{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC030",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "周末逛市中心",
  "sourceTitleTr": "Hafta Sonu Kasaba Turu",
  "sourceMiniAdventureTr": "Aile kasabanın banka, postane ve park gibi yerlerini gezer.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC030_001",
      "speaker": "张伟",
      "zh": "周末我们去市中心看看。",
      "pinyin": "Zhōumò wǒmen qù shìzhōngxīn kànkàn.",
      "tr": "Hafta sonu şehir merkezini gezelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_002",
      "speaker": "刘梅",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_003",
      "speaker": "张乐乐",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_004",
      "speaker": "张雨桐",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_005",
      "speaker": "张伟",
      "zh": "银行离这里不远。",
      "pinyin": "Yínháng lí zhèlǐ bùyuǎn.",
      "tr": "Banka buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_006",
      "speaker": "刘梅",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_007",
      "speaker": "张乐乐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_008",
      "speaker": "张雨桐",
      "zh": "邮局离这里不远。",
      "pinyin": "Yóujú lí zhèlǐ bùyuǎn.",
      "tr": "Postane buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_009",
      "speaker": "张伟",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_010",
      "speaker": "刘梅",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_011",
      "speaker": "张乐乐",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_012",
      "speaker": "张雨桐",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_014",
      "speaker": "刘梅",
      "zh": "市中心离这里不远。",
      "pinyin": "Shìzhōngxīn lí zhèlǐ bùyuǎn.",
      "tr": "Şehir merkezi buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_017",
      "speaker": "张伟",
      "zh": "银行离邮局远不远？",
      "pinyin": "Yínháng lí yóujú yuǎn bùyuǎn?",
      "tr": "Banka postaneden uzak mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC030_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC030_019",
      "speaker": "张乐乐",
      "zh": "没关系，我们先想个办法。",
      "pinyin": "Méiguānxì, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Sorun değil, önce bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_020",
      "speaker": "张雨桐",
      "zh": "我想先把最简单的做完。",
      "pinyin": "Wǒ xiǎng xiān bǎ zuì jiǎndān de zuò wán.",
      "tr": "Bence önce en kolay kısmı bitirelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_022",
      "speaker": "刘梅",
      "zh": "这个距离不算远。",
      "pinyin": "Zhège jùlí bùsuàn yuǎn.",
      "tr": "Bu mesafe çok uzak sayılmaz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_024",
      "speaker": "张雨桐",
      "zh": "那就先写下来。",
      "pinyin": "Nà jiù xiān xiě xiàlái.",
      "tr": "O zaman önce yazalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_025",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu şehir burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_028",
      "speaker": "张雨桐",
      "zh": "这个地图在这里。",
      "pinyin": "Zhège dìtú zài zhèlǐ.",
      "tr": "Bu harita burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_031",
      "speaker": "张乐乐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_032",
      "speaker": "张雨桐",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_034",
      "speaker": "刘梅",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_035",
      "speaker": "张乐乐",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_036",
      "speaker": "张雨桐",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_037",
      "speaker": "张伟",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_038",
      "speaker": "刘梅",
      "zh": "那试试别的办法。",
      "pinyin": "Nà shìshì biéde bànfǎ.",
      "tr": "O zaman başka bir yol deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_044",
      "speaker": "张雨桐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_048",
      "speaker": "张雨桐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_049",
      "speaker": "张伟",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_050",
      "speaker": "刘梅",
      "zh": "有了这次经验，下次就知道怎么办了。",
      "pinyin": "Yǒu le zhècì jīngyàn, xiàcì jiù zhīdào zěnmebàn le.",
      "tr": "Bu deneyim sayesinde bir dahaki sefere ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_051",
      "speaker": "张乐乐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_054",
      "speaker": "刘梅",
      "zh": "嗯，银行离这里不远。",
      "pinyin": "En, yínháng lí zhèlǐ bùyuǎn.",
      "tr": "Banka buradan uzak değil."
    },
    {
