{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC002",
  "level": "HSK2",
  "sceneCategory": "business",
  "sourceTitleZh": "张伟办公交卡",
  "sourceTitleTr": "Zhang Otobüs Kartı Alıyor",
  "sourceMiniAdventureTr": "Zhang günlük kart yerine yanlışlıkla başka kart almak üzeredir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC002_001",
      "speaker": "张伟",
      "zh": "我想办公交卡。",
      "pinyin": "Wǒ xiǎng bàngōng jiāokǎ.",
      "tr": "Otobüs kartı almak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_002",
      "speaker": "工作人员",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_003",
      "speaker": "刘梅",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_004",
      "speaker": "张伟",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_005",
      "speaker": "工作人员",
      "zh": "你看，这个公交卡在这儿。",
      "pinyin": "Nǐ kàn, zhège gōngjiāo kǎ zài zhèér.",
      "tr": "Bu otobüs kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_006",
      "speaker": "刘梅",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_007",
      "speaker": "张伟",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_008",
      "speaker": "工作人员",
      "zh": "一个月的时间过得很快。",
      "pinyin": "Yígèyuè de shíjiān guòdé hěnkuài.",
      "tr": "Bir aylık süre çok hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_009",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_010",
      "speaker": "张伟",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_011",
      "speaker": "工作人员",
      "zh": "一天用这个就够了。",
      "pinyin": "Yītiān yòng zhège jiùgòu le.",
      "tr": "Bir gün için bunu kullanmak yeterli."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_012",
      "speaker": "刘梅",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_014",
      "speaker": "工作人员",
      "zh": "服务台离这里不远。",
      "pinyin": "Fúwùtái lí zhèlǐ bùyuǎn.",
      "tr": "Hizmet bankosu buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_017",
      "speaker": "工作人员",
      "zh": "这个不是我要的卡。",
      "pinyin": "Zhège búshì wǒyào de kǎ.",
      "tr": "Bu istediğim kart değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC002_019",
      "speaker": "张伟",
      "zh": "先别慌，看看还有什么办法。",
      "pinyin": "Xiānbié huāng, kànkàn háiyǒu shénme bànfǎ.",
      "tr": "Panik yapmayalım, başka ne yapabiliriz bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_020",
      "speaker": "工作人员",
      "zh": "从简单的开始会快一点。",
      "pinyin": "Cóng jiǎndān de kāishǐ huìkuài yìdiǎn.",
      "tr": "Kolay olandan başlamak biraz daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_022",
      "speaker": "张伟",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_023",
      "speaker": "工作人员",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_024",
      "speaker": "刘梅",
      "zh": "好，这一点先记着。",
      "pinyin": "Hǎo, zhè yìdiǎn xiānjì zhe.",
      "tr": "Tamam, bu noktayı aklımızda tutalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_025",
      "speaker": "张伟",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_026",
      "speaker": "工作人员",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_028",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_029",
      "speaker": "工作人员",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_031",
      "speaker": "张伟",
      "zh": "这个套餐每月多少钱？",
      "pinyin": "Zhège tàocān měiyuè duōshǎo qián?",
      "tr": "Bu tarife ayda ne kadar?"
    },
    {
      "id": "DLG_ZH_HSK2_SC002_032",
      "speaker": "工作人员",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_034",
      "speaker": "张伟",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_035",
      "speaker": "工作人员",
      "zh": "好，先这个，后面再做下一个。",
      "pinyin": "Hǎo, xiān zhège, hòumiàn zài zuò xià yígè.",
      "tr": "Tamam, önce bu; sonra diğerini yaparız."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_036",
      "speaker": "刘梅",
      "zh": "这样比刚才方便。",
      "pinyin": "Zhèyàng bǐ gāngcái fāngbiàn.",
      "tr": "Böyle yapmak az öncekinden daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_037",
      "speaker": "张伟",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_038",
      "speaker": "工作人员",
      "zh": "不行的话就换一个办法。",
      "pinyin": "Bùxíng dehuà jiù huàn yígè bànfǎ.",
      "tr": "Olmazsa başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_041",
      "speaker": "工作人员",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_044",
      "speaker": "工作人员",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_047",
      "speaker": "工作人员",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_048",
      "speaker": "刘梅",
      "zh": "好了，问题终于解决了。",
      "pinyin": "Hǎo le, wèntí zhōngyú jiějué le.",
      "tr": "Tamam, sorun sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_049",
      "speaker": "张伟",
      "zh": "以后遇到这种情况就知道怎么办了。",
      "pinyin": "Yǐhòu yùdào zhèzhǒng qíngkuàng jiù zhīdào zěnmebàn le.",
      "tr": "Bundan sonra böyle bir durumda ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_050",
      "speaker": "工作人员",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha tecrübeli oluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_053",
      "speaker": "工作人员",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
