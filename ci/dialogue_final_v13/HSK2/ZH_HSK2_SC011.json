{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC011",
  "level": "HSK2",
  "sceneCategory": "education",
  "sourceTitleZh": "第一次家长会",
  "sourceTitleTr": "Okul Veli Toplantısı",
  "sourceMiniAdventureTr": "Liu Mei, Lele’nin öğretmeniyle okul durumu hakkında konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC011_001",
      "speaker": "刘梅",
      "zh": "今天是第一次家长会。",
      "pinyin": "Jīntiān shì dìyīcì jiāzhǎnghuì.",
      "tr": "Bugün ilk veli toplantısı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_002",
      "speaker": "老师",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_003",
      "speaker": "张乐乐",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_004",
      "speaker": "刘梅",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_005",
      "speaker": "老师",
      "zh": "今天学校开家长会。",
      "pinyin": "Jīntiān xuéxiào kāi jiāzhǎnghuì.",
      "tr": "Bugün okulda veli toplantısı var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_006",
      "speaker": "张乐乐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_007",
      "speaker": "刘梅",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_008",
      "speaker": "老师",
      "zh": "老师今天也来了。",
      "pinyin": "Lǎoshī jīntiān yě lái le.",
      "tr": "Öğretmen bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_009",
      "speaker": "张乐乐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_010",
      "speaker": "刘梅",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_011",
      "speaker": "老师",
      "zh": "老师说他进步很大。",
      "pinyin": "Lǎoshī shuō tā jìnbù hěndà.",
      "tr": "Öğretmen onun çok ilerlediğini söyledi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_012",
      "speaker": "张乐乐",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_014",
      "speaker": "老师",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_017",
      "speaker": "老师",
      "zh": "乐乐有一点不认真。",
      "pinyin": "Lèlè yǒu yìdiǎn bù rènzhēn.",
      "tr": "Lele biraz dikkatsiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_018",
      "speaker": "张乐乐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC011_019",
      "speaker": "刘梅",
      "zh": "别着急，总会有办法的。",
      "pinyin": "Biézháojí, zǒnghuì yǒu bànfǎ de.",
      "tr": "Telaşlanma, mutlaka bir çözüm buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_020",
      "speaker": "老师",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_021",
      "speaker": "张乐乐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_022",
      "speaker": "刘梅",
      "zh": "我们先学习。",
      "pinyin": "Wǒmen xiān xuéxí.",
      "tr": "Önce ders çalışma."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_023",
      "speaker": "老师",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_024",
      "speaker": "张乐乐",
      "zh": "好，把这个记下来吧。",
      "pinyin": "Hǎo, bǎ zhège jìxiàlái ba.",
      "tr": "Tamam, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_025",
      "speaker": "刘梅",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_026",
      "speaker": "老师",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_028",
      "speaker": "刘梅",
      "zh": "你看，这个校车在这儿。",
      "pinyin": "Nǐ kàn, zhège xiàochē zài zhèér.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_029",
      "speaker": "老师",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_030",
      "speaker": "张乐乐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_031",
      "speaker": "刘梅",
      "zh": "以后我会更注意。",
      "pinyin": "Yǐhòu wǒhuì gèng zhùyì.",
      "tr": "Bundan sonra daha dikkatli olacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_032",
      "speaker": "老师",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_033",
      "speaker": "张乐乐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_034",
      "speaker": "刘梅",
      "zh": "时间有点紧，我们动作快一点。",
      "pinyin": "Shíjiān yǒudiǎn jǐn, wǒmen dòngzuò kuài yìdiǎn.",
      "tr": "Zaman biraz sıkışık, biraz hızlı hareket edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_035",
      "speaker": "老师",
      "zh": "先把这个完成，再看下一个。",
      "pinyin": "Xiān bǎ zhège wánchéng, zài kàn xià yígè.",
      "tr": "Önce bunu tamamlayalım, sonra diğerine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_036",
      "speaker": "张乐乐",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_037",
      "speaker": "刘梅",
      "zh": "我试过了，知道是什么情况。",
      "pinyin": "Wǒshì guò le, zhīdào shì shénme qíngkuàng.",
      "tr": "Denedim, durumun ne olduğunu biliyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_038",
      "speaker": "老师",
      "zh": "不行的话就换一个办法。",
      "pinyin": "Bùxíng dehuà jiù huàn yígè bànfǎ.",
      "tr": "Olmazsa başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_041",
      "speaker": "老师",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_042",
      "speaker": "张乐乐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_044",
      "speaker": "老师",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_045",
      "speaker": "张乐乐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_047",
      "speaker": "老师",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_048",
      "speaker": "张乐乐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_049",
      "speaker": "刘梅",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_050",
      "speaker": "老师",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha tecrübeli oluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_051",
      "speaker": "张乐乐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_053",
      "speaker": "老师",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_054",
      "speaker": "张乐乐",
      "zh": "嗯，今天学校开家长会。",
      "pinyin": "En, jīntiān xuéxiào kāi jiāzhǎnghuì.",
      "tr": "Bugün okulda veli toplantısı var."
