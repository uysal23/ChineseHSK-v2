{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC013",
  "level": "HSK2",
  "sceneCategory": "work",
  "sourceTitleZh": "张伟帮同事",
  "sourceTitleTr": "Zhang İş Arkadaşına Yardım Ediyor",
  "sourceMiniAdventureTr": "Zhang iş arkadaşına küçük bir ekipman sorununda yardım eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC013_001",
      "speaker": "张伟",
      "zh": "这个设备有一点问题。",
      "pinyin": "Zhège shèbèi yǒu yìdiǎn wèntí.",
      "tr": "Bu ekipmanda küçük bir sorun var."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_002",
      "speaker": "同事",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_003",
      "speaker": "新同事",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_004",
      "speaker": "张伟",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_005",
      "speaker": "同事",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu ekipman burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_006",
      "speaker": "新同事",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_008",
      "speaker": "同事",
      "zh": "这个问题不难解决。",
      "pinyin": "Zhège wèntí bùnán jiějué.",
      "tr": "Bu sorunu çözmek zor değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_009",
      "speaker": "新同事",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_010",
      "speaker": "张伟",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_011",
      "speaker": "同事",
      "zh": "我们一步一步来。",
      "pinyin": "Wǒmen yībù yībù lái.",
      "tr": "Adım adım ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_012",
      "speaker": "新同事",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_014",
      "speaker": "同事",
      "zh": "我们先检查。",
      "pinyin": "Wǒmen xiān jiǎnchá.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_015",
      "speaker": "新同事",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_017",
      "speaker": "同事",
      "zh": "我们先检查，再重新打开。",
      "pinyin": "Wǒmen xiān jiǎnchá, zài chóngxīn dǎkāi.",
      "tr": "Önce kontrol edip sonra yeniden açalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_018",
      "speaker": "新同事",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC013_019",
      "speaker": "张伟",
      "zh": "先别急，我们一起想办法。",
      "pinyin": "Xiān biéjí, wǒmen yìqǐ xiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, birlikte bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_020",
      "speaker": "同事",
      "zh": "先做容易的吧。",
      "pinyin": "Xiān zuò róngyì de ba.",
      "tr": "Önce kolay olanı yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_021",
      "speaker": "新同事",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_022",
      "speaker": "张伟",
      "zh": "我们先修好。",
      "pinyin": "Wǒmen xiān xiūhǎo.",
      "tr": "Önce tamir etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_023",
      "speaker": "同事",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_024",
      "speaker": "新同事",
      "zh": "那就先写下来。",
      "pinyin": "Nà jiù xiān xiě xiàlái.",
      "tr": "O zaman önce yazalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_025",
      "speaker": "张伟",
      "zh": "你看，这个工作在这儿。",
      "pinyin": "Nǐ kàn, zhège gōngzuò zài zhèér.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_026",
      "speaker": "同事",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_027",
      "speaker": "新同事",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_028",
      "speaker": "张伟",
      "zh": "这个地方要特别注意。",
      "pinyin": "Zhège dìfāng yào tèbié zhùyì.",
      "tr": "Bu noktaya özellikle dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_029",
      "speaker": "同事",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_030",
      "speaker": "新同事",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_031",
      "speaker": "张伟",
      "zh": "第一步先检查这里。",
      "pinyin": "Dìyībù xiān jiǎnchá zhèlǐ.",
      "tr": "İlk adımda önce burayı kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_032",
      "speaker": "同事",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_033",
      "speaker": "新同事",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_034",
      "speaker": "张伟",
      "zh": "时间有点紧，我们动作快一点。",
      "pinyin": "Shíjiān yǒudiǎn jǐn, wǒmen dòngzuò kuài yìdiǎn.",
      "tr": "Zaman biraz sıkışık, biraz hızlı hareket edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_035",
      "speaker": "同事",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_036",
      "speaker": "新同事",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_037",
      "speaker": "张伟",
      "zh": "我已经试了一次。",
      "pinyin": "Wǒ yǐjīng shì le yīcì.",
      "tr": "Bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_038",
      "speaker": "同事",
      "zh": "那我们换个方法看看。",
      "pinyin": "Nà wǒmen huàngè fāngfǎ kànkàn.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_039",
      "speaker": "新同事",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_041",
      "speaker": "同事",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_042",
      "speaker": "新同事",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_044",
      "speaker": "同事",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_045",
      "speaker": "新同事",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_047",
      "speaker": "同事",
      "zh": "关于步骤，我们还是结合实际情况来看。",
      "pinyin": "Guānyú bùzhòu, wǒmen háishì jiéhéshíjì qíngkuàng láikàn.",
      "tr": "adım konusunda yine gerçek duruma bakmak gerekir."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_048",
      "speaker": "新同事",
      "zh": "终于好了，我放心了。",
      "pinyin": "Zhōngyú hǎo le, wǒ fàngxīn le.",
      "tr": "Sonunda düzeldi, içim rahatladı."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_049",
      "speaker": "张伟",
      "zh": "今天又学到了一点。",
      "pinyin": "Jīntiān yòu xuédào le yìdiǎn.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_050",
      "speaker": "同事",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_051",
      "speaker": "新同事",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_053",
      "speaker": "同事",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_054",
