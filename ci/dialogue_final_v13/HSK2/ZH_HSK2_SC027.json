{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC027",
  "level": "HSK2",
  "sceneCategory": "family",
  "sourceTitleZh": "乐乐掉牙了",
  "sourceTitleTr": "Lele’nin Dişi Düşüyor",
  "sourceMiniAdventureTr": "Lele’nin dişi düşer; aile onu rahatlatır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC027_001",
      "speaker": "张乐乐",
      "zh": "乐乐的牙掉了。",
      "pinyin": "Lèlè de yá diào le.",
      "tr": "Lele’nin dişi düştü."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_002",
      "speaker": "刘梅",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_003",
      "speaker": "张伟",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_004",
      "speaker": "张乐乐",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_005",
      "speaker": "刘梅",
      "zh": "这个牙在这里。",
      "pinyin": "Zhège yá zài zhèlǐ.",
      "tr": "Bu diş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_006",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_007",
      "speaker": "张乐乐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_008",
      "speaker": "刘梅",
      "zh": "这个疼在这里。",
      "pinyin": "Zhège téng zài zhèlǐ.",
      "tr": "Bu ağrımak burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_009",
      "speaker": "张伟",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_010",
      "speaker": "张乐乐",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_011",
      "speaker": "刘梅",
      "zh": "他的牙刚刚掉了。",
      "pinyin": "Tā de yá gānggāng diào le.",
      "tr": "Dişi az önce düştü."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_012",
      "speaker": "张伟",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_014",
      "speaker": "刘梅",
      "zh": "别害怕，我在这里。",
      "pinyin": "Bié hàipà, wǒ zài zhèlǐ.",
      "tr": "Korkma, ben buradayım."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_015",
      "speaker": "张伟",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_017",
      "speaker": "刘梅",
      "zh": "疼不疼？别害怕。",
      "pinyin": "Téngbùténg? bié hàipà.",
      "tr": "Acıyor mu? Korkma."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC027_019",
      "speaker": "张乐乐",
      "zh": "别着急，总会有办法的。",
      "pinyin": "Biézháojí, zǒnghuì yǒu bànfǎ de.",
      "tr": "Telaşlanma, mutlaka bir çözüm buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_020",
      "speaker": "刘梅",
      "zh": "从简单的开始会快一点。",
      "pinyin": "Cóng jiǎndān de kāishǐ huìkuài yìdiǎn.",
      "tr": "Kolay olandan başlamak biraz daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_022",
      "speaker": "张乐乐",
      "zh": "没关系，我们再试一次。",
      "pinyin": "Méiguānxì, wǒmen zàishìyīcì.",
      "tr": "Sorun değil, tekrar deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_024",
      "speaker": "张伟",
      "zh": "那我先把它写下来。",
      "pinyin": "Nà wǒ xiān bǎ tā xiě xiàlái.",
      "tr": "O zaman bunu önce yazayım."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_025",
      "speaker": "张乐乐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_027",
      "speaker": "张伟",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_028",
      "speaker": "张乐乐",
      "zh": "这个药在这里。",
      "pinyin": "Zhège yào zài zhèlǐ.",
      "tr": "Bu ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_031",
      "speaker": "张乐乐",
      "zh": "今天感觉好一点了吗？",
      "pinyin": "Jīntiān gǎnjué hǎo yìdiǎn le ma?",
      "tr": "Bugün biraz daha iyi hissediyor musun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC027_032",
      "speaker": "刘梅",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_034",
      "speaker": "张乐乐",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_035",
      "speaker": "刘梅",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_036",
      "speaker": "张伟",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_037",
      "speaker": "张乐乐",
      "zh": "我试过了，知道是什么情况。",
      "pinyin": "Wǒshì guò le, zhīdào shì shénme qíngkuàng.",
      "tr": "Denedim, durumun ne olduğunu biliyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_038",
      "speaker": "刘梅",
      "zh": "这个不行，就换一个。",
      "pinyin": "Zhège bùxíng, jiù huàn yígè.",
      "tr": "Bu olmazsa başka birini deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_039",
      "speaker": "张伟",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_046",
      "speaker": "张乐乐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_048",
      "speaker": "张伟",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_049",
      "speaker": "张乐乐",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_050",
      "speaker": "刘梅",
      "zh": "下次再遇到就容易多了。",
      "pinyin": "Xiàcì zài yùdào jiù róngyì duō le.",
      "tr": "Bir daha olursa çok daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_051",
      "speaker": "张伟",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_054",
      "speaker": "张伟",
      "zh": "你看，这个牙在这儿。",
      "pinyin": "Nǐ kàn, zhège yá zài zhèér.",
      "tr": "Bu diş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_055",
      "speaker": "张乐乐",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_056",
      "speaker": "刘梅",
      "zh": "嗯，这个疼在这里。",
      "pinyin": "En, zhège téng zài zhèlǐ.",
      "tr": "Bu ağrımak burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_057",
      "speaker": "张伟",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC027_058",
      "speaker": "张乐乐",
      "zh": "嗯，他的牙刚刚掉了。",
