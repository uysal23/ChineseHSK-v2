{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC048",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "新城的春天",
  "sourceTitleTr": "Kasabada İlk Bahar",
  "sourceMiniAdventureTr": "Aile ilkbaharda çevrenin değiştiğini fark eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC048_001",
      "speaker": "张伟",
      "zh": "新城的春天来了。",
      "pinyin": "Xīnchéng de chūntiān lái le.",
      "tr": "Yeni şehirde ilkbahar geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_002",
      "speaker": "刘梅",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_003",
      "speaker": "张雨桐",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_004",
      "speaker": "张乐乐",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_005",
      "speaker": "张伟",
      "zh": "你看，这个春天在这儿。",
      "pinyin": "Nǐ kàn, zhège chūntiān zài zhèér.",
      "tr": "Bu ilkbahar burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_006",
      "speaker": "刘梅",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_007",
      "speaker": "张雨桐",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_008",
      "speaker": "张乐乐",
      "zh": "春天的天气很暖和。",
      "pinyin": "Chūntiān de tiānqì hěn nuǎnhuo.",
      "tr": "İlkbaharda hava çok ılık."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_010",
      "speaker": "刘梅",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_011",
      "speaker": "张雨桐",
      "zh": "你看，这个花在这儿。",
      "pinyin": "Nǐ kàn, zhège huā zài zhèér.",
      "tr": "Bu çiçek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_012",
      "speaker": "张乐乐",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_014",
      "speaker": "刘梅",
      "zh": "公园里的花都开了。",
      "pinyin": "Gōngyuán lǐ de huādōu kāi le.",
      "tr": "Parktaki çiçeklerin hepsi açtı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_017",
      "speaker": "张伟",
      "zh": "天气比冬天暖和多了。",
      "pinyin": "Tiānqì bǐ dōngtiān nuǎnhuo duō le.",
      "tr": "Hava kışa göre çok daha sıcak."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC048_019",
      "speaker": "张雨桐",
      "zh": "先别急，我们一起想办法。",
      "pinyin": "Xiān biéjí, wǒmen yìqǐ xiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, birlikte bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_020",
      "speaker": "张乐乐",
      "zh": "要不先做最简单的？",
      "pinyin": "Yào bù xiān zuò zuì jiǎndān de?",
      "tr": "Önce en kolay olanı yapsak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC048_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_022",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu kış burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_024",
      "speaker": "张乐乐",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_025",
      "speaker": "张伟",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_028",
      "speaker": "张乐乐",
      "zh": "外面正在下雨。",
      "pinyin": "Wàimiàn zhèngzài xiàyǔ.",
      "tr": "Dışarıda yağmur yağıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_031",
      "speaker": "张雨桐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_032",
      "speaker": "张乐乐",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_034",
      "speaker": "刘梅",
      "zh": "时间不多了，我们快一点吧。",
      "pinyin": "Shíjiān bùduō le, wǒmen kuài yìdiǎn ba.",
      "tr": "Fazla zaman kalmadı, biraz hızlanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_035",
      "speaker": "张雨桐",
      "zh": "好，先这个，后面再做下一个。",
      "pinyin": "Hǎo, xiān zhège, hòumiàn zài zuò xià yígè.",
      "tr": "Tamam, önce bu; sonra diğerini yaparız."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_036",
      "speaker": "张乐乐",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_037",
      "speaker": "张伟",
      "zh": "这个我试过一次。",
      "pinyin": "Zhège wǒshì guò yīcì.",
      "tr": "Bunu bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_038",
      "speaker": "刘梅",
      "zh": "好，我们换一种做法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng zuòfǎ.",
      "tr": "Tamam, başka bir yöntem kullanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_047",
      "speaker": "张雨桐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_048",
      "speaker": "张乐乐",
      "zh": "太好了，这件事解决了。",
      "pinyin": "Tàihǎole, zhèjiàn shì jiějué le.",
      "tr": "Harika, bu işi çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_049",
      "speaker": "张伟",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_050",
      "speaker": "刘梅",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_051",
      "speaker": "张雨桐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_054",
      "speaker": "刘梅",
      "zh": "嗯，你看，这个春天在这儿。",
      "pinyin": "En, nǐ kàn, zhège chūntiān zài zhèér.",
      "tr": "Bu ilkbahar burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_055",
      "speaker": "张雨桐",
      "zh": "好，我会记着。",
      "pinyin": "Hǎo, wǒhuì jìzhe.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_056",
      "speaker": "张乐乐",
      "zh": "嗯，春天的天气很暖和。",
      "pinyin": "En, chūntiān de tiānqì hěn nuǎnhuo.",
      "tr": "İlkbaharda hava çok ılık."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_057",
      "speaker": "张伟",
      "zh": "嗯，这个很有用。",
      "pinyin": "En, zhège hěn yǒuyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_058",
      "speaker": "刘梅",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Bu çiçek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_059",
      "speaker": "张雨桐",
      "zh": "这个以后还会用。",
      "pinyin": "Zhège yǐhòu háihuìyòng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_060",
