  "sceneId": "ZH_HSK2_SC038",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "雨桐和朋友闹别扭",
  "sourceTitleTr": "Yutong’un İlk Küçük Tartışması",
  "sourceMiniAdventureTr": "Yutong ve arkadaşı yanlış anlaşılma sonrası konuşup barışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC038_001",
      "speaker": "张雨桐",
      "zh": "雨桐和朋友有一点误会。",
      "pinyin": "Yǔtóng hé péngyǒu yǒu yìdiǎn wùhuì.",
      "tr": "Yutong ile arkadaşının küçük bir yanlış anlaşılması var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_002",
      "speaker": "同学",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_003",
      "speaker": "刘梅",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_004",
      "speaker": "张雨桐",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_005",
      "speaker": "同学",
      "zh": "我们之间有一点误会。",
      "pinyin": "Wǒmen zhījiān yǒu yìdiǎn wùhuì.",
      "tr": "Aramızda küçük bir yanlış anlaşılma var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_006",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_007",
      "speaker": "张雨桐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_008",
      "speaker": "同学",
      "zh": "我明白你的意思了。",
      "pinyin": "Wǒ míngbái nǐ de yìsi le.",
      "tr": "Ne demek istediğini anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_009",
      "speaker": "刘梅",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_010",
      "speaker": "张雨桐",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_011",
      "speaker": "同学",
      "zh": "我们先道歉。",
      "pinyin": "Wǒmen xiān dàoqiàn.",
      "tr": "Önce özür dilemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_012",
      "speaker": "刘梅",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_014",
      "speaker": "同学",
      "zh": "说清楚以后就和好了。",
      "pinyin": "Shuō qīngchǔ yǐhòu jiù hé hǎo le.",
      "tr": "Açıklığa kavuşturunca barıştılar."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_017",
      "speaker": "同学",
      "zh": "我不是那个意思，对不起。",
      "pinyin": "Wǒ búshì nàge yìsi, duìbùqǐ.",
      "tr": "Öyle demek istemedim, özür dilerim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC038_019",
      "speaker": "张雨桐",
      "zh": "没关系，我们先想个办法。",
      "pinyin": "Méiguānxì, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Sorun değil, önce bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_020",
      "speaker": "同学",
      "zh": "先做容易的吧。",
      "pinyin": "Xiān zuò róngyì de ba.",
      "tr": "Önce kolay olanı yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_022",
      "speaker": "张雨桐",
      "zh": "我们先谈一谈。",
      "pinyin": "Wǒmen xiān tányītán.",
      "tr": "Önce konuşmak."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_023",
      "speaker": "同学",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_024",
      "speaker": "刘梅",
      "zh": "那我们先记下来。",
      "pinyin": "Nà wǒmen xiān jìxiàlái.",
      "tr": "O zaman önce not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_025",
      "speaker": "张雨桐",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_026",
      "speaker": "同学",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_028",
      "speaker": "张雨桐",
      "zh": "对不起，是我弄错了。",
      "pinyin": "Duìbùqǐ, shì wǒ nòngcuò le.",
      "tr": "Özür dilerim, ben yanlış yaptım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_029",
      "speaker": "同学",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_031",
      "speaker": "张雨桐",
      "zh": "没关系，我们再试一次。",
      "pinyin": "Méiguānxì, wǒmen zàishìyīcì.",
      "tr": "Sorun değil, tekrar deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_032",
      "speaker": "同学",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_034",
      "speaker": "张雨桐",
      "zh": "时间有点紧，我们动作快一点。",
      "pinyin": "Shíjiān yǒudiǎn jǐn, wǒmen dòngzuò kuài yìdiǎn.",
      "tr": "Zaman biraz sıkışık, biraz hızlı hareket edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_035",
      "speaker": "同学",
      "zh": "先做这个，然后再做下一个。",
      "pinyin": "Xiān zuò zhège, ránhòu zài zuò xià yígè.",
      "tr": "Önce bunu yapalım, sonra diğerine geçeriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_036",
      "speaker": "刘梅",
      "zh": "这样比刚才方便。",
      "pinyin": "Zhèyàng bǐ gāngcái fāngbiàn.",
      "tr": "Böyle yapmak az öncekinden daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_037",
      "speaker": "张雨桐",
      "zh": "这个我试过一次。",
      "pinyin": "Zhège wǒshì guò yīcì.",
      "tr": "Bunu bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_038",
      "speaker": "同学",
      "zh": "那我们换个办法吧。",
      "pinyin": "Nà wǒmen huàngè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_041",
      "speaker": "同学",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_044",
      "speaker": "同学",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_047",
      "speaker": "同学",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_048",
      "speaker": "刘梅",
      "zh": "太好了，这下没问题了。",
      "pinyin": "Tàihǎole, zhèxià méi wèntí le.",
      "tr": "Harika, artık sorun yok."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_049",
      "speaker": "张雨桐",
      "zh": "这件事让我学到了不少。",
      "pinyin": "Zhèjiàn shì ràngwǒxué dào le bùshǎo.",
      "tr": "Bu olay bana epey şey öğretti."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_050",
      "speaker": "同学",
      "zh": "这次记住了，下次会更顺利。",
      "pinyin": "Zhècì jìzhù le, xiàcì huì gèng shùnlì.",
      "tr": "Bu kez öğrendik; bir dahaki sefere daha sorunsuz olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_053",
      "speaker": "同学",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_054",
