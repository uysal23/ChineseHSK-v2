{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC014",
  "level": "HSK2",
  "sceneCategory": "business",
  "sourceTitleZh": "理发店里的误会",
  "sourceTitleTr": "Mahalle Berberi",
  "sourceMiniAdventureTr": "Zhang istediği saç modelini anlatırken küçük bir yanlış anlaşılma olur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC014_001",
      "speaker": "张伟",
      "zh": "我想把头发剪短一点。",
      "pinyin": "Wǒ xiǎng bǎ tóufà jiǎnduǎn yìdiǎn.",
      "tr": "Saçımı biraz daha kısa kestirmek istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_002",
      "speaker": "理发师",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_003",
      "speaker": "刘梅",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_004",
      "speaker": "张伟",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_005",
      "speaker": "理发师",
      "zh": "我今天去理发。",
      "pinyin": "Wǒ jīntiān qù lǐfà.",
      "tr": "Bugün saçımı kestirmeye gidiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_006",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_007",
      "speaker": "张伟",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_008",
      "speaker": "理发师",
      "zh": "我想再短一点。",
      "pinyin": "Wǒ xiǎng zài duǎn yìdiǎn.",
      "tr": "Biraz daha kısa istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_009",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_010",
      "speaker": "张伟",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_011",
      "speaker": "理发师",
      "zh": "这个有点长。",
      "pinyin": "Zhège yǒudiǎn zhǎng.",
      "tr": "Bu biraz uzun."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_012",
      "speaker": "刘梅",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_014",
      "speaker": "理发师",
      "zh": "这个样子更适合你。",
      "pinyin": "Zhège yàngzi gèng shìhé nǐ.",
      "tr": "Bu görünüm sana daha uygun."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_017",
      "speaker": "理发师",
      "zh": "不是这么短。",
      "pinyin": "Búshì zhème duǎn.",
      "tr": "Bu kadar kısa değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC014_019",
      "speaker": "张伟",
      "zh": "先别急，我们一起想办法。",
      "pinyin": "Xiān biéjí, wǒmen yìqǐ xiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, birlikte bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_020",
      "speaker": "理发师",
      "zh": "我们可以先从简单的开始。",
      "pinyin": "Wǒmen kěyǐ xiān cóng jiǎndān de kāishǐ.",
      "tr": "Önce kolay olandan başlayabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_022",
      "speaker": "张伟",
      "zh": "理发师今天也来了。",
      "pinyin": "Lǐfàshī jīntiān yě lái le.",
      "tr": "Berber bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_023",
      "speaker": "理发师",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_024",
      "speaker": "刘梅",
      "zh": "好，这一点先记着。",
      "pinyin": "Hǎo, zhè yìdiǎn xiānjì zhe.",
      "tr": "Tamam, bu noktayı aklımızda tutalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_025",
      "speaker": "张伟",
      "zh": "这个礼物很漂亮。",
      "pinyin": "Zhège lǐwù hěnpiàoliàng.",
      "tr": "Bu hediye çok güzel."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_026",
      "speaker": "理发师",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_028",
      "speaker": "张伟",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_029",
      "speaker": "理发师",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_031",
      "speaker": "张伟",
      "zh": "我们先检查。",
      "pinyin": "Wǒmen xiān jiǎnchá.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_032",
      "speaker": "理发师",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_034",
      "speaker": "张伟",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_035",
      "speaker": "理发师",
      "zh": "我们一个一个来，先做这个。",
      "pinyin": "Wǒmen yígè yígè lái, xiān zuò zhège.",
      "tr": "Tek tek ilerleyelim, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_036",
      "speaker": "刘梅",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_037",
      "speaker": "张伟",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_038",
      "speaker": "理发师",
      "zh": "那试试别的办法。",
      "pinyin": "Nà shìshì biéde bànfǎ.",
      "tr": "O zaman başka bir yol deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_041",
      "speaker": "理发师",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_044",
      "speaker": "理发师",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_047",
      "speaker": "理发师",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_048",
      "speaker": "刘梅",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_049",
      "speaker": "张伟",
      "zh": "以后遇到这种情况就知道怎么办了。",
      "pinyin": "Yǐhòu yùdào zhèzhǒng qíngkuàng jiù zhīdào zěnmebàn le.",
      "tr": "Bundan sonra böyle bir durumda ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_050",
      "speaker": "理发师",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_053",
      "speaker": "理发师",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_054",
      "speaker": "刘梅",
      "zh": "嗯，我今天去理发。",
