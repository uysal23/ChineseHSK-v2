      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_056",
      "speaker": "李晨妻子",
      "zh": "这个饭在这里。",
      "pinyin": "Zhège fàn zài zhèlǐ.",
      "tr": "Bu yemek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_057",
      "speaker": "刘梅",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_058",
