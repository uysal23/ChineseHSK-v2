{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC001",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "新的早晨",
  "sourceTitleTr": "Yeni Sabah Düzeni",
  "sourceMiniAdventureTr": "Herkes aynı anda hazırlanırken banyo sırası karışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC001_001",
      "speaker": "刘梅",
      "zh": "大家都要用洗手间。",
      "pinyin": "Dàjiā dōu yào yòng xǐshǒujiān.",
      "tr": "Herkes banyoyu kullanmak istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_002",
      "speaker": "张伟",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_003",
      "speaker": "张雨桐",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_004",
      "speaker": "张乐乐",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_005",
      "speaker": "刘梅",
      "zh": "今天的日常安排有一点乱。",
      "pinyin": "Jīntiān de rìcháng ānpái yǒu yìdiǎn luàn.",
      "tr": "Bugünkü günlük düzen biraz karışık."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_006",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_008",
      "speaker": "张乐乐",
      "zh": "今天早上大家都很忙。",
      "pinyin": "Jīntiān zǎoshàng dàjiā dōu hěn máng.",
      "tr": "Bu sabah herkes çok meşgul."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_009",
      "speaker": "刘梅",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_010",
      "speaker": "张伟",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_011",
      "speaker": "张雨桐",
      "zh": "洗手间离这里不远。",
      "pinyin": "Xǐshǒujiān lí zhèlǐ bùyuǎn.",
      "tr": "Banyo / tuvalet buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_012",
      "speaker": "张乐乐",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_014",
      "speaker": "张伟",
      "zh": "我们先做最重要的事。",
      "pinyin": "Wǒmen xiān zuò zuì zhòngyào de shì.",
      "tr": "Önce en önemli işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_017",
      "speaker": "刘梅",
      "zh": "时间不多了，我们来不及了。",
      "pinyin": "Shíjiān bùduō le, wǒmen láibùjí le.",
      "tr": "Fazla zaman kalmadı, yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC001_019",
      "speaker": "张雨桐",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_020",
      "speaker": "张乐乐",
      "zh": "先做容易的吧。",
      "pinyin": "Xiān zuò róngyì de ba.",
      "tr": "Önce kolay olanı yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_022",
      "speaker": "张伟",
      "zh": "做完这个再做别的。",
      "pinyin": "Zuò wán zhège zài zuò biéde.",
      "tr": "Bunu bitirdikten sonra diğer işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_024",
      "speaker": "张乐乐",
      "zh": "那就先写下来。",
      "pinyin": "Nà jiù xiān xiě xiàlái.",
      "tr": "O zaman önce yazalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_025",
      "speaker": "刘梅",
      "zh": "我们先等。",
      "pinyin": "Wǒmen xiān děng.",
      "tr": "Önce beklemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_028",
      "speaker": "张乐乐",
      "zh": "快一点，不然来不及了。",
      "pinyin": "Kuài yìdiǎn, bùrán láibùjí le.",
      "tr": "Biraz hızlı ol, yoksa yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_031",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_032",
      "speaker": "张乐乐",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_034",
      "speaker": "张伟",
      "zh": "先快一点做，等会儿再检查。",
      "pinyin": "Xiānkuài yìdiǎn zuò, děnghuìer zài jiǎnchá.",
      "tr": "Önce biraz hızlı yapalım, sonra yeniden kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_035",
      "speaker": "张雨桐",
      "zh": "先做这个，然后再做下一个。",
      "pinyin": "Xiān zuò zhège, ránhòu zài zuò xià yígè.",
      "tr": "Önce bunu yapalım, sonra diğerine geçeriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_036",
      "speaker": "张乐乐",
      "zh": "这样比刚才方便。",
      "pinyin": "Zhèyàng bǐ gāngcái fāngbiàn.",
      "tr": "Böyle yapmak az öncekinden daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_037",
      "speaker": "刘梅",
      "zh": "我试过了，知道是什么情况。",
      "pinyin": "Wǒshì guò le, zhīdào shì shénme qíngkuàng.",
      "tr": "Denedim, durumun ne olduğunu biliyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_038",
      "speaker": "张伟",
      "zh": "那试试别的办法。",
      "pinyin": "Nà shìshì biéde bànfǎ.",
      "tr": "O zaman başka bir yol deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_047",
      "speaker": "张雨桐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_048",
      "speaker": "张乐乐",
      "zh": "太好了，这下没问题了。",
      "pinyin": "Tàihǎole, zhèxià méi wèntí le.",
      "tr": "Harika, artık sorun yok."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_049",
      "speaker": "刘梅",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_050",
      "speaker": "张伟",
      "zh": "下次再遇到就容易多了。",
      "pinyin": "Xiàcì zài yùdào jiù róngyì duō le.",
      "tr": "Bir daha olursa çok daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_051",
      "speaker": "张雨桐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
