{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC023",
  "level": "HSK2",
  "sceneCategory": "business",
  "sourceTitleZh": "刘梅的第一个订单",
  "sourceTitleTr": "Liu Mei’nin İlk Siparişi",
  "sourceMiniAdventureTr": "Komşu özel bir pasta sipariş eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC023_001",
      "speaker": "刘梅",
      "zh": "这是刘梅的第一个蛋糕订单。",
      "pinyin": "Zhèshì liúméi de dìyígè dàngāo dìngdān.",
      "tr": "Bu Liu Mei’nin ilk pasta siparişi."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_002",
      "speaker": "邻居",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_003",
      "speaker": "张伟",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_004",
      "speaker": "刘梅",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_005",
      "speaker": "邻居",
      "zh": "这个订单在这里。",
      "pinyin": "Zhège dìngdān zài zhèlǐ.",
      "tr": "Bu sipariş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_006",
      "speaker": "张伟",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_007",
      "speaker": "刘梅",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_008",
      "speaker": "邻居",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu pasta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_009",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_010",
      "speaker": "刘梅",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_011",
      "speaker": "邻居",
      "zh": "我要大一点的。",
      "pinyin": "Wǒyào dà yìdiǎn de.",
      "tr": "Biraz daha büyüğünü istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_012",
      "speaker": "张伟",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_014",
      "speaker": "邻居",
      "zh": "有没有小一点的？",
      "pinyin": "Yǒuméiyǒu xiǎo yìdiǎn de?",
      "tr": "Biraz daha küçüğü var mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_015",
      "speaker": "张伟",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_017",
      "speaker": "邻居",
      "zh": "蛋糕要多大？几个人吃？",
      "pinyin": "Dàngāo yào duō dà? jǐgè rén chī?",
      "tr": "Pasta ne kadar büyük olsun? Kaç kişi yiyecek?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_019",
      "speaker": "刘梅",
      "zh": "先别急，我们一起想办法。",
      "pinyin": "Xiān biéjí, wǒmen yìqǐ xiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, birlikte bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_020",
      "speaker": "邻居",
      "zh": "我们可以先从简单的开始。",
      "pinyin": "Wǒmen kěyǐ xiān cóng jiǎndān de kāishǐ.",
      "tr": "Önce kolay olandan başlayabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_022",
      "speaker": "刘梅",
      "zh": "一共几个人？",
      "pinyin": "Yīgòng jǐgè rén?",
      "tr": "Toplam kaç kişi?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_023",
      "speaker": "邻居",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_024",
      "speaker": "张伟",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_025",
      "speaker": "刘梅",
      "zh": "明天是邻居的生日。",
      "pinyin": "Míngtiān shì línjū de shēngrì.",
      "tr": "Yarın komşunun doğum günü."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_026",
      "speaker": "邻居",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_027",
      "speaker": "张伟",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_028",
      "speaker": "刘梅",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_029",
      "speaker": "邻居",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_031",
      "speaker": "刘梅",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_032",
      "speaker": "邻居",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_034",
      "speaker": "刘梅",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_035",
      "speaker": "邻居",
      "zh": "我们一个一个来，先做这个。",
      "pinyin": "Wǒmen yígè yígè lái, xiān zuò zhège.",
      "tr": "Tek tek ilerleyelim, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_036",
      "speaker": "张伟",
      "zh": "这个办法看起来更合适。",
      "pinyin": "Zhège bànfǎ kànqǐlái gèng héshì.",
      "tr": "Bu yöntem daha uygun görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_037",
      "speaker": "刘梅",
      "zh": "我已经试了一次。",
      "pinyin": "Wǒ yǐjīng shì le yīcì.",
      "tr": "Bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_038",
      "speaker": "邻居",
      "zh": "那试试别的办法。",
      "pinyin": "Nà shìshì biéde bànfǎ.",
      "tr": "O zaman başka bir yol deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_039",
      "speaker": "张伟",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_041",
      "speaker": "邻居",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_044",
      "speaker": "邻居",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_047",
      "speaker": "邻居",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_048",
      "speaker": "张伟",
      "zh": "好了，问题终于解决了。",
      "pinyin": "Hǎo le, wèntí zhōngyú jiějué le.",
      "tr": "Tamam, sorun sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_049",
      "speaker": "刘梅",
      "zh": "这次我们也学到东西了。",
      "pinyin": "Zhècì wǒmen yě xuédào dōngxī le.",
      "tr": "Bu sefer de bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_050",
      "speaker": "邻居",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_051",
      "speaker": "张伟",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_053",
      "speaker": "邻居",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_054",
      "speaker": "张伟",
      "zh": "嗯，这个订单在这里。",
      "pinyin": "En, zhège dìngdān zài zhèlǐ.",
      "tr": "Bu sipariş burada."
