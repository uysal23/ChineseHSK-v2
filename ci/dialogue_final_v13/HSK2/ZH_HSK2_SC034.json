{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC034",
  "level": "HSK2",
  "sceneCategory": "community",
  "sourceTitleZh": "社区清洁日",
  "sourceTitleTr": "Mahalle Temizlik Günü",
  "sourceMiniAdventureTr": "Aile ilk gönüllü çevre temizliğine katılır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC034_001",
      "speaker": "张伟",
      "zh": "今天是社区清洁日。",
      "pinyin": "Jīntiān shì shèqū qīngjié rì.",
      "tr": "Bugün mahalle temizlik günü."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_002",
      "speaker": "刘梅",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_003",
      "speaker": "社区工作人员",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_004",
      "speaker": "张乐乐",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_005",
      "speaker": "张伟",
      "zh": "我们先打扫。",
      "pinyin": "Wǒmen xiān dǎsǎo.",
      "tr": "Önce temizlemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_006",
      "speaker": "刘梅",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_007",
      "speaker": "社区工作人员",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_008",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu çöp burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_009",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_010",
      "speaker": "刘梅",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_011",
      "speaker": "社区工作人员",
      "zh": "社区离这里不远。",
      "pinyin": "Shèqū lí zhèlǐ bùyuǎn.",
      "tr": "Mahalle / topluluk buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_012",
      "speaker": "张乐乐",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_014",
      "speaker": "刘梅",
      "zh": "志愿者今天也来了。",
      "pinyin": "Zhìyuànzhě jīntiān yě lái le.",
      "tr": "Gönüllü bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_015",
      "speaker": "社区工作人员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_017",
      "speaker": "张伟",
      "zh": "这里的垃圾比那边多。",
      "pinyin": "Zhèlǐ de lājī bǐ nàbiān duō.",
      "tr": "Buradaki çöp oradakinden daha fazla."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC034_019",
      "speaker": "社区工作人员",
      "zh": "没关系，我们先想个办法。",
      "pinyin": "Méiguānxì, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Sorun değil, önce bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_020",
      "speaker": "张乐乐",
      "zh": "从简单的开始会快一点。",
      "pinyin": "Cóng jiǎndān de kāishǐ huìkuài yìdiǎn.",
      "tr": "Kolay olandan başlamak biraz daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_022",
      "speaker": "刘梅",
      "zh": "这里现在很干净。",
      "pinyin": "Zhèlǐ xiànzài hěn gānjìng.",
      "tr": "Burası şimdi çok temiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_023",
      "speaker": "社区工作人员",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_024",
      "speaker": "张乐乐",
      "zh": "好，把这个记下来吧。",
      "pinyin": "Hǎo, bǎ zhège jìxiàlái ba.",
      "tr": "Tamam, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_025",
      "speaker": "张伟",
      "zh": "我们一起做吧。",
      "pinyin": "Wǒmen yìqǐ zuò ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_027",
      "speaker": "社区工作人员",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_028",
      "speaker": "张乐乐",
      "zh": "我们先帮忙。",
      "pinyin": "Wǒmen xiān bāngmáng.",
      "tr": "Önce yardım etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_031",
      "speaker": "社区工作人员",
      "zh": "今天社区有一个活动。",
      "pinyin": "Jīntiān shèqū yǒu yígè huódòng.",
      "tr": "Bugün mahallede bir etkinlik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_032",
      "speaker": "张乐乐",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_034",
      "speaker": "刘梅",
      "zh": "快一点吧，不然时间不够。",
      "pinyin": "Kuài yìdiǎn ba, bùrán shíjiān bùgòu.",
      "tr": "Biraz hızlanalım, yoksa zaman yetmeyecek."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_035",
      "speaker": "社区工作人员",
      "zh": "这个做完以后再做下一个。",
      "pinyin": "Zhège zuò wán yǐhòu zài zuò xià yígè.",
      "tr": "Bunu bitirdikten sonra diğerini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_037",
      "speaker": "张伟",
      "zh": "刚才我试过这个办法。",
      "pinyin": "Gāngcái wǒshì guò zhège bànfǎ.",
      "tr": "Az önce bu yöntemi denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_038",
      "speaker": "刘梅",
      "zh": "那我们换个办法吧。",
      "pinyin": "Nà wǒmen huàngè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_039",
      "speaker": "社区工作人员",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_043",
      "speaker": "社区工作人员",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_047",
      "speaker": "社区工作人员",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_048",
      "speaker": "张乐乐",
      "zh": "太好了，这下没问题了。",
      "pinyin": "Tàihǎole, zhèxià méi wèntí le.",
      "tr": "Harika, artık sorun yok."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_049",
      "speaker": "张伟",
      "zh": "这件事让我学到了不少。",
      "pinyin": "Zhèjiàn shì ràngwǒxué dào le bùshǎo.",
      "tr": "Bu olay bana epey şey öğretti."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_050",
      "speaker": "刘梅",
      "zh": "下次我们会准备得更好。",
      "pinyin": "Xiàcì wǒmen huì zhǔnbèi dé gènghǎo.",
      "tr": "Bir dahaki sefere daha iyi hazırlanırız."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_051",
      "speaker": "社区工作人员",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_054",
      "speaker": "刘梅",
      "zh": "嗯，我们先打扫。",
      "pinyin": "En, wǒmen xiān dǎsǎo.",
      "tr": "Önce temizlemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_055",
      "speaker": "社区工作人员",
      "zh": "嗯，我记住了。",
      "pinyin": "En, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_056",
      "speaker": "张乐乐",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Bu çöp burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC034_057",
      "speaker": "张伟",
      "zh": "这个挺实用的。",
