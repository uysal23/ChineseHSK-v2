{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC007",
  "level": "HSK2",
  "sceneCategory": "business",
  "sourceTitleZh": "邻居的生日",
  "sourceTitleTr": "Komşunun Doğum Günü",
  "sourceMiniAdventureTr": "Aile uygun bir hediye seçmek için mağazaya gider.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC007_001",
      "speaker": "刘梅",
      "zh": "邻居明天过生日。",
      "pinyin": "Línjū míngtiān guòshēngrì.",
      "tr": "Komşunun yarın doğum günü."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_002",
      "speaker": "张伟",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_003",
      "speaker": "张乐乐",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_004",
      "speaker": "店员",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_005",
      "speaker": "刘梅",
      "zh": "明天是邻居的生日。",
      "pinyin": "Míngtiān shì línjū de shēngrì.",
      "tr": "Yarın komşunun doğum günü."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_006",
      "speaker": "张伟",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_007",
      "speaker": "张乐乐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_008",
      "speaker": "店员",
      "zh": "这个礼物在这里。",
      "pinyin": "Zhège lǐwù zài zhèlǐ.",
      "tr": "Bu hediye burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_009",
      "speaker": "刘梅",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_010",
      "speaker": "张伟",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_011",
      "speaker": "张乐乐",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_012",
      "speaker": "店员",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_014",
      "speaker": "张伟",
      "zh": "这个礼物很漂亮。",
      "pinyin": "Zhège lǐwù hěnpiàoliàng.",
      "tr": "Bu hediye çok güzel."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_016",
      "speaker": "店员",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_017",
      "speaker": "刘梅",
      "zh": "我们不知道送什么好。",
      "pinyin": "Wǒmen bù zhīdào sòng shénme hǎo.",
      "tr": "Ne hediye edeceğimizi bilmiyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC007_019",
      "speaker": "张乐乐",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_020",
      "speaker": "店员",
      "zh": "从简单的开始会快一点。",
      "pinyin": "Cóng jiǎndān de kāishǐ huìkuài yìdiǎn.",
      "tr": "Kolay olandan başlamak biraz daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_022",
      "speaker": "张伟",
      "zh": "这个东西很有用。",
      "pinyin": "Zhège dōngxī hěn yǒuyòng.",
      "tr": "Bu şey çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_024",
      "speaker": "店员",
      "zh": "好，把这个记下来吧。",
      "pinyin": "Hǎo, bǎ zhège jìxiàlái ba.",
      "tr": "Tamam, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_025",
      "speaker": "刘梅",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_028",
      "speaker": "店员",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_031",
      "speaker": "张乐乐",
      "zh": "我们先买。",
      "pinyin": "Wǒmen xiānmǎi.",
      "tr": "Önce satın almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_032",
      "speaker": "店员",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_034",
      "speaker": "张伟",
      "zh": "先快一点做，等会儿再检查。",
      "pinyin": "Xiānkuài yìdiǎn zuò, děnghuìer zài jiǎnchá.",
      "tr": "Önce biraz hızlı yapalım, sonra yeniden kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_035",
      "speaker": "张乐乐",
      "zh": "我们一个一个来，先做这个。",
      "pinyin": "Wǒmen yígè yígè lái, xiān zuò zhège.",
      "tr": "Tek tek ilerleyelim, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_036",
      "speaker": "店员",
      "zh": "这样比刚才方便。",
      "pinyin": "Zhèyàng bǐ gāngcái fāngbiàn.",
      "tr": "Böyle yapmak az öncekinden daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_037",
      "speaker": "刘梅",
      "zh": "刚才我试过这个办法。",
      "pinyin": "Gāngcái wǒshì guò zhège bànfǎ.",
      "tr": "Az önce bu yöntemi denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_038",
      "speaker": "张伟",
      "zh": "那我们换个办法吧。",
      "pinyin": "Nà wǒmen huàngè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_040",
      "speaker": "店员",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_044",
      "speaker": "店员",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_048",
      "speaker": "店员",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_049",
      "speaker": "刘梅",
      "zh": "今天又学到了一点。",
      "pinyin": "Jīntiān yòu xuédào le yìdiǎn.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_050",
      "speaker": "张伟",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_051",
      "speaker": "张乐乐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_052",
      "speaker": "店员",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC007_054",
      "speaker": "张伟",
      "zh": "嗯，明天是邻居的生日。",
      "pinyin": "En, míngtiān shì línjū de shēngrì.",
      "tr": "Yarın komşunun doğum günü."
    },
