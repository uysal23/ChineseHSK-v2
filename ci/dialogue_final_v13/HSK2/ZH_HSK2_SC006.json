  "sceneId": "ZH_HSK2_SC006",
  "level": "HSK2",
  "sceneCategory": "work",
  "sourceTitleZh": "第一次加班",
  "sourceTitleTr": "Zhang’ın İlk Fazla Mesaisi",
  "sourceMiniAdventureTr": "Zhang eve geç geleceğini telefonla bildirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC006_001",
      "speaker": "张伟",
      "zh": "今天我要加班。",
      "pinyin": "Jīntiān wǒyào jiābān.",
      "tr": "Bugün fazla mesai yapacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_002",
      "speaker": "刘梅",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_003",
      "speaker": "同事",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_004",
      "speaker": "张伟",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_005",
      "speaker": "刘梅",
      "zh": "张伟今天要加班。",
      "pinyin": "Zhāngwěi jīntiān yào jiābān.",
      "tr": "Zhang Wei bugün fazla mesai yapacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_006",
      "speaker": "同事",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_007",
      "speaker": "张伟",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_008",
      "speaker": "刘梅",
      "zh": "我今天会晚一点回家。",
      "pinyin": "Wǒ jīntiān huì wǎnyìdiǎn huíjiā.",
      "tr": "Bugün eve biraz geç döneceğim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_009",
      "speaker": "同事",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_010",
      "speaker": "张伟",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_011",
      "speaker": "刘梅",
      "zh": "我们先打电话。",
      "pinyin": "Wǒmen xiān dǎdiànhuà.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_012",
      "speaker": "同事",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_014",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_015",
      "speaker": "同事",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_017",
      "speaker": "刘梅",
      "zh": "我可能晚一点回家。",
      "pinyin": "Wǒ kěnéng wǎnyìdiǎn huíjiā.",
      "tr": "Eve biraz geç dönebilirim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_018",
      "speaker": "同事",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC006_019",
      "speaker": "张伟",
      "zh": "先冷静一下，我们再想想怎么办。",
      "pinyin": "Xiān lěngjìng yīxià, wǒmen zài xiǎngxiǎng zěnmebàn.",
      "tr": "Önce sakinleşelim, sonra ne yapacağımızı düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_020",
      "speaker": "刘梅",
      "zh": "我们可以先从简单的开始。",
      "pinyin": "Wǒmen kěyǐ xiān cóng jiǎndān de kāishǐ.",
      "tr": "Önce kolay olandan başlayabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_021",
      "speaker": "同事",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_022",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_024",
      "speaker": "同事",
      "zh": "那就先写下来。",
      "pinyin": "Nà jiù xiān xiě xiàlái.",
      "tr": "O zaman önce yazalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_025",
      "speaker": "张伟",
      "zh": "今天早上大家都很忙。",
      "pinyin": "Jīntiān zǎoshàng dàjiā dōu hěn máng.",
      "tr": "Bu sabah herkes çok meşgul."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_027",
      "speaker": "同事",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_028",
      "speaker": "张伟",
      "zh": "经理今天也来了。",
      "pinyin": "Jīnglǐ jīntiān yě lái le.",
      "tr": "Müdür bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_030",
      "speaker": "同事",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_031",
      "speaker": "张伟",
      "zh": "你看，这个家在这儿。",
      "pinyin": "Nǐ kàn, zhège jiā zài zhèér.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_032",
      "speaker": "刘梅",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_033",
      "speaker": "同事",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_034",
      "speaker": "张伟",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_035",
      "speaker": "刘梅",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_036",
      "speaker": "同事",
      "zh": "这样比刚才方便。",
      "pinyin": "Zhèyàng bǐ gāngcái fāngbiàn.",
      "tr": "Böyle yapmak az öncekinden daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_037",
      "speaker": "张伟",
      "zh": "这个办法我刚刚试过。",
      "pinyin": "Zhège bànfǎ wǒ gānggāng shì guò.",
      "tr": "Bu yöntemi az önce denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_038",
      "speaker": "刘梅",
      "zh": "那我们换个办法吧。",
      "pinyin": "Nà wǒmen huàngè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_039",
      "speaker": "同事",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_042",
      "speaker": "同事",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_045",
      "speaker": "同事",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_048",
      "speaker": "同事",
      "zh": "好了，问题终于解决了。",
      "pinyin": "Hǎo le, wèntí zhōngyú jiějué le.",
      "tr": "Tamam, sorun sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_049",
      "speaker": "张伟",
      "zh": "这件事让我学到了不少。",
      "pinyin": "Zhèjiàn shì ràngwǒxué dào le bùshǎo.",
      "tr": "Bu olay bana epey şey öğretti."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_050",
      "speaker": "刘梅",
      "zh": "下次我们会准备得更好。",
      "pinyin": "Xiàcì wǒmen huì zhǔnbèi dé gènghǎo.",
      "tr": "Bir dahaki sefere daha iyi hazırlanırız."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_051",
      "speaker": "同事",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC006_054",
      "speaker": "同事",
      "zh": "嗯，张伟今天要加班。",
      "pinyin": "En, zhāngwěi jīntiān yào jiābān.",
      "tr": "Zhang Wei bugün fazla mesai yapacak."
