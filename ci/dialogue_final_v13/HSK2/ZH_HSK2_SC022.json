{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC022",
  "level": "HSK2",
  "sceneCategory": "health",
  "sourceTitleZh": "雨桐的比赛",
  "sourceTitleTr": "Yutong’un Spor Maçı",
  "sourceMiniAdventureTr": "Aile Yutong’un maçına yetişmeye çalışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC022_001",
      "speaker": "张雨桐",
      "zh": "雨桐的比赛快开始了。",
      "pinyin": "Yǔtóng de bǐsài kuài kāishǐ le.",
      "tr": "Yutong’un maçı başlamak üzere."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_002",
      "speaker": "张伟",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_003",
      "speaker": "刘梅",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_004",
      "speaker": "队友",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_005",
      "speaker": "张雨桐",
      "zh": "比赛马上开始了。",
      "pinyin": "Bǐsài mǎshàng kāishǐ le.",
      "tr": "Maç birazdan başlayacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_006",
      "speaker": "张伟",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_007",
      "speaker": "刘梅",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_008",
      "speaker": "队友",
      "zh": "我们今天赢了比赛。",
      "pinyin": "Wǒmen jīntiān yíng le bǐsài.",
      "tr": "Bugünkü maçı kazandık."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_009",
      "speaker": "张雨桐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_010",
      "speaker": "张伟",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_011",
      "speaker": "刘梅",
      "zh": "输了也没关系。",
      "pinyin": "Shū le yě méiguānxì.",
      "tr": "Kaybetsek de sorun değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_012",
      "speaker": "队友",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_014",
      "speaker": "张伟",
      "zh": "加油，你可以的！",
      "pinyin": "Jiāyóu, nǐ kěyǐ de!",
      "tr": "Haydi, yapabilirsin!"
    },
    {
      "id": "DLG_ZH_HSK2_SC022_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_016",
      "speaker": "队友",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_017",
      "speaker": "张雨桐",
      "zh": "我们差一点来晚了。",
      "pinyin": "Wǒmen chàyìdiǎn láiwǎn le.",
      "tr": "Neredeyse geç kalıyorduk."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC022_019",
      "speaker": "刘梅",
      "zh": "别着急，总会有办法的。",
      "pinyin": "Biézháojí, zǒnghuì yǒu bànfǎ de.",
      "tr": "Telaşlanma, mutlaka bir çözüm buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_020",
      "speaker": "队友",
      "zh": "要不先做最简单的？",
      "pinyin": "Yào bù xiān zuò zuì jiǎndān de?",
      "tr": "Önce en kolay olanı yapsak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC022_021",
      "speaker": "张雨桐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_022",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu takım burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_024",
      "speaker": "队友",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_025",
      "speaker": "张雨桐",
      "zh": "我最近常常运动。",
      "pinyin": "Wǒ zuìjìn chángcháng yùndòng.",
      "tr": "Son zamanlarda sık sık spor yapıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_028",
      "speaker": "队友",
      "zh": "快一点，不然来不及了。",
      "pinyin": "Kuài yìdiǎn, bùrán láibùjí le.",
      "tr": "Biraz hızlı ol, yoksa yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_029",
      "speaker": "张雨桐",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_031",
      "speaker": "刘梅",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_032",
      "speaker": "队友",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_033",
      "speaker": "张雨桐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_034",
      "speaker": "张伟",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_035",
      "speaker": "刘梅",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_036",
      "speaker": "队友",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_037",
      "speaker": "张雨桐",
      "zh": "刚才我试过这个办法。",
      "pinyin": "Gāngcái wǒshì guò zhège bànfǎ.",
      "tr": "Az önce bu yöntemi denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_038",
      "speaker": "张伟",
      "zh": "这个不行，就换一个。",
      "pinyin": "Zhège bùxíng, jiù huàn yígè.",
      "tr": "Bu olmazsa başka birini deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_040",
      "speaker": "队友",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_041",
      "speaker": "张雨桐",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_044",
      "speaker": "队友",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_045",
      "speaker": "张雨桐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_048",
      "speaker": "队友",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_049",
      "speaker": "张雨桐",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_050",
      "speaker": "张伟",
      "zh": "这次记住了，下次会更顺利。",
      "pinyin": "Zhècì jìzhù le, xiàcì huì gèng shùnlì.",
      "tr": "Bu kez öğrendik; bir dahaki sefere daha sorunsuz olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_052",
      "speaker": "队友",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_053",
      "speaker": "张雨桐",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_054",
      "speaker": "张伟",
      "zh": "嗯，比赛马上开始了。",
      "pinyin": "En, bǐsài mǎshàng kāishǐ le.",
      "tr": "Maç birazdan başlayacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_055",
      "speaker": "刘梅",
      "zh": "嗯，我记住了。",
      "pinyin": "En, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_056",
      "speaker": "队友",
      "zh": "嗯，我们今天赢了比赛。",
      "pinyin": "En, wǒmen jīntiān yíng le bǐsài.",
      "tr": "Bugünkü maçı kazandık."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_057",
      "speaker": "张雨桐",
      "zh": "这个办法很实用。",
      "pinyin": "Zhège bànfǎ hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_058",
      "speaker": "张伟",
      "zh": "嗯，输了也没关系。",
      "pinyin": "En, shū le yě méiguānxì.",
      "tr": "Kaybetsek de sorun değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_059",
      "speaker": "刘梅",
      "zh": "这个以后还会用。",
      "pinyin": "Zhège yǐhòu háihuìyòng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_060",
      "speaker": "队友",
      "zh": "加油，你可以的！",
      "pinyin": "Jiāyóu, nǐ kěyǐ de!",
      "tr": "Haydi, yapabilirsin!"
    },
    {
      "id": "DLG_ZH_HSK2_SC022_061",
      "speaker": "张雨桐",
      "zh": "我再说一遍。",
      "pinyin": "Wǒ zàishuō yībiàn.",
      "tr": "Bir kez daha söyleyeyim."
    },
