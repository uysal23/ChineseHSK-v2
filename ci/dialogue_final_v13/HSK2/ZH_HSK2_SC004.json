      "zh": "嗯，我们先等。",
      "pinyin": "En, wǒmen xiān děng.",
      "tr": "Önce beklemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_059",
      "speaker": "刘梅",
      "zh": "这个以后还会用。",
      "pinyin": "Zhège yǐhòu háihuìyòng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_060",
      "speaker": "邻居",
      "zh": "嗯，邻居今天也来了。",
      "pinyin": "En, línjū jīntiān yě lái le.",
      "tr": "Komşu bugün de geldi."
    },
