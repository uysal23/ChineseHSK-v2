{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC032",
  "level": "HSK2",
  "sceneCategory": "family",
  "sourceTitleZh": "给爷爷奶奶寄包裹",
  "sourceTitleTr": "Postanede Paket",
  "sourceMiniAdventureTr": "Aile büyüklerine hediye paketi gönderir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC032_001",
      "speaker": "张伟",
      "zh": "我们要给爷爷奶奶寄包裹。",
      "pinyin": "Wǒmen yào gěi yéyénǎinǎi jì bāoguǒ.",
      "tr": "Büyükanne ve büyükbabaya paket göndereceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_002",
      "speaker": "刘梅",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_003",
      "speaker": "邮局工作人员",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_004",
      "speaker": "张伟",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_005",
      "speaker": "刘梅",
      "zh": "你看，这个包裹在这儿。",
      "pinyin": "Nǐ kàn, zhège bāoguǒ zài zhèér.",
      "tr": "Bu paket burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_006",
      "speaker": "邮局工作人员",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_007",
      "speaker": "张伟",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_008",
      "speaker": "刘梅",
      "zh": "我们先寄。",
      "pinyin": "Wǒmen xiānjì.",
      "tr": "Önce göndermek."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_009",
      "speaker": "邮局工作人员",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_010",
      "speaker": "张伟",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_011",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu adres burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_012",
      "speaker": "邮局工作人员",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_014",
      "speaker": "刘梅",
      "zh": "大概三天能到。",
      "pinyin": "Dàgài sāntiān néng dào.",
      "tr": "Yaklaşık üç günde ulaşır."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_015",
      "speaker": "邮局工作人员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_017",
      "speaker": "刘梅",
      "zh": "这个地址写得对吗？",
      "pinyin": "Zhège dìzhǐ xiě dé duì ma?",
      "tr": "Bu adres doğru yazılmış mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_018",
      "speaker": "邮局工作人员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_019",
      "speaker": "张伟",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_020",
      "speaker": "刘梅",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_021",
      "speaker": "邮局工作人员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_022",
      "speaker": "张伟",
      "zh": "大概几天能到？",
      "pinyin": "Dàgài jǐtiān néng dào?",
      "tr": "Yaklaşık kaç günde ulaşır?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_024",
      "speaker": "邮局工作人员",
      "zh": "好，这一点先记着。",
      "pinyin": "Hǎo, zhè yìdiǎn xiānjì zhe.",
      "tr": "Tamam, bu noktayı aklımızda tutalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_025",
      "speaker": "张伟",
      "zh": "邮局离这里不远。",
      "pinyin": "Yóujú lí zhèlǐ bùyuǎn.",
      "tr": "Postane buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_027",
      "speaker": "邮局工作人员",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_028",
      "speaker": "张伟",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéyénǎinǎi jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_030",
      "speaker": "邮局工作人员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_031",
      "speaker": "张伟",
      "zh": "你看，这个礼物在这儿。",
      "pinyin": "Nǐ kàn, zhège lǐwù zài zhèér.",
      "tr": "Bu hediye burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_032",
      "speaker": "刘梅",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_033",
      "speaker": "邮局工作人员",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_034",
      "speaker": "张伟",
      "zh": "时间不多了，我们快一点吧。",
      "pinyin": "Shíjiān bùduō le, wǒmen kuài yìdiǎn ba.",
      "tr": "Fazla zaman kalmadı, biraz hızlanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_035",
      "speaker": "刘梅",
      "zh": "好，先这个，后面再做下一个。",
      "pinyin": "Hǎo, xiān zhège, hòumiàn zài zuò xià yígè.",
      "tr": "Tamam, önce bu; sonra diğerini yaparız."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_036",
      "speaker": "邮局工作人员",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_037",
      "speaker": "张伟",
      "zh": "刚才我试过这个办法。",
      "pinyin": "Gāngcái wǒshì guò zhège bànfǎ.",
      "tr": "Az önce bu yöntemi denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_038",
      "speaker": "刘梅",
      "zh": "那我们换个方法看看。",
      "pinyin": "Nà wǒmen huàngè fāngfǎ kànkàn.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_039",
      "speaker": "邮局工作人员",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_042",
      "speaker": "邮局工作人员",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_045",
      "speaker": "邮局工作人员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_048",
      "speaker": "邮局工作人员",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_049",
      "speaker": "张伟",
      "zh": "以后遇到这种情况就知道怎么办了。",
      "pinyin": "Yǐhòu yùdào zhèzhǒng qíngkuàng jiù zhīdào zěnmebàn le.",
      "tr": "Bundan sonra böyle bir durumda ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_050",
      "speaker": "刘梅",
      "zh": "下次我们会准备得更好。",
      "pinyin": "Xiàcì wǒmen huì zhǔnbèi dé gènghǎo.",
      "tr": "Bir dahaki sefere daha iyi hazırlanırız."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_051",
      "speaker": "邮局工作人员",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_054",
      "speaker": "邮局工作人员",
      "zh": "嗯，你看，这个包裹在这儿。",
      "pinyin": "En, nǐ kàn, zhège bāoguǒ zài zhèér.",
      "tr": "Bu paket burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_055",
      "speaker": "张伟",
      "zh": "嗯，我记住了。",
      "pinyin": "En, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_056",
      "speaker": "刘梅",
      "zh": "嗯，我们先寄。",
      "pinyin": "En, wǒmen xiānjì.",
      "tr": "Önce göndermek."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_057",
      "speaker": "邮局工作人员",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
