      "zh": "嗯，我们先装饰。",
      "pinyin": "En, wǒmen xiān zhuāngshì.",
      "tr": "Önce süslemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC041_059",
      "speaker": "张乐乐",
      "zh": "以后还用得上。",
      "pinyin": "Yǐhòu hái yòngdéshàng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
