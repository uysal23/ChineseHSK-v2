{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC043",
  "level": "HSK2",
  "sceneCategory": "family",
  "sourceTitleZh": "爷爷寄来的蔬菜",
  "sourceTitleTr": "Büyükbabanın Sebzeleri",
  "sourceMiniAdventureTr": "Çiftlikten taze sebze kutusu gelir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC043_001",
      "speaker": "张伟",
      "zh": "爷爷从农场寄来一箱蔬菜。",
      "pinyin": "Yéyé cóng nóngchǎng jì lái yīxiāng shūcài.",
      "tr": "Büyükbaba çiftlikten bir kutu sebze gönderdi."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_002",
      "speaker": "刘梅",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_003",
      "speaker": "张乐乐",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_004",
      "speaker": "爷爷",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_005",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_006",
      "speaker": "刘梅",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_007",
      "speaker": "张乐乐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_008",
      "speaker": "爷爷",
      "zh": "这些菜特别新鲜。",
      "pinyin": "Zhèxiē cài tèbié xīnxiān.",
      "tr": "Bu sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_010",
      "speaker": "刘梅",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_011",
      "speaker": "张乐乐",
      "zh": "我们先种。",
      "pinyin": "Wǒmen xiānzhǒng.",
      "tr": "Önce yetiştirmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_012",
      "speaker": "爷爷",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_014",
      "speaker": "刘梅",
      "zh": "这个箱子在这里。",
      "pinyin": "Zhège xiāngzi zài zhèlǐ.",
      "tr": "Bu kutu burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_016",
      "speaker": "爷爷",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_017",
      "speaker": "张伟",
      "zh": "这么多，而且特别新鲜。",
      "pinyin": "Zhème duō, érqiě tèbié xīnxiān.",
      "tr": "Bu kadar çok ve üstelik çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC043_019",
      "speaker": "张乐乐",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_020",
      "speaker": "爷爷",
      "zh": "要不先做最简单的？",
      "pinyin": "Yào bù xiān zuò zuì jiǎndān de?",
      "tr": "Önce en kolay olanı yapsak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC043_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_022",
      "speaker": "刘梅",
      "zh": "怎么会有这么多？",
      "pinyin": "Zěnme huì yǒu zhème duō?",
      "tr": "Nasıl bu kadar çok olabilir?"
    },
    {
      "id": "DLG_ZH_HSK2_SC043_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_024",
      "speaker": "爷爷",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_025",
      "speaker": "张伟",
      "zh": "农场离这里不远。",
      "pinyin": "Nóngchǎng lí zhèlǐ bùyuǎn.",
      "tr": "Çiftlik buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_028",
      "speaker": "爷爷",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéyénǎinǎi jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_031",
      "speaker": "张乐乐",
      "zh": "你看，这个食物在这儿。",
      "pinyin": "Nǐ kàn, zhège shíwù zài zhèér.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_032",
      "speaker": "爷爷",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_034",
      "speaker": "刘梅",
      "zh": "先快一点做，等会儿再检查。",
      "pinyin": "Xiānkuài yìdiǎn zuò, děnghuìer zài jiǎnchá.",
      "tr": "Önce biraz hızlı yapalım, sonra yeniden kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_035",
      "speaker": "张乐乐",
      "zh": "好，先这个，后面再做下一个。",
      "pinyin": "Hǎo, xiān zhège, hòumiàn zài zuò xià yígè.",
      "tr": "Tamam, önce bu; sonra diğerini yaparız."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_036",
      "speaker": "爷爷",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_037",
      "speaker": "张伟",
      "zh": "这个办法我刚刚试过。",
      "pinyin": "Zhège bànfǎ wǒ gānggāng shì guò.",
      "tr": "Bu yöntemi az önce denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_038",
      "speaker": "刘梅",
      "zh": "那我们换个办法吧。",
      "pinyin": "Nà wǒmen huàngè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_040",
      "speaker": "爷爷",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_044",
      "speaker": "爷爷",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_048",
      "speaker": "爷爷",
      "zh": "终于好了，我放心了。",
      "pinyin": "Zhōngyú hǎo le, wǒ fàngxīn le.",
      "tr": "Sonunda düzeldi, içim rahatladı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_049",
      "speaker": "张伟",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_050",
      "speaker": "刘梅",
      "zh": "下次再遇到就容易多了。",
      "pinyin": "Xiàcì zài yùdào jiù róngyì duō le.",
      "tr": "Bir daha olursa çok daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_051",
      "speaker": "张乐乐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_052",
      "speaker": "爷爷",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_054",
      "speaker": "刘梅",
      "zh": "你看，这个蔬菜在这儿。",
      "pinyin": "Nǐ kàn, zhège shūcài zài zhèér.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_055",
      "speaker": "张乐乐",
      "zh": "好，我会记着。",
      "pinyin": "Hǎo, wǒhuì jìzhe.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_056",
      "speaker": "爷爷",
      "zh": "嗯，这些菜特别新鲜。",
      "pinyin": "En, zhèxiē cài tèbié xīnxiān.",
      "tr": "Bu sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_057",
      "speaker": "张伟",
      "zh": "嗯，这个很有用。",
      "pinyin": "En, zhège hěn yǒuyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_058",
      "speaker": "刘梅",
      "zh": "嗯，我们先种。",
      "pinyin": "En, wǒmen xiānzhǒng.",
      "tr": "Önce yetiştirmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_059",
      "speaker": "张乐乐",
      "zh": "以后还用得上。",
      "pinyin": "Yǐhòu hái yòngdéshàng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_060",
      "speaker": "爷爷",
      "zh": "你看，这个箱子在这儿。",
      "pinyin": "Nǐ kàn, zhège xiāngzi zài zhèér.",
      "tr": "Bu kutu burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_061",
      "speaker": "张伟",
      "zh": "好，我再说一次。",
