{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC031",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "去银行开户",
  "sourceTitleTr": "Bankada Yeni Hesap",
  "sourceMiniAdventureTr": "Zhang bazı belgeleri unuttuğunu fark eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC031_001",
      "speaker": "张伟",
      "zh": "我想开一个银行账户。",
      "pinyin": "Wǒ xiǎngkāi yígè yínháng zhànghù.",
      "tr": "Bir banka hesabı açmak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_002",
      "speaker": "银行工作人员",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_003",
      "speaker": "刘梅",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_004",
      "speaker": "张伟",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_005",
      "speaker": "银行工作人员",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu hesap burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_006",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_007",
      "speaker": "张伟",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_008",
      "speaker": "银行工作人员",
      "zh": "这个身份证在这里。",
      "pinyin": "Zhège shēnfènzhèng zài zhèlǐ.",
      "tr": "Bu kimlik kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_009",
      "speaker": "刘梅",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_010",
      "speaker": "张伟",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_011",
      "speaker": "银行工作人员",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Bu form burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_012",
      "speaker": "刘梅",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_014",
      "speaker": "银行工作人员",
      "zh": "我们先签字。",
      "pinyin": "Wǒmen xiān qiānzì.",
      "tr": "Önce imza atmak."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_017",
      "speaker": "银行工作人员",
      "zh": "还需要身份证和一份材料。",
      "pinyin": "Hái xūyào shēnfènzhèng hé yīfèn cáiliào.",
      "tr": "Kimlik ve bir evrak daha gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC031_019",
      "speaker": "张伟",
      "zh": "先别慌，看看还有什么办法。",
      "pinyin": "Xiānbié huāng, kànkàn háiyǒu shénme bànfǎ.",
      "tr": "Panik yapmayalım, başka ne yapabiliriz bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_020",
      "speaker": "银行工作人员",
      "zh": "要不先做最简单的？",
      "pinyin": "Yào bù xiān zuò zuì jiǎndān de?",
      "tr": "Önce en kolay olanı yapsak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC031_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_022",
      "speaker": "张伟",
      "zh": "你看，这个材料在这儿。",
      "pinyin": "Nǐ kàn, zhège cáiliào zài zhèér.",
      "tr": "Bu belge / evrak burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_023",
      "speaker": "银行工作人员",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_024",
      "speaker": "刘梅",
      "zh": "好，把这个记下来吧。",
      "pinyin": "Hǎo, bǎ zhège jìxiàlái ba.",
      "tr": "Tamam, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_025",
      "speaker": "张伟",
      "zh": "银行离这里不远。",
      "pinyin": "Yínháng lí zhèlǐ bùyuǎn.",
      "tr": "Banka buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_026",
      "speaker": "银行工作人员",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_028",
      "speaker": "张伟",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_029",
      "speaker": "银行工作人员",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_031",
      "speaker": "张伟",
      "zh": "我们先检查。",
      "pinyin": "Wǒmen xiān jiǎnchá.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_032",
      "speaker": "银行工作人员",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_034",
      "speaker": "张伟",
      "zh": "时间有点紧，我们动作快一点。",
      "pinyin": "Shíjiān yǒudiǎn jǐn, wǒmen dòngzuò kuài yìdiǎn.",
      "tr": "Zaman biraz sıkışık, biraz hızlı hareket edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_035",
      "speaker": "银行工作人员",
      "zh": "这个做完以后再做下一个。",
      "pinyin": "Zhège zuò wán yǐhòu zài zuò xià yígè.",
      "tr": "Bunu bitirdikten sonra diğerini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_036",
      "speaker": "刘梅",
      "zh": "我觉得这个办法更好。",
      "pinyin": "Wǒ juéde zhège bànfǎ gènghǎo.",
      "tr": "Bence bu yöntem daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_037",
      "speaker": "张伟",
      "zh": "这个办法我刚刚试过。",
      "pinyin": "Zhège bànfǎ wǒ gānggāng shì guò.",
      "tr": "Bu yöntemi az önce denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_038",
      "speaker": "银行工作人员",
      "zh": "不行的话就换一个办法。",
      "pinyin": "Bùxíng dehuà jiù huàn yígè bànfǎ.",
      "tr": "Olmazsa başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_041",
      "speaker": "银行工作人员",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_044",
      "speaker": "银行工作人员",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_047",
      "speaker": "银行工作人员",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_048",
      "speaker": "刘梅",
      "zh": "终于好了，我放心了。",
      "pinyin": "Zhōngyú hǎo le, wǒ fàngxīn le.",
      "tr": "Sonunda düzeldi, içim rahatladı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_049",
      "speaker": "张伟",
      "zh": "这次我们也学到东西了。",
      "pinyin": "Zhècì wǒmen yě xuédào dōngxī le.",
      "tr": "Bu sefer de bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_050",
      "speaker": "银行工作人员",
      "zh": "有了这次经验，下次就知道怎么办了。",
      "pinyin": "Yǒu le zhècì jīngyàn, xiàcì jiù zhīdào zěnmebàn le.",
      "tr": "Bu deneyim sayesinde bir dahaki sefere ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_053",
      "speaker": "银行工作人员",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_054",
      "speaker": "刘梅",
      "zh": "这个账户在这里。",
      "pinyin": "Zhège zhànghù zài zhèlǐ.",
      "tr": "Bu hesap burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_055",
      "speaker": "张伟",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_056",
      "speaker": "银行工作人员",
      "zh": "你看，这个身份证在这儿。",
      "pinyin": "Nǐ kàn, zhège shēnfènzhèng zài zhèér.",
      "tr": "Bu kimlik kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_057",
      "speaker": "刘梅",
      "zh": "嗯，这个很有用。",
      "pinyin": "En, zhège hěn yǒuyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_058",
      "speaker": "张伟",
      "zh": "这个表格在这里。",
      "pinyin": "Zhège biǎogé zài zhèlǐ.",
      "tr": "Bu form burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_059",
      "speaker": "银行工作人员",
      "zh": "以后也会用到。",
      "pinyin": "Yǐhòu yě huì yòngdào.",
