{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC017",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "买冬衣",
  "sourceTitleTr": "İlk Kışlık Alışveriş",
  "sourceMiniAdventureTr": "Çocukların bedenleri karışır ve kıyafetler değiştirilir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC017_001",
      "speaker": "刘梅",
      "zh": "天气冷了，该买冬衣了。",
      "pinyin": "Tiānqì lěng le, gāi mǎi dōngyī le.",
      "tr": "Hava soğudu, kışlık kıyafet alma zamanı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_002",
      "speaker": "张雨桐",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_003",
      "speaker": "张乐乐",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_004",
      "speaker": "店员",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_005",
      "speaker": "刘梅",
      "zh": "你看，这个冬衣在这儿。",
      "pinyin": "Nǐ kàn, zhège dōngyī zài zhèér.",
      "tr": "Bu kışlık kıyafet burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_006",
      "speaker": "张雨桐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_007",
      "speaker": "张乐乐",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_008",
      "speaker": "店员",
      "zh": "这个尺码不太合适。",
      "pinyin": "Zhège chǐmǎ bùtài héshì.",
      "tr": "Bu beden pek uygun değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_009",
      "speaker": "刘梅",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_010",
      "speaker": "张雨桐",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_011",
      "speaker": "张乐乐",
      "zh": "我们先试。",
      "pinyin": "Wǒmen xiānshì.",
      "tr": "Önce denemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_012",
      "speaker": "店员",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_014",
      "speaker": "张雨桐",
      "zh": "我想试大一点的。",
      "pinyin": "Wǒxiǎng shìdà yìdiǎn de.",
      "tr": "Biraz daha büyüğünü denemek istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_016",
      "speaker": "店员",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_017",
      "speaker": "刘梅",
      "zh": "这个尺码太小。",
      "pinyin": "Zhège chǐmǎ tàixiǎo.",
      "tr": "Bu beden çok küçük."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_018",
      "speaker": "张雨桐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC017_019",
      "speaker": "张乐乐",
      "zh": "先冷静一下，我们再想想怎么办。",
      "pinyin": "Xiān lěngjìng yīxià, wǒmen zài xiǎngxiǎng zěnmebàn.",
      "tr": "Önce sakinleşelim, sonra ne yapacağımızı düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_020",
      "speaker": "店员",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_022",
      "speaker": "张雨桐",
      "zh": "有没有小一点的？",
      "pinyin": "Yǒuméiyǒu xiǎo yìdiǎn de?",
      "tr": "Biraz daha küçüğü var mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC017_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_024",
      "speaker": "店员",
      "zh": "好，这一点先记着。",
      "pinyin": "Hǎo, zhè yìdiǎn xiānjì zhe.",
      "tr": "Tamam, bu noktayı aklımızda tutalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_025",
      "speaker": "刘梅",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_026",
      "speaker": "张雨桐",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_028",
      "speaker": "店员",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_030",
      "speaker": "张雨桐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_031",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu kış burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_032",
      "speaker": "店员",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_034",
      "speaker": "张雨桐",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_035",
      "speaker": "张乐乐",
      "zh": "先做这个，然后再做下一个。",
      "pinyin": "Xiān zuò zhège, ránhòu zài zuò xià yígè.",
      "tr": "Önce bunu yapalım, sonra diğerine geçeriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_036",
      "speaker": "店员",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_037",
      "speaker": "刘梅",
      "zh": "这个办法我刚刚试过。",
      "pinyin": "Zhège bànfǎ wǒ gānggāng shì guò.",
      "tr": "Bu yöntemi az önce denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_038",
      "speaker": "张雨桐",
      "zh": "那我们换个办法吧。",
      "pinyin": "Nà wǒmen huàngè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_040",
      "speaker": "店员",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_042",
      "speaker": "张雨桐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_044",
      "speaker": "店员",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_048",
      "speaker": "店员",
      "zh": "好了，问题终于解决了。",
      "pinyin": "Hǎo le, wèntí zhōngyú jiějué le.",
      "tr": "Tamam, sorun sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_049",
      "speaker": "刘梅",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_050",
      "speaker": "张雨桐",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_051",
      "speaker": "张乐乐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_052",
      "speaker": "店员",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
