    },
    {
      "id": "DLG_ZH_HSK2_SC008_059",
      "speaker": "刘梅",
      "zh": "以后还用得上。",
      "pinyin": "Yǐhòu hái yòngdéshàng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_060",
