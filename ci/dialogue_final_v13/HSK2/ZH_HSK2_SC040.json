{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC040",
  "level": "HSK2",
  "sceneCategory": "health",
  "sourceTitleZh": "全家运动计划",
  "sourceTitleTr": "Ailece Egzersiz Kararı",
  "sourceMiniAdventureTr": "Aile düzenli yürüyüş yapmaya karar verir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC040_001",
      "speaker": "张伟",
      "zh": "我们需要一个全家运动计划。",
      "pinyin": "Wǒmen xūyào yígè quánjiā yùndòng jìhuà.",
      "tr": "Ailece bir egzersiz planına ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_002",
      "speaker": "刘梅",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_003",
      "speaker": "张乐乐",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_004",
      "speaker": "张雨桐",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_005",
      "speaker": "张伟",
      "zh": "我们先走路。",
      "pinyin": "Wǒmen xiān zǒulù.",
      "tr": "Önce yürümek."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_006",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_007",
      "speaker": "张乐乐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_008",
      "speaker": "张雨桐",
      "zh": "我们每天都走一走。",
      "pinyin": "Wǒmen měitiān dōu zǒu yī zǒu.",
      "tr": "Her gün biraz yürüyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_010",
      "speaker": "刘梅",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_011",
      "speaker": "张乐乐",
      "zh": "我们每周运动三次。",
      "pinyin": "Wǒmen měizhōu yùndòng sāncì.",
      "tr": "Haftada üç kez egzersiz yapıyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_012",
      "speaker": "张雨桐",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_014",
      "speaker": "刘梅",
      "zh": "我们先坚持。",
      "pinyin": "Wǒmen xiān jiānchí.",
      "tr": "Önce devam etmek / sürdürmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_017",
      "speaker": "张伟",
      "zh": "只做一天没有用。",
      "pinyin": "Zhǐ zuò yītiān méiyǒu yòng.",
      "tr": "Sadece bir gün yapmak işe yaramaz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC040_019",
      "speaker": "张乐乐",
      "zh": "没关系，我们先想个办法。",
      "pinyin": "Méiguānxì, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Sorun değil, önce bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_020",
      "speaker": "张雨桐",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_022",
      "speaker": "刘梅",
      "zh": "这个计划很实际。",
      "pinyin": "Zhège jìhuà hěn shíjì.",
      "tr": "Bu plan oldukça gerçekçi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_024",
      "speaker": "张雨桐",
      "zh": "那我们先记下来。",
      "pinyin": "Nà wǒmen xiān jìxiàlái.",
      "tr": "O zaman önce not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_025",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_028",
      "speaker": "张雨桐",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_031",
      "speaker": "张乐乐",
      "zh": "我们先运动。",
      "pinyin": "Wǒmen xiān yùndòng.",
      "tr": "Önce egzersiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_032",
      "speaker": "张雨桐",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，我们得快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, wǒmen dé kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olmalıyız."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_035",
      "speaker": "张乐乐",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_036",
      "speaker": "张雨桐",
      "zh": "这样比刚才方便。",
      "pinyin": "Zhèyàng bǐ gāngcái fāngbiàn.",
      "tr": "Böyle yapmak az öncekinden daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_037",
      "speaker": "张伟",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_038",
      "speaker": "刘梅",
      "zh": "那我们换个办法吧。",
      "pinyin": "Nà wǒmen huàngè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_044",
      "speaker": "张雨桐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_048",
      "speaker": "张雨桐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_049",
      "speaker": "张伟",
      "zh": "这件事让我学到了不少。",
      "pinyin": "Zhèjiàn shì ràngwǒxué dào le bùshǎo.",
      "tr": "Bu olay bana epey şey öğretti."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_050",
      "speaker": "刘梅",
      "zh": "下次再遇到就容易多了。",
      "pinyin": "Xiàcì zài yùdào jiù róngyì duō le.",
      "tr": "Bir daha olursa çok daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_051",
      "speaker": "张乐乐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_054",
