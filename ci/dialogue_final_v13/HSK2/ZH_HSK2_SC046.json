{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC046",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "雨桐有了好朋友",
  "sourceTitleTr": "Yutong’un Yeni Yakın Arkadaşı",
  "sourceMiniAdventureTr": "Yutong yeni yakın arkadaşıyla ortak ilgi alanlarını keşfeder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC046_001",
      "speaker": "张雨桐",
      "zh": "雨桐有了一个很合得来的朋友。",
      "pinyin": "Yǔtóng yǒu le yígè hěn hédelái de péngyǒu.",
      "tr": "Yutong çok iyi anlaştığı bir arkadaş edindi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_002",
      "speaker": "好朋友",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_003",
      "speaker": "刘梅",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_004",
      "speaker": "张雨桐",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_005",
      "speaker": "好朋友",
      "zh": "好朋友今天也来了。",
      "pinyin": "Hǎo péngyǒu jīntiān yě lái le.",
      "tr": "Yakın arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_006",
      "speaker": "刘梅",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_007",
      "speaker": "张雨桐",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_008",
      "speaker": "好朋友",
      "zh": "我们的爱好很像。",
      "pinyin": "Wǒmen de àihào hěn xiàng.",
      "tr": "Hobilerimiz birbirine çok benziyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_009",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_010",
      "speaker": "张雨桐",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_011",
      "speaker": "好朋友",
      "zh": "我们常常一起学习。",
      "pinyin": "Wǒmen chángcháng yìqǐ xuéxí.",
      "tr": "Sık sık birlikte ders çalışıyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_012",
      "speaker": "刘梅",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_014",
      "speaker": "好朋友",
      "zh": "我们有一样的爱好。",
      "pinyin": "Wǒmen yǒu yīyàng de àihào.",
      "tr": "Aynı hobilere sahibiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_017",
      "speaker": "好朋友",
      "zh": "她们有很多一样的爱好。",
      "pinyin": "Tāmen yǒu hěnduō yīyàng de àihào.",
      "tr": "Birçok ortak hobileri var."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC046_019",
      "speaker": "张雨桐",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_020",
      "speaker": "好朋友",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_022",
      "speaker": "张雨桐",
      "zh": "我们一起做吧。",
      "pinyin": "Wǒmen yìqǐ zuò ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_023",
      "speaker": "好朋友",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_024",
      "speaker": "刘梅",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_025",
      "speaker": "张雨桐",
      "zh": "雨桐很喜欢音乐。",
      "pinyin": "Yǔtóng hěn xǐhuān yīnyuè.",
      "tr": "Yutong müziği çok seviyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_026",
      "speaker": "好朋友",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_028",
      "speaker": "张雨桐",
      "zh": "我最近常常运动。",
      "pinyin": "Wǒ zuìjìn chángcháng yùndòng.",
      "tr": "Son zamanlarda sık sık spor yapıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_029",
      "speaker": "好朋友",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_031",
      "speaker": "张雨桐",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_032",
      "speaker": "好朋友",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_034",
      "speaker": "张雨桐",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_035",
      "speaker": "好朋友",
      "zh": "我们一个一个来，先做这个。",
      "pinyin": "Wǒmen yígè yígè lái, xiān zuò zhège.",
      "tr": "Tek tek ilerleyelim, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_036",
      "speaker": "刘梅",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_037",
      "speaker": "张雨桐",
      "zh": "这个我试过一次。",
      "pinyin": "Zhège wǒshì guò yīcì.",
      "tr": "Bunu bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_038",
      "speaker": "好朋友",
      "zh": "好，我们换一种做法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng zuòfǎ.",
      "tr": "Tamam, başka bir yöntem kullanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_041",
      "speaker": "好朋友",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_044",
      "speaker": "好朋友",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_047",
      "speaker": "好朋友",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_048",
      "speaker": "刘梅",
      "zh": "太好了，这件事解决了。",
      "pinyin": "Tàihǎole, zhèjiàn shì jiějué le.",
      "tr": "Harika, bu işi çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_049",
      "speaker": "张雨桐",
      "zh": "这件事让我学到了不少。",
      "pinyin": "Zhèjiàn shì ràngwǒxué dào le bùshǎo.",
      "tr": "Bu olay bana epey şey öğretti."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_050",
      "speaker": "好朋友",
      "zh": "下次我们会准备得更好。",
      "pinyin": "Xiàcì wǒmen huì zhǔnbèi dé gènghǎo.",
      "tr": "Bir dahaki sefere daha iyi hazırlanırız."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_053",
      "speaker": "好朋友",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_054",
      "speaker": "刘梅",
      "zh": "嗯，好朋友今天也来了。",
      "pinyin": "En, hǎo péngyǒu jīntiān yě lái le.",
      "tr": "Yakın arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_055",
