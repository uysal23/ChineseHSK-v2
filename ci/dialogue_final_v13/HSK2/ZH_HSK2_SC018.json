{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC018",
  "level": "HSK2",
  "sceneCategory": "travel",
  "sourceTitleZh": "忘在公交车上的包",
  "sourceTitleTr": "Otobüste Unutulan Çanta",
  "sourceMiniAdventureTr": "Yutong çantasını otobüste unutur ve kayıp eşya bürosuna gider.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC018_001",
      "speaker": "张雨桐",
      "zh": "我的包忘在公交车上了。",
      "pinyin": "Wǒ de bāowàng zài gōngjiāochē shàng le.",
      "tr": "Çantamı otobüste unuttum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_002",
      "speaker": "刘梅",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_003",
      "speaker": "工作人员",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_004",
      "speaker": "张雨桐",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_005",
      "speaker": "刘梅",
      "zh": "我的包好像丢了。",
      "pinyin": "Wǒ de bāo hǎoxiàng diū le.",
      "tr": "Sanırım çantam kayboldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_006",
      "speaker": "工作人员",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_008",
      "speaker": "刘梅",
      "zh": "我们去失物招领处问问。",
      "pinyin": "Wǒmen qù shīwùzhāolǐng chù wènwèn.",
      "tr": "Kayıp eşya bürosuna gidip soralım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_009",
      "speaker": "工作人员",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_010",
      "speaker": "张雨桐",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_011",
      "speaker": "刘梅",
      "zh": "里面还有东西。",
      "pinyin": "Lǐmiàn háiyǒu dōngxī.",
      "tr": "İçinde hâlâ bir şeyler var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_012",
      "speaker": "工作人员",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_014",
      "speaker": "刘梅",
      "zh": "你喜欢什么颜色？",
      "pinyin": "Nǐ xǐhuān shénme yánsè?",
      "tr": "Hangi rengi seviyorsun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC018_015",
      "speaker": "工作人员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_017",
      "speaker": "刘梅",
      "zh": "里面有书和钥匙。",
      "pinyin": "Lǐmiàn yǒushū hé yàoshi.",
      "tr": "İçinde kitap ve anahtar var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_018",
      "speaker": "工作人员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC018_019",
      "speaker": "张雨桐",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_020",
      "speaker": "刘梅",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_021",
      "speaker": "工作人员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_022",
      "speaker": "张雨桐",
      "zh": "我们先说明。",
      "pinyin": "Wǒmen xiān shuōmíng.",
      "tr": "Önce tarif etmek / açıklamak."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_024",
      "speaker": "工作人员",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_025",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_027",
      "speaker": "工作人员",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_028",
      "speaker": "张雨桐",
      "zh": "我终于找到了。",
      "pinyin": "Wǒ zhōngyú zhǎodào le.",
      "tr": "Sonunda buldum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_030",
      "speaker": "工作人员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_031",
      "speaker": "张雨桐",
      "zh": "我们先打电话。",
      "pinyin": "Wǒmen xiān dǎdiànhuà.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_032",
      "speaker": "刘梅",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_033",
      "speaker": "工作人员",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_034",
      "speaker": "张雨桐",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_035",
      "speaker": "刘梅",
      "zh": "先把这个完成，再看下一个。",
      "pinyin": "Xiān bǎ zhège wánchéng, zài kàn xià yígè.",
      "tr": "Önce bunu tamamlayalım, sonra diğerine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_036",
      "speaker": "工作人员",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_037",
      "speaker": "张雨桐",
      "zh": "这个办法我刚刚试过。",
      "pinyin": "Zhège bànfǎ wǒ gānggāng shì guò.",
      "tr": "Bu yöntemi az önce denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_038",
      "speaker": "刘梅",
      "zh": "好，我们换一种做法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng zuòfǎ.",
      "tr": "Tamam, başka bir yöntem kullanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_039",
      "speaker": "工作人员",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_042",
      "speaker": "工作人员",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_045",
      "speaker": "工作人员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_048",
      "speaker": "工作人员",
      "zh": "终于好了，我放心了。",
      "pinyin": "Zhōngyú hǎo le, wǒ fàngxīn le.",
      "tr": "Sonunda düzeldi, içim rahatladı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_049",
      "speaker": "张雨桐",
      "zh": "今天又学到了一点。",
      "pinyin": "Jīntiān yòu xuédào le yìdiǎn.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_050",
      "speaker": "刘梅",
      "zh": "有了这次经验，下次就知道怎么办了。",
      "pinyin": "Yǒu le zhècì jīngyàn, xiàcì jiù zhīdào zěnmebàn le.",
      "tr": "Bu deneyim sayesinde bir dahaki sefere ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_051",
      "speaker": "工作人员",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_054",
      "speaker": "工作人员",
      "zh": "嗯，我的包好像丢了。",
      "pinyin": "En, wǒ de bāo hǎoxiàng diū le.",
      "tr": "Sanırım çantam kayboldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_055",
      "speaker": "张雨桐",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_056",
      "speaker": "刘梅",
      "zh": "嗯，我们去失物招领处问问。",
      "pinyin": "En, wǒmen qù shīwùzhāolǐng chù wènwèn.",
      "tr": "Kayıp eşya bürosuna gidip soralım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_057",
      "speaker": "工作人员",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_058",
