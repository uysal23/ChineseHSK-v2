{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC024",
  "level": "HSK2",
  "sceneCategory": "family",
  "sourceTitleZh": "这个月怎么花钱？",
  "sourceTitleTr": "Aylık Bütçe Gecesi",
  "sourceMiniAdventureTr": "Aile aylık giderleri ve ihtiyaçları konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC024_001",
      "speaker": "张伟",
      "zh": "我们来看看这个月的预算。",
      "pinyin": "Wǒmen lái kànkàn zhège yuè de yùsuàn.",
      "tr": "Bu ayın bütçesine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_002",
      "speaker": "刘梅",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_003",
      "speaker": "张雨桐",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_004",
      "speaker": "张伟",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_005",
      "speaker": "刘梅",
      "zh": "这个月的预算有点紧。",
      "pinyin": "Zhège yuè de yùsuàn yǒudiǎn jǐn.",
      "tr": "Bu ayın bütçesi biraz sıkışık."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_006",
      "speaker": "张雨桐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_007",
      "speaker": "张伟",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_008",
      "speaker": "刘梅",
      "zh": "我们先花钱。",
      "pinyin": "Wǒmen xiān huāqián.",
      "tr": "Önce para harcamak."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_009",
      "speaker": "张雨桐",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_010",
      "speaker": "张伟",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_011",
      "speaker": "刘梅",
      "zh": "这个现在不是很必要。",
      "pinyin": "Zhège xiànzài búshì hěn bìyào.",
      "tr": "Bu şu anda çok gerekli değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_012",
      "speaker": "张雨桐",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_014",
      "speaker": "刘梅",
      "zh": "我们先省钱。",
      "pinyin": "Wǒmen xiān shěngqián.",
      "tr": "Önce para tasarrufu."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_017",
      "speaker": "刘梅",
      "zh": "有些东西现在不一定要买。",
      "pinyin": "Yǒuxiē dōngxī xiànzài bù yídìng yào mǎi.",
      "tr": "Bazı şeyleri şimdi almak şart değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_018",
      "speaker": "张雨桐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC024_019",
      "speaker": "张伟",
      "zh": "先别急，我们一起想办法。",
      "pinyin": "Xiān biéjí, wǒmen yìqǐ xiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, birlikte bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_020",
      "speaker": "刘梅",
      "zh": "要不先做最简单的？",
      "pinyin": "Yào bù xiān zuò zuì jiǎndān de?",
      "tr": "Önce en kolay olanı yapsak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC024_021",
      "speaker": "张雨桐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_022",
      "speaker": "张伟",
      "zh": "这个费用比我想的高。",
      "pinyin": "Zhège fèiyòng bǐ wǒ xiǎng de gāo.",
      "tr": "Bu masraf düşündüğümden daha yüksek."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_024",
      "speaker": "张雨桐",
      "zh": "好，把这个记下来吧。",
      "pinyin": "Hǎo, bǎ zhège jìxiàlái ba.",
      "tr": "Tamam, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_025",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_028",
      "speaker": "张伟",
      "zh": "一个月的时间过得很快。",
      "pinyin": "Yígèyuè de shíjiān guòdé hěnkuài.",
      "tr": "Bir aylık süre çok hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_030",
      "speaker": "张雨桐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_031",
      "speaker": "张伟",
      "zh": "这个计划很实际。",
      "pinyin": "Zhège jìhuà hěn shíjì.",
      "tr": "Bu plan oldukça gerçekçi."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_032",
      "speaker": "刘梅",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_033",
      "speaker": "张雨桐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_034",
      "speaker": "张伟",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_035",
      "speaker": "刘梅",
      "zh": "好，先这个，后面再做下一个。",
      "pinyin": "Hǎo, xiān zhège, hòumiàn zài zuò xià yígè.",
      "tr": "Tamam, önce bu; sonra diğerini yaparız."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_036",
      "speaker": "张雨桐",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_037",
      "speaker": "张伟",
      "zh": "我试过了，知道是什么情况。",
      "pinyin": "Wǒshì guò le, zhīdào shì shénme qíngkuàng.",
      "tr": "Denedim, durumun ne olduğunu biliyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_038",
      "speaker": "刘梅",
      "zh": "不行的话就换一个办法。",
      "pinyin": "Bùxíng dehuà jiù huàn yígè bànfǎ.",
      "tr": "Olmazsa başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_042",
      "speaker": "张雨桐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_045",
      "speaker": "张雨桐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_048",
      "speaker": "张雨桐",
      "zh": "终于好了，我放心了。",
      "pinyin": "Zhōngyú hǎo le, wǒ fàngxīn le.",
      "tr": "Sonunda düzeldi, içim rahatladı."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_049",
      "speaker": "张伟",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_050",
      "speaker": "刘梅",
      "zh": "有了这次经验，下次就知道怎么办了。",
      "pinyin": "Yǒu le zhècì jīngyàn, xiàcì jiù zhīdào zěnmebàn le.",
      "tr": "Bu deneyim sayesinde bir dahaki sefere ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_051",
      "speaker": "张雨桐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_054",
      "speaker": "张雨桐",
      "zh": "嗯，这个月的预算有点紧。",
      "pinyin": "En, zhège yuè de yùsuàn yǒudiǎn jǐn.",
      "tr": "Bu ayın bütçesi biraz sıkışık."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_055",
      "speaker": "张伟",
      "zh": "好，我会记着。",
      "pinyin": "Hǎo, wǒhuì jìzhe.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_056",
      "speaker": "刘梅",
      "zh": "嗯，我们先花钱。",
      "pinyin": "En, wǒmen xiān huāqián.",
      "tr": "Önce para harcamak."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_057",
      "speaker": "张雨桐",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC024_058",
