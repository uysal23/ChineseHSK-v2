  "sceneId": "ZH_HSK2_SC044",
  "level": "HSK2",
  "sceneCategory": "community",
  "sourceTitleZh": "刘梅给社区活动做饭",
  "sourceTitleTr": "Liu Mei Topluluk Etkinliğinde Yemek Yapıyor",
  "sourceMiniAdventureTr": "Liu Mei ilk kez çok sayıda kişi için yemek hazırlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC044_001",
      "speaker": "刘梅",
      "zh": "社区活动需要很多份饭。",
      "pinyin": "Shèqūhuódòng xūyào hěnduō fènfàn.",
      "tr": "Mahalle etkinliği için çok sayıda porsiyon yemek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_002",
      "speaker": "社区工作人员",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_003",
      "speaker": "志愿者",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_004",
      "speaker": "张伟",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_005",
      "speaker": "刘梅",
      "zh": "我们要准备二十份。",
      "pinyin": "Wǒmen yào zhǔnbèi èrshífèn.",
      "tr": "Yirmi porsiyon hazırlamamız gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_006",
      "speaker": "社区工作人员",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_007",
      "speaker": "志愿者",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_008",
      "speaker": "张伟",
      "zh": "这些已经够了。",
      "pinyin": "Zhèxiē yǐjīng gòu le.",
      "tr": "Bunlar artık yeterli."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_009",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_010",
      "speaker": "社区工作人员",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_011",
      "speaker": "志愿者",
      "zh": "现在还差一点。",
      "pinyin": "Xiànzài hái chàyìdiǎn.",
      "tr": "Şimdi hâlâ biraz eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_012",
      "speaker": "张伟",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_014",
      "speaker": "社区工作人员",
      "zh": "我们先把饭做好。",
      "pinyin": "Wǒmen xiān bǎ fàn zuòhǎo.",
      "tr": "Önce yemeği hazırlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_015",
      "speaker": "志愿者",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_017",
      "speaker": "刘梅",
      "zh": "现在还差十份，够不够时间？",
      "pinyin": "Xiànzài hái chà shífèn, gòubùgòu shíjiān?",
      "tr": "Şimdi on porsiyon eksik, zaman yeter mi?"
    },
    {
      "id": "DLG_ZH_HSK2_SC044_018",
      "speaker": "社区工作人员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC044_019",
      "speaker": "志愿者",
      "zh": "先别慌，看看还有什么办法。",
      "pinyin": "Xiānbié huāng, kànkàn háiyǒu shénme bànfǎ.",
      "tr": "Panik yapmayalım, başka ne yapabiliriz bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_020",
      "speaker": "张伟",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_022",
      "speaker": "社区工作人员",
      "zh": "今天社区有一个活动。",
      "pinyin": "Jīntiān shèqū yǒu yígè huódòng.",
      "tr": "Bugün mahallede bir etkinlik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_023",
      "speaker": "志愿者",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_024",
      "speaker": "张伟",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_025",
      "speaker": "刘梅",
      "zh": "社区离这里不远。",
      "pinyin": "Shèqū lí zhèlǐ bùyuǎn.",
      "tr": "Mahalle / topluluk buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_026",
      "speaker": "社区工作人员",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_027",
      "speaker": "志愿者",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_028",
      "speaker": "张伟",
      "zh": "这个食物在这里。",
      "pinyin": "Zhège shíwù zài zhèlǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_030",
      "speaker": "社区工作人员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_031",
      "speaker": "志愿者",
      "zh": "我们先帮忙。",
      "pinyin": "Wǒmen xiān bāngmáng.",
      "tr": "Önce yardım etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_032",
      "speaker": "张伟",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_034",
      "speaker": "社区工作人员",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_035",
      "speaker": "志愿者",
      "zh": "先把这个完成，再看下一个。",
      "pinyin": "Xiān bǎ zhège wánchéng, zài kàn xià yígè.",
      "tr": "Önce bunu tamamlayalım, sonra diğerine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_036",
      "speaker": "张伟",
      "zh": "我觉得这个办法更好。",
      "pinyin": "Wǒ juéde zhège bànfǎ gènghǎo.",
      "tr": "Bence bu yöntem daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_037",
      "speaker": "刘梅",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_038",
      "speaker": "社区工作人员",
      "zh": "好，我们换一种做法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng zuòfǎ.",
      "tr": "Tamam, başka bir yöntem kullanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_039",
      "speaker": "志愿者",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_042",
      "speaker": "社区工作人员",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_043",
      "speaker": "志愿者",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_046",
      "speaker": "社区工作人员",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_047",
      "speaker": "志愿者",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_048",
      "speaker": "张伟",
      "zh": "太好了，这件事解决了。",
      "pinyin": "Tàihǎole, zhèjiàn shì jiějué le.",
      "tr": "Harika, bu işi çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_049",
      "speaker": "刘梅",
      "zh": "这次我们也学到东西了。",
      "pinyin": "Zhècì wǒmen yě xuédào dōngxī le.",
      "tr": "Bu sefer de bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_050",
      "speaker": "社区工作人员",
      "zh": "下次再遇到就容易多了。",
      "pinyin": "Xiàcì zài yùdào jiù róngyì duō le.",
      "tr": "Bir daha olursa çok daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_051",
      "speaker": "志愿者",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC044_054",
