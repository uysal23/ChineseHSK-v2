      "tr": "Bu el feneri burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC016_059",
      "speaker": "张乐乐",
      "zh": "这个以后还会用。",
      "pinyin": "Zhège yǐhòu háihuìyòng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
