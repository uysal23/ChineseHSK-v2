{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC021",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "乐乐办借书证",
  "sourceTitleTr": "Lele Kütüphane Kartı Alıyor",
  "sourceMiniAdventureTr": "Lele ilk kütüphane kartını alıp kitap ödünç alır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC021_001",
      "speaker": "张乐乐",
      "zh": "乐乐今天要办借书证。",
      "pinyin": "Lèlè jīntiān yào bàn jièshūzhèng.",
      "tr": "Lele bugün kütüphane kartı çıkaracak."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_002",
      "speaker": "刘梅",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_003",
      "speaker": "图书管理员",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_004",
      "speaker": "张乐乐",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_005",
      "speaker": "刘梅",
      "zh": "你看，这个借书证在这儿。",
      "pinyin": "Nǐ kàn, zhège jièshūzhèng zài zhèér.",
      "tr": "Bu kütüphane kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_006",
      "speaker": "图书管理员",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_007",
      "speaker": "张乐乐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_008",
      "speaker": "刘梅",
      "zh": "我们先借。",
      "pinyin": "Wǒmen xiānjiè.",
      "tr": "Önce ödünç almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_009",
      "speaker": "图书管理员",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_010",
      "speaker": "张乐乐",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_011",
      "speaker": "刘梅",
      "zh": "我们先还。",
      "pinyin": "Wǒmen xiān hái.",
      "tr": "Önce iade etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_012",
      "speaker": "图书管理员",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_014",
      "speaker": "刘梅",
      "zh": "这个书在这里。",
      "pinyin": "Zhège shū zài zhèlǐ.",
      "tr": "Bu kitap burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_015",
      "speaker": "图书管理员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_017",
      "speaker": "刘梅",
      "zh": "第一次可以借几本书？",
      "pinyin": "Dìyīcì kěyǐ jiè jǐběnshū?",
      "tr": "İlk seferde kaç kitap ödünç alınabilir?"
    },
    {
      "id": "DLG_ZH_HSK2_SC021_018",
      "speaker": "图书管理员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC021_019",
      "speaker": "张乐乐",
      "zh": "没关系，我们先想个办法。",
      "pinyin": "Méiguānxì, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Sorun değil, önce bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_020",
      "speaker": "刘梅",
      "zh": "要不先做最简单的？",
      "pinyin": "Yào bù xiān zuò zuì jiǎndān de?",
      "tr": "Önce en kolay olanı yapsak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC021_021",
      "speaker": "图书管理员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_022",
      "speaker": "张乐乐",
      "zh": "图书馆离这里不远。",
      "pinyin": "Túshūguǎn lí zhèlǐ bùyuǎn.",
      "tr": "Kütüphane buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_024",
      "speaker": "图书管理员",
      "zh": "那我们先记下来。",
      "pinyin": "Nà wǒmen xiān jìxiàlái.",
      "tr": "O zaman önce not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_025",
      "speaker": "张乐乐",
      "zh": "这个表格在这里。",
      "pinyin": "Zhège biǎogé zài zhèlǐ.",
      "tr": "Bu form burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_027",
      "speaker": "图书管理员",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_028",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu kimlik kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_030",
      "speaker": "图书管理员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_031",
      "speaker": "张乐乐",
      "zh": "大概几天能到？",
      "pinyin": "Dàgài jǐtiān néng dào?",
      "tr": "Yaklaşık kaç günde ulaşır?"
    },
    {
      "id": "DLG_ZH_HSK2_SC021_032",
      "speaker": "刘梅",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_033",
      "speaker": "图书管理员",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_034",
      "speaker": "张乐乐",
      "zh": "因为时间不多，我们得快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, wǒmen dé kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olmalıyız."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_035",
      "speaker": "刘梅",
      "zh": "我们一个一个来，先做这个。",
      "pinyin": "Wǒmen yígè yígè lái, xiān zuò zhège.",
      "tr": "Tek tek ilerleyelim, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_036",
      "speaker": "图书管理员",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_037",
      "speaker": "张乐乐",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_038",
      "speaker": "刘梅",
      "zh": "好，我们换一种做法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng zuòfǎ.",
      "tr": "Tamam, başka bir yöntem kullanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_039",
      "speaker": "图书管理员",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_042",
      "speaker": "图书管理员",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_045",
      "speaker": "图书管理员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_046",
      "speaker": "张乐乐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_048",
      "speaker": "图书管理员",
      "zh": "太好了，这下没问题了。",
      "pinyin": "Tàihǎole, zhèxià méi wèntí le.",
      "tr": "Harika, artık sorun yok."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_049",
      "speaker": "张乐乐",
      "zh": "这件事让我学到了不少。",
      "pinyin": "Zhèjiàn shì ràngwǒxué dào le bùshǎo.",
      "tr": "Bu olay bana epey şey öğretti."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha tecrübeli oluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_051",
      "speaker": "图书管理员",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_054",
      "speaker": "图书管理员",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Bu kütüphane kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_055",
      "speaker": "张乐乐",
      "zh": "嗯，我记住了。",
      "pinyin": "En, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_056",
      "speaker": "刘梅",
      "zh": "嗯，我们先借。",
      "pinyin": "En, wǒmen xiānjiè.",
      "tr": "Önce ödünç almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_057",
      "speaker": "图书管理员",
      "zh": "这个办法很实用。",
      "pinyin": "Zhège bànfǎ hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_058",
      "speaker": "张乐乐",
      "zh": "嗯，我们先还。",
      "pinyin": "En, wǒmen xiān hái.",
      "tr": "Önce iade etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_059",
      "speaker": "刘梅",
      "zh": "以后还用得上。",
      "pinyin": "Yǐhòu hái yòngdéshàng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC021_060",
      "speaker": "图书管理员",
      "zh": "对，就在这里。",
      "pinyin": "Duì, jiù zài zhèlǐ.",
      "tr": "Bu kitap burada."
    },
