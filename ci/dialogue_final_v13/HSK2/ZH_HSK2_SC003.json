  "level": "HSK2",
  "sceneCategory": "business",
  "sourceTitleZh": "刘梅逛菜市场",
  "sourceTitleTr": "Liu Mei Mahalle Pazarında",
  "sourceMiniAdventureTr": "Liu Mei sebze ve meyve alırken miktar ve fiyat konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC003_001",
      "speaker": "刘梅",
      "zh": "今天的菜很新鲜。",
      "pinyin": "Jīntiān de cài hěn xīnxiān.",
      "tr": "Bugünkü sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_002",
      "speaker": "摊主",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_003",
      "speaker": "邻居",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_004",
      "speaker": "刘梅",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_005",
      "speaker": "摊主",
      "zh": "你看，这个蔬菜在这儿。",
      "pinyin": "Nǐ kàn, zhège shūcài zài zhèér.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_006",
      "speaker": "邻居",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_007",
      "speaker": "刘梅",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_008",
      "speaker": "摊主",
      "zh": "你看，这个水果在这儿。",
      "pinyin": "Nǐ kàn, zhège shuǐguǒ zài zhèér.",
      "tr": "Bu meyve burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_009",
      "speaker": "邻居",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_010",
      "speaker": "刘梅",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_011",
      "speaker": "摊主",
      "zh": "这个我要两斤。",
      "pinyin": "Zhège wǒyào liǎngjīn.",
      "tr": "Bundan bir kilo istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_012",
      "speaker": "邻居",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_014",
      "speaker": "摊主",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_015",
      "speaker": "邻居",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_017",
      "speaker": "摊主",
      "zh": "这个价格有点贵。",
      "pinyin": "Zhège jiàgé yǒudiǎn guì.",
      "tr": "Bu fiyat biraz pahalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_018",
      "speaker": "邻居",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC003_019",
      "speaker": "刘梅",
      "zh": "没关系，我们先想个办法。",
      "pinyin": "Méiguānxì, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Sorun değil, önce bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_020",
      "speaker": "摊主",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_021",
      "speaker": "邻居",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_022",
      "speaker": "刘梅",
      "zh": "这些菜特别新鲜。",
      "pinyin": "Zhèxiē cài tèbié xīnxiān.",
      "tr": "Bu sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_023",
      "speaker": "摊主",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_024",
      "speaker": "邻居",
      "zh": "那就先写下来。",
      "pinyin": "Nà jiù xiān xiě xiàlái.",
      "tr": "O zaman önce yazalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_025",
      "speaker": "刘梅",
      "zh": "我们先买。",
      "pinyin": "Wǒmen xiānmǎi.",
      "tr": "Önce satın almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_026",
      "speaker": "摊主",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_027",
      "speaker": "邻居",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_028",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_029",
      "speaker": "摊主",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_030",
      "speaker": "邻居",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_031",
      "speaker": "刘梅",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_032",
      "speaker": "摊主",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_033",
      "speaker": "邻居",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_034",
      "speaker": "刘梅",
      "zh": "先快一点做，等会儿再检查。",
      "pinyin": "Xiānkuài yìdiǎn zuò, děnghuìer zài jiǎnchá.",
      "tr": "Önce biraz hızlı yapalım, sonra yeniden kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_035",
      "speaker": "摊主",
      "zh": "这个做完以后再做下一个。",
      "pinyin": "Zhège zuò wán yǐhòu zài zuò xià yígè.",
      "tr": "Bunu bitirdikten sonra diğerini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_036",
      "speaker": "邻居",
      "zh": "这个办法看起来更合适。",
      "pinyin": "Zhège bànfǎ kànqǐlái gèng héshì.",
      "tr": "Bu yöntem daha uygun görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_037",
      "speaker": "刘梅",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_038",
      "speaker": "摊主",
      "zh": "不行的话就换一个办法。",
      "pinyin": "Bùxíng dehuà jiù huàn yígè bànfǎ.",
      "tr": "Olmazsa başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_039",
      "speaker": "邻居",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_041",
      "speaker": "摊主",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_042",
      "speaker": "邻居",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_044",
      "speaker": "摊主",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_045",
      "speaker": "邻居",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_047",
      "speaker": "摊主",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_048",
      "speaker": "邻居",
      "zh": "好了，问题终于解决了。",
      "pinyin": "Hǎo le, wèntí zhōngyú jiějué le.",
      "tr": "Tamam, sorun sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_049",
      "speaker": "刘梅",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_050",
      "speaker": "摊主",
      "zh": "下次我们会准备得更好。",
      "pinyin": "Xiàcì wǒmen huì zhǔnbèi dé gènghǎo.",
      "tr": "Bir dahaki sefere daha iyi hazırlanırız."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_051",
      "speaker": "邻居",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_053",
      "speaker": "摊主",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_054",
      "speaker": "邻居",
      "zh": "对，就在这里。",
