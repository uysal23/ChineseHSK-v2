{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC015",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "新菜谱",
  "sourceTitleTr": "Liu Mei Yeni Tarif Deniyor",
  "sourceMiniAdventureTr": "Liu Mei yanlış baharat ekler ama yemeği kurtarır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC015_001",
      "speaker": "刘梅",
      "zh": "刘梅今天试一个新菜谱。",
      "pinyin": "Liúméi jīntiān shì yígè xīn càipǔ.",
      "tr": "Liu Mei bugün yeni bir tarif deniyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_002",
      "speaker": "张伟",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_003",
      "speaker": "张雨桐",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_004",
      "speaker": "刘梅",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_005",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu tarif burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_006",
      "speaker": "张雨桐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_007",
      "speaker": "刘梅",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_008",
      "speaker": "张伟",
      "zh": "这个盐在这里。",
      "pinyin": "Zhège yán zài zhèlǐ.",
      "tr": "Bu tuz burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_009",
      "speaker": "张雨桐",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_010",
      "speaker": "刘梅",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_011",
      "speaker": "张伟",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Bu baharat burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_012",
      "speaker": "张雨桐",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_014",
      "speaker": "张伟",
      "zh": "这个菜有点咸。",
      "pinyin": "Zhège cài yǒudiǎnxián.",
      "tr": "Bu yemek biraz tuzlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_017",
      "speaker": "张伟",
      "zh": "盐放多了，有点咸。",
      "pinyin": "Yánfàngduō le, yǒudiǎnxián.",
      "tr": "Tuz fazla oldu, biraz tuzlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_018",
      "speaker": "张雨桐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC015_019",
      "speaker": "刘梅",
      "zh": "先别急，我们一起想办法。",
      "pinyin": "Xiān biéjí, wǒmen yìqǐ xiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, birlikte bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_020",
      "speaker": "张伟",
      "zh": "先做容易的吧。",
      "pinyin": "Xiān zuò róngyì de ba.",
      "tr": "Önce kolay olanı yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_021",
      "speaker": "张雨桐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_022",
      "speaker": "刘梅",
      "zh": "现在味道好多了。",
      "pinyin": "Xiànzài wèidào hǎoduō le.",
      "tr": "Şimdi tadı çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_023",
      "speaker": "张伟",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_024",
      "speaker": "张雨桐",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_025",
      "speaker": "刘梅",
      "zh": "对，就在这里。",
      "pinyin": "Duì, jiù zài zhèlǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_028",
      "speaker": "刘梅",
      "zh": "我们先做最重要的事。",
      "pinyin": "Wǒmen xiān zuò zuì zhòngyào de shì.",
      "tr": "Önce en önemli işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_030",
      "speaker": "张雨桐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_031",
      "speaker": "刘梅",
      "zh": "做完这个再做别的。",
      "pinyin": "Zuò wán zhège zài zuò biéde.",
      "tr": "Bunu bitirdikten sonra diğer işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_032",
      "speaker": "张伟",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_033",
      "speaker": "张雨桐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_034",
      "speaker": "刘梅",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_035",
      "speaker": "张伟",
      "zh": "这个做完以后再做下一个。",
      "pinyin": "Zhège zuò wán yǐhòu zài zuò xià yígè.",
      "tr": "Bunu bitirdikten sonra diğerini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_036",
      "speaker": "张雨桐",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_037",
      "speaker": "刘梅",
      "zh": "这个我试过一次。",
      "pinyin": "Zhège wǒshì guò yīcì.",
      "tr": "Bunu bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_038",
      "speaker": "张伟",
      "zh": "那试试别的办法。",
      "pinyin": "Nà shìshì biéde bànfǎ.",
      "tr": "O zaman başka bir yol deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_042",
      "speaker": "张雨桐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_045",
      "speaker": "张雨桐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_047",
      "speaker": "张伟",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_048",
      "speaker": "张雨桐",
      "zh": "太好了，这件事解决了。",
      "pinyin": "Tàihǎole, zhèjiàn shì jiějué le.",
      "tr": "Harika, bu işi çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_049",
      "speaker": "刘梅",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_050",
      "speaker": "张伟",
      "zh": "有了这次经验，下次就知道怎么办了。",
      "pinyin": "Yǒu le zhècì jīngyàn, xiàcì jiù zhīdào zěnmebàn le.",
      "tr": "Bu deneyim sayesinde bir dahaki sefere ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_051",
      "speaker": "张雨桐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_054",
      "speaker": "张雨桐",
      "zh": "这个菜谱在这里。",
      "pinyin": "Zhège càipǔ zài zhèlǐ.",
      "tr": "Bu tarif burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_055",
      "speaker": "刘梅",
      "zh": "好，我会记着。",
      "pinyin": "Hǎo, wǒhuì jìzhe.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_056",
      "speaker": "张伟",
      "zh": "好，就在这里。",
      "pinyin": "Hǎo, jiù zài zhèlǐ.",
      "tr": "Bu tuz burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_057",
      "speaker": "张雨桐",
      "zh": "这个办法很实用。",
      "pinyin": "Zhège bànfǎ hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_058",
      "speaker": "刘梅",
      "zh": "这个调料在这里。",
      "pinyin": "Zhège tiáoliào zài zhèlǐ.",
      "tr": "Bu baharat burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_059",
      "speaker": "张伟",
      "zh": "以后还用得上。",
      "pinyin": "Yǐhòu hái yòngdéshàng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_060",
      "speaker": "张雨桐",
      "zh": "嗯，这个菜有点咸。",
      "pinyin": "En, zhège cài yǒudiǎnxián.",
      "tr": "Bu yemek biraz tuzlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_061",
