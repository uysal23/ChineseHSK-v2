  "sceneCategory": "family",
  "sourceTitleZh": "和爷爷奶奶视频",
  "sourceTitleTr": "Büyük Aile Görüntülü Araması",
  "sourceMiniAdventureTr": "Zhang’ın anne-babası görüntülü aramayla yeni evi görür.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC042_001",
      "speaker": "张伟",
      "zh": "爷爷奶奶想看看新家。",
      "pinyin": "Yéyénǎinǎi xiǎng kànkàn xīn jiā.",
      "tr": "Büyükanne ve büyükbaba yeni evi görmek istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_002",
      "speaker": "刘梅",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_003",
      "speaker": "爷爷",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_004",
      "speaker": "奶奶",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_005",
      "speaker": "张伟",
      "zh": "我们晚上视频吧。",
      "pinyin": "Wǒmen wǎnshàng shìpín ba.",
      "tr": "Akşam görüntülü konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_006",
      "speaker": "刘梅",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_007",
      "speaker": "爷爷",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_008",
      "speaker": "奶奶",
      "zh": "你们看得见吗？",
      "pinyin": "Nǐmen kàndéjiàn ma?",
      "tr": "Görebiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_010",
      "speaker": "刘梅",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_011",
      "speaker": "爷爷",
      "zh": "你们听得见吗？",
      "pinyin": "Nǐmen tīngdejiàn ma?",
      "tr": "Duyabiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_012",
      "speaker": "奶奶",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_014",
      "speaker": "刘梅",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéyénǎinǎi jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_015",
      "speaker": "爷爷",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_016",
      "speaker": "奶奶",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_017",
      "speaker": "张伟",
      "zh": "你们看得见吗？听得见吗？",
      "pinyin": "Nǐmen kàndéjiàn ma? tīngdejiàn ma?",
      "tr": "Bizi görebiliyor ve duyabiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_019",
      "speaker": "爷爷",
      "zh": "先别急，我们一起想办法。",
      "pinyin": "Xiān biéjí, wǒmen yìqǐ xiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, birlikte bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_020",
      "speaker": "奶奶",
      "zh": "我想先把最简单的做完。",
      "pinyin": "Wǒ xiǎng xiān bǎ zuì jiǎndān de zuò wán.",
      "tr": "Bence önce en kolay kısmı bitirelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_022",
      "speaker": "刘梅",
      "zh": "这个屏幕在这里。",
      "pinyin": "Zhège píngmù zài zhèlǐ.",
      "tr": "Bu ekran burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_023",
      "speaker": "爷爷",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_024",
      "speaker": "奶奶",
      "zh": "那我先把它写下来。",
      "pinyin": "Nà wǒ xiān bǎ tā xiě xiàlái.",
      "tr": "O zaman bunu önce yazayım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_025",
      "speaker": "张伟",
      "zh": "你看，这个家在这儿。",
      "pinyin": "Nǐ kàn, zhège jiā zài zhèér.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_027",
      "speaker": "爷爷",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_028",
      "speaker": "奶奶",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_031",
      "speaker": "爷爷",
      "zh": "我们先打电话。",
      "pinyin": "Wǒmen xiān dǎdiànhuà.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_032",
      "speaker": "奶奶",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_034",
      "speaker": "刘梅",
      "zh": "先快一点做，等会儿再检查。",
      "pinyin": "Xiānkuài yìdiǎn zuò, děnghuìer zài jiǎnchá.",
      "tr": "Önce biraz hızlı yapalım, sonra yeniden kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_035",
      "speaker": "爷爷",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_036",
      "speaker": "奶奶",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_037",
      "speaker": "张伟",
      "zh": "这个办法我刚刚试过。",
      "pinyin": "Zhège bànfǎ wǒ gānggāng shì guò.",
      "tr": "Bu yöntemi az önce denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_038",
      "speaker": "刘梅",
      "zh": "这个不行，就换一个。",
      "pinyin": "Zhège bùxíng, jiù huàn yígè.",
      "tr": "Bu olmazsa başka birini deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_039",
      "speaker": "爷爷",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_040",
      "speaker": "奶奶",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_043",
      "speaker": "爷爷",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_044",
      "speaker": "奶奶",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_047",
      "speaker": "爷爷",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_048",
      "speaker": "奶奶",
      "zh": "好，总算解决了。",
      "pinyin": "Hǎo, zǒngsuàn jiějué le.",
      "tr": "Tamam, sonunda çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_049",
      "speaker": "张伟",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha tecrübeli oluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_051",
      "speaker": "爷爷",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_052",
      "speaker": "奶奶",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_054",
