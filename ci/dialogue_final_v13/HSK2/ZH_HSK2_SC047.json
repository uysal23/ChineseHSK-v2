{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC047",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "乐乐学骑自行车",
  "sourceTitleTr": "Lele Bisiklet Öğreniyor",
  "sourceMiniAdventureTr": "Lele düşer ama yeniden dener.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC047_001",
      "speaker": "张乐乐",
      "zh": "乐乐今天学骑自行车。",
      "pinyin": "Lèlè jīntiān xuéqí zìxíngchē.",
      "tr": "Lele bugün bisiklet sürmeyi öğreniyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_002",
      "speaker": "张伟",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_003",
      "speaker": "刘梅",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_004",
      "speaker": "张乐乐",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_005",
      "speaker": "张伟",
      "zh": "你看，这个自行车在这儿。",
      "pinyin": "Nǐ kàn, zhège zìxíngchē zài zhèér.",
      "tr": "Bu bisiklet burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_006",
      "speaker": "刘梅",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_007",
      "speaker": "张乐乐",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_008",
      "speaker": "张伟",
      "zh": "我现在会了。",
      "pinyin": "Wǒ xiànzài huì le.",
      "tr": "Artık yapabiliyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_009",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_010",
      "speaker": "张乐乐",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_011",
      "speaker": "张伟",
      "zh": "我还不会，但是我想再试。",
      "pinyin": "Wǒ hái búhuì, dànshì wǒxiǎng zàishì.",
      "tr": "Henüz yapamıyorum ama tekrar denemek istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_012",
      "speaker": "刘梅",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_014",
      "speaker": "张伟",
      "zh": "他刚才摔倒了。",
      "pinyin": "Tā gāngcái shuāidǎo le.",
      "tr": "Az önce düştü."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_017",
      "speaker": "张伟",
      "zh": "他摔倒了一次，有点怕。",
      "pinyin": "Tā shuāidǎo le yīcì, yǒudiǎn pà.",
      "tr": "Bir kez düştü ve biraz korktu."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC047_019",
      "speaker": "张乐乐",
      "zh": "先冷静一下，我们再想想怎么办。",
      "pinyin": "Xiān lěngjìng yīxià, wǒmen zài xiǎngxiǎng zěnmebàn.",
      "tr": "Önce sakinleşelim, sonra ne yapacağımızı düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_020",
      "speaker": "张伟",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_022",
      "speaker": "张乐乐",
      "zh": "我们再试一次。",
      "pinyin": "Wǒmen zàishìyīcì.",
      "tr": "Bir kez daha deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_023",
      "speaker": "张伟",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_024",
      "speaker": "刘梅",
      "zh": "那我先把它写下来。",
      "pinyin": "Nà wǒ xiān bǎ tā xiě xiàlái.",
      "tr": "O zaman bunu önce yazayım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_025",
      "speaker": "张乐乐",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_028",
      "speaker": "张乐乐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_031",
      "speaker": "张乐乐",
      "zh": "加油，你可以的！",
      "pinyin": "Jiāyóu, nǐ kěyǐ de!",
      "tr": "Haydi, yapabilirsin!"
    },
    {
      "id": "DLG_ZH_HSK2_SC047_032",
      "speaker": "张伟",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_034",
      "speaker": "张乐乐",
      "zh": "因为时间不多，我们得快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, wǒmen dé kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olmalıyız."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_035",
      "speaker": "张伟",
      "zh": "先把这个完成，再看下一个。",
      "pinyin": "Xiān bǎ zhège wánchéng, zài kàn xià yígè.",
      "tr": "Önce bunu tamamlayalım, sonra diğerine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_037",
      "speaker": "张乐乐",
      "zh": "刚才我试过这个办法。",
      "pinyin": "Gāngcái wǒshì guò zhège bànfǎ.",
      "tr": "Az önce bu yöntemi denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_038",
      "speaker": "张伟",
      "zh": "好，我们换一种做法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng zuòfǎ.",
      "tr": "Tamam, başka bir yöntem kullanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_046",
      "speaker": "张乐乐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_047",
      "speaker": "张伟",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_048",
      "speaker": "刘梅",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_049",
      "speaker": "张乐乐",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_050",
      "speaker": "张伟",
      "zh": "下次再遇到就容易多了。",
      "pinyin": "Xiàcì zài yùdào jiù róngyì duō le.",
      "tr": "Bir daha olursa çok daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_054",
