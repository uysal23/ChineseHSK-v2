{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK2_SC010",
  "level": "HSK2",
  "sceneCategory": "general",
  "sourceTitleZh": "没有午饭的野餐",
  "sourceTitleTr": "Yiyeceksiz Piknik",
  "sourceMiniAdventureTr": "Aile yanlış çantayı aldığı için piknik yiyeceklerini evde bırakmıştır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC010_001",
      "speaker": "张伟",
      "zh": "我们到公园了。",
      "pinyin": "Wǒmen dào gōngyuán le.",
      "tr": "Parka geldik."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_002",
      "speaker": "刘梅",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_003",
      "speaker": "张雨桐",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_004",
      "speaker": "张乐乐",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_005",
      "speaker": "张伟",
      "zh": "周末我们去公园野餐。",
      "pinyin": "Zhōumò wǒmen qù gōngyuán yěcān.",
      "tr": "Hafta sonu parkta piknik yapacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_006",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_007",
      "speaker": "张雨桐",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_008",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_009",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_010",
      "speaker": "刘梅",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_011",
      "speaker": "张雨桐",
      "zh": "我们忘了带吃的。",
      "pinyin": "Wǒmen wàng le dài chī de.",
      "tr": "Yiyecek getirmeyi unuttuk."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_012",
      "speaker": "张乐乐",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_014",
      "speaker": "刘梅",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_017",
      "speaker": "张伟",
      "zh": "糟了，我们拿错包了。",
      "pinyin": "Zāo le, wǒmen ná cuòbāo le.",
      "tr": "Eyvah, yanlış çantayı almışız."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC010_019",
      "speaker": "张雨桐",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_020",
      "speaker": "张乐乐",
      "zh": "我们可以先从简单的开始。",
      "pinyin": "Wǒmen kěyǐ xiān cóng jiǎndān de kāishǐ.",
      "tr": "Önce kolay olandan başlayabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_022",
      "speaker": "刘梅",
      "zh": "还好我们有别的办法。",
      "pinyin": "Háihǎo wǒmen yǒu biéde bànfǎ.",
      "tr": "Neyse ki başka bir çözümümüz var."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_024",
      "speaker": "张乐乐",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_025",
      "speaker": "张伟",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_028",
      "speaker": "张乐乐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_031",
      "speaker": "张雨桐",
      "zh": "我们先带。",
      "pinyin": "Wǒmen xiān dài.",
      "tr": "Önce yanına almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_032",
      "speaker": "张乐乐",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_034",
      "speaker": "刘梅",
      "zh": "时间有点紧，我们动作快一点。",
      "pinyin": "Shíjiān yǒudiǎn jǐn, wǒmen dòngzuò kuài yìdiǎn.",
      "tr": "Zaman biraz sıkışık, biraz hızlı hareket edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_035",
      "speaker": "张雨桐",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_036",
      "speaker": "张乐乐",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_037",
      "speaker": "张伟",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_038",
      "speaker": "刘梅",
      "zh": "那我们换个方法看看。",
      "pinyin": "Nà wǒmen huàngè fāngfǎ kànkàn.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_047",
      "speaker": "张雨桐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_048",
      "speaker": "张乐乐",
      "zh": "太好了，这件事解决了。",
      "pinyin": "Tàihǎole, zhèjiàn shì jiějué le.",
      "tr": "Harika, bu işi çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_049",
      "speaker": "张伟",
      "zh": "今天又学到了一点。",
      "pinyin": "Jīntiān yòu xuédào le yìdiǎn.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha tecrübeli oluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_051",
      "speaker": "张雨桐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_054",
      "speaker": "刘梅",
      "zh": "嗯，周末我们去公园野餐。",
      "pinyin": "En, zhōumò wǒmen qù gōngyuán yěcān.",
      "tr": "Hafta sonu parkta piknik yapacağız."
    },
