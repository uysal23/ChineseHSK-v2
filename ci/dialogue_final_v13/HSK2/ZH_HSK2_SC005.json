  "sceneId": "ZH_HSK2_SC005",
  "level": "HSK2",
  "sceneCategory": "health",
  "sourceTitleZh": "雨桐选社团",
  "sourceTitleTr": "Yutong’un Kulüp Seçimi",
  "sourceMiniAdventureTr": "Yutong spor ve müzik kulübü arasında karar veremez.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC005_001",
      "speaker": "张雨桐",
      "zh": "雨桐想参加一个社团。",
      "pinyin": "Yǔtóng xiǎng cānjiā yígè shètuán.",
      "tr": "Yutong bir kulübe katılmak istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_002",
      "speaker": "同学",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_003",
      "speaker": "老师",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_004",
      "speaker": "张雨桐",
      "zh": "好，别着急。",
      "pinyin": "Hǎo, biézháojí.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_005",
      "speaker": "同学",
      "zh": "我们来谈谈社团。",
      "pinyin": "Wǒmen lái tántán shètuán.",
      "tr": "Kulüp hakkında konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_006",
      "speaker": "老师",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_007",
      "speaker": "张雨桐",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_008",
      "speaker": "同学",
      "zh": "我最近常常运动。",
      "pinyin": "Wǒ zuìjìn chángcháng yùndòng.",
      "tr": "Son zamanlarda sık sık spor yapıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_009",
      "speaker": "老师",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_010",
      "speaker": "张雨桐",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_011",
      "speaker": "同学",
      "zh": "雨桐很喜欢音乐。",
      "pinyin": "Yǔtóng hěn xǐhuān yīnyuè.",
      "tr": "Yutong müziği çok seviyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_012",
      "speaker": "老师",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_014",
      "speaker": "同学",
      "zh": "因为时间不多，我们得快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, wǒmen dé kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olmalıyız."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_015",
      "speaker": "老师",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_017",
      "speaker": "同学",
      "zh": "运动和音乐，她都喜欢。",
      "pinyin": "Yùndòng hé yīnyuè, tā dōu xǐhuān.",
      "tr": "Hem sporu hem müziği seviyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_018",
      "speaker": "老师",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC005_019",
      "speaker": "张雨桐",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_020",
      "speaker": "同学",
      "zh": "先做容易的吧。",
      "pinyin": "Xiān zuò róngyì de ba.",
      "tr": "Önce kolay olanı yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_021",
      "speaker": "老师",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_022",
      "speaker": "张雨桐",
      "zh": "所以我们先解决这个问题。",
      "pinyin": "Suǒyǐ wǒmen xiān jiějué zhège wèntí.",
      "tr": "Bu yüzden önce bu sorunu çözelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_023",
      "speaker": "同学",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_024",
      "speaker": "老师",
      "zh": "那就先写下来。",
      "pinyin": "Nà jiù xiān xiě xiàlái.",
      "tr": "O zaman önce yazalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_025",
      "speaker": "张雨桐",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_026",
      "speaker": "同学",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_027",
      "speaker": "老师",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_028",
      "speaker": "张雨桐",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_029",
      "speaker": "同学",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_030",
      "speaker": "老师",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_031",
      "speaker": "张雨桐",
      "zh": "你看，这个校车在这儿。",
      "pinyin": "Nǐ kàn, zhège xiàochē zài zhèér.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_032",
      "speaker": "同学",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_033",
      "speaker": "老师",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_034",
      "speaker": "张雨桐",
      "zh": "时间不多了，我们快一点吧。",
      "pinyin": "Shíjiān bùduō le, wǒmen kuài yìdiǎn ba.",
      "tr": "Fazla zaman kalmadı, biraz hızlanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_035",
      "speaker": "同学",
      "zh": "好，先这个，后面再做下一个。",
      "pinyin": "Hǎo, xiān zhège, hòumiàn zài zuò xià yígè.",
      "tr": "Tamam, önce bu; sonra diğerini yaparız."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_036",
      "speaker": "老师",
      "zh": "这样比刚才方便。",
      "pinyin": "Zhèyàng bǐ gāngcái fāngbiàn.",
      "tr": "Böyle yapmak az öncekinden daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_037",
      "speaker": "张雨桐",
      "zh": "这个我试过一次。",
      "pinyin": "Zhège wǒshì guò yīcì.",
      "tr": "Bunu bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_038",
      "speaker": "同学",
      "zh": "这个不行，就换一个。",
      "pinyin": "Zhège bùxíng, jiù huàn yígè.",
      "tr": "Bu olmazsa başka birini deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_039",
      "speaker": "老师",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_041",
      "speaker": "同学",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_042",
      "speaker": "老师",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_044",
      "speaker": "同学",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_045",
      "speaker": "老师",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_047",
      "speaker": "同学",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_048",
      "speaker": "老师",
      "zh": "好，总算解决了。",
      "pinyin": "Hǎo, zǒngsuàn jiějué le.",
      "tr": "Tamam, sonunda çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_049",
      "speaker": "张雨桐",
      "zh": "这次我们也学到东西了。",
      "pinyin": "Zhècì wǒmen yě xuédào dōngxī le.",
      "tr": "Bu sefer de bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_050",
      "speaker": "同学",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_051",
      "speaker": "老师",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_053",
      "speaker": "同学",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_054",
