    {
      "id": "DLG_ZH_HSK1_SC033_003",
      "speaker": "服务员",
      "zh": "嗯，对。",
      "pinyin": "En, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_004",
      "speaker": "同事",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_006",
      "speaker": "同事",
      "zh": "这是菜单，对吗？",
      "pinyin": "Zhèshì càidān, duì ma?",
      "tr": "Bu, menü mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_007",
      "speaker": "服务员",
      "zh": "嗯，这就是菜单。",
      "pinyin": "En, zhè jiùshì càidān.",
      "tr": "Evet, bu menü."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_008",
      "speaker": "同事",
      "zh": "菜单呢？",
      "pinyin": "Càidān ne?",
      "tr": "Menü nerede?"
