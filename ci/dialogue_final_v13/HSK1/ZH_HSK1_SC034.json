    {
      "id": "DLG_ZH_HSK1_SC034_036",
      "speaker": "刘梅",
      "zh": "没错，这是电话。",
      "pinyin": "Méicuò, zhèshì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_037",
      "speaker": "张伟",
      "zh": "电话在哪儿？",
      "pinyin": "Diànhuà zài nǎér?",
