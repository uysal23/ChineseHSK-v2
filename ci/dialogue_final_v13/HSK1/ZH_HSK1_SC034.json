    {
      "id": "DLG_ZH_HSK1_SC034_040",
      "speaker": "刘梅",
      "zh": "嗯，这就是钱。",
      "pinyin": "En, zhè jiùshì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_041",
      "speaker": "张伟",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎér?",
      "tr": "Para nerede?"
