  "sourceTitleZh": "社区活动",
  "sourceTitleTr": "Mahalle Etkinliği",
  "sourceMiniAdventureTr": "Aile yerel bir topluluk etkinliğine katılıp yeni insanlarla tanışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC048_001",
      "speaker": "张伟",
      "zh": "一家人参加社区活动。",
      "pinyin": "Yījiārén cānjiā shèqūhuódòng.",
      "tr": "Aile mahalle etkinliğine katılıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_003",
      "speaker": "社区工作人员",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_004",
      "speaker": "新朋友",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_006",
      "speaker": "刘梅",
      "zh": "社区呢？",
      "pinyin": "Shèqū ne?",
      "tr": "Mahalle / topluluk nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_007",
      "speaker": "社区工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Mahalle / topluluk şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_008",
      "speaker": "新朋友",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_009",
      "speaker": "张伟",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_010",
      "speaker": "刘梅",
      "zh": "今天有活动吗？",
      "pinyin": "Jīntiān yǒu huódòng ma?",
      "tr": "Bugün etkinlik var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_011",
      "speaker": "社区工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_012",
      "speaker": "新朋友",
      "zh": "那准备得怎么样了？",
      "pinyin": "Nà zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_013",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_015",
      "speaker": "社区工作人员",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_016",
      "speaker": "新朋友",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_017",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_018",
      "speaker": "刘梅",
      "zh": "这是我们的人。",
      "pinyin": "Zhèshì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_019",
      "speaker": "社区工作人员",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_020",
      "speaker": "新朋友",
      "zh": "嗯，太好了，认识你很高兴。",
      "pinyin": "En, tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_021",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_022",
      "speaker": "刘梅",
      "zh": "他们还不认识很多人。",
      "pinyin": "Tāmen hái bù rènshí hěnduō rén.",
      "tr": "Henüz çok fazla kişi tanımıyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_023",
      "speaker": "社区工作人员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_024",
      "speaker": "新朋友",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_027",
      "speaker": "社区工作人员",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_028",
      "speaker": "新朋友",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_030",
      "speaker": "刘梅",
      "zh": "我也这么想。",
      "pinyin": "Wǒ yě zhème xiǎng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_031",
      "speaker": "社区工作人员",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yàofàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_032",
      "speaker": "新朋友",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_033",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_035",
      "speaker": "社区工作人员",
      "zh": "请问，公园在哪儿？",
      "pinyin": "Qǐngwèn, gōngyuán zài nǎér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_036",
      "speaker": "新朋友",
      "zh": "公园在那边。",
      "pinyin": "Gōngyuán zài nàbiān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_037",
      "speaker": "张伟",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_038",
      "speaker": "刘梅",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_039",
      "speaker": "社区工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_040",
      "speaker": "新朋友",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_042",
      "speaker": "刘梅",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_043",
      "speaker": "社区工作人员",
      "zh": "今天他们认识了新朋友。",
      "pinyin": "Jīntiān tāmen rènshí le xīn péngyǒu.",
      "tr": "Bugün yeni arkadaşlar edindiler."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_044",
      "speaker": "新朋友",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_047",
      "speaker": "社区工作人员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_048",
      "speaker": "新朋友",
      "zh": "嗯，我们继续。",
      "pinyin": "En, wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
