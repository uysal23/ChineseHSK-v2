      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_092",
      "speaker": "老师",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
