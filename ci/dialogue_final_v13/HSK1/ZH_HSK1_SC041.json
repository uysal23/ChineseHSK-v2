    {
      "id": "DLG_ZH_HSK1_SC041_042",
      "speaker": "张伟",
      "zh": "嗯，谢谢你。",
      "pinyin": "En, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_043",
      "speaker": "兽医",
      "zh": "兽医说咪咪没有大问题。",
      "pinyin": "Shòuyī shuō mīmī méiyǒu dà wèntí.",
      "tr": "Veteriner Mimi’nin ciddi bir sorunu olmadığını söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_045",
      "speaker": "刘梅",
      "zh": "对，谢谢你。",
      "pinyin": "Duì, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_046",
      "speaker": "张伟",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_047",
      "speaker": "兽医",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_048",
      "speaker": "张乐乐",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
