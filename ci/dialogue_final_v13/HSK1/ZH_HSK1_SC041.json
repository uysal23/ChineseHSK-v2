{
  "naturalizationVersion": 13,
  "status": "FINAL_NATIVE_RELEASE_CANDIDATE_V13",
  "sceneId": "ZH_HSK1_SC041",
  "level": "HSK1",
  "sceneCategory": "health",
  "sourceTitleZh": "咪咪去看兽医",
  "sourceTitleTr": "Mimi Veterinerde",
  "sourceMiniAdventureTr": "Mimi yemek yemeyince aile onu veterinere götürür.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC041_001",
      "speaker": "刘梅",
      "zh": "咪咪今天不吃饭。",
      "pinyin": "Mīmī jīntiān bù chīfàn.",
      "tr": "Mimi bugün yemek yemiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_003",
      "speaker": "兽医",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_006",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_007",
      "speaker": "兽医",
      "zh": "嗯，这就是猫。",
      "pinyin": "En, zhè jiùshì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_008",
      "speaker": "张乐乐",
      "zh": "猫呢？",
      "pinyin": "Māo ne?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_009",
      "speaker": "刘梅",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_010",
      "speaker": "张伟",
      "zh": "这是我们的兽医。",
      "pinyin": "Zhèshì wǒmen de shòuyī.",
      "tr": "Bu bizim veteriner."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_011",
      "speaker": "兽医",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_012",
      "speaker": "张乐乐",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_013",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_014",
      "speaker": "张伟",
      "zh": "这是我们的医生。",
      "pinyin": "Zhèshì wǒmen de yīshēng.",
      "tr": "Bu bizim doktor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_015",
      "speaker": "兽医",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_016",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_017",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_018",
      "speaker": "张伟",
      "zh": "医院呢？",
      "pinyin": "Yīyuàn ne?",
      "tr": "Hastane nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_019",
      "speaker": "兽医",
      "zh": "医院在那边。",
      "pinyin": "Yīyuàn zài nàbiān.",
      "tr": "Hastane şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_020",
      "speaker": "张乐乐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_021",
      "speaker": "刘梅",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_022",
      "speaker": "张伟",
      "zh": "家人有一点担心。",
      "pinyin": "Jiārén yǒu yìdiǎn dānxīn.",
      "tr": "Aile biraz endişeli."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_023",
      "speaker": "兽医",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_026",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_027",
      "speaker": "兽医",
      "zh": "这是药吗？",
      "pinyin": "Zhè shì yào ma?",
      "tr": "Bu, ilaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_028",
      "speaker": "张乐乐",
      "zh": "嗯，这就是药。",
      "pinyin": "En, zhè jiùshì yào.",
      "tr": "Evet, bu ilaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_029",
      "speaker": "刘梅",
      "zh": "请问，药在哪儿？",
      "pinyin": "Qǐngwèn, yào zài nǎér?",
      "tr": "Ilaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_030",
      "speaker": "张伟",
      "zh": "药在这里。",
      "pinyin": "Yào zài zhèlǐ.",
      "tr": "Ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_031",
      "speaker": "兽医",
      "zh": "你要水吗？",
      "pinyin": "Nǐ yào shuǐ ma?",
      "tr": "Su ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_032",
      "speaker": "张乐乐",
      "zh": "我要水，谢谢。",
      "pinyin": "Wǒyào shuǐ, xièxiè.",
      "tr": "Su istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_033",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_034",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_035",
      "speaker": "兽医",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yàofàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_036",
      "speaker": "张乐乐",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_037",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_038",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_039",
      "speaker": "兽医",
      "zh": "请问，家在哪儿？",
      "pinyin": "Qǐngwèn, jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_040",
      "speaker": "张乐乐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_041",
