  "sceneCategory": "travel",
  "sourceTitleZh": "站台在哪儿？",
  "sourceTitleTr": "Peron Nerede?",
  "sourceMiniAdventureTr": "İstasyonda yanlış yöne giderler ve görevliye doğru peronu sorarlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC003_001",
      "speaker": "张伟",
      "zh": "我们要找站台。",
      "pinyin": "Wǒmen yào zhǎo zhàntái.",
      "tr": "Peronu bulmamız gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_003",
      "speaker": "工作人员",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_006",
      "speaker": "刘梅",
      "zh": "请问，车站在哪儿？",
      "pinyin": "Qǐngwèn, chēzhàn zài nǎér?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_007",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_008",
      "speaker": "张乐乐",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_009",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_010",
      "speaker": "刘梅",
      "zh": "站台在哪儿？",
      "pinyin": "Zhàntái zài nǎér?",
      "tr": "Peron nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_011",
      "speaker": "工作人员",
      "zh": "你看，站台在那边。",
      "pinyin": "Nǐ kàn, zhàntái zài nàbiān.",
      "tr": "Peron şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_012",
      "speaker": "张乐乐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_013",
      "speaker": "张伟",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_014",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbiān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_015",
      "speaker": "工作人员",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbiān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_016",
      "speaker": "张乐乐",
      "zh": "来，这边走。",
      "pinyin": "Lái, zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_018",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubiān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_019",
      "speaker": "工作人员",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubiān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_020",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_021",
      "speaker": "张伟",
      "zh": "对，太好了，谢谢。",
      "pinyin": "Duì, tàihǎole, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_022",
      "speaker": "刘梅",
      "zh": "我们走错了。",
      "pinyin": "Wǒmen zǒucuò le.",
      "tr": "Yanlış yöne gittik."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
