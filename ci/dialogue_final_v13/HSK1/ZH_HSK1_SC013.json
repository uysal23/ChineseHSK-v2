  "sourceTitleZh": "咪咪在柜子旁边",
  "sourceTitleTr": "Mimi Dolapta",
  "sourceMiniAdventureTr": "Mimi mutfak dolabının yanında bulunur ve çocuklar rahatlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC013_001",
      "speaker": "张乐乐",
      "zh": "我们还在找咪咪。",
      "pinyin": "Wǒmen hái zài zhǎo mīmī.",
      "tr": "Mimi’yi hâlâ arıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_003",
      "speaker": "张雨桐",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_004",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_005",
      "speaker": "张乐乐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_006",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_007",
      "speaker": "张雨桐",
      "zh": "没错，这是猫。",
      "pinyin": "Méicuò, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_008",
      "speaker": "张伟",
      "zh": "请问，猫在哪儿？",
      "pinyin": "Qǐngwèn, māo zài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_009",
      "speaker": "张乐乐",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_010",
      "speaker": "刘梅",
      "zh": "这是柜子吗？",
      "pinyin": "Zhèshì guìzi ma?",
      "tr": "Bu, dolap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_011",
      "speaker": "张雨桐",
      "zh": "没错，这是柜子。",
      "pinyin": "Méicuò, zhèshì guìzi.",
      "tr": "Evet, bu dolap."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_012",
      "speaker": "张伟",
      "zh": "柜子在哪儿？",
      "pinyin": "Guìzi zài nǎér?",
      "tr": "Dolap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_013",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Dolap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_014",
      "speaker": "刘梅",
      "zh": "厨房在哪儿？",
      "pinyin": "Chúfáng zài nǎér?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_015",
      "speaker": "张雨桐",
      "zh": "你看，厨房在那边。",
      "pinyin": "Nǐ kàn, chúfáng zài nàbiān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_016",
      "speaker": "张伟",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_017",
      "speaker": "张乐乐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_018",
      "speaker": "刘梅",
      "zh": "这是桌子，对吗？",
      "pinyin": "Zhèshì zhuōzi, duì ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_019",
      "speaker": "张雨桐",
      "zh": "嗯，这就是桌子。",
      "pinyin": "En, zhè jiùshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_020",
      "speaker": "张伟",
      "zh": "请问，桌子在哪儿？",
      "pinyin": "Qǐngwèn, zhuōzi zài nǎér?",
      "tr": "Masa nerede?"
