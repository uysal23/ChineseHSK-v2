    {
      "id": "DLG_ZH_HSK1_SC013_026",
      "speaker": "刘梅",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_027",
      "speaker": "张雨桐",
      "zh": "这是椅子，对吗？",
      "pinyin": "Zhèshì yǐzi, duì ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_028",
