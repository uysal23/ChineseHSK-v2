    {
      "id": "DLG_ZH_HSK1_SC013_021",
      "speaker": "张乐乐",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_022",
      "speaker": "刘梅",
      "zh": "厨房里有声音。",
      "pinyin": "Chúfáng lǐ yǒu shēngyīn.",
      "tr": "Mutfaktan bir ses geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
