  "sceneCategory": "education",
  "sourceTitleZh": "丢失的铅笔",
  "sourceTitleTr": "Kaybolan Kalem",
  "sourceMiniAdventureTr": "Lele mavi kaleminin başka bir öğrencide olduğunu sanır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC025_001",
      "speaker": "张乐乐",
      "zh": "乐乐在找蓝色铅笔。",
      "pinyin": "Lèlè zài zhǎo lánsè qiānbǐ.",
      "tr": "Lele mavi kalemini arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_002",
      "speaker": "同学",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_003",
      "speaker": "老师",
      "zh": "嗯，对。",
      "pinyin": "En, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_004",
      "speaker": "刘梅",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_006",
      "speaker": "同学",
      "zh": "这个是铅笔吗？",
      "pinyin": "Zhège shì qiānbǐ ma?",
      "tr": "Bu, kurşun kalem mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_007",
      "speaker": "老师",
      "zh": "对，这是铅笔。",
      "pinyin": "Duì, zhèshì qiānbǐ.",
      "tr": "Evet, bu kurşun kalem."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_008",
      "speaker": "刘梅",
      "zh": "请问，铅笔在哪儿？",
      "pinyin": "Qǐngwèn, qiānbǐ zài nǎér?",
      "tr": "Kurşun kalem nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_009",
      "speaker": "张乐乐",
      "zh": "你看，铅笔在这儿。",
      "pinyin": "Nǐ kàn, qiānbǐ zài zhèér.",
      "tr": "Kurşun kalem burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_010",
      "speaker": "同学",
      "zh": "你喜欢蓝色吗？",
      "pinyin": "Nǐ xǐhuān lánsè ma?",
      "tr": "Mavi renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_011",
      "speaker": "老师",
      "zh": "嗯，喜欢。",
      "pinyin": "En, xǐhuān.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_012",
      "speaker": "刘梅",
      "zh": "这个是蓝色的。",
      "pinyin": "Zhège shì lánsè de.",
      "tr": "Bu mavi renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_013",
      "speaker": "张乐乐",
      "zh": "很好看。",
      "pinyin": "Hěn hǎokàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_014",
      "speaker": "同学",
      "zh": "你喜欢红色吗？",
      "pinyin": "Nǐ xǐhuān hóngsè ma?",
      "tr": "Kırmızı renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_015",
      "speaker": "老师",
      "zh": "嗯，喜欢。",
      "pinyin": "En, xǐhuān.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_016",
      "speaker": "刘梅",
      "zh": "这个是红色的。",
      "pinyin": "Zhège shì hóngsè de.",
      "tr": "Bu kırmızı renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_017",
      "speaker": "张乐乐",
      "zh": "嗯，很好看。",
      "pinyin": "En, hěn hǎokàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_018",
      "speaker": "同学",
      "zh": "这是我们的学生。",
      "pinyin": "Zhèshì wǒmen de xuéshēng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_019",
      "speaker": "老师",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_020",
      "speaker": "刘梅",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_021",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_022",
      "speaker": "同学",
      "zh": "他以为同学拿了他的铅笔。",
      "pinyin": "Tā yǐwéi tóngxué ná le tā de qiānbǐ.",
      "tr": "Sınıf arkadaşının kalemini aldığını sanıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_023",
      "speaker": "老师",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_024",
      "speaker": "刘梅",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_026",
      "speaker": "同学",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_027",
      "speaker": "老师",
      "zh": "这是我们的老师。",
      "pinyin": "Zhèshì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_028",
      "speaker": "刘梅",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_029",
      "speaker": "张乐乐",
      "zh": "认识你很高兴。",
      "pinyin": "Rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_030",
      "speaker": "同学",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_031",
      "speaker": "老师",
      "zh": "教室呢？",
      "pinyin": "Jiàoshì ne?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_032",
      "speaker": "刘梅",
      "zh": "教室在那边。",
      "pinyin": "Jiàoshì zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_033",
      "speaker": "张乐乐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_034",
      "speaker": "同学",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_035",
      "speaker": "老师",
      "zh": "这是书吗？",
      "pinyin": "Zhè shì shū ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_036",
      "speaker": "刘梅",
      "zh": "对，这是书。",
      "pinyin": "Duì, zhè shì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_037",
      "speaker": "张乐乐",
      "zh": "书在哪儿？",
      "pinyin": "Shū zài nǎér?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_038",
      "speaker": "同学",
      "zh": "你看，书在这儿。",
      "pinyin": "Nǐ kàn, shū zài zhèér.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_039",
      "speaker": "老师",
      "zh": "这个是包吗？",
      "pinyin": "Zhège shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_040",
      "speaker": "刘梅",
      "zh": "嗯，这就是包。",
      "pinyin": "En, zhè jiùshì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_041",
      "speaker": "张乐乐",
      "zh": "包在哪儿？",
      "pinyin": "Bāo zài nǎér?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_042",
      "speaker": "同学",
      "zh": "你看，包在这儿。",
      "pinyin": "Nǐ kàn, bāo zài zhèér.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_043",
      "speaker": "老师",
      "zh": "原来铅笔在自己的书包里。",
      "pinyin": "Yuánlái qiānbǐ zài zìjǐ de shūbāo lǐ.",
      "tr": "Meğer kalem kendi çantasındaymış."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_044",
      "speaker": "刘梅",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_046",
      "speaker": "同学",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_047",
      "speaker": "老师",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_048",
      "speaker": "刘梅",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
