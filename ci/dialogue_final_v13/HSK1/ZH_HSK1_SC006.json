    {
      "id": "DLG_ZH_HSK1_SC006_040",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuòhuǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_041",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_042",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_043",
      "speaker": "张雨桐",
      "zh": "新城很漂亮。",
      "pinyin": "Xīnchéng hěnpiàoliàng.",
      "tr": "Yeni kasaba çok güzel."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
