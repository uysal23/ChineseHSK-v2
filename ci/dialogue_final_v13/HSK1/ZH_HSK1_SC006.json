    {
      "id": "DLG_ZH_HSK1_SC006_038",
      "speaker": "刘梅",
      "zh": "我也这么想。",
      "pinyin": "Wǒ yě zhème xiǎng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_039",
      "speaker": "张雨桐",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuòhuǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
