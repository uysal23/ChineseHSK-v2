  "sourceTitleZh": "第一次看见新城",
  "sourceTitleTr": "Yeni Kasabayı İlk Görüş",
  "sourceMiniAdventureTr": "Tren yeni kasabaya yaklaşırken aile pencereden gördüklerini konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC006_001",
      "speaker": "张伟",
      "zh": "我们快到新城了。",
      "pinyin": "Wǒmen kuàidào xīnchéng le.",
      "tr": "Yeni kasabaya yaklaştık."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_003",
      "speaker": "张雨桐",
      "zh": "嗯，对。",
      "pinyin": "En, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_006",
      "speaker": "刘梅",
      "zh": "请问，城市在哪儿？",
      "pinyin": "Qǐngwèn, chéngshì zài nǎér?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_007",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_008",
      "speaker": "张乐乐",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_009",
      "speaker": "张伟",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_010",
      "speaker": "刘梅",
      "zh": "请问，学校在哪儿？",
      "pinyin": "Qǐngwèn, xuéxiào zài nǎér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_011",
      "speaker": "张雨桐",
      "zh": "你看，学校在那边。",
      "pinyin": "Nǐ kàn, xuéxiào zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_012",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_014",
      "speaker": "刘梅",
      "zh": "请问，家在哪儿？",
      "pinyin": "Qǐngwèn, jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_015",
      "speaker": "张雨桐",
      "zh": "嗯，就在那边。",
      "pinyin": "En, jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_016",
      "speaker": "张乐乐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_017",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_018",
      "speaker": "刘梅",
      "zh": "请问，路在哪儿？",
      "pinyin": "Qǐngwèn, lù zài nǎér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_019",
      "speaker": "张雨桐",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_020",
      "speaker": "张乐乐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_021",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_022",
      "speaker": "刘梅",
      "zh": "大家都想看外面。",
      "pinyin": "Dàjiā dōu xiǎng kàn wàimiàn.",
      "tr": "Herkes dışarıyı görmek istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_027",
      "speaker": "张雨桐",
      "zh": "公园在哪儿？",
      "pinyin": "Gōngyuán zài nǎér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_028",
      "speaker": "张乐乐",
      "zh": "对，就在那边。",
      "pinyin": "Duì, jiù zài nàbiān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_029",
      "speaker": "张伟",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_030",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_031",
      "speaker": "张雨桐",
      "zh": "这是新的吗？",
      "pinyin": "Zhè shì xīn de ma?",
      "tr": "Bu, yeni mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_032",
      "speaker": "张乐乐",
      "zh": "对，这是新的。",
      "pinyin": "Duì, zhè shì xīn de.",
      "tr": "Evet, bu yeni."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_033",
      "speaker": "张伟",
      "zh": "请问，新的在哪儿？",
      "pinyin": "Qǐngwèn, xīn de zài nǎér?",
      "tr": "Yeni nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_034",
      "speaker": "刘梅",
      "zh": "你看，新的在这儿。",
      "pinyin": "Nǐ kàn, xīn de zài zhèér.",
      "tr": "Yeni burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_035",
      "speaker": "张雨桐",
      "zh": "这是我们的人。",
      "pinyin": "Zhèshì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_036",
      "speaker": "张乐乐",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
