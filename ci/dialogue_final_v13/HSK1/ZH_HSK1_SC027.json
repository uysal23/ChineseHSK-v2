  "sourceTitleZh": "第一个工作电话",
  "sourceTitleTr": "İlk Telefon Görüşmesi",
  "sourceMiniAdventureTr": "Zhang bir iş yeriyle arama yapıp görüşme saati alır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC027_001",
      "speaker": "张伟",
      "zh": "张伟第一次给公司打电话。",
      "pinyin": "Zhāngwěi dìyīcì gěi gōngsī dǎdiànhuà.",
      "tr": "Zhang Wei şirkete ilk kez telefon ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_002",
      "speaker": "公司职员",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_003",
      "speaker": "刘梅",
      "zh": "嗯，对。",
      "pinyin": "En, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_006",
      "speaker": "公司职员",
      "zh": "这个是电话吗？",
      "pinyin": "Zhège shì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_007",
      "speaker": "刘梅",
      "zh": "嗯，这就是电话。",
      "pinyin": "En, zhè jiùshì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_008",
      "speaker": "张雨桐",
      "zh": "电话呢？",
      "pinyin": "Diànhuà ne?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_009",
      "speaker": "张伟",
      "zh": "电话在这里。",
      "pinyin": "Diànhuà zài zhèlǐ.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_010",
      "speaker": "公司职员",
      "zh": "你的电话号码是什么？",
      "pinyin": "Nǐ de diànhuàhàomǎ shì shénme?",
      "tr": "Telefon numarası nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_011",
      "speaker": "刘梅",
      "zh": "这是我的电话号码。",
      "pinyin": "Zhè shì wǒ de diànhuàhàomǎ.",
      "tr": "Bu benim telefon numarası."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_012",
      "speaker": "张雨桐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_013",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_014",
      "speaker": "公司职员",
      "zh": "明天可以吗？",
      "pinyin": "Míngtiān kěyǐ ma?",
      "tr": "Yarın uygun mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_015",
      "speaker": "刘梅",
      "zh": "可以。",
      "pinyin": "Kěyǐ.",
      "tr": "Uygun."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_016",
      "speaker": "张雨桐",
      "zh": "几点？",
      "pinyin": "Jǐdiǎn?",
      "tr": "Saat kaçta?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_017",
      "speaker": "张伟",
      "zh": "明天见。",
      "pinyin": "Míngtiān jiàn.",
      "tr": "Yarın görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_018",
      "speaker": "公司职员",
      "zh": "这个是时间吗？",
      "pinyin": "Zhège shì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_019",
      "speaker": "刘梅",
      "zh": "对，这是时间。",
      "pinyin": "Duì, zhèshì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_020",
      "speaker": "张雨桐",
      "zh": "时间呢？",
      "pinyin": "Shíjiān ne?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_021",
      "speaker": "张伟",
      "zh": "时间在这里。",
      "pinyin": "Shíjiān zài zhèlǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_022",
      "speaker": "公司职员",
      "zh": "他有一点紧张。",
      "pinyin": "Tā yǒu yìdiǎn jǐnzhāng.",
      "tr": "Biraz gergin."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_026",
      "speaker": "公司职员",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_027",
      "speaker": "刘梅",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_028",
      "speaker": "张雨桐",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_029",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_030",
      "speaker": "公司职员",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_031",
      "speaker": "刘梅",
      "zh": "今天有面试吗？",
      "pinyin": "Jīntiān yǒu miànshì ma?",
      "tr": "Bugün iş görüşmesi var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_032",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_033",
      "speaker": "张伟",
      "zh": "那准备好了吗？",
      "pinyin": "Nà zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_034",
      "speaker": "公司职员",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_035",
      "speaker": "刘梅",
      "zh": "办公室在哪儿？",
      "pinyin": "Bàngōngshì zài nǎér?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_036",
      "speaker": "张雨桐",
      "zh": "你看，办公室在那边。",
      "pinyin": "Nǐ kàn, bàngōngshì zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_037",
      "speaker": "张伟",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_038",
      "speaker": "公司职员",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_039",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_040",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_042",
      "speaker": "公司职员",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_043",
      "speaker": "刘梅",
      "zh": "他约好了明天的面试。",
      "pinyin": "Tā yuē hǎo le míngtiān de miànshì.",
      "tr": "Yarınki iş görüşmesini ayarladı."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_044",
      "speaker": "张雨桐",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_046",
      "speaker": "公司职员",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_047",
      "speaker": "刘梅",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_048",
      "speaker": "张雨桐",
      "zh": "嗯，我们继续。",
      "pinyin": "En, wǒmen jìxù.",
      "tr": "Devam edelim."
    },
