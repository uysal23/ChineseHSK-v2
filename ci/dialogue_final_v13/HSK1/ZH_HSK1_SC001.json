  "sceneCategory": "family",
  "sourceTitleZh": "搬家的最后几个箱子",
  "sourceTitleTr": "Son Kutular",
  "sourceMiniAdventureTr": "Nakliye ekibi erken gelir; kutular karışır ve aile son eşyaları düzenler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC001_001",
      "speaker": "张伟",
      "zh": "我们今天搬家。",
      "pinyin": "Wǒmen jīntiān bānjiā.",
      "tr": "Bugün taşınıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_003",
      "speaker": "张雨桐",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_005",
      "speaker": "王师傅",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_006",
      "speaker": "张伟",
      "zh": "这是箱子吗？",
      "pinyin": "Zhèshì xiāngzi ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_007",
      "speaker": "刘梅",
      "zh": "嗯，这就是箱子。",
      "pinyin": "En, zhè jiùshì xiāngzi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_008",
      "speaker": "张雨桐",
      "zh": "请问，箱子在哪儿？",
      "pinyin": "Qǐngwèn, xiāngzi zài nǎér?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_009",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_010",
      "speaker": "王师傅",
      "zh": "今天搬家吗？",
      "pinyin": "Jīntiān bānjiā ma?",
      "tr": "Bugün taşınıyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_011",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_012",
      "speaker": "刘梅",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_013",
      "speaker": "张雨桐",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_014",
      "speaker": "张乐乐",
      "zh": "请问，家在哪儿？",
      "pinyin": "Qǐngwèn, jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_015",
      "speaker": "王师傅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_016",
      "speaker": "张伟",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_017",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_018",
      "speaker": "张雨桐",
      "zh": "房间呢？",
      "pinyin": "Fángjiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_019",
      "speaker": "张乐乐",
      "zh": "房间在那边。",
      "pinyin": "Fángjiān zài nàbiān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_020",
      "speaker": "王师傅",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_021",
      "speaker": "张伟",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_022",
      "speaker": "刘梅",
      "zh": "这个箱子放错了。",
      "pinyin": "Zhège xiāngzi fàngcuò le.",
      "tr": "Bu kutu yanlış yere konmuş."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_025",
      "speaker": "王师傅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_026",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_027",
      "speaker": "刘梅",
      "zh": "厨房在哪儿？",
      "pinyin": "Chúfáng zài nǎér?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_028",
      "speaker": "张雨桐",
      "zh": "嗯，就在那边。",
      "pinyin": "En, jiù zài nàbiān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_029",
      "speaker": "张乐乐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_030",
      "speaker": "王师傅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_031",
      "speaker": "张伟",
      "zh": "这个是猫吗？",
      "pinyin": "Zhège shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_032",
      "speaker": "刘梅",
      "zh": "嗯，这就是猫。",
      "pinyin": "En, zhè jiùshì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_033",
      "speaker": "张雨桐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_034",
      "speaker": "张乐乐",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_035",
      "speaker": "王师傅",
      "zh": "这是书，对吗？",
      "pinyin": "Zhè shì shū, duì ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_036",
      "speaker": "张伟",
      "zh": "嗯，这就是书。",
      "pinyin": "En, zhè jiùshì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_037",
      "speaker": "刘梅",
      "zh": "书呢？",
      "pinyin": "Shū ne?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_038",
      "speaker": "张雨桐",
      "zh": "书在这里。",
      "pinyin": "Shū zài zhèlǐ.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_039",
      "speaker": "张乐乐",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_040",
      "speaker": "王师傅",
      "zh": "没错，这是门。",
      "pinyin": "Méicuò, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_041",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_042",
      "speaker": "刘梅",
      "zh": "你看，门在这儿。",
      "pinyin": "Nǐ kàn, mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_043",
      "speaker": "张雨桐",
      "zh": "好了，箱子都对了。",
      "pinyin": "Hǎo le, xiāngzi dōu duì le.",
      "tr": "Tamam, kutular artık doğru yerde."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_045",
      "speaker": "王师傅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_046",
      "speaker": "张伟",
      "zh": "不客气。",
