  "sourceTitleZh": "乐乐的第一天",
  "sourceTitleTr": "Lele’nin İlkokulu",
  "sourceMiniAdventureTr": "Lele annesinden ayrılmak istemez; öğretmen onu rahatlatır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC024_001",
      "speaker": "张乐乐",
      "zh": "乐乐第一天上小学。",
      "pinyin": "Lèlè dìyītiān shàng xiǎoxué.",
      "tr": "Lele’nin ilkokuldaki ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_003",
      "speaker": "老师",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_004",
      "speaker": "同学",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_005",
      "speaker": "张乐乐",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_006",
      "speaker": "刘梅",
      "zh": "学校呢？",
      "pinyin": "Xuéxiào ne?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_007",
      "speaker": "老师",
      "zh": "你看，学校在那边。",
      "pinyin": "Nǐ kàn, xuéxiào zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_008",
      "speaker": "同学",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_009",
      "speaker": "张乐乐",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_010",
      "speaker": "刘梅",
      "zh": "这是我们的老师。",
      "pinyin": "Zhèshì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_011",
      "speaker": "老师",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_012",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_013",
      "speaker": "张乐乐",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_014",
      "speaker": "刘梅",
      "zh": "这是我们的学生。",
      "pinyin": "Zhèshì wǒmen de xuéshēng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_015",
      "speaker": "老师",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_016",
      "speaker": "同学",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_017",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_018",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhèshì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_019",
      "speaker": "老师",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_020",
      "speaker": "同学",
      "zh": "嗯，很高兴认识你。",
      "pinyin": "En, hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_021",
      "speaker": "张乐乐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_022",
      "speaker": "刘梅",
      "zh": "他不想和妈妈分开。",
      "pinyin": "Tā bùxiǎng hé māmā fēnkāi.",
      "tr": "Annesinden ayrılmak istemiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_023",
      "speaker": "老师",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_026",
      "speaker": "刘梅",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_027",
      "speaker": "老师",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhèshì wǒmen de māmā.",
      "tr": "Bu bizim anne."
