      "speaker": "快递员",
      "zh": "他们把包裹送给邻居。",
      "pinyin": "Tāmen bǎ bāoguǒ sònggěi línjū.",
      "tr": "Paketi komşuya veriyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_044",
      "speaker": "邻居",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_045",
      "speaker": "张伟",
      "zh": "对，谢谢你。",
      "pinyin": "Duì, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_047",
      "speaker": "快递员",
      "zh": "现在好了。",
