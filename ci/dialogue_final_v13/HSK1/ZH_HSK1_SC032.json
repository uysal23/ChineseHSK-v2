  "sceneCategory": "work",
  "sourceTitleZh": "新同事",
  "sourceTitleTr": "Yeni İş Arkadaşları",
  "sourceMiniAdventureTr": "Öğle arasında iş arkadaşları kendilerini tanıtır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC032_001",
      "speaker": "张伟",
      "zh": "张伟认识新同事。",
      "pinyin": "Zhāngwěi rènshí xīn tóngshì.",
      "tr": "Zhang Wei yeni iş arkadaşlarıyla tanışıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_003",
      "speaker": "同事",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_004",
      "speaker": "经理",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_006",
      "speaker": "同事",
      "zh": "这是我们的同事。",
      "pinyin": "Zhèshì wǒmen de tóngshì.",
      "tr": "Bu bizim iş arkadaşı."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_007",
      "speaker": "同事",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_008",
      "speaker": "经理",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_009",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_010",
      "speaker": "同事",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_011",
      "speaker": "同事",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_012",
      "speaker": "经理",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_013",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_014",
      "speaker": "同事",
      "zh": "办公室呢？",
      "pinyin": "Bàngōngshì ne?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_015",
      "speaker": "同事",
      "zh": "你看，办公室在那边。",
      "pinyin": "Nǐ kàn, bàngōngshì zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_016",
      "speaker": "经理",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_017",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_018",
      "speaker": "同事",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_019",
      "speaker": "同事",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_020",
      "speaker": "经理",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_022",
      "speaker": "同事",
      "zh": "大家都想知道他从哪儿来。",
      "pinyin": "Dàjiā dōu xiǎng zhīdào tā cóng nǎér lái.",
      "tr": "Herkes nereden geldiğini merak ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_023",
      "speaker": "同事",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_024",
      "speaker": "经理",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_026",
      "speaker": "同事",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_027",
      "speaker": "同事",
      "zh": "请问，城市在哪儿？",
      "pinyin": "Qǐngwèn, chéngshì zài nǎér?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_028",
      "speaker": "经理",
      "zh": "城市在那边。",
      "pinyin": "Chéngshì zài nàbiān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_029",
      "speaker": "张伟",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_030",
      "speaker": "同事",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_031",
      "speaker": "同事",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_032",
      "speaker": "经理",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_033",
      "speaker": "张伟",
      "zh": "认识你很高兴。",
      "pinyin": "Rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_034",
      "speaker": "同事",
      "zh": "我也这么想。",
      "pinyin": "Wǒ yě zhème xiǎng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_035",
      "speaker": "同事",
      "zh": "你要午饭吗？",
      "pinyin": "Nǐ yào wǔfàn ma?",
      "tr": "Öğle yemeği ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_036",
      "speaker": "经理",
      "zh": "我要午饭，谢谢。",
      "pinyin": "Wǒyào wǔfàn, xièxiè.",
      "tr": "Öğle yemeği istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_037",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_038",
      "speaker": "同事",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_039",
      "speaker": "同事",
      "zh": "这是电脑吗？",
      "pinyin": "Zhèshì diànnǎo ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_040",
      "speaker": "经理",
      "zh": "嗯，这就是电脑。",
      "pinyin": "En, zhè jiùshì diànnǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_041",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diànnǎo zài nǎér?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_042",
      "speaker": "同事",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_043",
      "speaker": "同事",
      "zh": "他们很快开始聊天。",
      "pinyin": "Tāmen hěnkuài kāishǐ liáotiān.",
      "tr": "Kısa sürede sohbet etmeye başlıyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_044",
      "speaker": "经理",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_045",
      "speaker": "张伟",
      "zh": "嗯，谢谢你。",
      "pinyin": "En, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_046",
      "speaker": "同事",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_047",
      "speaker": "同事",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_048",
      "speaker": "经理",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
