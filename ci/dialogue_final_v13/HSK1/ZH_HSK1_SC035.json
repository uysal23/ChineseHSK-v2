  "sourceTitleZh": "李晨一家来做客",
  "sourceTitleTr": "Li Chen’in Ailesi Geliyor",
  "sourceMiniAdventureTr": "İki aile ilk kez evde birlikte yemek yer ve yakınlaşır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC035_001",
      "speaker": "张伟",
      "zh": "李晨一家来做客。",
      "pinyin": "Lǐchén yījiā lái zuòkè.",
      "tr": "Li Chen’in ailesi misafirliğe geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_003",
      "speaker": "李晨",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_004",
      "speaker": "李晨妻子",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_006",
      "speaker": "刘梅",
      "zh": "这是我们的客人。",
      "pinyin": "Zhèshì wǒmen de kèrén.",
      "tr": "Bu bizim misafir."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_007",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_008",
      "speaker": "李晨妻子",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_009",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_011",
      "speaker": "李晨",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_012",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_013",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_015",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_016",
      "speaker": "李晨妻子",
      "zh": "嗯，太好了，认识你很高兴。",
      "pinyin": "En, tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_017",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_018",
      "speaker": "刘梅",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yàofàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_019",
      "speaker": "李晨",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_020",
      "speaker": "李晨妻子",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_021",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_022",
      "speaker": "刘梅",
      "zh": "孩子们开始还有一点害羞。",
      "pinyin": "Háizi men kāishǐ háiyǒu yìdiǎn hàixiū.",
      "tr": "Çocuklar başta biraz çekingen."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_024",
      "speaker": "李晨妻子",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_026",
      "speaker": "刘梅",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_027",
      "speaker": "李晨",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_028",
      "speaker": "李晨妻子",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒyào chá, xièxiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_029",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_031",
      "speaker": "李晨",
      "zh": "这是桌子吗？",
      "pinyin": "Zhèshì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_032",
      "speaker": "李晨妻子",
      "zh": "对，这是桌子。",
      "pinyin": "Duì, zhèshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_033",
      "speaker": "张伟",
      "zh": "请问，桌子在哪儿？",
      "pinyin": "Qǐngwèn, zhuōzi zài nǎér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_034",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_035",
      "speaker": "李晨",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_036",
      "speaker": "李晨妻子",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_037",
      "speaker": "张伟",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_038",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_039",
      "speaker": "李晨",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàngāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_040",
      "speaker": "李晨妻子",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒyào dàngāo, xièxiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_041",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_042",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_043",
      "speaker": "李晨",
      "zh": "两家人很快聊得很开心。",
      "pinyin": "Liǎngjiā rén hěnkuài liáodé hěn kāixīn.",
      "tr": "İki aile kısa sürede keyifle sohbet ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_044",
      "speaker": "李晨妻子",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_047",
      "speaker": "李晨",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_048",
      "speaker": "李晨妻子",
      "zh": "我们继续。",
