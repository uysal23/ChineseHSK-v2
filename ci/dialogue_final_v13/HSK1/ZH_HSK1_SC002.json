      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_084",
      "speaker": "张乐乐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_085",
      "speaker": "张伟",
      "zh": "现在今天忙吗？",
      "pinyin": "Xiànzài jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_086",
      "speaker": "刘梅",
      "zh": "对，有一点。",
      "pinyin": "Duì, yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_087",
      "speaker": "张雨桐",
      "zh": "对，没关系。",
      "pinyin": "Duì, méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_088",
      "speaker": "张乐乐",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_089",
      "speaker": "张伟",
      "zh": "对，这是我们的家人。",
      "pinyin": "Duì, zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_090",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_091",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_092",
      "speaker": "张乐乐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_093",
      "speaker": "张伟",
      "zh": "那这个是门吗？",
      "pinyin": "Nà zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_094",
      "speaker": "刘梅",
      "zh": "对，这是门。",
      "pinyin": "Duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_095",
      "speaker": "张雨桐",
      "zh": "请问，门在哪儿？",
      "pinyin": "Qǐngwèn, mén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_096",
      "speaker": "张乐乐",
      "zh": "今天挺顺利的。",
      "pinyin": "Jīntiān tǐng shùnlì de.",
      "tr": "Bugün çok şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_097",
      "speaker": "张伟",
      "zh": "我也这么想。",
      "pinyin": "Wǒ yě zhème xiǎng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_098",
      "speaker": "刘梅",
      "zh": "都好了吗？",
      "pinyin": "Dōu hǎolema?",
      "tr": "Her şey tamam mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_099",
      "speaker": "张雨桐",
      "zh": "都好了。",
      "pinyin": "Dōu hǎo le.",
      "tr": "Her şey tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_100",
      "speaker": "张乐乐",
      "zh": "走吧。",
      "pinyin": "Zǒu ba.",
      "tr": "Hadi gidelim."
    }
  ]
}
