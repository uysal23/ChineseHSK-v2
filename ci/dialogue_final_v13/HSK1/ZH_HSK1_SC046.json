      "zh": "对，这是我们的家人。",
      "pinyin": "Duì, zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_086",
      "speaker": "张伟",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_087",
      "speaker": "邻居",
      "zh": "嗯，认识你很高兴。",
      "pinyin": "En, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_088",
      "speaker": "张乐乐",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_089",
      "speaker": "刘梅",
      "zh": "现在你要茶吗？",
      "pinyin": "Xiànzài nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_090",
      "speaker": "张伟",
      "zh": "对，我要茶，谢谢。",
      "pinyin": "Duì, wǒyào chá, xièxiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_091",
      "speaker": "邻居",
      "zh": "好吧。",
      "pinyin": "Hǎo ba.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_092",
      "speaker": "张乐乐",
      "zh": "真的谢谢你。",
      "pinyin": "Zhēnde xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_093",
      "speaker": "刘梅",
      "zh": "请问，家在哪儿？",
      "pinyin": "Qǐngwèn, jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_094",
      "speaker": "张伟",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_095",
      "speaker": "邻居",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_096",
      "speaker": "张乐乐",
      "zh": "今天挺顺利的。",
      "pinyin": "Jīntiān tǐng shùnlì de.",
      "tr": "Bugün çok şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_097",
      "speaker": "刘梅",
      "zh": "嗯，我也一样。",
      "pinyin": "En, wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_098",
      "speaker": "张伟",
      "zh": "都好了吗？",
      "pinyin": "Dōu hǎolema?",
      "tr": "Her şey tamam mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_099",
      "speaker": "邻居",
      "zh": "都好了。",
      "pinyin": "Dōu hǎo le.",
      "tr": "Her şey tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_100",
      "speaker": "张乐乐",
      "zh": "走吧。",
      "pinyin": "Zǒu ba.",
      "tr": "Hadi gidelim."
