    {
      "id": "DLG_ZH_HSK1_SC046_032",
      "speaker": "张乐乐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_033",
      "speaker": "刘梅",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
