    {
      "id": "DLG_ZH_HSK1_SC020_040",
      "speaker": "张乐乐",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_041",
      "speaker": "张伟",
      "zh": "认识你很高兴。",
