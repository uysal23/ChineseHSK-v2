  "sourceTitleZh": "掉在地上的冰淇淋",
  "sourceTitleTr": "Dondurma Kazası",
  "sourceMiniAdventureTr": "Lele’nin dondurması yere düşer; aile yenisini alıp onu neşelendirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC038_001",
      "speaker": "张乐乐",
      "zh": "乐乐买了一个冰淇淋。",
      "pinyin": "Lèlè mǎi le yígè bīngqílín.",
      "tr": "Lele bir dondurma aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_003",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_004",
      "speaker": "店员",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_005",
      "speaker": "张乐乐",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_006",
      "speaker": "刘梅",
      "zh": "你要冰淇淋吗？",
      "pinyin": "Nǐ yào bīngqílín ma?",
      "tr": "Dondurma ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_007",
      "speaker": "张伟",
      "zh": "我要冰淇淋，谢谢。",
      "pinyin": "Wǒyào bīngqílín, xièxiè.",
      "tr": "Dondurma istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_008",
      "speaker": "店员",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_009",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_010",
      "speaker": "刘梅",
      "zh": "公园在哪儿？",
      "pinyin": "Gōngyuán zài nǎér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_011",
      "speaker": "张伟",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_012",
      "speaker": "店员",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_013",
      "speaker": "张乐乐",
      "zh": "嗯，谢谢你。",
      "pinyin": "En, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_014",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhèshì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_015",
      "speaker": "张伟",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_016",
      "speaker": "店员",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_017",
      "speaker": "张乐乐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_018",
      "speaker": "刘梅",
      "zh": "这是钱，对吗？",
      "pinyin": "Zhè shì qián, duì ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_019",
      "speaker": "张伟",
      "zh": "没错，这是钱。",
      "pinyin": "Méicuò, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_020",
      "speaker": "店员",
      "zh": "请问，钱在哪儿？",
      "pinyin": "Qǐngwèn, qián zài nǎér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_021",
      "speaker": "张乐乐",
      "zh": "你看，钱在这儿。",
      "pinyin": "Nǐ kàn, qián zài zhèér.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_022",
      "speaker": "刘梅",
      "zh": "冰淇淋掉在地上了。",
      "pinyin": "Bīngqílín diào zài dìshàng le.",
      "tr": "Dondurma yere düştü."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_023",
      "speaker": "张伟",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_024",
      "speaker": "店员",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_027",
      "speaker": "张伟",
      "zh": "这是元吗？",
      "pinyin": "Zhè shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_028",
      "speaker": "店员",
      "zh": "嗯，这就是元。",
      "pinyin": "En, zhè jiùshì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_029",
      "speaker": "张乐乐",
      "zh": "请问，元在哪儿？",
      "pinyin": "Qǐngwèn, yuán zài nǎér?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_030",
      "speaker": "刘梅",
      "zh": "你看，元在这儿。",
      "pinyin": "Nǐ kàn, yuán zài zhèér.",
      "tr": "Yuan burada."
