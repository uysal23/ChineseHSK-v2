      "id": "DLG_ZH_HSK1_SC016_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_041",
      "speaker": "张伟",
      "zh": "嗯，太好了，认识你很高兴。",
