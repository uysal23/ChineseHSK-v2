  "sourceTitleZh": "乐乐的全家福",
  "sourceTitleTr": "Lele’nin Resmi",
  "sourceMiniAdventureTr": "Lele okulda çizdiği aile resmini sınıfa anlatır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC044_001",
      "speaker": "张乐乐",
      "zh": "乐乐画了全家福。",
      "pinyin": "Lèlè huà le quánjiāfú.",
      "tr": "Lele bir aile resmi çizdi."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_002",
      "speaker": "老师",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_003",
      "speaker": "同学",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_004",
      "speaker": "同学",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_006",
      "speaker": "老师",
      "zh": "这是画吗？",
      "pinyin": "Zhè shì huà ma?",
      "tr": "Bu, resim mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_007",
      "speaker": "同学",
      "zh": "对，这是画。",
      "pinyin": "Duì, zhè shì huà.",
      "tr": "Evet, bu resim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_008",
      "speaker": "同学",
      "zh": "画在哪儿？",
      "pinyin": "Huà zài nǎér?",
      "tr": "Resim nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_009",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Resim burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_010",
      "speaker": "老师",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_011",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_012",
      "speaker": "同学",
      "zh": "认识你很高兴。",
      "pinyin": "Rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_013",
      "speaker": "张乐乐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_014",
      "speaker": "老师",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhèshì wǒmen de māmā.",
      "tr": "Bu bizim anne."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_015",
      "speaker": "同学",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_016",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_017",
      "speaker": "张乐乐",
      "zh": "我也这么想。",
      "pinyin": "Wǒ yě zhème xiǎng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_018",
      "speaker": "老师",
      "zh": "这是我们的爸爸。",
      "pinyin": "Zhèshì wǒmen de bàbà.",
      "tr": "Bu bizim baba."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_019",
      "speaker": "同学",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_020",
      "speaker": "同学",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_021",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_022",
      "speaker": "老师",
      "zh": "老师请他介绍家人。",
      "pinyin": "Lǎoshī qǐng tā jièshào jiārén.",
      "tr": "Öğretmen ailesini tanıtmasını istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_023",
      "speaker": "同学",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_026",
      "speaker": "老师",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_027",
      "speaker": "同学",
      "zh": "这是我们的老师。",
      "pinyin": "Zhèshì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_028",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
