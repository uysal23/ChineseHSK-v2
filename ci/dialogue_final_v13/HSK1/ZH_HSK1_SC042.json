    {
      "id": "DLG_ZH_HSK1_SC042_032",
      "speaker": "张乐乐",
      "zh": "商店在那边。",
      "pinyin": "Shāngdiàn zài nàbiān.",
      "tr": "Mağaza şu tarafta."
