{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC008",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "咪咪跑到楼上了",
  "sourceTitleTr": "Mimi Üst Kata Kaçıyor",
  "sourceMiniAdventureTr": "Mimi komşunun katına kaçar; herkes onu arar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC008_001",
      "speaker": "张乐乐",
      "zh": "咪咪跑到楼上了。",
      "pinyin": "Mīmī pǎo dào lóushàng le.",
      "tr": "Mimi üst kata kaçtı."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_002",
      "speaker": "张雨桐",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_004",
      "speaker": "邻居",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_005",
      "speaker": "张乐乐",
      "zh": "它跑到楼上了。",
      "pinyin": "Tā pǎo dào lóushàng le.",
      "tr": "O üst kata kaçtı."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_006",
      "speaker": "张雨桐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_008",
      "speaker": "邻居",
      "zh": "我们去楼下看看。",
      "pinyin": "Wǒmen qù lóuxià kànkàn.",
      "tr": "Alt kata gidip bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_009",
      "speaker": "张乐乐",
      "zh": "好，楼下这点我记住了。",
      "pinyin": "Hǎo, lóuxià zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, alt kat konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_010",
      "speaker": "张雨桐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_011",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu kapı önü burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_012",
      "speaker": "邻居",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_014",
      "speaker": "张雨桐",
      "zh": "这个猫在这儿。",
      "pinyin": "Zhège māo zài zhèér.",
      "tr": "Bu kedi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_016",
      "speaker": "邻居",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_017",
      "speaker": "张乐乐",
      "zh": "我们找了半天还没找到。",
      "pinyin": "Wǒmen zhǎo le bàntiān hái méi zhǎodào.",
      "tr": "Uzun süre aradık ama hâlâ bulamadık."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_018",
      "speaker": "张雨桐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC008_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_020",
      "speaker": "邻居",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_021",
      "speaker": "张乐乐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_022",
      "speaker": "张雨桐",
      "zh": "我终于找到了。",
      "pinyin": "Wǒ zhōngyú zhǎodào le.",
      "tr": "Sonunda buldum."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_024",
      "speaker": "邻居",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_025",
      "speaker": "张乐乐",
      "zh": "邻居今天也来了。",
      "pinyin": "Línjū jīntiān yě lái le.",
      "tr": "Komşu bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_026",
      "speaker": "张雨桐",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_028",
      "speaker": "邻居",
      "zh": "我们先打电话一下吧。",
      "pinyin": "Wǒmen xiān dǎdiànhuà yīxià ba.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_029",
      "speaker": "张乐乐",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_030",
      "speaker": "张雨桐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_031",
      "speaker": "刘梅",
      "zh": "你看，这个家在这儿。",
      "pinyin": "Nǐ kàn, zhège jiā zài zhèér.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_032",
      "speaker": "邻居",
      "zh": "对，邻居这点你说得对。",
      "pinyin": "Duì, línjū zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, komşu konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_033",
      "speaker": "张乐乐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_036",
      "speaker": "邻居",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_037",
      "speaker": "张乐乐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_038",
      "speaker": "张雨桐",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_040",
      "speaker": "邻居",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_041",
      "speaker": "张乐乐",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_042",
      "speaker": "张雨桐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_044",
      "speaker": "邻居",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_045",
      "speaker": "张乐乐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_048",
      "speaker": "邻居",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_049",
      "speaker": "张乐乐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_050",
      "speaker": "张雨桐",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_051",
      "speaker": "刘梅",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "En, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_052",
      "speaker": "邻居",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_053",
      "speaker": "张乐乐",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_054",
      "speaker": "张雨桐",
      "zh": "它跑到楼上了。",
      "pinyin": "Tā pǎo dào lóushàng le.",
      "tr": "O üst kata kaçtı."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_055",
      "speaker": "刘梅",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_056",
      "speaker": "邻居",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_057",
      "speaker": "张乐乐",
      "zh": "嗯，楼下这点确实很实用。",
      "pinyin": "En, lóuxià zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, alt kat gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_058",
      "speaker": "张雨桐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_059",
      "speaker": "刘梅",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_060",
      "speaker": "邻居",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_061",
      "speaker": "张乐乐",
      "zh": "我觉得楼下也很重要。",
      "pinyin": "Wǒ juéde lóuxià yě hěn zhòngyào.",
      "tr": "Bence alt kat de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_062",
      "speaker": "张雨桐",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_063",
      "speaker": "刘梅",
      "zh": "嗯，找到这部分现在清楚多了。",
      "pinyin": "En, zhǎodào zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, bulmak kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_064",
      "speaker": "邻居",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_065",
      "speaker": "张乐乐",
      "zh": "那门口呢？",
      "pinyin": "Nà ménkǒu ne?",
      "tr": "Peki kapı önü?"
    },
    {
      "id": "DLG_ZH_HSK2_SC008_066",
      "speaker": "张雨桐",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_067",
      "speaker": "刘梅",
      "zh": "嗯，邻居这点确实很实用。",
      "pinyin": "En, línjū zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, komşu gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_068",
      "speaker": "邻居",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_069",
      "speaker": "张乐乐",
      "zh": "我觉得猫也很重要。",
      "pinyin": "Wǒ juéde māo yě hěn zhòngyào.",
      "tr": "Bence kedi de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_070",
      "speaker": "张雨桐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_071",
      "speaker": "刘梅",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_072",
      "speaker": "邻居",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_073",
      "speaker": "张乐乐",
      "zh": "嗯，楼下这部分现在清楚多了。",
      "pinyin": "En, lóuxià zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, alt kat kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC008_074",
      "speaker": "张雨桐",
