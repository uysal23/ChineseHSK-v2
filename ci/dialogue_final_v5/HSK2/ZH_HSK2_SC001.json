{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC001",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "新的早晨",
  "sourceTitleTr": "Yeni Sabah Düzeni",
  "sourceMiniAdventureTr": "Herkes aynı anda hazırlanırken banyo sırası karışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC001_001",
      "speaker": "刘梅",
      "zh": "大家都要用洗手间。",
      "pinyin": "Dàjiā dōu yào yòng xǐshǒujiān.",
      "tr": "Herkes banyoyu kullanmak istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_002",
      "speaker": "张伟",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_003",
      "speaker": "张雨桐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_004",
      "speaker": "张乐乐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_005",
      "speaker": "刘梅",
      "zh": "今天的日常安排有一点乱。",
      "pinyin": "Jīntiān de rìcháng ānpái yǒu yìdiǎn luàn.",
      "tr": "Bugünkü günlük düzen biraz karışık."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_006",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_008",
      "speaker": "张乐乐",
      "zh": "今天早上大家都很忙。",
      "pinyin": "Jīntiān zǎoshàng dàjiā dōu hěn máng.",
      "tr": "Bu sabah herkes çok meşgul."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_009",
      "speaker": "刘梅",
      "zh": "好，早上这点我记住了。",
      "pinyin": "Hǎo, zǎoshàng zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, sabah konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_011",
      "speaker": "张雨桐",
      "zh": "洗手间离这里不远。",
      "pinyin": "Xǐshǒujiān lí zhèlǐ bùyuǎn.",
      "tr": "Banyo / tuvalet buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_012",
      "speaker": "张乐乐",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_014",
      "speaker": "张伟",
      "zh": "我们先做最重要的事。",
      "pinyin": "Wǒmen xiān zuò zuì zhòngyào de shì.",
      "tr": "Önce en önemli işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_017",
      "speaker": "刘梅",
      "zh": "时间不多了，我们来不及了。",
      "pinyin": "Shíjiān bùduō le, wǒmen láibùjí le.",
      "tr": "Fazla zaman kalmadı, yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC001_019",
      "speaker": "张雨桐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_020",
      "speaker": "张乐乐",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_022",
      "speaker": "张伟",
      "zh": "做完这个再做别的。",
      "pinyin": "Zuò wán zhège zài zuò biéde.",
      "tr": "Bunu bitirdikten sonra diğer işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_024",
      "speaker": "张乐乐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_025",
      "speaker": "刘梅",
      "zh": "我们先等一下吧。",
      "pinyin": "Wǒmen xiān děng yīxià ba.",
      "tr": "Önce beklemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_028",
      "speaker": "张乐乐",
      "zh": "快一点，不然来不及了。",
      "pinyin": "Kuài yìdiǎn, bùrán láibùjí le.",
      "tr": "Biraz hızlı ol, yoksa yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_031",
      "speaker": "张雨桐",
      "zh": "这个家在这儿。",
      "pinyin": "Zhège jiā zài zhèér.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_032",
      "speaker": "张乐乐",
      "zh": "对，先这点你说得对。",
      "pinyin": "Duì, xiān zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, önce konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_035",
      "speaker": "张雨桐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_038",
      "speaker": "张伟",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_047",
      "speaker": "张雨桐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_048",
      "speaker": "张乐乐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_050",
      "speaker": "张伟",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_051",
      "speaker": "张雨桐",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_054",
      "speaker": "张伟",
      "zh": "今天的日常安排有一点乱。",
      "pinyin": "Jīntiān de rìcháng ānpái yǒu yìdiǎn luàn.",
      "tr": "Bugünkü günlük düzen biraz karışık."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_055",
      "speaker": "张雨桐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_056",
      "speaker": "张乐乐",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_057",
      "speaker": "刘梅",
      "zh": "嗯，早上这点确实很实用。",
      "pinyin": "En, zǎoshàng zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, sabah gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_058",
      "speaker": "张伟",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_059",
      "speaker": "张雨桐",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_060",
      "speaker": "张乐乐",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_061",
      "speaker": "刘梅",
      "zh": "我觉得早上也很重要。",
      "pinyin": "Wǒ juéde zǎoshàng yě hěn zhòngyào.",
      "tr": "Bence sabah de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_062",
      "speaker": "张伟",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_063",
      "speaker": "张雨桐",
      "zh": "嗯，再这部分现在清楚多了。",
      "pinyin": "En, zài zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, sonra kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_064",
      "speaker": "张乐乐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC001_065",
      "speaker": "刘梅",
      "zh": "那洗手间呢？",
      "pinyin": "Nà xǐshǒujiān ne?",
      "tr": "Peki banyo / tuvalet?"
    },
    {
      "id": "DLG_ZH_HSK2_SC001_066",
      "speaker": "张伟",
