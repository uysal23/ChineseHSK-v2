{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC031",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "去银行开户",
  "sourceTitleTr": "Bankada Yeni Hesap",
  "sourceMiniAdventureTr": "Zhang bazı belgeleri unuttuğunu fark eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC031_001",
      "speaker": "张伟",
      "zh": "我想开一个银行账户。",
      "pinyin": "Wǒ xiǎngkāi yígè yínháng zhànghù.",
      "tr": "Bir banka hesabı açmak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_002",
      "speaker": "银行工作人员",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_005",
      "speaker": "银行工作人员",
      "zh": "这个账户在这儿。",
      "pinyin": "Zhège zhànghù zài zhèér.",
      "tr": "Bu hesap burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_006",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_008",
      "speaker": "银行工作人员",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu kimlik kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_009",
      "speaker": "刘梅",
      "zh": "好，身份证这点我记住了。",
      "pinyin": "Hǎo, shēnfènzhèng zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, kimlik kartı konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_011",
      "speaker": "银行工作人员",
      "zh": "你看，这个表格在这儿。",
      "pinyin": "Nǐ kàn, zhège biǎogé zài zhèér.",
      "tr": "Bu form burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_012",
      "speaker": "刘梅",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_014",
      "speaker": "银行工作人员",
      "zh": "我们先签字一下吧。",
      "pinyin": "Wǒmen xiān qiānzì yīxià ba.",
      "tr": "Önce imza atmak."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_017",
      "speaker": "银行工作人员",
      "zh": "还需要身份证和一份材料。",
      "pinyin": "Hái xūyào shēnfènzhèng hé yīfèn cáiliào.",
      "tr": "Kimlik ve bir evrak daha gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC031_019",
      "speaker": "张伟",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_020",
      "speaker": "银行工作人员",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_022",
      "speaker": "张伟",
      "zh": "你看，这个材料在这儿。",
      "pinyin": "Nǐ kàn, zhège cáiliào zài zhèér.",
      "tr": "Bu belge / evrak burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_023",
      "speaker": "银行工作人员",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_025",
      "speaker": "张伟",
      "zh": "银行离这里不远。",
      "pinyin": "Yínháng lí zhèlǐ bùyuǎn.",
      "tr": "Banka buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_026",
      "speaker": "银行工作人员",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_028",
      "speaker": "张伟",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_029",
      "speaker": "银行工作人员",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_031",
      "speaker": "张伟",
      "zh": "我们先检查一下吧。",
      "pinyin": "Wǒmen xiān jiǎncháyīxià ba.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_032",
      "speaker": "银行工作人员",
      "zh": "对，银行这点你说得对。",
      "pinyin": "Duì, yínháng zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, banka konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_035",
      "speaker": "银行工作人员",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_038",
      "speaker": "银行工作人员",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_041",
      "speaker": "银行工作人员",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_044",
      "speaker": "银行工作人员",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_047",
      "speaker": "银行工作人员",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_048",
      "speaker": "刘梅",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_050",
      "speaker": "银行工作人员",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_051",
      "speaker": "刘梅",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_053",
      "speaker": "银行工作人员",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_054",
      "speaker": "刘梅",
      "zh": "你看，这个账户在这儿。",
      "pinyin": "Nǐ kàn, zhège zhànghù zài zhèér.",
      "tr": "Bu hesap burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_055",
      "speaker": "张伟",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_056",
      "speaker": "银行工作人员",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_057",
      "speaker": "刘梅",
      "zh": "嗯，身份证这点确实很实用。",
      "pinyin": "En, shēnfènzhèng zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, kimlik kartı gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_058",
      "speaker": "张伟",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_059",
      "speaker": "银行工作人员",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_060",
      "speaker": "刘梅",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_061",
      "speaker": "张伟",
      "zh": "我觉得身份证也很重要。",
      "pinyin": "Wǒ juéde shēnfènzhèng yě hěn zhòngyào.",
      "tr": "Bence kimlik kartı de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_062",
      "speaker": "银行工作人员",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_063",
      "speaker": "刘梅",
      "zh": "嗯，材料这部分现在清楚多了。",
      "pinyin": "En, cáiliào zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, belge / evrak kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_065",
      "speaker": "银行工作人员",
      "zh": "那表格呢？",
      "pinyin": "Nà biǎogé ne?",
      "tr": "Peki form?"
    },
    {
      "id": "DLG_ZH_HSK2_SC031_066",
      "speaker": "刘梅",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_067",
      "speaker": "张伟",
      "zh": "嗯，银行这点确实很实用。",
      "pinyin": "En, yínháng zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, banka gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_068",
      "speaker": "银行工作人员",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_069",
      "speaker": "刘梅",
      "zh": "我觉得先签字一下比较好。",
      "pinyin": "Wǒ juéde xiān qiānzì yīxià bǐjiào hǎo.",
      "tr": "Bence önce “imza atmak” kısmını ele almak daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_070",
      "speaker": "张伟",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_071",
      "speaker": "银行工作人员",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_072",
      "speaker": "刘梅",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
