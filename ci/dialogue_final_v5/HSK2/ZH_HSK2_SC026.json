{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC026",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "下雨的上学早晨",
  "sourceTitleTr": "Yağmurlu Okul Sabahı",
  "sourceMiniAdventureTr": "Yağmurluklar bulunamaz ve aile acele eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC026_001",
      "speaker": "刘梅",
      "zh": "外面正在下雨。",
      "pinyin": "Wàimiàn zhèngzài xiàyǔ.",
      "tr": "Dışarıda yağmur yağıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_002",
      "speaker": "张乐乐",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_003",
      "speaker": "张雨桐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_005",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu yağmurluk burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_006",
      "speaker": "张乐乐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_008",
      "speaker": "张伟",
      "zh": "外面正在下雨。",
      "pinyin": "Wàimiàn zhèngzài xiàyǔ.",
      "tr": "Dışarıda yağmur yağıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_009",
      "speaker": "刘梅",
      "zh": "好，下雨这点我记住了。",
      "pinyin": "Hǎo, xiàyǔ zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, yağmur yağmak konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_010",
      "speaker": "张乐乐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_011",
      "speaker": "张雨桐",
      "zh": "你看，这个雨伞在这儿。",
      "pinyin": "Nǐ kàn, zhège yǔsǎn zài zhèér.",
      "tr": "Bu şemsiye burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_012",
      "speaker": "张伟",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_014",
      "speaker": "张乐乐",
      "zh": "外面正在下雨。",
      "pinyin": "Wàimiàn zhèngzài xiàyǔ.",
      "tr": "Dışarıda yağmur yağıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_017",
      "speaker": "刘梅",
      "zh": "雨衣怎么找不到了？",
      "pinyin": "Yǔyī zěnme zhǎo búdào le?",
      "tr": "Yağmurluklar nasıl oldu da bulunamıyor?"
    },
    {
      "id": "DLG_ZH_HSK2_SC026_018",
      "speaker": "张乐乐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC026_019",
      "speaker": "张雨桐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_020",
      "speaker": "张伟",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_022",
      "speaker": "张乐乐",
      "zh": "我们先带一下吧。",
      "pinyin": "Wǒmen xiān dài yīxià ba.",
      "tr": "Önce yanına almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_024",
      "speaker": "张伟",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_025",
      "speaker": "刘梅",
      "zh": "快一点，不然来不及了。",
      "pinyin": "Kuài yìdiǎn, bùrán láibùjí le.",
      "tr": "Biraz hızlı ol, yoksa yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_026",
      "speaker": "张乐乐",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_028",
      "speaker": "张伟",
      "zh": "你看，这个校车在这儿。",
      "pinyin": "Nǐ kàn, zhège xiàochē zài zhèér.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_030",
      "speaker": "张乐乐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_031",
      "speaker": "张雨桐",
      "zh": "今天早上大家都很忙。",
      "pinyin": "Jīntiān zǎoshàng dàjiā dōu hěn máng.",
      "tr": "Bu sabah herkes çok meşgul."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_032",
      "speaker": "张伟",
      "zh": "对，来不及这点你说得对。",
      "pinyin": "Duì, láibùjí zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, yetişememek konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_034",
      "speaker": "张乐乐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_035",
      "speaker": "张雨桐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_036",
      "speaker": "张伟",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_038",
      "speaker": "张乐乐",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_042",
      "speaker": "张乐乐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_046",
      "speaker": "张乐乐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_047",
      "speaker": "张雨桐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_048",
      "speaker": "张伟",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_050",
      "speaker": "张乐乐",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_051",
      "speaker": "张雨桐",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_054",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu yağmurluk burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_055",
      "speaker": "张雨桐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_056",
      "speaker": "张伟",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_057",
      "speaker": "刘梅",
      "zh": "嗯，下雨这点确实很实用。",
      "pinyin": "En, xiàyǔ zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, yağmur yağmak gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_058",
      "speaker": "张乐乐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_059",
      "speaker": "张雨桐",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_060",
      "speaker": "张伟",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_061",
      "speaker": "刘梅",
      "zh": "我觉得下雨也很重要。",
      "pinyin": "Wǒ juéde xiàyǔ yě hěn zhòngyào.",
      "tr": "Bence yağmur yağmak de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_062",
      "speaker": "张乐乐",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_063",
      "speaker": "张雨桐",
      "zh": "嗯，带这部分现在清楚多了。",
      "pinyin": "En, dài zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, yanına almak kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_065",
      "speaker": "刘梅",
      "zh": "那雨伞呢？",
      "pinyin": "Nà yǔsǎn ne?",
      "tr": "Peki şemsiye?"
    },
    {
      "id": "DLG_ZH_HSK2_SC026_066",
      "speaker": "张乐乐",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_067",
      "speaker": "张雨桐",
      "zh": "嗯，来不及这点确实很实用。",
      "pinyin": "En, láibùjí zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, yetişememek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_068",
      "speaker": "张伟",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_069",
      "speaker": "刘梅",
      "zh": "我觉得外面也很重要。",
      "pinyin": "Wǒ juéde wàimiàn yě hěn zhòngyào.",
      "tr": "Bence dışarı de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_070",
      "speaker": "张乐乐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_071",
      "speaker": "张雨桐",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_072",
      "speaker": "张伟",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC026_073",
      "speaker": "刘梅",
