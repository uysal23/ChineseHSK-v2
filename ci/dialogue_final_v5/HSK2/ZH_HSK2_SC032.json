{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC032",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "给爷爷奶奶寄包裹",
  "sourceTitleTr": "Postanede Paket",
  "sourceMiniAdventureTr": "Aile büyüklerine hediye paketi gönderir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC032_001",
      "speaker": "张伟",
      "zh": "我们要给爷爷奶奶寄包裹。",
      "pinyin": "Wǒmen yào gěi yéyénǎinǎi jì bāoguǒ.",
      "tr": "Büyükanne ve büyükbabaya paket göndereceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_003",
      "speaker": "邮局工作人员",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_005",
      "speaker": "刘梅",
      "zh": "这个包裹在这儿。",
      "pinyin": "Zhège bāoguǒ zài zhèér.",
      "tr": "Bu paket burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_006",
      "speaker": "邮局工作人员",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_008",
      "speaker": "刘梅",
      "zh": "我们先寄一下吧。",
      "pinyin": "Wǒmen xiānjì yīxià ba.",
      "tr": "Önce göndermek."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_009",
      "speaker": "邮局工作人员",
      "zh": "好，寄这点我记住了。",
      "pinyin": "Hǎo, jì zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, göndermek konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_011",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu adres burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_012",
      "speaker": "邮局工作人员",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_014",
      "speaker": "刘梅",
      "zh": "大概三天能到。",
      "pinyin": "Dàgài sāntiān néng dào.",
      "tr": "Yaklaşık üç günde ulaşır."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_015",
      "speaker": "邮局工作人员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_017",
      "speaker": "刘梅",
      "zh": "这个地址写得对吗？",
      "pinyin": "Zhège dìzhǐ xiě dé duì ma?",
      "tr": "Bu adres doğru yazılmış mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_018",
      "speaker": "邮局工作人员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_019",
      "speaker": "张伟",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_020",
      "speaker": "刘梅",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_021",
      "speaker": "邮局工作人员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_022",
      "speaker": "张伟",
      "zh": "大概几天能到？",
      "pinyin": "Dàgài jǐtiān néng dào?",
      "tr": "Yaklaşık kaç günde ulaşır?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_024",
      "speaker": "邮局工作人员",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_025",
      "speaker": "张伟",
      "zh": "邮局离这里不远。",
      "pinyin": "Yóujú lí zhèlǐ bùyuǎn.",
      "tr": "Postane buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_027",
      "speaker": "邮局工作人员",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_028",
      "speaker": "张伟",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéyénǎinǎi jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_030",
      "speaker": "邮局工作人员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_031",
      "speaker": "张伟",
      "zh": "这个礼物在这儿。",
      "pinyin": "Zhège lǐwù zài zhèér.",
      "tr": "Bu hediye burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_032",
      "speaker": "刘梅",
      "zh": "对，到这点你说得对。",
      "pinyin": "Duì, dào zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, ulaşmak konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_033",
      "speaker": "邮局工作人员",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_036",
      "speaker": "邮局工作人员",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_039",
      "speaker": "邮局工作人员",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_042",
      "speaker": "邮局工作人员",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_045",
      "speaker": "邮局工作人员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_048",
      "speaker": "邮局工作人员",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_051",
      "speaker": "邮局工作人员",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_054",
      "speaker": "邮局工作人员",
      "zh": "你看，这个包裹在这儿。",
      "pinyin": "Nǐ kàn, zhège bāoguǒ zài zhèér.",
      "tr": "Bu paket burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_055",
      "speaker": "张伟",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_056",
      "speaker": "刘梅",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_057",
      "speaker": "邮局工作人员",
      "zh": "嗯，寄这点确实很实用。",
      "pinyin": "En, jì zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, göndermek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_058",
      "speaker": "张伟",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_059",
      "speaker": "刘梅",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_060",
      "speaker": "邮局工作人员",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_061",
      "speaker": "张伟",
      "zh": "我觉得先寄一下比较好。",
      "pinyin": "Wǒ juéde xiānjì yīxià bǐjiào hǎo.",
      "tr": "Bence önce “göndermek” kısmını ele almak daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_063",
      "speaker": "邮局工作人员",
      "zh": "嗯，几天这部分现在清楚多了。",
      "pinyin": "En, jǐtiān zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, kaç gün kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_065",
      "speaker": "刘梅",
      "zh": "那地址呢？",
      "pinyin": "Nà dìzhǐ ne?",
      "tr": "Peki adres?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_066",
      "speaker": "邮局工作人员",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_067",
      "speaker": "张伟",
      "zh": "嗯，邮局这点确实很实用。",
      "pinyin": "En, yóujú zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, postane gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_068",
      "speaker": "刘梅",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_069",
      "speaker": "邮局工作人员",
      "zh": "我觉得到也很重要。",
      "pinyin": "Wǒ juéde dào yě hěn zhòngyào.",
      "tr": "Bence ulaşmak de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_070",
      "speaker": "张伟",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_071",
      "speaker": "刘梅",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_072",
      "speaker": "邮局工作人员",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_073",
      "speaker": "张伟",
      "zh": "嗯，寄这部分现在清楚多了。",
