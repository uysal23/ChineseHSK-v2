{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC033",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "给朋友送饭",
  "sourceTitleTr": "Aile Dostlarına Yardım",
  "sourceMiniAdventureTr": "Li Chen’in ailesinden biri hastalanınca yemek götürürler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC033_001",
      "speaker": "刘梅",
      "zh": "李晨家有人生病了。",
      "pinyin": "Lǐchénjiā yǒurén shēngbìng le.",
      "tr": "Li Chen’in ailesinden biri hasta."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_002",
      "speaker": "张伟",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_003",
      "speaker": "李晨",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_004",
      "speaker": "李晨妻子",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_005",
      "speaker": "刘梅",
      "zh": "我们先帮忙一下吧。",
      "pinyin": "Wǒmen xiān bāngmáng yīxià ba.",
      "tr": "Önce yardım etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_006",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_007",
      "speaker": "李晨",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_008",
      "speaker": "李晨妻子",
      "zh": "这个饭在这儿。",
      "pinyin": "Zhège fàn zài zhèér.",
      "tr": "Bu yemek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_009",
      "speaker": "刘梅",
      "zh": "好，饭这点我记住了。",
      "pinyin": "Hǎo, fàn zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, yemek konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_011",
      "speaker": "李晨",
      "zh": "我们给他们送点饭。",
      "pinyin": "Wǒmen gěi tāmen sòngdiǎn fàn.",
      "tr": "Onlara biraz yemek götürelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_012",
      "speaker": "李晨妻子",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_014",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_015",
      "speaker": "李晨",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_016",
      "speaker": "李晨妻子",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_017",
      "speaker": "刘梅",
      "zh": "我们给他们送点饭吧。",
      "pinyin": "Wǒmen gěi tāmen sòngdiǎn fàn ba.",
      "tr": "Onlara biraz yemek götürelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC033_019",
      "speaker": "李晨",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_020",
      "speaker": "李晨妻子",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_022",
      "speaker": "张伟",
      "zh": "谢谢你来帮忙。",
      "pinyin": "Xièxiè nǐ lái bāngmáng.",
      "tr": "Yardıma geldiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_023",
      "speaker": "李晨",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_024",
      "speaker": "李晨妻子",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_025",
      "speaker": "刘梅",
      "zh": "他今天生病了。",
      "pinyin": "Tā jīntiān shēngbìng le.",
      "tr": "O bugün hasta."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_027",
      "speaker": "李晨",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_028",
      "speaker": "李晨妻子",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_031",
      "speaker": "李晨",
      "zh": "我们先看望一下吧。",
      "pinyin": "Wǒmen xiān kànwàng yīxià ba.",
      "tr": "Önce ziyaret etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_032",
      "speaker": "李晨妻子",
      "zh": "对，生病这点你说得对。",
      "pinyin": "Duì, shēngbìng zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, hasta olmak konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_035",
      "speaker": "李晨",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_036",
      "speaker": "李晨妻子",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_038",
      "speaker": "张伟",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_039",
      "speaker": "李晨",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_040",
      "speaker": "李晨妻子",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_043",
      "speaker": "李晨",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_044",
      "speaker": "李晨妻子",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_047",
      "speaker": "李晨",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_048",
      "speaker": "李晨妻子",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_050",
      "speaker": "张伟",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_051",
      "speaker": "李晨",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_052",
      "speaker": "李晨妻子",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_054",
      "speaker": "张伟",
      "zh": "我们先帮忙一下吧。",
      "pinyin": "Wǒmen xiān bāngmáng yīxià ba.",
      "tr": "Önce yardım etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_055",
      "speaker": "李晨",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_056",
      "speaker": "李晨妻子",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_057",
      "speaker": "刘梅",
      "zh": "嗯，饭这点确实很实用。",
      "pinyin": "En, fàn zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, yemek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_058",
      "speaker": "张伟",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_059",
      "speaker": "李晨",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_060",
      "speaker": "李晨妻子",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_061",
      "speaker": "刘梅",
      "zh": "我觉得饭也很重要。",
      "pinyin": "Wǒ juéde fàn yě hěn zhòngyào.",
      "tr": "Bence yemek de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_062",
      "speaker": "张伟",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_063",
      "speaker": "李晨",
      "zh": "嗯，帮忙这部分现在清楚多了。",
      "pinyin": "En, bāngmáng zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, yardım etmek kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_064",
      "speaker": "李晨妻子",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_065",
      "speaker": "刘梅",
      "zh": "那送饭呢？",
      "pinyin": "Nà sòngfàn ne?",
      "tr": "Peki yemek götürmek?"
    },
    {
      "id": "DLG_ZH_HSK2_SC033_066",
      "speaker": "张伟",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_067",
      "speaker": "李晨",
      "zh": "嗯，生病这点确实很实用。",
      "pinyin": "En, shēngbìng zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, hasta olmak gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC033_068",
      "speaker": "李晨妻子",
      "zh": "对，这样比较方便。",
