{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC048",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "新城的春天",
  "sourceTitleTr": "Kasabada İlk Bahar",
  "sourceMiniAdventureTr": "Aile ilkbaharda çevrenin değiştiğini fark eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC048_001",
      "speaker": "张伟",
      "zh": "新城的春天来了。",
      "pinyin": "Xīnchéng de chūntiān lái le.",
      "tr": "Yeni şehirde ilkbahar geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_003",
      "speaker": "张雨桐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_004",
      "speaker": "张乐乐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_005",
      "speaker": "张伟",
      "zh": "这个春天在这儿。",
      "pinyin": "Zhège chūntiān zài zhèér.",
      "tr": "Bu ilkbahar burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_006",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_008",
      "speaker": "张乐乐",
      "zh": "春天的天气很暖和。",
      "pinyin": "Chūntiān de tiānqì hěn nuǎnhuo.",
      "tr": "İlkbaharda hava çok ılık."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_009",
      "speaker": "张伟",
      "zh": "好，春天这点我记住了。",
      "pinyin": "Hǎo, chūntiān zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, ilkbahar konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_011",
      "speaker": "张雨桐",
      "zh": "这个花在这儿。",
      "pinyin": "Zhège huā zài zhèér.",
      "tr": "Bu çiçek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_012",
      "speaker": "张乐乐",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_014",
      "speaker": "刘梅",
      "zh": "公园里的花都开了。",
      "pinyin": "Gōngyuán lǐ de huādōu kāi le.",
      "tr": "Parktaki çiçeklerin hepsi açtı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_017",
      "speaker": "张伟",
      "zh": "天气比冬天暖和多了。",
      "pinyin": "Tiānqì bǐ dōngtiān nuǎnhuo duō le.",
      "tr": "Hava kışa göre çok daha sıcak."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC048_019",
      "speaker": "张雨桐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_020",
      "speaker": "张乐乐",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_022",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu kış burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_024",
      "speaker": "张乐乐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_025",
      "speaker": "张伟",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_028",
      "speaker": "张乐乐",
      "zh": "外面正在下雨。",
      "pinyin": "Wàimiàn zhèngzài xiàyǔ.",
      "tr": "Dışarıda yağmur yağıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_031",
      "speaker": "张雨桐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_032",
      "speaker": "张乐乐",
      "zh": "对，公园这点你说得对。",
      "pinyin": "Duì, gōngyuán zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, park konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_035",
      "speaker": "张雨桐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_047",
      "speaker": "张雨桐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_048",
      "speaker": "张乐乐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_051",
      "speaker": "张雨桐",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "En, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_054",
      "speaker": "刘梅",
      "zh": "这个春天在这儿。",
      "pinyin": "Zhège chūntiān zài zhèér.",
      "tr": "Bu ilkbahar burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_055",
      "speaker": "张雨桐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_056",
      "speaker": "张乐乐",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_057",
      "speaker": "张伟",
      "zh": "嗯，春天这点确实很实用。",
      "pinyin": "En, chūntiān zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, ilkbahar gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_059",
      "speaker": "张雨桐",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_060",
      "speaker": "张乐乐",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_061",
      "speaker": "张伟",
      "zh": "我觉得暖和也很重要。",
      "pinyin": "Wǒ juéde nuǎnhuo yě hěn zhòngyào.",
      "tr": "Bence ılık / sıcak de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_063",
      "speaker": "张雨桐",
      "zh": "嗯，冬天这部分现在清楚多了。",
      "pinyin": "En, dōngtiān zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, kış kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_064",
      "speaker": "张乐乐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_065",
      "speaker": "张伟",
      "zh": "那花呢？",
      "pinyin": "Nà huāní?",
      "tr": "Peki çiçek?"
    },
    {
      "id": "DLG_ZH_HSK2_SC048_066",
      "speaker": "刘梅",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_067",
      "speaker": "张雨桐",
      "zh": "嗯，公园这点确实很实用。",
      "pinyin": "En, gōngyuán zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, park gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_068",
      "speaker": "张乐乐",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_069",
      "speaker": "张伟",
      "zh": "我觉得开了也很重要。",
      "pinyin": "Wǒ juéde kāi le yě hěn zhòngyào.",
      "tr": "Bence açtı de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_071",
      "speaker": "张雨桐",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_072",
      "speaker": "张乐乐",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_073",
      "speaker": "张伟",
      "zh": "嗯，春天这部分现在清楚多了。",
      "pinyin": "En, chūntiān zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, ilkbahar kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_074",
