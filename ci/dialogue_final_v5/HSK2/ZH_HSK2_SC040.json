{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC040",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "全家运动计划",
  "sourceTitleTr": "Ailece Egzersiz Kararı",
  "sourceMiniAdventureTr": "Aile düzenli yürüyüş yapmaya karar verir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC040_001",
      "speaker": "张伟",
      "zh": "我们需要一个全家运动计划。",
      "pinyin": "Wǒmen xūyào yígè quánjiā yùndòng jìhuà.",
      "tr": "Ailece bir egzersiz planına ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_003",
      "speaker": "张乐乐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_005",
      "speaker": "张伟",
      "zh": "我们先走路一下吧。",
      "pinyin": "Wǒmen xiān zǒulù yīxià ba.",
      "tr": "Önce yürümek."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_006",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_007",
      "speaker": "张乐乐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_008",
      "speaker": "张雨桐",
      "zh": "我们每天都走一走。",
      "pinyin": "Wǒmen měitiān dōu zǒu yī zǒu.",
      "tr": "Her gün biraz yürüyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_009",
      "speaker": "张伟",
      "zh": "好，每天这点我记住了。",
      "pinyin": "Hǎo, měitiān zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, her gün konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_011",
      "speaker": "张乐乐",
      "zh": "我们每周运动三次。",
      "pinyin": "Wǒmen měizhōu yùndòng sāncì.",
      "tr": "Haftada üç kez egzersiz yapıyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_012",
      "speaker": "张雨桐",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_014",
      "speaker": "刘梅",
      "zh": "我们先坚持一下吧。",
      "pinyin": "Wǒmen xiān jiānchí yīxià ba.",
      "tr": "Önce devam etmek / sürdürmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_017",
      "speaker": "张伟",
      "zh": "只做一天没有用。",
      "pinyin": "Zhǐ zuò yītiān méiyǒu yòng.",
      "tr": "Sadece bir gün yapmak işe yaramaz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC040_019",
      "speaker": "张乐乐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_020",
      "speaker": "张雨桐",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_022",
      "speaker": "刘梅",
      "zh": "这个计划很实际。",
      "pinyin": "Zhège jìhuà hěn shíjì.",
      "tr": "Bu plan oldukça gerçekçi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_024",
      "speaker": "张雨桐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_025",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_028",
      "speaker": "张雨桐",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_031",
      "speaker": "张乐乐",
      "zh": "我们先运动一下吧。",
      "pinyin": "Wǒmen xiān yùndòng yīxià ba.",
      "tr": "Önce egzersiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_032",
      "speaker": "张雨桐",
      "zh": "对，家人这点你说得对。",
      "pinyin": "Duì, jiārén zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, aile konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_035",
      "speaker": "张乐乐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_036",
      "speaker": "张雨桐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_044",
      "speaker": "张雨桐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_048",
      "speaker": "张雨桐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_051",
      "speaker": "张乐乐",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_054",
      "speaker": "刘梅",
      "zh": "我们先走路一下吧。",
      "pinyin": "Wǒmen xiān zǒulù yīxià ba.",
      "tr": "Önce yürümek."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_055",
      "speaker": "张乐乐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_056",
      "speaker": "张雨桐",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_057",
      "speaker": "张伟",
      "zh": "嗯，每天这点确实很实用。",
      "pinyin": "En, měitiān zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, her gün gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_059",
      "speaker": "张乐乐",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_060",
      "speaker": "张雨桐",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_061",
      "speaker": "张伟",
      "zh": "我觉得每天也很重要。",
      "pinyin": "Wǒ juéde měitiān yě hěn zhòngyào.",
      "tr": "Bence her gün de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_063",
      "speaker": "张乐乐",
      "zh": "嗯，计划这部分现在清楚多了。",
      "pinyin": "En, jìhuà zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, plan kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_064",
      "speaker": "张雨桐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_065",
      "speaker": "张伟",
      "zh": "那每周呢？",
      "pinyin": "Nà měizhōu ne?",
      "tr": "Peki her hafta?"
    },
    {
      "id": "DLG_ZH_HSK2_SC040_066",
      "speaker": "刘梅",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_067",
      "speaker": "张乐乐",
      "zh": "嗯，家人这点确实很实用。",
      "pinyin": "En, jiārén zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, aile gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_068",
      "speaker": "张雨桐",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_069",
      "speaker": "张伟",
      "zh": "我觉得先坚持一下比较好。",
      "pinyin": "Wǒ juéde xiān jiānchí yīxià bǐjiào hǎo.",
      "tr": "Bence önce “devam etmek / sürdürmek” kısmını ele almak daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_071",
      "speaker": "张乐乐",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC040_072",
      "speaker": "张雨桐",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
