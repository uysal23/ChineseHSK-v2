{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC009",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "新的手机套餐",
  "sourceTitleTr": "Yeni Telefon Hattı",
  "sourceMiniAdventureTr": "Aile telefon mağazasında veri ve dakika seçeneklerini karşılaştırır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC009_001",
      "speaker": "张伟",
      "zh": "我们想换手机套餐。",
      "pinyin": "Wǒmen xiǎnghuàn shǒujī tàocān.",
      "tr": "Telefon tarifesini değiştirmek istiyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_003",
      "speaker": "店员",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_005",
      "speaker": "刘梅",
      "zh": "我们来谈谈套餐。",
      "pinyin": "Wǒmen lái tántán tàocān.",
      "tr": "Tarife / paket hakkında konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_006",
      "speaker": "店员",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_008",
      "speaker": "刘梅",
      "zh": "这个流量在这儿。",
      "pinyin": "Zhège liúliàng zài zhèér.",
      "tr": "Bu internet kotası burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_009",
      "speaker": "店员",
      "zh": "好，流量这点我记住了。",
      "pinyin": "Hǎo, liúliàng zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, internet kotası konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_011",
      "speaker": "刘梅",
      "zh": "还要十分钟。",
      "pinyin": "Háiyào shífēnzhōng.",
      "tr": "On dakika daha gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_012",
      "speaker": "店员",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_014",
      "speaker": "刘梅",
      "zh": "我们先比较一下吧。",
      "pinyin": "Wǒmen xiān bǐjiào yīxià ba.",
      "tr": "Önce karşılaştırmak."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_015",
      "speaker": "店员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_017",
      "speaker": "刘梅",
      "zh": "这个流量多，但是更贵。",
      "pinyin": "Zhège liúliàng duō, dànshì gèngguì.",
      "tr": "Bunun interneti fazla ama daha pahalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_018",
      "speaker": "店员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC009_019",
      "speaker": "张伟",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_020",
      "speaker": "刘梅",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_021",
      "speaker": "店员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_022",
      "speaker": "张伟",
      "zh": "这个套餐每月多少钱？",
      "pinyin": "Zhège tàocān měiyuè duōshǎo qián?",
      "tr": "Bu tarife ayda ne kadar?"
    },
    {
      "id": "DLG_ZH_HSK2_SC009_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_024",
      "speaker": "店员",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_025",
      "speaker": "张伟",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_027",
      "speaker": "店员",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_028",
      "speaker": "张伟",
      "zh": "一个月的时间过得很快。",
      "pinyin": "Yígèyuè de shíjiān guòdé hěnkuài.",
      "tr": "Bir aylık süre çok hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_030",
      "speaker": "店员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_031",
      "speaker": "张伟",
      "zh": "我们先选择一下吧。",
      "pinyin": "Wǒmen xiān xuǎnzé yīxià ba.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_032",
      "speaker": "刘梅",
      "zh": "对，价格这点你说得对。",
      "pinyin": "Duì, jiàgé zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, fiyat konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_033",
      "speaker": "店员",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_036",
      "speaker": "店员",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_039",
      "speaker": "店员",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_042",
      "speaker": "店员",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_045",
      "speaker": "店员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_048",
      "speaker": "店员",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_051",
      "speaker": "店员",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_054",
      "speaker": "店员",
      "zh": "我们来谈谈套餐。",
      "pinyin": "Wǒmen lái tántán tàocān.",
      "tr": "Tarife / paket hakkında konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_055",
      "speaker": "张伟",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_056",
      "speaker": "刘梅",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_057",
      "speaker": "店员",
      "zh": "嗯，流量这点确实很实用。",
      "pinyin": "En, liúliàng zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, internet kotası gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_058",
      "speaker": "张伟",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_059",
      "speaker": "刘梅",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_060",
      "speaker": "店员",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_061",
      "speaker": "张伟",
      "zh": "我觉得流量也很重要。",
      "pinyin": "Wǒ juéde liúliàng yě hěn zhòngyào.",
      "tr": "Bence internet kotası de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_063",
      "speaker": "店员",
      "zh": "嗯，套餐这部分现在清楚多了。",
      "pinyin": "En, tàocān zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, tarife / paket kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_065",
      "speaker": "刘梅",
      "zh": "那分钟呢？",
      "pinyin": "Nà fēnzhōng ne?",
      "tr": "Peki dakika?"
    },
    {
      "id": "DLG_ZH_HSK2_SC009_066",
      "speaker": "店员",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_067",
      "speaker": "张伟",
      "zh": "嗯，价格这点确实很实用。",
      "pinyin": "En, jiàgé zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, fiyat gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_068",
      "speaker": "刘梅",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_069",
      "speaker": "店员",
      "zh": "我觉得先比较一下比较好。",
      "pinyin": "Wǒ juéde xiān bǐjiào yīxià bǐjiào hǎo.",
      "tr": "Bence önce “karşılaştırmak” kısmını ele almak daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_070",
      "speaker": "张伟",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_071",
      "speaker": "刘梅",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
