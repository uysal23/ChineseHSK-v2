{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK1_SC003",
  "level": "HSK1",
  "sceneCategory": "travel",
  "sourceTitleZh": "站台在哪儿？",
  "sourceTitleTr": "Peron Nerede?",
  "sourceMiniAdventureTr": "İstasyonda yanlış yöne giderler ve görevliye doğru peronu sorarlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC003_001",
      "speaker": "张伟",
      "zh": "我们要找站台。",
      "pinyin": "Wǒmen yào zhǎo zhàntái.",
      "tr": "Peronu bulmamız gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_003",
      "speaker": "工作人员",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_006",
      "speaker": "刘梅",
      "zh": "那车站在哪儿？",
      "pinyin": "Nà chēzhàn zài nǎér?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_007",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_008",
      "speaker": "张乐乐",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_009",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_010",
      "speaker": "刘梅",
      "zh": "站台呢？",
      "pinyin": "Zhàntái ne?",
      "tr": "Peron nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_011",
      "speaker": "工作人员",
      "zh": "你看，站台在那边。",
      "pinyin": "Nǐ kàn, zhàntái zài nàbiān.",
      "tr": "Peron şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_012",
      "speaker": "张乐乐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_013",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_014",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbiān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_015",
      "speaker": "工作人员",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbiān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_016",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_017",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_018",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubiān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_019",
      "speaker": "工作人员",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubiān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_020",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_021",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_022",
      "speaker": "刘梅",
      "zh": "我们走错了。",
      "pinyin": "Wǒmen zǒucuò le.",
      "tr": "Yanlış yöne gittik."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_027",
      "speaker": "工作人员",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuòhuǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_028",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuòhuǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_029",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_030",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_031",
      "speaker": "工作人员",
      "zh": "这是火车票，对吗？",
      "pinyin": "Zhèshì huǒchēpiào, duì ma?",
      "tr": "Bu, tren bileti mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_032",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是火车票。",
      "pinyin": "En, duì, zhèshì huǒchēpiào.",
      "tr": "Evet, bu tren bileti."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_033",
      "speaker": "张伟",
      "zh": "火车票在哪儿？",
      "pinyin": "Huǒchēpiào zài nǎér?",
      "tr": "Tren bileti nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_034",
      "speaker": "刘梅",
      "zh": "火车票在这儿。",
      "pinyin": "Huǒchēpiào zài zhèér.",
      "tr": "Tren bileti burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_035",
      "speaker": "工作人员",
      "zh": "你看到那路了吗？",
      "pinyin": "Nǐ kàndào nàlù le ma?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_036",
      "speaker": "张乐乐",
      "zh": "你看，就在那边。",
      "pinyin": "Nǐ kàn, jiù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_037",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_038",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_039",
      "speaker": "工作人员",
      "zh": "这是我们的人。",
      "pinyin": "Zhèshì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_040",
      "speaker": "张乐乐",
      "zh": "你好，请问一下。",
      "pinyin": "Nǐhǎo, qǐngwèn yīxià.",
      "tr": "Merhaba, bir şey sorabilir miyim?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_041",
      "speaker": "张伟",
      "zh": "当然，你说。",
      "pinyin": "Dāngrán, nǐ shuō.",
      "tr": "Elbette, buyurun."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_042",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_043",
      "speaker": "工作人员",
      "zh": "对，站台在右边。",
      "pinyin": "Duì, zhàntái zài yòubiān.",
      "tr": "Evet, peron sağ tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_045",
      "speaker": "张伟",
      "zh": "好，谢谢你。",
      "pinyin": "Hǎo, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_047",
      "speaker": "工作人员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_048",
      "speaker": "张乐乐",
      "zh": "那我们接着来。",
      "pinyin": "Nà wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
