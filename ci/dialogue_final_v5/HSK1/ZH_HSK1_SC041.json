{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK1_SC041",
  "level": "HSK1",
  "sceneCategory": "pet",
  "sourceTitleZh": "咪咪去看兽医",
  "sourceTitleTr": "Mimi Veterinerde",
  "sourceMiniAdventureTr": "Mimi yemek yemeyince aile onu veterinere götürür.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC041_001",
      "speaker": "刘梅",
      "zh": "咪咪今天不吃饭。",
      "pinyin": "Mīmī jīntiān bù chīfàn.",
      "tr": "Mimi bugün yemek yemiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_003",
      "speaker": "兽医",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_006",
      "speaker": "张伟",
      "zh": "这个是猫，对，对吗？",
      "pinyin": "Zhège shì māo, duì, duì ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_007",
      "speaker": "兽医",
      "zh": "嗯，对，这是猫。",
      "pinyin": "En, duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_008",
      "speaker": "张乐乐",
      "zh": "猫呢？",
      "pinyin": "Māo ne?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_009",
      "speaker": "刘梅",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_010",
      "speaker": "张伟",
      "zh": "这是我们的兽医。",
      "pinyin": "Zhèshì wǒmen de shòuyī.",
      "tr": "Bu bizim veteriner."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_011",
      "speaker": "兽医",
      "zh": "你好，我想问问这只猫。",
      "pinyin": "Nǐhǎo, wǒ xiǎng wènwèn zhè zhǐ māo.",
      "tr": "Merhaba, bu kedi hakkında sormak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_012",
      "speaker": "张乐乐",
      "zh": "好，先看看它怎么了。",
      "pinyin": "Hǎo, xiān kànkàn tā zěnme le.",
      "tr": "Tamam, önce ne olduğuna bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_013",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Evet, tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_014",
      "speaker": "张伟",
      "zh": "这是我们的医生。",
      "pinyin": "Zhèshì wǒmen de yīshēng.",
      "tr": "Bu bizim doktor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_015",
      "speaker": "兽医",
      "zh": "你好，我想问问这只猫。",
      "pinyin": "Nǐhǎo, wǒ xiǎng wènwèn zhè zhǐ māo.",
      "tr": "Merhaba, bu kedi hakkında sormak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_016",
      "speaker": "张乐乐",
      "zh": "好，先看看它怎么了。",
      "pinyin": "Hǎo, xiān kànkàn tā zěnme le.",
      "tr": "Tamam, önce ne olduğuna bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_017",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Evet, tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_018",
      "speaker": "张伟",
      "zh": "医院呢？",
      "pinyin": "Yīyuàn ne?",
      "tr": "Hastane nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_019",
      "speaker": "兽医",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Hastane şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_020",
      "speaker": "张乐乐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_021",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_022",
      "speaker": "张伟",
      "zh": "家人有一点担心。",
      "pinyin": "Jiārén yǒu yìdiǎn dānxīn.",
      "tr": "Aile biraz endişeli."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_023",
      "speaker": "兽医",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_026",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_027",
      "speaker": "兽医",
      "zh": "这个是药吗？",
      "pinyin": "Zhège shì yào ma?",
      "tr": "Bu, ilaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_028",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是药。",
      "pinyin": "En, duì, zhè shì yào.",
      "tr": "Evet, bu ilaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_029",
      "speaker": "刘梅",
      "zh": "药呢？",
      "pinyin": "Yào ne?",
      "tr": "Ilaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_030",
      "speaker": "张伟",
      "zh": "你看，药在这儿。",
      "pinyin": "Nǐ kàn, yào zài zhèér.",
      "tr": "Ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_031",
      "speaker": "兽医",
      "zh": "你要水吗？",
      "pinyin": "Nǐ yào shuǐ ma?",
      "tr": "Su ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_032",
      "speaker": "张乐乐",
      "zh": "我要水，谢谢。",
      "pinyin": "Wǒyào shuǐ, xièxiè.",
      "tr": "Su istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_033",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_035",
      "speaker": "兽医",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yàofàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_036",
      "speaker": "张乐乐",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_037",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_038",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_039",
      "speaker": "兽医",
      "zh": "那家在哪儿？",
      "pinyin": "Nàjiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_040",
      "speaker": "张乐乐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_041",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_042",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_043",
      "speaker": "兽医",
      "zh": "兽医说咪咪没有大问题。",
      "pinyin": "Shòuyī shuō mīmī méiyǒu dà wèntí.",
      "tr": "Veteriner Mimi’nin ciddi bir sorunu olmadığını söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_045",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_046",
      "speaker": "张伟",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_047",
      "speaker": "兽医",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_048",
      "speaker": "张乐乐",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jìxù ba.",
      "tr": "Devam edelim."
