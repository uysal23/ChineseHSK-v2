{
  "naturalizationVersion": 5,
  "status": "FINAL",
  "sceneId": "ZH_HSK1_SC039",
  "level": "HSK1",
  "sceneCategory": "travel",
  "sourceTitleZh": "突然下雨了",
  "sourceTitleTr": "Yağmur Başlıyor",
  "sourceMiniAdventureTr": "Park dönüşünde yağmur başlar ve şemsiyelerin evde kaldığını fark ederler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC039_001",
      "speaker": "张伟",
      "zh": "大家从公园回家。",
      "pinyin": "Dàjiā cóng gōngyuán huíjiā.",
      "tr": "Herkes parktan eve dönüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_003",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_004",
      "speaker": "张雨桐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_006",
      "speaker": "刘梅",
      "zh": "这个是雨吗？",
      "pinyin": "Zhège shì yǔ ma?",
      "tr": "Bu, yağmur mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_007",
      "speaker": "张乐乐",
      "zh": "对，就是雨。",
      "pinyin": "Duì, jiùshì yǔ.",
      "tr": "Evet, bu yağmur."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_008",
      "speaker": "张雨桐",
      "zh": "你看到雨了吗？",
      "pinyin": "Nǐ kàndào yǔ le ma?",
      "tr": "Yağmur nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_009",
      "speaker": "张伟",
      "zh": "雨在这儿。",
      "pinyin": "Yǔ zài zhèér.",
      "tr": "Yağmur burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_010",
      "speaker": "刘梅",
      "zh": "这个是雨伞吗？",
      "pinyin": "Zhège shì yǔsǎn ma?",
      "tr": "Bu, şemsiye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_011",
      "speaker": "张乐乐",
      "zh": "没错，是雨伞。",
      "pinyin": "Méicuò, shì yǔsǎn.",
      "tr": "Evet, bu şemsiye."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_012",
      "speaker": "张雨桐",
      "zh": "雨伞在哪儿？",
      "pinyin": "Yǔsǎn zài nǎér?",
      "tr": "Şemsiye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_013",
      "speaker": "张伟",
      "zh": "你看，雨伞在这儿。",
      "pinyin": "Nǐ kàn, yǔsǎn zài zhèér.",
      "tr": "Şemsiye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_014",
      "speaker": "刘梅",
      "zh": "这是天气吧？",
      "pinyin": "Zhèshì tiānqì ba?",
      "tr": "Bu, hava mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_015",
      "speaker": "张乐乐",
      "zh": "对，就是天气。",
      "pinyin": "Duì, jiùshì tiānqì.",
      "tr": "Evet, bu hava."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_016",
      "speaker": "张雨桐",
      "zh": "那天气在哪儿？",
      "pinyin": "Nà tiānqì zài nǎér?",
      "tr": "Hava nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_017",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Hava burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_018",
      "speaker": "刘梅",
      "zh": "这是外套吧？",
      "pinyin": "Zhèshì wàitào ba?",
      "tr": "Bu, mont mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_019",
      "speaker": "张乐乐",
      "zh": "对，就是外套。",
      "pinyin": "Duì, jiùshì wàitào.",
      "tr": "Evet, bu mont."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_020",
      "speaker": "张雨桐",
      "zh": "外套呢？",
      "pinyin": "Wàitào ne?",
      "tr": "Mont nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_021",
      "speaker": "张伟",
      "zh": "你看，外套在这儿。",
      "pinyin": "Nǐ kàn, wàitào zài zhèér.",
      "tr": "Mont burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_022",
      "speaker": "刘梅",
      "zh": "突然下雨了，可是没有雨伞。",
      "pinyin": "Tūrán xiàyǔ le, kěshì méiyǒu yǔsǎn.",
      "tr": "Birden yağmur başladı ama şemsiye yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_023",
      "speaker": "张乐乐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_027",
      "speaker": "张乐乐",
      "zh": "路呢？",
      "pinyin": "Lù ne?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_028",
      "speaker": "张雨桐",
      "zh": "你看，就在那边。",
      "pinyin": "Nǐ kàn, jiù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_029",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_030",
      "speaker": "刘梅",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_031",
      "speaker": "张乐乐",
      "zh": "那家呢？",
      "pinyin": "Nàjiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_032",
      "speaker": "张雨桐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_033",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_034",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_035",
      "speaker": "张乐乐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_036",
      "speaker": "张雨桐",
      "zh": "你好，请问一下。",
      "pinyin": "Nǐhǎo, qǐngwèn yīxià.",
      "tr": "Merhaba, bir şey sorabilir miyim?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_037",
      "speaker": "张伟",
      "zh": "当然，你说。",
      "pinyin": "Dāngrán, nǐ shuō.",
      "tr": "Elbette, buyurun."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_038",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_039",
      "speaker": "张乐乐",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_040",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_042",
      "speaker": "刘梅",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_043",
      "speaker": "张乐乐",
      "zh": "大家快走回家。",
      "pinyin": "Dàjiā kuài zǒu huíjiā.",
      "tr": "Herkes hızlıca eve yürüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_044",
      "speaker": "张雨桐",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_047",
      "speaker": "张乐乐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_048",
      "speaker": "张雨桐",
      "zh": "那我们接着来。",
      "pinyin": "Nà wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_049",
      "speaker": "张伟",
      "zh": "这是雨吗？",
      "pinyin": "Zhè shì yǔ ma?",
      "tr": "Bu, yağmur mı?"
