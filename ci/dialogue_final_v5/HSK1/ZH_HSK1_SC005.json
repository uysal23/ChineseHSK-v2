    {
      "id": "DLG_ZH_HSK1_SC005_039",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhèshì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
