    {
      "id": "DLG_ZH_HSK1_SC005_040",
      "speaker": "张伟",
      "zh": "找到了吗？",
      "pinyin": "Zhǎodào le ma?",
      "tr": "Buldunuz mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_041",
      "speaker": "张乐乐",
      "zh": "还没有，我们再看看。",
      "pinyin": "Hái méiyǒu, wǒmen zài kànkàn.",
      "tr": "Henüz değil, biraz daha bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_042",
      "speaker": "张雨桐",
      "zh": "我也来帮忙。",
      "pinyin": "Wǒ yě lái bāngmáng.",
      "tr": "Ben de yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_043",
      "speaker": "刘梅",
      "zh": "玩具在座位下面。",
      "pinyin": "Wánjù zài zuòwèi xiàmiàn.",
      "tr": "Oyuncak koltuğun altında."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_044",
      "speaker": "张伟",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_046",
      "speaker": "张雨桐",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_047",
      "speaker": "刘梅",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
