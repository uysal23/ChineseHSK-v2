  "sourceTitleZh": "丢失的玩具",
  "sourceTitleTr": "Kayıp Oyuncak",
  "sourceMiniAdventureTr": "Lele oyuncak trenini bulamaz; herkes koltukların çevresine bakar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC005_001",
      "speaker": "张乐乐",
      "zh": "乐乐在找玩具。",
      "pinyin": "Lèlè zài zhǎo wánjù.",
      "tr": "Lele oyuncağını arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_003",
      "speaker": "刘梅",
      "zh": "嗯，对。",
      "pinyin": "En, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_004",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_005",
      "speaker": "张乐乐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_006",
      "speaker": "张雨桐",
      "zh": "这个是玩具吗？",
      "pinyin": "Zhège shì wánjù ma?",
      "tr": "Bu, oyuncak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_007",
      "speaker": "刘梅",
      "zh": "对，就是玩具。",
      "pinyin": "Duì, jiùshì wánjù.",
      "tr": "Evet, bu oyuncak."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_008",
      "speaker": "张伟",
      "zh": "玩具呢？",
      "pinyin": "Wánjù ne?",
      "tr": "Oyuncak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_009",
      "speaker": "张乐乐",
      "zh": "玩具在这儿。",
      "pinyin": "Wánjù zài zhèér.",
      "tr": "Oyuncak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_010",
      "speaker": "张雨桐",
      "zh": "这个是座位吗？",
      "pinyin": "Zhège shì zuòwèi ma?",
      "tr": "Bu, koltuk / oturma yeri mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_011",
      "speaker": "刘梅",
      "zh": "对，就是座位。",
      "pinyin": "Duì, jiùshì zuòwèi.",
      "tr": "Evet, bu koltuk / oturma yeri."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_012",
      "speaker": "张伟",
      "zh": "座位呢？",
      "pinyin": "Zuòwèi ne?",
      "tr": "Koltuk / oturma yeri nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_013",
      "speaker": "张乐乐",
      "zh": "你看，座位在这儿。",
      "pinyin": "Nǐ kàn, zuòwèi zài zhèér.",
      "tr": "Koltuk / oturma yeri burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_014",
      "speaker": "张雨桐",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuòhuǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_015",
      "speaker": "刘梅",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuòhuǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_016",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_017",
      "speaker": "张乐乐",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_018",
      "speaker": "张雨桐",
      "zh": "这个是包吗？",
      "pinyin": "Zhège shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_019",
      "speaker": "刘梅",
      "zh": "没错，是包。",
      "pinyin": "Méicuò, shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_020",
      "speaker": "张伟",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_021",
      "speaker": "张乐乐",
      "zh": "你看，包在这儿。",
      "pinyin": "Nǐ kàn, bāo zài zhèér.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_022",
      "speaker": "张雨桐",
      "zh": "玩具不在包里。",
      "pinyin": "Wánjù bù zài bāolǐ.",
      "tr": "Oyuncak çantada değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_026",
      "speaker": "张雨桐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_027",
      "speaker": "刘梅",
      "zh": "这个是猫吗？",
      "pinyin": "Zhège shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_028",
      "speaker": "张伟",
      "zh": "对，就是猫。",
      "pinyin": "Duì, jiùshì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_029",
      "speaker": "张乐乐",
      "zh": "你看到那猫了吗？",
      "pinyin": "Nǐ kàndào nàmāo le ma?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_030",
      "speaker": "张雨桐",
      "zh": "猫在这儿。",
      "pinyin": "Māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_031",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbiān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_032",
      "speaker": "张伟",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbiān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_033",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_034",
      "speaker": "张雨桐",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_035",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubiān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_036",
      "speaker": "张伟",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubiān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_037",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_038",
      "speaker": "张雨桐",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
