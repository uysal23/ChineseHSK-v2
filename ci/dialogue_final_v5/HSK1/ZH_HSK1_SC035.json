      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_045",
      "speaker": "张伟",
      "zh": "好，谢谢你。",
