    {
      "id": "DLG_ZH_HSK1_SC016_042",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_043",
      "speaker": "邻居",
      "zh": "邻居告诉我们怎么走。",
      "pinyin": "Línjū gàosù wǒmen zěnme zǒu.",
      "tr": "Komşu bize nasıl gideceğimizi söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_045",
      "speaker": "张伟",
      "zh": "真的谢谢你。",
      "pinyin": "Zhēnde xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
