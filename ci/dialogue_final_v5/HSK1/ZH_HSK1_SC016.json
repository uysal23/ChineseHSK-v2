  "level": "HSK1",
  "sceneCategory": "travel",
  "sourceTitleZh": "超市在哪儿？",
  "sourceTitleTr": "Market Nerede?",
  "sourceMiniAdventureTr": "Aile mahalledeki marketi bulmak için komşuya yol sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC016_001",
      "speaker": "张伟",
      "zh": "我们要去超市。",
      "pinyin": "Wǒmen yào qù chāoshì.",
      "tr": "Süpermarkete gideceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_003",
      "speaker": "邻居",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_006",
      "speaker": "刘梅",
      "zh": "那超市呢？",
      "pinyin": "Nà chāoshì ne?",
      "tr": "Süpermarket nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_007",
      "speaker": "邻居",
      "zh": "你看，超市在那边。",
      "pinyin": "Nǐ kàn, chāoshì zài nàbiān.",
      "tr": "Süpermarket şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_008",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_009",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_010",
      "speaker": "刘梅",
      "zh": "那路呢？",
      "pinyin": "Nàlù ne?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_011",
      "speaker": "邻居",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_012",
      "speaker": "张乐乐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_013",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_014",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbiān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_015",
      "speaker": "邻居",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbiān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_016",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_017",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_018",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubiān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_019",
      "speaker": "邻居",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubiān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_020",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_022",
      "speaker": "刘梅",
      "zh": "我们不知道超市在哪儿。",
      "pinyin": "Wǒmen bù zhīdào chāoshì zài nǎér.",
      "tr": "Süpermarketin nerede olduğunu bilmiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_023",
      "speaker": "邻居",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_027",
      "speaker": "邻居",
      "zh": "那家在哪儿？",
      "pinyin": "Nàjiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_028",
      "speaker": "张乐乐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_029",
      "speaker": "张伟",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_030",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_031",
      "speaker": "邻居",
      "zh": "商店呢？",
      "pinyin": "Shāngdiàn ne?",
      "tr": "Mağaza nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_032",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Mağaza şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_033",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_035",
      "speaker": "邻居",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhèshì wǒmen de línjū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_036",
      "speaker": "张乐乐",
      "zh": "你好，请问一下。",
      "pinyin": "Nǐhǎo, qǐngwèn yīxià.",
      "tr": "Merhaba, bir şey sorabilir miyim?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_037",
      "speaker": "张伟",
      "zh": "当然，你说。",
      "pinyin": "Dāngrán, nǐ shuō.",
      "tr": "Elbette, buyurun."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_038",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_039",
      "speaker": "邻居",
      "zh": "这是我们的人。",
      "pinyin": "Zhèshì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_040",
      "speaker": "张乐乐",
      "zh": "你好，请问一下。",
