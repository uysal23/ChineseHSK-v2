  "sourceTitleZh": "邻居的包裹",
  "sourceTitleTr": "Komşunun Paketi",
  "sourceMiniAdventureTr": "Kurye komşunun paketini yanlışlıkla Zhang ailesine bırakır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC040_001",
      "speaker": "张伟",
      "zh": "快递送来了一个包裹。",
      "pinyin": "Kuàidì sònglái le yígè bāoguǒ.",
      "tr": "Kurye bir paket getirdi."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_003",
      "speaker": "快递员",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_004",
      "speaker": "邻居",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_006",
      "speaker": "刘梅",
      "zh": "这个是包裹，对吗？",
      "pinyin": "Zhège shì bāoguǒ, duì ma?",
      "tr": "Bu, paket / kargo mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_007",
      "speaker": "快递员",
      "zh": "没错，是包裹。",
      "pinyin": "Méicuò, shì bāoguǒ.",
      "tr": "Evet, bu paket / kargo."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_008",
      "speaker": "邻居",
      "zh": "包裹呢？",
      "pinyin": "Bāoguǒ ne?",
      "tr": "Paket / kargo nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_009",
      "speaker": "张伟",
      "zh": "你看，就在这儿。",
      "pinyin": "Nǐ kàn, jiù zài zhèér.",
      "tr": "Paket / kargo burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_010",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dìzhǐ shì shénme?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_011",
      "speaker": "快递员",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_012",
      "speaker": "邻居",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_013",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_014",
      "speaker": "刘梅",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhèshì wǒmen de línjū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_015",
      "speaker": "快递员",
      "zh": "找到了吗？",
      "pinyin": "Zhǎodào le ma?",
      "tr": "Buldunuz mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_016",
      "speaker": "邻居",
      "zh": "还没有，我们再看看。",
      "pinyin": "Hái méiyǒu, wǒmen zài kànkàn.",
      "tr": "Henüz değil, biraz daha bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_017",
      "speaker": "张伟",
      "zh": "我也来帮忙。",
      "pinyin": "Wǒ yě lái bāngmáng.",
      "tr": "Ben de yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_018",
      "speaker": "刘梅",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_019",
      "speaker": "快递员",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiùshì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_020",
      "speaker": "邻居",
      "zh": "你看到门了吗？",
      "pinyin": "Nǐ kàndào mén le ma?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_021",
      "speaker": "张伟",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_022",
      "speaker": "刘梅",
      "zh": "包裹上的名字不是张伟。",
      "pinyin": "Bāoguǒ shàng de míngzì búshì zhāngwěi.",
      "tr": "Paketin üzerindeki isim Zhang Wei değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_023",
      "speaker": "快递员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_024",
      "speaker": "邻居",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_027",
      "speaker": "快递员",
      "zh": "你看到家了吗？",
      "pinyin": "Nǐ kàndào jiā le ma?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_028",
      "speaker": "邻居",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_029",
      "speaker": "张伟",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_030",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_031",
      "speaker": "快递员",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_032",
      "speaker": "邻居",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_033",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_034",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
