    {
      "id": "DLG_ZH_HSK1_SC040_035",
      "speaker": "快递员",
      "zh": "这是电话吗？",
      "pinyin": "Zhèshì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_036",
      "speaker": "邻居",
      "zh": "嗯，对，这是电话。",
      "pinyin": "En, duì, zhèshì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_037",
