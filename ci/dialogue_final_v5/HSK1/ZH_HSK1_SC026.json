  "sourceTitleZh": "张伟找工作",
  "sourceTitleTr": "Zhang İş Arıyor",
  "sourceMiniAdventureTr": "Zhang yerel ilanlara bakar ve Li Chen’den yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC026_001",
      "speaker": "张伟",
      "zh": "张伟开始找工作。",
      "pinyin": "Zhāngwěi kāishǐ zhǎo gōngzuò.",
      "tr": "Zhang Wei iş aramaya başlıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_002",
      "speaker": "李晨",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_003",
      "speaker": "刘梅",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_004",
      "speaker": "张雨桐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_006",
      "speaker": "李晨",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_007",
      "speaker": "刘梅",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_008",
      "speaker": "张雨桐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_010",
      "speaker": "李晨",
      "zh": "这个是电话，对，对吗？",
      "pinyin": "Zhège shì diànhuà, duì, duì ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_011",
      "speaker": "刘梅",
      "zh": "没错，是电话。",
      "pinyin": "Méicuò, shì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_012",
      "speaker": "张雨桐",
      "zh": "电话呢？",
      "pinyin": "Diànhuà ne?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_013",
      "speaker": "张伟",
      "zh": "你看，电话在这儿。",
      "pinyin": "Nǐ kàn, diànhuà zài zhèér.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_014",
      "speaker": "李晨",
      "zh": "你的电话号码是什么？",
      "pinyin": "Nǐ de diànhuàhàomǎ shì shénme?",
      "tr": "Telefon numarası nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_015",
      "speaker": "刘梅",
      "zh": "这是我的电话号码。",
      "pinyin": "Zhè shì wǒ de diànhuàhàomǎ.",
      "tr": "Bu benim telefon numarası."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_016",
      "speaker": "张雨桐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_017",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_018",
      "speaker": "李晨",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_019",
      "speaker": "刘梅",
      "zh": "找到了吗？",
      "pinyin": "Zhǎodào le ma?",
      "tr": "Buldunuz mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_020",
      "speaker": "张雨桐",
      "zh": "还没有，我们再看看。",
      "pinyin": "Hái méiyǒu, wǒmen zài kànkàn.",
      "tr": "Henüz değil, biraz daha bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_021",
      "speaker": "张伟",
      "zh": "我也来帮忙。",
      "pinyin": "Wǒ yě lái bāngmáng.",
      "tr": "Ben de yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_022",
      "speaker": "李晨",
      "zh": "他还不知道给谁打电话。",
      "pinyin": "Tā hái bù zhīdào gěi shuí dǎdiànhuà.",
      "tr": "Kimi arayacağını henüz bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_026",
      "speaker": "李晨",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_027",
      "speaker": "刘梅",
      "zh": "办公室呢？",
      "pinyin": "Bàngōngshì ne?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_028",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_029",
      "speaker": "张伟",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_030",
      "speaker": "李晨",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_031",
      "speaker": "刘梅",
      "zh": "这是我们的经理。",
      "pinyin": "Zhèshì wǒmen de jīnglǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_032",
      "speaker": "张雨桐",
      "zh": "找到了吗？",
      "pinyin": "Zhǎodào le ma?",
      "tr": "Buldunuz mu?"
