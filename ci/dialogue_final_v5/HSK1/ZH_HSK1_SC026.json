      "zh": "电脑在这儿。",
      "pinyin": "Diànnǎo zài zhèér.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_039",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_040",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_042",
      "speaker": "李晨",
      "zh": "那我们接着来。",
      "pinyin": "Nà wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_043",
      "speaker": "刘梅",
      "zh": "李晨给了他一个电话号码。",
      "pinyin": "Lǐchén gěi le tā yígè diànhuàhàomǎ.",
      "tr": "Li Chen ona bir telefon numarası veriyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_044",
      "speaker": "张雨桐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_045",
      "speaker": "张伟",
      "zh": "好，谢谢你。",
      "pinyin": "Hǎo, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_046",
