      "zh": "没错，是电脑。",
      "pinyin": "Méicuò, shì diànnǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_037",
      "speaker": "张伟",
      "zh": "电脑呢？",
      "pinyin": "Diànnǎo ne?",
      "tr": "Bilgisayar nerede?"
