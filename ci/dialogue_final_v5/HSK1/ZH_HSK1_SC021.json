  "level": "HSK1",
  "sceneCategory": "travel",
  "sourceTitleZh": "新高中的校门",
  "sourceTitleTr": "Yeni Lisenin Kapısı",
  "sourceMiniAdventureTr": "Yutong yanlış binaya yönelir ve okul görevlisinden yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC021_001",
      "speaker": "张雨桐",
      "zh": "雨桐第一天去新高中。",
      "pinyin": "Yǔtóng dìyītiān qù xīn gāozhōng.",
      "tr": "Yutong’un yeni lisede ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_002",
      "speaker": "老师",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_003",
      "speaker": "工作人员",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_004",
      "speaker": "同学",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_005",
      "speaker": "张雨桐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_006",
      "speaker": "老师",
      "zh": "你看到那高中了吗？",
      "pinyin": "Nǐ kàndào nà gāozhōng le ma?",
      "tr": "Lise nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_007",
      "speaker": "工作人员",
      "zh": "你看，就在那边。",
      "pinyin": "Nǐ kàn, jiù zài nàbiān.",
      "tr": "Lise şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_008",
      "speaker": "同学",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_009",
      "speaker": "张雨桐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_010",
      "speaker": "老师",
      "zh": "你看到学校了吗？",
      "pinyin": "Nǐ kàndào xuéxiào le ma?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_011",
      "speaker": "工作人员",
      "zh": "你看，学校在那边。",
      "pinyin": "Nǐ kàn, xuéxiào zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_012",
      "speaker": "同学",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_013",
      "speaker": "张雨桐",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_014",
      "speaker": "老师",
      "zh": "你看到那教室了吗？",
      "pinyin": "Nǐ kàndào nà jiàoshì le ma?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_015",
      "speaker": "工作人员",
      "zh": "你看，教室在那边。",
      "pinyin": "Nǐ kàn, jiàoshì zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_016",
      "speaker": "同学",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_017",
      "speaker": "张雨桐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_018",
      "speaker": "老师",
      "zh": "这是我们的学生。",
      "pinyin": "Zhèshì wǒmen de xuéshēng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_019",
      "speaker": "工作人员",
      "zh": "你好，请问一下。",
      "pinyin": "Nǐhǎo, qǐngwèn yīxià.",
      "tr": "Merhaba, bir şey sorabilir miyim?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_020",
      "speaker": "同学",
      "zh": "当然，你说。",
      "pinyin": "Dāngrán, nǐ shuō.",
      "tr": "Elbette, buyurun."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_021",
      "speaker": "张雨桐",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_022",
      "speaker": "老师",
      "zh": "她走到了错误的楼。",
      "pinyin": "Tā zǒu dào le cuòwù de lóu.",
      "tr": "Yanlış binaya gitti."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_025",
      "speaker": "张雨桐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_026",
      "speaker": "老师",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_027",
      "speaker": "工作人员",
      "zh": "这是我们的老师。",
      "pinyin": "Zhèshì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_028",
      "speaker": "同学",
      "zh": "你好，请问一下。",
      "pinyin": "Nǐhǎo, qǐngwèn yīxià.",
      "tr": "Merhaba, bir şey sorabilir miyim?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_029",
      "speaker": "张雨桐",
      "zh": "当然，你说。",
      "pinyin": "Dāngrán, nǐ shuō.",
      "tr": "Elbette, buyurun."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_030",
      "speaker": "老师",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_031",
      "speaker": "工作人员",
      "zh": "路呢？",
      "pinyin": "Lù ne?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_032",
      "speaker": "同学",
      "zh": "路在那边。",
      "pinyin": "Lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_033",
      "speaker": "张雨桐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_034",
      "speaker": "老师",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_035",
      "speaker": "工作人员",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_036",
      "speaker": "同学",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiùshì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_037",
      "speaker": "张雨桐",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_038",
      "speaker": "老师",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_039",
      "speaker": "工作人员",
      "zh": "这个是班吗？",
      "pinyin": "Zhège shì bān ma?",
      "tr": "Bu, sınıf / şube mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_040",
      "speaker": "同学",
      "zh": "没错，是班。",
      "pinyin": "Méicuò, shì bān.",
      "tr": "Evet, bu sınıf / şube."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_041",
      "speaker": "张雨桐",
      "zh": "你看到班了吗？",
      "pinyin": "Nǐ kàndào bān le ma?",
      "tr": "Sınıf / şube nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_042",
      "speaker": "老师",
      "zh": "班在这儿。",
      "pinyin": "Bān zài zhèér.",
      "tr": "Sınıf / şube burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_043",
      "speaker": "工作人员",
      "zh": "老师告诉她教室在哪儿。",
      "pinyin": "Lǎoshī gàosù tā jiàoshì zài nǎér.",
      "tr": "Öğretmen ona sınıfın nerede olduğunu söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_044",
      "speaker": "同学",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_045",
      "speaker": "张雨桐",
      "zh": "好，谢谢你。",
      "pinyin": "Hǎo, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_046",
      "speaker": "老师",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_047",
      "speaker": "工作人员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_048",
      "speaker": "同学",
      "zh": "那我们接着来。",
      "pinyin": "Nà wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_049",
      "speaker": "张雨桐",
      "zh": "高中在哪儿？",
      "pinyin": "Gāozhōng zài nǎér?",
      "tr": "Lise nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_050",
      "speaker": "老师",
      "zh": "你看，高中在那边。",
