  "sceneCategory": "travel",
  "sourceTitleZh": "认识李晨",
  "sourceTitleTr": "Li Chen ile Tanışma",
  "sourceMiniAdventureTr": "Li Chen aileye yardım teklif eder; bu tanışma uzun bir dostluğun başlangıcı olur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC008_001",
      "speaker": "张伟",
      "zh": "李晨来帮我们。",
      "pinyin": "Lǐchénlái bāng wǒmen.",
      "tr": "Li Chen bize yardım etmeye geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_003",
      "speaker": "李晨",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_006",
      "speaker": "刘梅",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_007",
      "speaker": "李晨",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_008",
      "speaker": "张乐乐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_009",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_010",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_011",
      "speaker": "李晨",
      "zh": "你好，请问一下。",
      "pinyin": "Nǐhǎo, qǐngwèn yīxià.",
      "tr": "Merhaba, bir şey sorabilir miyim?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_012",
      "speaker": "张乐乐",
      "zh": "当然，你说。",
      "pinyin": "Dāngrán, nǐ shuō.",
      "tr": "Elbette, buyurun."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_013",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_014",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_015",
      "speaker": "李晨",
      "zh": "你好，请问一下。",
      "pinyin": "Nǐhǎo, qǐngwèn yīxià.",
      "tr": "Merhaba, bir şey sorabilir miyim?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_016",
      "speaker": "张乐乐",
      "zh": "当然，你说。",
      "pinyin": "Dāngrán, nǐ shuō.",
      "tr": "Elbette, buyurun."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_018",
      "speaker": "刘梅",
      "zh": "车站呢？",
      "pinyin": "Chēzhàn ne?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_019",
      "speaker": "李晨",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_020",
      "speaker": "张乐乐",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_022",
      "speaker": "刘梅",
      "zh": "我们还不认识他。",
      "pinyin": "Wǒmen hái bù rènshí tā.",
      "tr": "Onu henüz tanımıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_026",
      "speaker": "刘梅",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_027",
      "speaker": "李晨",
      "zh": "你看到那城市了吗？",
      "pinyin": "Nǐ kàndào nà chéngshì le ma?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_028",
      "speaker": "张乐乐",
      "zh": "你看，就在那边。",
      "pinyin": "Nǐ kàn, jiù zài nàbiān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_029",
      "speaker": "张伟",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_031",
      "speaker": "李晨",
      "zh": "这个是电话，对，对吗？",
      "pinyin": "Zhège shì diànhuà, duì, duì ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_032",
      "speaker": "张乐乐",
      "zh": "对，就是电话。",
      "pinyin": "Duì, jiùshì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_033",
      "speaker": "张伟",
      "zh": "电话在哪儿？",
      "pinyin": "Diànhuà zài nǎér?",
      "tr": "Telefon nerede?"
