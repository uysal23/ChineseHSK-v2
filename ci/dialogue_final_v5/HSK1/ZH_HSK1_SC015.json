    {
      "id": "DLG_ZH_HSK1_SC015_045",
      "speaker": "刘梅",
      "zh": "好，谢谢你。",
      "pinyin": "Hǎo, xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_046",
      "speaker": "邻居",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
