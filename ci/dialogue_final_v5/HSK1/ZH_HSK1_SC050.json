  "sourceTitleZh": "这里是我们的家",
  "sourceTitleTr": "Artık Evimiz Burası",
  "sourceMiniAdventureTr": "Aile ve Li Chen’ler birlikte yemek yer; herkes yeni kasabada sevdiği bir şeyi söyler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC050_001",
      "speaker": "张伟",
      "zh": "今天两家人一起吃饭。",
      "pinyin": "Jīntiān liǎngjiā rén yìqǐ chīfàn.",
      "tr": "Bugün iki aile birlikte yemek yiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_003",
      "speaker": "李晨",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_004",
      "speaker": "李晨妻子",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_006",
      "speaker": "刘梅",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_007",
      "speaker": "李晨",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_008",
      "speaker": "李晨妻子",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_009",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_011",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_012",
      "speaker": "李晨妻子",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_013",
      "speaker": "张伟",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_015",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_016",
      "speaker": "李晨妻子",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_017",
      "speaker": "张伟",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_018",
      "speaker": "刘梅",
      "zh": "新城呢？",
      "pinyin": "Xīnchéng ne?",
      "tr": "Yeni şehir / kasaba nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_019",
      "speaker": "李晨",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Yeni şehir / kasaba şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_020",
      "speaker": "李晨妻子",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_021",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_022",
      "speaker": "刘梅",
      "zh": "大家说起刚来新城的时候。",
      "pinyin": "Dàjiā shuōqǐ gāng lái xīnchéng de shíhòu.",
      "tr": "Herkes yeni kasabaya ilk geldikleri zamanı konuşuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_024",
      "speaker": "李晨妻子",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_027",
      "speaker": "李晨",
      "zh": "学校呢？",
      "pinyin": "Xuéxiào ne?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_028",
      "speaker": "李晨妻子",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_029",
      "speaker": "张伟",
      "zh": "嗯，知道了。",
      "pinyin": "En, zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_031",
      "speaker": "李晨",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_032",
      "speaker": "李晨妻子",
      "zh": "嗯，对。",
      "pinyin": "En, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_033",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_034",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_035",
      "speaker": "李晨",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàngāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_036",
      "speaker": "李晨妻子",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒyào dàngāo, xièxiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_037",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_038",
