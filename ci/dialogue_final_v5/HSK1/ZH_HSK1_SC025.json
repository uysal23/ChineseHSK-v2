  "level": "HSK1",
  "sceneCategory": "lost",
  "sourceTitleZh": "丢失的铅笔",
  "sourceTitleTr": "Kaybolan Kalem",
  "sourceMiniAdventureTr": "Lele mavi kaleminin başka bir öğrencide olduğunu sanır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC025_001",
      "speaker": "张乐乐",
      "zh": "乐乐在找蓝色铅笔。",
      "pinyin": "Lèlè zài zhǎo lánsè qiānbǐ.",
      "tr": "Lele mavi kalemini arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_002",
      "speaker": "同学",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_003",
      "speaker": "老师",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_004",
      "speaker": "刘梅",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_006",
      "speaker": "同学",
      "zh": "这个是铅笔，对，对吗？",
      "pinyin": "Zhège shì qiānbǐ, duì, duì ma?",
      "tr": "Bu, kurşun kalem mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_007",
      "speaker": "老师",
      "zh": "没错，是铅笔。",
      "pinyin": "Méicuò, shì qiānbǐ.",
      "tr": "Evet, bu kurşun kalem."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_008",
      "speaker": "刘梅",
      "zh": "铅笔呢？",
      "pinyin": "Qiānbǐ ne?",
      "tr": "Kurşun kalem nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_009",
      "speaker": "张乐乐",
      "zh": "铅笔在这儿。",
      "pinyin": "Qiānbǐ zài zhèér.",
      "tr": "Kurşun kalem burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_010",
      "speaker": "同学",
      "zh": "你喜欢蓝色吗？",
      "pinyin": "Nǐ xǐhuān lánsè ma?",
      "tr": "Mavi renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_011",
      "speaker": "老师",
      "zh": "嗯，喜欢。",
      "pinyin": "En, xǐhuān.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_012",
      "speaker": "刘梅",
      "zh": "这个是蓝色的。",
      "pinyin": "Zhège shì lánsè de.",
      "tr": "Bu mavi renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_013",
      "speaker": "张乐乐",
      "zh": "很好看。",
      "pinyin": "Hěn hǎokàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_014",
      "speaker": "同学",
      "zh": "你觉得红色怎么样？",
      "pinyin": "Nǐ juéde hóngsè zěnmeyàng?",
      "tr": "Kırmızı renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_015",
      "speaker": "老师",
      "zh": "嗯，喜欢。",
      "pinyin": "En, xǐhuān.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_016",
      "speaker": "刘梅",
      "zh": "你看，这是红色的。",
      "pinyin": "Nǐ kàn, zhèshì hóngsè de.",
      "tr": "Bu kırmızı renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_017",
      "speaker": "张乐乐",
      "zh": "很好看。",
      "pinyin": "Hěn hǎokàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_018",
      "speaker": "同学",
      "zh": "那个学生也来帮忙找。",
      "pinyin": "Nàge xuéshēng yě lái bāngmáng zhǎo.",
      "tr": "O öğrenci de aramaya yardım ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_019",
      "speaker": "老师",
      "zh": "找到了吗？",
      "pinyin": "Zhǎodào le ma?",
      "tr": "Buldunuz mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_020",
      "speaker": "刘梅",
      "zh": "还没有，我们再看看。",
      "pinyin": "Hái méiyǒu, wǒmen zài kànkàn.",
      "tr": "Henüz değil, biraz daha bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_021",
      "speaker": "张乐乐",
      "zh": "我也来帮忙。",
      "pinyin": "Wǒ yě lái bāngmáng.",
      "tr": "Ben de yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_022",
      "speaker": "同学",
      "zh": "他以为同学拿了他的铅笔。",
      "pinyin": "Tā yǐwéi tóngxué ná le tā de qiānbǐ.",
      "tr": "Sınıf arkadaşının kalemini aldığını sanıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_023",
      "speaker": "老师",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_024",
      "speaker": "刘梅",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_026",
      "speaker": "同学",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_027",
      "speaker": "老师",
      "zh": "老师也过来帮忙了。",
      "pinyin": "Lǎoshī yě guòlái bāngmáng le.",
      "tr": "Öğretmen de yardıma geldi."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_028",
      "speaker": "刘梅",
      "zh": "找到了吗？",
      "pinyin": "Zhǎodào le ma?",
      "tr": "Buldunuz mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_029",
      "speaker": "张乐乐",
      "zh": "还没有，我们再看看。",
      "pinyin": "Hái méiyǒu, wǒmen zài kànkàn.",
      "tr": "Henüz değil, biraz daha bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_030",
      "speaker": "同学",
      "zh": "我也来帮忙。",
      "pinyin": "Wǒ yě lái bāngmáng.",
      "tr": "Ben de yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_031",
      "speaker": "老师",
      "zh": "教室呢？",
      "pinyin": "Jiàoshì ne?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_032",
      "speaker": "刘梅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_033",
      "speaker": "张乐乐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_034",
      "speaker": "同学",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_035",
      "speaker": "老师",
      "zh": "这是书，对吗？",
      "pinyin": "Zhè shì shū, duì ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_036",
      "speaker": "刘梅",
      "zh": "对，就是书。",
      "pinyin": "Duì, jiùshì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_037",
      "speaker": "张乐乐",
      "zh": "书呢？",
      "pinyin": "Shū ne?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_038",
      "speaker": "同学",
      "zh": "书在这儿。",
      "pinyin": "Shū zài zhèér.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_039",
      "speaker": "老师",
      "zh": "这个是包，对吗？",
      "pinyin": "Zhège shì bāo, duì ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_040",
      "speaker": "刘梅",
      "zh": "没错，是包。",
      "pinyin": "Méicuò, shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_041",
      "speaker": "张乐乐",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_042",
      "speaker": "同学",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_043",
      "speaker": "老师",
      "zh": "原来铅笔在自己的书包里。",
      "pinyin": "Yuánlái qiānbǐ zài zìjǐ de shūbāo lǐ.",
      "tr": "Meğer kalem kendi çantasındaymış."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_044",
      "speaker": "刘梅",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_045",
      "speaker": "张乐乐",
      "zh": "真的谢谢你。",
      "pinyin": "Zhēnde xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_046",
      "speaker": "同学",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_047",
      "speaker": "老师",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_048",
      "speaker": "刘梅",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_049",
      "speaker": "张乐乐",
      "zh": "这是铅笔吗？",
      "pinyin": "Zhèshì qiānbǐ ma?",
      "tr": "Bu, kurşun kalem mı?"
    },
