  "sourceTitleZh": "孩子们一起玩",
  "sourceTitleTr": "Çocuklar Birlikte Oynuyor",
  "sourceMiniAdventureTr": "Çocuklar aynı oyuncakla oynamak ister ve küçük bir paylaşma sorunu çıkar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC036_001",
      "speaker": "张乐乐",
      "zh": "孩子们一起玩。",
      "pinyin": "Háizi men yìqǐ wán.",
      "tr": "Çocuklar birlikte oynuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_002",
      "speaker": "小朋友",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_003",
      "speaker": "张雨桐",
      "zh": "是的。",
      "pinyin": "Shì de.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_004",
      "speaker": "刘梅",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_005",
      "speaker": "张乐乐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_006",
      "speaker": "小朋友",
      "zh": "这是玩具吧？",
      "pinyin": "Zhèshì wánjù ba?",
      "tr": "Bu, oyuncak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_007",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是玩具。",
      "pinyin": "En, duì, zhèshì wánjù.",
      "tr": "Evet, bu oyuncak."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_008",
      "speaker": "刘梅",
      "zh": "玩具呢？",
      "pinyin": "Wánjù ne?",
      "tr": "Oyuncak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_009",
      "speaker": "张乐乐",
      "zh": "玩具在这儿。",
      "pinyin": "Wánjù zài zhèér.",
      "tr": "Oyuncak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_010",
      "speaker": "小朋友",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhèshì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_011",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_012",
      "speaker": "刘梅",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_013",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_014",
      "speaker": "小朋友",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_015",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_016",
      "speaker": "刘梅",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_017",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_018",
      "speaker": "小朋友",
      "zh": "这个是球吗？",
      "pinyin": "Zhège shì qiú ma?",
      "tr": "Bu, top mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_019",
      "speaker": "张雨桐",
      "zh": "对，就是球。",
      "pinyin": "Duì, jiùshì qiú.",
      "tr": "Evet, bu top."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_020",
      "speaker": "刘梅",
      "zh": "那球呢？",
      "pinyin": "Nàqiú ne?",
      "tr": "Top nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_021",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Top burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_022",
      "speaker": "小朋友",
      "zh": "两个孩子都想要同一个玩具。",
      "pinyin": "Liǎnggè háizi dōu xiǎngyào tóngyīgè wánjù.",
      "tr": "İki çocuk da aynı oyuncağı istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_024",
      "speaker": "刘梅",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_026",
      "speaker": "小朋友",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_027",
      "speaker": "张雨桐",
      "zh": "你看到家了吗？",
      "pinyin": "Nǐ kàndào jiā le ma?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_028",
      "speaker": "刘梅",
      "zh": "你看，就在那边。",
      "pinyin": "Nǐ kàn, jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_029",
      "speaker": "张乐乐",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_030",
      "speaker": "小朋友",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_031",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_032",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_033",
      "speaker": "张乐乐",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_034",
      "speaker": "小朋友",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_035",
      "speaker": "张雨桐",
      "zh": "这个是椅子吗？",
      "pinyin": "Zhège shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_036",
      "speaker": "刘梅",
      "zh": "对，就是椅子。",
      "pinyin": "Duì, jiùshì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_037",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎér?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_038",
      "speaker": "小朋友",
      "zh": "椅子在这儿。",
      "pinyin": "Yǐzi zài zhèér.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_039",
      "speaker": "张雨桐",
      "zh": "这是桌子，对吧？",
      "pinyin": "Zhèshì zhuōzi, duì ba?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_040",
      "speaker": "刘梅",
      "zh": "嗯，对，这是桌子。",
      "pinyin": "En, duì, zhèshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_041",
      "speaker": "张乐乐",
      "zh": "你看到那桌子了吗？",
      "pinyin": "Nǐ kàndào nà zhuōzi le ma?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_042",
      "speaker": "小朋友",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_043",
      "speaker": "张雨桐",
      "zh": "他们学会一起玩。",
      "pinyin": "Tāmen xuéhuì yìqǐ wán.",
      "tr": "Birlikte oynamayı öğreniyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_044",
      "speaker": "刘梅",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_045",
      "speaker": "张乐乐",
      "zh": "真的谢谢你。",
      "pinyin": "Zhēnde xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_046",
      "speaker": "小朋友",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_048",
      "speaker": "刘梅",
      "zh": "那我们接着来。",
      "pinyin": "Nà wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
