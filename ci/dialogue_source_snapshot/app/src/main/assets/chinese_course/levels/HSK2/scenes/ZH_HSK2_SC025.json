{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC025",
  "level": "HSK2",
  "number": 25,
  "titleZh": "和李晨喝茶",
  "titleTr": "Li Chen ile Çay",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC025_001",
      "speaker": "张伟",
      "zh": "我们来新城已经一年了。",
      "pinyin": "Wǒmen lái xīnchéng yǐjīng yīnián le.",
      "tr": "Yeni şehre geleli bir yıl oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_002",
      "speaker": "李晨",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_003",
      "speaker": "刘梅",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_004",
      "speaker": "张伟",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_005",
      "speaker": "李晨",
      "zh": "以前我们还不太习惯这里。",
      "pinyin": "Yǐqián wǒmen hái bù tài xíguàn zhèlǐ.",
      "tr": "Eskiden buraya pek alışık değildik."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_006",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_008",
      "speaker": "李晨",
      "zh": "现在我们已经习惯多了。",
      "pinyin": "Xiànzài wǒmen yǐjīng xíguàn duō le.",
      "tr": "Şimdi buraya çok daha fazla alıştık."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_009",
      "speaker": "刘梅",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_010",
      "speaker": "张伟",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_011",
      "speaker": "李晨",
      "zh": "这个已经准备好了。",
      "pinyin": "Zhège yǐjīng zhǔnbèi hǎo le.",
      "tr": "Bu çoktan hazırlandı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_012",
      "speaker": "刘梅",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_014",
      "speaker": "李晨",
      "zh": "现在的生活越来越稳定了。",
      "pinyin": "Xiànzài de shēnghuó yuèláiyuè wěndìng le.",
      "tr": "Şimdiki hayat giderek daha düzenli oluyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_017",
      "speaker": "李晨",
      "zh": "以前我们一个朋友也没有。",
      "pinyin": "Yǐqián wǒmen yígè péngyǒu yě méiyǒu.",
      "tr": "Önceden hiç arkadaşımız yoktu."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC025_019",
      "speaker": "张伟",
      "zh": "先别慌，看看还有什么办法。",
      "pinyin": "Xiānbié huāng, kànkàn háiyǒu shénme bànfǎ.",
      "tr": "Panik yapmayalım, başka ne yapabiliriz bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_020",
      "speaker": "李晨",
      "zh": "先做容易的吧。",
      "pinyin": "Xiān zuò róngyì de ba.",
      "tr": "Önce kolay olanı yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_022",
      "speaker": "张伟",
      "zh": "这个城市在这里。",
      "pinyin": "Zhège chéngshì zài zhèlǐ.",
      "tr": "Bu şehir burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_023",
      "speaker": "李晨",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_024",
      "speaker": "刘梅",
      "zh": "那我先把它写下来。",
      "pinyin": "Nà wǒ xiān bǎ tā xiě xiàlái.",
      "tr": "O zaman bunu önce yazayım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_025",
      "speaker": "张伟",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_026",
      "speaker": "李晨",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_028",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_029",
      "speaker": "李晨",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_031",
      "speaker": "张伟",
      "zh": "这个家在这里。",
      "pinyin": "Zhège jiā zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_032",
      "speaker": "李晨",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_034",
      "speaker": "张伟",
      "zh": "快一点吧，不然时间不够。",
      "pinyin": "Kuài yìdiǎn ba, bùrán shíjiān bùgòu.",
      "tr": "Biraz hızlanalım, yoksa zaman yetmeyecek."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_035",
      "speaker": "李晨",
      "zh": "先把这个完成，再看下一个。",
      "pinyin": "Xiān bǎ zhège wánchéng, zài kàn xià yígè.",
      "tr": "Önce bunu tamamlayalım, sonra diğerine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_037",
      "speaker": "张伟",
      "zh": "我已经试了一次。",
      "pinyin": "Wǒ yǐjīng shì le yīcì.",
      "tr": "Bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_038",
      "speaker": "李晨",
      "zh": "不行的话就换一个办法。",
      "pinyin": "Bùxíng dehuà jiù huàn yígè bànfǎ.",
      "tr": "Olmazsa başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_041",
      "speaker": "李晨",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_044",
      "speaker": "李晨",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_047",
      "speaker": "李晨",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_048",
      "speaker": "刘梅",
      "zh": "好，总算解决了。",
      "pinyin": "Hǎo, zǒngsuàn jiějué le.",
      "tr": "Tamam, sonunda çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_049",
      "speaker": "张伟",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_050",
      "speaker": "李晨",
      "zh": "下次我们会准备得更好。",
      "pinyin": "Xiàcì wǒmen huì zhǔnbèi dé gènghǎo.",
      "tr": "Bir dahaki sefere daha iyi hazırlanırız."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_053",
      "speaker": "李晨",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_054",
