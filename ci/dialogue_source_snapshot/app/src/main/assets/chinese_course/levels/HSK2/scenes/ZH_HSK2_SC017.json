{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC017",
  "level": "HSK2",
  "number": 17,
  "titleZh": "买冬衣",
  "titleTr": "İlk Kışlık Alışveriş",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC017_001",
      "speaker": "刘梅",
      "zh": "天气冷了，该买冬衣了。",
      "pinyin": "Tiānqì lěng le, gāi mǎi dōngyī le.",
      "tr": "Hava soğudu, kışlık kıyafet alma zamanı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_002",
      "speaker": "张雨桐",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_003",
      "speaker": "张乐乐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_004",
      "speaker": "店员",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_005",
      "speaker": "刘梅",
      "zh": "这个冬衣在这里。",
      "pinyin": "Zhège dōngyī zài zhèlǐ.",
      "tr": "Bu kışlık kıyafet burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_006",
      "speaker": "张雨桐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbai le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_007",
      "speaker": "张乐乐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_008",
      "speaker": "店员",
      "zh": "这个尺码不太合适。",
      "pinyin": "Zhège chǐmǎ bú tài héshì.",
      "tr": "Bu beden pek uygun değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_009",
      "speaker": "刘梅",
      "zh": "这个我记住了。",
      "pinyin": "Zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_010",
      "speaker": "张雨桐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchu.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_011",
      "speaker": "张乐乐",
      "zh": "我们先试。",
      "pinyin": "Wǒmen xiān shì.",
      "tr": "Önce denemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_012",
      "speaker": "店员",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_014",
      "speaker": "张雨桐",
      "zh": "我想试大一点的。",
      "pinyin": "Wǒ xiǎng shì dà yìdiǎn de.",
      "tr": "Biraz daha büyüğünü denemek istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_016",
      "speaker": "店员",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_017",
      "speaker": "刘梅",
      "zh": "这个尺码太小。",
      "pinyin": "Zhège chǐmǎ tài xiǎo.",
      "tr": "Bu beden çok küçük."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_018",
      "speaker": "张雨桐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC017_019",
      "speaker": "张乐乐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān bié zháojí, wǒmen xiǎng ge bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_020",
      "speaker": "店员",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_022",
      "speaker": "张雨桐",
      "zh": "有没有小一点的？",
      "pinyin": "Yǒu méiyǒu xiǎo yìdiǎn de?",
      "tr": "Biraz daha küçüğü var mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC017_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_024",
      "speaker": "店员",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_025",
      "speaker": "刘梅",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_026",
      "speaker": "张雨桐",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshi.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_028",
      "speaker": "店员",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_030",
      "speaker": "张雨桐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_031",
      "speaker": "张乐乐",
      "zh": "这个冬天在这里。",
      "pinyin": "Zhège dōngtiān zài zhèlǐ.",
      "tr": "Bu kış burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_032",
      "speaker": "店员",
      "zh": "说得对。",
      "pinyin": "Shuō de duì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_035",
      "speaker": "张乐乐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_036",
      "speaker": "店员",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_038",
      "speaker": "张雨桐",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yí ge bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_040",
      "speaker": "店员",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosu wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_042",
      "speaker": "张雨桐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎo duō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chà yìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_044",
      "speaker": "店员",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yí cì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhè cì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_048",
      "speaker": "店员",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tài hǎo le, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_050",
      "speaker": "张雨桐",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_051",
      "speaker": "张乐乐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_052",
      "speaker": "店员",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_054",
      "speaker": "张雨桐",
      "zh": "这个冬衣在这里。",
      "pinyin": "Zhège dōngyī zài zhèlǐ.",
      "tr": "Bu kışlık kıyafet burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_055",
      "speaker": "张乐乐",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC017_056",
