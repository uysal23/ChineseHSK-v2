  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC021_001",
      "speaker": "张雨桐",
      "zh": "雨桐第一天去新高中。",
      "pinyin": "Yǔtóng dìyītiān qù xīn gāozhōng.",
      "tr": "Yutong’un yeni lisede ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_002",
      "speaker": "老师",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_003",
      "speaker": "工作人员",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_004",
      "speaker": "同学",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_005",
      "speaker": "张雨桐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_006",
      "speaker": "老师",
      "zh": "高中呢？",
      "pinyin": "Gāozhōng ne?",
      "tr": "Lise nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_007",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Lise şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_008",
      "speaker": "同学",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_009",
      "speaker": "张雨桐",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_010",
      "speaker": "老师",
      "zh": "请问，学校在哪儿？",
      "pinyin": "Qǐngwèn, xuéxiào zài nǎér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_011",
      "speaker": "工作人员",
      "zh": "嗯，就在那边。",
      "pinyin": "En, jiù zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_012",
      "speaker": "同学",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_013",
      "speaker": "张雨桐",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_014",
      "speaker": "老师",
      "zh": "请问，教室在哪儿？",
      "pinyin": "Qǐngwèn, jiàoshì zài nǎér?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_015",
      "speaker": "工作人员",
      "zh": "你看，教室在那边。",
      "pinyin": "Nǐ kàn, jiàoshì zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_016",
      "speaker": "同学",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_017",
      "speaker": "张雨桐",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_018",
      "speaker": "老师",
      "zh": "这是我们的学生。",
      "pinyin": "Zhèshì wǒmen de xuéshēng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_019",
      "speaker": "工作人员",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_020",
      "speaker": "同学",
      "zh": "认识你很高兴。",
      "pinyin": "Rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_021",
      "speaker": "张雨桐",
      "zh": "我也这么想。",
      "pinyin": "Wǒ yě zhème xiǎng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_022",
      "speaker": "老师",
      "zh": "她走到了错误的楼。",
      "pinyin": "Tā zǒu dào le cuòwù de lóu.",
      "tr": "Yanlış binaya gitti."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_025",
      "speaker": "张雨桐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_026",
      "speaker": "老师",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_027",
      "speaker": "工作人员",
      "zh": "这是我们的老师。",
      "pinyin": "Zhèshì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_028",
      "speaker": "同学",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_029",
      "speaker": "张雨桐",
      "zh": "嗯，认识你很高兴。",
      "pinyin": "En, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_030",
      "speaker": "老师",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_031",
      "speaker": "工作人员",
      "zh": "请问，路在哪儿？",
      "pinyin": "Qǐngwèn, lù zài nǎér?",
      "tr": "Yol nerede?"
