    {
      "id": "DLG_ZH_HSK1_SC042_006",
      "speaker": "张伟",
      "zh": "宠物店在哪儿？",
      "pinyin": "Chǒngwùdiàn zài nǎr?",
      "tr": "Pet mağazası nerede?"
