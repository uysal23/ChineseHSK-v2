{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC019",
  "level": "HSK2",
  "number": 19,
  "titleZh": "去看生病的同事",
  "titleTr": "Hasta İş Arkadaşını Ziyaret",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC019_001",
      "speaker": "张伟",
      "zh": "同事今天生病了。",
      "pinyin": "Tóngshì jīntiān shēngbìng le.",
      "tr": "İş arkadaşım bugün hasta."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_002",
      "speaker": "同事",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_003",
      "speaker": "刘梅",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_004",
      "speaker": "张伟",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_005",
      "speaker": "同事",
      "zh": "他今天生病了。",
      "pinyin": "Tā jīntiān shēngbìng le.",
      "tr": "O bugün hasta."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_006",
      "speaker": "刘梅",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_008",
      "speaker": "同事",
      "zh": "我们先休息。",
      "pinyin": "Wǒmen xiān xiūxī.",
      "tr": "Önce dinlenmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_009",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_010",
      "speaker": "张伟",
      "zh": "这样就清楚了。",
      "pinyin": "Zhèyàng jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_011",
      "speaker": "同事",
      "zh": "今天感觉好一点了吗？",
      "pinyin": "Jīntiān gǎnjué hǎo yìdiǎn le ma?",
      "tr": "Bugün biraz daha iyi hissediyor musun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC019_012",
      "speaker": "刘梅",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_014",
      "speaker": "同事",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_017",
      "speaker": "同事",
      "zh": "你要多休息，按时吃药。",
      "pinyin": "Nǐ yào duō xiūxī, ànshí chīyào.",
      "tr": "Çok dinlenip ilacını zamanında almalısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC019_019",
      "speaker": "张伟",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_020",
      "speaker": "同事",
      "zh": "我觉得先做最简单的比较好。",
      "pinyin": "Wǒ juéde xiān zuò zuì jiǎndān de bǐjiào hǎo.",
      "tr": "Bence önce en kolay olanı yapmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_022",
      "speaker": "张伟",
      "zh": "我们先看望。",
      "pinyin": "Wǒmen xiān kànwàng.",
      "tr": "Önce ziyaret etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_023",
      "speaker": "同事",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_024",
      "speaker": "刘梅",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_025",
      "speaker": "张伟",
      "zh": "这个工作在这里。",
      "pinyin": "Zhège gōngzuò zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_026",
      "speaker": "同事",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_028",
      "speaker": "张伟",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_029",
      "speaker": "同事",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_031",
      "speaker": "张伟",
      "zh": "我们先帮忙。",
      "pinyin": "Wǒmen xiān bāngmáng.",
      "tr": "Önce yardım etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_032",
      "speaker": "同事",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_034",
      "speaker": "张伟",
      "zh": "我们抓紧一点，时间不多了。",
      "pinyin": "Wǒmen zhuājǐn yìdiǎn, shíjiān bùduō le.",
      "tr": "Biraz hızlanalım, fazla zaman kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_035",
      "speaker": "同事",
      "zh": "这个做完以后再做下一个。",
      "pinyin": "Zhège zuò wán yǐhòu zài zuò xià yígè.",
      "tr": "Bunu bitirdikten sonra diğerini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_036",
      "speaker": "刘梅",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_037",
      "speaker": "张伟",
      "zh": "我已经试了一次。",
      "pinyin": "Wǒ yǐjīng shì le yīcì.",
      "tr": "Bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_038",
      "speaker": "同事",
      "zh": "这个不行，就换一个。",
      "pinyin": "Zhège bùxíng, jiù huàn yígè.",
      "tr": "Bu olmazsa başka birini deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_041",
      "speaker": "同事",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_044",
      "speaker": "同事",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_047",
      "speaker": "同事",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_048",
      "speaker": "刘梅",
      "zh": "太好了，这下没问题了。",
      "pinyin": "Tàihǎole, zhèxià méi wèntí le.",
      "tr": "Harika, artık sorun yok."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_049",
      "speaker": "张伟",
      "zh": "今天又知道了一个新办法。",
      "pinyin": "Jīntiān yòu zhīdào le yígè xīn bànfǎ.",
      "tr": "Bugün yeni bir yöntem daha öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_050",
      "speaker": "同事",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha tecrübeli oluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_053",
      "speaker": "同事",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_054",
      "speaker": "刘梅",
      "zh": "嗯，他今天生病了。",
      "pinyin": "En, tā jīntiān shēngbìng le.",
      "tr": "O bugün hasta."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_055",
      "speaker": "张伟",
      "zh": "好，我会记着。",
      "pinyin": "Hǎo, wǒhuì jìzhe.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_056",
