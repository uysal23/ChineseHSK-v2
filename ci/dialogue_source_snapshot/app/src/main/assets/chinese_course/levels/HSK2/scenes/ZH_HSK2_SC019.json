      "zh": "嗯，我们先休息。",
      "pinyin": "En, wǒmen xiān xiūxī.",
      "tr": "Önce dinlenmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_057",
      "speaker": "刘梅",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_058",
      "speaker": "张伟",
      "zh": "那今天感觉好一点了吗？",
      "pinyin": "Nà jīntiān gǎnjué hǎo yìdiǎn le ma?",
      "tr": "Bugün biraz daha iyi hissediyor musun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC019_059",
      "speaker": "同事",
      "zh": "以后也会用到。",
      "pinyin": "Yǐhòu yě huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_060",
      "speaker": "刘梅",
      "zh": "你看，这个药在这儿。",
      "pinyin": "Nǐ kàn, zhège yào zài zhèér.",
      "tr": "Bu ilaç burada."
    },
