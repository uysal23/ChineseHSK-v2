  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC009_001",
      "speaker": "张伟",
      "zh": "我们坐出租车去新家。",
      "pinyin": "Wǒmen zuò chūzūchē qù xīnjiā.",
      "tr": "Yeni eve taksiyle gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_003",
      "speaker": "李晨",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_004",
      "speaker": "司机",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_006",
      "speaker": "刘梅",
      "zh": "我们坐出租车吗？",
      "pinyin": "Wǒmen zuò chūzūchē ma?",
      "tr": "Taksi ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_007",
      "speaker": "李晨",
      "zh": "对，我们坐出租车。",
      "pinyin": "Duì, wǒmen zuò chūzūchē.",
      "tr": "Evet, taksi ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_008",
      "speaker": "司机",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_009",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_010",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dìzhǐ shì shénme?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_011",
      "speaker": "李晨",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_012",
      "speaker": "司机",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_014",
      "speaker": "刘梅",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_015",
      "speaker": "李晨",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_016",
      "speaker": "司机",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_017",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_018",
      "speaker": "刘梅",
      "zh": "你的号码是什么？",
      "pinyin": "Nǐ de hàomǎ shì shénme?",
      "tr": "Numara nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_019",
      "speaker": "李晨",
      "zh": "这是我的号码。",
      "pinyin": "Zhè shì wǒ de hàomǎ.",
      "tr": "Bu benim numara."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_020",
      "speaker": "司机",
      "zh": "嗯，我记下了。",
      "pinyin": "En, wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_021",
      "speaker": "张伟",
      "zh": "嗯，谢谢你。",
      "pinyin": "En, xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_022",
      "speaker": "刘梅",
      "zh": "司机听错了地址。",
      "pinyin": "Sījī tīngcuò le dìzhǐ.",
      "tr": "Şoför adresi yanlış duydu."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_024",
      "speaker": "司机",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_027",
      "speaker": "李晨",
      "zh": "城市在哪儿？",
      "pinyin": "Chéngshì zài nǎér?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_028",
      "speaker": "司机",
      "zh": "城市在那边。",
      "pinyin": "Chéngshì zài nàbiān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_029",
      "speaker": "张伟",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_030",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_031",
      "speaker": "李晨",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubiān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_032",
      "speaker": "司机",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubiān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_033",
      "speaker": "张伟",
      "zh": "从这边走。",
      "pinyin": "Cóng zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_034",
      "speaker": "刘梅",
      "zh": "对，谢谢你。",
      "pinyin": "Duì, xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_035",
      "speaker": "李晨",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbiān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_036",
      "speaker": "司机",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbiān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_037",
      "speaker": "张伟",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_038",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_039",
      "speaker": "李晨",
      "zh": "请问，家在哪儿？",
      "pinyin": "Qǐngwèn, jiā zài nǎér?",
