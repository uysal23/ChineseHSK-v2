      "id": "DLG_ZH_HSK1_SC022_018",
      "speaker": "张雨桐",
      "zh": "这是班吗？",
      "pinyin": "Zhè shì bān ma?",
      "tr": "Bu, sınıf / şube mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_019",
      "speaker": "同学",
      "zh": "对，这是班。",
      "pinyin": "Duì, zhè shì bān.",
      "tr": "Evet, bu sınıf / şube."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_020",
      "speaker": "同学",
      "zh": "班在哪儿？",
      "pinyin": "Bān zài nǎr?",
      "tr": "Sınıf / şube nerede?"
