    {
      "id": "DLG_ZH_HSK1_SC022_021",
      "speaker": "老师",
      "zh": "班在这里。",
      "pinyin": "Bān zài zhèlǐ.",
      "tr": "Sınıf / şube burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_022",
      "speaker": "张雨桐",
      "zh": "大家还不知道她是谁。",
      "pinyin": "Dàjiā hái bù zhīdào tā shì shéi.",
      "tr": "Kimse henüz onun kim olduğunu bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_023",
      "speaker": "同学",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
