      "id": "DLG_ZH_HSK1_SC022_028",
      "speaker": "同学",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzi.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_029",
      "speaker": "老师",
      "zh": "我记下了。",
