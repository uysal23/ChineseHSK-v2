  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC022_001",
      "speaker": "老师",
      "zh": "雨桐来到新班级。",
      "pinyin": "Yǔtóng láidào xīn bānjí.",
      "tr": "Yutong yeni sınıfına geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_003",
      "speaker": "同学",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_004",
      "speaker": "同学",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_005",
      "speaker": "老师",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_006",
      "speaker": "张雨桐",
      "zh": "教室在哪儿？",
      "pinyin": "Jiàoshì zài nǎr?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_007",
      "speaker": "同学",
      "zh": "教室在那边。",
      "pinyin": "Jiàoshì zài nàbian.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_008",
      "speaker": "同学",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbai le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_009",
      "speaker": "老师",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_010",
      "speaker": "张雨桐",
      "zh": "这是我们的学生。",
      "pinyin": "Zhè shì wǒmen de xuésheng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_011",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_012",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_013",
      "speaker": "老师",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_014",
      "speaker": "张雨桐",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_015",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_016",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
