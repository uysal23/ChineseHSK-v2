  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC020_001",
      "speaker": "张伟",
      "zh": "我们要拍全家福。",
      "pinyin": "Wǒmen yào pāi quánjiāfú.",
      "tr": "Aile fotoğrafı çekeceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_006",
      "speaker": "刘梅",
      "zh": "这个是照片吗？",
      "pinyin": "Zhège shì zhàopiān ma?",
      "tr": "Bu, fotoğraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_007",
      "speaker": "张雨桐",
      "zh": "对，这是照片。",
      "pinyin": "Duì, zhèshì zhàopiān.",
      "tr": "Evet, bu fotoğraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_008",
      "speaker": "张乐乐",
      "zh": "照片呢？",
      "pinyin": "Zhàopiān ne?",
      "tr": "Fotoğraf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_009",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Fotoğraf burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_011",
      "speaker": "张雨桐",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_013",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_014",
      "speaker": "刘梅",
      "zh": "这个是猫吗？",
      "pinyin": "Zhège shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_015",
      "speaker": "张雨桐",
      "zh": "对，这是猫。",
      "pinyin": "Duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_016",
      "speaker": "张乐乐",
      "zh": "猫呢？",
      "pinyin": "Māo ne?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_017",
      "speaker": "张伟",
      "zh": "嗯，就在这里。",
      "pinyin": "En, jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_018",
      "speaker": "刘梅",
      "zh": "这是椅子，对吗？",
      "pinyin": "Zhèshì yǐzi, duì ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_019",
      "speaker": "张雨桐",
      "zh": "对，这是椅子。",
      "pinyin": "Duì, zhèshì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_020",
      "speaker": "张乐乐",
      "zh": "请问，椅子在哪儿？",
      "pinyin": "Qǐngwèn, yǐzi zài nǎér?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_021",
      "speaker": "张伟",
      "zh": "你看，椅子在这儿。",
      "pinyin": "Nǐ kàn, yǐzi zài zhèér.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_022",
      "speaker": "刘梅",
      "zh": "咪咪一直换地方。",
      "pinyin": "Mīmī yìzhí huàn dìfāng.",
      "tr": "Mimi sürekli yer değiştiriyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_027",
      "speaker": "张雨桐",
      "zh": "这个是桌子吗？",
      "pinyin": "Zhège shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_028",
      "speaker": "张乐乐",
      "zh": "没错，这是桌子。",
      "pinyin": "Méicuò, zhèshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_029",
      "speaker": "张伟",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuōzi zài nǎér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_030",
      "speaker": "刘梅",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_031",
      "speaker": "张雨桐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_032",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_033",
      "speaker": "张伟",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_035",
      "speaker": "张雨桐",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhèshì wǒmen de māmā.",
      "tr": "Bu bizim anne."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_036",
      "speaker": "张乐乐",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
