    {
      "id": "DLG_ZH_HSK1_SC020_037",
      "speaker": "张伟",
      "zh": "嗯，很高兴认识你。",
      "pinyin": "En, hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_038",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_039",
      "speaker": "张雨桐",
      "zh": "这是我们的爸爸。",
      "pinyin": "Zhèshì wǒmen de bàbà.",
      "tr": "Bu bizim baba."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_040",
      "speaker": "张乐乐",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_041",
