      "id": "DLG_ZH_HSK1_SC044_049",
      "speaker": "张乐乐",
      "zh": "这是画吗？",
      "pinyin": "Zhè shì huà ma?",
      "tr": "Bu, resim mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_050",
      "speaker": "老师",
      "zh": "对，这是画。",
      "pinyin": "Duì, zhè shì huà.",
      "tr": "Evet, bu resim."
