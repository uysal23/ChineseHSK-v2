      "zh": "乐乐高兴地介绍了大家。",
      "pinyin": "Lèlè gāoxìng de jièshào le dàjiā.",
      "tr": "Lele herkesi sevinçle tanıtıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_044",
      "speaker": "同学",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_046",
      "speaker": "老师",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
