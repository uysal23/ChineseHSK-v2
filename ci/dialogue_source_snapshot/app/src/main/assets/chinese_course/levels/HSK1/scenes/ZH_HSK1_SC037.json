  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC037_001",
      "speaker": "张伟",
      "zh": "星期天一家人去公园。",
      "pinyin": "Xīngqītiān yījiārén qù gōngyuán.",
      "tr": "Pazar günü aile parka gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_003",
      "speaker": "张乐乐",
      "zh": "是。",
      "pinyin": "Shì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_006",
      "speaker": "刘梅",
      "zh": "公园在哪儿？",
      "pinyin": "Gōngyuán zài nǎér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_007",
      "speaker": "张乐乐",
      "zh": "公园在那边。",
      "pinyin": "Gōngyuán zài nàbiān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_008",
      "speaker": "张雨桐",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_009",
      "speaker": "张伟",
      "zh": "嗯，谢谢。",
      "pinyin": "En, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_010",
      "speaker": "刘梅",
      "zh": "这是天气，对吗？",
      "pinyin": "Zhèshì tiānqì, duì ma?",
      "tr": "Bu, hava mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_011",
      "speaker": "张乐乐",
      "zh": "对，这是天气。",
      "pinyin": "Duì, zhèshì tiānqì.",
      "tr": "Evet, bu hava."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_012",
      "speaker": "张雨桐",
      "zh": "天气呢？",
      "pinyin": "Tiānqì ne?",
      "tr": "Hava nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_013",
      "speaker": "张伟",
      "zh": "你看，天气在这儿。",
      "pinyin": "Nǐ kàn, tiānqì zài zhèér.",
      "tr": "Hava burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_014",
      "speaker": "刘梅",
      "zh": "这个是树吗？",
      "pinyin": "Zhège shì shù ma?",
      "tr": "Bu, ağaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_015",
      "speaker": "张乐乐",
      "zh": "嗯，这就是树。",
      "pinyin": "En, zhè jiùshì shù.",
      "tr": "Evet, bu ağaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_016",
      "speaker": "张雨桐",
      "zh": "树呢？",
      "pinyin": "Shù ne?",
      "tr": "Ağaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_017",
      "speaker": "张伟",
      "zh": "你看，树在这儿。",
      "pinyin": "Nǐ kàn, shù zài zhèér.",
      "tr": "Ağaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_018",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_019",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_020",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_021",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_022",
      "speaker": "刘梅",
      "zh": "乐乐想去很多地方。",
      "pinyin": "Lèlè xiǎng qù hěnduō dìfāng.",
      "tr": "Lele birçok yere gitmek istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_023",
      "speaker": "张乐乐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_027",
      "speaker": "张乐乐",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhèshì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_028",
      "speaker": "张雨桐",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_029",
      "speaker": "张伟",
      "zh": "太好了，认识你很高兴。",
      "pinyin": "Tàihǎole, rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_030",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_031",
      "speaker": "张乐乐",
      "zh": "这个是球吗？",
      "pinyin": "Zhège shì qiú ma?",
      "tr": "Bu, top mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_032",
      "speaker": "张雨桐",
      "zh": "没错，这是球。",
      "pinyin": "Méicuò, zhè shì qiú.",
      "tr": "Evet, bu top."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_033",
      "speaker": "张伟",
      "zh": "请问，球在哪儿？",
      "pinyin": "Qǐngwèn, qiú zài nǎér?",
      "tr": "Top nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_034",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Top burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_035",
      "speaker": "张乐乐",
      "zh": "我们坐自行车吗？",
      "pinyin": "Wǒmen zuò zìxíngchē ma?",
      "tr": "Bisiklet ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_036",
      "speaker": "张雨桐",
      "zh": "对，我们坐自行车。",
      "pinyin": "Duì, wǒmen zuò zìxíngchē.",
      "tr": "Evet, bisiklet ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_037",
      "speaker": "张伟",
      "zh": "那准备好了吗？",
      "pinyin": "Nà zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_038",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_039",
      "speaker": "张乐乐",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_040",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
