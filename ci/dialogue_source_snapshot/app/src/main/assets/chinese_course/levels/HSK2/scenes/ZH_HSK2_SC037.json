{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC037",
  "level": "HSK2",
  "number": 37,
  "titleZh": "乐乐的学校演出",
  "titleTr": "Okul Gösterisi",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC037_001",
      "speaker": "张乐乐",
      "zh": "乐乐今天参加学校演出。",
      "pinyin": "Lèlè jīntiān cānjiā xuéxiào yǎnchū.",
      "tr": "Lele bugün okul gösterisine katılıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_002",
      "speaker": "老师",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_003",
      "speaker": "刘梅",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_004",
      "speaker": "张伟",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_005",
      "speaker": "张乐乐",
      "zh": "学校的演出快开始了。",
      "pinyin": "Xuéxiào de yǎnchū kuài kāishǐ le.",
      "tr": "Okul gösterisi başlamak üzere."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_006",
      "speaker": "老师",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_008",
      "speaker": "张伟",
      "zh": "别紧张，慢慢说。",
      "pinyin": "Bié jǐnzhāng, mànmànshuō.",
      "tr": "Gerilme, yavaşça konuş."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_009",
      "speaker": "张乐乐",
      "zh": "嗯，这个我记住了。",
      "pinyin": "En, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_010",
      "speaker": "老师",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_011",
      "speaker": "刘梅",
      "zh": "请再说一次。",
      "pinyin": "Qǐng zàishuō yīcì.",
      "tr": "Lütfen bir kez daha söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_012",
      "speaker": "张伟",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_014",
      "speaker": "老师",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu sahne burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_017",
      "speaker": "张乐乐",
      "zh": "他一紧张就忘了台词。",
      "pinyin": "Tā yī jǐnzhāng jiù wàng le táicí.",
      "tr": "Gerilince repliğini unuttu."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_018",
      "speaker": "老师",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC037_019",
      "speaker": "刘梅",
      "zh": "先冷静一下，我们再想想怎么办。",
      "pinyin": "Xiān lěngjìng yīxià, wǒmen zài xiǎngxiǎng zěnmebàn.",
      "tr": "Önce sakinleşelim, sonra ne yapacağımızı düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_020",
      "speaker": "张伟",
      "zh": "从简单的开始会快一点。",
      "pinyin": "Cóng jiǎndān de kāishǐ huìkuài yìdiǎn.",
      "tr": "Kolay olandan başlamak biraz daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_021",
      "speaker": "张乐乐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_022",
      "speaker": "老师",
      "zh": "这个台词在这里。",
      "pinyin": "Zhège táicí zài zhèlǐ.",
      "tr": "Bu replik burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_024",
      "speaker": "张伟",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_025",
      "speaker": "张乐乐",
      "zh": "你看，这个校车在这儿。",
      "pinyin": "Nǐ kàn, zhège xiàochē zài zhèér.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_026",
      "speaker": "老师",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_028",
      "speaker": "张伟",
      "zh": "老师今天也来了。",
      "pinyin": "Lǎoshī jīntiān yě lái le.",
      "tr": "Öğretmen bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_029",
      "speaker": "张乐乐",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_030",
      "speaker": "老师",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_031",
      "speaker": "刘梅",
      "zh": "加油，你可以的！",
      "pinyin": "Jiāyóu, nǐ kěyǐ de!",
      "tr": "Haydi, yapabilirsin!"
    },
    {
      "id": "DLG_ZH_HSK2_SC037_032",
      "speaker": "张伟",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_033",
      "speaker": "张乐乐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_034",
      "speaker": "老师",
      "zh": "时间有点紧，我们动作快一点。",
      "pinyin": "Shíjiān yǒudiǎn jǐn, wǒmen dòngzuò kuài yìdiǎn.",
      "tr": "Zaman biraz sıkışık, biraz hızlı hareket edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_035",
      "speaker": "刘梅",
      "zh": "这个做完以后再做下一个。",
      "pinyin": "Zhège zuò wán yǐhòu zài zuò xià yígè.",
      "tr": "Bunu bitirdikten sonra diğerini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_036",
      "speaker": "张伟",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_037",
      "speaker": "张乐乐",
      "zh": "我试过了，知道是什么情况。",
      "pinyin": "Wǒshì guò le, zhīdào shì shénme qíngkuàng.",
      "tr": "Denedim, durumun ne olduğunu biliyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_038",
      "speaker": "老师",
      "zh": "那我们换个方法看看。",
      "pinyin": "Nà wǒmen huàngè fāngfǎ kànkàn.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_041",
      "speaker": "张乐乐",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_042",
      "speaker": "老师",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_045",
      "speaker": "张乐乐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_046",
      "speaker": "老师",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_048",
      "speaker": "张伟",
      "zh": "好，总算解决了。",
      "pinyin": "Hǎo, zǒngsuàn jiějué le.",
      "tr": "Tamam, sonunda çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_049",
      "speaker": "张乐乐",
      "zh": "以后遇到这种情况就知道怎么办了。",
      "pinyin": "Yǐhòu yùdào zhèzhǒng qíngkuàng jiù zhīdào zěnmebàn le.",
      "tr": "Bundan sonra böyle bir durumda ne yapacağımızı biliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_050",
      "speaker": "老师",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_053",
      "speaker": "张乐乐",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_054",
      "speaker": "老师",
      "zh": "再一次这一步弄清楚以后，后面就容易多了。",
      "pinyin": "Zài yīcì zhè yībù nòngqīngchǔ yǐhòu, hòumiàn jiù róngyì duō le.",
      "tr": "bir kez daha kısmı netleşince sonrası çok daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_055",
      "speaker": "刘梅",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_056",
      "speaker": "张伟",
      "zh": "嗯，别紧张，慢慢说。",
      "pinyin": "En, bié jǐnzhāng, mànmànshuō.",
      "tr": "Gerilme, yavaşça konuş."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_057",
      "speaker": "张乐乐",
      "zh": "这个办法很实用。",
      "pinyin": "Zhège bànfǎ hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_058",
      "speaker": "老师",
      "zh": "嗯，请再说一次。",
      "pinyin": "En, qǐng zàishuō yīcì.",
      "tr": "Lütfen bir kez daha söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_059",
      "speaker": "刘梅",
      "zh": "以后还用得上。",
      "pinyin": "Yǐhòu hái yòngdéshàng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_060",
      "speaker": "张伟",
      "zh": "这个舞台在这里。",
      "pinyin": "Zhège wǔtái zài zhèlǐ.",
      "tr": "Bu sahne burada."
    },
    {
