  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC034_001",
      "speaker": "张伟",
      "zh": "张伟下班要坐公交车回家。",
      "pinyin": "Zhāngwěi xiàbān yào zuò gōngjiāochē huíjiā.",
      "tr": "Zhang Wei işten sonra otobüsle eve dönecek."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_002",
      "speaker": "乘客",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_003",
      "speaker": "工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_004",
      "speaker": "刘梅",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_006",
      "speaker": "乘客",
      "zh": "我们坐公交车吗？",
      "pinyin": "Wǒmen zuò gōngjiāochē ma?",
      "tr": "Otobüs ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_007",
      "speaker": "工作人员",
      "zh": "对，我们坐公交车。",
      "pinyin": "Duì, wǒmen zuò gōngjiāochē.",
      "tr": "Evet, otobüs ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_008",
      "speaker": "刘梅",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_009",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_010",
      "speaker": "乘客",
      "zh": "这是时间，对吗？",
      "pinyin": "Zhèshì shíjiān, duì ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_011",
      "speaker": "工作人员",
      "zh": "对，这是时间。",
      "pinyin": "Duì, zhèshì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_012",
      "speaker": "刘梅",
      "zh": "时间在哪儿？",
      "pinyin": "Shíjiān zài nǎér?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_013",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_014",
      "speaker": "乘客",
      "zh": "请问，路在哪儿？",
      "pinyin": "Qǐngwèn, lù zài nǎér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_015",
      "speaker": "工作人员",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_016",
      "speaker": "刘梅",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_017",
      "speaker": "张伟",
      "zh": "太好了，谢谢。",
      "pinyin": "Tàihǎole, xièxiè.",
      "tr": "Teşekkür ederim."
    },
