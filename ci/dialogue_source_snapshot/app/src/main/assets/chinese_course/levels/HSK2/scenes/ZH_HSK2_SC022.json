{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC022",
  "level": "HSK2",
  "number": 22,
  "titleZh": "雨桐的比赛",
  "titleTr": "Yutong’un Spor Maçı",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC022_001",
      "speaker": "张雨桐",
      "zh": "雨桐的比赛快开始了。",
      "pinyin": "Yǔtóng de bǐsài kuài kāishǐ le.",
      "tr": "Yutong’un maçı başlamak üzere."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_002",
      "speaker": "张伟",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_004",
      "speaker": "队友",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_005",
      "speaker": "张雨桐",
      "zh": "比赛马上开始了。",
      "pinyin": "Bǐsài mǎshàng kāishǐ le.",
      "tr": "Maç birazdan başlayacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_006",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbai le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_008",
      "speaker": "队友",
      "zh": "我们今天赢了比赛。",
      "pinyin": "Wǒmen jīntiān yíng le bǐsài.",
      "tr": "Bugünkü maçı kazandık."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_009",
      "speaker": "张雨桐",
      "zh": "这个我记住了。",
      "pinyin": "Zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchu.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_011",
      "speaker": "刘梅",
      "zh": "输了也没关系。",
      "pinyin": "Shū le yě méi guānxi.",
      "tr": "Kaybetsek de sorun değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_012",
      "speaker": "队友",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_014",
      "speaker": "张伟",
      "zh": "加油，你可以的！",
      "pinyin": "Jiāyóu, nǐ kěyǐ de!",
      "tr": "Haydi, yapabilirsin!"
    },
    {
      "id": "DLG_ZH_HSK2_SC022_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_016",
      "speaker": "队友",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_017",
      "speaker": "张雨桐",
      "zh": "我们差一点来晚了。",
      "pinyin": "Wǒmen chà yìdiǎn lái wǎn le.",
      "tr": "Neredeyse geç kalıyorduk."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC022_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān bié zháojí, wǒmen xiǎng ge bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_020",
      "speaker": "队友",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_021",
      "speaker": "张雨桐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_022",
      "speaker": "张伟",
      "zh": "这个队在这里。",
      "pinyin": "Zhège duì zài zhèlǐ.",
      "tr": "Bu takım burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_024",
      "speaker": "队友",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_025",
      "speaker": "张雨桐",
      "zh": "我最近常常运动。",
      "pinyin": "Wǒ zuìjìn chángcháng yùndòng.",
      "tr": "Son zamanlarda sık sık spor yapıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshi.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_028",
      "speaker": "队友",
      "zh": "快一点，不然来不及了。",
      "pinyin": "Kuài yìdiǎn, bùrán láibují le.",
      "tr": "Biraz hızlı ol, yoksa yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_029",
      "speaker": "张雨桐",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_031",
      "speaker": "刘梅",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyou jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_032",
      "speaker": "队友",
      "zh": "说得对。",
      "pinyin": "Shuō de duì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_033",
      "speaker": "张雨桐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_036",
      "speaker": "队友",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_038",
      "speaker": "张伟",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yí ge bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_040",
      "speaker": "队友",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosu wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_041",
      "speaker": "张雨桐",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎo duō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chà yìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_044",
      "speaker": "队友",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_045",
      "speaker": "张雨桐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yí cì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhè cì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_048",
      "speaker": "队友",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tài hǎo le, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_050",
      "speaker": "张伟",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_052",
      "speaker": "队友",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_053",
      "speaker": "张雨桐",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_054",
      "speaker": "张伟",
      "zh": "比赛马上开始了。",
      "pinyin": "Bǐsài mǎshàng kāishǐ le.",
      "tr": "Maç birazdan başlayacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_055",
      "speaker": "刘梅",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_056",
      "speaker": "队友",
      "zh": "我们今天赢了比赛。",
      "pinyin": "Wǒmen jīntiān yíng le bǐsài.",
      "tr": "Bugünkü maçı kazandık."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_057",
      "speaker": "张雨桐",
      "zh": "这个很实用。",
      "pinyin": "Zhège hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_058",
      "speaker": "张伟",
      "zh": "输了也没关系。",
      "pinyin": "Shū le yě méi guānxi.",
      "tr": "Kaybetsek de sorun değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC022_059",
      "speaker": "刘梅",
      "zh": "以后还会用到。",
      "pinyin": "Yǐhòu hái huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
