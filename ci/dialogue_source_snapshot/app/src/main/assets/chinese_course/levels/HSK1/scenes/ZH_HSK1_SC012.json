    {
      "id": "DLG_ZH_HSK1_SC012_001",
      "speaker": "刘梅",
      "zh": "这是我们在新家的第一个晚上。",
      "pinyin": "Zhè shì wǒmen zài xīn jiā de dì yí ge wǎnshang.",
      "tr": "Bu yeni evdeki ilk akşamımız."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_003",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_006",
      "speaker": "张伟",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_007",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_008",
      "speaker": "张雨桐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbai le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
