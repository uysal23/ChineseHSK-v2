{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK1_SC034",
  "level": "HSK1",
  "sourceTitleZh": "错过公交车",
  "sourceTitleTr": "Otobüsü Kaçırmak",
  "sourceMiniAdventureTr": "Zhang eve dönüş otobüsünü kaçırır ve sonraki otobüsün saatini sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC034_001",
      "speaker": "张伟",
      "zh": "张伟下班要坐公交车回家。",
      "pinyin": "Zhāngwěi xiàbān yào zuò gōngjiāochē huíjiā.",
      "tr": "Zhang Wei işten sonra otobüsle eve dönecek."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_002",
      "speaker": "乘客",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_003",
      "speaker": "工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_004",
      "speaker": "刘梅",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_006",
      "speaker": "乘客",
      "zh": "我们坐公交车吗？",
      "pinyin": "Wǒmen zuò gōngjiāochē ma?",
      "tr": "Otobüs ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_007",
      "speaker": "工作人员",
      "zh": "对，我们坐公交车。",
      "pinyin": "Duì, wǒmen zuò gōngjiāochē.",
      "tr": "Evet, otobüs ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_008",
      "speaker": "刘梅",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_010",
      "speaker": "乘客",
      "zh": "这是时间吗？",
      "pinyin": "Zhèshì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_011",
      "speaker": "工作人员",
      "zh": "没错，是时间。",
      "pinyin": "Méicuò, shì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_012",
      "speaker": "刘梅",
      "zh": "时间在哪儿？",
      "pinyin": "Shíjiān zài nǎér?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_013",
      "speaker": "张伟",
      "zh": "你看，时间在这儿。",
      "pinyin": "Nǐ kàn, shíjiān zài zhèér.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_014",
      "speaker": "乘客",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_015",
      "speaker": "工作人员",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_016",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_018",
      "speaker": "乘客",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_019",
      "speaker": "工作人员",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_020",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_022",
      "speaker": "乘客",
      "zh": "他错过了这班车。",
      "pinyin": "Tā cuòguò le zhè bānchē.",
      "tr": "Bu otobüsü kaçırdı."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_024",
      "speaker": "刘梅",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_026",
      "speaker": "乘客",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_027",
      "speaker": "工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_028",
      "speaker": "刘梅",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_029",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_030",
      "speaker": "乘客",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_031",
      "speaker": "工作人员",
      "zh": "那车站在哪儿？",
      "pinyin": "Nà chēzhàn zài nǎér?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_032",
      "speaker": "刘梅",
      "zh": "车站在那边。",
      "pinyin": "Chēzhàn zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_033",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_034",
      "speaker": "乘客",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_035",
      "speaker": "工作人员",
      "zh": "这个是电话吗？",
      "pinyin": "Zhège shì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_036",
      "speaker": "刘梅",
      "zh": "没错，是电话。",
      "pinyin": "Méicuò, shì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_037",
      "speaker": "张伟",
      "zh": "电话呢？",
      "pinyin": "Diànhuà ne?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_038",
      "speaker": "乘客",
      "zh": "电话在这儿。",
      "pinyin": "Diànhuà zài zhèér.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_039",
      "speaker": "工作人员",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_040",
      "speaker": "刘梅",
      "zh": "嗯，对，这是钱。",
      "pinyin": "En, duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_041",
      "speaker": "张伟",
      "zh": "钱呢？",
      "pinyin": "Qián ne?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_042",
      "speaker": "乘客",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_043",
      "speaker": "工作人员",
      "zh": "他问到了下一班车的时间。",
      "pinyin": "Tā wèndào le xià yī bānchē de shíjiān.",
      "tr": "Sonraki otobüsün saatini öğrendi."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_044",
      "speaker": "刘梅",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_046",
      "speaker": "乘客",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_047",
      "speaker": "工作人员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_048",
      "speaker": "刘梅",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
