      "id": "DLG_ZH_HSK1_SC018_039",
      "speaker": "收银员",
      "zh": "你要面包吗？",
      "pinyin": "Nǐ yào miànbāo ma?",
      "tr": "Ekmek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_040",
      "speaker": "张乐乐",
      "zh": "我要面包，谢谢。",
      "pinyin": "Wǒyào miànbāo, xièxiè.",
      "tr": "Ekmek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_041",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
