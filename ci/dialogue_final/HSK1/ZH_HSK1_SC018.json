  "level": "HSK1",
  "sourceTitleZh": "钱够不够？",
  "sourceTitleTr": "Kasada Para Yetiyor mu?",
  "sourceMiniAdventureTr": "Kasada ödeme sırasında Zhang bozuk para ve toplam tutarı kontrol eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC018_001",
      "speaker": "张伟",
      "zh": "我们在超市付款。",
      "pinyin": "Wǒmen zài chāoshì fùkuǎn.",
      "tr": "Süpermarkette ödeme yapıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_003",
      "speaker": "收银员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_006",
      "speaker": "刘梅",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_007",
      "speaker": "收银员",
      "zh": "没错，是钱。",
      "pinyin": "Méicuò, shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_008",
      "speaker": "张乐乐",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_009",
      "speaker": "张伟",
      "zh": "你看，钱在这儿。",
      "pinyin": "Nǐ kàn, qián zài zhèér.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_010",
      "speaker": "刘梅",
      "zh": "这是元，对吗？",
      "pinyin": "Zhè shì yuán, duì ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_011",
      "speaker": "收银员",
      "zh": "没错，是元。",
      "pinyin": "Méicuò, shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_012",
      "speaker": "张乐乐",
      "zh": "元在哪儿？",
      "pinyin": "Yuán zài nǎér?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_013",
      "speaker": "张伟",
      "zh": "你看，元在这儿。",
      "pinyin": "Nǐ kàn, yuán zài zhèér.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_014",
      "speaker": "刘梅",
      "zh": "超市在哪儿？",
      "pinyin": "Chāoshì zài nǎér?",
      "tr": "Süpermarket nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_015",
      "speaker": "收银员",
      "zh": "你看，超市在那边。",
      "pinyin": "Nǐ kàn, chāoshì zài nàbiān.",
      "tr": "Süpermarket şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_016",
      "speaker": "张乐乐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_018",
      "speaker": "刘梅",
      "zh": "现在付款吗？",
      "pinyin": "Xiànzài fùkuǎn ma?",
      "tr": "Şimdi ödeme yapıyor muyuz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_019",
      "speaker": "收银员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_020",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_021",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_022",
      "speaker": "刘梅",
      "zh": "张伟在找零钱。",
      "pinyin": "Zhāngwěi zài zhǎo língqián.",
      "tr": "Zhang Wei bozuk para arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_023",
      "speaker": "收银员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_027",
      "speaker": "收银员",
      "zh": "这是包，对吗？",
      "pinyin": "Zhè shì bāo, duì ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_028",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是包。",
      "pinyin": "En, duì, zhè shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_029",
      "speaker": "张伟",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_030",
      "speaker": "刘梅",
      "zh": "包在这儿。",
      "pinyin": "Bāo zài zhèér.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_031",
      "speaker": "收银员",
      "zh": "你要苹果吗？",
      "pinyin": "Nǐ yào píngguǒ ma?",
      "tr": "Elma ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_032",
      "speaker": "张乐乐",
      "zh": "我要苹果，谢谢。",
      "pinyin": "Wǒyào píngguǒ, xièxiè.",
      "tr": "Elma istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_033",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_035",
      "speaker": "收银员",
      "zh": "你要牛奶吗？",
      "pinyin": "Nǐ yào niúnǎi ma?",
      "tr": "Süt ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_036",
      "speaker": "张乐乐",
      "zh": "我要牛奶，谢谢。",
      "pinyin": "Wǒyào niúnǎi, xièxiè.",
