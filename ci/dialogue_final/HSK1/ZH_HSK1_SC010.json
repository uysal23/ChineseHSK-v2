{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK1_SC010",
  "level": "HSK1",
  "sourceTitleZh": "新家的门",
  "sourceTitleTr": "Yeni Evin Kapısı",
  "sourceMiniAdventureTr": "Anahtar ilk denemede kapıyı açmaz; doğru anahtarı bulurlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC010_001",
      "speaker": "张伟",
      "zh": "我们到了新家。",
      "pinyin": "Wǒmen dào le xīnjiā.",
      "tr": "Yeni eve geldik."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_003",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_006",
      "speaker": "刘梅",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_007",
      "speaker": "张乐乐",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiùshì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_008",
      "speaker": "张雨桐",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_009",
      "speaker": "张伟",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_010",
      "speaker": "刘梅",
      "zh": "这是钥匙吗？",
      "pinyin": "Zhèshì yàoshi ma?",
      "tr": "Bu, anahtar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_011",
      "speaker": "张乐乐",
      "zh": "对，就是钥匙。",
      "pinyin": "Duì, jiùshì yàoshi.",
      "tr": "Evet, bu anahtar."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_012",
      "speaker": "张雨桐",
      "zh": "钥匙在哪儿？",
      "pinyin": "Yàoshi zài nǎér?",
      "tr": "Anahtar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_013",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Anahtar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_014",
      "speaker": "刘梅",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_015",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_016",
      "speaker": "张雨桐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_018",
      "speaker": "刘梅",
      "zh": "房间呢？",
      "pinyin": "Fángjiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_019",
      "speaker": "张乐乐",
      "zh": "你看，房间在那边。",
      "pinyin": "Nǐ kàn, fángjiān zài nàbiān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_020",
      "speaker": "张雨桐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_022",
      "speaker": "刘梅",
      "zh": "这个钥匙打不开门。",
      "pinyin": "Zhège yàoshi dǎ bù kāimén.",
      "tr": "Bu anahtar kapıyı açmıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_023",
      "speaker": "张乐乐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_027",
      "speaker": "张乐乐",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubiān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_028",
      "speaker": "张雨桐",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubiān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_029",
      "speaker": "张伟",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_031",
      "speaker": "张乐乐",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbiān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_032",
      "speaker": "张雨桐",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbiān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_033",
      "speaker": "张伟",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_035",
      "speaker": "张乐乐",
      "zh": "这个是箱子吗？",
      "pinyin": "Zhège shì xiāngzi ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_036",
      "speaker": "张雨桐",
      "zh": "对，就是箱子。",
      "pinyin": "Duì, jiùshì xiāngzi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_037",
      "speaker": "张伟",
      "zh": "那箱子在哪儿？",
      "pinyin": "Nà xiāngzi zài nǎér?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_038",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_039",
      "speaker": "张乐乐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_040",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_042",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_043",
      "speaker": "张乐乐",
      "zh": "对的钥匙找到了。",
      "pinyin": "Duì de yàoshi zhǎodào le.",
      "tr": "Doğru anahtarı bulduk."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_044",
      "speaker": "张雨桐",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_047",
      "speaker": "张乐乐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_048",
      "speaker": "张雨桐",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_049",
      "speaker": "张伟",
      "zh": "这是门，对吗？",
      "pinyin": "Zhè shì mén, duì ma?",
      "tr": "Bu, kapı mı?"
