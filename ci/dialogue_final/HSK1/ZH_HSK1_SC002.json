{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK1_SC002",
  "level": "HSK1",
  "sourceTitleZh": "火车票在哪儿？",
  "sourceTitleTr": "Tren Biletleri Nerede?",
  "sourceMiniAdventureTr": "Aile evden çıkmaya hazırlanırken Lele kendi tren biletini bulamaz.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC002_001",
      "speaker": "张伟",
      "zh": "我们要去坐火车。",
      "pinyin": "Wǒmen yào qù zuòhuǒchē.",
      "tr": "Trene binmeye gideceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_006",
      "speaker": "刘梅",
      "zh": "这个是火车票吗？",
      "pinyin": "Zhège shì huǒchēpiào ma?",
      "tr": "Bu, tren bileti mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_007",
      "speaker": "张雨桐",
      "zh": "对，就是火车票。",
      "pinyin": "Duì, jiùshì huǒchēpiào.",
      "tr": "Evet, bu tren bileti."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_008",
      "speaker": "张乐乐",
      "zh": "那火车票在哪儿？",
      "pinyin": "Nà huǒchēpiào zài nǎér?",
      "tr": "Tren bileti nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_009",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Tren bileti burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_010",
      "speaker": "刘梅",
      "zh": "这个是包吗？",
      "pinyin": "Zhège shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_011",
      "speaker": "张雨桐",
      "zh": "对，就是包。",
      "pinyin": "Duì, jiùshì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_012",
      "speaker": "张乐乐",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_013",
      "speaker": "张伟",
      "zh": "你看，包在这儿。",
      "pinyin": "Nǐ kàn, bāo zài zhèér.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_014",
      "speaker": "刘梅",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuòhuǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_015",
      "speaker": "张雨桐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuòhuǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_016",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_017",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_018",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_019",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_020",
      "speaker": "张乐乐",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_021",
      "speaker": "张伟",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_022",
      "speaker": "刘梅",
      "zh": "乐乐的火车票不见了。",
      "pinyin": "Lèlè de huǒchēpiào bújiàn le.",
      "tr": "Lele’nin tren bileti ortada yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_027",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_028",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_030",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_031",
      "speaker": "张雨桐",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_032",
      "speaker": "张乐乐",
      "zh": "没错，是门。",
      "pinyin": "Méicuò, shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_033",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_034",
      "speaker": "刘梅",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_035",
      "speaker": "张雨桐",
      "zh": "这个是时间吗？",
      "pinyin": "Zhège shì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_036",
      "speaker": "张乐乐",
      "zh": "对，就是时间。",
      "pinyin": "Duì, jiùshì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_037",
      "speaker": "张伟",
      "zh": "时间呢？",
      "pinyin": "Shíjiān ne?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_038",
      "speaker": "刘梅",
      "zh": "你看，时间在这儿。",
      "pinyin": "Nǐ kàn, shíjiān zài zhèér.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_039",
      "speaker": "张雨桐",
      "zh": "这是猫，对吗？",
      "pinyin": "Zhè shì māo, duì ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_040",
      "speaker": "张乐乐",
      "zh": "对，就是猫。",
      "pinyin": "Duì, jiùshì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_041",
      "speaker": "张伟",
      "zh": "那猫在哪儿？",
      "pinyin": "Nàmāo zài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_043",
      "speaker": "张雨桐",
      "zh": "找到了，在包里。",
      "pinyin": "Zhǎodào le, zài bāolǐ.",
      "tr": "Bulduk, çantanın içindeymiş."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_048",
      "speaker": "张乐乐",
      "zh": "我们继续。",
      "pinyin": "Wǒmen jìxù.",
      "tr": "Devam edelim."
