{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC005",
  "level": "HSK2",
  "sourceTitleZh": "雨桐选社团",
  "sourceTitleTr": "Yutong’un Kulüp Seçimi",
  "sourceMiniAdventureTr": "Yutong spor ve müzik kulübü arasında karar veremez.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC005_001",
      "speaker": "张雨桐",
      "zh": "雨桐想参加一个社团。",
      "pinyin": "Yǔtóng xiǎng cānjiā yígè shètuán.",
      "tr": "Yutong bir kulübe katılmak istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_002",
      "speaker": "同学",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_003",
      "speaker": "老师",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_005",
      "speaker": "同学",
      "zh": "我们来谈谈社团。",
      "pinyin": "Wǒmen lái tántán shètuán.",
      "tr": "Kulüp hakkında konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_006",
      "speaker": "老师",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_008",
      "speaker": "同学",
      "zh": "我最近常常运动。",
      "pinyin": "Wǒ zuìjìn chángcháng yùndòng.",
      "tr": "Son zamanlarda sık sık spor yapıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_009",
      "speaker": "老师",
      "zh": "好，运动这点我记住了。",
      "pinyin": "Hǎo, yùndòng zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, spor konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_010",
      "speaker": "张雨桐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_011",
      "speaker": "同学",
      "zh": "雨桐很喜欢音乐。",
      "pinyin": "Yǔtóng hěn xǐhuān yīnyuè.",
      "tr": "Yutong müziği çok seviyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_012",
      "speaker": "老师",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_014",
      "speaker": "同学",
      "zh": "因为时间不多，我们得快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, wǒmen dé kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olmalıyız."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_015",
      "speaker": "老师",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_017",
      "speaker": "同学",
      "zh": "运动和音乐，她都喜欢。",
      "pinyin": "Yùndòng hé yīnyuè, tā dōu xǐhuān.",
      "tr": "Hem sporu hem müziği seviyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_018",
      "speaker": "老师",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC005_019",
      "speaker": "张雨桐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_020",
      "speaker": "同学",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_021",
      "speaker": "老师",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_022",
      "speaker": "张雨桐",
      "zh": "所以我们先解决这个问题。",
      "pinyin": "Suǒyǐ wǒmen xiān jiějué zhège wèntí.",
      "tr": "Bu yüzden önce bu sorunu çözelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_023",
      "speaker": "同学",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_024",
      "speaker": "老师",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_025",
      "speaker": "张雨桐",
      "zh": "我们先选择一下吧。",
      "pinyin": "Wǒmen xiān xuǎnzé yīxià ba.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_026",
      "speaker": "同学",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_027",
      "speaker": "老师",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_028",
      "speaker": "张雨桐",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_029",
      "speaker": "同学",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_030",
      "speaker": "老师",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_031",
      "speaker": "张雨桐",
      "zh": "你看，这个校车在这儿。",
      "pinyin": "Nǐ kàn, zhège xiàochē zài zhèér.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_032",
      "speaker": "同学",
      "zh": "对，选择这点你说得对。",
      "pinyin": "Duì, xuǎnzé zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, seçmek konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_033",
      "speaker": "老师",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_035",
      "speaker": "同学",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_036",
      "speaker": "老师",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_038",
      "speaker": "同学",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_039",
      "speaker": "老师",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_041",
      "speaker": "同学",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_042",
      "speaker": "老师",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_044",
      "speaker": "同学",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_045",
      "speaker": "老师",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_047",
      "speaker": "同学",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_048",
      "speaker": "老师",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_050",
      "speaker": "同学",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_051",
      "speaker": "老师",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_053",
      "speaker": "同学",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_054",
      "speaker": "老师",
      "zh": "我们来谈谈社团。",
      "pinyin": "Wǒmen lái tántán shètuán.",
      "tr": "Kulüp hakkında konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_055",
      "speaker": "张雨桐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_056",
      "speaker": "同学",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_057",
      "speaker": "老师",
      "zh": "嗯，运动这点确实很实用。",
      "pinyin": "En, yùndòng zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, spor gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_058",
      "speaker": "张雨桐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_059",
      "speaker": "同学",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_060",
      "speaker": "老师",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_061",
      "speaker": "张雨桐",
      "zh": "我觉得运动也很重要。",
      "pinyin": "Wǒ juéde yùndòng yě hěn zhòngyào.",
      "tr": "Bence spor de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_062",
      "speaker": "同学",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_063",
      "speaker": "老师",
      "zh": "嗯，所以这部分现在清楚多了。",
      "pinyin": "En, suǒyǐ zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, bu yüzden kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_064",
      "speaker": "张雨桐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_065",
      "speaker": "同学",
      "zh": "那音乐呢？",
      "pinyin": "Nà yīnyuè ne?",
      "tr": "Peki müzik?"
    },
    {
      "id": "DLG_ZH_HSK2_SC005_066",
      "speaker": "老师",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_067",
      "speaker": "张雨桐",
      "zh": "嗯，选择这点确实很实用。",
      "pinyin": "En, xuǎnzé zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, seçmek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_068",
      "speaker": "同学",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_069",
      "speaker": "老师",
      "zh": "我觉得因为也很重要。",
      "pinyin": "Wǒ juéde yīnwèi yě hěn zhòngyào.",
      "tr": "Bence çünkü de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_070",
      "speaker": "张雨桐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_071",
      "speaker": "同学",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_072",
      "speaker": "老师",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC005_073",
      "speaker": "张雨桐",
      "zh": "嗯，运动这部分现在清楚多了。",
      "pinyin": "En, yùndòng zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, spor kısmı şimdi çok daha net."
    },
