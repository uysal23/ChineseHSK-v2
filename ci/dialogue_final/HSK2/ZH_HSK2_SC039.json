{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC039",
  "level": "HSK2",
  "sourceTitleZh": "咪咪要减肥",
  "sourceTitleTr": "Mimi Veteriner Kontrolünde",
  "sourceMiniAdventureTr": "Veteriner Mimi’nin kilo aldığını söyler ve beslenme önerir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC039_001",
      "speaker": "刘梅",
      "zh": "兽医说咪咪有点胖。",
      "pinyin": "Shòuyī shuō mīmī yǒudiǎn pàng.",
      "tr": "Veteriner Mimi’nin biraz kilolu olduğunu söyledi."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_002",
      "speaker": "张乐乐",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_003",
      "speaker": "兽医",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_005",
      "speaker": "刘梅",
      "zh": "咪咪最近有点胖。",
      "pinyin": "Mīmī zuìjìn yǒudiǎn pàng.",
      "tr": "Mimi son zamanlarda biraz kilolu."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_006",
      "speaker": "张乐乐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_007",
      "speaker": "兽医",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_008",
      "speaker": "张伟",
      "zh": "以后要少一点。",
      "pinyin": "Yǐhòu yàoshǎo yìdiǎn.",
      "tr": "Bundan sonra biraz daha az olmalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_009",
      "speaker": "刘梅",
      "zh": "好，少一点这点我记住了。",
      "pinyin": "Hǎo, shǎo yìdiǎn zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, biraz daha az konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_010",
      "speaker": "张乐乐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_011",
      "speaker": "兽医",
      "zh": "我们先运动一下吧。",
      "pinyin": "Wǒmen xiān yùndòng yīxià ba.",
      "tr": "Önce egzersiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_012",
      "speaker": "张伟",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_014",
      "speaker": "张乐乐",
      "zh": "咪咪的体重有点高。",
      "pinyin": "Mīmī de tǐzhòng yǒudiǎn gāo.",
      "tr": "Mimi’nin kilosu biraz yüksek."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_015",
      "speaker": "兽医",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_017",
      "speaker": "刘梅",
      "zh": "以后要少吃一点，多运动。",
      "pinyin": "Yǐhòu yàoshǎo chī yìdiǎn, duō yùndòng.",
      "tr": "Bundan sonra biraz daha az yiyip daha çok hareket etmeli."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_018",
      "speaker": "张乐乐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC039_019",
      "speaker": "兽医",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_020",
      "speaker": "张伟",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_022",
      "speaker": "张乐乐",
      "zh": "兽医今天也来了。",
      "pinyin": "Shòuyī jīntiān yě lái le.",
      "tr": "Veteriner bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_023",
      "speaker": "兽医",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_024",
      "speaker": "张伟",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_025",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu kedi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_026",
      "speaker": "张乐乐",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_027",
      "speaker": "兽医",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_028",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_030",
      "speaker": "张乐乐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_031",
      "speaker": "兽医",
      "zh": "我们先走路一下吧。",
      "pinyin": "Wǒmen xiān zǒulù yīxià ba.",
      "tr": "Önce yürümek."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_032",
      "speaker": "张伟",
      "zh": "对，猫这点你说得对。",
      "pinyin": "Duì, māo zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, kedi konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_034",
      "speaker": "张乐乐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_035",
      "speaker": "兽医",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_036",
      "speaker": "张伟",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_038",
      "speaker": "张乐乐",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_039",
      "speaker": "兽医",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_042",
      "speaker": "张乐乐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_043",
      "speaker": "兽医",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_046",
      "speaker": "张乐乐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_047",
      "speaker": "兽医",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_048",
      "speaker": "张伟",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_050",
      "speaker": "张乐乐",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_051",
      "speaker": "兽医",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_054",
      "speaker": "张乐乐",
      "zh": "咪咪最近有点胖。",
      "pinyin": "Mīmī zuìjìn yǒudiǎn pàng.",
      "tr": "Mimi son zamanlarda biraz kilolu."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_055",
      "speaker": "兽医",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_056",
      "speaker": "张伟",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_057",
      "speaker": "刘梅",
      "zh": "嗯，少一点这点确实很实用。",
      "pinyin": "En, shǎo yìdiǎn zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, biraz daha az gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_058",
      "speaker": "张乐乐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_059",
      "speaker": "兽医",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_060",
      "speaker": "张伟",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_061",
      "speaker": "刘梅",
      "zh": "我觉得先少一点一下比较好。",
      "pinyin": "Wǒ juéde xiānshǎo yìdiǎn yīxià bǐjiào hǎo.",
      "tr": "Bence önce “biraz daha az” kısmını ele almak daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_062",
      "speaker": "张乐乐",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_063",
      "speaker": "兽医",
      "zh": "嗯，兽医这部分现在清楚多了。",
      "pinyin": "En, shòuyī zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, veteriner kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_065",
      "speaker": "刘梅",
      "zh": "那要不要先运动一下？",
      "pinyin": "Nàyào búyào xiān yùndòng yīxià?",
      "tr": "O zaman önce “egzersiz” kısmını ele alalım mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC039_066",
      "speaker": "张乐乐",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_067",
      "speaker": "兽医",
      "zh": "嗯，猫这点确实很实用。",
      "pinyin": "En, māo zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, kedi gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_068",
      "speaker": "张伟",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_069",
      "speaker": "刘梅",
      "zh": "我觉得体重也很重要。",
      "pinyin": "Wǒ juéde tǐzhòng yě hěn zhòngyào.",
      "tr": "Bence kilo de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_070",
      "speaker": "张乐乐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_071",
      "speaker": "兽医",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_072",
      "speaker": "张伟",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC039_073",
      "speaker": "刘梅",
      "zh": "嗯，少一点这部分现在清楚多了。",
