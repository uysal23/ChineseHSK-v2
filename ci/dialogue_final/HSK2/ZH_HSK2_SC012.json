{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC012",
  "level": "HSK2",
  "sourceTitleZh": "雨桐的朋友来家里",
  "sourceTitleTr": "Yutong’un Arkadaşı Eve Geliyor",
  "sourceMiniAdventureTr": "Yutong’un arkadaşı ilk kez eve gelir ve aileyle tanışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC012_001",
      "speaker": "张雨桐",
      "zh": "雨桐的朋友第一次来家里。",
      "pinyin": "Yǔtóng de péngyǒu dìyīcì lái jiālǐ.",
      "tr": "Yutong’un arkadaşı ilk kez eve geliyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_002",
      "speaker": "同学",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_005",
      "speaker": "张雨桐",
      "zh": "客人今天也来了。",
      "pinyin": "Kèrén jīntiān yě lái le.",
      "tr": "Misafir bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_006",
      "speaker": "同学",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_008",
      "speaker": "张伟",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_009",
      "speaker": "张雨桐",
      "zh": "好，朋友这点我记住了。",
      "pinyin": "Hǎo, péngyǒu zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, arkadaş konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_010",
      "speaker": "同学",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_011",
      "speaker": "刘梅",
      "zh": "你看，这个坐在这儿。",
      "pinyin": "Nǐ kàn, zhège zuòzài zhèér.",
      "tr": "Bu oturmak burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_012",
      "speaker": "张伟",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_014",
      "speaker": "同学",
      "zh": "欢迎来我们家。",
      "pinyin": "Huānyíng lái wǒmen jiā.",
      "tr": "Evimize hoş geldin."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_017",
      "speaker": "张雨桐",
      "zh": "她有一点紧张。",
      "pinyin": "Tā yǒu yìdiǎn jǐnzhāng.",
      "tr": "Biraz gergin."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_018",
      "speaker": "同学",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC012_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_020",
      "speaker": "张伟",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_021",
      "speaker": "张雨桐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_022",
      "speaker": "同学",
      "zh": "别客气，随便坐。",
      "pinyin": "Bié kèqì, suíbiàn zuò.",
      "tr": "Çekinme, rahatça otur."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_024",
      "speaker": "张伟",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_025",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_026",
      "speaker": "同学",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_028",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_029",
      "speaker": "张雨桐",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_030",
      "speaker": "同学",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_031",
      "speaker": "刘梅",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_032",
      "speaker": "张伟",
      "zh": "对，食物这点你说得对。",
      "pinyin": "Duì, shíwù zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, yiyecek konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_033",
      "speaker": "张雨桐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_034",
      "speaker": "同学",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_036",
      "speaker": "张伟",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_038",
      "speaker": "同学",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_041",
      "speaker": "张雨桐",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_042",
      "speaker": "同学",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_045",
      "speaker": "张雨桐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_046",
      "speaker": "同学",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_048",
      "speaker": "张伟",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_050",
      "speaker": "同学",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_051",
      "speaker": "刘梅",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "En, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_053",
      "speaker": "张雨桐",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_054",
      "speaker": "同学",
      "zh": "客人今天也来了。",
      "pinyin": "Kèrén jīntiān yě lái le.",
      "tr": "Misafir bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_055",
      "speaker": "刘梅",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_056",
      "speaker": "张伟",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_057",
      "speaker": "张雨桐",
      "zh": "嗯，朋友这点确实很实用。",
      "pinyin": "En, péngyǒu zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, arkadaş gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_058",
      "speaker": "同学",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_059",
      "speaker": "刘梅",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_060",
      "speaker": "张伟",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_061",
      "speaker": "张雨桐",
      "zh": "我觉得朋友也很重要。",
      "pinyin": "Wǒ juéde péngyǒu yě hěn zhòngyào.",
      "tr": "Bence arkadaş de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_062",
      "speaker": "同学",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_063",
      "speaker": "刘梅",
      "zh": "嗯，别客气这部分现在清楚多了。",
      "pinyin": "En, bié kèqì zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, çekinme / rica ederim kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_065",
      "speaker": "张雨桐",
      "zh": "那坐呢？",
      "pinyin": "Nà zuò ne?",
      "tr": "Peki oturmak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC012_066",
      "speaker": "同学",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_067",
      "speaker": "刘梅",
      "zh": "嗯，食物这点确实很实用。",
      "pinyin": "En, shíwù zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, yiyecek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_068",
      "speaker": "张伟",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_069",
      "speaker": "张雨桐",
      "zh": "我觉得欢迎也很重要。",
      "pinyin": "Wǒ juéde huānyíng yě hěn zhòngyào.",
      "tr": "Bence hoş geldin de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_070",
      "speaker": "同学",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_071",
      "speaker": "刘梅",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_072",
      "speaker": "张伟",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_073",
      "speaker": "张雨桐",
      "zh": "嗯，朋友这部分现在清楚多了。",
      "pinyin": "En, péngyǒu zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, arkadaş kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC012_074",
      "speaker": "同学",
      "zh": "我觉得这个选择可以。",
      "pinyin": "Wǒ juéde zhège xuǎnzé kěyǐ.",
