{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC003",
  "level": "HSK2",
  "sourceTitleZh": "刘梅逛菜市场",
  "sourceTitleTr": "Liu Mei Mahalle Pazarında",
  "sourceMiniAdventureTr": "Liu Mei sebze ve meyve alırken miktar ve fiyat konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC003_001",
      "speaker": "刘梅",
      "zh": "今天的菜很新鲜。",
      "pinyin": "Jīntiān de cài hěn xīnxiān.",
      "tr": "Bugünkü sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_002",
      "speaker": "摊主",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_003",
      "speaker": "邻居",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_004",
      "speaker": "刘梅",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_005",
      "speaker": "摊主",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_006",
      "speaker": "邻居",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_008",
      "speaker": "摊主",
      "zh": "你看，这个水果在这儿。",
      "pinyin": "Nǐ kàn, zhège shuǐguǒ zài zhèér.",
      "tr": "Bu meyve burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_009",
      "speaker": "邻居",
      "zh": "好，水果这点我记住了。",
      "pinyin": "Hǎo, shuǐguǒ zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, meyve konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_011",
      "speaker": "摊主",
      "zh": "这个我要两斤。",
      "pinyin": "Zhège wǒyào liǎngjīn.",
      "tr": "Bundan bir kilo istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_012",
      "speaker": "邻居",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_014",
      "speaker": "摊主",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_015",
      "speaker": "邻居",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_017",
      "speaker": "摊主",
      "zh": "这个价格有点贵。",
      "pinyin": "Zhège jiàgé yǒudiǎn guì.",
      "tr": "Bu fiyat biraz pahalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_018",
      "speaker": "邻居",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC003_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_020",
      "speaker": "摊主",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_021",
      "speaker": "邻居",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_022",
      "speaker": "刘梅",
      "zh": "这些菜特别新鲜。",
      "pinyin": "Zhèxiē cài tèbié xīnxiān.",
      "tr": "Bu sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_023",
      "speaker": "摊主",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_024",
      "speaker": "邻居",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_025",
      "speaker": "刘梅",
      "zh": "我们先买一下吧。",
      "pinyin": "Wǒmen xiānmǎi yīxià ba.",
      "tr": "Önce satın almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_026",
      "speaker": "摊主",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_027",
      "speaker": "邻居",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_028",
      "speaker": "刘梅",
      "zh": "你看，这个蔬菜在这儿。",
      "pinyin": "Nǐ kàn, zhège shūcài zài zhèér.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_029",
      "speaker": "摊主",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_030",
      "speaker": "邻居",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_031",
      "speaker": "刘梅",
      "zh": "你看，这个包在这儿。",
      "pinyin": "Nǐ kàn, zhège bāo zài zhèér.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_032",
      "speaker": "摊主",
      "zh": "对，蔬菜这点你说得对。",
      "pinyin": "Duì, shūcài zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, sebze konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_033",
      "speaker": "邻居",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_035",
      "speaker": "摊主",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_036",
      "speaker": "邻居",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_038",
      "speaker": "摊主",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_039",
      "speaker": "邻居",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_041",
      "speaker": "摊主",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_042",
      "speaker": "邻居",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_044",
      "speaker": "摊主",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_045",
      "speaker": "邻居",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_047",
      "speaker": "摊主",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_048",
      "speaker": "邻居",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_050",
      "speaker": "摊主",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_051",
      "speaker": "邻居",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_053",
      "speaker": "摊主",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_054",
      "speaker": "邻居",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_055",
      "speaker": "刘梅",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_056",
      "speaker": "摊主",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_057",
      "speaker": "邻居",
      "zh": "嗯，水果这点确实很实用。",
      "pinyin": "En, shuǐguǒ zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, meyve gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_059",
      "speaker": "摊主",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_060",
      "speaker": "邻居",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_061",
      "speaker": "刘梅",
      "zh": "我觉得水果也很重要。",
      "pinyin": "Wǒ juéde shuǐguǒ yě hěn zhòngyào.",
      "tr": "Bence meyve de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_062",
      "speaker": "摊主",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_063",
      "speaker": "邻居",
      "zh": "嗯，新鲜这部分现在清楚多了。",
      "pinyin": "En, xīnxiān zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, taze kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_064",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_065",
      "speaker": "摊主",
      "zh": "那斤呢？",
      "pinyin": "Nàjīn ne?",
      "tr": "Peki yarım kilo ölçüsü?"
    },
    {
      "id": "DLG_ZH_HSK2_SC003_066",
      "speaker": "邻居",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_067",
      "speaker": "刘梅",
      "zh": "嗯，蔬菜这点确实很实用。",
      "pinyin": "En, shūcài zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, sebze gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_068",
      "speaker": "摊主",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_069",
      "speaker": "邻居",
      "zh": "我觉得价格也很重要。",
      "pinyin": "Wǒ juéde jiàgé yě hěn zhòngyào.",
      "tr": "Bence fiyat de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_071",
      "speaker": "摊主",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_072",
      "speaker": "邻居",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_073",
      "speaker": "刘梅",
      "zh": "嗯，水果这部分现在清楚多了。",
      "pinyin": "En, shuǐguǒ zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, meyve kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_074",
      "speaker": "摊主",
      "zh": "我觉得这个选择可以。",
      "pinyin": "Wǒ juéde zhège xuǎnzé kěyǐ.",
