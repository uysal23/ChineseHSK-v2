{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC042",
  "level": "HSK2",
  "sourceTitleZh": "和爷爷奶奶视频",
  "sourceTitleTr": "Büyük Aile Görüntülü Araması",
  "sourceMiniAdventureTr": "Zhang’ın anne-babası görüntülü aramayla yeni evi görür.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC042_001",
      "speaker": "张伟",
      "zh": "爷爷奶奶想看看新家。",
      "pinyin": "Yéyénǎinǎi xiǎng kànkàn xīn jiā.",
      "tr": "Büyükanne ve büyükbaba yeni evi görmek istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_003",
      "speaker": "爷爷",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_004",
      "speaker": "奶奶",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_005",
      "speaker": "张伟",
      "zh": "我们晚上视频吧。",
      "pinyin": "Wǒmen wǎnshàng shìpín ba.",
      "tr": "Akşam görüntülü konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_006",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_007",
      "speaker": "爷爷",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_008",
      "speaker": "奶奶",
      "zh": "你们看得见吗？",
      "pinyin": "Nǐmen kàndéjiàn ma?",
      "tr": "Görebiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_009",
      "speaker": "张伟",
      "zh": "好，看得见这点我记住了。",
      "pinyin": "Hǎo, kàndéjiàn zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, görebilmek konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_011",
      "speaker": "爷爷",
      "zh": "你们听得见吗？",
      "pinyin": "Nǐmen tīngdejiàn ma?",
      "tr": "Duyabiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_012",
      "speaker": "奶奶",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_014",
      "speaker": "刘梅",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéyénǎinǎi jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_015",
      "speaker": "爷爷",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_016",
      "speaker": "奶奶",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_017",
      "speaker": "张伟",
      "zh": "你们看得见吗？听得见吗？",
      "pinyin": "Nǐmen kàndéjiàn ma? tīngdejiàn ma?",
      "tr": "Bizi görebiliyor ve duyabiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_019",
      "speaker": "爷爷",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_020",
      "speaker": "奶奶",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_022",
      "speaker": "刘梅",
      "zh": "这个屏幕在这儿。",
      "pinyin": "Zhège píngmù zài zhèér.",
      "tr": "Bu ekran burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_023",
      "speaker": "爷爷",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_024",
      "speaker": "奶奶",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_025",
      "speaker": "张伟",
      "zh": "这个家在这儿。",
      "pinyin": "Zhège jiā zài zhèér.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_027",
      "speaker": "爷爷",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_028",
      "speaker": "奶奶",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_031",
      "speaker": "爷爷",
      "zh": "我们先打电话一下吧。",
      "pinyin": "Wǒmen xiān dǎdiànhuà yīxià ba.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_032",
      "speaker": "奶奶",
      "zh": "对，家这点你说得对。",
      "pinyin": "Duì, jiā zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, ev konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_035",
      "speaker": "爷爷",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_036",
      "speaker": "奶奶",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_039",
      "speaker": "爷爷",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_040",
      "speaker": "奶奶",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_043",
      "speaker": "爷爷",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_044",
      "speaker": "奶奶",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_047",
      "speaker": "爷爷",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_048",
      "speaker": "奶奶",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_051",
      "speaker": "爷爷",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_052",
      "speaker": "奶奶",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_054",
      "speaker": "刘梅",
      "zh": "我们晚上视频吧。",
      "pinyin": "Wǒmen wǎnshàng shìpín ba.",
      "tr": "Akşam görüntülü konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_055",
      "speaker": "爷爷",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_056",
      "speaker": "奶奶",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_057",
      "speaker": "张伟",
      "zh": "嗯，看得见这点确实很实用。",
      "pinyin": "En, kàndéjiàn zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, görebilmek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_059",
      "speaker": "爷爷",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_060",
      "speaker": "奶奶",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_061",
      "speaker": "张伟",
      "zh": "我觉得看得见也很重要。",
      "pinyin": "Wǒ juéde kàndéjiàn yě hěn zhòngyào.",
      "tr": "Bence görebilmek de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_063",
      "speaker": "爷爷",
      "zh": "嗯，屏幕这部分现在清楚多了。",
      "pinyin": "En, píngmù zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, ekran kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_064",
      "speaker": "奶奶",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_065",
      "speaker": "张伟",
      "zh": "那听得见呢？",
      "pinyin": "Nà tīngdejiàn ne?",
      "tr": "Peki duyabilmek?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_066",
      "speaker": "刘梅",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_067",
      "speaker": "爷爷",
      "zh": "嗯，家这点确实很实用。",
      "pinyin": "En, jiā zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, ev gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_068",
      "speaker": "奶奶",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_069",
      "speaker": "张伟",
      "zh": "我觉得爷爷奶奶也很重要。",
      "pinyin": "Wǒ juéde yéyénǎinǎi yě hěn zhòngyào.",
      "tr": "Bence büyükanne ve büyükbaba de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_071",
      "speaker": "爷爷",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_072",
      "speaker": "奶奶",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_073",
      "speaker": "张伟",
      "zh": "嗯，看得见这部分现在清楚多了。",
      "pinyin": "En, kàndéjiàn zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, görebilmek kısmı şimdi çok daha net."
    },
