{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC036",
  "level": "HSK2",
  "sourceTitleZh": "张伟带新同事",
  "sourceTitleTr": "Zhang Yeni Sorumluluk Alıyor",
  "sourceMiniAdventureTr": "Zhang yeni bir çalışana işi öğretir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC036_001",
      "speaker": "张伟",
      "zh": "今天我来带新同事。",
      "pinyin": "Jīntiān wǒlái dài xīn tóngshì.",
      "tr": "Bugün yeni iş arkadaşına ben rehberlik edeceğim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_002",
      "speaker": "新同事",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_003",
      "speaker": "经理",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_005",
      "speaker": "新同事",
      "zh": "新同事今天也来了。",
      "pinyin": "Xīn tóngshì jīntiān yě lái le.",
      "tr": "Yeni iş arkadaşı bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_006",
      "speaker": "经理",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_008",
      "speaker": "新同事",
      "zh": "这个地方要特别注意。",
      "pinyin": "Zhège dìfāng yào tèbié zhùyì.",
      "tr": "Bu noktaya özellikle dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_009",
      "speaker": "经理",
      "zh": "好，注意这点我记住了。",
      "pinyin": "Hǎo, zhùyì zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, dikkat etmek konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_011",
      "speaker": "新同事",
      "zh": "记得把东西带上。",
      "pinyin": "Jìde bǎ dōngxī dàishàng.",
      "tr": "Eşyaları yanına almayı unutma."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_012",
      "speaker": "经理",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_014",
      "speaker": "新同事",
      "zh": "第一步先检查这里。",
      "pinyin": "Dìyībù xiān jiǎnchá zhèlǐ.",
      "tr": "İlk adımda önce burayı kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_015",
      "speaker": "经理",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_017",
      "speaker": "新同事",
      "zh": "第一步要特别注意安全。",
      "pinyin": "Dìyībù yào tèbié zhùyìānquán.",
      "tr": "İlk adımda güvenliğe özellikle dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_018",
      "speaker": "经理",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC036_019",
      "speaker": "张伟",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_020",
      "speaker": "新同事",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_021",
      "speaker": "经理",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_022",
      "speaker": "张伟",
      "zh": "我们先教一下吧。",
      "pinyin": "Wǒmen xiānjiào yīxià ba.",
      "tr": "Önce öğretmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_023",
      "speaker": "新同事",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_024",
      "speaker": "经理",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_025",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_026",
      "speaker": "新同事",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_027",
      "speaker": "经理",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_028",
      "speaker": "张伟",
      "zh": "我们一步一步来。",
      "pinyin": "Wǒmen yībù yībù lái.",
      "tr": "Adım adım ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_029",
      "speaker": "新同事",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_030",
      "speaker": "经理",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_031",
      "speaker": "张伟",
      "zh": "我们先检查一下吧。",
      "pinyin": "Wǒmen xiān jiǎncháyīxià ba.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_032",
      "speaker": "新同事",
      "zh": "对，注意这点你说得对。",
      "pinyin": "Duì, zhùyì zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, dikkat etmek konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_033",
      "speaker": "经理",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_035",
      "speaker": "新同事",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_036",
      "speaker": "经理",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_038",
      "speaker": "新同事",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_039",
      "speaker": "经理",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_041",
      "speaker": "新同事",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_042",
      "speaker": "经理",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_044",
      "speaker": "新同事",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_045",
      "speaker": "经理",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_047",
      "speaker": "新同事",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_048",
      "speaker": "经理",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_050",
      "speaker": "新同事",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_051",
      "speaker": "经理",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_053",
      "speaker": "新同事",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_054",
      "speaker": "经理",
      "zh": "新同事今天也来了。",
      "pinyin": "Xīn tóngshì jīntiān yě lái le.",
      "tr": "Yeni iş arkadaşı bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_055",
      "speaker": "张伟",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_056",
      "speaker": "新同事",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_057",
      "speaker": "经理",
      "zh": "嗯，注意这点确实很实用。",
      "pinyin": "En, zhùyì zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, dikkat etmek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_058",
      "speaker": "张伟",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_059",
      "speaker": "新同事",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_060",
      "speaker": "经理",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_061",
      "speaker": "张伟",
      "zh": "我觉得注意也很重要。",
      "pinyin": "Wǒ juéde zhùyì yě hěn zhòngyào.",
      "tr": "Bence dikkat etmek de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_062",
      "speaker": "新同事",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_063",
      "speaker": "经理",
      "zh": "嗯，教这部分现在清楚多了。",
      "pinyin": "En, jiào zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, öğretmek kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_065",
      "speaker": "新同事",
      "zh": "那记得呢？",
      "pinyin": "Nà jìde ne?",
      "tr": "Peki hatırlamak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC036_066",
      "speaker": "经理",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_067",
      "speaker": "张伟",
      "zh": "嗯，工作这点确实很实用。",
      "pinyin": "En, gōngzuò zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, iş gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_068",
      "speaker": "新同事",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_069",
      "speaker": "经理",
      "zh": "我觉得第一步也很重要。",
      "pinyin": "Wǒ juéde dìyībù yě hěn zhòngyào.",
      "tr": "Bence ilk adım de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_070",
      "speaker": "张伟",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_071",
      "speaker": "新同事",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_072",
      "speaker": "经理",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_073",
      "speaker": "张伟",
      "zh": "嗯，注意这部分现在清楚多了。",
      "pinyin": "En, zhùyì zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, dikkat etmek kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC036_074",
      "speaker": "新同事",
      "zh": "我觉得这个选择可以。",
      "pinyin": "Wǒ juéde zhège xuǎnzé kěyǐ.",
      "tr": "Bence bu seçenek uygun."
    },
