  "sceneId": "ZH_HSK2_SC029",
  "level": "HSK2",
  "sourceTitleZh": "张伟发错了文件",
  "sourceTitleTr": "Zhang’ın Küçük Hatası",
  "sourceMiniAdventureTr": "Zhang işte yanlış dosyayı gönderir ve özür dileyip düzeltir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC029_001",
      "speaker": "张伟",
      "zh": "我刚才发错文件了。",
      "pinyin": "Wǒ gāngcái fācuò wénjiàn le.",
      "tr": "Az önce yanlış dosyayı gönderdim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_002",
      "speaker": "同事",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_003",
      "speaker": "经理",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_005",
      "speaker": "同事",
      "zh": "我刚才发错文件了。",
      "pinyin": "Wǒ gāngcái fācuò wénjiàn le.",
      "tr": "Az önce yanlış dosyayı gönderdim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_006",
      "speaker": "经理",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_008",
      "speaker": "同事",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu dosya burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_009",
      "speaker": "经理",
      "zh": "好，文件这点我记住了。",
      "pinyin": "Hǎo, wénjiàn zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, dosya konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_011",
      "speaker": "同事",
      "zh": "对不起，是我弄错了。",
      "pinyin": "Duìbùqǐ, shì wǒ nòngcuò le.",
      "tr": "Özür dilerim, ben yanlış yaptım."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_012",
      "speaker": "经理",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_014",
      "speaker": "同事",
      "zh": "我们先修改一下吧。",
      "pinyin": "Wǒmen xiān xiūgǎi yīxià ba.",
      "tr": "Önce düzeltmek / değiştirmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_015",
      "speaker": "经理",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_017",
      "speaker": "同事",
      "zh": "对不起，我马上修改。",
      "pinyin": "Duìbùqǐ, wǒ mǎshàng xiūgǎi.",
      "tr": "Özür dilerim, hemen düzelteceğim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_018",
      "speaker": "经理",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC029_019",
      "speaker": "张伟",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_020",
      "speaker": "同事",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_021",
      "speaker": "经理",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_022",
      "speaker": "张伟",
      "zh": "我马上改。",
      "pinyin": "Wǒ mǎshàng gǎi.",
      "tr": "Hemen düzelteceğim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_023",
      "speaker": "同事",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_024",
      "speaker": "经理",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_025",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_026",
      "speaker": "同事",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_027",
      "speaker": "经理",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_028",
      "speaker": "张伟",
      "zh": "经理今天也来了。",
      "pinyin": "Jīnglǐ jīntiān yě lái le.",
      "tr": "Müdür bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_029",
      "speaker": "同事",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_030",
      "speaker": "经理",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_031",
      "speaker": "张伟",
      "zh": "我们先检查一下吧。",
      "pinyin": "Wǒmen xiān jiǎncháyīxià ba.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_032",
      "speaker": "同事",
      "zh": "对，工作这点你说得对。",
      "pinyin": "Duì, gōngzuò zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, iş konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_033",
      "speaker": "经理",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_035",
      "speaker": "同事",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_036",
      "speaker": "经理",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_038",
      "speaker": "同事",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_039",
      "speaker": "经理",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_041",
      "speaker": "同事",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_042",
      "speaker": "经理",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_044",
      "speaker": "同事",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_045",
      "speaker": "经理",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_047",
      "speaker": "同事",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_048",
      "speaker": "经理",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_050",
      "speaker": "同事",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_051",
      "speaker": "经理",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_053",
      "speaker": "同事",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC029_054",
