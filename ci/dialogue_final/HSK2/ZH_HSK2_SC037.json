{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC037",
  "level": "HSK2",
  "sourceTitleZh": "乐乐的学校演出",
  "sourceTitleTr": "Okul Gösterisi",
  "sourceMiniAdventureTr": "Lele sahnede sözünü unutur ama öğretmenin yardımıyla devam eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC037_001",
      "speaker": "张乐乐",
      "zh": "乐乐今天参加学校演出。",
      "pinyin": "Lèlè jīntiān cānjiā xuéxiào yǎnchū.",
      "tr": "Lele bugün okul gösterisine katılıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_002",
      "speaker": "老师",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_005",
      "speaker": "张乐乐",
      "zh": "学校的演出快开始了。",
      "pinyin": "Xuéxiào de yǎnchū kuài kāishǐ le.",
      "tr": "Okul gösterisi başlamak üzere."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_006",
      "speaker": "老师",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_008",
      "speaker": "张伟",
      "zh": "别紧张，慢慢说。",
      "pinyin": "Bié jǐnzhāng, mànmànshuō.",
      "tr": "Gerilme, yavaşça konuş."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_009",
      "speaker": "张乐乐",
      "zh": "好，紧张这点我记住了。",
      "pinyin": "Hǎo, jǐnzhāng zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, gergin konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_010",
      "speaker": "老师",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_011",
      "speaker": "刘梅",
      "zh": "请再说一次。",
      "pinyin": "Qǐng zàishuō yīcì.",
      "tr": "Lütfen bir kez daha söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_012",
      "speaker": "张伟",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_014",
      "speaker": "老师",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu sahne burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_017",
      "speaker": "张乐乐",
      "zh": "他一紧张就忘了台词。",
      "pinyin": "Tā yī jǐnzhāng jiù wàng le táicí.",
      "tr": "Gerilince repliğini unuttu."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_018",
      "speaker": "老师",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC037_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_020",
      "speaker": "张伟",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_021",
      "speaker": "张乐乐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_022",
      "speaker": "老师",
      "zh": "这个台词在这儿。",
      "pinyin": "Zhège táicí zài zhèér.",
      "tr": "Bu replik burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_024",
      "speaker": "张伟",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_025",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_026",
      "speaker": "老师",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_028",
      "speaker": "张伟",
      "zh": "老师今天也来了。",
      "pinyin": "Lǎoshī jīntiān yě lái le.",
      "tr": "Öğretmen bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_029",
      "speaker": "张乐乐",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_030",
      "speaker": "老师",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_031",
      "speaker": "刘梅",
      "zh": "加油，你可以的！",
      "pinyin": "Jiāyóu, nǐ kěyǐ de!",
      "tr": "Haydi, yapabilirsin!"
    },
    {
      "id": "DLG_ZH_HSK2_SC037_032",
      "speaker": "张伟",
      "zh": "对，校车这点你说得对。",
      "pinyin": "Duì, xiàochē zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, okul servisi konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_033",
      "speaker": "张乐乐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_034",
      "speaker": "老师",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_036",
      "speaker": "张伟",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_037",
      "speaker": "张乐乐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_038",
      "speaker": "老师",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_041",
      "speaker": "张乐乐",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_042",
      "speaker": "老师",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_045",
      "speaker": "张乐乐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_046",
      "speaker": "老师",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_048",
      "speaker": "张伟",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_049",
      "speaker": "张乐乐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_050",
      "speaker": "老师",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_051",
      "speaker": "刘梅",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_053",
      "speaker": "张乐乐",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_054",
      "speaker": "老师",
      "zh": "学校的演出快开始了。",
      "pinyin": "Xuéxiào de yǎnchū kuài kāishǐ le.",
      "tr": "Okul gösterisi başlamak üzere."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_055",
      "speaker": "刘梅",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_056",
      "speaker": "张伟",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_057",
      "speaker": "张乐乐",
      "zh": "嗯，紧张这点确实很实用。",
      "pinyin": "En, jǐnzhāng zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, gergin gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_058",
      "speaker": "老师",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_059",
      "speaker": "刘梅",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_060",
      "speaker": "张伟",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_061",
      "speaker": "张乐乐",
      "zh": "我觉得紧张也很重要。",
      "pinyin": "Wǒ juéde jǐnzhāng yě hěn zhòngyào.",
      "tr": "Bence gergin de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_062",
      "speaker": "老师",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_063",
      "speaker": "刘梅",
      "zh": "嗯，台词这部分现在清楚多了。",
      "pinyin": "En, táicí zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, replik kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_064",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_065",
      "speaker": "张乐乐",
      "zh": "那再一次呢？",
      "pinyin": "Nà zài yīcì ne?",
      "tr": "Peki bir kez daha?"
    },
    {
      "id": "DLG_ZH_HSK2_SC037_066",
      "speaker": "老师",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_067",
      "speaker": "刘梅",
      "zh": "嗯，校车这点确实很实用。",
      "pinyin": "En, xiàochē zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, okul servisi gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_068",
      "speaker": "张伟",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_069",
      "speaker": "张乐乐",
      "zh": "我觉得舞台也很重要。",
      "pinyin": "Wǒ juéde wǔtái yě hěn zhòngyào.",
      "tr": "Bence sahne de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_070",
      "speaker": "老师",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_071",
      "speaker": "刘梅",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_072",
      "speaker": "张伟",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_073",
      "speaker": "张乐乐",
      "zh": "嗯，紧张这部分现在清楚多了。",
      "pinyin": "En, jǐnzhāng zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, gergin kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC037_074",
      "speaker": "老师",
