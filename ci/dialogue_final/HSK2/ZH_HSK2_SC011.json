{
  "naturalizationVersion": 3,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC011",
  "level": "HSK2",
  "sourceTitleZh": "第一次家长会",
  "sourceTitleTr": "Okul Veli Toplantısı",
  "sourceMiniAdventureTr": "Liu Mei, Lele’nin öğretmeniyle okul durumu hakkında konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC011_001",
      "speaker": "刘梅",
      "zh": "今天是第一次家长会。",
      "pinyin": "Jīntiān shì dìyīcì jiāzhǎnghuì.",
      "tr": "Bugün ilk veli toplantısı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_002",
      "speaker": "老师",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_003",
      "speaker": "张乐乐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_004",
      "speaker": "刘梅",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_005",
      "speaker": "老师",
      "zh": "今天学校开家长会。",
      "pinyin": "Jīntiān xuéxiào kāi jiāzhǎnghuì.",
      "tr": "Bugün okulda veli toplantısı var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_006",
      "speaker": "张乐乐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_008",
      "speaker": "老师",
      "zh": "老师今天也来了。",
      "pinyin": "Lǎoshī jīntiān yě lái le.",
      "tr": "Öğretmen bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_009",
      "speaker": "张乐乐",
      "zh": "好，老师这点我记住了。",
      "pinyin": "Hǎo, lǎoshī zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, öğretmen konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_011",
      "speaker": "老师",
      "zh": "老师说他进步很大。",
      "pinyin": "Lǎoshī shuō tā jìnbù hěndà.",
      "tr": "Öğretmen onun çok ilerlediğini söyledi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_012",
      "speaker": "张乐乐",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_014",
      "speaker": "老师",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_017",
      "speaker": "老师",
      "zh": "乐乐有一点不认真。",
      "pinyin": "Lèlè yǒu yìdiǎn bù rènzhēn.",
      "tr": "Lele biraz dikkatsiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_018",
      "speaker": "张乐乐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC011_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_020",
      "speaker": "老师",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_021",
      "speaker": "张乐乐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_022",
      "speaker": "刘梅",
      "zh": "我们先学习一下吧。",
      "pinyin": "Wǒmen xiān xuéxí yīxià ba.",
      "tr": "Önce ders çalışma."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_023",
      "speaker": "老师",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_024",
      "speaker": "张乐乐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_025",
      "speaker": "刘梅",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_026",
      "speaker": "老师",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_028",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_029",
      "speaker": "老师",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_030",
      "speaker": "张乐乐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_031",
      "speaker": "刘梅",
      "zh": "以后我会更注意。",
      "pinyin": "Yǐhòu wǒhuì gèng zhùyì.",
      "tr": "Bundan sonra daha dikkatli olacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_032",
      "speaker": "老师",
      "zh": "对，家人这点你说得对。",
      "pinyin": "Duì, jiārén zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, aile konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_033",
      "speaker": "张乐乐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_035",
      "speaker": "老师",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_038",
      "speaker": "老师",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_041",
      "speaker": "老师",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_042",
      "speaker": "张乐乐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_044",
      "speaker": "老师",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_045",
      "speaker": "张乐乐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_047",
      "speaker": "老师",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_048",
      "speaker": "张乐乐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_050",
      "speaker": "老师",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_051",
      "speaker": "张乐乐",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_053",
      "speaker": "老师",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_054",
      "speaker": "张乐乐",
      "zh": "今天学校开家长会。",
      "pinyin": "Jīntiān xuéxiào kāi jiāzhǎnghuì.",
      "tr": "Bugün okulda veli toplantısı var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_055",
      "speaker": "刘梅",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_056",
      "speaker": "老师",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_057",
      "speaker": "张乐乐",
      "zh": "嗯，老师这点确实很实用。",
      "pinyin": "En, lǎoshī zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, öğretmen gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_059",
      "speaker": "老师",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_060",
      "speaker": "张乐乐",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_061",
      "speaker": "刘梅",
      "zh": "我觉得老师也很重要。",
      "pinyin": "Wǒ juéde lǎoshī yě hěn zhòngyào.",
      "tr": "Bence öğretmen de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_062",
      "speaker": "老师",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_063",
      "speaker": "张乐乐",
      "zh": "嗯，学习这部分现在清楚多了。",
      "pinyin": "En, xuéxí zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, ders çalışma kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_064",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_065",
      "speaker": "老师",
      "zh": "那进步呢？",
      "pinyin": "Nà jìnbù ne?",
      "tr": "Peki ilerleme?"
    },
    {
      "id": "DLG_ZH_HSK2_SC011_066",
      "speaker": "张乐乐",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_067",
      "speaker": "刘梅",
      "zh": "嗯，家人这点确实很实用。",
      "pinyin": "En, jiārén zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, aile gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_068",
      "speaker": "老师",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_069",
      "speaker": "张乐乐",
      "zh": "我觉得需要也很重要。",
      "pinyin": "Wǒ juéde xūyào yě hěn zhòngyào.",
      "tr": "Bence gerekmek de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_071",
      "speaker": "老师",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_072",
      "speaker": "张乐乐",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_073",
      "speaker": "刘梅",
      "zh": "嗯，老师这部分现在清楚多了。",
      "pinyin": "En, lǎoshī zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, öğretmen kısmı şimdi çok daha net."
