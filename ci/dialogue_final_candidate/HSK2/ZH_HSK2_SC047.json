{
  "naturalizationVersion": 2,
  "status": "FINAL_CANDIDATE",
  "sceneId": "ZH_HSK2_SC047",
  "level": "HSK2",
  "sourceTitleZh": "乐乐学骑自行车",
  "sourceTitleTr": "Lele Bisiklet Öğreniyor",
  "sourceMiniAdventureTr": "Lele düşer ama yeniden dener.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC047_001",
      "speaker": "张乐乐",
      "zh": "乐乐今天学骑自行车。",
      "pinyin": "Lèlè jīntiān xuéqí zìxíngchē.",
      "tr": "Lele bugün bisiklet sürmeyi öğreniyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_002",
      "speaker": "张伟",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_004",
      "speaker": "张乐乐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_005",
      "speaker": "张伟",
      "zh": "你看，这个自行车在这儿。",
      "pinyin": "Nǐ kàn, zhège zìxíngchē zài zhèér.",
      "tr": "Bu bisiklet burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_006",
      "speaker": "刘梅",
      "zh": "嗯，自行车这部分我明白了。",
      "pinyin": "En, zìxíngchē zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; bisiklet kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_007",
      "speaker": "张乐乐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_008",
      "speaker": "张伟",
      "zh": "我现在会了。",
      "pinyin": "Wǒ xiànzài huì le.",
      "tr": "Artık yapabiliyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_009",
      "speaker": "刘梅",
      "zh": "好，会这点我记住了。",
      "pinyin": "Hǎo, huì zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, yapabilmek konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_010",
      "speaker": "张乐乐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_011",
      "speaker": "张伟",
      "zh": "我还不会，但是我想再试。",
      "pinyin": "Wǒ hái búhuì, dànshì wǒxiǎng zàishì.",
      "tr": "Henüz yapamıyorum ama tekrar denemek istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_012",
      "speaker": "刘梅",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_014",
      "speaker": "张伟",
      "zh": "他刚才摔倒了。",
      "pinyin": "Tā gāngcái shuāidǎo le.",
      "tr": "Az önce düştü."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_017",
      "speaker": "张伟",
      "zh": "他摔倒了一次，有点怕。",
      "pinyin": "Tā shuāidǎo le yīcì, yǒudiǎn pà.",
      "tr": "Bir kez düştü ve biraz korktu."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC047_019",
      "speaker": "张乐乐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_020",
      "speaker": "张伟",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_022",
      "speaker": "张乐乐",
      "zh": "我们再试一次。",
      "pinyin": "Wǒmen zàishìyīcì.",
      "tr": "Bir kez daha deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_023",
      "speaker": "张伟",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_025",
      "speaker": "张乐乐",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_028",
      "speaker": "张乐乐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_031",
      "speaker": "张乐乐",
      "zh": "加油，你可以的！",
      "pinyin": "Jiāyóu, nǐ kěyǐ de!",
      "tr": "Haydi, yapabilirsin!"
    },
    {
      "id": "DLG_ZH_HSK2_SC047_032",
      "speaker": "张伟",
      "zh": "对，公园这点你说得对。",
      "pinyin": "Duì, gōngyuán zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, park konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_034",
      "speaker": "张乐乐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_035",
      "speaker": "张伟",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_037",
      "speaker": "张乐乐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_038",
      "speaker": "张伟",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_045",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把公园说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ gōngyuán shuō qīngchǔ.",
      "tr": "Tamam, park konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_046",
      "speaker": "张乐乐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_047",
      "speaker": "张伟",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_048",
      "speaker": "刘梅",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_049",
      "speaker": "张乐乐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_050",
      "speaker": "张伟",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_051",
      "speaker": "刘梅",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_053",
      "speaker": "张伟",
      "zh": "好，会这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, huì zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, yapabilmek kısmı netleşti; devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_054",
      "speaker": "刘梅",
      "zh": "这个自行车在这儿。",
      "pinyin": "Zhège zìxíngchē zài zhèér.",
      "tr": "Bu bisiklet burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_055",
      "speaker": "张乐乐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_056",
      "speaker": "张伟",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_057",
      "speaker": "刘梅",
      "zh": "嗯，会这点确实很实用。",
      "pinyin": "En, huì zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, yapabilmek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_058",
      "speaker": "张乐乐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_059",
      "speaker": "张伟",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_060",
      "speaker": "刘梅",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_061",
      "speaker": "张乐乐",
      "zh": "我觉得会也很重要。",
      "pinyin": "Wǒ juéde huì yě hěn zhòngyào.",
      "tr": "Bence yapabilmek de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_062",
      "speaker": "张伟",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_063",
      "speaker": "刘梅",
      "zh": "嗯，再试一次这部分现在清楚多了。",
      "pinyin": "En, zàishìyīcì zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, bir kez daha denemek kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_064",
      "speaker": "张乐乐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_065",
      "speaker": "张伟",
      "zh": "那还不会呢？",
      "pinyin": "Nà hái búhuì ne?",
      "tr": "Peki henüz yapamamak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC047_066",
      "speaker": "刘梅",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_067",
      "speaker": "张乐乐",
      "zh": "嗯，公园这点确实很实用。",
      "pinyin": "En, gōngyuán zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, park gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_068",
      "speaker": "张伟",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_069",
      "speaker": "刘梅",
      "zh": "我觉得摔倒也很重要。",
      "pinyin": "Wǒ juéde shuāidǎo yě hěn zhòngyào.",
      "tr": "Bence düşmek de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_070",
      "speaker": "张乐乐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_071",
      "speaker": "张伟",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC047_072",
      "speaker": "刘梅",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
