  "level": "HSK1",
  "sourceTitleZh": "第一次坐出租车",
  "sourceTitleTr": "İlk Taksi Yolculuğu",
  "sourceMiniAdventureTr": "Taksi şoförü adresi yanlış anlar; Li Chen doğru yolu açıklamaya yardım eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC009_001",
      "speaker": "张伟",
      "zh": "我们坐出租车去新家。",
      "pinyin": "Wǒmen zuò chūzūchē qù xīnjiā.",
      "tr": "Yeni eve taksiyle gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_003",
      "speaker": "李晨",
      "zh": "嗯，出租车这点就这么办。",
      "pinyin": "En, chūzūchē zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, taksi konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_004",
      "speaker": "司机",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_006",
      "speaker": "刘梅",
      "zh": "我们坐出租车吗？",
      "pinyin": "Wǒmen zuò chūzūchē ma?",
      "tr": "Taksi ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_007",
      "speaker": "李晨",
      "zh": "对，我们坐出租车。",
      "pinyin": "Duì, wǒmen zuò chūzūchē.",
      "tr": "Evet, taksi ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_008",
      "speaker": "司机",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_010",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dìzhǐ shì shénme?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_011",
      "speaker": "李晨",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_012",
      "speaker": "司机",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_013",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把地址说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ dìzhǐ shuō qīngchǔ.",
      "tr": "Tamam, adres konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_014",
      "speaker": "刘梅",
      "zh": "那路在哪儿？",
      "pinyin": "Nàlù zài nǎér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_015",
      "speaker": "李晨",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_016",
      "speaker": "司机",
      "zh": "嗯，路这部分我明白了。",
      "pinyin": "En, lù zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; yol kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_017",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把路说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ lù shuō qīngchǔ.",
      "tr": "Tamam, yol konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_018",
      "speaker": "刘梅",
      "zh": "你的号码是什么？",
      "pinyin": "Nǐ de hàomǎ shì shénme?",
      "tr": "Numara nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_019",
      "speaker": "李晨",
      "zh": "这是我的号码。",
      "pinyin": "Zhè shì wǒ de hàomǎ.",
      "tr": "Bu benim numara."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_020",
      "speaker": "司机",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_021",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把号码说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ hàomǎ shuō qīngchǔ.",
      "tr": "Tamam, numara konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_022",
      "speaker": "刘梅",
      "zh": "司机听错了地址。",
      "pinyin": "Sījī tīngcuò le dìzhǐ.",
      "tr": "Şoför adresi yanlış duydu."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_024",
      "speaker": "司机",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_026",
      "speaker": "刘梅",
      "zh": "嗯，地址这点就这么办。",
