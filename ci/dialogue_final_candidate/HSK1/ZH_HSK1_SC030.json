  "sourceTitleZh": "好消息",
  "sourceTitleTr": "Güzel Haber",
  "sourceMiniAdventureTr": "Zhang işe kabul edilir; aile küçük bir kutlama yapar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC030_001",
      "speaker": "张伟",
      "zh": "公司打来了好消息。",
      "pinyin": "Gōngsī dǎlái le hǎoxiāoxī.",
      "tr": "Şirketten güzel haber geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_003",
      "speaker": "张雨桐",
      "zh": "嗯，工作这点就这么办。",
      "pinyin": "En, gōngzuò zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, iş konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_006",
      "speaker": "刘梅",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_007",
      "speaker": "张雨桐",
      "zh": "嗯，工作这点就这么办。",
      "pinyin": "En, gōngzuò zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, iş konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_008",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_011",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_013",
      "speaker": "张伟",
      "zh": "嗯，家人这点我也是这么想的。",
      "pinyin": "En, jiārén zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, aile konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_014",
      "speaker": "刘梅",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàngāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_015",
      "speaker": "张雨桐",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒyào dàngāo, xièxiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_016",
      "speaker": "张乐乐",
      "zh": "嗯，蛋糕这点就这么办。",
      "pinyin": "En, dàngāo zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, kek / pasta konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_017",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把蛋糕说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ dàngāo shuō qīngchǔ.",
      "tr": "Tamam, kek / pasta konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_018",
      "speaker": "刘梅",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎnshàng yǒu shíjiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_019",
      "speaker": "张雨桐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_020",
      "speaker": "张乐乐",
      "zh": "晚上见。",
      "pinyin": "Wǎnshàng jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_021",
      "speaker": "张伟",
      "zh": "嗯，晚上这点就这么办。",
      "pinyin": "En, wǎnshàng zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, akşam konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_022",
      "speaker": "刘梅",
      "zh": "大家等着听结果。",
      "pinyin": "Dàjiā děng zhe tīng jiéguǒ.",
      "tr": "Herkes sonucu bekliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_026",
      "speaker": "刘梅",
      "zh": "嗯，晚上这点就这么办。",
      "pinyin": "En, wǎnshàng zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, akşam konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_027",
      "speaker": "张雨桐",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_028",
      "speaker": "张乐乐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_029",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_030",
      "speaker": "刘梅",
      "zh": "好，今天这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, jīntiān zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, bugün kısmı netleşti; devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_031",
      "speaker": "张雨桐",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_032",
      "speaker": "张乐乐",
      "zh": "你好！",
