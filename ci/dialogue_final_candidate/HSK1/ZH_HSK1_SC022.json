{
  "naturalizationVersion": 2,
  "status": "FINAL_CANDIDATE",
  "sceneId": "ZH_HSK1_SC022",
  "level": "HSK1",
  "sourceTitleZh": "新班级",
  "sourceTitleTr": "Yeni Sınıf",
  "sourceMiniAdventureTr": "Öğretmen Yutong’u sınıfa tanıtır; öğrenciler basit sorular sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC022_001",
      "speaker": "老师",
      "zh": "雨桐来到新班级。",
      "pinyin": "Yǔtóng láidào xīn bānjí.",
      "tr": "Yutong yeni sınıfına geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_003",
      "speaker": "同学",
      "zh": "嗯，班这点就这么办。",
      "pinyin": "En, bān zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, sınıf / şube konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_004",
      "speaker": "同学",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_005",
      "speaker": "老师",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_006",
      "speaker": "张雨桐",
      "zh": "教室在哪儿？",
      "pinyin": "Jiàoshì zài nǎér?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_007",
      "speaker": "同学",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_008",
      "speaker": "同学",
      "zh": "嗯，教室这部分我明白了。",
      "pinyin": "En, jiàoshì zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; sınıf kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_009",
      "speaker": "老师",
      "zh": "好，谢谢你帮我把教室说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ jiàoshì shuō qīngchǔ.",
      "tr": "Tamam, sınıf konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_010",
      "speaker": "张雨桐",
      "zh": "这是我们的学生。",
      "pinyin": "Zhèshì wǒmen de xuéshēng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_011",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_012",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_013",
      "speaker": "老师",
      "zh": "嗯，学生这点我也是这么想的。",
      "pinyin": "En, xuéshēng zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, öğrenci konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_014",
      "speaker": "张雨桐",
      "zh": "这是我们的老师。",
      "pinyin": "Zhèshì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_015",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_016",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_017",
      "speaker": "老师",
      "zh": "嗯，老师这点我也是这么想的。",
      "pinyin": "En, lǎoshī zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, öğretmen konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_018",
      "speaker": "张雨桐",
      "zh": "这是班吗？",
      "pinyin": "Zhè shì bān ma?",
      "tr": "Bu, sınıf / şube mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_019",
      "speaker": "同学",
      "zh": "没错，是班。",
      "pinyin": "Méicuò, shì bān.",
      "tr": "Evet, bu sınıf / şube."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_020",
      "speaker": "同学",
      "zh": "那班在哪儿？",
      "pinyin": "Nàbān zài nǎér?",
      "tr": "Sınıf / şube nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_021",
      "speaker": "老师",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sınıf / şube burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_022",
      "speaker": "张雨桐",
      "zh": "大家还不知道她是谁。",
      "pinyin": "Dàjiā hái bù zhīdào tā shì shuí.",
      "tr": "Kimse henüz onun kim olduğunu bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_023",
      "speaker": "同学",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_025",
      "speaker": "老师",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_026",
      "speaker": "张雨桐",
      "zh": "嗯，班这点就这么办。",
      "pinyin": "En, bān zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, sınıf / şube konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_027",
      "speaker": "同学",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_028",
      "speaker": "同学",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_029",
      "speaker": "老师",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_030",
      "speaker": "张雨桐",
      "zh": "好，谢谢你帮我把名字说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ míngzì shuō qīngchǔ.",
      "tr": "Tamam, isim konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_031",
      "speaker": "同学",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_032",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_033",
      "speaker": "老师",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_034",
      "speaker": "张雨桐",
      "zh": "嗯，朋友这点我也是这么想的。",
      "pinyin": "En, péngyǒu zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, arkadaş konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_035",
      "speaker": "同学",
      "zh": "那学校在哪儿？",
      "pinyin": "Nà xuéxiào zài nǎér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_036",
      "speaker": "同学",
      "zh": "你看，学校在那边。",
      "pinyin": "Nǐ kàn, xuéxiào zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_037",
      "speaker": "老师",
      "zh": "嗯，朋友这部分我明白了。",
      "pinyin": "En, péngyǒu zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; arkadaş kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_038",
      "speaker": "张雨桐",
      "zh": "好，谢谢你帮我把朋友说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ péngyǒu shuō qīngchǔ.",
      "tr": "Tamam, arkadaş konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_039",
      "speaker": "同学",
      "zh": "这个是书吗？",
      "pinyin": "Zhège shì shū ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_040",
      "speaker": "同学",
      "zh": "对，就是书。",
      "pinyin": "Duì, jiùshì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_041",
      "speaker": "老师",
      "zh": "书呢？",
      "pinyin": "Shū ne?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_042",
      "speaker": "张雨桐",
      "zh": "你看，书在这儿。",
      "pinyin": "Nǐ kàn, shū zài zhèér.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_043",
      "speaker": "同学",
      "zh": "老师介绍了雨桐。",
      "pinyin": "Lǎoshī jièshào le yǔtóng.",
      "tr": "Öğretmen Yutong’u tanıttı."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_044",
      "speaker": "同学",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_045",
      "speaker": "老师",
      "zh": "好，谢谢你帮我把老师说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ lǎoshī shuō qīngchǔ.",
      "tr": "Tamam, öğretmen konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_046",
      "speaker": "张雨桐",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_047",
      "speaker": "同学",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_048",
      "speaker": "同学",
      "zh": "好，老师这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, lǎoshī zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, öğretmen kısmı netleşti; devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_049",
      "speaker": "老师",
