      "zh": "那雨伞在哪儿？",
      "pinyin": "Nà yǔsǎn zài nǎér?",
      "tr": "Şemsiye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_080",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Şemsiye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_081",
      "speaker": "张伟",
      "zh": "这个是天气吗？",
      "pinyin": "Zhège shì tiānqì ma?",
      "tr": "Bu, hava mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_082",
      "speaker": "刘梅",
      "zh": "对，就是天气。",
      "pinyin": "Duì, jiùshì tiānqì.",
      "tr": "Evet, bu hava."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_083",
      "speaker": "张乐乐",
      "zh": "天气呢？",
      "pinyin": "Tiānqì ne?",
      "tr": "Hava nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_084",
      "speaker": "张雨桐",
      "zh": "你看，天气在这儿。",
      "pinyin": "Nǐ kàn, tiānqì zài zhèér.",
      "tr": "Hava burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_085",
      "speaker": "张伟",
      "zh": "这是外套吗？",
      "pinyin": "Zhèshì wàitào ma?",
      "tr": "Bu, mont mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_086",
      "speaker": "刘梅",
      "zh": "嗯，对，这是外套。",
      "pinyin": "En, duì, zhèshì wàitào.",
      "tr": "Evet, bu mont."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_087",
      "speaker": "张乐乐",
      "zh": "外套在哪儿？",
      "pinyin": "Wàitào zài nǎér?",
      "tr": "Mont nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_088",
      "speaker": "张雨桐",
      "zh": "外套在这儿。",
      "pinyin": "Wàitào zài zhèér.",
      "tr": "Mont burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_089",
      "speaker": "张伟",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_090",
      "speaker": "刘梅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_091",
      "speaker": "张乐乐",
      "zh": "嗯，路这部分我明白了。",
      "pinyin": "En, lù zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; yol kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_092",
      "speaker": "张雨桐",
      "zh": "好，谢谢你帮我把路说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ lù shuō qīngchǔ.",
      "tr": "Tamam, yol konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_093",
      "speaker": "张伟",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_094",
      "speaker": "刘梅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_095",
      "speaker": "张乐乐",
      "zh": "嗯，家这部分我明白了。",
      "pinyin": "En, jiā zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; ev kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_096",
      "speaker": "张雨桐",
      "zh": "今天学了很多。",
      "pinyin": "Jīntiān xuéle hěnduō.",
      "tr": "Bugün çok şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_097",
      "speaker": "张伟",
      "zh": "嗯，家这点我也是这么想的。",
      "pinyin": "En, jiā zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, ev konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_098",
      "speaker": "刘梅",
      "zh": "都好了吗？",
      "pinyin": "Dōu hǎolema?",
      "tr": "Her şey tamam mı?"
