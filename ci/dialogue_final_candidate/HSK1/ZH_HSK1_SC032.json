{
  "naturalizationVersion": 2,
  "status": "FINAL_CANDIDATE",
  "sceneId": "ZH_HSK1_SC032",
  "level": "HSK1",
  "sourceTitleZh": "新同事",
  "sourceTitleTr": "Yeni İş Arkadaşları",
  "sourceMiniAdventureTr": "Öğle arasında iş arkadaşları kendilerini tanıtır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC032_001",
      "speaker": "张伟",
      "zh": "张伟认识新同事。",
      "pinyin": "Zhāngwěi rènshí xīn tóngshì.",
      "tr": "Zhang Wei yeni iş arkadaşlarıyla tanışıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_003",
      "speaker": "同事",
      "zh": "嗯，同事这点就这么办。",
      "pinyin": "En, tóngshì zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, iş arkadaşı konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_004",
      "speaker": "经理",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_006",
      "speaker": "同事",
      "zh": "这是我们的同事。",
      "pinyin": "Zhèshì wǒmen de tóngshì.",
      "tr": "Bu bizim iş arkadaşı."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_007",
      "speaker": "同事",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_008",
      "speaker": "经理",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_009",
      "speaker": "张伟",
      "zh": "嗯，同事这点我也是这么想的。",
      "pinyin": "En, tóngshì zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, iş arkadaşı konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_010",
      "speaker": "同事",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_011",
      "speaker": "同事",
      "zh": "嗯，工作这点就这么办。",
      "pinyin": "En, gōngzuò zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, iş konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_012",
      "speaker": "经理",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_013",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_014",
      "speaker": "同事",
      "zh": "那办公室在哪儿？",
      "pinyin": "Nà bàngōngshì zài nǎér?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_015",
      "speaker": "同事",
      "zh": "办公室在那边。",
      "pinyin": "Bàngōngshì zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_016",
      "speaker": "经理",
      "zh": "嗯，办公室这部分我明白了。",
      "pinyin": "En, bàngōngshì zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; ofis kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_017",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把办公室说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ bàngōngshì shuō qīngchǔ.",
      "tr": "Tamam, ofis konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_018",
      "speaker": "同事",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_019",
      "speaker": "同事",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_020",
      "speaker": "经理",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_021",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把名字说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ míngzì shuō qīngchǔ.",
      "tr": "Tamam, isim konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_022",
      "speaker": "同事",
      "zh": "大家都想知道他从哪儿来。",
      "pinyin": "Dàjiā dōu xiǎng zhīdào tā cóng nǎér lái.",
      "tr": "Herkes nereden geldiğini merak ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_023",
      "speaker": "同事",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_024",
      "speaker": "经理",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_026",
      "speaker": "同事",
      "zh": "嗯，名字这点就这么办。",
      "pinyin": "En, míngzì zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, isim konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_027",
      "speaker": "同事",
      "zh": "城市呢？",
      "pinyin": "Chéngshì ne?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_028",
      "speaker": "经理",
      "zh": "城市在那边。",
      "pinyin": "Chéngshì zài nàbiān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_029",
      "speaker": "张伟",
      "zh": "嗯，城市这部分我明白了。",
      "pinyin": "En, chéngshì zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; şehir kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_030",
      "speaker": "同事",
      "zh": "好，谢谢你帮我把城市说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ chéngshì shuō qīngchǔ.",
      "tr": "Tamam, şehir konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_031",
      "speaker": "同事",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_032",
      "speaker": "经理",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_034",
      "speaker": "同事",
      "zh": "嗯，朋友这点我也是这么想的。",
      "pinyin": "En, péngyǒu zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, arkadaş konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_035",
      "speaker": "同事",
      "zh": "你要午饭吗？",
      "pinyin": "Nǐ yào wǔfàn ma?",
      "tr": "Öğle yemeği ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_036",
      "speaker": "经理",
      "zh": "我要午饭，谢谢。",
      "pinyin": "Wǒyào wǔfàn, xièxiè.",
      "tr": "Öğle yemeği istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_037",
      "speaker": "张伟",
      "zh": "嗯，朋友这点就这么办。",
      "pinyin": "En, péngyǒu zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, arkadaş konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_038",
      "speaker": "同事",
      "zh": "好，谢谢你帮我把朋友说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ péngyǒu shuō qīngchǔ.",
      "tr": "Tamam, arkadaş konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_039",
      "speaker": "同事",
      "zh": "这是电脑，对吗？",
      "pinyin": "Zhèshì diànnǎo, duì ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_040",
      "speaker": "经理",
      "zh": "没错，是电脑。",
      "pinyin": "Méicuò, shì diànnǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_041",
      "speaker": "张伟",
      "zh": "那电脑在哪儿？",
      "pinyin": "Nà diànnǎo zài nǎér?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_042",
      "speaker": "同事",
      "zh": "电脑在这儿。",
      "pinyin": "Diànnǎo zài zhèér.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_043",
      "speaker": "同事",
      "zh": "他们很快开始聊天。",
      "pinyin": "Tāmen hěnkuài kāishǐ liáotiān.",
      "tr": "Kısa sürede sohbet etmeye başlıyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_044",
      "speaker": "经理",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_045",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把朋友说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ péngyǒu shuō qīngchǔ.",
      "tr": "Tamam, arkadaş konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_046",
      "speaker": "同事",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_047",
      "speaker": "同事",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_048",
      "speaker": "经理",
      "zh": "好，朋友这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, péngyǒu zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, arkadaş kısmı netleşti; devam edelim."
    },
