  "level": "HSK1",
  "sourceTitleZh": "认识李晨",
  "sourceTitleTr": "Li Chen ile Tanışma",
  "sourceMiniAdventureTr": "Li Chen aileye yardım teklif eder; bu tanışma uzun bir dostluğun başlangıcı olur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC008_001",
      "speaker": "张伟",
      "zh": "李晨来帮我们。",
      "pinyin": "Lǐchénlái bāng wǒmen.",
      "tr": "Li Chen bize yardım etmeye geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_003",
      "speaker": "李晨",
      "zh": "嗯，名字这点就这么办。",
      "pinyin": "En, míngzì zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, isim konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_006",
      "speaker": "刘梅",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_007",
      "speaker": "李晨",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_008",
      "speaker": "张乐乐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_009",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把名字说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ míngzì shuō qīngchǔ.",
      "tr": "Tamam, isim konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_010",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_011",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_013",
      "speaker": "张伟",
      "zh": "嗯，朋友这点我也是这么想的。",
      "pinyin": "En, péngyǒu zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, arkadaş konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_014",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_015",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_016",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_017",
      "speaker": "张伟",
      "zh": "嗯，家人这点我也是这么想的。",
      "pinyin": "En, jiārén zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, aile konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_018",
      "speaker": "刘梅",
      "zh": "车站呢？",
      "pinyin": "Chēzhàn ne?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_019",
      "speaker": "李晨",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_020",
      "speaker": "张乐乐",
      "zh": "嗯，车站这部分我明白了。",
      "pinyin": "En, chēzhàn zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; istasyon kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_021",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把车站说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ chēzhàn shuō qīngchǔ.",
      "tr": "Tamam, istasyon konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_022",
      "speaker": "刘梅",
      "zh": "我们还不认识他。",
      "pinyin": "Wǒmen hái bù rènshí tā.",
      "tr": "Onu henüz tanımıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_026",
      "speaker": "刘梅",
      "zh": "嗯，车站这点就这么办。",
      "pinyin": "En, chēzhàn zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, istasyon konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC008_027",
      "speaker": "李晨",
      "zh": "那城市在哪儿？",
      "pinyin": "Nà chéngshì zài nǎér?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_028",
      "speaker": "张乐乐",
      "zh": "就在那边。",
