      "id": "DLG_ZH_HSK1_SC043_077",
      "speaker": "张雨桐",
      "zh": "你在学习吗？",
      "pinyin": "Nǐ zài xuéxí ma?",
      "tr": "Ders mi çalışıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_078",
      "speaker": "刘梅",
      "zh": "嗯，学习这点就这么办。",
      "pinyin": "En, xuéxí zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, ders çalışma / öğrenme konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_079",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_080",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_081",
      "speaker": "张雨桐",
      "zh": "学校在哪儿？",
      "pinyin": "Xuéxiào zài nǎér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_082",
      "speaker": "刘梅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_083",
      "speaker": "张伟",
      "zh": "嗯，学校这部分我明白了。",
      "pinyin": "En, xuéxiào zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; okul kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_084",
      "speaker": "张乐乐",
      "zh": "好，谢谢你帮我把学校说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ xuéxiào shuō qīngchǔ.",
      "tr": "Tamam, okul konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_085",
      "speaker": "张雨桐",
      "zh": "这是书，对吗？",
      "pinyin": "Zhè shì shū, duì ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_086",
      "speaker": "刘梅",
      "zh": "对，就是书。",
      "pinyin": "Duì, jiùshì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_087",
      "speaker": "张伟",
      "zh": "那书在哪儿？",
      "pinyin": "Nàshū zài nǎér?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_088",
      "speaker": "张乐乐",
      "zh": "你看，书在这儿。",
      "pinyin": "Nǐ kàn, shū zài zhèér.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_089",
      "speaker": "张雨桐",
      "zh": "这是试卷，对吗？",
      "pinyin": "Zhèshì shìjuàn, duì ma?",
      "tr": "Bu, sınav kâğıdı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_090",
      "speaker": "刘梅",
      "zh": "没错，是试卷。",
      "pinyin": "Méicuò, shì shìjuàn.",
      "tr": "Evet, bu sınav kâğıdı."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_091",
      "speaker": "张伟",
      "zh": "试卷在哪儿？",
      "pinyin": "Shìjuàn zài nǎér?",
      "tr": "Sınav kâğıdı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_092",
      "speaker": "张乐乐",
      "zh": "试卷在这儿。",
      "pinyin": "Shìjuàn zài zhèér.",
      "tr": "Sınav kâğıdı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_093",
      "speaker": "张雨桐",
      "zh": "这是我们的老师。",
      "pinyin": "Zhèshì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_094",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_095",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_096",
      "speaker": "张乐乐",
      "zh": "今天学了很多。",
      "pinyin": "Jīntiān xuéle hěnduō.",
      "tr": "Bugün çok şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_097",
      "speaker": "张雨桐",
      "zh": "嗯，老师这点我也是这么想的。",
      "pinyin": "En, lǎoshī zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, öğretmen konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_098",
      "speaker": "刘梅",
      "zh": "都好了吗？",
      "pinyin": "Dōu hǎolema?",
      "tr": "Her şey tamam mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_099",
      "speaker": "张伟",
      "zh": "都好了。",
      "pinyin": "Dōu hǎo le.",
      "tr": "Her şey tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_100",
      "speaker": "张乐乐",
      "zh": "走吧。",
      "pinyin": "Zǒu ba.",
      "tr": "Hadi gidelim."
    }
  ]
}
