{
  "naturalizationVersion": 2,
  "status": "FINAL_CANDIDATE",
  "sceneId": "ZH_HSK1_SC011",
  "level": "HSK1",
  "sourceTitleZh": "箱子放哪儿？",
  "sourceTitleTr": "Kutular Nerede?",
  "sourceMiniAdventureTr": "Mutfak kutuları yanlış odaya bırakılmıştır; aile kutuları yeniden düzenler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC011_001",
      "speaker": "张伟",
      "zh": "我们要放好箱子。",
      "pinyin": "Wǒmen yàofànghǎo xiāngzi.",
      "tr": "Kutuları doğru yerlere koyacağız."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_003",
      "speaker": "张雨桐",
      "zh": "嗯，箱子这点就这么办。",
      "pinyin": "En, xiāngzi zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, kutu / koli konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_006",
      "speaker": "刘梅",
      "zh": "这是箱子，对吗？",
      "pinyin": "Zhèshì xiāngzi, duì ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_007",
      "speaker": "张雨桐",
      "zh": "没错，是箱子。",
      "pinyin": "Méicuò, shì xiāngzi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_008",
      "speaker": "张乐乐",
      "zh": "那箱子在哪儿？",
      "pinyin": "Nà xiāngzi zài nǎér?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_009",
      "speaker": "张伟",
      "zh": "你看，箱子在这儿。",
      "pinyin": "Nǐ kàn, xiāngzi zài zhèér.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_010",
      "speaker": "刘梅",
      "zh": "房间呢？",
      "pinyin": "Fángjiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_011",
      "speaker": "张雨桐",
      "zh": "你看，房间在那边。",
      "pinyin": "Nǐ kàn, fángjiān zài nàbiān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_012",
      "speaker": "张乐乐",
      "zh": "嗯，房间这部分我明白了。",
      "pinyin": "En, fángjiān zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; oda kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_013",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把房间说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ fángjiān shuō qīngchǔ.",
      "tr": "Tamam, oda konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_014",
      "speaker": "刘梅",
      "zh": "厨房呢？",
      "pinyin": "Chúfáng ne?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_015",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_016",
      "speaker": "张乐乐",
      "zh": "嗯，厨房这部分我明白了。",
      "pinyin": "En, chúfáng zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; mutfak kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_017",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把厨房说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ chúfáng shuō qīngchǔ.",
      "tr": "Tamam, mutfak konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_018",
      "speaker": "刘梅",
      "zh": "那客厅在哪儿？",
      "pinyin": "Nà kètīng zài nǎér?",
      "tr": "Salon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_019",
      "speaker": "张雨桐",
      "zh": "你看，客厅在那边。",
      "pinyin": "Nǐ kàn, kètīng zài nàbiān.",
      "tr": "Salon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_020",
      "speaker": "张乐乐",
      "zh": "嗯，客厅这部分我明白了。",
      "pinyin": "En, kètīng zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; salon kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_021",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把客厅说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ kètīng shuō qīngchǔ.",
      "tr": "Tamam, salon konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_022",
      "speaker": "刘梅",
      "zh": "厨房的箱子在孩子的房间。",
      "pinyin": "Chúfáng de xiāngzi zài háizi de fángjiān.",
      "tr": "Mutfak kutusu çocuk odasında."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_026",
      "speaker": "刘梅",
      "zh": "嗯，箱子这点就这么办。",
      "pinyin": "En, xiāngzi zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, kutu / koli konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_027",
      "speaker": "张雨桐",
      "zh": "那家在哪儿？",
      "pinyin": "Nàjiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_028",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_029",
      "speaker": "张伟",
      "zh": "嗯，家这部分我明白了。",
      "pinyin": "En, jiā zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; ev kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_030",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把家说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ jiā shuō qīngchǔ.",
      "tr": "Tamam, ev konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_031",
      "speaker": "张雨桐",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_032",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是门。",
      "pinyin": "En, duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_033",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_034",
      "speaker": "刘梅",
      "zh": "你看，门在这儿。",
      "pinyin": "Nǐ kàn, mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_035",
      "speaker": "张雨桐",
      "zh": "这是桌子，对吗？",
      "pinyin": "Zhèshì zhuōzi, duì ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_036",
      "speaker": "张乐乐",
      "zh": "对，就是桌子。",
      "pinyin": "Duì, jiùshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_037",
      "speaker": "张伟",
      "zh": "桌子呢？",
      "pinyin": "Zhuōzi ne?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_038",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_039",
      "speaker": "张雨桐",
      "zh": "这是椅子，对吗？",
      "pinyin": "Zhèshì yǐzi, duì ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_040",
      "speaker": "张乐乐",
      "zh": "没错，是椅子。",
      "pinyin": "Méicuò, shì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_041",
      "speaker": "张伟",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎér?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_043",
      "speaker": "张雨桐",
      "zh": "我们把箱子放回厨房。",
      "pinyin": "Wǒmen bǎ xiāngzi fàng huí chúfáng.",
      "tr": "Kutuyu yeniden mutfağa koyuyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_045",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把箱子说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ xiāngzi shuō qīngchǔ.",
      "tr": "Tamam, kutu / koli konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_048",
      "speaker": "张乐乐",
      "zh": "好，箱子这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, xiāngzi zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, kutu / koli kısmı netleşti; devam edelim."
    },
