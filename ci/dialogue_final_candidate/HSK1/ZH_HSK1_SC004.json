  "level": "HSK1",
  "sourceTitleZh": "火车上的早餐",
  "sourceTitleTr": "Trende İlk Kahvaltı",
  "sourceMiniAdventureTr": "Çocuklar trende yiyecek ister ve aile vagondaki satıcıdan alışveriş yapar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC004_001",
      "speaker": "张伟",
      "zh": "我们在火车上吃早饭。",
      "pinyin": "Wǒmen zài huǒchē shàng chī zǎofàn.",
      "tr": "Trende kahvaltı yapıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_003",
      "speaker": "张雨桐",
      "zh": "嗯，早饭这点就这么办。",
      "pinyin": "En, zǎofàn zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, kahvaltı konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_005",
      "speaker": "售货员",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_006",
      "speaker": "张伟",
      "zh": "你要早饭吗？",
      "pinyin": "Nǐ yào zǎofàn ma?",
      "tr": "Kahvaltı ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_007",
      "speaker": "刘梅",
      "zh": "我要早饭，谢谢。",
      "pinyin": "Wǒyào zǎofàn, xièxiè.",
      "tr": "Kahvaltı istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_008",
      "speaker": "张雨桐",
      "zh": "嗯，早饭这点就这么办。",
      "pinyin": "En, zǎofàn zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, kahvaltı konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_009",
      "speaker": "张乐乐",
      "zh": "好，谢谢你帮我把早饭说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ zǎofàn shuō qīngchǔ.",
      "tr": "Tamam, kahvaltı konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_010",
      "speaker": "售货员",
      "zh": "你要面包吗？",
      "pinyin": "Nǐ yào miànbāo ma?",
      "tr": "Ekmek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_011",
      "speaker": "张伟",
      "zh": "我要面包，谢谢。",
      "pinyin": "Wǒyào miànbāo, xièxiè.",
      "tr": "Ekmek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_012",
      "speaker": "刘梅",
      "zh": "嗯，面包这点就这么办。",
      "pinyin": "En, miànbāo zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, ekmek konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_013",
      "speaker": "张雨桐",
      "zh": "好，谢谢你帮我把面包说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ miànbāo shuō qīngchǔ.",
      "tr": "Tamam, ekmek konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_014",
      "speaker": "张乐乐",
      "zh": "你要水吗？",
      "pinyin": "Nǐ yào shuǐ ma?",
      "tr": "Su ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_015",
      "speaker": "售货员",
      "zh": "我要水，谢谢。",
      "pinyin": "Wǒyào shuǐ, xièxiè.",
      "tr": "Su istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_016",
      "speaker": "张伟",
      "zh": "嗯，水这点就这么办。",
      "pinyin": "En, shuǐ zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, su konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_017",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把水说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ shuǐ shuō qīngchǔ.",
      "tr": "Tamam, su konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_018",
      "speaker": "张雨桐",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_019",
      "speaker": "张乐乐",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒyào chá, xièxiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_020",
      "speaker": "售货员",
      "zh": "嗯，茶这点就这么办。",
      "pinyin": "En, chá zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, çay konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_021",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把茶说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ chá shuō qīngchǔ.",
      "tr": "Tamam, çay konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_022",
      "speaker": "刘梅",
      "zh": "乐乐不知道要吃什么。",
      "pinyin": "Lèlè bù zhīdào yào chī shénme.",
      "tr": "Lele ne yiyeceğini bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_025",
      "speaker": "售货员",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_026",
      "speaker": "张伟",
      "zh": "嗯，茶这点就这么办。",
      "pinyin": "En, chá zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, çay konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_027",
      "speaker": "刘梅",
      "zh": "这个是杯子吗？",
      "pinyin": "Zhège shì bēizi ma?",
      "tr": "Bu, bardak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_028",
      "speaker": "张雨桐",
      "zh": "没错，是杯子。",
      "pinyin": "Méicuò, shì bēizi.",
      "tr": "Evet, bu bardak."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_029",
      "speaker": "张乐乐",
      "zh": "杯子呢？",
      "pinyin": "Bēizi ne?",
      "tr": "Bardak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_030",
      "speaker": "售货员",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bardak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_031",
      "speaker": "张伟",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuòhuǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_032",
      "speaker": "刘梅",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuòhuǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_033",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_034",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_035",
      "speaker": "售货员",
      "zh": "这个是钱吗？",
      "pinyin": "Zhège shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_036",
      "speaker": "张伟",
      "zh": "嗯，对，这是钱。",
      "pinyin": "En, duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_037",
      "speaker": "刘梅",
      "zh": "钱呢？",
      "pinyin": "Qián ne?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_038",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_039",
      "speaker": "张乐乐",
      "zh": "这是元吗？",
      "pinyin": "Zhè shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_040",
      "speaker": "售货员",
      "zh": "嗯，对，这是元。",
      "pinyin": "En, duì, zhè shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_041",
      "speaker": "张伟",
      "zh": "元在哪儿？",
      "pinyin": "Yuán zài nǎér?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_043",
      "speaker": "张雨桐",
      "zh": "他要面包和牛奶。",
      "pinyin": "Tā yào miànbāo hé niúnǎi.",
      "tr": "Ekmek ve süt istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC004_045",
      "speaker": "售货员",
      "zh": "好，谢谢你帮我把面包说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ miànbāo shuō qīngchǔ.",
      "tr": "Tamam, ekmek konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_046",
      "speaker": "张伟",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_047",
      "speaker": "刘梅",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC004_048",
      "speaker": "张雨桐",
      "zh": "好，面包这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, miànbāo zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, ekmek kısmı netleşti; devam edelim."
    },
    {
