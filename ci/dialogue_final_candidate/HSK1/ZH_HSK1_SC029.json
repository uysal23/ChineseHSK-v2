  "level": "HSK1",
  "sourceTitleZh": "工作面试",
  "sourceTitleTr": "İş Görüşmesi",
  "sourceMiniAdventureTr": "Zhang kendini ve temel becerilerini iş görüşmesinde tanıtır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC029_001",
      "speaker": "张伟",
      "zh": "张伟来参加工作面试。",
      "pinyin": "Zhāngwěilái cānjiā gōngzuò miànshì.",
      "tr": "Zhang Wei iş görüşmesine geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_002",
      "speaker": "经理",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_003",
      "speaker": "公司职员",
      "zh": "嗯，面试这点就这么办。",
      "pinyin": "En, miànshì zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, iş görüşmesi konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_004",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_006",
      "speaker": "经理",
      "zh": "今天有面试吗？",
      "pinyin": "Jīntiān yǒu miànshì ma?",
      "tr": "Bugün iş görüşmesi var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_007",
      "speaker": "公司职员",
      "zh": "嗯，面试这点就这么办。",
      "pinyin": "En, miànshì zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, iş görüşmesi konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_008",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_010",
      "speaker": "经理",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_011",
      "speaker": "公司职员",
      "zh": "嗯，工作这点就这么办。",
      "pinyin": "En, gōngzuò zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, iş konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_012",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_013",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_014",
      "speaker": "经理",
      "zh": "这是我们的经理。",
      "pinyin": "Zhèshì wǒmen de jīnglǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_015",
      "speaker": "公司职员",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_016",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_017",
      "speaker": "张伟",
      "zh": "嗯，经理这点我也是这么想的。",
      "pinyin": "En, jīnglǐ zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, müdür konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_018",
      "speaker": "经理",
      "zh": "办公室在哪儿？",
      "pinyin": "Bàngōngshì zài nǎér?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_019",
      "speaker": "公司职员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_020",
      "speaker": "张伟",
      "zh": "嗯，办公室这部分我明白了。",
      "pinyin": "En, bàngōngshì zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; ofis kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_021",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把办公室说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ bàngōngshì shuō qīngchǔ.",
      "tr": "Tamam, ofis konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_022",
      "speaker": "经理",
      "zh": "他要介绍自己会做什么。",
      "pinyin": "Tā yào jièshào zìjǐ huì zuò shénme.",
      "tr": "Neler yapabildiğini anlatması gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_023",
      "speaker": "公司职员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_026",
      "speaker": "经理",
      "zh": "嗯，办公室这点就这么办。",
      "pinyin": "En, bàngōngshì zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, ofis konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_027",
      "speaker": "公司职员",
      "zh": "这个是电脑吗？",
      "pinyin": "Zhège shì diànnǎo ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_028",
      "speaker": "张伟",
      "zh": "嗯，对，这是电脑。",
      "pinyin": "En, duì, zhèshì diànnǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_029",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diànnǎo zài nǎér?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_030",
      "speaker": "经理",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_031",
      "speaker": "公司职员",
      "zh": "这是卡吗？",
      "pinyin": "Zhè shì kǎ ma?",
      "tr": "Bu, kart mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_032",
      "speaker": "张伟",
      "zh": "嗯，对，这是卡。",
      "pinyin": "En, duì, zhè shì kǎ.",
      "tr": "Evet, bu kart."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_033",
      "speaker": "张伟",
      "zh": "卡在哪儿？",
      "pinyin": "Kǎ zài nǎér?",
      "tr": "Kart nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_034",
      "speaker": "经理",
      "zh": "你看，卡在这儿。",
      "pinyin": "Nǐ kàn, kǎ zài zhèér.",
      "tr": "Kart burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_035",
      "speaker": "公司职员",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_036",
      "speaker": "张伟",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_037",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_038",
      "speaker": "经理",
      "zh": "好，谢谢你帮我把卡说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ kǎ shuō qīngchǔ.",
      "tr": "Tamam, kart konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_039",
      "speaker": "公司职员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_040",
      "speaker": "张伟",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méiguānxì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_042",
      "speaker": "经理",
      "zh": "好，卡这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, kǎ zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, kart kısmı netleşti; devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_043",
      "speaker": "公司职员",
      "zh": "经理对他的回答很满意。",
      "pinyin": "Jīnglǐ duì tā de huídá hěn mǎnyì.",
      "tr": "Müdür cevaplarından memnun."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_044",
      "speaker": "张伟",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_045",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把经理说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ jīnglǐ shuō qīngchǔ.",
      "tr": "Tamam, müdür konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_046",
      "speaker": "经理",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_047",
      "speaker": "公司职员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_048",
