  "level": "HSK1",
  "sourceTitleZh": "请邻居喝茶",
  "sourceTitleTr": "Komşuya Çay",
  "sourceMiniAdventureTr": "Liu Mei komşuya çay veya su ikram eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC015_001",
      "speaker": "刘梅",
      "zh": "我们请邻居喝茶。",
      "pinyin": "Wǒmen qǐng línjū hēchá.",
      "tr": "Komşuya çay ikram ediyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_002",
      "speaker": "邻居",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_003",
      "speaker": "张伟",
      "zh": "嗯，邻居这点就这么办。",
      "pinyin": "En, línjū zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, komşu konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_006",
      "speaker": "邻居",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_007",
      "speaker": "张伟",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒyào chá, xièxiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_008",
      "speaker": "张乐乐",
      "zh": "嗯，茶这点就这么办。",
      "pinyin": "En, chá zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, çay konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_009",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把茶说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ chá shuō qīngchǔ.",
      "tr": "Tamam, çay konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_010",
      "speaker": "邻居",
      "zh": "你要水吗？",
      "pinyin": "Nǐ yào shuǐ ma?",
      "tr": "Su ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_011",
      "speaker": "张伟",
      "zh": "我要水，谢谢。",
      "pinyin": "Wǒyào shuǐ, xièxiè.",
      "tr": "Su istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_012",
      "speaker": "张乐乐",
      "zh": "嗯，水这点就这么办。",
      "pinyin": "En, shuǐ zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, su konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_013",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把水说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ shuǐ shuō qīngchǔ.",
      "tr": "Tamam, su konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_014",
      "speaker": "邻居",
      "zh": "你要咖啡吗？",
      "pinyin": "Nǐ yào kāfēi ma?",
      "tr": "Kahve ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_015",
      "speaker": "张伟",
      "zh": "我要咖啡，谢谢。",
      "pinyin": "Wǒyào kāfēi, xièxiè.",
      "tr": "Kahve istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_016",
      "speaker": "张乐乐",
      "zh": "嗯，咖啡这点就这么办。",
      "pinyin": "En, kāfēi zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, kahve konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_017",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把咖啡说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ kāfēi shuō qīngchǔ.",
      "tr": "Tamam, kahve konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_018",
      "speaker": "邻居",
      "zh": "你要果汁吗？",
      "pinyin": "Nǐ yào guǒzhī ma?",
      "tr": "Meyve suyu ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_019",
      "speaker": "张伟",
      "zh": "我要果汁，谢谢。",
      "pinyin": "Wǒyào guǒzhī, xièxiè.",
      "tr": "Meyve suyu istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_020",
      "speaker": "张乐乐",
      "zh": "嗯，果汁这点就这么办。",
      "pinyin": "En, guǒzhī zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, meyve suyu konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_021",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把果汁说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ guǒzhī shuō qīngchǔ.",
      "tr": "Tamam, meyve suyu konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_022",
      "speaker": "邻居",
      "zh": "她不知道喝茶还是水。",
      "pinyin": "Tā bù zhīdào hēchá háishì shuǐ.",
      "tr": "Çay mı su mu içeceğine karar veremiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_023",
      "speaker": "张伟",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_026",
      "speaker": "邻居",
      "zh": "嗯，茶这点就这么办。",
      "pinyin": "En, chá zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, çay konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_027",
      "speaker": "张伟",
      "zh": "这是杯子，对吗？",
      "pinyin": "Zhèshì bēizi, duì ma?",
      "tr": "Bu, bardak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_028",
      "speaker": "张乐乐",
      "zh": "没错，是杯子。",
      "pinyin": "Méicuò, shì bēizi.",
      "tr": "Evet, bu bardak."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_029",
      "speaker": "刘梅",
      "zh": "那杯子在哪儿？",
      "pinyin": "Nà bēizi zài nǎér?",
      "tr": "Bardak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_030",
      "speaker": "邻居",
      "zh": "你看，杯子在这儿。",
      "pinyin": "Nǐ kàn, bēizi zài zhèér.",
      "tr": "Bardak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_031",
      "speaker": "张伟",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhèshì wǒmen de línjū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_032",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_033",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_034",
      "speaker": "邻居",
      "zh": "嗯，邻居这点我也是这么想的。",
      "pinyin": "En, línjū zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, komşu konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_035",
      "speaker": "张伟",
      "zh": "这是桌子，对吗？",
      "pinyin": "Zhèshì zhuōzi, duì ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_036",
      "speaker": "张乐乐",
      "zh": "对，就是桌子。",
      "pinyin": "Duì, jiùshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_037",
      "speaker": "刘梅",
      "zh": "那桌子在哪儿？",
      "pinyin": "Nà zhuōzi zài nǎér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_038",
      "speaker": "邻居",
      "zh": "桌子在这儿。",
      "pinyin": "Zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_039",
      "speaker": "张伟",
      "zh": "这是我们的客人。",
      "pinyin": "Zhèshì wǒmen de kèrén.",
      "tr": "Bu bizim misafir."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_041",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_042",
      "speaker": "邻居",
      "zh": "嗯，邻居这点我也是这么想的。",
      "pinyin": "En, línjū zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, komşu konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_043",
      "speaker": "张伟",
      "zh": "她要一杯茶。",
      "pinyin": "Tā yào yībēi chá.",
      "tr": "Bir bardak çay istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_045",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把茶说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ chá shuō qīngchǔ.",
      "tr": "Tamam, çay konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_046",
      "speaker": "邻居",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_047",
      "speaker": "张伟",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_048",
      "speaker": "张乐乐",
      "zh": "好，茶这部分清楚了，我们接着往下聊。",
