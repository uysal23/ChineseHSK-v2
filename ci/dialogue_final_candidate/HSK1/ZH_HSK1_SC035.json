  "sourceTitleZh": "李晨一家来做客",
  "sourceTitleTr": "Li Chen’in Ailesi Geliyor",
  "sourceMiniAdventureTr": "İki aile ilk kez evde birlikte yemek yer ve yakınlaşır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC035_001",
      "speaker": "张伟",
      "zh": "李晨一家来做客。",
      "pinyin": "Lǐchén yījiā lái zuòkè.",
      "tr": "Li Chen’in ailesi misafirliğe geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_003",
      "speaker": "李晨",
      "zh": "嗯，客人这点就这么办。",
      "pinyin": "En, kèrén zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, misafir konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_004",
      "speaker": "李晨妻子",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_006",
      "speaker": "刘梅",
      "zh": "这是我们的客人。",
      "pinyin": "Zhèshì wǒmen de kèrén.",
      "tr": "Bu bizim misafir."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_007",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_008",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_009",
      "speaker": "张伟",
      "zh": "嗯，客人这点我也是这么想的。",
      "pinyin": "En, kèrén zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, misafir konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_011",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_012",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_013",
      "speaker": "张伟",
      "zh": "嗯，家人这点我也是这么想的。",
      "pinyin": "En, jiārén zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, aile konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_015",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_016",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_017",
      "speaker": "张伟",
      "zh": "嗯，朋友这点我也是这么想的。",
      "pinyin": "En, péngyǒu zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, arkadaş konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_018",
      "speaker": "刘梅",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yàofàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_019",
      "speaker": "李晨",
      "zh": "好，谢谢你帮我把饭说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ fàn shuō qīngchǔ.",
      "tr": "Tamam, yemek konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_020",
      "speaker": "李晨妻子",
      "zh": "嗯，饭这点就这么办。",
      "pinyin": "En, fàn zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, yemek konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_021",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把饭说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ fàn shuō qīngchǔ.",
      "tr": "Tamam, yemek konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_022",
      "speaker": "刘梅",
      "zh": "孩子们开始还有一点害羞。",
      "pinyin": "Háizi men kāishǐ háiyǒu yìdiǎn hàixiū.",
      "tr": "Çocuklar başta biraz çekingen."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_024",
      "speaker": "李晨妻子",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_026",
      "speaker": "刘梅",
      "zh": "嗯，饭这点就这么办。",
      "pinyin": "En, fàn zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, yemek konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_027",
      "speaker": "李晨",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_028",
      "speaker": "李晨妻子",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒyào chá, xièxiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_029",
      "speaker": "张伟",
      "zh": "嗯，茶这点就这么办。",
      "pinyin": "En, chá zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, çay konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_030",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把茶说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ chá shuō qīngchǔ.",
      "tr": "Tamam, çay konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_031",
      "speaker": "李晨",
      "zh": "这是桌子吗？",
      "pinyin": "Zhèshì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_032",
      "speaker": "李晨妻子",
      "zh": "嗯，对，这是桌子。",
      "pinyin": "En, duì, zhèshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_033",
      "speaker": "张伟",
      "zh": "桌子呢？",
      "pinyin": "Zhuōzi ne?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_034",
      "speaker": "刘梅",
      "zh": "桌子在这儿。",
      "pinyin": "Zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_035",
      "speaker": "李晨",
      "zh": "那家在哪儿？",
      "pinyin": "Nàjiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_036",
      "speaker": "李晨妻子",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_037",
      "speaker": "张伟",
      "zh": "嗯，桌子这部分我明白了。",
      "pinyin": "En, zhuōzi zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; masa kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_038",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把桌子说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ zhuōzi shuō qīngchǔ.",
      "tr": "Tamam, masa konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_039",
      "speaker": "李晨",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàngāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_040",
      "speaker": "李晨妻子",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒyào dàngāo, xièxiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_041",
      "speaker": "张伟",
      "zh": "嗯，桌子这点就这么办。",
      "pinyin": "En, zhuōzi zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, masa konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_042",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把桌子说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ zhuōzi shuō qīngchǔ.",
      "tr": "Tamam, masa konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_043",
      "speaker": "李晨",
      "zh": "两家人很快聊得很开心。",
      "pinyin": "Liǎngjiā rén hěnkuài liáodé hěn kāixīn.",
      "tr": "İki aile kısa sürede keyifle sohbet ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_044",
      "speaker": "李晨妻子",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_045",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把家人说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ jiārén shuō qīngchǔ.",
      "tr": "Tamam, aile konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_047",
      "speaker": "李晨",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_048",
      "speaker": "李晨妻子",
      "zh": "好，家人这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, jiārén zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, aile kısmı netleşti; devam edelim."
