{
  "naturalizationVersion": 2,
  "status": "FINAL_CANDIDATE",
  "sceneId": "ZH_HSK1_SC041",
  "level": "HSK1",
  "sourceTitleZh": "咪咪去看兽医",
  "sourceTitleTr": "Mimi Veterinerde",
  "sourceMiniAdventureTr": "Mimi yemek yemeyince aile onu veterinere götürür.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC041_001",
      "speaker": "刘梅",
      "zh": "咪咪今天不吃饭。",
      "pinyin": "Mīmī jīntiān bù chīfàn.",
      "tr": "Mimi bugün yemek yemiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_003",
      "speaker": "兽医",
      "zh": "嗯，猫这点就这么办。",
      "pinyin": "En, māo zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, kedi konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_006",
      "speaker": "张伟",
      "zh": "这是猫，对吗？",
      "pinyin": "Zhè shì māo, duì ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_007",
      "speaker": "兽医",
      "zh": "嗯，对，这是猫。",
      "pinyin": "En, duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_008",
      "speaker": "张乐乐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_009",
      "speaker": "刘梅",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_010",
      "speaker": "张伟",
      "zh": "这是我们的兽医。",
      "pinyin": "Zhèshì wǒmen de shòuyī.",
      "tr": "Bu bizim veteriner."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_011",
      "speaker": "兽医",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_013",
      "speaker": "刘梅",
      "zh": "嗯，兽医这点我也是这么想的。",
      "pinyin": "En, shòuyī zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, veteriner konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_014",
      "speaker": "张伟",
      "zh": "这是我们的医生。",
      "pinyin": "Zhèshì wǒmen de yīshēng.",
      "tr": "Bu bizim doktor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_015",
      "speaker": "兽医",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_016",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_017",
      "speaker": "刘梅",
      "zh": "嗯，医生这点我也是这么想的。",
      "pinyin": "En, yīshēng zhèdiǎn wǒ yě shì zhème xiǎng de.",
      "tr": "Evet, doktor konusunda ben de aynı düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_018",
      "speaker": "张伟",
      "zh": "医院在哪儿？",
      "pinyin": "Yīyuàn zài nǎér?",
      "tr": "Hastane nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_019",
      "speaker": "兽医",
      "zh": "你看，医院在那边。",
      "pinyin": "Nǐ kàn, yīyuàn zài nàbiān.",
      "tr": "Hastane şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_020",
      "speaker": "张乐乐",
      "zh": "嗯，医院这部分我明白了。",
      "pinyin": "En, yīyuàn zhèbùfèn wǒ míngbái le.",
      "tr": "Anladım; hastane kısmı şimdi daha net."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_021",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把医院说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ yīyuàn shuō qīngchǔ.",
      "tr": "Tamam, hastane konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_022",
      "speaker": "张伟",
      "zh": "家人有一点担心。",
      "pinyin": "Jiārén yǒu yìdiǎn dānxīn.",
      "tr": "Aile biraz endişeli."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_023",
      "speaker": "兽医",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_026",
      "speaker": "张伟",
      "zh": "嗯，医院这点就这么办。",
      "pinyin": "En, yīyuàn zhèdiǎn jiù zhème bàn.",
      "tr": "Tamam, hastane konusunda böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_027",
      "speaker": "兽医",
      "zh": "这个是药吗？",
      "pinyin": "Zhège shì yào ma?",
      "tr": "Bu, ilaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_028",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是药。",
      "pinyin": "En, duì, zhè shì yào.",
      "tr": "Evet, bu ilaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_029",
      "speaker": "刘梅",
      "zh": "药呢？",
      "pinyin": "Yào ne?",
      "tr": "Ilaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_030",
      "speaker": "张伟",
      "zh": "你看，药在这儿。",
      "pinyin": "Nǐ kàn, yào zài zhèér.",
      "tr": "Ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_031",
      "speaker": "兽医",
      "zh": "你要水吗？",
      "pinyin": "Nǐ yào shuǐ ma?",
      "tr": "Su ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_032",
      "speaker": "张乐乐",
      "zh": "我要水，谢谢。",
      "pinyin": "Wǒyào shuǐ, xièxiè.",
      "tr": "Su istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_033",
      "speaker": "刘梅",
      "zh": "嗯，水这点就这么办。",
      "pinyin": "En, shuǐ zhèdiǎn jiù zhème bàn.",
