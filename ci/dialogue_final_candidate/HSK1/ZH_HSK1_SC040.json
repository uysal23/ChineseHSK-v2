    {
      "id": "DLG_ZH_HSK1_SC040_078",
      "speaker": "刘梅",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
