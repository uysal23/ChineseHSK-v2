    {
      "id": "DLG_ZH_HSK1_SC040_041",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_042",
      "speaker": "刘梅",
      "zh": "好，谢谢你帮我把名字说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ míngzì shuō qīngchǔ.",
      "tr": "Tamam, isim konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_043",
      "speaker": "快递员",
      "zh": "他们把包裹送给邻居。",
      "pinyin": "Tāmen bǎ bāoguǒ sònggěi línjū.",
      "tr": "Paketi komşuya veriyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_044",
      "speaker": "邻居",
      "zh": "太好了！",
      "pinyin": "Tàihǎole!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_045",
      "speaker": "张伟",
      "zh": "好，谢谢你帮我把包裹说清楚。",
      "pinyin": "Hǎo, xièxiè nǐ bāng wǒ bǎ bāoguǒ shuō qīngchǔ.",
      "tr": "Tamam, paket / kargo konusunu netleştirmeme yardım ettiğin için teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_047",
      "speaker": "快递员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_048",
      "speaker": "邻居",
      "zh": "好，包裹这部分清楚了，我们接着往下聊。",
      "pinyin": "Hǎo, bāoguǒ zhèbùfèn qīngchǔ le, wǒmen jiēzhe wǎngxià liáo.",
      "tr": "Tamam, paket / kargo kısmı netleşti; devam edelim."
