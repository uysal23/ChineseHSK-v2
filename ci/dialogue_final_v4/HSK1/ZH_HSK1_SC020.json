      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_084",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_085",
      "speaker": "张伟",
      "zh": "这个是椅子吗？",
      "pinyin": "Zhège shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_086",
      "speaker": "刘梅",
      "zh": "对，就是椅子。",
      "pinyin": "Duì, jiùshì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_087",
      "speaker": "张雨桐",
      "zh": "椅子呢？",
      "pinyin": "Yǐzi ne?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_088",
      "speaker": "张乐乐",
      "zh": "椅子在这儿。",
      "pinyin": "Yǐzi zài zhèér.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_089",
      "speaker": "张伟",
      "zh": "这是桌子吗？",
      "pinyin": "Zhèshì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_090",
      "speaker": "刘梅",
      "zh": "对，就是桌子。",
      "pinyin": "Duì, jiùshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_091",
      "speaker": "张雨桐",
      "zh": "桌子呢？",
      "pinyin": "Zhuōzi ne?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_092",
      "speaker": "张乐乐",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_093",
      "speaker": "张伟",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_094",
      "speaker": "刘梅",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_095",
      "speaker": "张雨桐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_096",
      "speaker": "张乐乐",
      "zh": "现在放心多了。",
      "pinyin": "Xiànzài fàngxīn duō le.",
      "tr": "Şimdi çok daha rahatız."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_097",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Evet, tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_098",
      "speaker": "刘梅",
      "zh": "都好了吗？",
      "pinyin": "Dōu hǎolema?",
      "tr": "Her şey tamam mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_099",
      "speaker": "张雨桐",
      "zh": "都好了。",
      "pinyin": "Dōu hǎo le.",
      "tr": "Her şey tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_100",
      "speaker": "张乐乐",
      "zh": "走吧。",
      "pinyin": "Zǒu ba.",
      "tr": "Hadi gidelim."
    }
  ]
