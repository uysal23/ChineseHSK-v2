{
  "naturalizationVersion": 4,
  "status": "FINAL",
  "sceneId": "ZH_HSK1_SC020",
  "level": "HSK1",
  "sceneCategory": "pet",
  "sourceTitleZh": "全家福",
  "sourceTitleTr": "Aile Fotoğrafı",
  "sourceMiniAdventureTr": "Aile ilk fotoğrafını çekmeye çalışır; Mimi sürekli yer değiştirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC020_001",
      "speaker": "张伟",
      "zh": "我们要拍全家福。",
      "pinyin": "Wǒmen yào pāi quánjiāfú.",
      "tr": "Aile fotoğrafı çekeceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_006",
      "speaker": "刘梅",
      "zh": "这是照片吗？",
      "pinyin": "Zhèshì zhàopiān ma?",
      "tr": "Bu, fotoğraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_007",
      "speaker": "张雨桐",
      "zh": "没错，是照片。",
      "pinyin": "Méicuò, shì zhàopiān.",
      "tr": "Evet, bu fotoğraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_008",
      "speaker": "张乐乐",
      "zh": "照片在哪儿？",
      "pinyin": "Zhàopiān zài nǎér?",
      "tr": "Fotoğraf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_009",
      "speaker": "张伟",
      "zh": "你看，照片在这儿。",
      "pinyin": "Nǐ kàn, zhàopiān zài zhèér.",
      "tr": "Fotoğraf burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_011",
      "speaker": "张雨桐",
      "zh": "你好，我想问问这只猫。",
      "pinyin": "Nǐhǎo, wǒ xiǎng wènwèn zhè zhǐ māo.",
      "tr": "Merhaba, bu kedi hakkında sormak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_012",
      "speaker": "张乐乐",
      "zh": "好，先看看它怎么了。",
      "pinyin": "Hǎo, xiān kànkàn tā zěnme le.",
      "tr": "Tamam, önce ne olduğuna bakalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_013",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Evet, tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_014",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_015",
      "speaker": "张雨桐",
      "zh": "对，就是猫。",
      "pinyin": "Duì, jiùshì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_016",
      "speaker": "张乐乐",
      "zh": "猫呢？",
      "pinyin": "Māo ne?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_017",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_018",
      "speaker": "刘梅",
      "zh": "这个是椅子吗？",
      "pinyin": "Zhège shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_019",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是椅子。",
      "pinyin": "En, duì, zhèshì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_020",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎér?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_021",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_022",
      "speaker": "刘梅",
      "zh": "咪咪一直换地方。",
      "pinyin": "Mīmī yìzhí huàn dìfāng.",
      "tr": "Mimi sürekli yer değiştiriyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_027",
      "speaker": "张雨桐",
      "zh": "这个是桌子吗？",
      "pinyin": "Zhège shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_028",
      "speaker": "张乐乐",
      "zh": "没错，是桌子。",
      "pinyin": "Méicuò, shì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_029",
      "speaker": "张伟",
      "zh": "桌子呢？",
      "pinyin": "Zhuōzi ne?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_030",
      "speaker": "刘梅",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_031",
      "speaker": "张雨桐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_032",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_033",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_035",
