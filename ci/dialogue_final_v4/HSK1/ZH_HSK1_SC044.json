    {
      "id": "DLG_ZH_HSK1_SC044_021",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_022",
      "speaker": "老师",
      "zh": "老师请他介绍家人。",
      "pinyin": "Lǎoshī qǐng tā jièshào jiārén.",
      "tr": "Öğretmen ailesini tanıtmasını istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_023",
      "speaker": "同学",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_026",
      "speaker": "老师",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_027",
      "speaker": "同学",
      "zh": "老师也在教室里。",
      "pinyin": "Lǎoshī yě zài jiàoshì lǐ.",
      "tr": "Öğretmen de sınıfta."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_028",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_029",
      "speaker": "张乐乐",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
