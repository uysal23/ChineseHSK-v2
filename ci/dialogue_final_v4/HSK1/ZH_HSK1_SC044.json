  "sourceTitleZh": "乐乐的全家福",
  "sourceTitleTr": "Lele’nin Resmi",
  "sourceMiniAdventureTr": "Lele okulda çizdiği aile resmini sınıfa anlatır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC044_001",
      "speaker": "张乐乐",
      "zh": "乐乐画了全家福。",
      "pinyin": "Lèlè huà le quánjiāfú.",
      "tr": "Lele bir aile resmi çizdi."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_002",
      "speaker": "老师",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_003",
      "speaker": "同学",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_004",
      "speaker": "同学",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_006",
      "speaker": "老师",
      "zh": "这是画吗？",
      "pinyin": "Zhè shì huà ma?",
      "tr": "Bu, resim mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_007",
      "speaker": "同学",
      "zh": "对，就是画。",
      "pinyin": "Duì, jiùshì huà.",
      "tr": "Evet, bu resim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_008",
      "speaker": "同学",
      "zh": "画呢？",
      "pinyin": "Huà ne?",
      "tr": "Resim nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_009",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Resim burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_010",
      "speaker": "老师",
      "zh": "这是我们的家人。",
      "pinyin": "Zhèshì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_011",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_012",
      "speaker": "同学",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_013",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_014",
      "speaker": "老师",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhèshì wǒmen de māmā.",
      "tr": "Bu bizim anne."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_015",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_016",
      "speaker": "同学",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_017",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
