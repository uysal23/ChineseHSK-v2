      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_031",
      "speaker": "同学",
      "zh": "这是我们班的学生。",
      "pinyin": "Zhèshì wǒmen bān de xuéshēng.",
      "tr": "Bu bizim sınıftan bir öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_032",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
