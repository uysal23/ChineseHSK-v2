    {
      "id": "DLG_ZH_HSK1_SC044_035",
      "speaker": "同学",
      "zh": "这是图片吗？",
      "pinyin": "Zhèshì túpiàn ma?",
      "tr": "Bu, resim / görsel mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_036",
      "speaker": "同学",
      "zh": "没错，是图片。",
      "pinyin": "Méicuò, shì túpiàn.",
      "tr": "Evet, bu resim / görsel."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_037",
      "speaker": "张乐乐",
      "zh": "那图片在哪儿？",
      "pinyin": "Nà túpiàn zài nǎér?",
      "tr": "Resim / görsel nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_038",
      "speaker": "老师",
      "zh": "图片在这儿。",
      "pinyin": "Túpiàn zài zhèér.",
      "tr": "Resim / görsel burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_039",
      "speaker": "同学",
      "zh": "学校呢？",
      "pinyin": "Xuéxiào ne?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_040",
      "speaker": "同学",
      "zh": "学校在那边。",
      "pinyin": "Xuéxiào zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_041",
      "speaker": "张乐乐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_042",
      "speaker": "老师",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_043",
      "speaker": "同学",
      "zh": "乐乐高兴地介绍了大家。",
      "pinyin": "Lèlè gāoxìng dì jièshào le dàjiā.",
      "tr": "Lele herkesi sevinçle tanıtıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_044",
      "speaker": "同学",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_046",
      "speaker": "老师",
      "zh": "不客气。",
      "pinyin": "Bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_047",
      "speaker": "同学",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
