  "sceneCategory": "pet",
  "sourceTitleZh": "咪咪在柜子旁边",
  "sourceTitleTr": "Mimi Dolapta",
  "sourceMiniAdventureTr": "Mimi mutfak dolabının yanında bulunur ve çocuklar rahatlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC013_001",
      "speaker": "张乐乐",
      "zh": "我们还在找咪咪。",
      "pinyin": "Wǒmen hái zài zhǎo mīmī.",
      "tr": "Mimi’yi hâlâ arıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_004",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_006",
      "speaker": "刘梅",
      "zh": "这个是猫吗？",
      "pinyin": "Zhège shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_007",
      "speaker": "张雨桐",
      "zh": "没错，是猫。",
      "pinyin": "Méicuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_008",
      "speaker": "张伟",
      "zh": "那猫在哪儿？",
      "pinyin": "Nàmāo zài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_009",
      "speaker": "张乐乐",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_010",
      "speaker": "刘梅",
      "zh": "这是柜子吗？",
      "pinyin": "Zhèshì guìzi ma?",
      "tr": "Bu, dolap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_011",
      "speaker": "张雨桐",
      "zh": "对，就是柜子。",
      "pinyin": "Duì, jiùshì guìzi.",
      "tr": "Evet, bu dolap."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_012",
      "speaker": "张伟",
      "zh": "柜子在哪儿？",
      "pinyin": "Guìzi zài nǎér?",
      "tr": "Dolap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_013",
      "speaker": "张乐乐",
      "zh": "你看，柜子在这儿。",
      "pinyin": "Nǐ kàn, guìzi zài zhèér.",
      "tr": "Dolap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_014",
      "speaker": "刘梅",
      "zh": "厨房在哪儿？",
      "pinyin": "Chúfáng zài nǎér?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_015",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_016",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_017",
      "speaker": "张乐乐",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_018",
      "speaker": "刘梅",
      "zh": "这个是桌子吗？",
      "pinyin": "Zhège shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_019",
      "speaker": "张雨桐",
      "zh": "没错，是桌子。",
      "pinyin": "Méicuò, shì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_020",
      "speaker": "张伟",
      "zh": "桌子呢？",
      "pinyin": "Zhuōzi ne?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_021",
      "speaker": "张乐乐",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_022",
      "speaker": "刘梅",
      "zh": "厨房里有声音。",
      "pinyin": "Chúfáng lǐ yǒu shēngyīn.",
      "tr": "Mutfaktan bir ses geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_027",
      "speaker": "张雨桐",
      "zh": "这个是椅子吗？",
      "pinyin": "Zhège shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_028",
      "speaker": "张伟",
      "zh": "没错，是椅子。",
      "pinyin": "Méicuò, shì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_029",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎér?",
      "tr": "Sandalye nerede?"
