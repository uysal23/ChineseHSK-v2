  "sourceTitleZh": "乐乐的第一天",
  "sourceTitleTr": "Lele’nin İlkokulu",
  "sourceMiniAdventureTr": "Lele annesinden ayrılmak istemez; öğretmen onu rahatlatır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC024_001",
      "speaker": "张乐乐",
      "zh": "乐乐第一天上小学。",
      "pinyin": "Lèlè dìyītiān shàng xiǎoxué.",
      "tr": "Lele’nin ilkokuldaki ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_003",
      "speaker": "老师",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_004",
      "speaker": "同学",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_006",
      "speaker": "刘梅",
      "zh": "学校呢？",
      "pinyin": "Xuéxiào ne?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_007",
      "speaker": "老师",
      "zh": "学校在那边。",
      "pinyin": "Xuéxiào zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_008",
      "speaker": "同学",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_009",
      "speaker": "张乐乐",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_010",
      "speaker": "刘梅",
      "zh": "老师也在教室里。",
      "pinyin": "Lǎoshī yě zài jiàoshì lǐ.",
      "tr": "Öğretmen de sınıfta."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_011",
      "speaker": "老师",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_012",
      "speaker": "同学",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_013",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_014",
      "speaker": "刘梅",
      "zh": "这是我们班的学生。",
      "pinyin": "Zhèshì wǒmen bān de xuéshēng.",
      "tr": "Bu bizim sınıftan bir öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_015",
      "speaker": "老师",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_016",
      "speaker": "同学",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_017",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_018",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhèshì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_019",
      "speaker": "老师",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_020",
      "speaker": "同学",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_021",
      "speaker": "张乐乐",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_022",
      "speaker": "刘梅",
      "zh": "他不想和妈妈分开。",
      "pinyin": "Tā bùxiǎng hé māmā fēnkāi.",
      "tr": "Annesinden ayrılmak istemiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_023",
      "speaker": "老师",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_024",
      "speaker": "同学",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_027",
      "speaker": "老师",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhèshì wǒmen de māmā.",
      "tr": "Bu bizim anne."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_028",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_029",
      "speaker": "张乐乐",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_030",
      "speaker": "刘梅",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_031",
      "speaker": "老师",
      "zh": "那教室在哪儿？",
      "pinyin": "Nà jiàoshì zài nǎér?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_032",
      "speaker": "同学",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_033",
      "speaker": "张乐乐",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_035",
      "speaker": "老师",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_036",
      "speaker": "同学",
      "zh": "嗯，对，这是门。",
      "pinyin": "En, duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_037",
      "speaker": "张乐乐",
      "zh": "那门在哪儿？",
      "pinyin": "Nàmén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_038",
      "speaker": "刘梅",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_039",
      "speaker": "老师",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhèshì wǒmen de péngyǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_040",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_041",
      "speaker": "张乐乐",
      "zh": "以后一起学习吧。",
      "pinyin": "Yǐhòu yìqǐ xuéxí ba.",
      "tr": "Bundan sonra birlikte çalışalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_042",
      "speaker": "刘梅",
      "zh": "好啊。",
      "pinyin": "Hǎo a.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_043",
      "speaker": "老师",
      "zh": "老师让他放心。",
      "pinyin": "Lǎoshī ràng tā fàngxīn.",
      "tr": "Öğretmen onu rahatlatıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_044",
      "speaker": "同学",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_047",
      "speaker": "老师",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
