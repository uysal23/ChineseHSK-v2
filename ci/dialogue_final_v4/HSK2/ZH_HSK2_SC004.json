{
  "naturalizationVersion": 4,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC004",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "乐乐没赶上校车",
  "sourceTitleTr": "Lele Okul Servisini Kaçırıyor",
  "sourceMiniAdventureTr": "Lele geç kalır; komşu aileye yardım eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC004_001",
      "speaker": "张乐乐",
      "zh": "校车已经走了。",
      "pinyin": "Xiàochē yǐjīng zǒu le.",
      "tr": "Okul servisi çoktan gitti."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_003",
      "speaker": "邻居",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_004",
      "speaker": "张乐乐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_005",
      "speaker": "刘梅",
      "zh": "今天差一点迟到。",
      "pinyin": "Jīntiān chàyìdiǎn chídào.",
      "tr": "Bugün neredeyse geç kalıyordum."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_006",
      "speaker": "邻居",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_007",
      "speaker": "张乐乐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_008",
      "speaker": "刘梅",
      "zh": "你看，这个校车在这儿。",
      "pinyin": "Nǐ kàn, zhège xiàochē zài zhèér.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_009",
      "speaker": "邻居",
      "zh": "好，校车这点我记住了。",
      "pinyin": "Hǎo, xiàochē zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, okul servisi konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_010",
      "speaker": "张乐乐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_011",
      "speaker": "刘梅",
      "zh": "我们先等一下吧。",
      "pinyin": "Wǒmen xiān děng yīxià ba.",
      "tr": "Önce beklemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_012",
      "speaker": "邻居",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_013",
      "speaker": "张乐乐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_014",
      "speaker": "刘梅",
      "zh": "邻居今天也来了。",
      "pinyin": "Línjū jīntiān yě lái le.",
      "tr": "Komşu bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_015",
      "speaker": "邻居",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_017",
      "speaker": "刘梅",
      "zh": "乐乐今天要迟到了。",
      "pinyin": "Lèlè jīntiān yào chídào le.",
      "tr": "Lele bugün geç kalacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_018",
      "speaker": "邻居",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC004_019",
      "speaker": "张乐乐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_020",
      "speaker": "刘梅",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_021",
      "speaker": "邻居",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_022",
      "speaker": "张乐乐",
      "zh": "快一点，不然来不及了。",
      "pinyin": "Kuài yìdiǎn, bùrán láibùjí le.",
      "tr": "Biraz hızlı ol, yoksa yetişemeyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_024",
      "speaker": "邻居",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_025",
      "speaker": "张乐乐",
      "zh": "我们先打电话一下吧。",
      "pinyin": "Wǒmen xiān dǎdiànhuà yīxià ba.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_027",
      "speaker": "邻居",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_028",
      "speaker": "张乐乐",
      "zh": "今天早上大家都很忙。",
      "pinyin": "Jīntiān zǎoshàng dàjiā dōu hěn máng.",
      "tr": "Bu sabah herkes çok meşgul."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_030",
      "speaker": "邻居",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_031",
      "speaker": "张乐乐",
      "zh": "我们先帮忙一下吧。",
      "pinyin": "Wǒmen xiān bāngmáng yīxià ba.",
      "tr": "Önce yardım etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_032",
      "speaker": "刘梅",
      "zh": "对，打电话这点你说得对。",
      "pinyin": "Duì, dǎdiànhuà zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, telefon etmek konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_033",
      "speaker": "邻居",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_034",
      "speaker": "张乐乐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_036",
      "speaker": "邻居",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_037",
      "speaker": "张乐乐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_039",
      "speaker": "邻居",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_042",
      "speaker": "邻居",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_045",
      "speaker": "邻居",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_046",
      "speaker": "张乐乐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_048",
      "speaker": "邻居",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_049",
      "speaker": "张乐乐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_051",
      "speaker": "邻居",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "En, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_054",
      "speaker": "邻居",
      "zh": "今天差一点迟到。",
      "pinyin": "Jīntiān chàyìdiǎn chídào.",
      "tr": "Bugün neredeyse geç kalıyordum."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_055",
      "speaker": "张乐乐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_056",
      "speaker": "刘梅",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_057",
      "speaker": "邻居",
      "zh": "嗯，校车这点确实很实用。",
      "pinyin": "En, xiàochē zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, okul servisi gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_058",
      "speaker": "张乐乐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_059",
      "speaker": "刘梅",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_060",
      "speaker": "邻居",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_061",
      "speaker": "张乐乐",
      "zh": "我觉得校车也很重要。",
      "pinyin": "Wǒ juéde xiàochē yě hěn zhòngyào.",
      "tr": "Bence okul servisi de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_063",
      "speaker": "邻居",
      "zh": "嗯，来不及这部分现在清楚多了。",
      "pinyin": "En, láibùjí zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, yetişememek kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_064",
      "speaker": "张乐乐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_065",
      "speaker": "刘梅",
      "zh": "那要不要先等一下？",
      "pinyin": "Nàyào búyào xiān děng yīxià?",
      "tr": "O zaman önce “beklemek” kısmını ele alalım mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC004_066",
      "speaker": "邻居",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_067",
      "speaker": "张乐乐",
      "zh": "嗯，打电话这点确实很实用。",
      "pinyin": "En, dǎdiànhuà zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, telefon etmek gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_068",
      "speaker": "刘梅",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_069",
      "speaker": "邻居",
      "zh": "我觉得邻居也很重要。",
      "pinyin": "Wǒ juéde línjū yě hěn zhòngyào.",
      "tr": "Bence komşu de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_070",
      "speaker": "张乐乐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_071",
      "speaker": "刘梅",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_072",
      "speaker": "邻居",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_073",
      "speaker": "张乐乐",
      "zh": "嗯，校车这部分现在清楚多了。",
