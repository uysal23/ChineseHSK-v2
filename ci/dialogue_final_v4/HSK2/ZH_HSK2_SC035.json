{
  "naturalizationVersion": 4,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC035",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "大家都喜欢刘梅做的点心",
  "sourceTitleTr": "Liu Mei’nin Hamur İşi Çok Beğeniliyor",
  "sourceMiniAdventureTr": "Komşular Liu Mei’den daha fazla sipariş istemeye başlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC035_001",
      "speaker": "刘梅",
      "zh": "大家都喜欢刘梅做的点心。",
      "pinyin": "Dàjiā dōu xǐhuān liúméi zuò de diǎnxīn.",
      "tr": "Herkes Liu Mei’nin yaptığı hamur işlerini seviyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_002",
      "speaker": "邻居",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_003",
      "speaker": "张伟",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_004",
      "speaker": "刘梅",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_005",
      "speaker": "邻居",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu atıştırmalık / hamur işi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_006",
      "speaker": "张伟",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_008",
      "speaker": "邻居",
      "zh": "我们先卖一下吧。",
      "pinyin": "Wǒmen xiānmài yīxià ba.",
      "tr": "Önce satmak."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_009",
      "speaker": "张伟",
      "zh": "好，卖这点我记住了。",
      "pinyin": "Hǎo, mài zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, satmak konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_011",
      "speaker": "邻居",
      "zh": "我们先买一下吧。",
      "pinyin": "Wǒmen xiānmǎi yīxià ba.",
      "tr": "Önce satın almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_012",
      "speaker": "张伟",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_014",
      "speaker": "邻居",
      "zh": "这个真的很好吃。",
      "pinyin": "Zhège zhēnde hěn hǎochī.",
      "tr": "Bu gerçekten çok lezzetli."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_015",
      "speaker": "张伟",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_017",
      "speaker": "邻居",
      "zh": "已经有人问可不可以买了。",
      "pinyin": "Yǐjīng yǒurén wèn kěbùkěyǐ mǎi le.",
      "tr": "Artık satın alıp alamayacaklarını soranlar var."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC035_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_020",
      "speaker": "邻居",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_022",
      "speaker": "刘梅",
      "zh": "顾客今天也来了。",
      "pinyin": "Gùkè jīntiān yě lái le.",
      "tr": "Müşteri bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_023",
      "speaker": "邻居",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_024",
      "speaker": "张伟",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_025",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu pasta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_026",
      "speaker": "邻居",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_027",
      "speaker": "张伟",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_028",
      "speaker": "刘梅",
      "zh": "邻居今天也来了。",
      "pinyin": "Línjū jīntiān yě lái le.",
      "tr": "Komşu bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_029",
      "speaker": "邻居",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_031",
      "speaker": "刘梅",
      "zh": "你看，这个订单在这儿。",
      "pinyin": "Nǐ kàn, zhège dìngdān zài zhèér.",
      "tr": "Bu sipariş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_032",
      "speaker": "邻居",
      "zh": "对，蛋糕这点你说得对。",
      "pinyin": "Duì, dàngāo zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, pasta konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_035",
      "speaker": "邻居",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_036",
      "speaker": "张伟",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_038",
      "speaker": "邻居",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_039",
      "speaker": "张伟",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_041",
      "speaker": "邻居",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_042",
      "speaker": "张伟",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_044",
      "speaker": "邻居",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_047",
      "speaker": "邻居",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_048",
      "speaker": "张伟",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_050",
      "speaker": "邻居",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_051",
      "speaker": "张伟",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_053",
      "speaker": "邻居",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_054",
      "speaker": "张伟",
      "zh": "你看，这个点心在这儿。",
      "pinyin": "Nǐ kàn, zhège diǎnxīn zài zhèér.",
      "tr": "Bu atıştırmalık / hamur işi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_055",
      "speaker": "刘梅",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_056",
      "speaker": "邻居",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_057",
      "speaker": "张伟",
      "zh": "嗯，卖这点确实很实用。",
      "pinyin": "En, mài zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, satmak gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_059",
      "speaker": "邻居",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_060",
      "speaker": "张伟",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_061",
      "speaker": "刘梅",
      "zh": "我觉得先卖一下比较好。",
      "pinyin": "Wǒ juéde xiānmài yīxià bǐjiào hǎo.",
      "tr": "Bence önce “satmak” kısmını ele almak daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_062",
      "speaker": "邻居",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_063",
      "speaker": "张伟",
      "zh": "嗯，顾客这部分现在清楚多了。",
      "pinyin": "En, gùkè zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, müşteri kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_064",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_065",
      "speaker": "邻居",
      "zh": "那要不要先买一下？",
      "pinyin": "Nàyào búyào xiānmǎi yīxià?",
      "tr": "O zaman önce “satın almak” kısmını ele alalım mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC035_066",
      "speaker": "张伟",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_067",
      "speaker": "刘梅",
      "zh": "嗯，蛋糕这点确实很实用。",
      "pinyin": "En, dàngāo zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, pasta gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_068",
      "speaker": "邻居",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_069",
      "speaker": "张伟",
      "zh": "我觉得好吃也很重要。",
      "pinyin": "Wǒ juéde hǎochī yě hěn zhòngyào.",
      "tr": "Bence lezzetli de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_071",
      "speaker": "邻居",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_072",
      "speaker": "张伟",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC035_073",
      "speaker": "刘梅",
      "zh": "嗯，卖这部分现在清楚多了。",
      "pinyin": "En, mài zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, satmak kısmı şimdi çok daha net."
