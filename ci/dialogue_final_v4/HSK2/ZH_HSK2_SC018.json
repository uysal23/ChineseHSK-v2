{
  "naturalizationVersion": 4,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC018",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "忘在公交车上的包",
  "sourceTitleTr": "Otobüste Unutulan Çanta",
  "sourceMiniAdventureTr": "Yutong çantasını otobüste unutur ve kayıp eşya bürosuna gider.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC018_001",
      "speaker": "张雨桐",
      "zh": "我的包忘在公交车上了。",
      "pinyin": "Wǒ de bāowàng zài gōngjiāochē shàng le.",
      "tr": "Çantamı otobüste unuttum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_003",
      "speaker": "工作人员",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_005",
      "speaker": "刘梅",
      "zh": "我的包好像丢了。",
      "pinyin": "Wǒ de bāo hǎoxiàng diū le.",
      "tr": "Sanırım çantam kayboldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_006",
      "speaker": "工作人员",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_008",
      "speaker": "刘梅",
      "zh": "我们去失物招领处问问。",
      "pinyin": "Wǒmen qù shīwùzhāolǐng chù wènwèn.",
      "tr": "Kayıp eşya bürosuna gidip soralım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_009",
      "speaker": "工作人员",
      "zh": "好，失物招领处这点我记住了。",
      "pinyin": "Hǎo, shīwùzhāolǐng chù zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, kayıp eşya bürosu konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_010",
      "speaker": "张雨桐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_011",
      "speaker": "刘梅",
      "zh": "里面还有东西。",
      "pinyin": "Lǐmiàn háiyǒu dōngxī.",
      "tr": "İçinde hâlâ bir şeyler var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_012",
      "speaker": "工作人员",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_014",
      "speaker": "刘梅",
      "zh": "你喜欢什么颜色？",
      "pinyin": "Nǐ xǐhuān shénme yánsè?",
      "tr": "Hangi rengi seviyorsun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC018_015",
      "speaker": "工作人员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_017",
      "speaker": "刘梅",
      "zh": "里面有书和钥匙。",
      "pinyin": "Lǐmiàn yǒushū hé yàoshi.",
      "tr": "İçinde kitap ve anahtar var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_018",
      "speaker": "工作人员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC018_019",
      "speaker": "张雨桐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_020",
      "speaker": "刘梅",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_021",
      "speaker": "工作人员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_022",
      "speaker": "张雨桐",
      "zh": "我们先说明一下吧。",
      "pinyin": "Wǒmen xiān shuōmíng yīxià ba.",
      "tr": "Önce tarif etmek / açıklamak."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_024",
      "speaker": "工作人员",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_025",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_027",
      "speaker": "工作人员",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_028",
      "speaker": "张雨桐",
      "zh": "我终于找到了。",
      "pinyin": "Wǒ zhōngyú zhǎodào le.",
      "tr": "Sonunda buldum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_030",
      "speaker": "工作人员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_031",
      "speaker": "张雨桐",
      "zh": "我们先打电话一下吧。",
      "pinyin": "Wǒmen xiān dǎdiànhuà yīxià ba.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_032",
      "speaker": "刘梅",
      "zh": "对，包这点你说得对。",
      "pinyin": "Duì, bāo zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, çanta konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_033",
      "speaker": "工作人员",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_036",
      "speaker": "工作人员",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_039",
      "speaker": "工作人员",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_042",
      "speaker": "工作人员",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_045",
      "speaker": "工作人员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_048",
      "speaker": "工作人员",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_051",
      "speaker": "工作人员",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_054",
      "speaker": "工作人员",
      "zh": "我的包好像丢了。",
      "pinyin": "Wǒ de bāo hǎoxiàng diū le.",
      "tr": "Sanırım çantam kayboldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_055",
      "speaker": "张雨桐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_056",
      "speaker": "刘梅",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_057",
      "speaker": "工作人员",
      "zh": "嗯，失物招领处这点确实很实用。",
      "pinyin": "En, shīwùzhāolǐng chù zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, kayıp eşya bürosu gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_058",
      "speaker": "张雨桐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_059",
      "speaker": "刘梅",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_060",
      "speaker": "工作人员",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_061",
      "speaker": "张雨桐",
      "zh": "我觉得失物招领处也很重要。",
      "pinyin": "Wǒ juéde shīwùzhāolǐng chù yě hěn zhòngyào.",
      "tr": "Bence kayıp eşya bürosu de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_063",
      "speaker": "工作人员",
      "zh": "嗯，说明这部分现在清楚多了。",
      "pinyin": "En, shuōmíng zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, tarif etmek / açıklamak kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_064",
      "speaker": "张雨桐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_065",
      "speaker": "刘梅",
      "zh": "那里面呢？",
      "pinyin": "Nà lǐmiàn ne?",
      "tr": "Peki içinde?"
    },
    {
      "id": "DLG_ZH_HSK2_SC018_066",
      "speaker": "工作人员",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_067",
      "speaker": "张雨桐",
      "zh": "嗯，包这点确实很实用。",
      "pinyin": "En, bāo zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, çanta gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_068",
      "speaker": "刘梅",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_069",
      "speaker": "工作人员",
      "zh": "我觉得颜色也很重要。",
      "pinyin": "Wǒ juéde yánsè yě hěn zhòngyào.",
      "tr": "Bence renk de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_070",
      "speaker": "张雨桐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_071",
      "speaker": "刘梅",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_072",
      "speaker": "工作人员",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_073",
