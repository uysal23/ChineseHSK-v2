{
  "naturalizationVersion": 4,
  "status": "FINAL",
  "sceneId": "ZH_HSK2_SC030",
  "level": "HSK2",
  "sceneCategory": "other",
  "sourceTitleZh": "周末逛市中心",
  "sourceTitleTr": "Hafta Sonu Kasaba Turu",
  "sourceMiniAdventureTr": "Aile kasabanın banka, postane ve park gibi yerlerini gezer.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC030_001",
      "speaker": "张伟",
      "zh": "周末我们去市中心看看。",
      "pinyin": "Zhōumò wǒmen qù shìzhōngxīn kànkàn.",
      "tr": "Hafta sonu şehir merkezini gezelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqíng bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_003",
      "speaker": "张乐乐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkàn zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_005",
      "speaker": "张伟",
      "zh": "银行离这里不远。",
      "pinyin": "Yínháng lí zhèlǐ bùyuǎn.",
      "tr": "Banka buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_006",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_007",
      "speaker": "张乐乐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_008",
      "speaker": "张雨桐",
      "zh": "邮局离这里不远。",
      "pinyin": "Yóujú lí zhèlǐ bùyuǎn.",
      "tr": "Postane buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_009",
      "speaker": "张伟",
      "zh": "好，邮局这点我记住了。",
      "pinyin": "Hǎo, yóujú zhèdiǎn wǒ jìzhù le.",
      "tr": "Tamam, postane konusunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_011",
      "speaker": "张乐乐",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bùyuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_012",
      "speaker": "张雨桐",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_014",
      "speaker": "刘梅",
      "zh": "市中心离这里不远。",
      "pinyin": "Shìzhōngxīn lí zhèlǐ bùyuǎn.",
      "tr": "Şehir merkezi buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_017",
      "speaker": "张伟",
      "zh": "银行离邮局远不远？",
      "pinyin": "Yínháng lí yóujú yuǎn bùyuǎn?",
      "tr": "Banka postaneden uzak mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC030_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC030_019",
      "speaker": "张乐乐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān biézháojí, wǒmen xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_020",
      "speaker": "张雨桐",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_022",
      "speaker": "刘梅",
      "zh": "这个距离不算远。",
      "pinyin": "Zhège jùlí bùsuàn yuǎn.",
      "tr": "Bu mesafe çok uzak sayılmaz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_024",
      "speaker": "张雨桐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_025",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu şehir burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_027",
      "speaker": "张乐乐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_028",
      "speaker": "张雨桐",
      "zh": "这个地图在这儿。",
      "pinyin": "Zhège dìtú zài zhèér.",
      "tr": "Bu harita burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_031",
      "speaker": "张乐乐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_032",
      "speaker": "张雨桐",
      "zh": "对，城市这点你说得对。",
      "pinyin": "Duì, chéngshì zhèdiǎn nǐ shuōdéduì.",
      "tr": "Evet, şehir konusunda haklısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_035",
      "speaker": "张乐乐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yígè.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_036",
      "speaker": "张雨桐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shì guò yīcì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_038",
      "speaker": "刘梅",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yígè bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_043",
      "speaker": "张乐乐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_044",
      "speaker": "张雨桐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_047",
      "speaker": "张乐乐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_048",
      "speaker": "张雨桐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tàihǎole, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yījiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xiàcì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_051",
      "speaker": "张乐乐",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_054",
      "speaker": "刘梅",
      "zh": "银行离这里不远。",
      "pinyin": "Yínháng lí zhèlǐ bùyuǎn.",
      "tr": "Banka buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_055",
      "speaker": "张乐乐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒmen bǎ gāngcái kàn de zài zhěnglǐ yīxià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_056",
      "speaker": "张雨桐",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xūyào quèrèn de dìfāng kāishǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_057",
      "speaker": "张伟",
      "zh": "嗯，邮局这点确实很实用。",
      "pinyin": "En, yóujú zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, postane gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ juéde xiānkàn shíjì qíngkuàng bǐjiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_059",
      "speaker": "张乐乐",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù héshì jiù huàn yígè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_060",
      "speaker": "张雨桐",
      "zh": "别急，慢慢来。",
      "pinyin": "Biéjí, mànmànlái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_061",
      "speaker": "张伟",
      "zh": "我觉得邮局也很重要。",
      "pinyin": "Wǒ juéde yóujú yě hěn zhòngyào.",
      "tr": "Bence postane de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_062",
      "speaker": "刘梅",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhèyàng jiù qīngchǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_063",
      "speaker": "张乐乐",
      "zh": "嗯，离这部分现在清楚多了。",
      "pinyin": "En, lí zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, -den uzaklık kısmı şimdi çok daha net."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_064",
      "speaker": "张雨桐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_065",
      "speaker": "张伟",
      "zh": "那公园呢？",
      "pinyin": "Nà gōngyuán ne?",
      "tr": "Peki park?"
    },
    {
      "id": "DLG_ZH_HSK2_SC030_066",
      "speaker": "刘梅",
      "zh": "我先试试看。",
      "pinyin": "Wǒxiān shìshìkàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_067",
      "speaker": "张乐乐",
      "zh": "嗯，城市这点确实很实用。",
      "pinyin": "En, chéngshì zhèdiǎn quèshí hěn shíyòng.",
      "tr": "Evet, şehir gerçekten işe yarar."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_068",
      "speaker": "张雨桐",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhèyàng bǐjiào fāngbiàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_069",
      "speaker": "张伟",
      "zh": "我觉得市中心也很重要。",
      "pinyin": "Wǒ juéde shìzhōngxīn yě hěn zhòngyào.",
      "tr": "Bence şehir merkezi de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhème zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_071",
      "speaker": "张乐乐",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐhòu wǒmen zài jiǎnchá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_072",
      "speaker": "张雨桐",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèntí mǎshàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_073",
      "speaker": "张伟",
      "zh": "嗯，邮局这部分现在清楚多了。",
      "pinyin": "En, yóujú zhèbùfèn xiànzài qīngchǔ duō le.",
      "tr": "Evet, postane kısmı şimdi çok daha net."
