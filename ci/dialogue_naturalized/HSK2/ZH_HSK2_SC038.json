{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC038",
  "level": "HSK2",
  "sourceTitleZh": "雨桐和朋友闹别扭",
  "sourceTitleTr": "Yutong’un İlk Küçük Tartışması",
  "sourceMiniAdventureTr": "Yutong ve arkadaşı yanlış anlaşılma sonrası konuşup barışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC038_001",
      "speaker": "张雨桐",
      "zh": "雨桐和朋友有一点误会。",
      "pinyin": "Yǔtóng hé péngyou yǒu yìdiǎn wùhuì.",
      "tr": "Yutong ile arkadaşının küçük bir yanlış anlaşılması var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_002",
      "speaker": "同学",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_005",
      "speaker": "同学",
      "zh": "我们之间有一点误会。",
      "pinyin": "Wǒmen zhījiān yǒu yìdiǎn wùhuì.",
      "tr": "Aramızda küçük bir yanlış anlaşılma var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_006",
      "speaker": "刘梅",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_007",
      "speaker": "张雨桐",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_008",
      "speaker": "同学",
      "zh": "我明白你的意思了。",
      "pinyin": "Wǒ míngbai nǐ de yìsi le.",
      "tr": "Ne demek istediğini anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_009",
      "speaker": "刘梅",
      "zh": "这个我会记住。",
      "pinyin": "Zhège wǒhuì jìzhù.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_010",
      "speaker": "张雨桐",
      "zh": "嗯，听起来很清楚。",
      "pinyin": "Èn, tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_011",
      "speaker": "同学",
      "zh": "我们先道歉。",
      "pinyin": "Wǒmen xiān dàoqiàn.",
      "tr": "Önce özür dilemek."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_012",
      "speaker": "刘梅",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_014",
      "speaker": "同学",
      "zh": "说清楚以后就和好了。",
      "pinyin": "Shuō qīngchu yǐhòu jiù héhǎo le.",
      "tr": "Açıklığa kavuşturunca barıştılar."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_017",
      "speaker": "同学",
      "zh": "我不是那个意思，对不起。",
      "pinyin": "Wǒ bú shì nàge yìsi, duìbuqǐ.",
      "tr": "Öyle demek istemedim, özür dilerim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_018",
      "speaker": "刘梅",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC038_019",
      "speaker": "张雨桐",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_020",
      "speaker": "同学",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_022",
      "speaker": "张雨桐",
      "zh": "我们先谈一谈。",
      "pinyin": "Wǒmen xiān tán yì tán.",
      "tr": "Önce konuşmak."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_023",
      "speaker": "同学",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_025",
      "speaker": "张雨桐",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyou jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_026",
      "speaker": "同学",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_027",
      "speaker": "刘梅",
      "zh": "我们先试一下。",
      "pinyin": "Wǒmen xiān shìyīxià.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_028",
      "speaker": "张雨桐",
      "zh": "对不起，是我弄错了。",
      "pinyin": "Duìbuqǐ, shì wǒ nòng cuò le.",
      "tr": "Özür dilerim, ben yanlış yaptım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_029",
      "speaker": "同学",
      "zh": "之前我都没发现。",
      "pinyin": "Zhīqián wǒ dōu méi fāxiàn.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_030",
      "speaker": "刘梅",
      "zh": "这下知道了。",
      "pinyin": "Zhè xià zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_031",
      "speaker": "张雨桐",
      "zh": "没关系，我们再试一次。",
      "pinyin": "Méi guānxi, wǒmen zài shì yí cì.",
      "tr": "Sorun değil, tekrar deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_032",
      "speaker": "同学",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_033",
      "speaker": "刘梅",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_035",
      "speaker": "同学",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_038",
      "speaker": "同学",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_039",
      "speaker": "刘梅",
      "zh": "行，那你先试。",
      "pinyin": "Xíng, nà nǐ xiān shì.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_040",
      "speaker": "张雨桐",
      "zh": "做完了告诉我一声。",
      "pinyin": "Zuò wán le gàosù wǒ yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_041",
      "speaker": "同学",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_042",
      "speaker": "刘梅",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_043",
      "speaker": "张雨桐",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_044",
      "speaker": "同学",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_047",
      "speaker": "同学",
      "zh": "现在看起来没问题了。",
      "pinyin": "Xiànzài kànqǐlái méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_048",
      "speaker": "刘梅",
      "zh": "太好了，总算解决了。",
      "pinyin": "Tàihǎole, zǒngsuàn jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_050",
      "speaker": "同学",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_051",
      "speaker": "刘梅",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_052",
      "speaker": "张雨桐",
      "zh": "好，那就这么决定。",
      "pinyin": "Hǎo, nà jiù zhème juédìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_053",
      "speaker": "同学",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_054",
      "speaker": "刘梅",
      "zh": "我们之间有一点误会。",
      "pinyin": "Wǒmen zhījiān yǒu yìdiǎn wùhuì.",
      "tr": "Aramızda küçük bir yanlış anlaşılma var."
    },
    {
      "id": "DLG_ZH_HSK2_SC038_055",
