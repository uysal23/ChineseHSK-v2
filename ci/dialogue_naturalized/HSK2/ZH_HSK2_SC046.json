{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK2_SC046",
  "level": "HSK2",
  "sourceTitleZh": "雨桐有了好朋友",
  "sourceTitleTr": "Yutong’un Yeni Yakın Arkadaşı",
  "sourceMiniAdventureTr": "Yutong yeni yakın arkadaşıyla ortak ilgi alanlarını keşfeder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC046_001",
      "speaker": "张雨桐",
      "zh": "雨桐有了一个很合得来的朋友。",
      "pinyin": "Yǔtóng yǒu le yí ge hěn hé de lái de péngyou.",
      "tr": "Yutong çok iyi anlaştığı bir arkadaş edindi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_002",
      "speaker": "好朋友",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_005",
      "speaker": "好朋友",
      "zh": "好朋友今天也来了。",
      "pinyin": "Hǎo péngyou jīntiān yě lái le.",
      "tr": "Yakın arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_006",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_008",
      "speaker": "好朋友",
      "zh": "我们的爱好很像。",
      "pinyin": "Wǒmen de àihào hěn xiàng.",
      "tr": "Hobilerimiz birbirine çok benziyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_009",
      "speaker": "刘梅",
      "zh": "这个我记住了。",
      "pinyin": "Zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_010",
      "speaker": "张雨桐",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchu.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_011",
      "speaker": "好朋友",
      "zh": "我们常常一起学习。",
      "pinyin": "Wǒmen chángcháng yìqǐ xuéxí.",
      "tr": "Sık sık birlikte ders çalışıyoruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_012",
      "speaker": "刘梅",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_014",
      "speaker": "好朋友",
      "zh": "我们有一样的爱好。",
      "pinyin": "Wǒmen yǒu yíyàng de àihào.",
      "tr": "Aynı hobilere sahibiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_017",
      "speaker": "好朋友",
      "zh": "她们有很多一样的爱好。",
      "pinyin": "Tāmen yǒu hěn duō yíyàng de àihào.",
      "tr": "Birçok ortak hobileri var."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC046_019",
      "speaker": "张雨桐",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān bié zháojí, wǒmen xiǎng ge bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_020",
      "speaker": "好朋友",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_022",
      "speaker": "张雨桐",
      "zh": "我们一起做吧。",
      "pinyin": "Wǒmen yìqǐ zuò ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_023",
      "speaker": "好朋友",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_025",
      "speaker": "张雨桐",
      "zh": "雨桐很喜欢音乐。",
      "pinyin": "Yǔtóng hěn xǐhuan yīnyuè.",
      "tr": "Yutong müziği çok seviyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_026",
      "speaker": "好朋友",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshi.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_028",
      "speaker": "张雨桐",
      "zh": "我最近常常运动。",
      "pinyin": "Wǒ zuìjìn chángcháng yùndòng.",
      "tr": "Son zamanlarda sık sık spor yapıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_029",
      "speaker": "好朋友",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_031",
      "speaker": "张雨桐",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyou jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_032",
      "speaker": "好朋友",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuō dé duì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_035",
      "speaker": "好朋友",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_038",
      "speaker": "好朋友",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yí ge bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosu wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_041",
      "speaker": "好朋友",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎo duō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chà yìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_044",
      "speaker": "好朋友",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yí cì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_047",
      "speaker": "好朋友",
      "zh": "这次没有问题了。",
      "pinyin": "Zhè cì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_048",
      "speaker": "刘梅",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tài hǎo le, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_050",
      "speaker": "好朋友",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_051",
      "speaker": "刘梅",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhè me jué de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_053",
      "speaker": "好朋友",
      "zh": "行，我们接着来。",
      "pinyin": "Xíng, wǒ men jiē zhe lái.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_054",
      "speaker": "刘梅",
      "zh": "好朋友今天也来了。",
      "pinyin": "Hǎo péngyou jīntiān yě lái le.",
      "tr": "Yakın arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_055",
      "speaker": "张雨桐",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒ men bǎ gāng cái kàn de zài zhěng lǐ yī xià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_056",
      "speaker": "好朋友",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xū yào què rèn de dì fāng kāi shǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_057",
      "speaker": "刘梅",
      "zh": "那好朋友呢？",
      "pinyin": "Nà hǎo péng yǒu ne?",
      "tr": "Peki yakın arkadaş?"
    },
    {
      "id": "DLG_ZH_HSK2_SC046_058",
      "speaker": "张雨桐",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ jué de xiān kàn shí jì qíng kuàng bǐ jiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_059",
      "speaker": "好朋友",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù hé shì jiù huàn yí gè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_060",
      "speaker": "刘梅",
      "zh": "别急，慢慢来。",
      "pinyin": "Bié jí, màn màn lái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_061",
      "speaker": "张雨桐",
      "zh": "我觉得一样也很重要。",
      "pinyin": "Wǒ jué de yī yàng yě hěn zhòng yào.",
      "tr": "Bence aynı de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_062",
      "speaker": "好朋友",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhè yàng jiù qīng chǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_063",
      "speaker": "刘梅",
      "zh": "那再看下一个。",
      "pinyin": "Nà zài kàn xià yí gè.",
      "tr": "O zaman sonrakine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_064",
      "speaker": "张雨桐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jì zhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_065",
      "speaker": "好朋友",
      "zh": "那常常呢？",
      "pinyin": "Nà cháng cháng ne?",
      "tr": "Peki sık sık?"
    },
    {
      "id": "DLG_ZH_HSK2_SC046_066",
      "speaker": "刘梅",
      "zh": "我先试试看。",
      "pinyin": "Wǒ xiān shì shì kàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_067",
      "speaker": "张雨桐",
      "zh": "如果不合适，我就换。",
      "pinyin": "Rú guǒ bù hé shì, wǒ jiù huàn.",
      "tr": "Uygun olmazsa değiştiririm."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_068",
      "speaker": "好朋友",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhè yàng bǐ jiào fāng biàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_069",
      "speaker": "刘梅",
      "zh": "我觉得爱好也很重要。",
      "pinyin": "Wǒ jué de ài hào yě hěn zhòng yào.",
      "tr": "Bence hobi de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_070",
      "speaker": "张雨桐",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhè me zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_071",
      "speaker": "好朋友",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐ hòu wǒ men zài jiǎn chá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_072",
      "speaker": "刘梅",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèn tí mǎ shàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC046_073",
      "speaker": "张雨桐",
      "zh": "那一起呢？",
      "pinyin": "Nà yì qǐ ne?",
      "tr": "Peki birlikte?"
    },
    {
      "id": "DLG_ZH_HSK2_SC046_074",
      "speaker": "好朋友",
      "zh": "我觉得这个选择可以。",
      "pinyin": "Wǒ jué de zhè ge xuǎn zé kě yǐ.",
      "tr": "Bence bu seçenek uygun."
    },
    {
