{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC049",
  "level": "HSK2",
  "sourceTitleZh": "一年的照片",
  "sourceTitleTr": "Birinci Yıl Fotoğraf Albümü",
  "sourceMiniAdventureTr": "Aile bir yılda çekilen fotoğrafları inceler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC049_001",
      "speaker": "张伟",
      "zh": "我们来看看这一年的照片。",
      "pinyin": "Wǒmen lái kànkan zhè yì nián de zhàopiàn.",
      "tr": "Bu yılın fotoğraflarına bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_003",
      "speaker": "张雨桐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_004",
      "speaker": "张乐乐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_005",
      "speaker": "张伟",
      "zh": "这个照片在这里。",
      "pinyin": "Zhège zhàopiàn zài zhèlǐ.",
      "tr": "Bu fotoğraf burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_006",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_007",
      "speaker": "张雨桐",
      "zh": "嗯，原来如此。",
      "pinyin": "Èn, yuánláirúcǐ.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_008",
      "speaker": "张乐乐",
      "zh": "这一年我们经历了很多事。",
      "pinyin": "Zhè yì nián wǒmen jīnglì le hěn duō shì.",
      "tr": "Bu yıl birçok şey yaşadık."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "Èn, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_010",
      "speaker": "刘梅",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_011",
      "speaker": "张雨桐",
      "zh": "你还记得这张照片吗？",
      "pinyin": "Nǐ hái jìde zhè zhāng zhàopiàn ma?",
      "tr": "Bu fotoğrafı hâlâ hatırlıyor musun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC049_012",
      "speaker": "张乐乐",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_014",
      "speaker": "刘梅",
      "zh": "这个地方我们以前去过。",
      "pinyin": "Zhège dìfang wǒmen yǐqián qùguo.",
      "tr": "Bu yere daha önce gitmiştik."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_017",
      "speaker": "张伟",
      "zh": "这张是我们第一次去公园的时候。",
      "pinyin": "Zhè zhāng shì wǒmen dì yí cì qù gōngyuán de shíhou.",
      "tr": "Bu, parka ilk gittiğimiz zamanki fotoğraf."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_018",
      "speaker": "刘梅",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC049_019",
      "speaker": "张雨桐",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_020",
      "speaker": "张乐乐",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_022",
      "speaker": "刘梅",
      "zh": "那时候我们刚来这里。",
      "pinyin": "Nà shíhou wǒmen gāng lái zhèlǐ.",
      "tr": "O zaman buraya yeni gelmiştik."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_024",
      "speaker": "张乐乐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_025",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_026",
      "speaker": "刘梅",
      "zh": "嗯，这个办法可以。",
      "pinyin": "Èn, zhège bànfǎ kěyǐ.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_027",
      "speaker": "张雨桐",
      "zh": "可以，先试试看。",
      "pinyin": "Kěyǐ, xiān shìshìkàn.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_028",
      "speaker": "张乐乐",
      "zh": "这个城市在这里。",
      "pinyin": "Zhège chéngshì zài zhèlǐ.",
      "tr": "Bu şehir burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_029",
      "speaker": "张伟",
      "zh": "我以前还真没注意。",
      "pinyin": "Wǒ yǐqián hái zhēn méi zhùyì.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_030",
      "speaker": "刘梅",
      "zh": "这下知道了。",
      "pinyin": "Zhè xià zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_031",
      "speaker": "张雨桐",
      "zh": "大家今天都很开心。",
      "pinyin": "Dàjiā jīntiān dōu hěn kāixīn.",
      "tr": "Bugün herkes çok mutlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_032",
      "speaker": "张乐乐",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_033",
      "speaker": "张伟",
      "zh": "这样会更方便。",
      "pinyin": "Zhèyàng huì gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_035",
      "speaker": "张雨桐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_038",
      "speaker": "刘梅",
      "zh": "好，我们换一种办法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_039",
      "speaker": "张雨桐",
      "zh": "行，那你先试。",
      "pinyin": "Xíng, nà nǐ xiān shì.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_040",
      "speaker": "张乐乐",
      "zh": "弄好以后跟我说一声。",
      "pinyin": "Nòng hǎo yǐhòu gēn wǒ shuō yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_042",
      "speaker": "刘梅",
      "zh": "你看，现在好多了。",
      "pinyin": "Nǐ kàn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_043",
      "speaker": "张雨桐",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_044",
      "speaker": "张乐乐",
      "zh": "要不我来帮你吧。",
      "pinyin": "Yào bù wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_046",
      "speaker": "刘梅",
      "zh": "好，再检查一次。",
      "pinyin": "Hǎo, zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_047",
      "speaker": "张雨桐",
      "zh": "好，这次没问题了。",
      "pinyin": "Hǎo, zhècì méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_048",
      "speaker": "张乐乐",
      "zh": "好，总算弄好了。",
      "pinyin": "Hǎo, zǒngsuàn nòng hǎo le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_051",
      "speaker": "张雨桐",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_052",
      "speaker": "张乐乐",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_053",
      "speaker": "张伟",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_054",
      "speaker": "刘梅",
      "zh": "这个照片在这里。",
      "pinyin": "Zhège zhàopiàn zài zhèlǐ.",
      "tr": "Bu fotoğraf burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_055",
      "speaker": "张雨桐",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_056",
      "speaker": "张乐乐",
      "zh": "这一年我们经历了很多事。",
      "pinyin": "Zhè yì nián wǒmen jīnglì le hěn duō shì.",
      "tr": "Bu yıl birçok şey yaşadık."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_057",
      "speaker": "张伟",
      "zh": "这个确实很实用。",
      "pinyin": "Zhège quèshí hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC049_058",
      "speaker": "刘梅",
      "zh": "你还记得这张照片吗？",
