{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC019",
  "level": "HSK2",
  "sourceTitleZh": "去看生病的同事",
  "sourceTitleTr": "Hasta İş Arkadaşını Ziyaret",
  "sourceMiniAdventureTr": "Zhang hasta bir iş arkadaşını ziyaret eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC019_001",
      "speaker": "张伟",
      "zh": "同事今天生病了。",
      "pinyin": "Tóngshì jīntiān shēngbìng le.",
      "tr": "İş arkadaşım bugün hasta."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_002",
      "speaker": "同事",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_005",
      "speaker": "同事",
      "zh": "他今天生病了。",
      "pinyin": "Tā jīntiān shēngbìng le.",
      "tr": "O bugün hasta."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_006",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_007",
      "speaker": "张伟",
      "zh": "哦，原来是这样。",
      "pinyin": "Ò, yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_008",
      "speaker": "同事",
      "zh": "我们先休息。",
      "pinyin": "Wǒmen xiān xiūxi.",
      "tr": "Önce dinlenmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_009",
      "speaker": "刘梅",
      "zh": "好，这个我记住了。",
      "pinyin": "Hǎo, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_010",
      "speaker": "张伟",
      "zh": "嗯，听起来很清楚。",
      "pinyin": "Èn, tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_011",
      "speaker": "同事",
      "zh": "今天感觉好一点了吗？",
      "pinyin": "Jīntiān gǎnjué hǎo yìdiǎn le ma?",
      "tr": "Bugün biraz daha iyi hissediyor musun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC019_012",
      "speaker": "刘梅",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_014",
      "speaker": "同事",
      "zh": "这个药在这里。",
      "pinyin": "Zhège yào zài zhèlǐ.",
      "tr": "Bu ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_017",
      "speaker": "同事",
      "zh": "你要多休息，按时吃药。",
      "pinyin": "Nǐ yào duō xiūxi, ànshí chī yào.",
      "tr": "Çok dinlenip ilacını zamanında almalısın."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC019_019",
      "speaker": "张伟",
      "zh": "别着急，我们先想个办法。",
      "pinyin": "Biézháojí, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_020",
      "speaker": "同事",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_022",
      "speaker": "张伟",
      "zh": "我们先看望。",
      "pinyin": "Wǒmen xiān kànwàng.",
      "tr": "Önce ziyaret etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_023",
      "speaker": "同事",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_025",
      "speaker": "张伟",
      "zh": "这个工作在这里。",
      "pinyin": "Zhège gōngzuò zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_026",
      "speaker": "同事",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_027",
      "speaker": "刘梅",
      "zh": "那我们试试吧。",
      "pinyin": "Nà wǒmen shìshì ba.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_028",
      "speaker": "张伟",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyou jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_029",
      "speaker": "同事",
      "zh": "我以前还真没注意。",
      "pinyin": "Wǒ yǐqián hái zhēn méi zhùyì.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_031",
      "speaker": "张伟",
      "zh": "我们先帮忙。",
      "pinyin": "Wǒmen xiān bāngmáng.",
      "tr": "Önce yardım etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_032",
      "speaker": "同事",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_033",
      "speaker": "刘梅",
      "zh": "这样确实更方便。",
      "pinyin": "Zhèyàng quèshí gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_035",
      "speaker": "同事",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_038",
      "speaker": "同事",
      "zh": "好，我们换一种办法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_039",
      "speaker": "刘梅",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_040",
      "speaker": "张伟",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_041",
      "speaker": "同事",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_042",
      "speaker": "刘梅",
      "zh": "嗯，现在好多了。",
      "pinyin": "Èn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_043",
      "speaker": "张伟",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_044",
      "speaker": "同事",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_046",
      "speaker": "张伟",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_047",
      "speaker": "同事",
      "zh": "这次应该没问题了。",
      "pinyin": "Zhècì yīnggāi méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_048",
      "speaker": "刘梅",
      "zh": "终于解决了，太好了。",
      "pinyin": "Zhōngyú jiějué le, tàihǎole.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_050",
      "speaker": "同事",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_051",
      "speaker": "刘梅",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_052",
      "speaker": "张伟",
      "zh": "那就这么定吧。",
      "pinyin": "Nà jiù zhème dìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC019_053",
      "speaker": "同事",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
