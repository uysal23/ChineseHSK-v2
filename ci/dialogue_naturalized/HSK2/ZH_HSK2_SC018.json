{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC018",
  "level": "HSK2",
  "sourceTitleZh": "忘在公交车上的包",
  "sourceTitleTr": "Otobüste Unutulan Çanta",
  "sourceMiniAdventureTr": "Yutong çantasını otobüste unutur ve kayıp eşya bürosuna gider.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC018_001",
      "speaker": "张雨桐",
      "zh": "我的包忘在公交车上了。",
      "pinyin": "Wǒ de bāo wàng zài gōngjiāochē shàng le.",
      "tr": "Çantamı otobüste unuttum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_003",
      "speaker": "工作人员",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_005",
      "speaker": "刘梅",
      "zh": "我的包好像丢了。",
      "pinyin": "Wǒ de bāo hǎoxiàng diū le.",
      "tr": "Sanırım çantam kayboldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_006",
      "speaker": "工作人员",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_007",
      "speaker": "张雨桐",
      "zh": "哦，原来是这样。",
      "pinyin": "Ò, yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_008",
      "speaker": "刘梅",
      "zh": "我们去失物招领处问问。",
      "pinyin": "Wǒmen qù shīwù zhāolǐng chù wènwen.",
      "tr": "Kayıp eşya bürosuna gidip soralım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_009",
      "speaker": "工作人员",
      "zh": "这个我会记住。",
      "pinyin": "Zhège wǒhuì jìzhù.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_010",
      "speaker": "张雨桐",
      "zh": "嗯，听起来很清楚。",
      "pinyin": "Èn, tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_011",
      "speaker": "刘梅",
      "zh": "里面还有东西。",
      "pinyin": "Lǐmiàn hái yǒu dōngxi.",
      "tr": "İçinde hâlâ bir şeyler var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_012",
      "speaker": "工作人员",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_014",
      "speaker": "刘梅",
      "zh": "你喜欢什么颜色？",
      "pinyin": "Nǐ xǐhuan shénme yánsè?",
      "tr": "Hangi rengi seviyorsun?"
    },
    {
      "id": "DLG_ZH_HSK2_SC018_015",
      "speaker": "工作人员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_017",
      "speaker": "刘梅",
      "zh": "里面有书和钥匙。",
      "pinyin": "Lǐmiàn yǒu shū hé yàoshi.",
      "tr": "İçinde kitap ve anahtar var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_018",
      "speaker": "工作人员",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC018_019",
      "speaker": "张雨桐",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_020",
      "speaker": "刘梅",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_021",
      "speaker": "工作人员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_022",
      "speaker": "张雨桐",
      "zh": "我们先说明。",
      "pinyin": "Wǒmen xiān shuōmíng.",
      "tr": "Önce tarif etmek / açıklamak."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_024",
      "speaker": "工作人员",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_025",
      "speaker": "张雨桐",
      "zh": "这个包在这里。",
      "pinyin": "Zhège bāo zài zhèlǐ.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_027",
      "speaker": "工作人员",
      "zh": "可以，先试试看。",
      "pinyin": "Kěyǐ, xiān shìshìkàn.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_028",
      "speaker": "张雨桐",
      "zh": "我终于找到了。",
      "pinyin": "Wǒ zhōngyú zhǎodào le.",
      "tr": "Sonunda buldum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_029",
      "speaker": "刘梅",
      "zh": "之前我都没发现。",
      "pinyin": "Zhīqián wǒ dōu méi fāxiàn.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_030",
      "speaker": "工作人员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_031",
      "speaker": "张雨桐",
      "zh": "我们先打电话。",
      "pinyin": "Wǒmen xiān dǎ diànhuà.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_032",
      "speaker": "刘梅",
      "zh": "对，就是这样。",
      "pinyin": "Duì, jiùshì zhèyàng.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_033",
      "speaker": "工作人员",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_036",
      "speaker": "工作人员",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_038",
      "speaker": "刘梅",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_039",
      "speaker": "工作人员",
      "zh": "好，你先来。",
      "pinyin": "Hǎo, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_040",
      "speaker": "张雨桐",
      "zh": "做完了告诉我一声。",
      "pinyin": "Zuò wán le gàosù wǒ yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_042",
      "speaker": "工作人员",
      "zh": "你看，现在好多了。",
      "pinyin": "Nǐ kàn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_043",
      "speaker": "张雨桐",
      "zh": "就差一点了。",
      "pinyin": "Jiù chàyìdiǎn le.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_045",
      "speaker": "工作人员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_046",
      "speaker": "张雨桐",
      "zh": "好，再检查一次。",
      "pinyin": "Hǎo, zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_047",
      "speaker": "刘梅",
      "zh": "这次应该没问题了。",
      "pinyin": "Zhècì yīnggāi méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_048",
      "speaker": "工作人员",
      "zh": "太好了，总算解决了。",
      "pinyin": "Tàihǎole, zǒngsuàn jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_051",
      "speaker": "工作人员",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "Èn, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_052",
      "speaker": "张雨桐",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_053",
      "speaker": "刘梅",
      "zh": "行，我们接着来。",
      "pinyin": "Xíng, wǒmen jiēzhe lái.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_054",
      "speaker": "工作人员",
      "zh": "我的包好像丢了。",
      "pinyin": "Wǒ de bāo hǎoxiàng diū le.",
      "tr": "Sanırım çantam kayboldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_055",
      "speaker": "张雨桐",
      "zh": "嗯，我记住了。",
      "pinyin": "Èn, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_056",
      "speaker": "刘梅",
      "zh": "我们去失物招领处问问。",
      "pinyin": "Wǒmen qù shīwù zhāolǐng chù wènwen.",
      "tr": "Kayıp eşya bürosuna gidip soralım."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_057",
      "speaker": "工作人员",
      "zh": "嗯，这个很实用。",
      "pinyin": "Èn, zhège hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_058",
      "speaker": "张雨桐",
      "zh": "里面还有东西。",
      "pinyin": "Lǐmiàn hái yǒu dōngxi.",
      "tr": "İçinde hâlâ bir şeyler var."
    },
    {
      "id": "DLG_ZH_HSK2_SC018_059",
      "speaker": "刘梅",
      "zh": "以后肯定还会用到。",
      "pinyin": "Yǐhòu kěndìng hái huì yòngdào.",
