{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC013",
  "level": "HSK2",
  "sourceTitleZh": "张伟帮同事",
  "sourceTitleTr": "Zhang İş Arkadaşına Yardım Ediyor",
  "sourceMiniAdventureTr": "Zhang iş arkadaşına küçük bir ekipman sorununda yardım eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC013_001",
      "speaker": "张伟",
      "zh": "这个设备有一点问题。",
      "pinyin": "Zhège shèbèi yǒu yìdiǎn wèntí.",
      "tr": "Bu ekipmanda küçük bir sorun var."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_002",
      "speaker": "同事",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_003",
      "speaker": "新同事",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_005",
      "speaker": "同事",
      "zh": "这个设备在这里。",
      "pinyin": "Zhège shèbèi zài zhèlǐ.",
      "tr": "Bu ekipman burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_006",
      "speaker": "新同事",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_007",
      "speaker": "张伟",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_008",
      "speaker": "同事",
      "zh": "这个问题不难解决。",
      "pinyin": "Zhège wèntí bù nán jiějué.",
      "tr": "Bu sorunu çözmek zor değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_009",
      "speaker": "新同事",
      "zh": "这个我会记住。",
      "pinyin": "Zhège wǒhuì jìzhù.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_010",
      "speaker": "张伟",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_011",
      "speaker": "同事",
      "zh": "我们一步一步来。",
      "pinyin": "Wǒmen yí bù yí bù lái.",
      "tr": "Adım adım ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_012",
      "speaker": "新同事",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_014",
      "speaker": "同事",
      "zh": "我们先检查。",
      "pinyin": "Wǒmen xiān jiǎnchá.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_015",
      "speaker": "新同事",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_017",
      "speaker": "同事",
      "zh": "我们先检查，再重新打开。",
      "pinyin": "Wǒmen xiān jiǎnchá, zài chóngxīn dǎkāi.",
      "tr": "Önce kontrol edip sonra yeniden açalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_018",
      "speaker": "新同事",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC013_019",
      "speaker": "张伟",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_020",
      "speaker": "同事",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_021",
      "speaker": "新同事",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_022",
      "speaker": "张伟",
      "zh": "我们先修好。",
      "pinyin": "Wǒmen xiān xiūhǎo.",
      "tr": "Önce tamir etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_023",
      "speaker": "同事",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_024",
      "speaker": "新同事",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_025",
      "speaker": "张伟",
      "zh": "这个工作在这里。",
      "pinyin": "Zhège gōngzuò zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_026",
      "speaker": "同事",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_027",
      "speaker": "新同事",
      "zh": "可以，先试试看。",
      "pinyin": "Kěyǐ, xiān shìshìkàn.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_028",
      "speaker": "张伟",
      "zh": "这个地方要特别注意。",
      "pinyin": "Zhège dìfang yào tèbié zhùyì.",
      "tr": "Bu noktaya özellikle dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_029",
      "speaker": "同事",
      "zh": "之前我都没发现。",
      "pinyin": "Zhīqián wǒ dōu méi fāxiàn.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_030",
      "speaker": "新同事",
      "zh": "嗯，现在我知道了。",
      "pinyin": "Èn, xiànzài wǒ zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_031",
      "speaker": "张伟",
      "zh": "第一步先检查这里。",
      "pinyin": "Dì yí bù xiān jiǎnchá zhèlǐ.",
      "tr": "İlk adımda önce burayı kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_032",
      "speaker": "同事",
      "zh": "对，就是这样。",
      "pinyin": "Duì, jiùshì zhèyàng.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_033",
      "speaker": "新同事",
      "zh": "这样会更方便。",
      "pinyin": "Zhèyàng huì gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_035",
      "speaker": "同事",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_036",
      "speaker": "新同事",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_038",
      "speaker": "同事",
      "zh": "那换个办法吧。",
      "pinyin": "Nà huàn gè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_039",
      "speaker": "新同事",
      "zh": "好，你先来。",
      "pinyin": "Hǎo, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_040",
      "speaker": "张伟",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_041",
      "speaker": "同事",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_042",
      "speaker": "新同事",
      "zh": "你看，现在好多了。",
      "pinyin": "Nǐ kàn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_043",
      "speaker": "张伟",
      "zh": "还差一点儿。",
      "pinyin": "Hái chàyìdiǎner.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_044",
      "speaker": "同事",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_045",
      "speaker": "新同事",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_046",
      "speaker": "张伟",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_047",
      "speaker": "同事",
      "zh": "好，这次没问题了。",
      "pinyin": "Hǎo, zhècì méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_048",
      "speaker": "新同事",
      "zh": "好，总算弄好了。",
      "pinyin": "Hǎo, zǒngsuàn nòng hǎo le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_050",
      "speaker": "同事",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_051",
      "speaker": "新同事",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_052",
      "speaker": "张伟",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_053",
      "speaker": "同事",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_054",
      "speaker": "新同事",
      "zh": "这个设备在这里。",
      "pinyin": "Zhège shèbèi zài zhèlǐ.",
      "tr": "Bu ekipman burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_055",
      "speaker": "张伟",
      "zh": "嗯，我记住了。",
      "pinyin": "Èn, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_056",
      "speaker": "同事",
      "zh": "这个问题不难解决。",
      "pinyin": "Zhège wèntí bù nán jiějué.",
      "tr": "Bu sorunu çözmek zor değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC013_057",
      "speaker": "新同事",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
