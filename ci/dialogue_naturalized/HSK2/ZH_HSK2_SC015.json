{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK2_SC015",
  "level": "HSK2",
  "sourceTitleZh": "新菜谱",
  "sourceTitleTr": "Liu Mei Yeni Tarif Deniyor",
  "sourceMiniAdventureTr": "Liu Mei yanlış baharat ekler ama yemeği kurtarır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC015_001",
      "speaker": "刘梅",
      "zh": "刘梅今天试一个新菜谱。",
      "pinyin": "Liú Méi jīntiān shì yí ge xīn càipǔ.",
      "tr": "Liu Mei bugün yeni bir tarif deniyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_002",
      "speaker": "张伟",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_003",
      "speaker": "张雨桐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_004",
      "speaker": "刘梅",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_005",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Bu tarif burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_006",
      "speaker": "张雨桐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_007",
      "speaker": "刘梅",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_008",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Bu tuz burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_009",
      "speaker": "张雨桐",
      "zh": "这个我记住了。",
      "pinyin": "Zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_010",
      "speaker": "刘梅",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchu.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_011",
      "speaker": "张伟",
      "zh": "你看，这个调料在这儿。",
      "pinyin": "Nǐ kàn, zhè ge tiáo liào zài zhèr.",
      "tr": "Bu baharat burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_012",
      "speaker": "张雨桐",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_014",
      "speaker": "张伟",
      "zh": "这个菜有点咸。",
      "pinyin": "Zhège cài yǒudiǎn xián.",
      "tr": "Bu yemek biraz tuzlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_017",
      "speaker": "张伟",
      "zh": "盐放多了，有点咸。",
      "pinyin": "Yán fàng duō le, yǒudiǎn xián.",
      "tr": "Tuz fazla oldu, biraz tuzlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_018",
      "speaker": "张雨桐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC015_019",
      "speaker": "刘梅",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān bié zháojí, wǒmen xiǎng ge bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_020",
      "speaker": "张伟",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_021",
      "speaker": "张雨桐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_022",
      "speaker": "刘梅",
      "zh": "现在味道好多了。",
      "pinyin": "Xiànzài wèidào hǎo duō le.",
      "tr": "Şimdi tadı çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_023",
      "speaker": "张伟",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_024",
      "speaker": "张雨桐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_025",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_026",
      "speaker": "张伟",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshi.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_028",
      "speaker": "刘梅",
      "zh": "我们先做最重要的事。",
      "pinyin": "Wǒmen xiān zuò zuì zhòngyào de shì.",
      "tr": "Önce en önemli işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_030",
      "speaker": "张雨桐",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_031",
      "speaker": "刘梅",
      "zh": "做完这个再做别的。",
      "pinyin": "Zuò wán zhège zài zuò bié de.",
      "tr": "Bunu bitirdikten sonra diğer işi yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_032",
      "speaker": "张伟",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuō dé duì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_033",
      "speaker": "张雨桐",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_035",
      "speaker": "张伟",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_036",
      "speaker": "张雨桐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_038",
      "speaker": "张伟",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yí ge bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_040",
      "speaker": "刘梅",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosu wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_042",
      "speaker": "张雨桐",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎo duō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_043",
      "speaker": "刘梅",
      "zh": "还差一点。",
      "pinyin": "Hái chà yìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_044",
      "speaker": "张伟",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_045",
      "speaker": "张雨桐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yí cì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_047",
      "speaker": "张伟",
      "zh": "这次没有问题了。",
      "pinyin": "Zhè cì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_048",
      "speaker": "张雨桐",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tài hǎo le, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_050",
      "speaker": "张伟",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_051",
      "speaker": "张雨桐",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "Èn, wǒ yě shì zhè me xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_052",
      "speaker": "刘梅",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_053",
      "speaker": "张伟",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_054",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Bu tarif burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_055",
      "speaker": "刘梅",
      "zh": "好，我们把刚才看的再整理一下。",
      "pinyin": "Hǎo, wǒ men bǎ gāng cái kàn de zài zhěng lǐ yī xià.",
      "tr": "Tamam, az önce baktıklarımızı bir kez daha toparlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_056",
      "speaker": "张伟",
      "zh": "先从最需要确认的地方开始。",
      "pinyin": "Xiān cóng zuì xū yào què rèn de dì fāng kāi shǐ.",
      "tr": "Önce en çok teyit edilmesi gereken yerden başlayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_057",
      "speaker": "张雨桐",
      "zh": "那菜谱呢？",
      "pinyin": "Nà cài pǔ ne?",
      "tr": "Peki tarif?"
    },
    {
      "id": "DLG_ZH_HSK2_SC015_058",
      "speaker": "刘梅",
      "zh": "我觉得先看实际情况比较好。",
      "pinyin": "Wǒ jué de xiān kàn shí jì qíng kuàng bǐ jiào hǎo.",
      "tr": "Bence önce gerçek duruma bakmak daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_059",
      "speaker": "张伟",
      "zh": "对，不合适就换一个。",
      "pinyin": "Duì, bù hé shì jiù huàn yí gè.",
      "tr": "Evet, uygun değilse başka birini deneriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_060",
      "speaker": "张雨桐",
      "zh": "别急，慢慢来。",
      "pinyin": "Bié jí, màn màn lái.",
      "tr": "Acele etmeyelim, yavaş yavaş ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_061",
      "speaker": "刘梅",
      "zh": "我觉得盐也很重要。",
      "pinyin": "Wǒ jué de yán yě hěn zhòng yào.",
      "tr": "Bence tuz de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_062",
      "speaker": "张伟",
      "zh": "这样就清楚多了。",
      "pinyin": "Zhè yàng jiù qīng chǔ duō le.",
      "tr": "Böylece çok daha net oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_063",
      "speaker": "张雨桐",
      "zh": "那再看下一个。",
      "pinyin": "Nà zài kàn xià yí gè.",
      "tr": "O zaman sonrakine bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_064",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jì zhù le.",
      "tr": "Tamam, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_065",
      "speaker": "张伟",
      "zh": "那调料呢？",
      "pinyin": "Nà tiáo liào ne?",
      "tr": "Peki baharat?"
    },
    {
      "id": "DLG_ZH_HSK2_SC015_066",
      "speaker": "张雨桐",
      "zh": "我先试试看。",
      "pinyin": "Wǒ xiān shì shì kàn.",
      "tr": "Önce bir deneyeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_067",
      "speaker": "刘梅",
      "zh": "如果不合适，我就换。",
      "pinyin": "Rú guǒ bù hé shì, wǒ jiù huàn.",
      "tr": "Uygun olmazsa değiştiririm."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_068",
      "speaker": "张伟",
      "zh": "对，这样比较方便。",
      "pinyin": "Duì, zhè yàng bǐ jiào fāng biàn.",
      "tr": "Evet, böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_069",
      "speaker": "张雨桐",
      "zh": "我觉得咸也很重要。",
      "pinyin": "Wǒ jué de xián yě hěn zhòng yào.",
      "tr": "Bence tuzlu de önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_070",
      "speaker": "刘梅",
      "zh": "那就先这么做吧。",
      "pinyin": "Nà jiù xiān zhè me zuò ba.",
      "tr": "O zaman şimdilik böyle yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_071",
      "speaker": "张伟",
      "zh": "做完以后我们再检查。",
      "pinyin": "Zuò wán yǐ hòu wǒ men zài jiǎn chá.",
      "tr": "Bitirdikten sonra bir kez daha kontrol ederiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_072",
      "speaker": "张雨桐",
      "zh": "好，有问题马上说。",
      "pinyin": "Hǎo, yǒu wèn tí mǎ shàng shuō.",
      "tr": "Tamam, sorun olursa hemen söyleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_073",
      "speaker": "刘梅",
      "zh": "那味道呢？",
      "pinyin": "Nà wèi dào ne?",
      "tr": "Peki tat?"
    },
    {
      "id": "DLG_ZH_HSK2_SC015_074",
      "speaker": "张伟",
      "zh": "我觉得这个选择可以。",
      "pinyin": "Wǒ jué de zhè ge xuǎn zé kě yǐ.",
      "tr": "Bence bu seçenek uygun."
    },
    {
      "id": "DLG_ZH_HSK2_SC015_075",
      "speaker": "张雨桐",
      "zh": "不过还要再比较一下。",
      "pinyin": "Bù guò hái yào zài bǐ jiào yī xià.",
      "tr": "Ama yine de biraz daha karşılaştırmak gerekiyor."
    },
    {
