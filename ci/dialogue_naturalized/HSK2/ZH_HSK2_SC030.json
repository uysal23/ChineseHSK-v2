      "zh": "嗯，我记住了。",
      "pinyin": "Èn, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_056",
      "speaker": "张雨桐",
      "zh": "邮局离这里不远。",
      "pinyin": "Yóujú lí zhèlǐ bù yuǎn.",
      "tr": "Postane buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_057",
      "speaker": "张伟",
      "zh": "这个确实很实用。",
      "pinyin": "Zhège quèshí hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_058",
      "speaker": "刘梅",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bù yuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC030_059",
      "speaker": "张乐乐",
      "zh": "以后肯定还会用到。",
      "pinyin": "Yǐhòu kěndìng hái huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
