      "zh": "这个流量在这里。",
      "pinyin": "Zhège liúliàng zài zhèlǐ.",
      "tr": "Bu internet kotası burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_057",
      "speaker": "店员",
      "zh": "这个确实很实用。",
      "pinyin": "Zhège quèshí hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_058",
      "speaker": "张伟",
      "zh": "还要十分钟。",
      "pinyin": "Hái yào shí fēnzhōng.",
      "tr": "On dakika daha gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC009_059",
      "speaker": "刘梅",
      "zh": "以后肯定还会用到。",
      "pinyin": "Yǐhòu kěndìng hái huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
