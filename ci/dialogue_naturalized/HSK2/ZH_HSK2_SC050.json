{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC050",
  "level": "HSK2",
  "sourceTitleZh": "在新城的一年",
  "sourceTitleTr": "Kasabada Bir Yıl",
  "sourceMiniAdventureTr": "İki aile yıldönümü yemeğinde bir yılı değerlendirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC050_001",
      "speaker": "张伟",
      "zh": "我们在新城已经一年了。",
      "pinyin": "Wǒmen zài Xīnchéng yǐjīng yì nián le.",
      "tr": "Yeni şehirde bir yılı tamamladık."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_003",
      "speaker": "李晨",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_004",
      "speaker": "李晨妻子",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_005",
      "speaker": "张伟",
      "zh": "这一年过得很快。",
      "pinyin": "Zhè yì nián guò de hěn kuài.",
      "tr": "Bu bir yıl çok hızlı geçti."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_006",
      "speaker": "刘梅",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_007",
      "speaker": "李晨",
      "zh": "嗯，原来如此。",
      "pinyin": "Èn, yuánláirúcǐ.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_008",
      "speaker": "李晨妻子",
      "zh": "这个已经准备好了。",
      "pinyin": "Zhège yǐjīng zhǔnbèi hǎo le.",
      "tr": "Bu çoktan hazırlandı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_009",
      "speaker": "张伟",
      "zh": "好，这个我记住了。",
      "pinyin": "Hǎo, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_010",
      "speaker": "刘梅",
      "zh": "嗯，听起来很清楚。",
      "pinyin": "Èn, tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_011",
      "speaker": "李晨",
      "zh": "我希望大家都越来越好。",
      "pinyin": "Wǒ xīwàng dàjiā dōu yuèláiyuè hǎo.",
      "tr": "Umarım herkes giderek daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_012",
      "speaker": "李晨妻子",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_014",
      "speaker": "刘梅",
      "zh": "希望以后越来越好。",
      "pinyin": "Xīwàng yǐhòu yuèláiyuè hǎo.",
      "tr": "Umarım gelecekte giderek daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_015",
      "speaker": "李晨",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_016",
      "speaker": "李晨妻子",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_017",
      "speaker": "张伟",
      "zh": "这一年发生了很多事情。",
      "pinyin": "Zhè yì nián fāshēng le hěn duō shìqing.",
      "tr": "Bu yıl birçok şey oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_018",
      "speaker": "刘梅",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC050_019",
      "speaker": "李晨",
      "zh": "别着急，我们先想个办法。",
      "pinyin": "Biézháojí, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_020",
      "speaker": "李晨妻子",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_022",
      "speaker": "刘梅",
      "zh": "大家今天都很开心。",
      "pinyin": "Dàjiā jīntiān dōu hěn kāixīn.",
      "tr": "Bugün herkes çok mutlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_023",
      "speaker": "李晨",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_024",
      "speaker": "李晨妻子",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_025",
      "speaker": "张伟",
      "zh": "这个家在这里。",
      "pinyin": "Zhège jiā zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_027",
      "speaker": "李晨",
      "zh": "那我们试试吧。",
      "pinyin": "Nà wǒmen shìshì ba.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_028",
      "speaker": "李晨妻子",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyou jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_029",
      "speaker": "张伟",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_031",
      "speaker": "李晨",
      "zh": "现在的生活越来越稳定了。",
      "pinyin": "Xiànzài de shēnghuó yuèláiyuè wěndìng le.",
      "tr": "Şimdiki hayat giderek daha düzenli oluyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_032",
      "speaker": "李晨妻子",
      "zh": "对，就是这样。",
      "pinyin": "Duì, jiùshì zhèyàng.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_033",
      "speaker": "张伟",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_035",
      "speaker": "李晨",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_036",
      "speaker": "李晨妻子",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_038",
      "speaker": "刘梅",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_039",
      "speaker": "李晨",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_040",
      "speaker": "李晨妻子",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_042",
      "speaker": "刘梅",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_043",
      "speaker": "李晨",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_044",
      "speaker": "李晨妻子",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_046",
      "speaker": "刘梅",
      "zh": "好，再检查一次。",
      "pinyin": "Hǎo, zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_047",
      "speaker": "李晨",
      "zh": "现在看起来没问题了。",
      "pinyin": "Xiànzài kànqǐlái méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_048",
      "speaker": "李晨妻子",
      "zh": "终于解决了，太好了。",
      "pinyin": "Zhōngyú jiějué le, tàihǎole.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_051",
      "speaker": "李晨",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_052",
      "speaker": "李晨妻子",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_053",
      "speaker": "张伟",
      "zh": "行，我们接着来。",
      "pinyin": "Xíng, wǒmen jiēzhe lái.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_054",
      "speaker": "刘梅",
      "zh": "这一年过得很快。",
      "pinyin": "Zhè yì nián guò de hěn kuài.",
      "tr": "Bu bir yıl çok hızlı geçti."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_055",
      "speaker": "李晨",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_056",
      "speaker": "李晨妻子",
      "zh": "这个已经准备好了。",
      "pinyin": "Zhège yǐjīng zhǔnbèi hǎo le.",
      "tr": "Bu çoktan hazırlandı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_057",
      "speaker": "张伟",
      "zh": "这个确实很实用。",
      "pinyin": "Zhège quèshí hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_058",
      "speaker": "刘梅",
      "zh": "我希望大家都越来越好。",
      "pinyin": "Wǒ xīwàng dàjiā dōu yuèláiyuè hǎo.",
      "tr": "Umarım herkes giderek daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_059",
      "speaker": "李晨",
      "zh": "这个以后还会用到。",
      "pinyin": "Zhège yǐhòu hái huì yòngdào.",
