{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC002",
  "level": "HSK2",
  "sourceTitleZh": "张伟办公交卡",
  "sourceTitleTr": "Zhang Otobüs Kartı Alıyor",
  "sourceMiniAdventureTr": "Zhang günlük kart yerine yanlışlıkla başka kart almak üzeredir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC002_001",
      "speaker": "张伟",
      "zh": "我想办公交卡。",
      "pinyin": "Wǒ xiǎng bàn gōngjiāo kǎ.",
      "tr": "Otobüs kartı almak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_002",
      "speaker": "工作人员",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_005",
      "speaker": "工作人员",
      "zh": "这个公交卡在这里。",
      "pinyin": "Zhège gōngjiāo kǎ zài zhèlǐ.",
      "tr": "Bu otobüs kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_006",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_007",
      "speaker": "张伟",
      "zh": "哦，原来是这样。",
      "pinyin": "Ò, yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_008",
      "speaker": "工作人员",
      "zh": "一个月的时间过得很快。",
      "pinyin": "Yí ge yuè de shíjiān guò de hěn kuài.",
      "tr": "Bir aylık süre çok hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_009",
      "speaker": "刘梅",
      "zh": "好，这个我记住了。",
      "pinyin": "Hǎo, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_010",
      "speaker": "张伟",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_011",
      "speaker": "工作人员",
      "zh": "一天用这个就够了。",
      "pinyin": "Yì tiān yòng zhège jiù gòu le.",
      "tr": "Bir gün için bunu kullanmak yeterli."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_012",
      "speaker": "刘梅",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_014",
      "speaker": "工作人员",
      "zh": "服务台离这里不远。",
      "pinyin": "Fúwùtái lí zhèlǐ bù yuǎn.",
      "tr": "Hizmet bankosu buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_017",
      "speaker": "工作人员",
      "zh": "这个不是我要的卡。",
      "pinyin": "Zhège bú shì wǒ yào de kǎ.",
      "tr": "Bu istediğim kart değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_018",
      "speaker": "刘梅",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC002_019",
      "speaker": "张伟",
      "zh": "别着急，我们先想个办法。",
      "pinyin": "Biézháojí, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_020",
      "speaker": "工作人员",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_022",
      "speaker": "张伟",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_023",
      "speaker": "工作人员",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_025",
      "speaker": "张伟",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_026",
      "speaker": "工作人员",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_027",
      "speaker": "刘梅",
      "zh": "可以，先试试看。",
      "pinyin": "Kěyǐ, xiān shìshìkàn.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_028",
      "speaker": "张伟",
      "zh": "这个工作在这里。",
      "pinyin": "Zhège gōngzuò zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_029",
      "speaker": "工作人员",
      "zh": "之前我都没发现。",
      "pinyin": "Zhīqián wǒ dōu méi fāxiàn.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_031",
      "speaker": "张伟",
      "zh": "这个套餐每月多少钱？",
      "pinyin": "Zhège tàocān měiyuè duōshao qián?",
      "tr": "Bu tarife ayda ne kadar?"
    },
    {
      "id": "DLG_ZH_HSK2_SC002_032",
      "speaker": "工作人员",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_033",
      "speaker": "刘梅",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_035",
      "speaker": "工作人员",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_038",
      "speaker": "工作人员",
      "zh": "好，我们换一种办法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_039",
      "speaker": "刘梅",
      "zh": "好，你先来。",
      "pinyin": "Hǎo, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_040",
      "speaker": "张伟",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_041",
      "speaker": "工作人员",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_042",
      "speaker": "刘梅",
      "zh": "嗯，现在好多了。",
      "pinyin": "Èn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_043",
      "speaker": "张伟",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_044",
      "speaker": "工作人员",
      "zh": "来，我帮你。",
      "pinyin": "Lái, wǒ bāng nǐ.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_046",
      "speaker": "张伟",
      "zh": "最后再检查一遍。",
      "pinyin": "Zuìhòu zài jiǎnchá yībiàn.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_047",
      "speaker": "工作人员",
      "zh": "现在看起来没问题了。",
      "pinyin": "Xiànzài kànqǐlái méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_048",
      "speaker": "刘梅",
      "zh": "好，总算弄好了。",
      "pinyin": "Hǎo, zǒngsuàn nòng hǎo le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_050",
      "speaker": "工作人员",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_051",
      "speaker": "刘梅",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_052",
      "speaker": "张伟",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_053",
      "speaker": "工作人员",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_054",
      "speaker": "刘梅",
      "zh": "这个公交卡在这里。",
      "pinyin": "Zhège gōngjiāo kǎ zài zhèlǐ.",
      "tr": "Bu otobüs kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_055",
      "speaker": "张伟",
      "zh": "嗯，我记住了。",
      "pinyin": "Èn, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_056",
      "speaker": "工作人员",
      "zh": "一个月的时间过得很快。",
      "pinyin": "Yí ge yuè de shíjiān guò de hěn kuài.",
      "tr": "Bir aylık süre çok hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_057",
      "speaker": "刘梅",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_058",
      "speaker": "张伟",
      "zh": "一天用这个就够了。",
      "pinyin": "Yì tiān yòng zhège jiù gòu le.",
      "tr": "Bir gün için bunu kullanmak yeterli."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_059",
      "speaker": "工作人员",
      "zh": "以后肯定还会用到。",
      "pinyin": "Yǐhòu kěndìng hái huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC002_060",
      "speaker": "刘梅",
      "zh": "服务台离这里不远。",
