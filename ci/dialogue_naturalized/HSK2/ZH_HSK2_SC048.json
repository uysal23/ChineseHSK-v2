{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC048",
  "level": "HSK2",
  "sourceTitleZh": "新城的春天",
  "sourceTitleTr": "Kasabada İlk Bahar",
  "sourceMiniAdventureTr": "Aile ilkbaharda çevrenin değiştiğini fark eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC048_001",
      "speaker": "张伟",
      "zh": "新城的春天来了。",
      "pinyin": "Xīnchéng de chūntiān lái le.",
      "tr": "Yeni şehirde ilkbahar geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_003",
      "speaker": "张雨桐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_004",
      "speaker": "张乐乐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_005",
      "speaker": "张伟",
      "zh": "这个春天在这里。",
      "pinyin": "Zhège chūntiān zài zhèlǐ.",
      "tr": "Bu ilkbahar burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_006",
      "speaker": "刘梅",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_007",
      "speaker": "张雨桐",
      "zh": "哦，原来是这样。",
      "pinyin": "Ò, yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_008",
      "speaker": "张乐乐",
      "zh": "春天的天气很暖和。",
      "pinyin": "Chūntiān de tiānqì hěn nuǎnhuo.",
      "tr": "İlkbaharda hava çok ılık."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_009",
      "speaker": "张伟",
      "zh": "这个我会记住。",
      "pinyin": "Zhège wǒhuì jìzhù.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_010",
      "speaker": "刘梅",
      "zh": "这样说就很清楚了。",
      "pinyin": "Zhèyàng shuō jiù hěn qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_011",
      "speaker": "张雨桐",
      "zh": "这个花在这里。",
      "pinyin": "Zhège huā zài zhèlǐ.",
      "tr": "Bu çiçek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_012",
      "speaker": "张乐乐",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_014",
      "speaker": "刘梅",
      "zh": "公园里的花都开了。",
      "pinyin": "Gōngyuán lǐ de huā dōu kāi le.",
      "tr": "Parktaki çiçeklerin hepsi açtı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_017",
      "speaker": "张伟",
      "zh": "天气比冬天暖和多了。",
      "pinyin": "Tiānqì bǐ dōngtiān nuǎnhuo duō le.",
      "tr": "Hava kışa göre çok daha sıcak."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC048_019",
      "speaker": "张雨桐",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_020",
      "speaker": "张乐乐",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_022",
      "speaker": "刘梅",
      "zh": "这个冬天在这里。",
      "pinyin": "Zhège dōngtiān zài zhèlǐ.",
      "tr": "Bu kış burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_024",
      "speaker": "张乐乐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_025",
      "speaker": "张伟",
      "zh": "公园离这里不远。",
      "pinyin": "Gōngyuán lí zhèlǐ bù yuǎn.",
      "tr": "Park buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_026",
      "speaker": "刘梅",
      "zh": "嗯，这个办法可以。",
      "pinyin": "Èn, zhège bànfǎ kěyǐ.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_027",
      "speaker": "张雨桐",
      "zh": "我们先试一下。",
      "pinyin": "Wǒmen xiān shìyīxià.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_028",
      "speaker": "张乐乐",
      "zh": "外面正在下雨。",
      "pinyin": "Wàimiàn zhèngzài xiàyǔ.",
      "tr": "Dışarıda yağmur yağıyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_029",
      "speaker": "张伟",
      "zh": "我以前还真没注意。",
      "pinyin": "Wǒ yǐqián hái zhēn méi zhùyì.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_030",
      "speaker": "刘梅",
      "zh": "嗯，现在我知道了。",
      "pinyin": "Èn, xiànzài wǒ zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_031",
      "speaker": "张雨桐",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_032",
      "speaker": "张乐乐",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_033",
      "speaker": "张伟",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_035",
      "speaker": "张雨桐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_038",
      "speaker": "刘梅",
      "zh": "那换个办法吧。",
      "pinyin": "Nà huàn gè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_040",
      "speaker": "张乐乐",
      "zh": "做完了告诉我一声。",
      "pinyin": "Zuò wán le gàosù wǒ yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_042",
      "speaker": "刘梅",
      "zh": "嗯，现在好多了。",
      "pinyin": "Èn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_043",
      "speaker": "张雨桐",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_044",
      "speaker": "张乐乐",
      "zh": "来，我帮你。",
      "pinyin": "Lái, wǒ bāng nǐ.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_046",
      "speaker": "刘梅",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_047",
      "speaker": "张雨桐",
      "zh": "好，这次没问题了。",
      "pinyin": "Hǎo, zhècì méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_048",
      "speaker": "张乐乐",
      "zh": "好，总算弄好了。",
      "pinyin": "Hǎo, zǒngsuàn nòng hǎo le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_051",
      "speaker": "张雨桐",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "Èn, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_052",
      "speaker": "张乐乐",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_053",
      "speaker": "张伟",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_054",
      "speaker": "刘梅",
      "zh": "这个春天在这里。",
      "pinyin": "Zhège chūntiān zài zhèlǐ.",
      "tr": "Bu ilkbahar burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_055",
