      "tr": "İlkbaharda hava çok ılık."
    },
    {
      "id": "DLG_ZH_HSK2_SC048_057",
      "speaker": "张伟",
      "zh": "嗯，这个很实用。",
      "pinyin": "Èn, zhège hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
