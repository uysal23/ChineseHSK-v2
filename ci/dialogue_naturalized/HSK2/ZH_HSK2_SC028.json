{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC028",
  "level": "HSK2",
  "sourceTitleZh": "雨桐第一次自己回家",
  "sourceTitleTr": "Yutong İlk Kez Tek Başına Dönüyor",
  "sourceMiniAdventureTr": "Yutong yanlış durakta iner ama telefonla yolu bulur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC028_001",
      "speaker": "张雨桐",
      "zh": "我好像下错站了。",
      "pinyin": "Wǒ hǎoxiàng xià cuò zhàn le.",
      "tr": "Sanırım yanlış durakta indim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_003",
      "speaker": "路人",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_004",
      "speaker": "张雨桐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_005",
      "speaker": "刘梅",
      "zh": "我刚才下错站了。",
      "pinyin": "Wǒ gāngcái xià cuò zhàn le.",
      "tr": "Az önce yanlış durakta indim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_006",
      "speaker": "路人",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_007",
      "speaker": "张雨桐",
      "zh": "嗯，原来如此。",
      "pinyin": "Èn, yuánláirúcǐ.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_008",
      "speaker": "刘梅",
      "zh": "我不太确定方向。",
      "pinyin": "Wǒ bú tài quèdìng fāngxiàng.",
      "tr": "Yönden pek emin değilim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_009",
      "speaker": "路人",
      "zh": "嗯，这个我记住了。",
      "pinyin": "Èn, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_010",
      "speaker": "张雨桐",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_011",
      "speaker": "刘梅",
      "zh": "我们先转。",
      "pinyin": "Wǒmen xiān zhuǎn.",
      "tr": "Önce dönmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_012",
      "speaker": "路人",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_014",
      "speaker": "刘梅",
      "zh": "从这里一直走就到了。",
      "pinyin": "Cóng zhèlǐ yìzhí zǒu jiù dào le.",
      "tr": "Buradan dümdüz gidince ulaşırsın."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_015",
      "speaker": "路人",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_017",
      "speaker": "刘梅",
      "zh": "你先看地图，然后一直走。",
      "pinyin": "Nǐ xiān kàn dìtú, ránhòu yìzhí zǒu.",
      "tr": "Önce haritaya bak, sonra dümdüz yürü."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_018",
      "speaker": "路人",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC028_019",
      "speaker": "张雨桐",
      "zh": "先别急，总会有办法的。",
      "pinyin": "Xiān biéjí, zǒnghuì yǒu bànfǎ de.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_020",
      "speaker": "刘梅",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_021",
      "speaker": "路人",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_022",
      "speaker": "张雨桐",
      "zh": "这个地图在这里。",
      "pinyin": "Zhège dìtú zài zhèlǐ.",
      "tr": "Bu harita burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_024",
      "speaker": "路人",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_025",
      "speaker": "张雨桐",
      "zh": "我们先打电话。",
      "pinyin": "Wǒmen xiān dǎ diànhuà.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_026",
      "speaker": "刘梅",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_027",
      "speaker": "路人",
      "zh": "那我们试试吧。",
      "pinyin": "Nà wǒmen shìshì ba.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_028",
      "speaker": "张雨桐",
      "zh": "这个家在这里。",
      "pinyin": "Zhège jiā zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_029",
      "speaker": "刘梅",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_030",
      "speaker": "路人",
      "zh": "嗯，现在我知道了。",
      "pinyin": "Èn, xiànzài wǒ zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_031",
      "speaker": "张雨桐",
      "zh": "我终于找到了。",
      "pinyin": "Wǒ zhōngyú zhǎodào le.",
      "tr": "Sonunda buldum."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_032",
      "speaker": "刘梅",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_033",
      "speaker": "路人",
      "zh": "这样会更方便。",
      "pinyin": "Zhèyàng huì gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_034",
      "speaker": "张雨桐",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_036",
      "speaker": "路人",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_037",
      "speaker": "张雨桐",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_038",
      "speaker": "刘梅",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_039",
      "speaker": "路人",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_040",
      "speaker": "张雨桐",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_042",
      "speaker": "路人",
      "zh": "你看，现在好多了。",
      "pinyin": "Nǐ kàn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_043",
      "speaker": "张雨桐",
      "zh": "就差一点了。",
      "pinyin": "Jiù chàyìdiǎn le.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_044",
      "speaker": "刘梅",
      "zh": "来，我帮你。",
      "pinyin": "Lái, wǒ bāng nǐ.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_045",
      "speaker": "路人",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_047",
      "speaker": "刘梅",
      "zh": "这次应该没问题了。",
      "pinyin": "Zhècì yīnggāi méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_048",
      "speaker": "路人",
      "zh": "终于解决了，太好了。",
      "pinyin": "Zhōngyú jiějué le, tàihǎole.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_049",
      "speaker": "张雨桐",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_051",
      "speaker": "路人",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_052",
      "speaker": "张雨桐",
      "zh": "那就这么定吧。",
      "pinyin": "Nà jiù zhème dìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_053",
      "speaker": "刘梅",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_054",
      "speaker": "路人",
      "zh": "我刚才下错站了。",
      "pinyin": "Wǒ gāngcái xià cuò zhàn le.",
      "tr": "Az önce yanlış durakta indim."
    },
