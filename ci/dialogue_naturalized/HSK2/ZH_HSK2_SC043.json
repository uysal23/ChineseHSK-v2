{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC043",
  "level": "HSK2",
  "sourceTitleZh": "爷爷寄来的蔬菜",
  "sourceTitleTr": "Büyükbabanın Sebzeleri",
  "sourceMiniAdventureTr": "Çiftlikten taze sebze kutusu gelir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC043_001",
      "speaker": "张伟",
      "zh": "爷爷从农场寄来一箱蔬菜。",
      "pinyin": "Yéye cóng nóngchǎng jì lái yì xiāng shūcài.",
      "tr": "Büyükbaba çiftlikten bir kutu sebze gönderdi."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_003",
      "speaker": "张乐乐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_004",
      "speaker": "爷爷",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_005",
      "speaker": "张伟",
      "zh": "这个蔬菜在这里。",
      "pinyin": "Zhège shūcài zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_006",
      "speaker": "刘梅",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_007",
      "speaker": "张乐乐",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_008",
      "speaker": "爷爷",
      "zh": "这些菜特别新鲜。",
      "pinyin": "Zhèxiē cài tèbié xīnxiān.",
      "tr": "Bu sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_009",
      "speaker": "张伟",
      "zh": "好，这个我记住了。",
      "pinyin": "Hǎo, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_010",
      "speaker": "刘梅",
      "zh": "这样说就很清楚了。",
      "pinyin": "Zhèyàng shuō jiù hěn qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_011",
      "speaker": "张乐乐",
      "zh": "我们先种。",
      "pinyin": "Wǒmen xiān zhòng.",
      "tr": "Önce yetiştirmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_012",
      "speaker": "爷爷",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_014",
      "speaker": "刘梅",
      "zh": "这个箱子在这里。",
      "pinyin": "Zhège xiāngzi zài zhèlǐ.",
      "tr": "Bu kutu burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_016",
      "speaker": "爷爷",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_017",
      "speaker": "张伟",
      "zh": "这么多，而且特别新鲜。",
      "pinyin": "Zhème duō, érqiě tèbié xīnxiān.",
      "tr": "Bu kadar çok ve üstelik çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_018",
      "speaker": "刘梅",
      "zh": "那接下来怎么办？",
      "pinyin": "Nà jiēxiàlái zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC043_019",
      "speaker": "张乐乐",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_020",
      "speaker": "爷爷",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_022",
      "speaker": "刘梅",
      "zh": "怎么会有这么多？",
      "pinyin": "Zěnme huì yǒu zhème duō?",
      "tr": "Nasıl bu kadar çok olabilir?"
    },
    {
      "id": "DLG_ZH_HSK2_SC043_023",
      "speaker": "张乐乐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_024",
      "speaker": "爷爷",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_025",
      "speaker": "张伟",
      "zh": "农场离这里不远。",
      "pinyin": "Nóngchǎng lí zhèlǐ bù yuǎn.",
      "tr": "Çiftlik buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_026",
      "speaker": "刘梅",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_027",
      "speaker": "张乐乐",
      "zh": "可以，先试试看。",
      "pinyin": "Kěyǐ, xiān shìshìkàn.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_028",
      "speaker": "爷爷",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéye nǎinai jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_029",
      "speaker": "张伟",
      "zh": "我以前还真没注意。",
      "pinyin": "Wǒ yǐqián hái zhēn méi zhùyì.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_030",
      "speaker": "刘梅",
      "zh": "这下知道了。",
      "pinyin": "Zhè xià zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_031",
      "speaker": "张乐乐",
      "zh": "这个食物在这里。",
      "pinyin": "Zhège shíwù zài zhèlǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_032",
      "speaker": "爷爷",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_033",
      "speaker": "张伟",
      "zh": "这样确实更方便。",
      "pinyin": "Zhèyàng quèshí gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_035",
      "speaker": "张乐乐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_036",
      "speaker": "爷爷",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_038",
      "speaker": "刘梅",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_039",
      "speaker": "张乐乐",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_040",
      "speaker": "爷爷",
      "zh": "弄好以后跟我说一声。",
      "pinyin": "Nòng hǎo yǐhòu gēn wǒ shuō yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_042",
      "speaker": "刘梅",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_043",
      "speaker": "张乐乐",
      "zh": "就差一点了。",
      "pinyin": "Jiù chàyìdiǎn le.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_044",
      "speaker": "爷爷",
      "zh": "来，我帮你。",
      "pinyin": "Lái, wǒ bāng nǐ.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_046",
      "speaker": "刘梅",
      "zh": "好，再检查一次。",
      "pinyin": "Hǎo, zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_047",
      "speaker": "张乐乐",
      "zh": "这次应该没问题了。",
      "pinyin": "Zhècì yīnggāi méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_048",
      "speaker": "爷爷",
      "zh": "终于解决了，太好了。",
      "pinyin": "Zhōngyú jiějué le, tàihǎole.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_051",
      "speaker": "张乐乐",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_052",
      "speaker": "爷爷",
      "zh": "那就这么定吧。",
      "pinyin": "Nà jiù zhème dìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_053",
      "speaker": "张伟",
      "zh": "行，我们接着来。",
      "pinyin": "Xíng, wǒmen jiēzhe lái.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_054",
      "speaker": "刘梅",
      "zh": "这个蔬菜在这里。",
      "pinyin": "Zhège shūcài zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC043_055",
