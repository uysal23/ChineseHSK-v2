{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC003",
  "level": "HSK2",
  "sourceTitleZh": "刘梅逛菜市场",
  "sourceTitleTr": "Liu Mei Mahalle Pazarında",
  "sourceMiniAdventureTr": "Liu Mei sebze ve meyve alırken miktar ve fiyat konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC003_001",
      "speaker": "刘梅",
      "zh": "今天的菜很新鲜。",
      "pinyin": "Jīntiān de cài hěn xīnxiān.",
      "tr": "Bugünkü sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_002",
      "speaker": "摊主",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_003",
      "speaker": "邻居",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_004",
      "speaker": "刘梅",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_005",
      "speaker": "摊主",
      "zh": "这个蔬菜在这里。",
      "pinyin": "Zhège shūcài zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_006",
      "speaker": "邻居",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_007",
      "speaker": "刘梅",
      "zh": "哦，原来是这样。",
      "pinyin": "Ò, yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_008",
      "speaker": "摊主",
      "zh": "这个水果在这里。",
      "pinyin": "Zhège shuǐguǒ zài zhèlǐ.",
      "tr": "Bu meyve burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_009",
      "speaker": "邻居",
      "zh": "这个我会记住。",
      "pinyin": "Zhège wǒhuì jìzhù.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_010",
      "speaker": "刘梅",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_011",
      "speaker": "摊主",
      "zh": "这个我要两斤。",
      "pinyin": "Zhège wǒ yào liǎng jīn.",
      "tr": "Bundan bir kilo istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_012",
      "speaker": "邻居",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_014",
      "speaker": "摊主",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_015",
      "speaker": "邻居",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_017",
      "speaker": "摊主",
      "zh": "这个价格有点贵。",
      "pinyin": "Zhège jiàgé yǒudiǎn guì.",
      "tr": "Bu fiyat biraz pahalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_018",
      "speaker": "邻居",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC003_019",
      "speaker": "刘梅",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_020",
      "speaker": "摊主",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_021",
      "speaker": "邻居",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_022",
      "speaker": "刘梅",
      "zh": "这些菜特别新鲜。",
      "pinyin": "Zhèxiē cài tèbié xīnxiān.",
      "tr": "Bu sebzeler çok taze."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_023",
      "speaker": "摊主",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_024",
      "speaker": "邻居",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_025",
      "speaker": "刘梅",
      "zh": "我们先买。",
      "pinyin": "Wǒmen xiān mǎi.",
      "tr": "Önce satın almak."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_026",
      "speaker": "摊主",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_027",
      "speaker": "邻居",
      "zh": "那我们试试吧。",
      "pinyin": "Nà wǒmen shìshì ba.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_028",
      "speaker": "刘梅",
      "zh": "这个蔬菜在这里。",
      "pinyin": "Zhège shūcài zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_029",
      "speaker": "摊主",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_030",
      "speaker": "邻居",
      "zh": "这下知道了。",
      "pinyin": "Zhè xià zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_031",
      "speaker": "刘梅",
      "zh": "这个包在这里。",
      "pinyin": "Zhège bāo zài zhèlǐ.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_032",
      "speaker": "摊主",
      "zh": "对，就是这样。",
      "pinyin": "Duì, jiùshì zhèyàng.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_033",
      "speaker": "邻居",
      "zh": "这样会更方便。",
      "pinyin": "Zhèyàng huì gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_035",
      "speaker": "摊主",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_036",
      "speaker": "邻居",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_038",
      "speaker": "摊主",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_039",
      "speaker": "邻居",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_040",
      "speaker": "刘梅",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_041",
      "speaker": "摊主",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_042",
      "speaker": "邻居",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_043",
      "speaker": "刘梅",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_044",
      "speaker": "摊主",
      "zh": "来，我帮你。",
      "pinyin": "Lái, wǒ bāng nǐ.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_045",
      "speaker": "邻居",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_046",
      "speaker": "刘梅",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_047",
      "speaker": "摊主",
      "zh": "这次应该没问题了。",
      "pinyin": "Zhècì yīnggāi méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_048",
      "speaker": "邻居",
      "zh": "太好了，总算解决了。",
      "pinyin": "Tàihǎole, zǒngsuàn jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_050",
      "speaker": "摊主",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_051",
      "speaker": "邻居",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_052",
      "speaker": "刘梅",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_053",
      "speaker": "摊主",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_054",
      "speaker": "邻居",
      "zh": "这个蔬菜在这里。",
      "pinyin": "Zhège shūcài zài zhèlǐ.",
      "tr": "Bu sebze burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_055",
      "speaker": "刘梅",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_056",
      "speaker": "摊主",
      "zh": "这个水果在这里。",
      "pinyin": "Zhège shuǐguǒ zài zhèlǐ.",
      "tr": "Bu meyve burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_057",
      "speaker": "邻居",
      "zh": "这个确实很实用。",
      "pinyin": "Zhège quèshí hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_058",
      "speaker": "刘梅",
      "zh": "这个我要两斤。",
      "pinyin": "Zhège wǒ yào liǎng jīn.",
      "tr": "Bundan bir kilo istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC003_059",
      "speaker": "摊主",
      "zh": "这个以后还会用到。",
      "pinyin": "Zhège yǐhòu hái huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
