{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC045",
  "level": "HSK2",
  "sourceTitleZh": "张伟的第一次工作评价",
  "sourceTitleTr": "Zhang’ın İlk Performans Görüşmesi",
  "sourceMiniAdventureTr": "Müdürü güçlü ve geliştirmesi gereken yönleri konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC045_001",
      "speaker": "张伟",
      "zh": "今天是第一次工作评价。",
      "pinyin": "Jīntiān shì dì yí cì gōngzuò píngjià.",
      "tr": "Bugün ilk performans değerlendirmesi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_002",
      "speaker": "经理",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_003",
      "speaker": "同事",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_005",
      "speaker": "经理",
      "zh": "今天经理要做工作评价。",
      "pinyin": "Jīntiān jīnglǐ yào zuò gōngzuò píngjià.",
      "tr": "Bugün müdür iş değerlendirmesi yapacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_006",
      "speaker": "同事",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_007",
      "speaker": "张伟",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_008",
      "speaker": "经理",
      "zh": "这个地方以后还可以提高。",
      "pinyin": "Zhège dìfang yǐhòu hái kěyǐ tígāo.",
      "tr": "Bu alan ileride daha da geliştirilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_009",
      "speaker": "同事",
      "zh": "这个我会记住。",
      "pinyin": "Zhège wǒhuì jìzhù.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_010",
      "speaker": "张伟",
      "zh": "嗯，听起来很清楚。",
      "pinyin": "Èn, tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_011",
      "speaker": "经理",
      "zh": "这是你的一个优点。",
      "pinyin": "Zhè shì nǐ de yí ge yōudiǎn.",
      "tr": "Bu senin güçlü yönlerinden biri."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_012",
      "speaker": "同事",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_014",
      "speaker": "经理",
      "zh": "以后我会更注意。",
      "pinyin": "Yǐhòu wǒ huì gèng zhùyì.",
      "tr": "Bundan sonra daha dikkatli olacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_015",
      "speaker": "同事",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_017",
      "speaker": "经理",
      "zh": "你做得不错，但是沟通还可以提高。",
      "pinyin": "Nǐ zuò de búcuò, dànshì gōutōng hái kěyǐ tígāo.",
      "tr": "İyi gidiyorsun ama iletişimini daha da geliştirebilirsin."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_018",
      "speaker": "同事",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC045_019",
      "speaker": "张伟",
      "zh": "别着急，我们先想个办法。",
      "pinyin": "Biézháojí, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_020",
      "speaker": "经理",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_021",
      "speaker": "同事",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_022",
      "speaker": "张伟",
      "zh": "经理今天也来了。",
      "pinyin": "Jīnglǐ jīntiān yě lái le.",
      "tr": "Müdür bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_023",
      "speaker": "经理",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_024",
      "speaker": "同事",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_025",
      "speaker": "张伟",
      "zh": "这个工作在这里。",
      "pinyin": "Zhège gōngzuò zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_026",
      "speaker": "经理",
      "zh": "嗯，这个办法可以。",
      "pinyin": "Èn, zhège bànfǎ kěyǐ.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_027",
      "speaker": "同事",
      "zh": "可以，先试试看。",
      "pinyin": "Kěyǐ, xiān shìshìkàn.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_028",
      "speaker": "张伟",
      "zh": "老师说他进步很大。",
      "pinyin": "Lǎoshī shuō tā jìnbù hěn dà.",
      "tr": "Öğretmen onun çok ilerlediğini söyledi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_029",
      "speaker": "经理",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_030",
      "speaker": "同事",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_031",
      "speaker": "张伟",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_032",
      "speaker": "经理",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_033",
      "speaker": "同事",
      "zh": "这样会更方便。",
      "pinyin": "Zhèyàng huì gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_035",
      "speaker": "经理",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_036",
      "speaker": "同事",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_038",
      "speaker": "经理",
      "zh": "那换个办法吧。",
      "pinyin": "Nà huàn gè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_039",
      "speaker": "同事",
      "zh": "好，你先来。",
      "pinyin": "Hǎo, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_040",
      "speaker": "张伟",
      "zh": "做完了告诉我一声。",
      "pinyin": "Zuò wán le gàosù wǒ yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_041",
      "speaker": "经理",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_042",
      "speaker": "同事",
      "zh": "你看，现在好多了。",
      "pinyin": "Nǐ kàn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_043",
      "speaker": "张伟",
      "zh": "就差一点了。",
      "pinyin": "Jiù chàyìdiǎn le.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_044",
      "speaker": "经理",
      "zh": "要不我来帮你吧。",
      "pinyin": "Yào bù wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_045",
      "speaker": "同事",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_046",
      "speaker": "张伟",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_047",
      "speaker": "经理",
      "zh": "现在看起来没问题了。",
      "pinyin": "Xiànzài kànqǐlái méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_048",
      "speaker": "同事",
      "zh": "终于解决了，太好了。",
      "pinyin": "Zhōngyú jiějué le, tàihǎole.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_050",
      "speaker": "经理",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_051",
      "speaker": "同事",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_052",
      "speaker": "张伟",
      "zh": "那就这么定吧。",
      "pinyin": "Nà jiù zhème dìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_053",
      "speaker": "经理",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_054",
      "speaker": "同事",
      "zh": "今天经理要做工作评价。",
      "pinyin": "Jīntiān jīnglǐ yào zuò gōngzuò píngjià.",
      "tr": "Bugün müdür iş değerlendirmesi yapacak."
    },
