{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC023",
  "level": "HSK2",
  "sourceTitleZh": "刘梅的第一个订单",
  "sourceTitleTr": "Liu Mei’nin İlk Siparişi",
  "sourceMiniAdventureTr": "Komşu özel bir pasta sipariş eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC023_001",
      "speaker": "刘梅",
      "zh": "这是刘梅的第一个蛋糕订单。",
      "pinyin": "Zhè shì Liú Méi de dì yí ge dàngāo dìngdān.",
      "tr": "Bu Liu Mei’nin ilk pasta siparişi."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_002",
      "speaker": "邻居",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_003",
      "speaker": "张伟",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_004",
      "speaker": "刘梅",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_005",
      "speaker": "邻居",
      "zh": "这个订单在这里。",
      "pinyin": "Zhège dìngdān zài zhèlǐ.",
      "tr": "Bu sipariş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_006",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_007",
      "speaker": "刘梅",
      "zh": "嗯，原来如此。",
      "pinyin": "Èn, yuánláirúcǐ.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_008",
      "speaker": "邻居",
      "zh": "这个蛋糕在这里。",
      "pinyin": "Zhège dàngāo zài zhèlǐ.",
      "tr": "Bu pasta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "Èn, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_010",
      "speaker": "刘梅",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_011",
      "speaker": "邻居",
      "zh": "我要大一点的。",
      "pinyin": "Wǒ yào dà yìdiǎn de.",
      "tr": "Biraz daha büyüğünü istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_012",
      "speaker": "张伟",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_014",
      "speaker": "邻居",
      "zh": "有没有小一点的？",
      "pinyin": "Yǒu méiyǒu xiǎo yìdiǎn de?",
      "tr": "Biraz daha küçüğü var mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_015",
      "speaker": "张伟",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_017",
      "speaker": "邻居",
      "zh": "蛋糕要多大？几个人吃？",
      "pinyin": "Dàngāo yào duō dà? Jǐ ge rén chī?",
      "tr": "Pasta ne kadar büyük olsun? Kaç kişi yiyecek?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_018",
      "speaker": "张伟",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_019",
      "speaker": "刘梅",
      "zh": "别着急，我们先想个办法。",
      "pinyin": "Biézháojí, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_020",
      "speaker": "邻居",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_022",
      "speaker": "刘梅",
      "zh": "一共几个人？",
      "pinyin": "Yígòng jǐ ge rén?",
      "tr": "Toplam kaç kişi?"
    },
    {
      "id": "DLG_ZH_HSK2_SC023_023",
      "speaker": "邻居",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_024",
      "speaker": "张伟",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_025",
      "speaker": "刘梅",
      "zh": "明天是邻居的生日。",
      "pinyin": "Míngtiān shì línjū de shēngrì.",
      "tr": "Yarın komşunun doğum günü."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_026",
      "speaker": "邻居",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_027",
      "speaker": "张伟",
      "zh": "我们先试一下。",
      "pinyin": "Wǒmen xiān shìyīxià.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_028",
      "speaker": "刘梅",
      "zh": "这个价格可以接受。",
      "pinyin": "Zhège jiàgé kěyǐ jiēshòu.",
      "tr": "Bu fiyat kabul edilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_029",
      "speaker": "邻居",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_030",
      "speaker": "张伟",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_031",
      "speaker": "刘梅",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_032",
      "speaker": "邻居",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_033",
      "speaker": "张伟",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_035",
      "speaker": "邻居",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_036",
      "speaker": "张伟",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_038",
      "speaker": "邻居",
      "zh": "那换个办法吧。",
      "pinyin": "Nà huàn gè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_039",
      "speaker": "张伟",
      "zh": "好，你先来。",
      "pinyin": "Hǎo, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_040",
      "speaker": "刘梅",
      "zh": "弄好以后跟我说一声。",
      "pinyin": "Nòng hǎo yǐhòu gēn wǒ shuō yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_041",
      "speaker": "邻居",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_042",
      "speaker": "张伟",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_043",
      "speaker": "刘梅",
      "zh": "嗯，还差一点。",
      "pinyin": "Èn, hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_044",
      "speaker": "邻居",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_046",
      "speaker": "刘梅",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_047",
      "speaker": "邻居",
      "zh": "现在看起来没问题了。",
      "pinyin": "Xiànzài kànqǐlái méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_048",
      "speaker": "张伟",
      "zh": "好，总算弄好了。",
      "pinyin": "Hǎo, zǒngsuàn nòng hǎo le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_050",
      "speaker": "邻居",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_051",
      "speaker": "张伟",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "Èn, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_052",
      "speaker": "刘梅",
      "zh": "好，那就这么决定。",
      "pinyin": "Hǎo, nà jiù zhème juédìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_053",
      "speaker": "邻居",
      "zh": "行，我们接着来。",
      "pinyin": "Xíng, wǒmen jiēzhe lái.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_054",
      "speaker": "张伟",
      "zh": "这个订单在这里。",
      "pinyin": "Zhège dìngdān zài zhèlǐ.",
      "tr": "Bu sipariş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_055",
      "speaker": "刘梅",
      "zh": "嗯，我记住了。",
      "pinyin": "Èn, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_056",
      "speaker": "邻居",
      "zh": "这个蛋糕在这里。",
      "pinyin": "Zhège dàngāo zài zhèlǐ.",
      "tr": "Bu pasta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC023_057",
      "speaker": "张伟",
      "zh": "这个确实很实用。",
      "pinyin": "Zhège quèshí hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
