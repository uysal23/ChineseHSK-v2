{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC042",
  "level": "HSK2",
  "sourceTitleZh": "和爷爷奶奶视频",
  "sourceTitleTr": "Büyük Aile Görüntülü Araması",
  "sourceMiniAdventureTr": "Zhang’ın anne-babası görüntülü aramayla yeni evi görür.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC042_001",
      "speaker": "张伟",
      "zh": "爷爷奶奶想看看新家。",
      "pinyin": "Yéye nǎinai xiǎng kànkan xīn jiā.",
      "tr": "Büyükanne ve büyükbaba yeni evi görmek istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_003",
      "speaker": "爷爷",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_004",
      "speaker": "奶奶",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_005",
      "speaker": "张伟",
      "zh": "我们晚上视频吧。",
      "pinyin": "Wǒmen wǎnshang shìpín ba.",
      "tr": "Akşam görüntülü konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_006",
      "speaker": "刘梅",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_007",
      "speaker": "爷爷",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_008",
      "speaker": "奶奶",
      "zh": "你们看得见吗？",
      "pinyin": "Nǐmen kàn de jiàn ma?",
      "tr": "Görebiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "Èn, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_010",
      "speaker": "刘梅",
      "zh": "这样说就很清楚了。",
      "pinyin": "Zhèyàng shuō jiù hěn qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_011",
      "speaker": "爷爷",
      "zh": "你们听得见吗？",
      "pinyin": "Nǐmen tīng de jiàn ma?",
      "tr": "Duyabiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_012",
      "speaker": "奶奶",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_014",
      "speaker": "刘梅",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéye nǎinai jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_015",
      "speaker": "爷爷",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_016",
      "speaker": "奶奶",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_017",
      "speaker": "张伟",
      "zh": "你们看得见吗？听得见吗？",
      "pinyin": "Nǐmen kàn de jiàn ma? Tīng de jiàn ma?",
      "tr": "Bizi görebiliyor ve duyabiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_019",
      "speaker": "爷爷",
      "zh": "别着急，我们先想个办法。",
      "pinyin": "Biézháojí, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_020",
      "speaker": "奶奶",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_022",
      "speaker": "刘梅",
      "zh": "这个屏幕在这里。",
      "pinyin": "Zhège píngmù zài zhèlǐ.",
      "tr": "Bu ekran burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_023",
      "speaker": "爷爷",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_024",
      "speaker": "奶奶",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_025",
      "speaker": "张伟",
      "zh": "这个家在这里。",
      "pinyin": "Zhège jiā zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_027",
      "speaker": "爷爷",
      "zh": "我们先试一下。",
      "pinyin": "Wǒmen xiān shìyīxià.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_028",
      "speaker": "奶奶",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_029",
      "speaker": "张伟",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_031",
      "speaker": "爷爷",
      "zh": "我们先打电话。",
      "pinyin": "Wǒmen xiān dǎ diànhuà.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_032",
      "speaker": "奶奶",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_033",
      "speaker": "张伟",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_035",
      "speaker": "爷爷",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_036",
      "speaker": "奶奶",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_038",
      "speaker": "刘梅",
      "zh": "那换个办法吧。",
      "pinyin": "Nà huàn gè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_039",
      "speaker": "爷爷",
      "zh": "好，你先来。",
      "pinyin": "Hǎo, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_040",
      "speaker": "奶奶",
      "zh": "做完了告诉我一声。",
      "pinyin": "Zuò wán le gàosù wǒ yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_042",
      "speaker": "刘梅",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_043",
      "speaker": "爷爷",
      "zh": "就差一点了。",
      "pinyin": "Jiù chàyìdiǎn le.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_044",
      "speaker": "奶奶",
      "zh": "要不我来帮你吧。",
      "pinyin": "Yào bù wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_046",
      "speaker": "刘梅",
      "zh": "最后再检查一遍。",
      "pinyin": "Zuìhòu zài jiǎnchá yībiàn.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_047",
      "speaker": "爷爷",
      "zh": "好，这次没问题了。",
      "pinyin": "Hǎo, zhècì méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_048",
      "speaker": "奶奶",
      "zh": "终于解决了，太好了。",
      "pinyin": "Zhōngyú jiějué le, tàihǎole.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_051",
      "speaker": "爷爷",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_052",
      "speaker": "奶奶",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_053",
      "speaker": "张伟",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_054",
      "speaker": "刘梅",
      "zh": "我们晚上视频吧。",
      "pinyin": "Wǒmen wǎnshang shìpín ba.",
      "tr": "Akşam görüntülü konuşalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_055",
      "speaker": "爷爷",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_056",
      "speaker": "奶奶",
      "zh": "你们看得见吗？",
      "pinyin": "Nǐmen kàn de jiàn ma?",
      "tr": "Görebiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_057",
      "speaker": "张伟",
      "zh": "这个确实很实用。",
      "pinyin": "Zhège quèshí hěn shíyòng.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC042_058",
      "speaker": "刘梅",
      "zh": "你们听得见吗？",
      "pinyin": "Nǐmen tīng de jiàn ma?",
      "tr": "Duyabiliyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK2_SC042_059",
      "speaker": "爷爷",
      "zh": "以后还用得上。",
      "pinyin": "Yǐhòu hái yòngdéshàng.",
      "tr": "Bunu ileride yine kullanacağız."
    },
