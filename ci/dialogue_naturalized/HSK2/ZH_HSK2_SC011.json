{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC011",
  "level": "HSK2",
  "sourceTitleZh": "第一次家长会",
  "sourceTitleTr": "Okul Veli Toplantısı",
  "sourceMiniAdventureTr": "Liu Mei, Lele’nin öğretmeniyle okul durumu hakkında konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC011_001",
      "speaker": "刘梅",
      "zh": "今天是第一次家长会。",
      "pinyin": "Jīntiān shì dì yí cì jiāzhǎnghuì.",
      "tr": "Bugün ilk veli toplantısı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_002",
      "speaker": "老师",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_003",
      "speaker": "张乐乐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_004",
      "speaker": "刘梅",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_005",
      "speaker": "老师",
      "zh": "今天学校开家长会。",
      "pinyin": "Jīntiān xuéxiào kāi jiāzhǎnghuì.",
      "tr": "Bugün okulda veli toplantısı var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_006",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_007",
      "speaker": "刘梅",
      "zh": "嗯，原来如此。",
      "pinyin": "Èn, yuánláirúcǐ.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_008",
      "speaker": "老师",
      "zh": "老师今天也来了。",
      "pinyin": "Lǎoshī jīntiān yě lái le.",
      "tr": "Öğretmen bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_009",
      "speaker": "张乐乐",
      "zh": "好，这个我记住了。",
      "pinyin": "Hǎo, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_010",
      "speaker": "刘梅",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_011",
      "speaker": "老师",
      "zh": "老师说他进步很大。",
      "pinyin": "Lǎoshī shuō tā jìnbù hěn dà.",
      "tr": "Öğretmen onun çok ilerlediğini söyledi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_012",
      "speaker": "张乐乐",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_013",
      "speaker": "刘梅",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_014",
      "speaker": "老师",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_015",
      "speaker": "张乐乐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_016",
      "speaker": "刘梅",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_017",
      "speaker": "老师",
      "zh": "乐乐有一点不认真。",
      "pinyin": "Lèlè yǒu yìdiǎn bù rènzhēn.",
      "tr": "Lele biraz dikkatsiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_018",
      "speaker": "张乐乐",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC011_019",
      "speaker": "刘梅",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_020",
      "speaker": "老师",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_021",
      "speaker": "张乐乐",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_022",
      "speaker": "刘梅",
      "zh": "我们先学习。",
      "pinyin": "Wǒmen xiān xuéxí.",
      "tr": "Önce ders çalışma."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_023",
      "speaker": "老师",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_024",
      "speaker": "张乐乐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_025",
      "speaker": "刘梅",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_026",
      "speaker": "老师",
      "zh": "嗯，这个办法可以。",
      "pinyin": "Èn, zhège bànfǎ kěyǐ.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_027",
      "speaker": "张乐乐",
      "zh": "那我们试试吧。",
      "pinyin": "Nà wǒmen shìshì ba.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_028",
      "speaker": "刘梅",
      "zh": "这个校车在这里。",
      "pinyin": "Zhège xiàochē zài zhèlǐ.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_029",
      "speaker": "老师",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_030",
      "speaker": "张乐乐",
      "zh": "嗯，现在我知道了。",
      "pinyin": "Èn, xiànzài wǒ zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_031",
      "speaker": "刘梅",
      "zh": "以后我会更注意。",
      "pinyin": "Yǐhòu wǒ huì gèng zhùyì.",
      "tr": "Bundan sonra daha dikkatli olacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_032",
      "speaker": "老师",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_033",
      "speaker": "张乐乐",
      "zh": "这样确实更方便。",
      "pinyin": "Zhèyàng quèshí gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_035",
      "speaker": "老师",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_037",
      "speaker": "刘梅",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_038",
      "speaker": "老师",
      "zh": "那换个办法吧。",
      "pinyin": "Nà huàn gè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_039",
      "speaker": "张乐乐",
      "zh": "行，那你先试。",
      "pinyin": "Xíng, nà nǐ xiān shì.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_040",
      "speaker": "刘梅",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_041",
      "speaker": "老师",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_042",
      "speaker": "张乐乐",
      "zh": "嗯，现在好多了。",
      "pinyin": "Èn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_043",
      "speaker": "刘梅",
      "zh": "还差一点儿。",
      "pinyin": "Hái chàyìdiǎner.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_044",
      "speaker": "老师",
      "zh": "要不我来帮你吧。",
      "pinyin": "Yào bù wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_045",
      "speaker": "张乐乐",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_046",
      "speaker": "刘梅",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_047",
      "speaker": "老师",
      "zh": "这次应该没问题了。",
      "pinyin": "Zhècì yīnggāi méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_048",
      "speaker": "张乐乐",
      "zh": "太好了，总算解决了。",
      "pinyin": "Tàihǎole, zǒngsuàn jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_049",
      "speaker": "刘梅",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_050",
      "speaker": "老师",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_051",
      "speaker": "张乐乐",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_052",
      "speaker": "刘梅",
      "zh": "好，那就这么决定。",
      "pinyin": "Hǎo, nà jiù zhème juédìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_053",
      "speaker": "老师",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_054",
      "speaker": "张乐乐",
      "zh": "今天学校开家长会。",
      "pinyin": "Jīntiān xuéxiào kāi jiāzhǎnghuì.",
      "tr": "Bugün okulda veli toplantısı var."
    },
    {
      "id": "DLG_ZH_HSK2_SC011_055",
