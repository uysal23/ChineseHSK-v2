{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC020",
  "level": "HSK2",
  "sourceTitleZh": "家庭电影之夜",
  "sourceTitleTr": "Ailece Film Gecesi",
  "sourceMiniAdventureTr": "Herkes farklı film izlemek ister ve ortak seçim yapar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC020_001",
      "speaker": "张伟",
      "zh": "今晚我们一起看电影。",
      "pinyin": "Jīnwǎn wǒmen yìqǐ kàn diànyǐng.",
      "tr": "Bu akşam birlikte film izleyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_003",
      "speaker": "张雨桐",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_004",
      "speaker": "张乐乐",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_005",
      "speaker": "张伟",
      "zh": "这个电影在这里。",
      "pinyin": "Zhège diànyǐng zài zhèlǐ.",
      "tr": "Bu film burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_006",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_007",
      "speaker": "张雨桐",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_008",
      "speaker": "张乐乐",
      "zh": "我想听听你的意见。",
      "pinyin": "Wǒ xiǎng tīngting nǐ de yìjiàn.",
      "tr": "Fikrini duymak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_009",
      "speaker": "张伟",
      "zh": "嗯，这个我记住了。",
      "pinyin": "Èn, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_010",
      "speaker": "刘梅",
      "zh": "嗯，听起来很清楚。",
      "pinyin": "Èn, tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_011",
      "speaker": "张雨桐",
      "zh": "这个电影真的很好笑。",
      "pinyin": "Zhège diànyǐng zhēn de hěn hǎoxiào.",
      "tr": "Bu film gerçekten çok komik."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_012",
      "speaker": "张乐乐",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_014",
      "speaker": "刘梅",
      "zh": "这个故事很有意思。",
      "pinyin": "Zhège gùshi hěn yǒuyìsi.",
      "tr": "Bu hikâye çok ilginç."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_017",
      "speaker": "张伟",
      "zh": "大家想看的电影都不一样。",
      "pinyin": "Dàjiā xiǎng kàn de diànyǐng dōu bù yíyàng.",
      "tr": "Herkes farklı bir film izlemek istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_018",
      "speaker": "刘梅",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC020_019",
      "speaker": "张雨桐",
      "zh": "先别急，总会有办法的。",
      "pinyin": "Xiān biéjí, zǒnghuì yǒu bànfǎ de.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_020",
      "speaker": "张乐乐",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_022",
      "speaker": "刘梅",
      "zh": "我们先决定。",
      "pinyin": "Wǒmen xiān juédìng.",
      "tr": "Önce karar vermek."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_024",
      "speaker": "张乐乐",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_025",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_027",
      "speaker": "张雨桐",
      "zh": "我们先试一下。",
      "pinyin": "Wǒmen xiān shìyīxià.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_028",
      "speaker": "张乐乐",
      "zh": "因为时间不多，我们得快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, wǒmen děi kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olmalıyız."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_029",
      "speaker": "张伟",
      "zh": "我以前还真没注意。",
      "pinyin": "Wǒ yǐqián hái zhēn méi zhùyì.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_030",
      "speaker": "刘梅",
      "zh": "嗯，现在我知道了。",
      "pinyin": "Èn, xiànzài wǒ zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_031",
      "speaker": "张雨桐",
      "zh": "所以我们先解决这个问题。",
      "pinyin": "Suǒyǐ wǒmen xiān jiějué zhège wèntí.",
      "tr": "Bu yüzden önce bu sorunu çözelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_032",
      "speaker": "张乐乐",
      "zh": "你说得对。",
      "pinyin": "Nǐ shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_033",
      "speaker": "张伟",
      "zh": "这样会更方便。",
      "pinyin": "Zhèyàng huì gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_034",
      "speaker": "刘梅",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_035",
      "speaker": "张雨桐",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_036",
      "speaker": "张乐乐",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_038",
      "speaker": "刘梅",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_040",
      "speaker": "张乐乐",
      "zh": "弄好以后跟我说一声。",
      "pinyin": "Nòng hǎo yǐhòu gēn wǒ shuō yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_042",
      "speaker": "刘梅",
      "zh": "你看，现在好多了。",
      "pinyin": "Nǐ kàn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_043",
      "speaker": "张雨桐",
      "zh": "还差一点儿。",
      "pinyin": "Hái chàyìdiǎner.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_046",
      "speaker": "刘梅",
      "zh": "我们再检查一遍吧。",
      "pinyin": "Wǒmen zài jiǎnchá yībiàn ba.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_047",
      "speaker": "张雨桐",
      "zh": "现在看起来没问题了。",
      "pinyin": "Xiànzài kànqǐlái méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_048",
      "speaker": "张乐乐",
      "zh": "好，总算弄好了。",
      "pinyin": "Hǎo, zǒngsuàn nòng hǎo le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_051",
      "speaker": "张雨桐",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_052",
      "speaker": "张乐乐",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_053",
      "speaker": "张伟",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_054",
      "speaker": "刘梅",
      "zh": "这个电影在这里。",
      "pinyin": "Zhège diànyǐng zài zhèlǐ.",
      "tr": "Bu film burada."
