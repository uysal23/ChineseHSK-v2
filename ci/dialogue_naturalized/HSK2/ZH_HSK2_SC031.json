{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC031",
  "level": "HSK2",
  "sourceTitleZh": "去银行开户",
  "sourceTitleTr": "Bankada Yeni Hesap",
  "sourceMiniAdventureTr": "Zhang bazı belgeleri unuttuğunu fark eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC031_001",
      "speaker": "张伟",
      "zh": "我想开一个银行账户。",
      "pinyin": "Wǒ xiǎng kāi yí ge yínháng zhànghù.",
      "tr": "Bir banka hesabı açmak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_002",
      "speaker": "银行工作人员",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_005",
      "speaker": "银行工作人员",
      "zh": "这个账户在这里。",
      "pinyin": "Zhège zhànghù zài zhèlǐ.",
      "tr": "Bu hesap burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_006",
      "speaker": "刘梅",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_007",
      "speaker": "张伟",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_008",
      "speaker": "银行工作人员",
      "zh": "这个身份证在这里。",
      "pinyin": "Zhège shēnfènzhèng zài zhèlǐ.",
      "tr": "Bu kimlik kartı burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_009",
      "speaker": "刘梅",
      "zh": "这个我会记住。",
      "pinyin": "Zhège wǒhuì jìzhù.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_010",
      "speaker": "张伟",
      "zh": "这样说就很清楚了。",
      "pinyin": "Zhèyàng shuō jiù hěn qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_011",
      "speaker": "银行工作人员",
      "zh": "这个表格在这里。",
      "pinyin": "Zhège biǎogé zài zhèlǐ.",
      "tr": "Bu form burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_012",
      "speaker": "刘梅",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_014",
      "speaker": "银行工作人员",
      "zh": "我们先签字。",
      "pinyin": "Wǒmen xiān qiānzì.",
      "tr": "Önce imza atmak."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_017",
      "speaker": "银行工作人员",
      "zh": "还需要身份证和一份材料。",
      "pinyin": "Hái xūyào shēnfènzhèng hé yí fèn cáiliào.",
      "tr": "Kimlik ve bir evrak daha gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_018",
      "speaker": "刘梅",
      "zh": "好，那我们现在怎么做？",
      "pinyin": "Hǎo, nà wǒmen xiànzài zěnme zuò?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC031_019",
      "speaker": "张伟",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_020",
      "speaker": "银行工作人员",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_022",
      "speaker": "张伟",
      "zh": "这个材料在这里。",
      "pinyin": "Zhège cáiliào zài zhèlǐ.",
      "tr": "Bu belge / evrak burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_023",
      "speaker": "银行工作人员",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_025",
      "speaker": "张伟",
      "zh": "银行离这里不远。",
      "pinyin": "Yínháng lí zhèlǐ bù yuǎn.",
      "tr": "Banka buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_026",
      "speaker": "银行工作人员",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_027",
      "speaker": "刘梅",
      "zh": "那我们试试吧。",
      "pinyin": "Nà wǒmen shìshì ba.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_028",
      "speaker": "张伟",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_029",
      "speaker": "银行工作人员",
      "zh": "之前我都没发现。",
      "pinyin": "Zhīqián wǒ dōu méi fāxiàn.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_030",
      "speaker": "刘梅",
      "zh": "嗯，现在我知道了。",
      "pinyin": "Èn, xiànzài wǒ zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_031",
      "speaker": "张伟",
      "zh": "我们先检查。",
      "pinyin": "Wǒmen xiān jiǎnchá.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_032",
      "speaker": "银行工作人员",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_033",
      "speaker": "刘梅",
      "zh": "这样确实更方便。",
      "pinyin": "Zhèyàng quèshí gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_035",
      "speaker": "银行工作人员",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_038",
      "speaker": "银行工作人员",
      "zh": "那换个办法吧。",
      "pinyin": "Nà huàn gè bànfǎ ba.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_039",
      "speaker": "刘梅",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_040",
      "speaker": "张伟",
      "zh": "做完以后记得告诉我。",
      "pinyin": "Zuò wán yǐhòu jìde gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_041",
      "speaker": "银行工作人员",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_042",
      "speaker": "刘梅",
      "zh": "你看，现在好多了。",
      "pinyin": "Nǐ kàn, xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_043",
      "speaker": "张伟",
      "zh": "还差一点儿。",
      "pinyin": "Hái chàyìdiǎner.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_044",
      "speaker": "银行工作人员",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_046",
      "speaker": "张伟",
      "zh": "好，再检查一次。",
      "pinyin": "Hǎo, zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_047",
      "speaker": "银行工作人员",
      "zh": "好，这次没问题了。",
      "pinyin": "Hǎo, zhècì méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_048",
      "speaker": "刘梅",
      "zh": "太好了，总算解决了。",
      "pinyin": "Tàihǎole, zǒngsuàn jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_050",
      "speaker": "银行工作人员",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_051",
      "speaker": "刘梅",
      "zh": "嗯，我也是这么想的。",
      "pinyin": "Èn, wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_052",
      "speaker": "张伟",
      "zh": "那我们就这么定。",
      "pinyin": "Nà wǒmen jiù zhème dìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC031_053",
      "speaker": "银行工作人员",
      "zh": "行，我们接着来。",
      "pinyin": "Xíng, wǒmen jiēzhe lái.",
      "tr": "Tamam, devam edelim."
    },
