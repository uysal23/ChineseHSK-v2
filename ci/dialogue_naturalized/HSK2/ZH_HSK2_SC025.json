{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC025",
  "level": "HSK2",
  "sourceTitleZh": "和李晨喝茶",
  "sourceTitleTr": "Li Chen ile Çay",
  "sourceMiniAdventureTr": "İki arkadaş yeni şehirdeki hayatlarını değerlendirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC025_001",
      "speaker": "张伟",
      "zh": "我们来新城已经一年了。",
      "pinyin": "Wǒmen lái Xīnchéng yǐjīng yì nián le.",
      "tr": "Yeni şehre geleli bir yıl oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_002",
      "speaker": "李晨",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_005",
      "speaker": "李晨",
      "zh": "以前我们还不太习惯这里。",
      "pinyin": "Yǐqián wǒmen hái bú tài xíguàn zhèlǐ.",
      "tr": "Eskiden buraya pek alışık değildik."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_006",
      "speaker": "刘梅",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_007",
      "speaker": "张伟",
      "zh": "原来是这样啊。",
      "pinyin": "Yuánlái shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_008",
      "speaker": "李晨",
      "zh": "现在我们已经习惯多了。",
      "pinyin": "Xiànzài wǒmen yǐjīng xíguàn duō le.",
      "tr": "Şimdi buraya çok daha fazla alıştık."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_009",
      "speaker": "刘梅",
      "zh": "嗯，这个我记住了。",
      "pinyin": "Èn, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_010",
      "speaker": "张伟",
      "zh": "听你这么说就清楚了。",
      "pinyin": "Tīng nǐ zhème shuō jiù qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_011",
      "speaker": "李晨",
      "zh": "这个已经准备好了。",
      "pinyin": "Zhège yǐjīng zhǔnbèi hǎo le.",
      "tr": "Bu çoktan hazırlandı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_012",
      "speaker": "刘梅",
      "zh": "好，那我们就这么做。",
      "pinyin": "Hǎo, nà wǒmen jiù zhème zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_014",
      "speaker": "李晨",
      "zh": "现在的生活越来越稳定了。",
      "pinyin": "Xiànzài de shēnghuó yuèláiyuè wěndìng le.",
      "tr": "Şimdiki hayat giderek daha düzenli oluyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_017",
      "speaker": "李晨",
      "zh": "以前我们一个朋友也没有。",
      "pinyin": "Yǐqián wǒmen yí ge péngyou yě méiyǒu.",
      "tr": "Önceden hiç arkadaşımız yoktu."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC025_019",
      "speaker": "张伟",
      "zh": "先别急，我们想想办法。",
      "pinyin": "Xiān biéjí, wǒmen xiǎngxiǎng bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_020",
      "speaker": "李晨",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_022",
      "speaker": "张伟",
      "zh": "这个城市在这里。",
      "pinyin": "Zhège chéngshì zài zhèlǐ.",
      "tr": "Bu şehir burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_023",
      "speaker": "李晨",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_025",
      "speaker": "张伟",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyou jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_026",
      "speaker": "李晨",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_027",
      "speaker": "刘梅",
      "zh": "可以，先试试看。",
      "pinyin": "Kěyǐ, xiān shìshìkàn.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_028",
      "speaker": "张伟",
      "zh": "这个工作在这里。",
      "pinyin": "Zhège gōngzuò zài zhèlǐ.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_029",
      "speaker": "李晨",
      "zh": "这个我以前没注意到。",
      "pinyin": "Zhège wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_031",
      "speaker": "张伟",
      "zh": "这个家在这里。",
      "pinyin": "Zhège jiā zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_032",
      "speaker": "李晨",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_033",
      "speaker": "刘梅",
      "zh": "这样会更方便。",
      "pinyin": "Zhèyàng huì gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_035",
      "speaker": "李晨",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_038",
      "speaker": "李晨",
      "zh": "那就换个办法试试。",
      "pinyin": "Nà jiù huàn gè bànfǎ shìshì.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_039",
      "speaker": "刘梅",
      "zh": "可以，你先来吧。",
      "pinyin": "Kěyǐ, nǐ xiān lái ba.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_040",
      "speaker": "张伟",
      "zh": "弄好以后跟我说一声。",
      "pinyin": "Nòng hǎo yǐhòu gēn wǒ shuō yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_041",
      "speaker": "李晨",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_042",
      "speaker": "刘梅",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_043",
      "speaker": "张伟",
      "zh": "还差一点儿。",
      "pinyin": "Hái chàyìdiǎner.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_044",
      "speaker": "李晨",
      "zh": "要不我来帮你吧。",
      "pinyin": "Yào bù wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_046",
      "speaker": "张伟",
      "zh": "最后再检查一遍。",
      "pinyin": "Zuìhòu zài jiǎnchá yībiàn.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_047",
      "speaker": "李晨",
      "zh": "这次应该没问题了。",
      "pinyin": "Zhècì yīnggāi méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_048",
      "speaker": "刘梅",
      "zh": "太好了，总算解决了。",
      "pinyin": "Tàihǎole, zǒngsuàn jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_050",
      "speaker": "李晨",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_051",
      "speaker": "刘梅",
      "zh": "对，我也这么觉得。",
      "pinyin": "Duì, wǒ yě zhème juéde.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_052",
      "speaker": "张伟",
      "zh": "好，那就这么决定。",
      "pinyin": "Hǎo, nà jiù zhème juédìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_053",
      "speaker": "李晨",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC025_054",
