{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK2_SC032",
  "level": "HSK2",
  "sourceTitleZh": "给爷爷奶奶寄包裹",
  "sourceTitleTr": "Postanede Paket",
  "sourceMiniAdventureTr": "Aile büyüklerine hediye paketi gönderir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC032_001",
      "speaker": "张伟",
      "zh": "我们要给爷爷奶奶寄包裹。",
      "pinyin": "Wǒmen yào gěi yéye nǎinai jì bāoguǒ.",
      "tr": "Büyükanne ve büyükbabaya paket göndereceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_002",
      "speaker": "刘梅",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_003",
      "speaker": "邮局工作人员",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_005",
      "speaker": "刘梅",
      "zh": "这个包裹在这里。",
      "pinyin": "Zhège bāoguǒ zài zhèlǐ.",
      "tr": "Bu paket burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_006",
      "speaker": "邮局工作人员",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_007",
      "speaker": "张伟",
      "zh": "嗯，原来如此。",
      "pinyin": "Èn, yuánláirúcǐ.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_008",
      "speaker": "刘梅",
      "zh": "我们先寄。",
      "pinyin": "Wǒmen xiān jì.",
      "tr": "Önce göndermek."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_009",
      "speaker": "邮局工作人员",
      "zh": "嗯，这个我记住了。",
      "pinyin": "Èn, zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_010",
      "speaker": "张伟",
      "zh": "嗯，听起来很清楚。",
      "pinyin": "Èn, tīng qǐlái hěn qīngchǔ.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_011",
      "speaker": "刘梅",
      "zh": "这个地址在这里。",
      "pinyin": "Zhège dìzhǐ zài zhèlǐ.",
      "tr": "Bu adres burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_012",
      "speaker": "邮局工作人员",
      "zh": "好，那就这么来。",
      "pinyin": "Hǎo, nà jiù zhème lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_014",
      "speaker": "刘梅",
      "zh": "大概三天能到。",
      "pinyin": "Dàgài sān tiān néng dào.",
      "tr": "Yaklaşık üç günde ulaşır."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_015",
      "speaker": "邮局工作人员",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_017",
      "speaker": "刘梅",
      "zh": "这个地址写得对吗？",
      "pinyin": "Zhège dìzhǐ xiě de duì ma?",
      "tr": "Bu adres doğru yazılmış mı?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_018",
      "speaker": "邮局工作人员",
      "zh": "那接下来怎么办？",
      "pinyin": "Nà jiēxiàlái zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_019",
      "speaker": "张伟",
      "zh": "别着急，我们先想个办法。",
      "pinyin": "Biézháojí, wǒmen xiān xiǎnggèbànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_020",
      "speaker": "刘梅",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_021",
      "speaker": "邮局工作人员",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_022",
      "speaker": "张伟",
      "zh": "大概几天能到？",
      "pinyin": "Dàgài jǐ tiān néng dào?",
      "tr": "Yaklaşık kaç günde ulaşır?"
    },
    {
      "id": "DLG_ZH_HSK2_SC032_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_024",
      "speaker": "邮局工作人员",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_025",
      "speaker": "张伟",
      "zh": "邮局离这里不远。",
      "pinyin": "Yóujú lí zhèlǐ bù yuǎn.",
      "tr": "Postane buradan uzak değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_026",
      "speaker": "刘梅",
      "zh": "这个主意挺好的。",
      "pinyin": "Zhège zhǔyì tǐng hǎo de.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_027",
      "speaker": "邮局工作人员",
      "zh": "那我们试试吧。",
      "pinyin": "Nà wǒmen shìshì ba.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_028",
      "speaker": "张伟",
      "zh": "爷爷奶奶今天也来了。",
      "pinyin": "Yéye nǎinai jīntiān yě lái le.",
      "tr": "Büyükanne ve büyükbaba bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_029",
      "speaker": "刘梅",
      "zh": "之前我都没发现。",
      "pinyin": "Zhīqián wǒ dōu méi fāxiàn.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_030",
      "speaker": "邮局工作人员",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_031",
      "speaker": "张伟",
      "zh": "这个礼物在这里。",
      "pinyin": "Zhège lǐwù zài zhèlǐ.",
      "tr": "Bu hediye burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_032",
      "speaker": "刘梅",
      "zh": "嗯，说得对。",
      "pinyin": "Èn, shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_033",
      "speaker": "邮局工作人员",
      "zh": "嗯，这样方便多了。",
      "pinyin": "Èn, zhèyàng fāngbiàn duō le.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_035",
      "speaker": "刘梅",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_036",
      "speaker": "邮局工作人员",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_038",
      "speaker": "刘梅",
      "zh": "好，我们换一种办法。",
      "pinyin": "Hǎo, wǒmen huàn yīzhǒng bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_039",
      "speaker": "邮局工作人员",
      "zh": "好，你先来。",
      "pinyin": "Hǎo, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_040",
      "speaker": "张伟",
      "zh": "做完了告诉我一声。",
      "pinyin": "Zuò wán le gàosù wǒ yīshēng.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_042",
      "speaker": "邮局工作人员",
      "zh": "这下好多了。",
      "pinyin": "Zhè xià hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_043",
      "speaker": "张伟",
      "zh": "还差一点儿。",
      "pinyin": "Hái chàyìdiǎner.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_045",
      "speaker": "邮局工作人员",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_046",
      "speaker": "张伟",
      "zh": "好，再检查一次。",
      "pinyin": "Hǎo, zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_047",
      "speaker": "刘梅",
      "zh": "现在看起来没问题了。",
      "pinyin": "Xiànzài kànqǐlái méi wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_048",
      "speaker": "邮局工作人员",
      "zh": "好，总算弄好了。",
      "pinyin": "Hǎo, zǒngsuàn nòng hǎo le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_050",
      "speaker": "刘梅",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_051",
      "speaker": "邮局工作人员",
      "zh": "我的想法也一样。",
      "pinyin": "Wǒ de xiǎngfǎ yě yīyàng.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_052",
      "speaker": "张伟",
      "zh": "好，那就这么决定。",
      "pinyin": "Hǎo, nà jiù zhème juédìng.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_053",
      "speaker": "刘梅",
      "zh": "好，那继续吧。",
      "pinyin": "Hǎo, nà jìxù ba.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_054",
      "speaker": "邮局工作人员",
      "zh": "这个包裹在这里。",
      "pinyin": "Zhège bāoguǒ zài zhèlǐ.",
      "tr": "Bu paket burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_055",
      "speaker": "张伟",
      "zh": "嗯，我记住了。",
      "pinyin": "Èn, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_056",
      "speaker": "刘梅",
      "zh": "我们先寄。",
      "pinyin": "Wǒmen xiān jì.",
      "tr": "Önce göndermek."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_057",
      "speaker": "邮局工作人员",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_058",
      "speaker": "张伟",
      "zh": "这个地址在这里。",
      "pinyin": "Zhège dìzhǐ zài zhèlǐ.",
      "tr": "Bu adres burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC032_059",
      "speaker": "刘梅",
      "zh": "这个以后还会用到。",
      "pinyin": "Zhège yǐhòu hái huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
