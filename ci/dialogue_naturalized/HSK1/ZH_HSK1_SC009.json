    {
      "id": "DLG_ZH_HSK1_SC009_043",
      "speaker": "李晨",
      "zh": "李晨说了正确的路。",
      "pinyin": "Lǐ chén shuō le zhèng què de lù.",
      "tr": "Li Chen doğru yolu söyledi."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_044",
      "speaker": "司机",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_047",
      "speaker": "李晨",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_048",
      "speaker": "司机",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
