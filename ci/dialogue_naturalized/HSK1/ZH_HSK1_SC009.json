      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_088",
      "speaker": "司机",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_089",
      "speaker": "张伟",
      "zh": "城市在哪儿？",
      "pinyin": "Chéng shì zài nǎ ér?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_090",
      "speaker": "刘梅",
      "zh": "城市在那边。",
      "pinyin": "Chéng shì zài nà biān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_091",
      "speaker": "李晨",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_092",
      "speaker": "司机",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_093",
      "speaker": "张伟",
      "zh": "在右边吗？",
      "pinyin": "Zài yòu biān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_094",
      "speaker": "刘梅",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòu biān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_095",
      "speaker": "李晨",
      "zh": "这边走。",
      "pinyin": "Zhè biān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_096",
      "speaker": "司机",
      "zh": "今天学了很多。",
      "pinyin": "Jīn tiān xué le hěn duō.",
      "tr": "Bugün çok şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_097",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_098",
      "speaker": "刘梅",
      "zh": "都好了吗？",
      "pinyin": "Dōu hǎo le ma?",
      "tr": "Her şey tamam mı?"
