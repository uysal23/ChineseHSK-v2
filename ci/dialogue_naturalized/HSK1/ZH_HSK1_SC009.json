{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC009",
  "level": "HSK1",
  "sourceTitleZh": "第一次坐出租车",
  "sourceTitleTr": "İlk Taksi Yolculuğu",
  "sourceMiniAdventureTr": "Taksi şoförü adresi yanlış anlar; Li Chen doğru yolu açıklamaya yardım eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC009_001",
      "speaker": "张伟",
      "zh": "我们坐出租车去新家。",
      "pinyin": "Wǒ men zuò chū zū chē qù xīn jiā.",
      "tr": "Yeni eve taksiyle gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_003",
      "speaker": "李晨",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_004",
      "speaker": "司机",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_006",
      "speaker": "刘梅",
      "zh": "我们坐出租车吗？",
      "pinyin": "Wǒ men zuò chū zū chē ma?",
      "tr": "Taksi ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_007",
      "speaker": "李晨",
      "zh": "对，我们坐出租车。",
      "pinyin": "Duì, wǒ men zuò chū zū chē.",
      "tr": "Evet, taksi ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_008",
      "speaker": "司机",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_009",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_010",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dì zhǐ shì shén me?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_011",
      "speaker": "李晨",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dì zhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_012",
      "speaker": "司机",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_014",
      "speaker": "刘梅",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎ ér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_015",
      "speaker": "李晨",
      "zh": "路在那边。",
      "pinyin": "Lù zài nà biān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_016",
      "speaker": "司机",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_017",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_018",
      "speaker": "刘梅",
      "zh": "你的号码是什么？",
      "pinyin": "Nǐ de hào mǎ shì shén me?",
      "tr": "Numara nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_019",
      "speaker": "李晨",
      "zh": "这是我的号码。",
      "pinyin": "Zhè shì wǒ de hào mǎ.",
      "tr": "Bu benim numara."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_020",
      "speaker": "司机",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_022",
      "speaker": "刘梅",
      "zh": "司机听错了地址。",
      "pinyin": "Sī jī tīng cuò le dì zhǐ.",
      "tr": "Şoför adresi yanlış duydu."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_024",
      "speaker": "司机",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_027",
      "speaker": "李晨",
      "zh": "城市在哪儿？",
      "pinyin": "Chéng shì zài nǎ ér?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_028",
      "speaker": "司机",
      "zh": "城市在那边。",
      "pinyin": "Chéng shì zài nà biān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_029",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_030",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_031",
      "speaker": "李晨",
      "zh": "在右边吗？",
      "pinyin": "Zài yòu biān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_032",
      "speaker": "司机",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòu biān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_033",
      "speaker": "张伟",
      "zh": "这边走。",
      "pinyin": "Zhè biān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_034",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC009_035",
      "speaker": "李晨",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒ biān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC009_036",
      "speaker": "司机",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒ biān.",
      "tr": "Evet, sol taraf."
