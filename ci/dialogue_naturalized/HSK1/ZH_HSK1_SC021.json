{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC021",
  "level": "HSK1",
  "sourceTitleZh": "新高中的校门",
  "sourceTitleTr": "Yeni Lisenin Kapısı",
  "sourceMiniAdventureTr": "Yutong yanlış binaya yönelir ve okul görevlisinden yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC021_001",
      "speaker": "张雨桐",
      "zh": "雨桐第一天去新高中。",
      "pinyin": "Yǔtóng dì yī tiān qù xīn gāozhōng.",
      "tr": "Yutong’un yeni lisede ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_002",
      "speaker": "老师",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_003",
      "speaker": "工作人员",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_004",
      "speaker": "同学",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_005",
      "speaker": "张雨桐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_006",
      "speaker": "老师",
      "zh": "高中呢？",
      "pinyin": "Gāozhōng ne?",
      "tr": "Lise nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_007",
      "speaker": "工作人员",
      "zh": "高中在那边。",
      "pinyin": "Gāozhōng zài nàbian.",
      "tr": "Lise şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_008",
      "speaker": "同学",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_009",
      "speaker": "张雨桐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_010",
      "speaker": "老师",
      "zh": "那学校在哪儿？",
      "pinyin": "Nà xuéxiào zài nǎér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_011",
      "speaker": "工作人员",
      "zh": "学校在那边。",
      "pinyin": "Xuéxiào zài nàbian.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_012",
      "speaker": "同学",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_013",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_014",
      "speaker": "老师",
      "zh": "教室呢？",
      "pinyin": "Jiàoshì ne?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_015",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_016",
      "speaker": "同学",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_017",
      "speaker": "张雨桐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_018",
      "speaker": "老师",
      "zh": "这是我们的学生。",
      "pinyin": "Zhè shì wǒmen de xuésheng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_019",
      "speaker": "工作人员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_020",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_021",
      "speaker": "张雨桐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_022",
      "speaker": "老师",
      "zh": "她走到了错误的楼。",
      "pinyin": "Tā zǒu dào le cuòwù de lóu.",
      "tr": "Yanlış binaya gitti."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_023",
      "speaker": "工作人员",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_024",
      "speaker": "同学",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_025",
      "speaker": "张雨桐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_026",
      "speaker": "老师",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_027",
      "speaker": "工作人员",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_028",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_029",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_030",
      "speaker": "老师",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_031",
      "speaker": "工作人员",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎr?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_032",
      "speaker": "同学",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_033",
      "speaker": "张雨桐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_034",
      "speaker": "老师",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_035",
      "speaker": "工作人员",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_036",
      "speaker": "同学",
      "zh": "嗯，对，这是门。",
      "pinyin": "Èn, duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_037",
      "speaker": "张雨桐",
      "zh": "门呢？放哪儿了？",
      "pinyin": "Mén ne? fàng nǎér le?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_038",
      "speaker": "老师",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_039",
      "speaker": "工作人员",
      "zh": "这是班吗？",
      "pinyin": "Zhè shì bān ma?",
      "tr": "Bu, sınıf / şube mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_040",
      "speaker": "同学",
      "zh": "对，就是班。",
      "pinyin": "Duì, jiùshì bān.",
      "tr": "Evet, bu sınıf / şube."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_041",
      "speaker": "张雨桐",
      "zh": "那班在哪儿？",
      "pinyin": "Nà bān zài nǎér?",
      "tr": "Sınıf / şube nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_042",
      "speaker": "老师",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sınıf / şube burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_043",
      "speaker": "工作人员",
      "zh": "老师告诉她教室在哪儿。",
      "pinyin": "Lǎoshī gàosu tā jiàoshì zài nǎr.",
      "tr": "Öğretmen ona sınıfın nerede olduğunu söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_044",
      "speaker": "同学",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC021_045",
      "speaker": "张雨桐",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_046",
      "speaker": "老师",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_047",
      "speaker": "工作人员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xiàxíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_048",
      "speaker": "同学",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC021_049",
      "speaker": "张雨桐",
      "zh": "高中在哪儿？",
      "pinyin": "Gāozhōng zài nǎr?",
      "tr": "Lise nerede?"
