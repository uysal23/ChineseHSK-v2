  "level": "HSK1",
  "sourceTitleZh": "乐乐的第一天",
  "sourceTitleTr": "Lele’nin İlkokulu",
  "sourceMiniAdventureTr": "Lele annesinden ayrılmak istemez; öğretmen onu rahatlatır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC024_001",
      "speaker": "张乐乐",
      "zh": "乐乐第一天上小学。",
      "pinyin": "Lè lè dì yī tiān shàng xiǎo xué.",
      "tr": "Lele’nin ilkokuldaki ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_003",
      "speaker": "老师",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_004",
      "speaker": "同学",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_006",
      "speaker": "刘梅",
      "zh": "学校在哪儿？",
      "pinyin": "Xué xiào zài nǎ ér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_007",
      "speaker": "老师",
      "zh": "学校在那边。",
      "pinyin": "Xué xiào zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_008",
      "speaker": "同学",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_009",
      "speaker": "张乐乐",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_010",
      "speaker": "刘梅",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒ men de lǎo shī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_011",
      "speaker": "老师",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_012",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_013",
      "speaker": "张乐乐",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_014",
      "speaker": "刘梅",
      "zh": "这是我们的学生。",
      "pinyin": "Zhè shì wǒ men de xué shēng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC024_015",
      "speaker": "老师",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC024_016",
