{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC043",
  "level": "HSK1",
  "sourceTitleZh": "雨桐的第一次考试",
  "sourceTitleTr": "Yutong’un İlk Sınavı",
  "sourceMiniAdventureTr": "Yutong sınavdan önce heyecanlıdır; aile onu destekler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC043_001",
      "speaker": "张雨桐",
      "zh": "雨桐明天有第一次考试。",
      "pinyin": "Yǔ tóng míng tiān yǒu dì yī cì kǎo shì.",
      "tr": "Yutong’un yarın ilk sınavı var."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_003",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_005",
      "speaker": "张雨桐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_006",
      "speaker": "刘梅",
      "zh": "今天有考试吗？",
      "pinyin": "Jīn tiān yǒu kǎo shì ma?",
      "tr": "Bugün sınav var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_007",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_008",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_009",
      "speaker": "张雨桐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_010",
      "speaker": "刘梅",
      "zh": "你在学习吗？",
      "pinyin": "Nǐ zài xué xí ma?",
      "tr": "Ders mi çalışıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_011",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_012",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_013",
      "speaker": "张雨桐",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_014",
      "speaker": "刘梅",
      "zh": "学校在哪儿？",
      "pinyin": "Xué xiào zài nǎ ér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_015",
      "speaker": "张伟",
      "zh": "学校在那边。",
      "pinyin": "Xué xiào zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_016",
      "speaker": "张乐乐",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_017",
      "speaker": "张雨桐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_018",
      "speaker": "刘梅",
      "zh": "这是书吗？",
      "pinyin": "Zhè shì shū ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_019",
      "speaker": "张伟",
      "zh": "对，这是书。",
      "pinyin": "Duì, zhè shì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_020",
      "speaker": "张乐乐",
      "zh": "书在哪儿？",
      "pinyin": "Shū zài nǎ ér?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_021",
      "speaker": "张雨桐",
      "zh": "书在这里。",
      "pinyin": "Shū zài zhè lǐ.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_022",
      "speaker": "刘梅",
      "zh": "她觉得有一点难。",
      "pinyin": "Tā jué dé yǒu yī diǎn nán.",
      "tr": "Biraz zor olduğunu düşünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_023",
      "speaker": "张伟",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_025",
      "speaker": "张雨桐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_027",
      "speaker": "张伟",
      "zh": "这是试卷吗？",
      "pinyin": "Zhè shì shì juǎn ma?",
      "tr": "Bu, sınav kâğıdı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_028",
      "speaker": "张乐乐",
      "zh": "对，这是试卷。",
      "pinyin": "Duì, zhè shì shì juǎn.",
      "tr": "Evet, bu sınav kâğıdı."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_029",
      "speaker": "张雨桐",
      "zh": "试卷在哪儿？",
      "pinyin": "Shì juǎn zài nǎ ér?",
      "tr": "Sınav kâğıdı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_030",
      "speaker": "刘梅",
      "zh": "试卷在这里。",
      "pinyin": "Shì juǎn zài zhè lǐ.",
      "tr": "Sınav kâğıdı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_031",
      "speaker": "张伟",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒ men de lǎo shī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_032",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_033",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_034",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_035",
      "speaker": "张伟",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_036",
      "speaker": "张乐乐",
      "zh": "有点儿。",
      "pinyin": "Yǒu diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_037",
      "speaker": "张雨桐",
      "zh": "没关系，别急。",
      "pinyin": "Méi guān xì, bié jí.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_038",
      "speaker": "刘梅",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_039",
      "speaker": "张伟",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎn shàng yǒu shí jiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_040",
      "speaker": "张乐乐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_041",
      "speaker": "张雨桐",
      "zh": "晚上见。",
      "pinyin": "Wǎn shàng jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_042",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_043",
      "speaker": "张伟",
      "zh": "家人陪她一起学习。",
      "pinyin": "Jiā rén péi tā yī qǐ xué xí.",
      "tr": "Ailesi onunla birlikte çalışıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_045",
      "speaker": "张雨桐",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_047",
      "speaker": "张伟",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_049",
      "speaker": "张雨桐",
      "zh": "今天有考试吗？",
      "pinyin": "Jīn tiān yǒu kǎo shì ma?",
