{
  "naturalizationVersion": 6,
  "sceneId": "ZH_HSK1_SC043",
  "level": "HSK1",
  "sourceTitleZh": "雨桐的第一次考试",
  "sourceTitleTr": "Yutong’un İlk Sınavı",
  "sourceMiniAdventureTr": "Yutong sınavdan önce heyecanlıdır; aile onu destekler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC043_001",
      "speaker": "张雨桐",
      "zh": "雨桐明天有第一次考试。",
      "pinyin": "Yǔtóng míngtiān yǒu dì yī cì kǎoshì.",
      "tr": "Yutong’un yarın ilk sınavı var."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_003",
      "speaker": "张伟",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_005",
      "speaker": "张雨桐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_006",
      "speaker": "刘梅",
      "zh": "今天有考试吗？",
      "pinyin": "Jīntiān yǒu kǎoshì ma?",
      "tr": "Bugün sınav var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_007",
      "speaker": "张伟",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_008",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_009",
      "speaker": "张雨桐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_010",
      "speaker": "刘梅",
      "zh": "你在学习吗？",
      "pinyin": "Nǐ zài xuéxí ma?",
      "tr": "Ders mi çalışıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_011",
      "speaker": "张伟",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_012",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_013",
      "speaker": "张雨桐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_014",
      "speaker": "刘梅",
      "zh": "学校在哪儿？",
      "pinyin": "Xuéxiào zài nǎr?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_015",
      "speaker": "张伟",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_016",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_017",
      "speaker": "张雨桐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_018",
      "speaker": "刘梅",
      "zh": "这是书吗？",
      "pinyin": "Zhè shì shū ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_019",
      "speaker": "张伟",
      "zh": "嗯，对，这是书。",
      "pinyin": "Èn, duì, zhè shì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_020",
      "speaker": "张乐乐",
      "zh": "书呢？",
      "pinyin": "Shū ne?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_021",
      "speaker": "张雨桐",
      "zh": "书在这儿。",
      "pinyin": "Shū zài zhèr.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_022",
      "speaker": "刘梅",
      "zh": "她觉得有一点难。",
      "pinyin": "Tā juéde yǒu yìdiǎn nán.",
      "tr": "Biraz zor olduğunu düşünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_023",
      "speaker": "张伟",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_025",
      "speaker": "张雨桐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_027",
      "speaker": "张伟",
      "zh": "这是试卷，对吗？",
      "pinyin": "Zhè shì shì juàn, duì ma?",
      "tr": "Bu, sınav kâğıdı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_028",
      "speaker": "张乐乐",
      "zh": "没错，是试卷。",
      "pinyin": "Méi cuò, shì shì juàn.",
      "tr": "Evet, bu sınav kâğıdı."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_029",
      "speaker": "张雨桐",
      "zh": "试卷呢？",
      "pinyin": "Shì juàn ne?",
      "tr": "Sınav kâğıdı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_030",
      "speaker": "刘梅",
      "zh": "试卷在这儿。",
      "pinyin": "Shì juàn zài zhèr.",
      "tr": "Sınav kâğıdı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_031",
      "speaker": "张伟",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_032",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_033",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_034",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_035",
      "speaker": "张伟",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_036",
      "speaker": "张乐乐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_037",
      "speaker": "张雨桐",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_038",
      "speaker": "刘梅",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_039",
      "speaker": "张伟",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎnshang yǒu shíjiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_040",
      "speaker": "张乐乐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_041",
      "speaker": "张雨桐",
      "zh": "晚上见。",
      "pinyin": "Wǎnshang jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_042",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_043",
      "speaker": "张伟",
      "zh": "家人陪她一起学习。",
      "pinyin": "Jiārén péi tā yìqǐ xuéxí.",
      "tr": "Ailesi onunla birlikte çalışıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC043_045",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bú kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_047",
      "speaker": "张伟",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC043_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
