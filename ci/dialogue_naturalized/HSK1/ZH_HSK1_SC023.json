{
  "naturalizationVersion": 4,
  "sceneId": "ZH_HSK1_SC023",
  "level": "HSK1",
  "sourceTitleZh": "第一个新朋友",
  "sourceTitleTr": "İlk Yeni Arkadaş",
  "sourceMiniAdventureTr": "Bir öğrenci Yutong’u öğle yemeğine davet eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC023_001",
      "speaker": "张雨桐",
      "zh": "雨桐认识了一个新朋友。",
      "pinyin": "Yǔtóng rènshi le yí ge xīn péngyou.",
      "tr": "Yutong yeni bir arkadaş edindi."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_002",
      "speaker": "同学",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_003",
      "speaker": "同学",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_004",
      "speaker": "老师",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_005",
      "speaker": "张雨桐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_006",
      "speaker": "同学",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_007",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_008",
      "speaker": "老师",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_009",
      "speaker": "张雨桐",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_010",
      "speaker": "同学",
      "zh": "你要午饭吗？",
      "pinyin": "Nǐ yào wǔfàn ma?",
      "tr": "Öğle yemeği ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_011",
      "speaker": "同学",
      "zh": "我要午饭，谢谢。",
      "pinyin": "Wǒ yào wǔfàn, xièxie.",
      "tr": "Öğle yemeği istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_012",
      "speaker": "老师",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_013",
      "speaker": "张雨桐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_014",
      "speaker": "同学",
      "zh": "这是我们的学生。",
      "pinyin": "Zhè shì wǒmen de xuésheng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_015",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_016",
      "speaker": "老师",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_017",
      "speaker": "张雨桐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_018",
      "speaker": "同学",
      "zh": "学校在哪儿？",
      "pinyin": "Xuéxiào zài nǎr?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_019",
      "speaker": "同学",
      "zh": "学校在那边。",
      "pinyin": "Xuéxiào zài nàbian.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_020",
      "speaker": "老师",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_021",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_022",
      "speaker": "同学",
      "zh": "她不知道午饭和谁一起吃。",
      "pinyin": "Tā bù zhīdào wǔfàn hé shéi yìqǐ chī.",
      "tr": "Öğle yemeğini kiminle yiyeceğini bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_023",
      "speaker": "同学",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_024",
      "speaker": "老师",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_025",
      "speaker": "张雨桐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_026",
      "speaker": "同学",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_027",
      "speaker": "同学",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_028",
      "speaker": "老师",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xièxie.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_029",
      "speaker": "张雨桐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_030",
      "speaker": "同学",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_031",
      "speaker": "同学",
      "zh": "那教室在哪儿？",
      "pinyin": "Nà jiào shì zài nǎr?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_032",
      "speaker": "老师",
      "zh": "教室在那边。",
      "pinyin": "Jiàoshì zài nàbian.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_033",
      "speaker": "张雨桐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_034",
      "speaker": "同学",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_035",
      "speaker": "同学",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzi shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_036",
      "speaker": "老师",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzi.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_037",
      "speaker": "张雨桐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_038",
      "speaker": "同学",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_039",
      "speaker": "同学",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_040",
      "speaker": "老师",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_041",
      "speaker": "张雨桐",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_042",
      "speaker": "同学",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_043",
      "speaker": "同学",
      "zh": "新朋友请她一起吃午饭。",
      "pinyin": "Xīn péngyou qǐng tā yìqǐ chī wǔfàn.",
      "tr": "Yeni arkadaşı onu birlikte öğle yemeğine çağırıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_044",
      "speaker": "老师",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC023_045",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_046",
      "speaker": "同学",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC023_047",
      "speaker": "同学",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
