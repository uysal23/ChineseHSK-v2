    {
      "id": "DLG_ZH_HSK1_SC013_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_048",
      "speaker": "张伟",
      "zh": "好，继续。",
