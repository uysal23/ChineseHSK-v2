{
  "naturalizationVersion": 4,
  "sceneId": "ZH_HSK1_SC013",
  "level": "HSK1",
  "sourceTitleZh": "咪咪在柜子旁边",
  "sourceTitleTr": "Mimi Dolapta",
  "sourceMiniAdventureTr": "Mimi mutfak dolabının yanında bulunur ve çocuklar rahatlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC013_001",
      "speaker": "张乐乐",
      "zh": "我们还在找咪咪。",
      "pinyin": "Wǒmen hái zài zhǎo Mīmī.",
      "tr": "Mimi’yi hâlâ arıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_004",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_006",
      "speaker": "刘梅",
      "zh": "这个是猫吗？",
      "pinyin": "Zhè ge shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_007",
      "speaker": "张雨桐",
      "zh": "没错，是猫。",
      "pinyin": "Méi cuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_008",
      "speaker": "张伟",
      "zh": "那猫在哪儿？",
      "pinyin": "Nà māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_009",
      "speaker": "张乐乐",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèr.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_010",
      "speaker": "刘梅",
      "zh": "这是柜子吗？",
      "pinyin": "Zhè shì guìzi ma?",
      "tr": "Bu, dolap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_011",
      "speaker": "张雨桐",
      "zh": "对，就是柜子。",
      "pinyin": "Duì, jiù shì guì zi.",
      "tr": "Evet, bu dolap."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_012",
      "speaker": "张伟",
      "zh": "柜子在哪儿？",
      "pinyin": "Guìzi zài nǎr?",
      "tr": "Dolap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_013",
      "speaker": "张乐乐",
      "zh": "你看，柜子在这儿。",
      "pinyin": "Nǐ kàn, guì zi zài zhèr.",
      "tr": "Dolap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_014",
      "speaker": "刘梅",
      "zh": "厨房在哪儿？",
      "pinyin": "Chúfáng zài nǎr?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_015",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_016",
      "speaker": "张伟",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_017",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_018",
      "speaker": "刘梅",
      "zh": "这个是桌子吗？",
      "pinyin": "Zhè ge shì zhuō zi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_019",
      "speaker": "张雨桐",
      "zh": "没错，是桌子。",
      "pinyin": "Méi cuò, shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_020",
      "speaker": "张伟",
      "zh": "桌子呢？",
      "pinyin": "Zhuō zi ne?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_021",
      "speaker": "张乐乐",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuō zi zài zhèr.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_022",
      "speaker": "刘梅",
      "zh": "厨房里有声音。",
      "pinyin": "Chúfáng lǐ yǒu shēngyīn.",
      "tr": "Mutfaktan bir ses geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_027",
      "speaker": "张雨桐",
      "zh": "这个是椅子吗？",
      "pinyin": "Zhè ge shì yǐ zi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_028",
      "speaker": "张伟",
      "zh": "没错，是椅子。",
      "pinyin": "Méi cuò, shì yǐ zi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_029",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎr?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_030",
      "speaker": "刘梅",
      "zh": "你看，椅子在这儿。",
      "pinyin": "Nǐ kàn, yǐ zi zài zhèr.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_031",
      "speaker": "张雨桐",
      "zh": "房间呢？",
      "pinyin": "Fáng jiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_032",
      "speaker": "张伟",
      "zh": "你看，房间在那边。",
      "pinyin": "Nǐ kàn, fáng jiān zài nà biān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_033",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_035",
      "speaker": "张雨桐",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_036",
      "speaker": "张伟",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_037",
      "speaker": "张乐乐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_038",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
