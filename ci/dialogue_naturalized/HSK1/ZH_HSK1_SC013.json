{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC013",
  "level": "HSK1",
  "sourceTitleZh": "咪咪在柜子旁边",
  "sourceTitleTr": "Mimi Dolapta",
  "sourceMiniAdventureTr": "Mimi mutfak dolabının yanında bulunur ve çocuklar rahatlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC013_001",
      "speaker": "张乐乐",
      "zh": "我们还在找咪咪。",
      "pinyin": "Wǒmen hái zài zhǎo Mīmī.",
      "tr": "Mimi’yi hâlâ arıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_004",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_005",
      "speaker": "张乐乐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_006",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_007",
      "speaker": "张雨桐",
      "zh": "没错，是猫。",
      "pinyin": "Méicuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_008",
      "speaker": "张伟",
      "zh": "那猫放在哪儿？",
      "pinyin": "Nà māo fàngzài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_009",
      "speaker": "张乐乐",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_010",
      "speaker": "刘梅",
      "zh": "这是柜子吗？",
      "pinyin": "Zhè shì guìzi ma?",
      "tr": "Bu, dolap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_011",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是柜子。",
      "pinyin": "Èn, duì, zhè shì guìzi.",
      "tr": "Evet, bu dolap."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_012",
      "speaker": "张伟",
      "zh": "柜子在哪儿？",
      "pinyin": "Guìzi zài nǎr?",
      "tr": "Dolap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_013",
      "speaker": "张乐乐",
      "zh": "你看，柜子在这儿。",
      "pinyin": "Nǐ kàn, guìzi zài zhèér.",
      "tr": "Dolap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_014",
      "speaker": "刘梅",
      "zh": "厨房呢？",
      "pinyin": "Chúfáng ne?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_015",
      "speaker": "张雨桐",
      "zh": "你看，厨房在那边。",
      "pinyin": "Nǐ kàn, chúfáng zài nàbiān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_016",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_017",
      "speaker": "张乐乐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_018",
      "speaker": "刘梅",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_019",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是桌子。",
      "pinyin": "Èn, duì, zhè shì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_020",
      "speaker": "张伟",
      "zh": "那桌子放在哪儿？",
      "pinyin": "Nà zhuōzi fàngzài nǎér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_021",
      "speaker": "张乐乐",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_022",
      "speaker": "刘梅",
      "zh": "厨房里有声音。",
      "pinyin": "Chúfáng lǐ yǒu shēngyīn.",
      "tr": "Mutfaktan bir ses geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_023",
      "speaker": "张雨桐",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_024",
      "speaker": "张伟",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ láikàn kànba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_027",
      "speaker": "张雨桐",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_028",
      "speaker": "张伟",
      "zh": "没错，是椅子。",
      "pinyin": "Méicuò, shì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_029",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎr?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_030",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_031",
      "speaker": "张雨桐",
      "zh": "那房间在哪儿？",
      "pinyin": "Nà fángjiān zài nǎér?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_032",
      "speaker": "张伟",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_033",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_035",
      "speaker": "张雨桐",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_036",
      "speaker": "张伟",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_037",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_038",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_039",
      "speaker": "张雨桐",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_040",
      "speaker": "张伟",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiùshì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_041",
      "speaker": "张乐乐",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎr?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_043",
      "speaker": "张雨桐",
      "zh": "咪咪在柜子旁边。",
      "pinyin": "Mīmī zài guìzi pángbiān.",
      "tr": "Mimi dolabın yanında."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_044",
      "speaker": "张伟",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_045",
      "speaker": "张乐乐",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_047",
      "speaker": "张雨桐",
      "zh": "现在就好了。",
      "pinyin": "Xiànzài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_048",
      "speaker": "张伟",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
