{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC013",
  "level": "HSK1",
  "sourceTitleZh": "咪咪在柜子旁边",
  "sourceTitleTr": "Mimi Dolapta",
  "sourceMiniAdventureTr": "Mimi mutfak dolabının yanında bulunur ve çocuklar rahatlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC013_001",
      "speaker": "张乐乐",
      "zh": "我们还在找咪咪。",
      "pinyin": "Wǒ men hái zài zhǎo mī mī.",
      "tr": "Mimi’yi hâlâ arıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_004",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_005",
      "speaker": "张乐乐",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_006",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_007",
      "speaker": "张雨桐",
      "zh": "对，这是猫。",
      "pinyin": "Duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_008",
      "speaker": "张伟",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎ ér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_009",
      "speaker": "张乐乐",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhè lǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_010",
      "speaker": "刘梅",
      "zh": "这是柜子吗？",
      "pinyin": "Zhè shì guì zi ma?",
      "tr": "Bu, dolap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_011",
      "speaker": "张雨桐",
      "zh": "对，这是柜子。",
      "pinyin": "Duì, zhè shì guì zi.",
      "tr": "Evet, bu dolap."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_012",
      "speaker": "张伟",
      "zh": "柜子在哪儿？",
      "pinyin": "Guì zi zài nǎ ér?",
      "tr": "Dolap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_013",
      "speaker": "张乐乐",
      "zh": "柜子在这里。",
      "pinyin": "Guì zi zài zhè lǐ.",
      "tr": "Dolap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_014",
      "speaker": "刘梅",
      "zh": "厨房在哪儿？",
      "pinyin": "Chú fáng zài nǎ ér?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_015",
      "speaker": "张雨桐",
      "zh": "厨房在那边。",
      "pinyin": "Chú fáng zài nà biān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_016",
      "speaker": "张伟",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_017",
      "speaker": "张乐乐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_018",
      "speaker": "刘梅",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuō zi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_019",
      "speaker": "张雨桐",
      "zh": "对，这是桌子。",
      "pinyin": "Duì, zhè shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_020",
      "speaker": "张伟",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuō zi zài nǎ ér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_021",
      "speaker": "张乐乐",
      "zh": "桌子在这里。",
      "pinyin": "Zhuō zi zài zhè lǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_022",
      "speaker": "刘梅",
      "zh": "厨房里有声音。",
      "pinyin": "Chú fáng lǐ yǒu shēng yīn.",
      "tr": "Mutfaktan bir ses geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_024",
      "speaker": "张伟",
      "zh": "我看看。",
      "pinyin": "Wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_025",
      "speaker": "张乐乐",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_027",
      "speaker": "张雨桐",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐ zi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC013_028",
      "speaker": "张伟",
      "zh": "对，这是椅子。",
      "pinyin": "Duì, zhè shì yǐ zi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC013_029",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐ zi zài nǎ ér?",
