{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK1_SC017",
  "level": "HSK1",
  "sourceTitleZh": "第一次去超市",
  "sourceTitleTr": "İlk Market Alışverişi",
  "sourceMiniAdventureTr": "Lele sepete fazla atıştırmalık koyar; aile alışveriş listesini kontrol eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC017_001",
      "speaker": "刘梅",
      "zh": "我们第一次去新超市。",
      "pinyin": "Wǒmen dì yí cì qù xīn chāoshì.",
      "tr": "Yeni süpermarkete ilk kez gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_003",
      "speaker": "张乐乐",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_004",
      "speaker": "店员",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_006",
      "speaker": "张伟",
      "zh": "超市呢？",
      "pinyin": "Chāo shì ne?",
      "tr": "Süpermarket nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_007",
      "speaker": "张乐乐",
      "zh": "你看，超市在那边。",
      "pinyin": "Nǐ kàn, chāo shì zài nà biān.",
      "tr": "Süpermarket şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_008",
      "speaker": "店员",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_009",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_010",
      "speaker": "张伟",
      "zh": "你要苹果吗？",
      "pinyin": "Nǐ yào píngguǒ ma?",
      "tr": "Elma ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_011",
      "speaker": "张乐乐",
      "zh": "我要苹果，谢谢。",
      "pinyin": "Wǒ yào píngguǒ, xièxie.",
      "tr": "Elma istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_012",
      "speaker": "店员",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_013",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_014",
      "speaker": "张伟",
      "zh": "你要牛奶吗？",
      "pinyin": "Nǐ yào niúnǎi ma?",
      "tr": "Süt ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_015",
      "speaker": "张乐乐",
      "zh": "我要牛奶，谢谢。",
      "pinyin": "Wǒ yào niúnǎi, xièxie.",
      "tr": "Süt istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_016",
      "speaker": "店员",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_017",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_018",
      "speaker": "张伟",
      "zh": "你要鸡蛋吗？",
      "pinyin": "Nǐ yào jīdàn ma?",
      "tr": "Yumurta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_019",
      "speaker": "张乐乐",
      "zh": "我要鸡蛋，谢谢。",
      "pinyin": "Wǒ yào jīdàn, xièxie.",
      "tr": "Yumurta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_020",
      "speaker": "店员",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_021",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_022",
      "speaker": "张伟",
      "zh": "乐乐拿了太多东西。",
      "pinyin": "Lèlè ná le tài duō dōngxi.",
      "tr": "Lele çok fazla şey aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_023",
      "speaker": "张乐乐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_024",
      "speaker": "店员",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_026",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_027",
      "speaker": "张乐乐",
      "zh": "你要面包吗？",
      "pinyin": "Nǐ yào miànbāo ma?",
      "tr": "Ekmek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_028",
      "speaker": "店员",
      "zh": "我要面包，谢谢。",
      "pinyin": "Wǒ yào miànbāo, xièxie.",
      "tr": "Ekmek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_029",
      "speaker": "刘梅",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_030",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_031",
      "speaker": "张乐乐",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_032",
      "speaker": "店员",
      "zh": "没错，是钱。",
      "pinyin": "Méi cuò, shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_033",
      "speaker": "刘梅",
      "zh": "钱呢？",
      "pinyin": "Qián ne?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_034",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_035",
      "speaker": "张乐乐",
      "zh": "这个是包吗？",
      "pinyin": "Zhè ge shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_036",
      "speaker": "店员",
      "zh": "对，就是包。",
      "pinyin": "Duì, jiù shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_037",
      "speaker": "刘梅",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_038",
      "speaker": "张伟",
      "zh": "你看，包在这儿。",
      "pinyin": "Nǐ kàn, bāo zài zhèr.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_039",
      "speaker": "张乐乐",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_040",
      "speaker": "店员",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xièxie.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_041",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_042",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_043",
      "speaker": "张乐乐",
      "zh": "我们只买需要的东西。",
      "pinyin": "Wǒmen zhǐ mǎi xūyào de dōngxi.",
      "tr": "Yalnızca ihtiyacımız olan şeyleri alıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_044",
      "speaker": "店员",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC017_045",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_046",
      "speaker": "张伟",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bú kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_047",
      "speaker": "张乐乐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC017_048",
      "speaker": "店员",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
    },
    {
