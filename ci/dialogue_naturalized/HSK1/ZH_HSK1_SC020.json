{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC020",
  "level": "HSK1",
  "sourceTitleZh": "全家福",
  "sourceTitleTr": "Aile Fotoğrafı",
  "sourceMiniAdventureTr": "Aile ilk fotoğrafını çekmeye çalışır; Mimi sürekli yer değiştirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC020_001",
      "speaker": "张伟",
      "zh": "我们要拍全家福。",
      "pinyin": "Wǒ men yào pāi quán jiā fú.",
      "tr": "Aile fotoğrafı çekeceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_006",
      "speaker": "刘梅",
      "zh": "这是照片吗？",
      "pinyin": "Zhè shì zhào piàn ma?",
      "tr": "Bu, fotoğraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_007",
      "speaker": "张雨桐",
      "zh": "对，这是照片。",
      "pinyin": "Duì, zhè shì zhào piàn.",
      "tr": "Evet, bu fotoğraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_008",
      "speaker": "张乐乐",
      "zh": "照片在哪儿？",
      "pinyin": "Zhào piàn zài nǎ ér?",
      "tr": "Fotoğraf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_009",
      "speaker": "张伟",
      "zh": "照片在这里。",
      "pinyin": "Zhào piàn zài zhè lǐ.",
      "tr": "Fotoğraf burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_011",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_013",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_014",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_015",
      "speaker": "张雨桐",
      "zh": "对，这是猫。",
      "pinyin": "Duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_016",
      "speaker": "张乐乐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎ ér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_017",
      "speaker": "张伟",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhè lǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_018",
      "speaker": "刘梅",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐ zi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_019",
      "speaker": "张雨桐",
      "zh": "对，这是椅子。",
      "pinyin": "Duì, zhè shì yǐ zi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_020",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐ zi zài nǎ ér?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_021",
      "speaker": "张伟",
      "zh": "椅子在这里。",
      "pinyin": "Yǐ zi zài zhè lǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_022",
      "speaker": "刘梅",
      "zh": "咪咪一直换地方。",
      "pinyin": "Mī mī yī zhí huàn dì fāng.",
      "tr": "Mimi sürekli yer değiştiriyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_027",
      "speaker": "张雨桐",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuō zi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_028",
      "speaker": "张乐乐",
      "zh": "对，这是桌子。",
      "pinyin": "Duì, zhè shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_029",
      "speaker": "张伟",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuō zi zài nǎ ér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_030",
      "speaker": "刘梅",
      "zh": "桌子在这里。",
      "pinyin": "Zhuō zi zài zhè lǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_031",
      "speaker": "张雨桐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_032",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_033",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_035",
      "speaker": "张雨桐",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhè shì wǒ men de mā mā.",
      "tr": "Bu bizim anne."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_037",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_038",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_039",
      "speaker": "张雨桐",
      "zh": "这是我们的爸爸。",
      "pinyin": "Zhè shì wǒ men de bà bà.",
      "tr": "Bu bizim baba."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_042",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_043",
      "speaker": "张雨桐",
      "zh": "终于拍好照片了。",
      "pinyin": "Zhōng yú pāi hǎo zhào piàn le.",
      "tr": "Sonunda fotoğrafı çektik."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_047",
      "speaker": "张雨桐",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_048",
      "speaker": "张乐乐",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
