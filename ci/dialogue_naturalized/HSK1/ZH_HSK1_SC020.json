{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC020",
  "level": "HSK1",
  "sourceTitleZh": "全家福",
  "sourceTitleTr": "Aile Fotoğrafı",
  "sourceMiniAdventureTr": "Aile ilk fotoğrafını çekmeye çalışır; Mimi sürekli yer değiştirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC020_001",
      "speaker": "张伟",
      "zh": "我们要拍全家福。",
      "pinyin": "Wǒmen yào pāi quánjiāfú.",
      "tr": "Aile fotoğrafı çekeceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_006",
      "speaker": "刘梅",
      "zh": "这是照片吗？",
      "pinyin": "Zhè shì zhàopiàn ma?",
      "tr": "Bu, fotoğraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_007",
      "speaker": "张雨桐",
      "zh": "对，就是照片。",
      "pinyin": "Duì, jiùshì zhàopiān.",
      "tr": "Evet, bu fotoğraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_008",
      "speaker": "张乐乐",
      "zh": "照片呢？",
      "pinyin": "Zhàopiān ne?",
      "tr": "Fotoğraf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_009",
      "speaker": "张伟",
      "zh": "照片在这儿。",
      "pinyin": "Zhàopiān zài zhèér.",
      "tr": "Fotoğraf burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_011",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_013",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_014",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_015",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是猫。",
      "pinyin": "Èn, duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_016",
      "speaker": "张乐乐",
      "zh": "猫呢？放哪儿了？",
      "pinyin": "Māo ne? fàng nǎér le?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_017",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_018",
      "speaker": "刘梅",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_019",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是椅子。",
      "pinyin": "Èn, duì, zhè shì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_020",
      "speaker": "张乐乐",
      "zh": "椅子呢？放哪儿了？",
      "pinyin": "Yǐzi ne? fàng nǎér le?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_021",
      "speaker": "张伟",
      "zh": "椅子在这儿。",
      "pinyin": "Yǐzi zài zhèér.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_022",
      "speaker": "刘梅",
      "zh": "咪咪一直换地方。",
      "pinyin": "Mīmī yìzhí huàn dìfang.",
      "tr": "Mimi sürekli yer değiştiriyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_023",
      "speaker": "张雨桐",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_027",
      "speaker": "张雨桐",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_028",
      "speaker": "张乐乐",
      "zh": "没错，是桌子。",
      "pinyin": "Méicuò, shì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_029",
      "speaker": "张伟",
      "zh": "桌子呢？放哪儿了？",
      "pinyin": "Zhuōzi ne? fàng nǎér le?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_030",
      "speaker": "刘梅",
      "zh": "桌子在这儿。",
      "pinyin": "Zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_031",
      "speaker": "张雨桐",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_032",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_033",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_034",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_035",
      "speaker": "张雨桐",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhè shì wǒmen de māma.",
      "tr": "Bu bizim anne."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_037",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_038",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_039",
      "speaker": "张雨桐",
      "zh": "这是我们的爸爸。",
      "pinyin": "Zhè shì wǒmen de bàba.",
      "tr": "Bu bizim baba."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_042",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_043",
      "speaker": "张雨桐",
      "zh": "终于拍好照片了。",
      "pinyin": "Zhōngyú pāi hǎo zhàopiàn le.",
      "tr": "Sonunda fotoğrafı çektik."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC020_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_047",
      "speaker": "张雨桐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC020_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
