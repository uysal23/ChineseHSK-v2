{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC005",
  "level": "HSK1",
  "sourceTitleZh": "丢失的玩具",
  "sourceTitleTr": "Kayıp Oyuncak",
  "sourceMiniAdventureTr": "Lele oyuncak trenini bulamaz; herkes koltukların çevresine bakar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC005_001",
      "speaker": "张乐乐",
      "zh": "乐乐在找玩具。",
      "pinyin": "Lè lè zài zhǎo wán jù.",
      "tr": "Lele oyuncağını arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_003",
      "speaker": "刘梅",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_004",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_006",
      "speaker": "张雨桐",
      "zh": "这是玩具吗？",
      "pinyin": "Zhè shì wán jù ma?",
      "tr": "Bu, oyuncak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_007",
      "speaker": "刘梅",
      "zh": "对，这是玩具。",
      "pinyin": "Duì, zhè shì wán jù.",
      "tr": "Evet, bu oyuncak."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_008",
      "speaker": "张伟",
      "zh": "玩具在哪儿？",
      "pinyin": "Wán jù zài nǎ ér?",
      "tr": "Oyuncak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_009",
      "speaker": "张乐乐",
      "zh": "玩具在这里。",
      "pinyin": "Wán jù zài zhè lǐ.",
      "tr": "Oyuncak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_010",
      "speaker": "张雨桐",
      "zh": "这是座位吗？",
      "pinyin": "Zhè shì zuò wèi ma?",
      "tr": "Bu, koltuk / oturma yeri mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_011",
      "speaker": "刘梅",
      "zh": "对，这是座位。",
      "pinyin": "Duì, zhè shì zuò wèi.",
      "tr": "Evet, bu koltuk / oturma yeri."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_012",
      "speaker": "张伟",
      "zh": "座位在哪儿？",
      "pinyin": "Zuò wèi zài nǎ ér?",
      "tr": "Koltuk / oturma yeri nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_013",
      "speaker": "张乐乐",
      "zh": "座位在这里。",
      "pinyin": "Zuò wèi zài zhè lǐ.",
      "tr": "Koltuk / oturma yeri burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_014",
      "speaker": "张雨桐",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒ men zuò huǒ chē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_015",
      "speaker": "刘梅",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒ men zuò huǒ chē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_016",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_017",
      "speaker": "张乐乐",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_018",
      "speaker": "张雨桐",
      "zh": "这是包吗？",
      "pinyin": "Zhè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_019",
      "speaker": "刘梅",
      "zh": "对，这是包。",
      "pinyin": "Duì, zhè shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_020",
      "speaker": "张伟",
      "zh": "包在哪儿？",
      "pinyin": "Bāo zài nǎ ér?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_021",
      "speaker": "张乐乐",
      "zh": "包在这里。",
      "pinyin": "Bāo zài zhè lǐ.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_022",
      "speaker": "张雨桐",
      "zh": "玩具不在包里。",
      "pinyin": "Wán jù bù zài bāo lǐ.",
      "tr": "Oyuncak çantada değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_024",
      "speaker": "张伟",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_025",
      "speaker": "张乐乐",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_026",
      "speaker": "张雨桐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_027",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_028",
      "speaker": "张伟",
      "zh": "对，这是猫。",
      "pinyin": "Duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_029",
      "speaker": "张乐乐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎ ér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_030",
      "speaker": "张雨桐",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhè lǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_031",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒ biān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_032",
      "speaker": "张伟",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒ biān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_033",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhè biān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_034",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_035",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòu biān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_036",
      "speaker": "张伟",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòu biān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_037",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhè biān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_038",
      "speaker": "张雨桐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_039",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒ men de hái zi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_040",
      "speaker": "张伟",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_041",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_042",
      "speaker": "张雨桐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_043",
      "speaker": "刘梅",
      "zh": "玩具在座位下面。",
      "pinyin": "Wán jù zài zuò wèi xià miàn.",
      "tr": "Oyuncak koltuğun altında."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_044",
      "speaker": "张伟",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_045",
      "speaker": "张乐乐",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_046",
      "speaker": "张雨桐",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_047",
      "speaker": "刘梅",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_048",
      "speaker": "张伟",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_049",
      "speaker": "张乐乐",
      "zh": "这是玩具吗？",
      "pinyin": "Zhè shì wán jù ma?",
      "tr": "Bu, oyuncak mı?"
