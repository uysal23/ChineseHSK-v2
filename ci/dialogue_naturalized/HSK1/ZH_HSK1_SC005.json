{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC005",
  "level": "HSK1",
  "sourceTitleZh": "丢失的玩具",
  "sourceTitleTr": "Kayıp Oyuncak",
  "sourceMiniAdventureTr": "Lele oyuncak trenini bulamaz; herkes koltukların çevresine bakar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC005_001",
      "speaker": "张乐乐",
      "zh": "乐乐在找玩具。",
      "pinyin": "Lèlè zài zhǎo wánjù.",
      "tr": "Lele oyuncağını arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_003",
      "speaker": "刘梅",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_004",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_005",
      "speaker": "张乐乐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_006",
      "speaker": "张雨桐",
      "zh": "这是玩具吗？",
      "pinyin": "Zhè shì wánjù ma?",
      "tr": "Bu, oyuncak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_007",
      "speaker": "刘梅",
      "zh": "没错，是玩具。",
      "pinyin": "Méicuò, shì wánjù.",
      "tr": "Evet, bu oyuncak."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_008",
      "speaker": "张伟",
      "zh": "那玩具在哪儿？",
      "pinyin": "Nà wánjù zài nǎér?",
      "tr": "Oyuncak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_009",
      "speaker": "张乐乐",
      "zh": "你看，玩具在这儿。",
      "pinyin": "Nǐ kàn, wánjù zài zhèér.",
      "tr": "Oyuncak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_010",
      "speaker": "张雨桐",
      "zh": "这是座位吗？",
      "pinyin": "Zhè shì zuòwèi ma?",
      "tr": "Bu, koltuk / oturma yeri mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_011",
      "speaker": "刘梅",
      "zh": "对，就是座位。",
      "pinyin": "Duì, jiùshì zuòwèi.",
      "tr": "Evet, bu koltuk / oturma yeri."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_012",
      "speaker": "张伟",
      "zh": "座位呢？",
      "pinyin": "Zuòwèi ne?",
      "tr": "Koltuk / oturma yeri nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_013",
      "speaker": "张乐乐",
      "zh": "你看，座位在这儿。",
      "pinyin": "Nǐ kàn, zuòwèi zài zhèér.",
      "tr": "Koltuk / oturma yeri burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_014",
      "speaker": "张雨桐",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuò huǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_015",
      "speaker": "刘梅",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuò huǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_016",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_017",
      "speaker": "张乐乐",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_018",
      "speaker": "张雨桐",
      "zh": "这是包吗？",
      "pinyin": "Zhè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_019",
      "speaker": "刘梅",
      "zh": "嗯，对，这是包。",
      "pinyin": "Èn, duì, zhè shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_020",
      "speaker": "张伟",
      "zh": "包在哪儿？",
      "pinyin": "Bāo zài nǎr?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_021",
      "speaker": "张乐乐",
      "zh": "包在这儿。",
      "pinyin": "Bāo zài zhèér.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_022",
      "speaker": "张雨桐",
      "zh": "玩具不在包里。",
      "pinyin": "Wánjù bú zài bāo lǐ.",
      "tr": "Oyuncak çantada değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_024",
      "speaker": "张伟",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_025",
      "speaker": "张乐乐",
      "zh": "那一起吧。",
      "pinyin": "Nà yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_026",
      "speaker": "张雨桐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_027",
      "speaker": "刘梅",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_028",
      "speaker": "张伟",
      "zh": "没错，是猫。",
      "pinyin": "Méicuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_029",
      "speaker": "张乐乐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_030",
      "speaker": "张雨桐",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_031",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbian ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_032",
      "speaker": "张伟",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbian.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_033",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_034",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_035",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubian ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_036",
      "speaker": "张伟",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubian.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_037",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_038",
      "speaker": "张雨桐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_039",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_040",
      "speaker": "张伟",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_041",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_042",
      "speaker": "张雨桐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_043",
      "speaker": "刘梅",
      "zh": "玩具在座位下面。",
      "pinyin": "Wánjù zài zuòwèi xiàmiàn.",
      "tr": "Oyuncak koltuğun altında."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_044",
      "speaker": "张伟",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_045",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_046",
      "speaker": "张雨桐",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_047",
      "speaker": "刘梅",
      "zh": "现在就好了。",
      "pinyin": "Xiànzài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_048",
      "speaker": "张伟",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒmen jìxù ba.",
      "tr": "Devam edelim."
    },
    {
