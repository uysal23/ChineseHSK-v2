{
  "naturalizationVersion": 3,
  "sceneId": "ZH_HSK1_SC005",
  "level": "HSK1",
  "sourceTitleZh": "丢失的玩具",
  "sourceTitleTr": "Kayıp Oyuncak",
  "sourceMiniAdventureTr": "Lele oyuncak trenini bulamaz; herkes koltukların çevresine bakar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC005_001",
      "speaker": "张乐乐",
      "zh": "乐乐在找玩具。",
      "pinyin": "Lèlè zài zhǎo wánjù.",
      "tr": "Lele oyuncağını arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_003",
      "speaker": "刘梅",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_004",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_006",
      "speaker": "张雨桐",
      "zh": "这个是玩具吗？",
      "pinyin": "Zhè gè shì wán jù ma?",
      "tr": "Bu, oyuncak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_007",
      "speaker": "刘梅",
      "zh": "对，就是玩具。",
      "pinyin": "Duì, jiù shì wán jù.",
      "tr": "Evet, bu oyuncak."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_008",
      "speaker": "张伟",
      "zh": "玩具呢？",
      "pinyin": "Wán jù ne?",
      "tr": "Oyuncak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_009",
      "speaker": "张乐乐",
      "zh": "玩具在这儿。",
      "pinyin": "Wán jù zài zhèr.",
      "tr": "Oyuncak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_010",
      "speaker": "张雨桐",
      "zh": "这个是座位吗？",
      "pinyin": "Zhè gè shì zuò wèi ma?",
      "tr": "Bu, koltuk / oturma yeri mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_011",
      "speaker": "刘梅",
      "zh": "对，就是座位。",
      "pinyin": "Duì, jiù shì zuò wèi.",
      "tr": "Evet, bu koltuk / oturma yeri."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_012",
      "speaker": "张伟",
      "zh": "座位在哪儿？",
      "pinyin": "Zuòwèi zài nǎr?",
      "tr": "Koltuk / oturma yeri nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_013",
      "speaker": "张乐乐",
      "zh": "你看，座位在这儿。",
      "pinyin": "Nǐ kàn, zuò wèi zài zhèr.",
      "tr": "Koltuk / oturma yeri burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_014",
      "speaker": "张雨桐",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuò huǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_015",
      "speaker": "刘梅",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuò huǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_016",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_017",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_018",
      "speaker": "张雨桐",
      "zh": "这个是包吗？",
      "pinyin": "Zhè gè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_019",
      "speaker": "刘梅",
      "zh": "没错，是包。",
      "pinyin": "Méi cuò, shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_020",
      "speaker": "张伟",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_021",
      "speaker": "张乐乐",
      "zh": "你看，包在这儿。",
      "pinyin": "Nǐ kàn, bāo zài zhèr.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_022",
      "speaker": "张雨桐",
      "zh": "玩具不在包里。",
      "pinyin": "Wánjù bú zài bāo lǐ.",
      "tr": "Oyuncak çantada değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_026",
      "speaker": "张雨桐",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_027",
      "speaker": "刘梅",
      "zh": "这个是猫吗？",
      "pinyin": "Zhè gè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_028",
      "speaker": "张伟",
      "zh": "对，就是猫。",
      "pinyin": "Duì, jiù shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_029",
      "speaker": "张乐乐",
      "zh": "那猫在哪儿？",
      "pinyin": "Nà māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_030",
      "speaker": "张雨桐",
      "zh": "猫在这儿。",
      "pinyin": "Māo zài zhèr.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_031",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbian ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_032",
      "speaker": "张伟",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbian.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_033",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_034",
      "speaker": "张雨桐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_035",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubian ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_036",
      "speaker": "张伟",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubian.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_037",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_038",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_039",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_040",
      "speaker": "张伟",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_041",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_042",
      "speaker": "张雨桐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_043",
      "speaker": "刘梅",
      "zh": "玩具在座位下面。",
      "pinyin": "Wánjù zài zuòwèi xiàmiàn.",
      "tr": "Oyuncak koltuğun altında."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_044",
      "speaker": "张伟",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC005_045",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_046",
      "speaker": "张雨桐",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_047",
      "speaker": "刘梅",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_048",
      "speaker": "张伟",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC005_049",
      "speaker": "张乐乐",
      "zh": "这是玩具，对吗？",
      "pinyin": "Zhè shì wán jù, duì ma?",
      "tr": "Bu, oyuncak mı?"
