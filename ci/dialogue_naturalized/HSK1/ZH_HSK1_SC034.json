{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC034",
  "level": "HSK1",
  "sourceTitleZh": "错过公交车",
  "sourceTitleTr": "Otobüsü Kaçırmak",
  "sourceMiniAdventureTr": "Zhang eve dönüş otobüsünü kaçırır ve sonraki otobüsün saatini sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC034_001",
      "speaker": "张伟",
      "zh": "张伟下班要坐公交车回家。",
      "pinyin": "Zhāng Wěi xiàbān yào zuò gōngjiāochē huí jiā.",
      "tr": "Zhang Wei işten sonra otobüsle eve dönecek."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_002",
      "speaker": "乘客",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_003",
      "speaker": "工作人员",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_004",
      "speaker": "刘梅",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_006",
      "speaker": "乘客",
      "zh": "我们坐公交车吗？",
      "pinyin": "Wǒmen zuò gōngjiāochē ma?",
      "tr": "Otobüs ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_007",
      "speaker": "工作人员",
      "zh": "对，我们坐公交车。",
      "pinyin": "Duì, wǒmen zuò gōngjiāochē.",
      "tr": "Evet, otobüs ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_008",
      "speaker": "刘梅",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_010",
      "speaker": "乘客",
      "zh": "这是时间吗？",
      "pinyin": "Zhè shì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_011",
      "speaker": "工作人员",
      "zh": "嗯，对，这是时间。",
      "pinyin": "Èn, duì, zhè shì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_012",
      "speaker": "刘梅",
      "zh": "时间在哪儿？",
      "pinyin": "Shíjiān zài nǎr?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_013",
      "speaker": "张伟",
      "zh": "时间在这儿。",
      "pinyin": "Shíjiān zài zhèér.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_014",
      "speaker": "乘客",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎr?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_015",
      "speaker": "工作人员",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_016",
      "speaker": "刘梅",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_018",
      "speaker": "乘客",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_019",
      "speaker": "工作人员",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_020",
      "speaker": "刘梅",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_021",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_022",
      "speaker": "乘客",
      "zh": "他错过了这班车。",
      "pinyin": "Tā cuòguò le zhè bān chē.",
      "tr": "Bu otobüsü kaçırdı."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_024",
      "speaker": "刘梅",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_026",
      "speaker": "乘客",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_027",
      "speaker": "工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_028",
      "speaker": "刘梅",
      "zh": "有点儿。",
      "pinyin": "Yǒudiǎnér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_029",
      "speaker": "张伟",
      "zh": "没关系，别急。",
      "pinyin": "Méiguānxì, biéjí.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_030",
      "speaker": "乘客",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒmen jìxù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_031",
      "speaker": "工作人员",
      "zh": "车站在哪儿？",
      "pinyin": "Chēzhàn zài nǎr?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_032",
      "speaker": "刘梅",
      "zh": "车站在那边。",
      "pinyin": "Chēzhàn zài nàbian.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_033",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_034",
      "speaker": "乘客",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_035",
      "speaker": "工作人员",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_036",
      "speaker": "刘梅",
      "zh": "嗯，对，这是电话。",
      "pinyin": "Èn, duì, zhè shì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_037",
      "speaker": "张伟",
      "zh": "那电话放在哪儿？",
      "pinyin": "Nà diànhuà fàngzài nǎér?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_038",
      "speaker": "乘客",
      "zh": "电话在这儿。",
      "pinyin": "Diànhuà zài zhèér.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_039",
      "speaker": "工作人员",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_040",
      "speaker": "刘梅",
      "zh": "嗯，对，这是钱。",
      "pinyin": "Èn, duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_041",
      "speaker": "张伟",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎr?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_042",
      "speaker": "乘客",
      "zh": "你看，钱在这儿。",
      "pinyin": "Nǐ kàn, qián zài zhèér.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_043",
      "speaker": "工作人员",
      "zh": "他问到了下一班车的时间。",
      "pinyin": "Tā wèn dào le xià yì bān chē de shíjiān.",
      "tr": "Sonraki otobüsün saatini öğrendi."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_044",
      "speaker": "刘梅",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_046",
      "speaker": "乘客",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_047",
      "speaker": "工作人员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xiàxíng le.",
      "tr": "Şimdi tamam."
    },
