{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC034",
  "level": "HSK1",
  "sourceTitleZh": "错过公交车",
  "sourceTitleTr": "Otobüsü Kaçırmak",
  "sourceMiniAdventureTr": "Zhang eve dönüş otobüsünü kaçırır ve sonraki otobüsün saatini sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC034_001",
      "speaker": "张伟",
      "zh": "张伟下班要坐公交车回家。",
      "pinyin": "Zhāng wěi xià bān yào zuò gōng jiāo chē huí jiā.",
      "tr": "Zhang Wei işten sonra otobüsle eve dönecek."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_002",
      "speaker": "乘客",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_003",
      "speaker": "工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_004",
      "speaker": "刘梅",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_006",
      "speaker": "乘客",
      "zh": "我们坐公交车吗？",
      "pinyin": "Wǒ men zuò gōng jiāo chē ma?",
      "tr": "Otobüs ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_007",
      "speaker": "工作人员",
      "zh": "对，我们坐公交车。",
      "pinyin": "Duì, wǒ men zuò gōng jiāo chē.",
      "tr": "Evet, otobüs ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_008",
      "speaker": "刘梅",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_009",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_010",
      "speaker": "乘客",
      "zh": "这是时间吗？",
      "pinyin": "Zhè shì shí jiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_011",
      "speaker": "工作人员",
      "zh": "对，这是时间。",
      "pinyin": "Duì, zhè shì shí jiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_012",
      "speaker": "刘梅",
      "zh": "时间在哪儿？",
      "pinyin": "Shí jiān zài nǎ ér?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_013",
      "speaker": "张伟",
      "zh": "时间在这里。",
      "pinyin": "Shí jiān zài zhè lǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_014",
      "speaker": "乘客",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎ ér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_015",
      "speaker": "工作人员",
      "zh": "路在那边。",
      "pinyin": "Lù zài nà biān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_016",
      "speaker": "刘梅",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_017",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_018",
      "speaker": "乘客",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_019",
      "speaker": "工作人员",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_020",
      "speaker": "刘梅",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_021",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_022",
      "speaker": "乘客",
      "zh": "他错过了这班车。",
      "pinyin": "Tā cuò guò le zhè bān chē.",
      "tr": "Bu otobüsü kaçırdı."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_024",
      "speaker": "刘梅",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_026",
      "speaker": "乘客",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_027",
      "speaker": "工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_028",
      "speaker": "刘梅",
      "zh": "有一点儿。",
      "pinyin": "Yǒu yī diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_029",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guān xì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_030",
      "speaker": "乘客",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_031",
      "speaker": "工作人员",
      "zh": "车站在哪儿？",
      "pinyin": "Chē zhàn zài nǎ ér?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_032",
      "speaker": "刘梅",
      "zh": "车站在那边。",
      "pinyin": "Chē zhàn zài nà biān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_033",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_034",
      "speaker": "乘客",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_035",
      "speaker": "工作人员",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diàn huà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_036",
      "speaker": "刘梅",
      "zh": "对，这是电话。",
      "pinyin": "Duì, zhè shì diàn huà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_037",
      "speaker": "张伟",
      "zh": "电话在哪儿？",
      "pinyin": "Diàn huà zài nǎ ér?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_038",
      "speaker": "乘客",
      "zh": "电话在这里。",
      "pinyin": "Diàn huà zài zhè lǐ.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_039",
      "speaker": "工作人员",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_040",
      "speaker": "刘梅",
      "zh": "对，这是钱。",
      "pinyin": "Duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_041",
      "speaker": "张伟",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎ ér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_042",
      "speaker": "乘客",
      "zh": "钱在这里。",
      "pinyin": "Qián zài zhè lǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_043",
      "speaker": "工作人员",
      "zh": "他问到了下一班车的时间。",
      "pinyin": "Tā wèn dào le xià yī bān chē de shí jiān.",
      "tr": "Sonraki otobüsün saatini öğrendi."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_044",
      "speaker": "刘梅",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC034_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_046",
      "speaker": "乘客",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_047",
      "speaker": "工作人员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_048",
      "speaker": "刘梅",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC034_049",
      "speaker": "张伟",
      "zh": "我们坐公交车吗？",
      "pinyin": "Wǒ men zuò gōng jiāo chē ma?",
      "tr": "Otobüs ile mi gidiyoruz?"
    },
