{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC031",
  "level": "HSK1",
  "sourceTitleZh": "上班第一天",
  "sourceTitleTr": "İşe İlk Gün",
  "sourceMiniAdventureTr": "Zhang iş yerine giriş kartını bulamayınca kısa süreli telaş yaşar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC031_001",
      "speaker": "张伟",
      "zh": "今天是张伟上班第一天。",
      "pinyin": "Jīntiān shì Zhāng Wěi shàngbān dì yī tiān.",
      "tr": "Bugün Zhang Wei’nin işe ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_003",
      "speaker": "保安",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_004",
      "speaker": "经理",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_006",
      "speaker": "同事",
      "zh": "这是工作卡吗？",
      "pinyin": "Zhè shì gōngzuò kǎ ma?",
      "tr": "Bu, iş kartı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_007",
      "speaker": "保安",
      "zh": "没错，是工作卡。",
      "pinyin": "Méicuò, shì gōngzuò kǎ.",
      "tr": "Evet, bu iş kartı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_008",
      "speaker": "经理",
      "zh": "工作卡呢？",
      "pinyin": "Gōngzuò kǎ ne?",
      "tr": "Iş kartı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_009",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Iş kartı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_010",
      "speaker": "同事",
      "zh": "这是卡吗？",
      "pinyin": "Zhè shì kǎ ma?",
      "tr": "Bu, kart mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_011",
      "speaker": "保安",
      "zh": "对，就是卡。",
      "pinyin": "Duì, jiùshì kǎ.",
      "tr": "Evet, bu kart."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_012",
      "speaker": "经理",
      "zh": "那卡在哪儿？",
      "pinyin": "Nà kǎ zài nǎér?",
      "tr": "Kart nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_013",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kart burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_014",
      "speaker": "同事",
      "zh": "那办公室在哪儿？",
      "pinyin": "Nà bàngōngshì zài nǎér?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_015",
      "speaker": "保安",
      "zh": "你看，办公室在那边。",
      "pinyin": "Nǐ kàn, bàngōngshì zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_016",
      "speaker": "经理",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_018",
      "speaker": "同事",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_019",
      "speaker": "保安",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_020",
      "speaker": "经理",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_021",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_022",
      "speaker": "同事",
      "zh": "他的工作卡找不到了。",
      "pinyin": "Tā de gōngzuò kǎ zhǎo bú dào le.",
      "tr": "İş kartını bulamıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_023",
      "speaker": "保安",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_024",
      "speaker": "经理",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_026",
      "speaker": "同事",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_027",
      "speaker": "保安",
      "zh": "这是我们的同事。",
      "pinyin": "Zhè shì wǒmen de tóngshì.",
      "tr": "Bu bizim iş arkadaşı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_028",
      "speaker": "经理",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_030",
      "speaker": "同事",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_031",
      "speaker": "保安",
      "zh": "这是我们的经理。",
      "pinyin": "Zhè shì wǒmen de jīnglǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_032",
      "speaker": "经理",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_034",
      "speaker": "同事",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_035",
      "speaker": "保安",
      "zh": "这是电脑吗？",
      "pinyin": "Zhè shì diànnǎo ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_036",
      "speaker": "经理",
      "zh": "嗯，对，这是电脑。",
      "pinyin": "Èn, duì, zhè shì diànnǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_037",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diànnǎo zài nǎr?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_038",
      "speaker": "同事",
      "zh": "你看，电脑在这儿。",
      "pinyin": "Nǐ kàn, diànnǎo zài zhèér.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_039",
      "speaker": "保安",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_040",
      "speaker": "经理",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiùshì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_041",
      "speaker": "张伟",
      "zh": "门呢？放哪儿了？",
      "pinyin": "Mén ne? fàng nǎér le?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_042",
      "speaker": "同事",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_043",
      "speaker": "保安",
      "zh": "工作卡原来在外套里。",
      "pinyin": "Gōngzuò kǎ yuánlái zài wàitào lǐ.",
      "tr": "Meğer iş kartı montunun içindeymiş."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_044",
      "speaker": "经理",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_046",
      "speaker": "同事",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_047",
      "speaker": "保安",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_048",
      "speaker": "经理",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_049",
      "speaker": "张伟",
      "zh": "这个是工作卡吗？",
      "pinyin": "Zhège shì gōngzuò kǎ ma?",
      "tr": "Bu, iş kartı mı?"
