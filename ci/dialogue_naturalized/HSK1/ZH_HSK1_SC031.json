{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC031",
  "level": "HSK1",
  "sourceTitleZh": "上班第一天",
  "sourceTitleTr": "İşe İlk Gün",
  "sourceMiniAdventureTr": "Zhang iş yerine giriş kartını bulamayınca kısa süreli telaş yaşar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC031_001",
      "speaker": "张伟",
      "zh": "今天是张伟上班第一天。",
      "pinyin": "Jīn tiān shì zhāng wěi shàng bān dì yī tiān.",
      "tr": "Bugün Zhang Wei’nin işe ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_003",
      "speaker": "保安",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_004",
      "speaker": "经理",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_006",
      "speaker": "同事",
      "zh": "这是工作卡吗？",
      "pinyin": "Zhè shì gōng zuò kǎ ma?",
      "tr": "Bu, iş kartı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_007",
      "speaker": "保安",
      "zh": "对，这是工作卡。",
      "pinyin": "Duì, zhè shì gōng zuò kǎ.",
      "tr": "Evet, bu iş kartı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_008",
      "speaker": "经理",
      "zh": "工作卡在哪儿？",
      "pinyin": "Gōng zuò kǎ zài nǎ ér?",
      "tr": "Iş kartı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_009",
      "speaker": "张伟",
      "zh": "工作卡在这里。",
      "pinyin": "Gōng zuò kǎ zài zhè lǐ.",
      "tr": "Iş kartı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_010",
      "speaker": "同事",
      "zh": "这是卡吗？",
      "pinyin": "Zhè shì kǎ ma?",
      "tr": "Bu, kart mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_011",
      "speaker": "保安",
      "zh": "对，这是卡。",
      "pinyin": "Duì, zhè shì kǎ.",
      "tr": "Evet, bu kart."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_012",
      "speaker": "经理",
      "zh": "卡在哪儿？",
      "pinyin": "Kǎ zài nǎ ér?",
      "tr": "Kart nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_013",
      "speaker": "张伟",
      "zh": "卡在这里。",
      "pinyin": "Kǎ zài zhè lǐ.",
      "tr": "Kart burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_014",
      "speaker": "同事",
      "zh": "办公室在哪儿？",
      "pinyin": "Bàn gōng shì zài nǎ ér?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_015",
      "speaker": "保安",
      "zh": "办公室在那边。",
      "pinyin": "Bàn gōng shì zài nà biān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_016",
      "speaker": "经理",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_017",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_018",
      "speaker": "同事",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōng zuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_019",
      "speaker": "保安",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_020",
      "speaker": "经理",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_021",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_022",
      "speaker": "同事",
      "zh": "他的工作卡找不到了。",
      "pinyin": "Tā de gōng zuò kǎ zhǎo bù dào le.",
      "tr": "İş kartını bulamıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_023",
      "speaker": "保安",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_024",
      "speaker": "经理",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_026",
      "speaker": "同事",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_027",
      "speaker": "保安",
      "zh": "这是我们的同事。",
      "pinyin": "Zhè shì wǒ men de tóng shì.",
      "tr": "Bu bizim iş arkadaşı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_028",
      "speaker": "经理",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_030",
      "speaker": "同事",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_031",
      "speaker": "保安",
      "zh": "这是我们的经理。",
      "pinyin": "Zhè shì wǒ men de jīng lǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_032",
      "speaker": "经理",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_034",
      "speaker": "同事",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_035",
      "speaker": "保安",
      "zh": "这是电脑吗？",
      "pinyin": "Zhè shì diàn nǎo ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_036",
      "speaker": "经理",
      "zh": "对，这是电脑。",
      "pinyin": "Duì, zhè shì diàn nǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_037",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diàn nǎo zài nǎ ér?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_038",
      "speaker": "同事",
      "zh": "电脑在这里。",
      "pinyin": "Diàn nǎo zài zhè lǐ.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_039",
      "speaker": "保安",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_040",
      "speaker": "经理",
      "zh": "对，这是门。",
      "pinyin": "Duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_041",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎ ér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_042",
      "speaker": "同事",
      "zh": "门在这里。",
      "pinyin": "Mén zài zhè lǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_043",
      "speaker": "保安",
      "zh": "工作卡原来在外套里。",
      "pinyin": "Gōng zuò kǎ yuán lái zài wài tào lǐ.",
      "tr": "Meğer iş kartı montunun içindeymiş."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_044",
      "speaker": "经理",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_046",
      "speaker": "同事",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_047",
      "speaker": "保安",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_048",
      "speaker": "经理",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
