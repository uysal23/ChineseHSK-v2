{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC047",
  "level": "HSK1",
  "sourceTitleZh": "一个小小的想法",
  "sourceTitleTr": "Küçük Bir Fikir",
  "sourceMiniAdventureTr": "Li Chen’in eşi Liu Mei’nin yiyecek satabileceğini söyler; ilk iş fikri doğar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC047_001",
      "speaker": "刘梅",
      "zh": "大家在说刘梅的蛋糕。",
      "pinyin": "Dàjiā zài shuō Liú Méi de dàngāo.",
      "tr": "Herkes Liu Mei’nin keklerinden konuşuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_003",
      "speaker": "李晨妻子",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_004",
      "speaker": "李晨",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_005",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_006",
      "speaker": "张伟",
      "zh": "这是想法吗？",
      "pinyin": "Zhè shì xiǎngfa ma?",
      "tr": "Bu, fikir mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_007",
      "speaker": "李晨妻子",
      "zh": "嗯，对，这是想法。",
      "pinyin": "Èn, duì, zhè shì xiǎngfǎ.",
      "tr": "Evet, bu fikir."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_008",
      "speaker": "李晨",
      "zh": "想法在哪儿？",
      "pinyin": "Xiǎngfa zài nǎr?",
      "tr": "Fikir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_009",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Fikir burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_010",
      "speaker": "张伟",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàngāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_011",
      "speaker": "李晨妻子",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒ yào dàngāo, xièxie.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_012",
      "speaker": "李晨",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_013",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_014",
      "speaker": "张伟",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_015",
      "speaker": "李晨妻子",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_016",
      "speaker": "李晨",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_017",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_018",
      "speaker": "张伟",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_019",
      "speaker": "李晨妻子",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_020",
      "speaker": "李晨",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_021",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_022",
      "speaker": "张伟",
      "zh": "朋友说她可以卖这些蛋糕。",
      "pinyin": "Péngyou shuō tā kěyǐ mài zhèxiē dàngāo.",
      "tr": "Arkadaşı bu kekleri satabileceğini söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_023",
      "speaker": "李晨妻子",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_024",
      "speaker": "李晨",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_026",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_027",
      "speaker": "李晨妻子",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_028",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_029",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_030",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_031",
      "speaker": "李晨妻子",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_032",
      "speaker": "李晨",
      "zh": "对，就是钱。",
      "pinyin": "Duì, jiùshì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_033",
      "speaker": "刘梅",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎr?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_034",
      "speaker": "张伟",
      "zh": "钱在这儿。",
      "pinyin": "Qián zài zhèér.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_035",
      "speaker": "李晨妻子",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_036",
      "speaker": "李晨",
      "zh": "有点儿。",
      "pinyin": "Yǒudiǎnér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_037",
      "speaker": "刘梅",
      "zh": "没事。",
      "pinyin": "Méishì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_038",
      "speaker": "张伟",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_039",
      "speaker": "李晨妻子",
      "zh": "这是新的吗？",
      "pinyin": "Zhè shì xīn de ma?",
      "tr": "Bu, yeni mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_040",
      "speaker": "李晨",
      "zh": "没错，是新的。",
      "pinyin": "Méicuò, shì xīn de.",
      "tr": "Evet, bu yeni."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_041",
      "speaker": "刘梅",
      "zh": "新的在哪儿？",
      "pinyin": "Xīn de zài nǎr?",
      "tr": "Yeni nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_042",
      "speaker": "张伟",
      "zh": "你看，新的在这儿。",
      "pinyin": "Nǐ kàn, xīn de zài zhèér.",
      "tr": "Yeni burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_043",
      "speaker": "李晨妻子",
      "zh": "一个小小的想法开始了。",
      "pinyin": "Yí ge xiǎoxiǎo de xiǎngfa kāishǐ le.",
      "tr": "Küçük bir fikir doğuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_044",
      "speaker": "李晨",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_045",
      "speaker": "刘梅",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_046",
      "speaker": "张伟",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_047",
      "speaker": "李晨妻子",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_048",
      "speaker": "李晨",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
