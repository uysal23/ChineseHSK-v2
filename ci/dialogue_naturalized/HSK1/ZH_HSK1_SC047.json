{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC047",
  "level": "HSK1",
  "sourceTitleZh": "一个小小的想法",
  "sourceTitleTr": "Küçük Bir Fikir",
  "sourceMiniAdventureTr": "Li Chen’in eşi Liu Mei’nin yiyecek satabileceğini söyler; ilk iş fikri doğar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC047_001",
      "speaker": "刘梅",
      "zh": "大家在说刘梅的蛋糕。",
      "pinyin": "Dà jiā zài shuō liú méi de dàn gāo.",
      "tr": "Herkes Liu Mei’nin keklerinden konuşuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_003",
      "speaker": "李晨妻子",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_004",
      "speaker": "李晨",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_005",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_006",
      "speaker": "张伟",
      "zh": "这是想法吗？",
      "pinyin": "Zhè shì xiǎng fǎ ma?",
      "tr": "Bu, fikir mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_007",
      "speaker": "李晨妻子",
      "zh": "对，这是想法。",
      "pinyin": "Duì, zhè shì xiǎng fǎ.",
      "tr": "Evet, bu fikir."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_008",
      "speaker": "李晨",
      "zh": "想法在哪儿？",
      "pinyin": "Xiǎng fǎ zài nǎ ér?",
      "tr": "Fikir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_009",
      "speaker": "刘梅",
      "zh": "想法在这里。",
      "pinyin": "Xiǎng fǎ zài zhè lǐ.",
      "tr": "Fikir burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_010",
      "speaker": "张伟",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàn gāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_011",
      "speaker": "李晨妻子",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒ yào dàn gāo, xiè xiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_012",
      "speaker": "李晨",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_013",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_014",
      "speaker": "张伟",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōng zuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_015",
      "speaker": "李晨妻子",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_016",
      "speaker": "李晨",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_017",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_018",
      "speaker": "张伟",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_019",
      "speaker": "李晨妻子",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_020",
      "speaker": "李晨",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_021",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_022",
      "speaker": "张伟",
      "zh": "朋友说她可以卖这些蛋糕。",
      "pinyin": "Péng yǒu shuō tā kě yǐ mài zhè xiē dàn gāo.",
      "tr": "Arkadaşı bu kekleri satabileceğini söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_023",
      "speaker": "李晨妻子",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_024",
      "speaker": "李晨",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_025",
      "speaker": "刘梅",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_026",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_027",
      "speaker": "李晨妻子",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_028",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_029",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_030",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_031",
      "speaker": "李晨妻子",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_032",
      "speaker": "李晨",
      "zh": "对，这是钱。",
      "pinyin": "Duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_033",
      "speaker": "刘梅",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎ ér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_034",
      "speaker": "张伟",
      "zh": "钱在这里。",
      "pinyin": "Qián zài zhè lǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_035",
      "speaker": "李晨妻子",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_036",
      "speaker": "李晨",
      "zh": "有点儿。",
      "pinyin": "Yǒu diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_037",
      "speaker": "刘梅",
      "zh": "没关系，别急。",
      "pinyin": "Méi guān xì, bié jí.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_038",
      "speaker": "张伟",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_039",
      "speaker": "李晨妻子",
      "zh": "这是新的吗？",
      "pinyin": "Zhè shì xīn de ma?",
      "tr": "Bu, yeni mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_040",
      "speaker": "李晨",
      "zh": "对，这是新的。",
      "pinyin": "Duì, zhè shì xīn de.",
      "tr": "Evet, bu yeni."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_041",
      "speaker": "刘梅",
      "zh": "新的在哪儿？",
      "pinyin": "Xīn de zài nǎ ér?",
      "tr": "Yeni nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_042",
      "speaker": "张伟",
      "zh": "新的在这里。",
      "pinyin": "Xīn de zài zhè lǐ.",
      "tr": "Yeni burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_043",
      "speaker": "李晨妻子",
      "zh": "一个小小的想法开始了。",
      "pinyin": "Yī gè xiǎo xiǎo de xiǎng fǎ kāi shǐ le.",
      "tr": "Küçük bir fikir doğuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_044",
      "speaker": "李晨",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC047_045",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_046",
      "speaker": "张伟",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_047",
      "speaker": "李晨妻子",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC047_048",
      "speaker": "李晨",
      "zh": "那我们继续。",
