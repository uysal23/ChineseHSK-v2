    {
      "id": "DLG_ZH_HSK1_SC008_031",
      "speaker": "李晨",
      "zh": "这是电话，对吗？",
      "pinyin": "Zhè shì diàn huà, duì ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC008_032",
