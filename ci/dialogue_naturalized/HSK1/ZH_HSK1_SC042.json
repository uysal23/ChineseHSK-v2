{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC042",
  "level": "HSK1",
  "sourceTitleZh": "在宠物店买东西",
  "sourceTitleTr": "Eczane/Pet Ürünü Alışverişi",
  "sourceMiniAdventureTr": "Aile veterinerin önerdiği ürünü pet mağazasında arar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC042_001",
      "speaker": "刘梅",
      "zh": "家人去宠物店。",
      "pinyin": "Jiārén qù chǒngwùdiàn.",
      "tr": "Aile pet mağazasına gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_003",
      "speaker": "店员",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_005",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_006",
      "speaker": "张伟",
      "zh": "宠物店在哪儿？",
      "pinyin": "Chǒngwùdiàn zài nǎr?",
      "tr": "Pet mağazası nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_007",
      "speaker": "店员",
      "zh": "宠物店在那边。",
      "pinyin": "Chǒngwùdiàn zài nàbian.",
      "tr": "Pet mağazası şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_008",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_010",
      "speaker": "张伟",
      "zh": "你要猫粮吗？",
      "pinyin": "Nǐ yào māoliáng ma?",
      "tr": "Kedi maması ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_011",
      "speaker": "店员",
      "zh": "我要猫粮，谢谢。",
      "pinyin": "Wǒ yào māoliáng, xièxie.",
      "tr": "Kedi maması istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_012",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_013",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_014",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_015",
      "speaker": "店员",
      "zh": "对，就是猫。",
      "pinyin": "Duì, jiùshì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_016",
      "speaker": "张乐乐",
      "zh": "那猫放在哪儿？",
      "pinyin": "Nà māo fàngzài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_017",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_018",
      "speaker": "张伟",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_019",
      "speaker": "店员",
      "zh": "嗯，对，这是钱。",
      "pinyin": "Èn, duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_020",
      "speaker": "张乐乐",
      "zh": "那钱放在哪儿？",
      "pinyin": "Nà qián fàngzài nǎér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_021",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_022",
      "speaker": "张伟",
      "zh": "他们不知道哪种猫粮合适。",
      "pinyin": "Tāmen bù zhīdào nǎ zhǒng māoliáng héshì.",
      "tr": "Hangi kedi mamasının uygun olduğunu bilmiyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_023",
      "speaker": "店员",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ láikàn kànba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_026",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_027",
      "speaker": "店员",
      "zh": "这是元吗？",
      "pinyin": "Zhè shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_028",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是元。",
      "pinyin": "Èn, duì, zhè shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_029",
      "speaker": "刘梅",
      "zh": "元在哪儿？",
      "pinyin": "Yuán zài nǎr?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_030",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_031",
      "speaker": "店员",
      "zh": "那商店在哪儿？",
      "pinyin": "Nà shāngdiàn zài nǎér?",
      "tr": "Mağaza nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_032",
      "speaker": "张乐乐",
      "zh": "商店在那边。",
      "pinyin": "Shāngdiàn zài nàbian.",
      "tr": "Mağaza şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_033",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
