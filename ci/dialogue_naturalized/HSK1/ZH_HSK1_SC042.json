{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC042",
  "level": "HSK1",
  "sourceTitleZh": "在宠物店买东西",
  "sourceTitleTr": "Eczane/Pet Ürünü Alışverişi",
  "sourceMiniAdventureTr": "Aile veterinerin önerdiği ürünü pet mağazasında arar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC042_001",
      "speaker": "刘梅",
      "zh": "家人去宠物店。",
      "pinyin": "Jiā rén qù chǒng wù diàn.",
      "tr": "Aile pet mağazasına gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_003",
      "speaker": "店员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_006",
      "speaker": "张伟",
      "zh": "宠物店在哪儿？",
      "pinyin": "Chǒng wù diàn zài nǎ ér?",
      "tr": "Pet mağazası nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_007",
      "speaker": "店员",
      "zh": "宠物店在那边。",
      "pinyin": "Chǒng wù diàn zài nà biān.",
      "tr": "Pet mağazası şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_008",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_010",
      "speaker": "张伟",
      "zh": "你要猫粮吗？",
      "pinyin": "Nǐ yào māo liáng ma?",
      "tr": "Kedi maması ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_011",
      "speaker": "店员",
      "zh": "我要猫粮，谢谢。",
      "pinyin": "Wǒ yào māo liáng, xiè xiè.",
      "tr": "Kedi maması istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_012",
      "speaker": "张乐乐",
      "zh": "嗯，好。",
      "pinyin": "Ń, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_013",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_014",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_015",
      "speaker": "店员",
      "zh": "对，这是猫。",
      "pinyin": "Duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_016",
      "speaker": "张乐乐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎ ér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_017",
      "speaker": "刘梅",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhè lǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_018",
      "speaker": "张伟",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_019",
      "speaker": "店员",
      "zh": "对，这是钱。",
      "pinyin": "Duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_020",
      "speaker": "张乐乐",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎ ér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_021",
      "speaker": "刘梅",
      "zh": "钱在这里。",
      "pinyin": "Qián zài zhè lǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_022",
      "speaker": "张伟",
      "zh": "他们不知道哪种猫粮合适。",
      "pinyin": "Tā men bù zhī dào nǎ zhǒng māo liáng hé shì.",
      "tr": "Hangi kedi mamasının uygun olduğunu bilmiyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_023",
      "speaker": "店员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_025",
      "speaker": "刘梅",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_026",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_027",
      "speaker": "店员",
      "zh": "这是元吗？",
      "pinyin": "Zhè shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_028",
      "speaker": "张乐乐",
      "zh": "对，这是元。",
      "pinyin": "Duì, zhè shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_029",
      "speaker": "刘梅",
      "zh": "元在哪儿？",
      "pinyin": "Yuán zài nǎ ér?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_030",
      "speaker": "张伟",
      "zh": "元在这里。",
      "pinyin": "Yuán zài zhè lǐ.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_031",
      "speaker": "店员",
      "zh": "商店在哪儿？",
      "pinyin": "Shāng diàn zài nǎ ér?",
      "tr": "Mağaza nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_032",
      "speaker": "张乐乐",
      "zh": "商店在那边。",
      "pinyin": "Shāng diàn zài nà biān.",
      "tr": "Mağaza şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_033",
      "speaker": "刘梅",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_035",
      "speaker": "店员",
      "zh": "这是包吗？",
      "pinyin": "Zhè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_036",
      "speaker": "张乐乐",
      "zh": "对，这是包。",
      "pinyin": "Duì, zhè shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_037",
      "speaker": "刘梅",
      "zh": "包在哪儿？",
      "pinyin": "Bāo zài nǎ ér?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_038",
      "speaker": "张伟",
      "zh": "包在这里。",
      "pinyin": "Bāo zài zhè lǐ.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_039",
      "speaker": "店员",
      "zh": "这是药吗？",
      "pinyin": "Zhè shì yào ma?",
      "tr": "Bu, ilaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_040",
      "speaker": "张乐乐",
      "zh": "对，这是药。",
      "pinyin": "Duì, zhè shì yào.",
      "tr": "Evet, bu ilaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_041",
      "speaker": "刘梅",
      "zh": "药在哪儿？",
      "pinyin": "Yào zài nǎ ér?",
      "tr": "Ilaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_042",
      "speaker": "张伟",
      "zh": "药在这里。",
      "pinyin": "Yào zài zhè lǐ.",
      "tr": "Ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_043",
      "speaker": "店员",
      "zh": "店员帮他们找到了。",
      "pinyin": "Diàn yuán bāng tā men zhǎo dào le.",
      "tr": "Mağaza çalışanı bulmalarına yardım ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_045",
      "speaker": "刘梅",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_046",
      "speaker": "张伟",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_047",
      "speaker": "店员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_048",
      "speaker": "张乐乐",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
