    {
      "id": "DLG_ZH_HSK1_SC042_040",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是药。",
      "pinyin": "Èn, duì, zhè shì yào.",
      "tr": "Evet, bu ilaç."
