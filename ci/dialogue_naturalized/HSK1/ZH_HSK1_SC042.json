{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK1_SC042",
  "level": "HSK1",
  "sourceTitleZh": "在宠物店买东西",
  "sourceTitleTr": "Eczane/Pet Ürünü Alışverişi",
  "sourceMiniAdventureTr": "Aile veterinerin önerdiği ürünü pet mağazasında arar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC042_001",
      "speaker": "刘梅",
      "zh": "家人去宠物店。",
      "pinyin": "Jiārén qù chǒngwùdiàn.",
      "tr": "Aile pet mağazasına gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_003",
      "speaker": "店员",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_006",
      "speaker": "张伟",
      "zh": "宠物店呢？",
      "pinyin": "Chǒng wù diàn ne?",
      "tr": "Pet mağazası nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_007",
      "speaker": "店员",
      "zh": "宠物店在那边。",
      "pinyin": "Chǒngwùdiàn zài nàbian.",
      "tr": "Pet mağazası şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_008",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_010",
      "speaker": "张伟",
      "zh": "你要猫粮吗？",
      "pinyin": "Nǐ yào māoliáng ma?",
      "tr": "Kedi maması ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_011",
      "speaker": "店员",
      "zh": "我要猫粮，谢谢。",
      "pinyin": "Wǒ yào māoliáng, xièxie.",
      "tr": "Kedi maması istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_012",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_013",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_014",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_015",
      "speaker": "店员",
      "zh": "没错，是猫。",
      "pinyin": "Méi cuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_016",
      "speaker": "张乐乐",
      "zh": "那猫在哪儿？",
      "pinyin": "Nà māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_017",
      "speaker": "刘梅",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèr.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_018",
      "speaker": "张伟",
      "zh": "这是钱，对吗？",
      "pinyin": "Zhè shì qián, duì ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_019",
      "speaker": "店员",
      "zh": "没错，是钱。",
      "pinyin": "Méi cuò, shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_020",
      "speaker": "张乐乐",
      "zh": "那钱在哪儿？",
      "pinyin": "Nà qián zài nǎr?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_021",
      "speaker": "刘梅",
      "zh": "钱在这儿。",
      "pinyin": "Qián zài zhèr.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_022",
      "speaker": "张伟",
      "zh": "他们不知道哪种猫粮合适。",
      "pinyin": "Tāmen bù zhīdào nǎ zhǒng māoliáng héshì.",
      "tr": "Hangi kedi mamasının uygun olduğunu bilmiyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_023",
      "speaker": "店员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_026",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_027",
      "speaker": "店员",
      "zh": "这个是元吗？",
      "pinyin": "Zhè ge shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_028",
      "speaker": "张乐乐",
      "zh": "对，就是元。",
      "pinyin": "Duì, jiù shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_029",
      "speaker": "刘梅",
      "zh": "元在哪儿？",
      "pinyin": "Yuán zài nǎr?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_030",
      "speaker": "张伟",
      "zh": "元在这儿。",
      "pinyin": "Yuán zài zhèr.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_031",
      "speaker": "店员",
      "zh": "商店呢？",
      "pinyin": "Shāng diàn ne?",
      "tr": "Mağaza nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_032",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Mağaza şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_033",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_035",
      "speaker": "店员",
      "zh": "这个是包吗？",
      "pinyin": "Zhè ge shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_036",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是包。",
      "pinyin": "Èn, duì, zhè shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_037",
      "speaker": "刘梅",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_038",
      "speaker": "张伟",
      "zh": "包在这儿。",
      "pinyin": "Bāo zài zhèr.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_039",
      "speaker": "店员",
      "zh": "这是药吗？",
      "pinyin": "Zhè shì yào ma?",
      "tr": "Bu, ilaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_040",
      "speaker": "张乐乐",
      "zh": "对，就是药。",
      "pinyin": "Duì, jiù shì yào.",
      "tr": "Evet, bu ilaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_041",
      "speaker": "刘梅",
      "zh": "药呢？",
      "pinyin": "Yào ne?",
      "tr": "Ilaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_042",
      "speaker": "张伟",
      "zh": "你看，药在这儿。",
      "pinyin": "Nǐ kàn, yào zài zhèr.",
      "tr": "Ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_043",
      "speaker": "店员",
      "zh": "店员帮他们找到了。",
      "pinyin": "Diànyuán bāng tāmen zhǎodào le.",
      "tr": "Mağaza çalışanı bulmalarına yardım ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC042_045",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_046",
      "speaker": "张伟",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_047",
      "speaker": "店员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC042_049",
      "speaker": "刘梅",
      "zh": "那宠物店在哪儿？",
      "pinyin": "Nà chǒng wù diàn zài nǎr?",
