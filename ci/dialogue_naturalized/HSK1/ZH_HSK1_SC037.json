{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC037",
  "level": "HSK1",
  "sourceTitleZh": "公园里的星期天",
  "sourceTitleTr": "Parkta Bir Pazar",
  "sourceMiniAdventureTr": "Aile parkta yürür, oynar ve çevreyi keşfeder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC037_001",
      "speaker": "张伟",
      "zh": "星期天一家人去公园。",
      "pinyin": "Xīng qī tiān yī jiā rén qù gōng yuán.",
      "tr": "Pazar günü aile parka gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_003",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_004",
      "speaker": "张雨桐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_006",
      "speaker": "刘梅",
      "zh": "公园在哪儿？",
      "pinyin": "Gōng yuán zài nǎ ér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_007",
      "speaker": "张乐乐",
      "zh": "公园在那边。",
      "pinyin": "Gōng yuán zài nà biān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_008",
      "speaker": "张雨桐",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_009",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_010",
      "speaker": "刘梅",
      "zh": "这是天气吗？",
      "pinyin": "Zhè shì tiān qì ma?",
      "tr": "Bu, hava mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_011",
      "speaker": "张乐乐",
      "zh": "对，这是天气。",
      "pinyin": "Duì, zhè shì tiān qì.",
      "tr": "Evet, bu hava."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_012",
      "speaker": "张雨桐",
      "zh": "天气在哪儿？",
      "pinyin": "Tiān qì zài nǎ ér?",
      "tr": "Hava nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_013",
      "speaker": "张伟",
      "zh": "天气在这里。",
      "pinyin": "Tiān qì zài zhè lǐ.",
      "tr": "Hava burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_014",
      "speaker": "刘梅",
      "zh": "这是树吗？",
      "pinyin": "Zhè shì shù ma?",
      "tr": "Bu, ağaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_015",
      "speaker": "张乐乐",
      "zh": "对，这是树。",
      "pinyin": "Duì, zhè shì shù.",
      "tr": "Evet, bu ağaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_016",
      "speaker": "张雨桐",
      "zh": "树在哪儿？",
      "pinyin": "Shù zài nǎ ér?",
      "tr": "Ağaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_017",
      "speaker": "张伟",
      "zh": "树在这里。",
      "pinyin": "Shù zài zhè lǐ.",
      "tr": "Ağaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_018",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_019",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_020",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_021",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_022",
      "speaker": "刘梅",
      "zh": "乐乐想去很多地方。",
      "pinyin": "Lè lè xiǎng qù hěn duō dì fāng.",
      "tr": "Lele birçok yere gitmek istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_023",
      "speaker": "张乐乐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_024",
      "speaker": "张雨桐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_027",
      "speaker": "张乐乐",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒ men de hái zi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_028",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_030",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_031",
      "speaker": "张乐乐",
      "zh": "这是球吗？",
      "pinyin": "Zhè shì qiú ma?",
      "tr": "Bu, top mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_032",
      "speaker": "张雨桐",
      "zh": "对，这是球。",
      "pinyin": "Duì, zhè shì qiú.",
      "tr": "Evet, bu top."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_033",
      "speaker": "张伟",
      "zh": "球在哪儿？",
      "pinyin": "Qiú zài nǎ ér?",
      "tr": "Top nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_034",
      "speaker": "刘梅",
      "zh": "球在这里。",
      "pinyin": "Qiú zài zhè lǐ.",
      "tr": "Top burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_035",
      "speaker": "张乐乐",
      "zh": "我们坐自行车吗？",
      "pinyin": "Wǒ men zuò zì xíng chē ma?",
      "tr": "Bisiklet ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_036",
      "speaker": "张雨桐",
      "zh": "对，我们坐自行车。",
      "pinyin": "Duì, wǒ men zuò zì xíng chē.",
      "tr": "Evet, bisiklet ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_037",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_038",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_039",
      "speaker": "张乐乐",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_040",
      "speaker": "张雨桐",
      "zh": "有点儿。",
      "pinyin": "Yǒu diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guān xì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_042",
      "speaker": "刘梅",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_043",
      "speaker": "张乐乐",
      "zh": "大家一起散步和玩球。",
      "pinyin": "Dà jiā yī qǐ sàn bù hé wán qiú.",
      "tr": "Herkes birlikte yürüyüp top oynuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_044",
      "speaker": "张雨桐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC037_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_047",
      "speaker": "张乐乐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC037_048",
      "speaker": "张雨桐",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
