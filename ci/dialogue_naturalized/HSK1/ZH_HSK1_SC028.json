{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC028",
  "level": "HSK1",
  "sourceTitleZh": "面试前的准备",
  "sourceTitleTr": "İş Görüşmesine Hazırlık",
  "sourceMiniAdventureTr": "Liu Mei ve çocuklar Zhang için uygun gömlek seçer.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC028_001",
      "speaker": "张伟",
      "zh": "张伟在准备面试。",
      "pinyin": "Zhāng wěi zài zhǔn bèi miàn shì.",
      "tr": "Zhang Wei iş görüşmesine hazırlanıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_006",
      "speaker": "刘梅",
      "zh": "这是衣服吗？",
      "pinyin": "Zhè shì yī fú ma?",
      "tr": "Bu, kıyafet mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_007",
      "speaker": "张雨桐",
      "zh": "对，这是衣服。",
      "pinyin": "Duì, zhè shì yī fú.",
      "tr": "Evet, bu kıyafet."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_008",
      "speaker": "张乐乐",
      "zh": "衣服在哪儿？",
      "pinyin": "Yī fú zài nǎ ér?",
      "tr": "Kıyafet nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_009",
      "speaker": "张伟",
      "zh": "衣服在这里。",
      "pinyin": "Yī fú zài zhè lǐ.",
      "tr": "Kıyafet burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_010",
      "speaker": "刘梅",
      "zh": "这是衬衫吗？",
      "pinyin": "Zhè shì chèn shān ma?",
      "tr": "Bu, gömlek mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_011",
      "speaker": "张雨桐",
      "zh": "对，这是衬衫。",
      "pinyin": "Duì, zhè shì chèn shān.",
      "tr": "Evet, bu gömlek."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_012",
      "speaker": "张乐乐",
      "zh": "衬衫在哪儿？",
      "pinyin": "Chèn shān zài nǎ ér?",
      "tr": "Gömlek nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_013",
      "speaker": "张伟",
      "zh": "衬衫在这里。",
      "pinyin": "Chèn shān zài zhè lǐ.",
      "tr": "Gömlek burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_014",
      "speaker": "刘梅",
      "zh": "你喜欢蓝色吗？",
      "pinyin": "Nǐ xǐ huān lán sè ma?",
      "tr": "Mavi renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_015",
      "speaker": "张雨桐",
      "zh": "喜欢。",
      "pinyin": "Xǐ huān.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_016",
      "speaker": "张乐乐",
      "zh": "这个是蓝色的。",
      "pinyin": "Zhè gè shì lán sè de.",
      "tr": "Bu mavi renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_017",
      "speaker": "张伟",
      "zh": "很好看。",
      "pinyin": "Hěn hǎo kàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_018",
      "speaker": "刘梅",
      "zh": "你喜欢红色吗？",
      "pinyin": "Nǐ xǐ huān hóng sè ma?",
      "tr": "Kırmızı renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_019",
      "speaker": "张雨桐",
      "zh": "喜欢。",
      "pinyin": "Xǐ huān.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_020",
      "speaker": "张乐乐",
      "zh": "这个是红色的。",
      "pinyin": "Zhè gè shì hóng sè de.",
      "tr": "Bu kırmızı renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_021",
      "speaker": "张伟",
      "zh": "很好看。",
      "pinyin": "Hěn hǎo kàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_022",
      "speaker": "刘梅",
      "zh": "家人不知道哪件衬衫最好。",
      "pinyin": "Jiā rén bù zhī dào nǎ jiàn chèn shān zuì hǎo.",
      "tr": "Aile hangi gömleğin en iyi olduğuna karar veremiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_027",
      "speaker": "张雨桐",
      "zh": "今天有面试吗？",
      "pinyin": "Jīn tiān yǒu miàn shì ma?",
      "tr": "Bugün iş görüşmesi var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_028",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_029",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_030",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_031",
      "speaker": "张雨桐",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōng zuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_032",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_033",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_034",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_035",
      "speaker": "张雨桐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_036",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_037",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_038",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_039",
      "speaker": "张雨桐",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_040",
      "speaker": "张乐乐",
      "zh": "有一点儿。",
      "pinyin": "Yǒu yī diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guān xì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_042",
      "speaker": "刘梅",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_043",
      "speaker": "张雨桐",
      "zh": "大家选了蓝色衬衫。",
      "pinyin": "Dà jiā xuǎn le lán sè chèn shān.",
      "tr": "Herkes mavi gömleği seçiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC028_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_047",
      "speaker": "张雨桐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC028_048",
      "speaker": "张乐乐",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
