{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC015",
  "level": "HSK1",
  "sourceTitleZh": "请邻居喝茶",
  "sourceTitleTr": "Komşuya Çay",
  "sourceMiniAdventureTr": "Liu Mei komşuya çay veya su ikram eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC015_001",
      "speaker": "刘梅",
      "zh": "我们请邻居喝茶。",
      "pinyin": "Wǒmen qǐng línjū hē chá.",
      "tr": "Komşuya çay ikram ediyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_002",
      "speaker": "邻居",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_003",
      "speaker": "张伟",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_006",
      "speaker": "邻居",
      "zh": "要不要茶？",
      "pinyin": "Yào búyào chá?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_007",
      "speaker": "张伟",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒ yào chá, xièxie.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_008",
      "speaker": "张乐乐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_010",
      "speaker": "邻居",
      "zh": "要不要水？",
      "pinyin": "Yào búyào shuǐ?",
      "tr": "Su ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_011",
      "speaker": "张伟",
      "zh": "好，我要水，谢谢。",
      "pinyin": "Hǎo, wǒ yào shuǐ, xièxiè.",
      "tr": "Su istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_012",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_013",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_014",
      "speaker": "邻居",
      "zh": "你要咖啡吗？",
      "pinyin": "Nǐ yào kāfēi ma?",
      "tr": "Kahve ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_015",
      "speaker": "张伟",
      "zh": "好，我要咖啡，谢谢。",
      "pinyin": "Hǎo, wǒ yào kāfēi, xièxiè.",
      "tr": "Kahve istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_016",
      "speaker": "张乐乐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_017",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_018",
      "speaker": "邻居",
      "zh": "你要果汁吗？",
      "pinyin": "Nǐ yào guǒzhī ma?",
      "tr": "Meyve suyu ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_019",
      "speaker": "张伟",
      "zh": "好，我要果汁，谢谢。",
      "pinyin": "Hǎo, wǒ yào guǒzhī, xièxiè.",
      "tr": "Meyve suyu istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_020",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_021",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_022",
      "speaker": "邻居",
      "zh": "她不知道喝茶还是水。",
      "pinyin": "Tā bù zhīdào hē chá háishi shuǐ.",
      "tr": "Çay mı su mu içeceğine karar veremiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_023",
      "speaker": "张伟",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_025",
      "speaker": "刘梅",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_026",
      "speaker": "邻居",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_027",
      "speaker": "张伟",
      "zh": "这是杯子吗？",
      "pinyin": "Zhè shì bēizi ma?",
      "tr": "Bu, bardak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_028",
      "speaker": "张乐乐",
      "zh": "对，就是杯子。",
      "pinyin": "Duì, jiùshì bēizi.",
      "tr": "Evet, bu bardak."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_029",
      "speaker": "刘梅",
      "zh": "那杯子在哪儿？",
      "pinyin": "Nà bēizi zài nǎér?",
      "tr": "Bardak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_030",
      "speaker": "邻居",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bardak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_031",
      "speaker": "张伟",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhè shì wǒmen de línjū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_032",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_033",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_034",
      "speaker": "邻居",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_035",
      "speaker": "张伟",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_036",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是桌子。",
      "pinyin": "Èn, duì, zhè shì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_037",
      "speaker": "刘梅",
      "zh": "那桌子放在哪儿？",
      "pinyin": "Nà zhuōzi fàngzài nǎér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_038",
      "speaker": "邻居",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_039",
      "speaker": "张伟",
      "zh": "这是我们的客人。",
      "pinyin": "Zhè shì wǒmen de kèrén.",
      "tr": "Bu bizim misafir."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_041",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_042",
      "speaker": "邻居",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_043",
      "speaker": "张伟",
      "zh": "她要一杯茶。",
      "pinyin": "Tā yào yì bēi chá.",
      "tr": "Bir bardak çay istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_045",
      "speaker": "刘梅",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_046",
      "speaker": "邻居",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_047",
      "speaker": "张伟",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xiàxíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC015_049",
      "speaker": "刘梅",
      "zh": "要不要茶？",
      "pinyin": "Yào búyào chá?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC015_050",
