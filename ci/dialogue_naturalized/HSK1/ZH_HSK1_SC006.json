{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC006",
  "level": "HSK1",
  "sourceTitleZh": "第一次看见新城",
  "sourceTitleTr": "Yeni Kasabayı İlk Görüş",
  "sourceMiniAdventureTr": "Tren yeni kasabaya yaklaşırken aile pencereden gördüklerini konuşur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC006_001",
      "speaker": "张伟",
      "zh": "我们快到新城了。",
      "pinyin": "Wǒ men kuài dào xīn chéng le.",
      "tr": "Yeni kasabaya yaklaştık."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_006",
      "speaker": "刘梅",
      "zh": "城市在哪儿？",
      "pinyin": "Chéng shì zài nǎ ér?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_007",
      "speaker": "张雨桐",
      "zh": "城市在那边。",
      "pinyin": "Chéng shì zài nà biān.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_008",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_009",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_010",
      "speaker": "刘梅",
      "zh": "学校在哪儿？",
      "pinyin": "Xué xiào zài nǎ ér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_011",
      "speaker": "张雨桐",
      "zh": "学校在那边。",
      "pinyin": "Xué xiào zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_012",
      "speaker": "张乐乐",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_014",
      "speaker": "刘梅",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_015",
      "speaker": "张雨桐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_016",
      "speaker": "张乐乐",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_018",
      "speaker": "刘梅",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎ ér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_019",
      "speaker": "张雨桐",
      "zh": "路在那边。",
      "pinyin": "Lù zài nà biān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_020",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_022",
      "speaker": "刘梅",
      "zh": "大家都想看外面。",
      "pinyin": "Dà jiā dōu xiǎng kàn wài miàn.",
      "tr": "Herkes dışarıyı görmek istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_024",
      "speaker": "张乐乐",
      "zh": "我看看。",
      "pinyin": "Wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_027",
      "speaker": "张雨桐",
      "zh": "公园在哪儿？",
      "pinyin": "Gōng yuán zài nǎ ér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_028",
      "speaker": "张乐乐",
      "zh": "公园在那边。",
      "pinyin": "Gōng yuán zài nà biān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_029",
      "speaker": "张伟",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_030",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_031",
      "speaker": "张雨桐",
      "zh": "这是新的吗？",
      "pinyin": "Zhè shì xīn de ma?",
      "tr": "Bu, yeni mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_032",
      "speaker": "张乐乐",
      "zh": "对，这是新的。",
      "pinyin": "Duì, zhè shì xīn de.",
      "tr": "Evet, bu yeni."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_033",
      "speaker": "张伟",
      "zh": "新的在哪儿？",
      "pinyin": "Xīn de zài nǎ ér?",
      "tr": "Yeni nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_034",
      "speaker": "刘梅",
      "zh": "新的在这里。",
      "pinyin": "Xīn de zài zhè lǐ.",
      "tr": "Yeni burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_035",
      "speaker": "张雨桐",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒ men de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_037",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_038",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_039",
      "speaker": "张雨桐",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒ men zuò huǒ chē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_040",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒ men zuò huǒ chē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_041",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_042",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_043",
      "speaker": "张雨桐",
      "zh": "新城很漂亮。",
      "pinyin": "Xīn chéng hěn piāo liàng.",
      "tr": "Yeni kasaba çok güzel."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC006_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_047",
      "speaker": "张雨桐",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC006_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
