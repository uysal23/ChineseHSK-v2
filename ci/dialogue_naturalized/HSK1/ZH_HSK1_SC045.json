{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC045",
  "level": "HSK1",
  "sourceTitleZh": "第一个发薪日",
  "sourceTitleTr": "Zhang’ın Maaş Günü",
  "sourceMiniAdventureTr": "Zhang ilk maaşını alınca aile küçük bir akşam yemeği planlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC045_001",
      "speaker": "张伟",
      "zh": "张伟拿到第一个月的工资。",
      "pinyin": "Zhāng Wěi ná dào dì yí ge yuè de gōngzī.",
      "tr": "Zhang Wei ilk aylık maaşını aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_006",
      "speaker": "刘梅",
      "zh": "这是工资吗？",
      "pinyin": "Zhè shì gōngzī ma?",
      "tr": "Bu, maaş mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_007",
      "speaker": "张雨桐",
      "zh": "没错，是工资。",
      "pinyin": "Méicuò, shì gōngzī.",
      "tr": "Evet, bu maaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_008",
      "speaker": "张乐乐",
      "zh": "工资在哪儿？",
      "pinyin": "Gōngzī zài nǎr?",
      "tr": "Maaş nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_009",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Maaş burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_010",
      "speaker": "刘梅",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_011",
      "speaker": "张雨桐",
      "zh": "没错，是钱。",
      "pinyin": "Méicuò, shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_012",
      "speaker": "张乐乐",
      "zh": "那钱放在哪儿？",
      "pinyin": "Nà qián fàngzài nǎér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_013",
      "speaker": "张伟",
      "zh": "你看，钱在这儿。",
      "pinyin": "Nǐ kàn, qián zài zhèér.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_014",
      "speaker": "刘梅",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎnshang yǒu shíjiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_015",
      "speaker": "张雨桐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_016",
      "speaker": "张乐乐",
      "zh": "晚上见。",
      "pinyin": "Wǎnshang jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_017",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_018",
      "speaker": "刘梅",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_019",
      "speaker": "张雨桐",
      "zh": "好，我要饭，谢谢。",
      "pinyin": "Hǎo, wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_020",
      "speaker": "张乐乐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_022",
      "speaker": "刘梅",
      "zh": "大家想怎么庆祝。",
      "pinyin": "Dàjiā xiǎng zěnme qìngzhù.",
      "tr": "Herkes nasıl kutlayacağını düşünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_023",
      "speaker": "张雨桐",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_027",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_028",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_030",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_031",
      "speaker": "张雨桐",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_032",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_033",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_034",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_035",
      "speaker": "张雨桐",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_036",
      "speaker": "张乐乐",
      "zh": "有点儿。",
      "pinyin": "Yǒudiǎnér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_037",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_038",
      "speaker": "刘梅",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒmen jìxù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_039",
      "speaker": "张雨桐",
      "zh": "这是菜单吗？",
      "pinyin": "Zhè shì càidān ma?",
      "tr": "Bu, menü mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_040",
      "speaker": "张乐乐",
      "zh": "对，就是菜单。",
      "pinyin": "Duì, jiùshì càidān.",
      "tr": "Evet, bu menü."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_041",
      "speaker": "张伟",
      "zh": "菜单在哪儿？",
      "pinyin": "Càidān zài nǎr?",
      "tr": "Menü nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_042",
      "speaker": "刘梅",
      "zh": "菜单在这儿。",
      "pinyin": "Càidān zài zhèér.",
      "tr": "Menü burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_043",
      "speaker": "张雨桐",
      "zh": "他们决定晚上一起吃饭。",
      "pinyin": "Tāmen juédìng wǎnshang yìqǐ chīfàn.",
      "tr": "Akşam birlikte yemek yemeye karar veriyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_047",
      "speaker": "张雨桐",
      "zh": "现在就好了。",
      "pinyin": "Xiànzài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
