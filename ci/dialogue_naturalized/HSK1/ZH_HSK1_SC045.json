{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC045",
  "level": "HSK1",
  "sourceTitleZh": "第一个发薪日",
  "sourceTitleTr": "Zhang’ın Maaş Günü",
  "sourceMiniAdventureTr": "Zhang ilk maaşını alınca aile küçük bir akşam yemeği planlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC045_001",
      "speaker": "张伟",
      "zh": "张伟拿到第一个月的工资。",
      "pinyin": "Zhāng wěi ná dào dì yī gè yuè de gōng zī.",
      "tr": "Zhang Wei ilk aylık maaşını aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_006",
      "speaker": "刘梅",
      "zh": "这是工资吗？",
      "pinyin": "Zhè shì gōng zī ma?",
      "tr": "Bu, maaş mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_007",
      "speaker": "张雨桐",
      "zh": "对，这是工资。",
      "pinyin": "Duì, zhè shì gōng zī.",
      "tr": "Evet, bu maaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_008",
      "speaker": "张乐乐",
      "zh": "工资在哪儿？",
      "pinyin": "Gōng zī zài nǎ ér?",
      "tr": "Maaş nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_009",
      "speaker": "张伟",
      "zh": "工资在这里。",
      "pinyin": "Gōng zī zài zhè lǐ.",
      "tr": "Maaş burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_010",
      "speaker": "刘梅",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_011",
      "speaker": "张雨桐",
      "zh": "对，这是钱。",
      "pinyin": "Duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_012",
      "speaker": "张乐乐",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎ ér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_013",
      "speaker": "张伟",
      "zh": "钱在这里。",
      "pinyin": "Qián zài zhè lǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_014",
      "speaker": "刘梅",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎn shàng yǒu shí jiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_015",
      "speaker": "张雨桐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_016",
      "speaker": "张乐乐",
      "zh": "晚上见。",
      "pinyin": "Wǎn shàng jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_017",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_018",
      "speaker": "刘梅",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_019",
      "speaker": "张雨桐",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xiè xiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_020",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_022",
      "speaker": "刘梅",
      "zh": "大家想怎么庆祝。",
      "pinyin": "Dà jiā xiǎng zěn me qìng zhù.",
      "tr": "Herkes nasıl kutlayacağını düşünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_027",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_028",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_030",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_031",
      "speaker": "张雨桐",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōng zuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_032",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_033",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_034",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_035",
      "speaker": "张雨桐",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_036",
      "speaker": "张乐乐",
      "zh": "有一点儿。",
      "pinyin": "Yǒu yī diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_037",
      "speaker": "张伟",
      "zh": "没关系，别急。",
      "pinyin": "Méi guān xì, bié jí.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_038",
      "speaker": "刘梅",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_039",
      "speaker": "张雨桐",
      "zh": "这是菜单吗？",
      "pinyin": "Zhè shì cài dān ma?",
      "tr": "Bu, menü mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_040",
      "speaker": "张乐乐",
      "zh": "对，这是菜单。",
      "pinyin": "Duì, zhè shì cài dān.",
      "tr": "Evet, bu menü."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_041",
      "speaker": "张伟",
      "zh": "菜单在哪儿？",
      "pinyin": "Cài dān zài nǎ ér?",
      "tr": "Menü nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_042",
      "speaker": "刘梅",
      "zh": "菜单在这里。",
      "pinyin": "Cài dān zài zhè lǐ.",
      "tr": "Menü burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_043",
      "speaker": "张雨桐",
      "zh": "他们决定晚上一起吃饭。",
      "pinyin": "Tā men jué dìng wǎn shàng yī qǐ chī fàn.",
      "tr": "Akşam birlikte yemek yemeye karar veriyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC045_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_047",
      "speaker": "张雨桐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_048",
      "speaker": "张乐乐",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC045_049",
      "speaker": "张伟",
      "zh": "这是工资吗？",
      "pinyin": "Zhè shì gōng zī ma?",
