{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC048",
  "level": "HSK1",
  "sourceTitleZh": "社区活动",
  "sourceTitleTr": "Mahalle Etkinliği",
  "sourceMiniAdventureTr": "Aile yerel bir topluluk etkinliğine katılıp yeni insanlarla tanışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC048_001",
      "speaker": "张伟",
      "zh": "一家人参加社区活动。",
      "pinyin": "Yī jiā rén cān jiā shè qū huó dòng.",
      "tr": "Aile mahalle etkinliğine katılıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_003",
      "speaker": "社区工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_004",
      "speaker": "新朋友",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_006",
      "speaker": "刘梅",
      "zh": "社区在哪儿？",
      "pinyin": "Shè qū zài nǎ ér?",
      "tr": "Mahalle / topluluk nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_007",
      "speaker": "社区工作人员",
      "zh": "社区在那边。",
      "pinyin": "Shè qū zài nà biān.",
      "tr": "Mahalle / topluluk şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_008",
      "speaker": "新朋友",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_009",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_010",
      "speaker": "刘梅",
      "zh": "今天有活动吗？",
      "pinyin": "Jīn tiān yǒu huó dòng ma?",
      "tr": "Bugün etkinlik var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_011",
      "speaker": "社区工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_012",
      "speaker": "新朋友",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_013",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_015",
      "speaker": "社区工作人员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_016",
      "speaker": "新朋友",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_017",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_018",
      "speaker": "刘梅",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒ men de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_019",
      "speaker": "社区工作人员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_020",
      "speaker": "新朋友",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_021",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_022",
      "speaker": "刘梅",
      "zh": "他们还不认识很多人。",
      "pinyin": "Tā men hái bù rèn shí hěn duō rén.",
      "tr": "Henüz çok fazla kişi tanımıyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_023",
      "speaker": "社区工作人员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_024",
      "speaker": "新朋友",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_027",
      "speaker": "社区工作人员",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_028",
      "speaker": "新朋友",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_030",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_031",
      "speaker": "社区工作人员",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_032",
      "speaker": "新朋友",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xiè xiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_033",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_034",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_035",
      "speaker": "社区工作人员",
      "zh": "公园在哪儿？",
      "pinyin": "Gōng yuán zài nǎ ér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_036",
      "speaker": "新朋友",
      "zh": "公园在那边。",
      "pinyin": "Gōng yuán zài nà biān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_037",
      "speaker": "张伟",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_038",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_039",
      "speaker": "社区工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_040",
      "speaker": "新朋友",
      "zh": "有点儿。",
      "pinyin": "Yǒu diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guān xì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_042",
      "speaker": "刘梅",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_043",
      "speaker": "社区工作人员",
      "zh": "今天他们认识了新朋友。",
      "pinyin": "Jīn tiān tā men rèn shí le xīn péng yǒu.",
      "tr": "Bugün yeni arkadaşlar edindiler."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_044",
      "speaker": "新朋友",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_047",
      "speaker": "社区工作人员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_048",
      "speaker": "新朋友",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
