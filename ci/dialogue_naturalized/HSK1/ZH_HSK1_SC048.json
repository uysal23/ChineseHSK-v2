{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC048",
  "level": "HSK1",
  "sourceTitleZh": "社区活动",
  "sourceTitleTr": "Mahalle Etkinliği",
  "sourceMiniAdventureTr": "Aile yerel bir topluluk etkinliğine katılıp yeni insanlarla tanışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC048_001",
      "speaker": "张伟",
      "zh": "一家人参加社区活动。",
      "pinyin": "Yì jiā rén cānjiā shèqū huódòng.",
      "tr": "Aile mahalle etkinliğine katılıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_003",
      "speaker": "社区工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_004",
      "speaker": "新朋友",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_006",
      "speaker": "刘梅",
      "zh": "社区呢？",
      "pinyin": "Shèqū ne?",
      "tr": "Mahalle / topluluk nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_007",
      "speaker": "社区工作人员",
      "zh": "你看，社区在那边。",
      "pinyin": "Nǐ kàn, shèqū zài nàbiān.",
      "tr": "Mahalle / topluluk şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_008",
      "speaker": "新朋友",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_009",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_010",
      "speaker": "刘梅",
      "zh": "今天有活动吗？",
      "pinyin": "Jīntiān yǒu huódòng ma?",
      "tr": "Bugün etkinlik var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_011",
      "speaker": "社区工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_012",
      "speaker": "新朋友",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_013",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_015",
      "speaker": "社区工作人员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_016",
      "speaker": "新朋友",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_017",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_018",
      "speaker": "刘梅",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_019",
      "speaker": "社区工作人员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_020",
      "speaker": "新朋友",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_021",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_022",
      "speaker": "刘梅",
      "zh": "他们还不认识很多人。",
      "pinyin": "Tāmen hái bù rènshi hěn duō rén.",
      "tr": "Henüz çok fazla kişi tanımıyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_023",
      "speaker": "社区工作人员",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_024",
      "speaker": "新朋友",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_027",
      "speaker": "社区工作人员",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_028",
      "speaker": "新朋友",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_030",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_031",
      "speaker": "社区工作人员",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_032",
      "speaker": "新朋友",
      "zh": "好，我要饭，谢谢。",
      "pinyin": "Hǎo, wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_033",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_035",
      "speaker": "社区工作人员",
      "zh": "那公园在哪儿？",
      "pinyin": "Nà gōngyuán zài nǎér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_036",
      "speaker": "新朋友",
      "zh": "公园在那边。",
      "pinyin": "Gōngyuán zài nàbian.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_037",
      "speaker": "张伟",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_038",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_039",
      "speaker": "社区工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_040",
      "speaker": "新朋友",
      "zh": "有点儿。",
      "pinyin": "Yǒudiǎnér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_041",
      "speaker": "张伟",
      "zh": "没事。",
      "pinyin": "Méishì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_042",
      "speaker": "刘梅",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒmen jìxù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_043",
      "speaker": "社区工作人员",
      "zh": "今天他们认识了新朋友。",
      "pinyin": "Jīntiān tāmen rènshi le xīn péngyou.",
      "tr": "Bugün yeni arkadaşlar edindiler."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_044",
      "speaker": "新朋友",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_047",
      "speaker": "社区工作人员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xiàxíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_048",
      "speaker": "新朋友",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC048_049",
      "speaker": "张伟",
      "zh": "社区在哪儿？",
      "pinyin": "Shèqū zài nǎr?",
      "tr": "Mahalle / topluluk nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC048_050",
      "speaker": "刘梅",
      "zh": "社区在那边。",
      "pinyin": "Shèqū zài nàbian.",
      "tr": "Mahalle / topluluk şu tarafta."
