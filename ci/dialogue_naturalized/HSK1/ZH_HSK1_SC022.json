{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC022",
  "level": "HSK1",
  "sourceTitleZh": "新班级",
  "sourceTitleTr": "Yeni Sınıf",
  "sourceMiniAdventureTr": "Öğretmen Yutong’u sınıfa tanıtır; öğrenciler basit sorular sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC022_001",
      "speaker": "老师",
      "zh": "雨桐来到新班级。",
      "pinyin": "Yǔ tóng lái dào xīn bān jí.",
      "tr": "Yutong yeni sınıfına geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_003",
      "speaker": "同学",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_004",
      "speaker": "同学",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_005",
      "speaker": "老师",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_006",
      "speaker": "张雨桐",
      "zh": "教室在哪儿？",
      "pinyin": "Jiào shì zài nǎ ér?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_007",
      "speaker": "同学",
      "zh": "教室在那边。",
      "pinyin": "Jiào shì zài nà biān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_008",
      "speaker": "同学",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_009",
      "speaker": "老师",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_010",
      "speaker": "张雨桐",
      "zh": "这是我们的学生。",
      "pinyin": "Zhè shì wǒ men de xué shēng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_011",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_012",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_013",
      "speaker": "老师",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_014",
      "speaker": "张雨桐",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒ men de lǎo shī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_015",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_016",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_017",
      "speaker": "老师",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_018",
      "speaker": "张雨桐",
      "zh": "这是班吗？",
      "pinyin": "Zhè shì bān ma?",
      "tr": "Bu, sınıf / şube mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_019",
      "speaker": "同学",
      "zh": "对，这是班。",
      "pinyin": "Duì, zhè shì bān.",
      "tr": "Evet, bu sınıf / şube."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_020",
      "speaker": "同学",
      "zh": "班在哪儿？",
      "pinyin": "Bān zài nǎ ér?",
      "tr": "Sınıf / şube nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_021",
      "speaker": "老师",
      "zh": "班在这里。",
      "pinyin": "Bān zài zhè lǐ.",
      "tr": "Sınıf / şube burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_022",
      "speaker": "张雨桐",
      "zh": "大家还不知道她是谁。",
      "pinyin": "Dà jiā hái bù zhī dào tā shì shuí.",
      "tr": "Kimse henüz onun kim olduğunu bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_023",
      "speaker": "同学",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_024",
      "speaker": "同学",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_025",
      "speaker": "老师",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_026",
      "speaker": "张雨桐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_027",
      "speaker": "同学",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míng zì shì shén me?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_028",
      "speaker": "同学",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míng zì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_029",
      "speaker": "老师",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_030",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_031",
      "speaker": "同学",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_032",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_033",
      "speaker": "老师",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_034",
      "speaker": "张雨桐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_035",
      "speaker": "同学",
      "zh": "学校在哪儿？",
      "pinyin": "Xué xiào zài nǎ ér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_036",
      "speaker": "同学",
      "zh": "学校在那边。",
      "pinyin": "Xué xiào zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_037",
      "speaker": "老师",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_038",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_039",
      "speaker": "同学",
      "zh": "这是书吗？",
      "pinyin": "Zhè shì shū ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_040",
      "speaker": "同学",
      "zh": "对，这是书。",
      "pinyin": "Duì, zhè shì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_041",
      "speaker": "老师",
      "zh": "书在哪儿？",
      "pinyin": "Shū zài nǎ ér?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_042",
      "speaker": "张雨桐",
      "zh": "书在这里。",
      "pinyin": "Shū zài zhè lǐ.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_043",
      "speaker": "同学",
      "zh": "老师介绍了雨桐。",
      "pinyin": "Lǎo shī jiè shào le yǔ tóng.",
      "tr": "Öğretmen Yutong’u tanıttı."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_044",
      "speaker": "同学",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_045",
      "speaker": "老师",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_046",
      "speaker": "张雨桐",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_047",
      "speaker": "同学",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_048",
      "speaker": "同学",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_049",
      "speaker": "老师",
      "zh": "教室在哪儿？",
      "pinyin": "Jiào shì zài nǎ ér?",
