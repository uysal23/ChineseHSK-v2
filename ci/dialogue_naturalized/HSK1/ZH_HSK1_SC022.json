{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC022",
  "level": "HSK1",
  "sourceTitleZh": "新班级",
  "sourceTitleTr": "Yeni Sınıf",
  "sourceMiniAdventureTr": "Öğretmen Yutong’u sınıfa tanıtır; öğrenciler basit sorular sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC022_001",
      "speaker": "老师",
      "zh": "雨桐来到新班级。",
      "pinyin": "Yǔtóng láidào xīn bānjí.",
      "tr": "Yutong yeni sınıfına geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_002",
      "speaker": "张雨桐",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_003",
      "speaker": "同学",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_004",
      "speaker": "同学",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_005",
      "speaker": "老师",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_006",
      "speaker": "张雨桐",
      "zh": "教室呢？",
      "pinyin": "Jiàoshì ne?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_007",
      "speaker": "同学",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_008",
      "speaker": "同学",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_009",
      "speaker": "老师",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_010",
      "speaker": "张雨桐",
      "zh": "这是我们的学生。",
      "pinyin": "Zhè shì wǒmen de xuésheng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_011",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_012",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_013",
      "speaker": "老师",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_014",
      "speaker": "张雨桐",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_015",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_016",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_017",
      "speaker": "老师",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_018",
      "speaker": "张雨桐",
      "zh": "这是班吗？",
      "pinyin": "Zhè shì bān ma?",
      "tr": "Bu, sınıf / şube mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_019",
      "speaker": "同学",
      "zh": "对，就是班。",
      "pinyin": "Duì, jiùshì bān.",
      "tr": "Evet, bu sınıf / şube."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_020",
      "speaker": "同学",
      "zh": "那班在哪儿？",
      "pinyin": "Nà bān zài nǎér?",
      "tr": "Sınıf / şube nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_021",
      "speaker": "老师",
      "zh": "你看，班在这儿。",
      "pinyin": "Nǐ kàn, bān zài zhèér.",
      "tr": "Sınıf / şube burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_022",
      "speaker": "张雨桐",
      "zh": "大家还不知道她是谁。",
      "pinyin": "Dàjiā hái bù zhīdào tā shì shéi.",
      "tr": "Kimse henüz onun kim olduğunu bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_023",
      "speaker": "同学",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_024",
      "speaker": "同学",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_025",
      "speaker": "老师",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_026",
      "speaker": "张雨桐",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_027",
      "speaker": "同学",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzi shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_028",
      "speaker": "同学",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzi.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_029",
      "speaker": "老师",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_030",
      "speaker": "张雨桐",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_031",
      "speaker": "同学",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_032",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_033",
      "speaker": "老师",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_034",
      "speaker": "张雨桐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_035",
      "speaker": "同学",
      "zh": "那学校在哪儿？",
      "pinyin": "Nà xuéxiào zài nǎér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_036",
      "speaker": "同学",
      "zh": "学校在那边。",
      "pinyin": "Xuéxiào zài nàbian.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_037",
      "speaker": "老师",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_038",
      "speaker": "张雨桐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_039",
      "speaker": "同学",
      "zh": "这是书吗？",
      "pinyin": "Zhè shì shū ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_040",
      "speaker": "同学",
      "zh": "对，就是书。",
      "pinyin": "Duì, jiùshì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_041",
      "speaker": "老师",
      "zh": "书在哪儿？",
      "pinyin": "Shū zài nǎr?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_042",
      "speaker": "张雨桐",
      "zh": "你看，书在这儿。",
      "pinyin": "Nǐ kàn, shū zài zhèér.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_043",
      "speaker": "同学",
      "zh": "老师介绍了雨桐。",
      "pinyin": "Lǎoshī jièshào le Yǔtóng.",
      "tr": "Öğretmen Yutong’u tanıttı."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_044",
      "speaker": "同学",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC022_045",
      "speaker": "老师",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_046",
      "speaker": "张雨桐",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_047",
      "speaker": "同学",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xiàxíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_048",
      "speaker": "同学",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC022_049",
      "speaker": "老师",
      "zh": "教室呢？",
      "pinyin": "Jiàoshì ne?",
      "tr": "Sınıf nerede?"
    },
    {
