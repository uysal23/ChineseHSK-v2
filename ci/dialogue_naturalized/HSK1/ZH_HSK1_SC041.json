{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC041",
  "level": "HSK1",
  "sourceTitleZh": "咪咪去看兽医",
  "sourceTitleTr": "Mimi Veterinerde",
  "sourceMiniAdventureTr": "Mimi yemek yemeyince aile onu veterinere götürür.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC041_001",
      "speaker": "刘梅",
      "zh": "咪咪今天不吃饭。",
      "pinyin": "Mīmī jīntiān bù chīfàn.",
      "tr": "Mimi bugün yemek yemiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_003",
      "speaker": "兽医",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_005",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_006",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_007",
      "speaker": "兽医",
      "zh": "没错，是猫。",
      "pinyin": "Méicuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_008",
      "speaker": "张乐乐",
      "zh": "那猫放在哪儿？",
      "pinyin": "Nà māo fàngzài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_009",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_010",
      "speaker": "张伟",
      "zh": "这是我们的兽医。",
      "pinyin": "Zhè shì wǒmen de shòuyī.",
      "tr": "Bu bizim veteriner."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_011",
      "speaker": "兽医",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_013",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_014",
      "speaker": "张伟",
      "zh": "这是我们的医生。",
      "pinyin": "Zhè shì wǒmen de yīshēng.",
      "tr": "Bu bizim doktor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_015",
      "speaker": "兽医",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_016",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_017",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_018",
      "speaker": "张伟",
      "zh": "医院在哪儿？",
      "pinyin": "Yīyuàn zài nǎr?",
      "tr": "Hastane nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_019",
      "speaker": "兽医",
      "zh": "医院在那边。",
      "pinyin": "Yīyuàn zài nàbian.",
      "tr": "Hastane şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_020",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_021",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_022",
      "speaker": "张伟",
      "zh": "家人有一点担心。",
      "pinyin": "Jiārén yǒu yìdiǎn dānxīn.",
      "tr": "Aile biraz endişeli."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_023",
      "speaker": "兽医",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_025",
      "speaker": "刘梅",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_026",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_027",
      "speaker": "兽医",
      "zh": "这是药吗？",
      "pinyin": "Zhè shì yào ma?",
      "tr": "Bu, ilaç mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_028",
      "speaker": "张乐乐",
      "zh": "没错，是药。",
      "pinyin": "Méicuò, shì yào.",
      "tr": "Evet, bu ilaç."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_029",
      "speaker": "刘梅",
      "zh": "药在哪儿？",
      "pinyin": "Yào zài nǎr?",
      "tr": "Ilaç nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_030",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Ilaç burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_031",
      "speaker": "兽医",
      "zh": "要不要水？",
      "pinyin": "Yào búyào shuǐ?",
      "tr": "Su ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_032",
      "speaker": "张乐乐",
      "zh": "那我要水吧，谢谢。",
      "pinyin": "Nà wǒ yào shuǐba, xièxiè.",
      "tr": "Su istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_033",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_035",
      "speaker": "兽医",
      "zh": "要不要饭？",
      "pinyin": "Yào búyào fàn?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_036",
      "speaker": "张乐乐",
      "zh": "那我要饭吧，谢谢。",
      "pinyin": "Nà wǒ yàofàn ba, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_037",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_038",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_039",
      "speaker": "兽医",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_040",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_041",
      "speaker": "刘梅",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_042",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_043",
      "speaker": "兽医",
      "zh": "兽医说咪咪没有大问题。",
      "pinyin": "Shòuyī shuō Mīmī méiyǒu dà wèntí.",
      "tr": "Veteriner Mimi’nin ciddi bir sorunu olmadığını söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_045",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_046",
      "speaker": "张伟",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_047",
      "speaker": "兽医",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
