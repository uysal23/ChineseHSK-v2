{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC046",
  "level": "HSK1",
  "sourceTitleZh": "刘梅的蛋糕",
  "sourceTitleTr": "Liu Mei’nin Kekleri",
  "sourceMiniAdventureTr": "Liu Mei komşular için kek yapar; herkes çok beğenir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC046_001",
      "speaker": "刘梅",
      "zh": "刘梅做了几个蛋糕。",
      "pinyin": "Liú Méi zuò le jǐ ge dàngāo.",
      "tr": "Liu Mei birkaç kek yaptı."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_003",
      "speaker": "邻居",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_005",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_006",
      "speaker": "张伟",
      "zh": "要不要蛋糕？",
      "pinyin": "Yào búyào dàngāo?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_007",
      "speaker": "邻居",
      "zh": "那我要蛋糕吧，谢谢。",
      "pinyin": "Nà wǒ yào dàngāo ba, xièxiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_008",
      "speaker": "张乐乐",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_009",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_010",
      "speaker": "张伟",
      "zh": "你想要饭吗？",
      "pinyin": "Nǐ xiǎngyào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_011",
      "speaker": "邻居",
      "zh": "那我要饭吧，谢谢。",
      "pinyin": "Nà wǒ yàofàn ba, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_012",
      "speaker": "张乐乐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_013",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_014",
      "speaker": "张伟",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhè shì wǒmen de línjū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_015",
      "speaker": "邻居",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_016",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_017",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_018",
      "speaker": "张伟",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_019",
      "speaker": "邻居",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_020",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_021",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_022",
      "speaker": "张伟",
      "zh": "邻居都说很好吃。",
      "pinyin": "Línjū dōu shuō hěn hǎochī.",
      "tr": "Komşular hepsinin çok lezzetli olduğunu söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_023",
      "speaker": "邻居",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_024",
      "speaker": "张乐乐",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_026",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_027",
      "speaker": "邻居",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_028",
      "speaker": "张乐乐",
      "zh": "那我要茶吧，谢谢。",
      "pinyin": "Nà wǒ yào chá ba, xièxiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_029",
      "speaker": "刘梅",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_030",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_031",
      "speaker": "邻居",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_032",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_033",
      "speaker": "刘梅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_035",
      "speaker": "邻居",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_037",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_038",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_039",
      "speaker": "邻居",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_040",
      "speaker": "张乐乐",
      "zh": "嗯，有一点。",
      "pinyin": "Èn, yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_041",
      "speaker": "刘梅",
      "zh": "没事。",
      "pinyin": "Méishì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_042",
      "speaker": "张伟",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_043",
      "speaker": "邻居",
      "zh": "刘梅很高兴。",
      "pinyin": "Liú Méi hěn gāoxìng.",
      "tr": "Liu Mei çok mutlu."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_045",
      "speaker": "刘梅",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_046",
      "speaker": "张伟",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_047",
      "speaker": "邻居",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xiàxíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC046_049",
      "speaker": "刘梅",
      "zh": "你想要蛋糕吗？",
      "pinyin": "Nǐ xiǎngyào dàngāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC046_050",
