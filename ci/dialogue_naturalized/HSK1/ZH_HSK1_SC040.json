{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK1_SC040",
  "level": "HSK1",
  "sourceTitleZh": "邻居的包裹",
  "sourceTitleTr": "Komşunun Paketi",
  "sourceMiniAdventureTr": "Kurye komşunun paketini yanlışlıkla Zhang ailesine bırakır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC040_001",
      "speaker": "张伟",
      "zh": "快递送来了一个包裹。",
      "pinyin": "Kuàidì sòng lái le yí ge bāoguǒ.",
      "tr": "Kurye bir paket getirdi."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_003",
      "speaker": "快递员",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_004",
      "speaker": "邻居",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_006",
      "speaker": "刘梅",
      "zh": "这是包裹吗？",
      "pinyin": "Zhè shì bāoguǒ ma?",
      "tr": "Bu, paket / kargo mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_007",
      "speaker": "快递员",
      "zh": "没错，是包裹。",
      "pinyin": "Méi cuò, shì bāo guǒ.",
      "tr": "Evet, bu paket / kargo."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_008",
      "speaker": "邻居",
      "zh": "包裹在哪儿？",
      "pinyin": "Bāoguǒ zài nǎr?",
      "tr": "Paket / kargo nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_009",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Paket / kargo burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_010",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dìzhǐ shì shénme?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_011",
      "speaker": "快递员",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_012",
      "speaker": "邻居",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_013",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_014",
      "speaker": "刘梅",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhè shì wǒmen de línjū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_015",
      "speaker": "快递员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_016",
      "speaker": "邻居",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_017",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_018",
      "speaker": "刘梅",
      "zh": "这个是门吗？",
      "pinyin": "Zhè ge shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_019",
      "speaker": "快递员",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiù shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_020",
      "speaker": "邻居",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎr?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_021",
      "speaker": "张伟",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèr.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_022",
      "speaker": "刘梅",
      "zh": "包裹上的名字不是张伟。",
      "pinyin": "Bāoguǒ shàng de míngzi bú shì Zhāng Wěi.",
      "tr": "Paketin üzerindeki isim Zhang Wei değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_023",
      "speaker": "快递员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_024",
      "speaker": "邻居",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_027",
      "speaker": "快递员",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_028",
      "speaker": "邻居",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_029",
      "speaker": "张伟",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_031",
      "speaker": "快递员",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzi shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_032",
      "speaker": "邻居",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzi.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_033",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_035",
      "speaker": "快递员",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_036",
      "speaker": "邻居",
      "zh": "嗯，对，这是电话。",
      "pinyin": "Èn, duì, zhè shì diàn huà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_037",
      "speaker": "张伟",
      "zh": "电话呢？",
      "pinyin": "Diàn huà ne?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_038",
      "speaker": "刘梅",
      "zh": "电话在这儿。",
      "pinyin": "Diàn huà zài zhèr.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_039",
      "speaker": "快递员",
      "zh": "你的号码是什么？",
      "pinyin": "Nǐ de hàomǎ shì shénme?",
      "tr": "Numara nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_040",
      "speaker": "邻居",
      "zh": "这是我的号码。",
      "pinyin": "Zhè shì wǒ de hàomǎ.",
      "tr": "Bu benim numara."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_041",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_042",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_043",
      "speaker": "快递员",
      "zh": "他们把包裹送给邻居。",
      "pinyin": "Tāmen bǎ bāoguǒ sòng gěi línjū.",
      "tr": "Paketi komşuya veriyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_044",
      "speaker": "邻居",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bú kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_047",
      "speaker": "快递员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_048",
      "speaker": "邻居",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
