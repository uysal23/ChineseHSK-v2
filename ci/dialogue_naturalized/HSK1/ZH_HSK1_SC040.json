{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC040",
  "level": "HSK1",
  "sourceTitleZh": "邻居的包裹",
  "sourceTitleTr": "Komşunun Paketi",
  "sourceMiniAdventureTr": "Kurye komşunun paketini yanlışlıkla Zhang ailesine bırakır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC040_001",
      "speaker": "张伟",
      "zh": "快递送来了一个包裹。",
      "pinyin": "Kuài dì sòng lái le yī gè bāo guǒ.",
      "tr": "Kurye bir paket getirdi."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_003",
      "speaker": "快递员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_004",
      "speaker": "邻居",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_006",
      "speaker": "刘梅",
      "zh": "这是包裹吗？",
      "pinyin": "Zhè shì bāo guǒ ma?",
      "tr": "Bu, paket / kargo mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_007",
      "speaker": "快递员",
      "zh": "对，这是包裹。",
      "pinyin": "Duì, zhè shì bāo guǒ.",
      "tr": "Evet, bu paket / kargo."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_008",
      "speaker": "邻居",
      "zh": "包裹在哪儿？",
      "pinyin": "Bāo guǒ zài nǎ ér?",
      "tr": "Paket / kargo nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_009",
      "speaker": "张伟",
      "zh": "包裹在这里。",
      "pinyin": "Bāo guǒ zài zhè lǐ.",
      "tr": "Paket / kargo burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_010",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dì zhǐ shì shén me?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_011",
      "speaker": "快递员",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dì zhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_012",
      "speaker": "邻居",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_014",
      "speaker": "刘梅",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhè shì wǒ men de lín jū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_015",
      "speaker": "快递员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_016",
      "speaker": "邻居",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_017",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_018",
      "speaker": "刘梅",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_019",
      "speaker": "快递员",
      "zh": "对，这是门。",
      "pinyin": "Duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_020",
      "speaker": "邻居",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎ ér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_021",
      "speaker": "张伟",
      "zh": "门在这里。",
      "pinyin": "Mén zài zhè lǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_022",
      "speaker": "刘梅",
      "zh": "包裹上的名字不是张伟。",
      "pinyin": "Bāo guǒ shàng de míng zì bù shì zhāng wěi.",
      "tr": "Paketin üzerindeki isim Zhang Wei değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_023",
      "speaker": "快递员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_024",
      "speaker": "邻居",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_027",
      "speaker": "快递员",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_028",
      "speaker": "邻居",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_029",
      "speaker": "张伟",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_030",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_031",
      "speaker": "快递员",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míng zì shì shén me?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_032",
      "speaker": "邻居",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míng zì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_033",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_035",
      "speaker": "快递员",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diàn huà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_036",
      "speaker": "邻居",
      "zh": "对，这是电话。",
      "pinyin": "Duì, zhè shì diàn huà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_037",
      "speaker": "张伟",
      "zh": "电话在哪儿？",
      "pinyin": "Diàn huà zài nǎ ér?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_038",
      "speaker": "刘梅",
      "zh": "电话在这里。",
      "pinyin": "Diàn huà zài zhè lǐ.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_039",
      "speaker": "快递员",
      "zh": "你的号码是什么？",
      "pinyin": "Nǐ de hào mǎ shì shén me?",
      "tr": "Numara nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_040",
      "speaker": "邻居",
      "zh": "这是我的号码。",
      "pinyin": "Zhè shì wǒ de hào mǎ.",
      "tr": "Bu benim numara."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_041",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_042",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_043",
      "speaker": "快递员",
      "zh": "他们把包裹送给邻居。",
      "pinyin": "Tā men bǎ bāo guǒ sòng gěi lín jū.",
      "tr": "Paketi komşuya veriyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_044",
      "speaker": "邻居",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_047",
      "speaker": "快递员",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_048",
      "speaker": "邻居",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
    },
    {
