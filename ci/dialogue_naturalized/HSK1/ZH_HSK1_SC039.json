{
  "naturalizationVersion": 6,
  "sceneId": "ZH_HSK1_SC039",
  "level": "HSK1",
  "sourceTitleZh": "突然下雨了",
  "sourceTitleTr": "Yağmur Başlıyor",
  "sourceMiniAdventureTr": "Park dönüşünde yağmur başlar ve şemsiyelerin evde kaldığını fark ederler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC039_001",
      "speaker": "张伟",
      "zh": "大家从公园回家。",
      "pinyin": "Dàjiā cóng gōngyuán huí jiā.",
      "tr": "Herkes parktan eve dönüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_003",
      "speaker": "张乐乐",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_006",
      "speaker": "刘梅",
      "zh": "这个是雨吗？",
      "pinyin": "Zhè ge shì yǔ ma?",
      "tr": "Bu, yağmur mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_007",
      "speaker": "张乐乐",
      "zh": "对，就是雨。",
      "pinyin": "Duì, jiù shì yǔ.",
      "tr": "Evet, bu yağmur."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_008",
      "speaker": "张雨桐",
      "zh": "雨在哪儿？",
      "pinyin": "Yǔ zài nǎr?",
      "tr": "Yağmur nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_009",
      "speaker": "张伟",
      "zh": "雨在这儿。",
      "pinyin": "Yǔ zài zhèr.",
      "tr": "Yağmur burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_010",
      "speaker": "刘梅",
      "zh": "这个是雨伞吗？",
      "pinyin": "Zhè ge shì yǔ sǎn ma?",
      "tr": "Bu, şemsiye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_011",
      "speaker": "张乐乐",
      "zh": "没错，是雨伞。",
      "pinyin": "Méi cuò, shì yǔ sǎn.",
      "tr": "Evet, bu şemsiye."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_012",
      "speaker": "张雨桐",
      "zh": "雨伞在哪儿？",
      "pinyin": "Yǔsǎn zài nǎr?",
      "tr": "Şemsiye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_013",
      "speaker": "张伟",
      "zh": "你看，雨伞在这儿。",
      "pinyin": "Nǐ kàn, yǔ sǎn zài zhèr.",
      "tr": "Şemsiye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_014",
      "speaker": "刘梅",
      "zh": "这是天气吗？",
      "pinyin": "Zhè shì tiānqì ma?",
      "tr": "Bu, hava mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_015",
      "speaker": "张乐乐",
      "zh": "对，就是天气。",
      "pinyin": "Duì, jiù shì tiān qì.",
      "tr": "Evet, bu hava."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_016",
      "speaker": "张雨桐",
      "zh": "那天气在哪儿？",
      "pinyin": "Nà tiān qì zài nǎr?",
      "tr": "Hava nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_017",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Hava burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_018",
      "speaker": "刘梅",
      "zh": "这是外套吗？",
      "pinyin": "Zhè shì wàitào ma?",
      "tr": "Bu, mont mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_019",
      "speaker": "张乐乐",
      "zh": "对，就是外套。",
      "pinyin": "Duì, jiù shì wài tào.",
      "tr": "Evet, bu mont."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_020",
      "speaker": "张雨桐",
      "zh": "外套呢？",
      "pinyin": "Wài tào ne?",
      "tr": "Mont nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_021",
      "speaker": "张伟",
      "zh": "你看，外套在这儿。",
      "pinyin": "Nǐ kàn, wài tào zài zhèr.",
      "tr": "Mont burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_022",
      "speaker": "刘梅",
      "zh": "突然下雨了，可是没有雨伞。",
      "pinyin": "Tūrán xiàyǔ le, kěshì méiyǒu yǔsǎn.",
      "tr": "Birden yağmur başladı ama şemsiye yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_023",
      "speaker": "张乐乐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_027",
      "speaker": "张乐乐",
      "zh": "路呢？",
      "pinyin": "Lù ne?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_028",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_029",
      "speaker": "张伟",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_031",
      "speaker": "张乐乐",
      "zh": "那家在哪儿？",
      "pinyin": "Nà jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_032",
      "speaker": "张雨桐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_033",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_034",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_035",
      "speaker": "张乐乐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_036",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_037",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_038",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_039",
      "speaker": "张乐乐",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_040",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_042",
      "speaker": "刘梅",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_043",
      "speaker": "张乐乐",
      "zh": "大家快走回家。",
      "pinyin": "Dàjiā kuài zǒu huí jiā.",
      "tr": "Herkes hızlıca eve yürüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_044",
      "speaker": "张雨桐",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC039_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_047",
      "speaker": "张乐乐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC039_048",
      "speaker": "张雨桐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
