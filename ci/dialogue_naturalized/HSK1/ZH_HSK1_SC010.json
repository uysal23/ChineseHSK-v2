{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC010",
  "level": "HSK1",
  "sourceTitleZh": "新家的门",
  "sourceTitleTr": "Yeni Evin Kapısı",
  "sourceMiniAdventureTr": "Anahtar ilk denemede kapıyı açmaz; doğru anahtarı bulurlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC010_001",
      "speaker": "张伟",
      "zh": "我们到了新家。",
      "pinyin": "Wǒmen dào le xīn jiā.",
      "tr": "Yeni eve geldik."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_003",
      "speaker": "张乐乐",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_004",
      "speaker": "张雨桐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_006",
      "speaker": "刘梅",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_007",
      "speaker": "张乐乐",
      "zh": "没错，是门。",
      "pinyin": "Méicuò, shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_008",
      "speaker": "张雨桐",
      "zh": "那门放在哪儿？",
      "pinyin": "Nà mén fàngzài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_009",
      "speaker": "张伟",
      "zh": "你看，门在这儿。",
      "pinyin": "Nǐ kàn, mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_010",
      "speaker": "刘梅",
      "zh": "这是钥匙吗？",
      "pinyin": "Zhè shì yàoshi ma?",
      "tr": "Bu, anahtar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_011",
      "speaker": "张乐乐",
      "zh": "没错，是钥匙。",
      "pinyin": "Méicuò, shì yàoshi.",
      "tr": "Evet, bu anahtar."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_012",
      "speaker": "张雨桐",
      "zh": "那钥匙在哪儿？",
      "pinyin": "Nà yàoshi zài nǎér?",
      "tr": "Anahtar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_013",
      "speaker": "张伟",
      "zh": "你看，钥匙在这儿。",
      "pinyin": "Nǐ kàn, yàoshi zài zhèér.",
      "tr": "Anahtar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_014",
      "speaker": "刘梅",
      "zh": "那家在哪儿？",
      "pinyin": "Nà jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_015",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_016",
      "speaker": "张雨桐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_018",
      "speaker": "刘梅",
      "zh": "房间在哪儿？",
      "pinyin": "Fángjiān zài nǎr?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_019",
      "speaker": "张乐乐",
      "zh": "房间在那边。",
      "pinyin": "Fángjiān zài nàbian.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_020",
      "speaker": "张雨桐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_021",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_022",
      "speaker": "刘梅",
      "zh": "这个钥匙打不开门。",
      "pinyin": "Zhège yàoshi dǎbukāi mén.",
      "tr": "Bu anahtar kapıyı açmıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_023",
      "speaker": "张乐乐",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_024",
      "speaker": "张雨桐",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_027",
      "speaker": "张乐乐",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubian ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_028",
      "speaker": "张雨桐",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubian.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_029",
      "speaker": "张伟",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_031",
      "speaker": "张乐乐",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbian ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_032",
      "speaker": "张雨桐",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbian.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_033",
      "speaker": "张伟",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_034",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_035",
      "speaker": "张乐乐",
      "zh": "这是箱子吗？",
      "pinyin": "Zhè shì xiāngzi ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_036",
      "speaker": "张雨桐",
      "zh": "没错，是箱子。",
      "pinyin": "Méicuò, shì xiāngzi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_037",
      "speaker": "张伟",
      "zh": "箱子呢？放哪儿了？",
      "pinyin": "Xiāngzi ne? fàng nǎér le?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_038",
      "speaker": "刘梅",
      "zh": "箱子在这儿。",
      "pinyin": "Xiāngzi zài zhèér.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_039",
      "speaker": "张乐乐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_040",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_042",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_043",
      "speaker": "张乐乐",
      "zh": "对的钥匙找到了。",
      "pinyin": "Duì de yàoshi zhǎodào le.",
      "tr": "Doğru anahtarı bulduk."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_044",
      "speaker": "张雨桐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_047",
      "speaker": "张乐乐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_048",
      "speaker": "张雨桐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC010_049",
      "speaker": "张伟",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC010_050",
