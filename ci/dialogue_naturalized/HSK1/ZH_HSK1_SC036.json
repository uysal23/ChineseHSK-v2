{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC036",
  "level": "HSK1",
  "sourceTitleZh": "孩子们一起玩",
  "sourceTitleTr": "Çocuklar Birlikte Oynuyor",
  "sourceMiniAdventureTr": "Çocuklar aynı oyuncakla oynamak ister ve küçük bir paylaşma sorunu çıkar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC036_001",
      "speaker": "张乐乐",
      "zh": "孩子们一起玩。",
      "pinyin": "Háizimen yìqǐ wán.",
      "tr": "Çocuklar birlikte oynuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_002",
      "speaker": "小朋友",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_003",
      "speaker": "张雨桐",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_004",
      "speaker": "刘梅",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_005",
      "speaker": "张乐乐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_006",
      "speaker": "小朋友",
      "zh": "这是玩具吗？",
      "pinyin": "Zhè shì wánjù ma?",
      "tr": "Bu, oyuncak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_007",
      "speaker": "张雨桐",
      "zh": "对，就是玩具。",
      "pinyin": "Duì, jiùshì wánjù.",
      "tr": "Evet, bu oyuncak."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_008",
      "speaker": "刘梅",
      "zh": "玩具在哪儿？",
      "pinyin": "Wánjù zài nǎr?",
      "tr": "Oyuncak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_009",
      "speaker": "张乐乐",
      "zh": "你看，玩具在这儿。",
      "pinyin": "Nǐ kàn, wánjù zài zhèér.",
      "tr": "Oyuncak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_010",
      "speaker": "小朋友",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_011",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_012",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_013",
      "speaker": "张乐乐",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_014",
      "speaker": "小朋友",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_015",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_016",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_017",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_018",
      "speaker": "小朋友",
      "zh": "这是球吗？",
      "pinyin": "Zhè shì qiú ma?",
      "tr": "Bu, top mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_019",
      "speaker": "张雨桐",
      "zh": "没错，是球。",
      "pinyin": "Méicuò, shì qiú.",
      "tr": "Evet, bu top."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_020",
      "speaker": "刘梅",
      "zh": "球呢？",
      "pinyin": "Qiú ne?",
      "tr": "Top nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_021",
      "speaker": "张乐乐",
      "zh": "你看，球在这儿。",
      "pinyin": "Nǐ kàn, qiú zài zhèér.",
      "tr": "Top burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_022",
      "speaker": "小朋友",
      "zh": "两个孩子都想要同一个玩具。",
      "pinyin": "Liǎng ge háizi dōu xiǎng yào tóng yí ge wánjù.",
      "tr": "İki çocuk da aynı oyuncağı istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_024",
      "speaker": "刘梅",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_025",
      "speaker": "张乐乐",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_026",
      "speaker": "小朋友",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_027",
      "speaker": "张雨桐",
      "zh": "那家在哪儿？",
      "pinyin": "Nà jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_028",
      "speaker": "刘梅",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_029",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_030",
      "speaker": "小朋友",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_031",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_032",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_033",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_034",
      "speaker": "小朋友",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_035",
      "speaker": "张雨桐",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_036",
      "speaker": "刘梅",
      "zh": "对，就是椅子。",
      "pinyin": "Duì, jiùshì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_037",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎr?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_038",
      "speaker": "小朋友",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_039",
      "speaker": "张雨桐",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_040",
      "speaker": "刘梅",
      "zh": "对，就是桌子。",
      "pinyin": "Duì, jiùshì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_041",
      "speaker": "张乐乐",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuōzi zài nǎr?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_042",
      "speaker": "小朋友",
      "zh": "桌子在这儿。",
      "pinyin": "Zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_043",
      "speaker": "张雨桐",
      "zh": "他们学会一起玩。",
      "pinyin": "Tāmen xuéhuì yìqǐ wán.",
      "tr": "Birlikte oynamayı öğreniyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_044",
      "speaker": "刘梅",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_045",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_046",
      "speaker": "小朋友",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_047",
      "speaker": "张雨桐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_048",
      "speaker": "刘梅",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
