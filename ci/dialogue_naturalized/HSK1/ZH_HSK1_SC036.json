{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC036",
  "level": "HSK1",
  "sourceTitleZh": "孩子们一起玩",
  "sourceTitleTr": "Çocuklar Birlikte Oynuyor",
  "sourceMiniAdventureTr": "Çocuklar aynı oyuncakla oynamak ister ve küçük bir paylaşma sorunu çıkar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC036_001",
      "speaker": "张乐乐",
      "zh": "孩子们一起玩。",
      "pinyin": "Hái zi men yī qǐ wán.",
      "tr": "Çocuklar birlikte oynuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_002",
      "speaker": "小朋友",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_004",
      "speaker": "刘梅",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_005",
      "speaker": "张乐乐",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_006",
      "speaker": "小朋友",
      "zh": "这是玩具吗？",
      "pinyin": "Zhè shì wán jù ma?",
      "tr": "Bu, oyuncak mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_007",
      "speaker": "张雨桐",
      "zh": "对，这是玩具。",
      "pinyin": "Duì, zhè shì wán jù.",
      "tr": "Evet, bu oyuncak."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_008",
      "speaker": "刘梅",
      "zh": "玩具在哪儿？",
      "pinyin": "Wán jù zài nǎ ér?",
      "tr": "Oyuncak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_009",
      "speaker": "张乐乐",
      "zh": "玩具在这里。",
      "pinyin": "Wán jù zài zhè lǐ.",
      "tr": "Oyuncak burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_010",
      "speaker": "小朋友",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒ men de hái zi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_011",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_012",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_013",
      "speaker": "张乐乐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_014",
      "speaker": "小朋友",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_015",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_016",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_017",
      "speaker": "张乐乐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_018",
      "speaker": "小朋友",
      "zh": "这是球吗？",
      "pinyin": "Zhè shì qiú ma?",
      "tr": "Bu, top mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_019",
      "speaker": "张雨桐",
      "zh": "对，这是球。",
      "pinyin": "Duì, zhè shì qiú.",
      "tr": "Evet, bu top."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_020",
      "speaker": "刘梅",
      "zh": "球在哪儿？",
      "pinyin": "Qiú zài nǎ ér?",
      "tr": "Top nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_021",
      "speaker": "张乐乐",
      "zh": "球在这里。",
      "pinyin": "Qiú zài zhè lǐ.",
      "tr": "Top burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_022",
      "speaker": "小朋友",
      "zh": "两个孩子都想要同一个玩具。",
      "pinyin": "Liǎng gè hái zi dōu xiǎng yào tóng yī gè wán jù.",
      "tr": "İki çocuk da aynı oyuncağı istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_024",
      "speaker": "刘梅",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_025",
      "speaker": "张乐乐",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_026",
      "speaker": "小朋友",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_027",
      "speaker": "张雨桐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_028",
      "speaker": "刘梅",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_029",
      "speaker": "张乐乐",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_030",
      "speaker": "小朋友",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_031",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_032",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_033",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_034",
      "speaker": "小朋友",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_035",
      "speaker": "张雨桐",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐ zi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_036",
      "speaker": "刘梅",
      "zh": "对，这是椅子。",
      "pinyin": "Duì, zhè shì yǐ zi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_037",
      "speaker": "张乐乐",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐ zi zài nǎ ér?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_038",
      "speaker": "小朋友",
      "zh": "椅子在这里。",
      "pinyin": "Yǐ zi zài zhè lǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_039",
      "speaker": "张雨桐",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuō zi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_040",
      "speaker": "刘梅",
      "zh": "对，这是桌子。",
      "pinyin": "Duì, zhè shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_041",
      "speaker": "张乐乐",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuō zi zài nǎ ér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_042",
      "speaker": "小朋友",
      "zh": "桌子在这里。",
      "pinyin": "Zhuō zi zài zhè lǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_043",
      "speaker": "张雨桐",
      "zh": "他们学会一起玩。",
      "pinyin": "Tā men xué huì yī qǐ wán.",
      "tr": "Birlikte oynamayı öğreniyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_044",
      "speaker": "刘梅",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_045",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_046",
      "speaker": "小朋友",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_047",
      "speaker": "张雨桐",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
