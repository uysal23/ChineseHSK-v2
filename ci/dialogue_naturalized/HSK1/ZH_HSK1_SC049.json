{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC049",
  "level": "HSK1",
  "sourceTitleZh": "来新城三个月了",
  "sourceTitleTr": "Kasabada Üç Ay",
  "sourceMiniAdventureTr": "Aile eski yaşamla yeni kasabadaki ilk üç ayı basit şekilde karşılaştırır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC049_001",
      "speaker": "张伟",
      "zh": "我们来新城三个月了。",
      "pinyin": "Wǒmen lái Xīnchéng sān ge yuè le.",
      "tr": "Yeni kasabaya geleli üç ay oldu."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_003",
      "speaker": "张雨桐",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_006",
      "speaker": "刘梅",
      "zh": "三个月了。",
      "pinyin": "Sān ge yuè le.",
      "tr": "Üç ay oldu."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_007",
      "speaker": "张雨桐",
      "zh": "时间真快。",
      "pinyin": "Shíjiān zhēn kuài.",
      "tr": "Zaman gerçekten hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_008",
      "speaker": "张乐乐",
      "zh": "是啊。",
      "pinyin": "Shì a.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_009",
      "speaker": "张伟",
      "zh": "我们很喜欢这里。",
      "pinyin": "Wǒmen hěn xǐhuan zhèlǐ.",
      "tr": "Burayı çok seviyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_010",
      "speaker": "刘梅",
      "zh": "那新城在哪儿？",
      "pinyin": "Nà xīnchéng zài nǎér?",
      "tr": "Yeni şehir / kasaba nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_011",
      "speaker": "张雨桐",
      "zh": "你看，新城在那边。",
      "pinyin": "Nǐ kàn, xīnchéng zài nàbiān.",
      "tr": "Yeni şehir / kasaba şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_012",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_013",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_014",
      "speaker": "刘梅",
      "zh": "这是旧的吗？",
      "pinyin": "Zhè shì jiù de ma?",
      "tr": "Bu, eski mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_015",
      "speaker": "张雨桐",
      "zh": "对，就是旧的。",
      "pinyin": "Duì, jiùshì jiù de.",
      "tr": "Evet, bu eski."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_016",
      "speaker": "张乐乐",
      "zh": "旧的在哪儿？",
      "pinyin": "Jiù de zài nǎr?",
      "tr": "Eski nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_017",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Eski burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_018",
      "speaker": "刘梅",
      "zh": "这是新的吗？",
      "pinyin": "Zhè shì xīn de ma?",
      "tr": "Bu, yeni mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_019",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是新的。",
      "pinyin": "Èn, duì, zhè shì xīn de.",
      "tr": "Evet, bu yeni."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_020",
      "speaker": "张乐乐",
      "zh": "那新的在哪儿？",
      "pinyin": "Nà xīn de zài nǎér?",
      "tr": "Yeni nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_021",
      "speaker": "张伟",
      "zh": "你看，新的在这儿。",
      "pinyin": "Nǐ kàn, xīn de zài zhèér.",
      "tr": "Yeni burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_022",
      "speaker": "刘梅",
      "zh": "大家想起以前的生活。",
      "pinyin": "Dàjiā xiǎngqǐ yǐqián de shēnghuó.",
      "tr": "Herkes eski yaşamını hatırlıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_023",
      "speaker": "张雨桐",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_027",
      "speaker": "张雨桐",
      "zh": "那家在哪儿？",
      "pinyin": "Nà jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_028",
      "speaker": "张乐乐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_029",
      "speaker": "张伟",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_031",
      "speaker": "张雨桐",
      "zh": "学校在哪儿？",
      "pinyin": "Xuéxiào zài nǎr?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_032",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_033",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_034",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_035",
      "speaker": "张雨桐",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_036",
      "speaker": "张乐乐",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_037",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_038",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_039",
      "speaker": "张雨桐",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_042",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_043",
      "speaker": "张雨桐",
      "zh": "我们越来越喜欢这里。",
      "pinyin": "Wǒmen yuèláiyuè xǐhuan zhèlǐ.",
      "tr": "Burayı gittikçe daha çok seviyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC049_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_047",
      "speaker": "张雨桐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_049",
      "speaker": "张伟",
      "zh": "三个月了。",
      "pinyin": "Sān ge yuè le.",
      "tr": "Üç ay oldu."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_050",
      "speaker": "刘梅",
      "zh": "时间真快。",
      "pinyin": "Shíjiān zhēn kuài.",
      "tr": "Zaman gerçekten hızlı geçiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_051",
      "speaker": "张雨桐",
      "zh": "是啊。",
      "pinyin": "Shì a.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC049_052",
      "speaker": "张乐乐",
      "zh": "我们很喜欢这里。",
