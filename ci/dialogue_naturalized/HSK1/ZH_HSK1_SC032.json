{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK1_SC032",
  "level": "HSK1",
  "sourceTitleZh": "新同事",
  "sourceTitleTr": "Yeni İş Arkadaşları",
  "sourceMiniAdventureTr": "Öğle arasında iş arkadaşları kendilerini tanıtır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC032_001",
      "speaker": "张伟",
      "zh": "张伟认识新同事。",
      "pinyin": "Zhāng Wěi rènshi xīn tóngshì.",
      "tr": "Zhang Wei yeni iş arkadaşlarıyla tanışıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_003",
      "speaker": "同事",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_004",
      "speaker": "经理",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_006",
      "speaker": "同事",
      "zh": "这是我们的同事。",
      "pinyin": "Zhè shì wǒmen de tóngshì.",
      "tr": "Bu bizim iş arkadaşı."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_007",
      "speaker": "同事",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_008",
      "speaker": "经理",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_009",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_010",
      "speaker": "同事",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_011",
      "speaker": "同事",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_012",
      "speaker": "经理",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_013",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_014",
      "speaker": "同事",
      "zh": "那办公室在哪儿？",
      "pinyin": "Nà bàn gōng shì zài nǎr?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_015",
      "speaker": "同事",
      "zh": "办公室在那边。",
      "pinyin": "Bàngōngshì zài nàbian.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_016",
      "speaker": "经理",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_017",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_018",
      "speaker": "同事",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzi shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_019",
      "speaker": "同事",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzi.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_020",
      "speaker": "经理",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_022",
      "speaker": "同事",
      "zh": "大家都想知道他从哪儿来。",
      "pinyin": "Dàjiā dōu xiǎng zhīdào tā cóng nǎr lái.",
      "tr": "Herkes nereden geldiğini merak ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_023",
      "speaker": "同事",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_024",
      "speaker": "经理",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_026",
      "speaker": "同事",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_027",
      "speaker": "同事",
      "zh": "城市呢？",
      "pinyin": "Chéng shì ne?",
      "tr": "Şehir nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_028",
      "speaker": "经理",
      "zh": "城市在那边。",
      "pinyin": "Chéngshì zài nàbian.",
      "tr": "Şehir şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_029",
      "speaker": "张伟",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_030",
      "speaker": "同事",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_031",
      "speaker": "同事",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_032",
      "speaker": "经理",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_034",
      "speaker": "同事",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_035",
      "speaker": "同事",
      "zh": "你要午饭吗？",
      "pinyin": "Nǐ yào wǔfàn ma?",
      "tr": "Öğle yemeği ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_036",
      "speaker": "经理",
      "zh": "我要午饭，谢谢。",
      "pinyin": "Wǒ yào wǔfàn, xièxie.",
      "tr": "Öğle yemeği istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_037",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_038",
      "speaker": "同事",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_039",
      "speaker": "同事",
      "zh": "这是电脑，对吗？",
      "pinyin": "Zhè shì diàn nǎo, duì ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_040",
      "speaker": "经理",
      "zh": "没错，是电脑。",
      "pinyin": "Méi cuò, shì diàn nǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_041",
      "speaker": "张伟",
      "zh": "那电脑在哪儿？",
      "pinyin": "Nà diàn nǎo zài nǎr?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_042",
      "speaker": "同事",
      "zh": "电脑在这儿。",
      "pinyin": "Diàn nǎo zài zhèr.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_043",
      "speaker": "同事",
      "zh": "他们很快开始聊天。",
      "pinyin": "Tāmen hěn kuài kāishǐ liáotiān.",
      "tr": "Kısa sürede sohbet etmeye başlıyorlar."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_044",
      "speaker": "经理",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC032_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_046",
      "speaker": "同事",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_047",
      "speaker": "同事",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_048",
      "speaker": "经理",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC032_049",
