{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC035",
  "level": "HSK1",
  "sourceTitleZh": "李晨一家来做客",
  "sourceTitleTr": "Li Chen’in Ailesi Geliyor",
  "sourceMiniAdventureTr": "İki aile ilk kez evde birlikte yemek yer ve yakınlaşır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC035_001",
      "speaker": "张伟",
      "zh": "李晨一家来做客。",
      "pinyin": "Lǐ chén yī jiā lái zuò kè.",
      "tr": "Li Chen’in ailesi misafirliğe geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_003",
      "speaker": "李晨",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_004",
      "speaker": "李晨妻子",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_006",
      "speaker": "刘梅",
      "zh": "这是我们的客人。",
      "pinyin": "Zhè shì wǒ men de kè rén.",
      "tr": "Bu bizim misafir."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_007",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_008",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_009",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_011",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_012",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_013",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_015",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_016",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_017",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_018",
      "speaker": "刘梅",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_019",
      "speaker": "李晨",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xiè xiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_020",
      "speaker": "李晨妻子",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_022",
      "speaker": "刘梅",
      "zh": "孩子们开始还有一点害羞。",
      "pinyin": "Hái zi men kāi shǐ hái yǒu yī diǎn hài xiū.",
      "tr": "Çocuklar başta biraz çekingen."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_024",
      "speaker": "李晨妻子",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_027",
      "speaker": "李晨",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_028",
      "speaker": "李晨妻子",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒ yào chá, xiè xiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_029",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "Ń, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_030",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_031",
      "speaker": "李晨",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuō zi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_032",
      "speaker": "李晨妻子",
      "zh": "对，这是桌子。",
      "pinyin": "Duì, zhè shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_033",
      "speaker": "张伟",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuō zi zài nǎ ér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_034",
      "speaker": "刘梅",
      "zh": "桌子在这里。",
      "pinyin": "Zhuō zi zài zhè lǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_035",
      "speaker": "李晨",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_036",
      "speaker": "李晨妻子",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_037",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_038",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_039",
      "speaker": "李晨",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàn gāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_040",
      "speaker": "李晨妻子",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒ yào dàn gāo, xiè xiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_041",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_042",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_043",
      "speaker": "李晨",
      "zh": "两家人很快聊得很开心。",
      "pinyin": "Liǎng jiā rén hěn kuài liáo dé hěn kāi xīn.",
      "tr": "İki aile kısa sürede keyifle sohbet ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_044",
      "speaker": "李晨妻子",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC035_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_047",
      "speaker": "李晨",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_048",
      "speaker": "李晨妻子",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC035_049",
      "speaker": "张伟",
      "zh": "这是我们的客人。",
      "pinyin": "Zhè shì wǒ men de kè rén.",
      "tr": "Bu bizim misafir."
