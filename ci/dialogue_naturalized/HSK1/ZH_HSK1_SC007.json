{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC007",
  "level": "HSK1",
  "sourceTitleZh": "车站的小麻烦",
  "sourceTitleTr": "İstasyonda Karışıklık",
  "sourceMiniAdventureTr": "Nakliye firmasından kimse görünmez; aile telefonla ne yapacağını anlamaya çalışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC007_001",
      "speaker": "张伟",
      "zh": "我们到新车站了。",
      "pinyin": "Wǒmen dào xīn chēzhàn le.",
      "tr": "Yeni istasyona geldik."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_003",
      "speaker": "工作人员",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_006",
      "speaker": "刘梅",
      "zh": "那车站在哪儿？",
      "pinyin": "Nà chēzhàn zài nǎér?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_007",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_008",
      "speaker": "张乐乐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_009",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_010",
      "speaker": "刘梅",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_011",
      "speaker": "工作人员",
      "zh": "嗯，对，这是电话。",
      "pinyin": "Èn, duì, zhè shì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_012",
      "speaker": "张乐乐",
      "zh": "电话在哪儿？",
      "pinyin": "Diànhuà zài nǎr?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_013",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_014",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dìzhǐ shì shénme?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_015",
      "speaker": "工作人员",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_016",
      "speaker": "张乐乐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_018",
      "speaker": "刘梅",
      "zh": "这是时间吗？",
      "pinyin": "Zhè shì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_019",
      "speaker": "工作人员",
      "zh": "对，就是时间。",
      "pinyin": "Duì, jiùshì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_020",
      "speaker": "张乐乐",
      "zh": "那时间在哪儿？",
      "pinyin": "Nà shíjiān zài nǎér?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_021",
      "speaker": "张伟",
      "zh": "你看，时间在这儿。",
      "pinyin": "Nǐ kàn, shíjiān zài zhèér.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_022",
      "speaker": "刘梅",
      "zh": "搬家公司的人还没来。",
      "pinyin": "Bānjiā gōngsī de rén hái méi lái.",
      "tr": "Nakliye şirketinden kimse henüz gelmedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_024",
      "speaker": "张乐乐",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_027",
      "speaker": "工作人员",
      "zh": "我们坐车吗？",
      "pinyin": "Wǒmen zuò chē ma?",
      "tr": "Araç ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_028",
      "speaker": "张乐乐",
      "zh": "对，我们坐车。",
      "pinyin": "Duì, wǒmen zuò chē.",
      "tr": "Evet, araç ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_029",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_030",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_031",
      "speaker": "工作人员",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuò huǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_032",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuò huǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_033",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_034",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_035",
      "speaker": "工作人员",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_037",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_038",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_039",
      "speaker": "工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_040",
      "speaker": "张乐乐",
      "zh": "有点儿。",
      "pinyin": "Yǒudiǎnér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_042",
      "speaker": "刘梅",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_043",
      "speaker": "工作人员",
      "zh": "我们先打电话等一下。",
      "pinyin": "Wǒmen xiān dǎ diànhuà děng yíxià.",
      "tr": "Önce telefon edip biraz bekleyelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_047",
      "speaker": "工作人员",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_049",
