{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC007",
  "level": "HSK1",
  "sourceTitleZh": "车站的小麻烦",
  "sourceTitleTr": "İstasyonda Karışıklık",
  "sourceMiniAdventureTr": "Nakliye firmasından kimse görünmez; aile telefonla ne yapacağını anlamaya çalışır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC007_001",
      "speaker": "张伟",
      "zh": "我们到新车站了。",
      "pinyin": "Wǒ men dào xīn chē zhàn le.",
      "tr": "Yeni istasyona geldik."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_003",
      "speaker": "工作人员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_006",
      "speaker": "刘梅",
      "zh": "车站在哪儿？",
      "pinyin": "Chē zhàn zài nǎ ér?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_007",
      "speaker": "工作人员",
      "zh": "车站在那边。",
      "pinyin": "Chē zhàn zài nà biān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_008",
      "speaker": "张乐乐",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_009",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_010",
      "speaker": "刘梅",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diàn huà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_011",
      "speaker": "工作人员",
      "zh": "对，这是电话。",
      "pinyin": "Duì, zhè shì diàn huà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_012",
      "speaker": "张乐乐",
      "zh": "电话在哪儿？",
      "pinyin": "Diàn huà zài nǎ ér?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_013",
      "speaker": "张伟",
      "zh": "电话在这里。",
      "pinyin": "Diàn huà zài zhè lǐ.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_014",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dì zhǐ shì shén me?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_015",
      "speaker": "工作人员",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dì zhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_016",
      "speaker": "张乐乐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_018",
      "speaker": "刘梅",
      "zh": "这是时间吗？",
      "pinyin": "Zhè shì shí jiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_019",
      "speaker": "工作人员",
      "zh": "对，这是时间。",
      "pinyin": "Duì, zhè shì shí jiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_020",
      "speaker": "张乐乐",
      "zh": "时间在哪儿？",
      "pinyin": "Shí jiān zài nǎ ér?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_021",
      "speaker": "张伟",
      "zh": "时间在这里。",
      "pinyin": "Shí jiān zài zhè lǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_022",
      "speaker": "刘梅",
      "zh": "搬家公司的人还没来。",
      "pinyin": "Bān jiā gōng sī de rén hái méi lái.",
      "tr": "Nakliye şirketinden kimse henüz gelmedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_027",
      "speaker": "工作人员",
      "zh": "我们坐车吗？",
      "pinyin": "Wǒ men zuò chē ma?",
      "tr": "Araç ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_028",
      "speaker": "张乐乐",
      "zh": "对，我们坐车。",
      "pinyin": "Duì, wǒ men zuò chē.",
      "tr": "Evet, araç ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_029",
      "speaker": "张伟",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_030",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_031",
      "speaker": "工作人员",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒ men zuò huǒ chē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_032",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒ men zuò huǒ chē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_033",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_034",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_035",
      "speaker": "工作人员",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒ men de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_037",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_038",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_039",
      "speaker": "工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_040",
      "speaker": "张乐乐",
      "zh": "嗯，有一点。",
      "pinyin": "Ń, yǒu yī diǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_041",
      "speaker": "张伟",
      "zh": "没事。",
      "pinyin": "Méi shì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_042",
      "speaker": "刘梅",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_043",
      "speaker": "工作人员",
      "zh": "我们先打电话等一下。",
      "pinyin": "Wǒ men xiān dǎ diàn huà děng yī xià.",
      "tr": "Önce telefon edip biraz bekleyelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_047",
      "speaker": "工作人员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_048",
      "speaker": "张乐乐",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
    },
