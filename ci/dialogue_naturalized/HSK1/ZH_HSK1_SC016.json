{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC016",
  "level": "HSK1",
  "sourceTitleZh": "超市在哪儿？",
  "sourceTitleTr": "Market Nerede?",
  "sourceMiniAdventureTr": "Aile mahalledeki marketi bulmak için komşuya yol sorar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC016_001",
      "speaker": "张伟",
      "zh": "我们要去超市。",
      "pinyin": "Wǒ men yào qù chāo shì.",
      "tr": "Süpermarkete gideceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_003",
      "speaker": "邻居",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_006",
      "speaker": "刘梅",
      "zh": "超市在哪儿？",
      "pinyin": "Chāo shì zài nǎ ér?",
      "tr": "Süpermarket nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_007",
      "speaker": "邻居",
      "zh": "超市在那边。",
      "pinyin": "Chāo shì zài nà biān.",
      "tr": "Süpermarket şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_008",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_009",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_010",
      "speaker": "刘梅",
      "zh": "路在哪儿？",
      "pinyin": "Lù zài nǎ ér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_011",
      "speaker": "邻居",
      "zh": "路在那边。",
      "pinyin": "Lù zài nà biān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_012",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_013",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_014",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒ biān ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_015",
      "speaker": "邻居",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒ biān.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_016",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhè biān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_018",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòu biān ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_019",
      "speaker": "邻居",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòu biān.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_020",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhè biān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_021",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_022",
      "speaker": "刘梅",
      "zh": "我们不知道超市在哪儿。",
      "pinyin": "Wǒ men bù zhī dào chāo shì zài nǎ ér.",
      "tr": "Süpermarketin nerede olduğunu bilmiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_023",
      "speaker": "邻居",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_027",
      "speaker": "邻居",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_028",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_029",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_030",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_031",
      "speaker": "邻居",
      "zh": "商店在哪儿？",
      "pinyin": "Shāng diàn zài nǎ ér?",
      "tr": "Mağaza nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_032",
      "speaker": "张乐乐",
      "zh": "商店在那边。",
      "pinyin": "Shāng diàn zài nà biān.",
      "tr": "Mağaza şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_033",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_034",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_035",
      "speaker": "邻居",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhè shì wǒ men de lín jū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_037",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_038",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_039",
      "speaker": "邻居",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒ men de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_042",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_043",
      "speaker": "邻居",
      "zh": "邻居告诉我们怎么走。",
      "pinyin": "Lín jū gào sù wǒ men zěn me zǒu.",
      "tr": "Komşu bize nasıl gideceğimizi söylüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC016_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_047",
      "speaker": "邻居",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC016_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
