    {
      "id": "DLG_ZH_HSK1_SC001_045",
      "speaker": "王师傅",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_046",
      "speaker": "张伟",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
