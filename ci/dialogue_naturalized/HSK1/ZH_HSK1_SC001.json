    {
      "id": "DLG_ZH_HSK1_SC001_043",
      "speaker": "张雨桐",
      "zh": "好了，箱子都对了。",
      "pinyin": "Hǎo le, xiāngzi dōu duì le.",
      "tr": "Tamam, kutular artık doğru yerde."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
