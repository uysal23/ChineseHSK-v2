{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK1_SC001",
  "level": "HSK1",
  "sourceTitleZh": "搬家的最后几个箱子",
  "sourceTitleTr": "Son Kutular",
  "sourceMiniAdventureTr": "Nakliye ekibi erken gelir; kutular karışır ve aile son eşyaları düzenler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC001_001",
      "speaker": "张伟",
      "zh": "我们今天搬家。",
      "pinyin": "Wǒmen jīntiān bānjiā.",
      "tr": "Bugün taşınıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_005",
      "speaker": "王师傅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_006",
      "speaker": "张伟",
      "zh": "这是箱子，对吗？",
      "pinyin": "Zhè shì xiāng zi, duì ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_007",
      "speaker": "刘梅",
      "zh": "对，就是箱子。",
      "pinyin": "Duì, jiù shì xiāng zi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_008",
      "speaker": "张雨桐",
      "zh": "箱子在哪儿？",
      "pinyin": "Xiāngzi zài nǎr?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_009",
      "speaker": "张乐乐",
      "zh": "箱子在这儿。",
      "pinyin": "Xiāng zi zài zhèr.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_010",
      "speaker": "王师傅",
      "zh": "今天搬家吗？",
      "pinyin": "Jīntiān bānjiā ma?",
      "tr": "Bugün taşınıyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_011",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_012",
      "speaker": "刘梅",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_013",
      "speaker": "张雨桐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_014",
      "speaker": "张乐乐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_015",
      "speaker": "王师傅",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_016",
      "speaker": "张伟",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_017",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_018",
      "speaker": "张雨桐",
      "zh": "那房间在哪儿？",
      "pinyin": "Nà fáng jiān zài nǎr?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_019",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_020",
      "speaker": "王师傅",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_022",
      "speaker": "刘梅",
      "zh": "这个箱子放错了。",
      "pinyin": "Zhège xiāngzi fàng cuò le.",
      "tr": "Bu kutu yanlış yere konmuş."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_025",
      "speaker": "王师傅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_026",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_027",
      "speaker": "刘梅",
      "zh": "那厨房在哪儿？",
      "pinyin": "Nà chú fáng zài nǎr?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_028",
      "speaker": "张雨桐",
      "zh": "厨房在那边。",
      "pinyin": "Chúfáng zài nàbian.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_029",
      "speaker": "张乐乐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_030",
      "speaker": "王师傅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_031",
      "speaker": "张伟",
      "zh": "这是猫，对吗？",
      "pinyin": "Zhè shì māo, duì ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_032",
      "speaker": "刘梅",
      "zh": "没错，是猫。",
      "pinyin": "Méi cuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_033",
      "speaker": "张雨桐",
      "zh": "那猫在哪儿？",
      "pinyin": "Nà māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_034",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_035",
      "speaker": "王师傅",
      "zh": "这个是书吗？",
      "pinyin": "Zhè ge shì shū ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_036",
      "speaker": "张伟",
      "zh": "对，就是书。",
      "pinyin": "Duì, jiù shì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_037",
      "speaker": "刘梅",
      "zh": "那书在哪儿？",
      "pinyin": "Nà shū zài nǎr?",
      "tr": "Kitap nerede?"
