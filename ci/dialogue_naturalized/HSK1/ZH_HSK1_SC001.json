{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC001",
  "level": "HSK1",
  "sourceTitleZh": "搬家的最后几个箱子",
  "sourceTitleTr": "Son Kutular",
  "sourceMiniAdventureTr": "Nakliye ekibi erken gelir; kutular karışır ve aile son eşyaları düzenler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC001_001",
      "speaker": "张伟",
      "zh": "我们今天搬家。",
      "pinyin": "Wǒmen jīntiān bānjiā.",
      "tr": "Bugün taşınıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_005",
      "speaker": "王师傅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_006",
      "speaker": "张伟",
      "zh": "这是箱子吗？",
      "pinyin": "Zhè shì xiāngzi ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_007",
      "speaker": "刘梅",
      "zh": "嗯，对，这是箱子。",
      "pinyin": "Èn, duì, zhè shì xiāngzi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_008",
      "speaker": "张雨桐",
      "zh": "箱子呢？放哪儿了？",
      "pinyin": "Xiāngzi ne? fàng nǎér le?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_009",
      "speaker": "张乐乐",
      "zh": "箱子在这儿。",
      "pinyin": "Xiāngzi zài zhèér.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_010",
      "speaker": "王师傅",
      "zh": "今天搬家吗？",
      "pinyin": "Jīntiān bānjiā ma?",
      "tr": "Bugün taşınıyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_011",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_012",
      "speaker": "刘梅",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_013",
      "speaker": "张雨桐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_014",
      "speaker": "张乐乐",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_015",
      "speaker": "王师傅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_016",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_017",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_018",
      "speaker": "张雨桐",
      "zh": "房间呢？",
      "pinyin": "Fángjiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_019",
      "speaker": "张乐乐",
      "zh": "你看，房间在那边。",
      "pinyin": "Nǐ kàn, fángjiān zài nàbiān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_020",
      "speaker": "王师傅",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_022",
      "speaker": "刘梅",
      "zh": "这个箱子放错了。",
      "pinyin": "Zhège xiāngzi fàng cuò le.",
      "tr": "Bu kutu yanlış yere konmuş."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_023",
      "speaker": "张雨桐",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ láikàn kànba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_025",
      "speaker": "王师傅",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_026",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_027",
      "speaker": "刘梅",
      "zh": "厨房在哪儿？",
      "pinyin": "Chúfáng zài nǎr?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_028",
      "speaker": "张雨桐",
      "zh": "你看，厨房在那边。",
      "pinyin": "Nǐ kàn, chúfáng zài nàbiān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_029",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_030",
      "speaker": "王师傅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_031",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
