    {
      "id": "DLG_ZH_HSK1_SC001_039",
      "speaker": "张乐乐",
      "zh": "这是门，对吗？",
      "pinyin": "Zhè shì mén, duì ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_040",
      "speaker": "王师傅",
      "zh": "没错，是门。",
      "pinyin": "Méi cuò, shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_041",
      "speaker": "张伟",
      "zh": "门呢？",
      "pinyin": "Mén ne?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Kapı burada."
