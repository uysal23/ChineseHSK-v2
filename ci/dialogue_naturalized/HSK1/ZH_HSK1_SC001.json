  "level": "HSK1",
  "sourceTitleZh": "搬家的最后几个箱子",
  "sourceTitleTr": "Son Kutular",
  "sourceMiniAdventureTr": "Nakliye ekibi erken gelir; kutular karışır ve aile son eşyaları düzenler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC001_001",
      "speaker": "张伟",
      "zh": "我们今天搬家。",
      "pinyin": "Wǒ men jīn tiān bān jiā.",
      "tr": "Bugün taşınıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_005",
      "speaker": "王师傅",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_006",
      "speaker": "张伟",
      "zh": "这是箱子吗？",
      "pinyin": "Zhè shì xiāng zi ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_007",
      "speaker": "刘梅",
      "zh": "对，这是箱子。",
      "pinyin": "Duì, zhè shì xiāng zi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_008",
      "speaker": "张雨桐",
      "zh": "箱子在哪儿？",
      "pinyin": "Xiāng zi zài nǎ ér?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_009",
      "speaker": "张乐乐",
      "zh": "箱子在这里。",
      "pinyin": "Xiāng zi zài zhè lǐ.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_010",
      "speaker": "王师傅",
      "zh": "今天搬家吗？",
      "pinyin": "Jīn tiān bān jiā ma?",
      "tr": "Bugün taşınıyor musunuz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_011",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_012",
      "speaker": "刘梅",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_013",
      "speaker": "张雨桐",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_014",
      "speaker": "张乐乐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_015",
      "speaker": "王师傅",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_016",
      "speaker": "张伟",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_017",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_018",
      "speaker": "张雨桐",
      "zh": "房间在哪儿？",
      "pinyin": "Fáng jiān zài nǎ ér?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC001_019",
      "speaker": "张乐乐",
      "zh": "房间在那边。",
      "pinyin": "Fáng jiān zài nà biān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_020",
      "speaker": "王师傅",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_022",
      "speaker": "刘梅",
      "zh": "这个箱子放错了。",
      "pinyin": "Zhè gè xiāng zi fàng cuò le.",
      "tr": "Bu kutu yanlış yere konmuş."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_025",
      "speaker": "王师傅",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
