{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK1_SC030",
  "level": "HSK1",
  "sourceTitleZh": "好消息",
  "sourceTitleTr": "Güzel Haber",
  "sourceMiniAdventureTr": "Zhang işe kabul edilir; aile küçük bir kutlama yapar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC030_001",
      "speaker": "张伟",
      "zh": "公司打来了好消息。",
      "pinyin": "Gōngsī dǎ lái le hǎo xiāoxi.",
      "tr": "Şirketten güzel haber geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_003",
      "speaker": "张雨桐",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_006",
      "speaker": "刘梅",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_007",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_008",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_011",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_013",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_014",
      "speaker": "刘梅",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàngāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_015",
      "speaker": "张雨桐",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒ yào dàngāo, xièxie.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_016",
      "speaker": "张乐乐",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_018",
      "speaker": "刘梅",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎnshang yǒu shíjiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_019",
      "speaker": "张雨桐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_020",
      "speaker": "张乐乐",
      "zh": "晚上见。",
      "pinyin": "Wǎnshang jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_021",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_022",
      "speaker": "刘梅",
      "zh": "大家等着听结果。",
      "pinyin": "Dàjiā děngzhe tīng jiéguǒ.",
      "tr": "Herkes sonucu bekliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_027",
      "speaker": "张雨桐",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_028",
      "speaker": "张乐乐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_029",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_030",
      "speaker": "刘梅",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_031",
      "speaker": "张雨桐",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_032",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_034",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_035",
      "speaker": "张雨桐",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_036",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_037",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_038",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_039",
      "speaker": "张雨桐",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_040",
      "speaker": "张乐乐",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xièxie.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_041",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_042",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_043",
      "speaker": "张雨桐",
      "zh": "张伟找到工作了。",
      "pinyin": "Zhāng Wěi zhǎodào gōngzuò le.",
      "tr": "Zhang Wei iş buldu."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC030_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC030_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
