{
  "naturalizationVersion": 4,
  "sceneId": "ZH_HSK1_SC027",
  "level": "HSK1",
  "sourceTitleZh": "第一个工作电话",
  "sourceTitleTr": "İlk Telefon Görüşmesi",
  "sourceMiniAdventureTr": "Zhang bir iş yeriyle arama yapıp görüşme saati alır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC027_001",
      "speaker": "张伟",
      "zh": "张伟第一次给公司打电话。",
      "pinyin": "Zhāng Wěi dì yī cì gěi gōngsī dǎ diànhuà.",
      "tr": "Zhang Wei şirkete ilk kez telefon ediyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_002",
      "speaker": "公司职员",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_003",
      "speaker": "刘梅",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_006",
      "speaker": "公司职员",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_007",
      "speaker": "刘梅",
      "zh": "没错，是电话。",
      "pinyin": "Méi cuò, shì diàn huà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_008",
      "speaker": "张雨桐",
      "zh": "电话呢？",
      "pinyin": "Diàn huà ne?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_009",
      "speaker": "张伟",
      "zh": "你看，电话在这儿。",
      "pinyin": "Nǐ kàn, diàn huà zài zhèr.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_010",
      "speaker": "公司职员",
      "zh": "你的电话号码是什么？",
      "pinyin": "Nǐ de diànhuà hàomǎ shì shénme?",
      "tr": "Telefon numarası nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_011",
      "speaker": "刘梅",
      "zh": "这是我的电话号码。",
      "pinyin": "Zhè shì wǒ de diànhuà hàomǎ.",
      "tr": "Bu benim telefon numarası."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_012",
      "speaker": "张雨桐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_014",
      "speaker": "公司职员",
      "zh": "明天可以吗？",
      "pinyin": "Míngtiān kěyǐ ma?",
      "tr": "Yarın uygun mu?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_015",
      "speaker": "刘梅",
      "zh": "可以。",
      "pinyin": "Kěyǐ.",
      "tr": "Uygun."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_016",
      "speaker": "张雨桐",
      "zh": "几点？",
      "pinyin": "Jǐ diǎn?",
      "tr": "Saat kaçta?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_017",
      "speaker": "张伟",
      "zh": "明天见。",
      "pinyin": "Míngtiān jiàn.",
      "tr": "Yarın görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_018",
      "speaker": "公司职员",
      "zh": "这是时间吗？",
      "pinyin": "Zhè shì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_019",
      "speaker": "刘梅",
      "zh": "嗯，对，这是时间。",
      "pinyin": "Èn, duì, zhè shì shí jiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_020",
      "speaker": "张雨桐",
      "zh": "时间在哪儿？",
      "pinyin": "Shíjiān zài nǎr?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_021",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_022",
      "speaker": "公司职员",
      "zh": "他有一点紧张。",
      "pinyin": "Tā yǒu yìdiǎn jǐnzhāng.",
      "tr": "Biraz gergin."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_026",
      "speaker": "公司职员",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_027",
      "speaker": "刘梅",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_028",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_029",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_030",
      "speaker": "公司职员",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_031",
      "speaker": "刘梅",
      "zh": "今天有面试吗？",
      "pinyin": "Jīntiān yǒu miànshì ma?",
      "tr": "Bugün iş görüşmesi var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_032",
      "speaker": "张雨桐",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_033",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_034",
      "speaker": "公司职员",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_035",
      "speaker": "刘梅",
      "zh": "办公室呢？",
      "pinyin": "Bàn gōng shì ne?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_036",
      "speaker": "张雨桐",
      "zh": "你看，办公室在那边。",
      "pinyin": "Nǐ kàn, bàn gōng shì zài nà biān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_037",
      "speaker": "张伟",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_038",
      "speaker": "公司职员",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_039",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_040",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_042",
      "speaker": "公司职员",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_043",
      "speaker": "刘梅",
      "zh": "他约好了明天的面试。",
      "pinyin": "Tā yuē hǎo le míngtiān de miànshì.",
      "tr": "Yarınki iş görüşmesini ayarladı."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_044",
      "speaker": "张雨桐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC027_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_046",
      "speaker": "公司职员",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bú kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC027_047",
      "speaker": "刘梅",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
