    {
      "id": "DLG_ZH_HSK1_SC011_042",
      "speaker": "刘梅",
      "zh": "椅子在这里。",
      "pinyin": "Yǐ zi zài zhè lǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_043",
      "speaker": "张雨桐",
      "zh": "我们把箱子放回厨房。",
      "pinyin": "Wǒ men bǎ xiāng zi fàng huí chú fáng.",
      "tr": "Kutuyu yeniden mutfağa koyuyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_047",
      "speaker": "张雨桐",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
