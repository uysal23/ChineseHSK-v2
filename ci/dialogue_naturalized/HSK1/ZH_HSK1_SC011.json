    {
      "id": "DLG_ZH_HSK1_SC011_040",
      "speaker": "张乐乐",
      "zh": "对，这是椅子。",
      "pinyin": "Duì, zhè shì yǐ zi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_041",
      "speaker": "张伟",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐ zi zài nǎ ér?",
      "tr": "Sandalye nerede?"
