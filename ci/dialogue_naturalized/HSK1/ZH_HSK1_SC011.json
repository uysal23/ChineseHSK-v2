{
  "naturalizationVersion": 5,
  "sceneId": "ZH_HSK1_SC011",
  "level": "HSK1",
  "sourceTitleZh": "箱子放哪儿？",
  "sourceTitleTr": "Kutular Nerede?",
  "sourceMiniAdventureTr": "Mutfak kutuları yanlış odaya bırakılmıştır; aile kutuları yeniden düzenler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC011_001",
      "speaker": "张伟",
      "zh": "我们要放好箱子。",
      "pinyin": "Wǒmen yào fàng hǎo xiāngzi.",
      "tr": "Kutuları doğru yerlere koyacağız."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_006",
      "speaker": "刘梅",
      "zh": "这是箱子，对吗？",
      "pinyin": "Zhè shì xiāng zi, duì ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_007",
      "speaker": "张雨桐",
      "zh": "没错，是箱子。",
      "pinyin": "Méi cuò, shì xiāng zi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_008",
      "speaker": "张乐乐",
      "zh": "那箱子在哪儿？",
      "pinyin": "Nà xiāng zi zài nǎr?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_009",
      "speaker": "张伟",
      "zh": "你看，箱子在这儿。",
      "pinyin": "Nǐ kàn, xiāng zi zài zhèr.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_010",
      "speaker": "刘梅",
      "zh": "房间呢？",
      "pinyin": "Fáng jiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_011",
      "speaker": "张雨桐",
      "zh": "你看，房间在那边。",
      "pinyin": "Nǐ kàn, fáng jiān zài nà biān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_012",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_014",
      "speaker": "刘梅",
      "zh": "厨房呢？",
      "pinyin": "Chú fáng ne?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_015",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_016",
      "speaker": "张乐乐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_018",
      "speaker": "刘梅",
      "zh": "那客厅在哪儿？",
      "pinyin": "Nà kè tīng zài nǎr?",
      "tr": "Salon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_019",
      "speaker": "张雨桐",
      "zh": "你看，客厅在那边。",
      "pinyin": "Nǐ kàn, kè tīng zài nà biān.",
      "tr": "Salon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_020",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_021",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_022",
      "speaker": "刘梅",
      "zh": "厨房的箱子在孩子的房间。",
      "pinyin": "Chúfáng de xiāngzi zài háizi de fángjiān.",
      "tr": "Mutfak kutusu çocuk odasında."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_027",
      "speaker": "张雨桐",
      "zh": "那家在哪儿？",
      "pinyin": "Nà jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_028",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_029",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_030",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_031",
      "speaker": "张雨桐",
      "zh": "这个是门吗？",
      "pinyin": "Zhè ge shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_032",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是门。",
      "pinyin": "Èn, duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_033",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎr?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_034",
      "speaker": "刘梅",
      "zh": "你看，门在这儿。",
      "pinyin": "Nǐ kàn, mén zài zhèr.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_035",
      "speaker": "张雨桐",
      "zh": "这是桌子，对吗？",
      "pinyin": "Zhè shì zhuō zi, duì ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_036",
      "speaker": "张乐乐",
      "zh": "对，就是桌子。",
      "pinyin": "Duì, jiù shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_037",
      "speaker": "张伟",
      "zh": "桌子呢？",
      "pinyin": "Zhuō zi ne?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_038",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_039",
      "speaker": "张雨桐",
      "zh": "这是椅子，对吗？",
      "pinyin": "Zhè shì yǐ zi, duì ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_040",
      "speaker": "张乐乐",
      "zh": "没错，是椅子。",
      "pinyin": "Méi cuò, shì yǐ zi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_041",
      "speaker": "张伟",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎr?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_043",
      "speaker": "张雨桐",
      "zh": "我们把箱子放回厨房。",
      "pinyin": "Wǒmen bǎ xiāngzi fàng huí chúfáng.",
      "tr": "Kutuyu yeniden mutfağa koyuyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
