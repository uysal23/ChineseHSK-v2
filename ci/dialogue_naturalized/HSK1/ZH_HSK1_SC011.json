{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC011",
  "level": "HSK1",
  "sourceTitleZh": "箱子放哪儿？",
  "sourceTitleTr": "Kutular Nerede?",
  "sourceMiniAdventureTr": "Mutfak kutuları yanlış odaya bırakılmıştır; aile kutuları yeniden düzenler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC011_001",
      "speaker": "张伟",
      "zh": "我们要放好箱子。",
      "pinyin": "Wǒmen yào fàng hǎo xiāngzi.",
      "tr": "Kutuları doğru yerlere koyacağız."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_006",
      "speaker": "刘梅",
      "zh": "这是箱子吗？",
      "pinyin": "Zhè shì xiāngzi ma?",
      "tr": "Bu, kutu / koli mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_007",
      "speaker": "张雨桐",
      "zh": "嗯，对，这是箱子。",
      "pinyin": "Èn, duì, zhè shì xiāngzi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_008",
      "speaker": "张乐乐",
      "zh": "箱子呢？放哪儿了？",
      "pinyin": "Xiāngzi ne? fàng nǎér le?",
      "tr": "Kutu / koli nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_009",
      "speaker": "张伟",
      "zh": "箱子在这儿。",
      "pinyin": "Xiāngzi zài zhèér.",
      "tr": "Kutu / koli burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_010",
      "speaker": "刘梅",
      "zh": "房间在哪儿？",
      "pinyin": "Fángjiān zài nǎr?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_011",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_012",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_013",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_014",
      "speaker": "刘梅",
      "zh": "那厨房在哪儿？",
      "pinyin": "Nà chúfáng zài nǎér?",
      "tr": "Mutfak nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_015",
      "speaker": "张雨桐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Mutfak şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_016",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_018",
      "speaker": "刘梅",
      "zh": "那客厅在哪儿？",
      "pinyin": "Nà kètīng zài nǎér?",
      "tr": "Salon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_019",
      "speaker": "张雨桐",
      "zh": "客厅在那边。",
      "pinyin": "Kètīng zài nàbian.",
      "tr": "Salon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_020",
      "speaker": "张乐乐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_021",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_022",
      "speaker": "刘梅",
      "zh": "厨房的箱子在孩子的房间。",
      "pinyin": "Chúfáng de xiāngzi zài háizi de fángjiān.",
      "tr": "Mutfak kutusu çocuk odasında."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ láikàn kànba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_027",
      "speaker": "张雨桐",
      "zh": "那家在哪儿？",
      "pinyin": "Nà jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_028",
      "speaker": "张乐乐",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_029",
      "speaker": "张伟",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_030",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_031",
      "speaker": "张雨桐",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_032",
      "speaker": "张乐乐",
      "zh": "没错，是门。",
      "pinyin": "Méicuò, shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_033",
      "speaker": "张伟",
      "zh": "那门放在哪儿？",
      "pinyin": "Nà mén fàngzài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_034",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_035",
      "speaker": "张雨桐",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_036",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是桌子。",
      "pinyin": "Èn, duì, zhè shì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_037",
      "speaker": "张伟",
      "zh": "那桌子放在哪儿？",
      "pinyin": "Nà zhuōzi fàngzài nǎér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_038",
      "speaker": "刘梅",
      "zh": "你看，桌子在这儿。",
      "pinyin": "Nǐ kàn, zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_039",
      "speaker": "张雨桐",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_040",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是椅子。",
      "pinyin": "Èn, duì, zhè shì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_041",
      "speaker": "张伟",
      "zh": "椅子呢？放哪儿了？",
      "pinyin": "Yǐzi ne? fàng nǎér le?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_043",
      "speaker": "张雨桐",
      "zh": "我们把箱子放回厨房。",
      "pinyin": "Wǒmen bǎ xiāngzi fàng huí chúfáng.",
      "tr": "Kutuyu yeniden mutfağa koyuyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_044",
      "speaker": "张乐乐",
      "zh": "太棒了！",
      "pinyin": "Tàibàngle!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC011_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_047",
      "speaker": "张雨桐",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xiàxíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC011_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
