    {
      "id": "DLG_ZH_HSK1_SC011_039",
      "speaker": "张雨桐",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐ zi ma?",
      "tr": "Bu, sandalye mı?"
