      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒ yào chá, xiè xiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_029",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Ń, hǎo.",
      "tr": "Olur."
