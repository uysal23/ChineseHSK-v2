{
  "naturalizationVersion": 3,
  "sceneId": "ZH_HSK1_SC019",
  "level": "HSK1",
  "sourceTitleZh": "新家的早餐",
  "sourceTitleTr": "Sabah Kahvaltısı",
  "sourceMiniAdventureTr": "Aile yeni evde ilk sakin kahvaltısını yapar; herkes sevdiği yiyecekleri söyler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC019_001",
      "speaker": "刘梅",
      "zh": "我们一起吃早饭。",
      "pinyin": "Wǒmen yìqǐ chī zǎofàn.",
      "tr": "Birlikte kahvaltı yapıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_003",
      "speaker": "张雨桐",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_006",
      "speaker": "张伟",
      "zh": "你要早饭吗？",
      "pinyin": "Nǐ yào zǎofàn ma?",
      "tr": "Kahvaltı ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_007",
      "speaker": "张雨桐",
      "zh": "我要早饭，谢谢。",
      "pinyin": "Wǒ yào zǎofàn, xièxie.",
      "tr": "Kahvaltı istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_008",
      "speaker": "张乐乐",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_010",
      "speaker": "张伟",
      "zh": "你要面包吗？",
      "pinyin": "Nǐ yào miànbāo ma?",
      "tr": "Ekmek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_011",
      "speaker": "张雨桐",
      "zh": "我要面包，谢谢。",
      "pinyin": "Wǒ yào miànbāo, xièxie.",
      "tr": "Ekmek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_012",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_013",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_014",
      "speaker": "张伟",
      "zh": "你要牛奶吗？",
      "pinyin": "Nǐ yào niúnǎi ma?",
      "tr": "Süt ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_015",
      "speaker": "张雨桐",
      "zh": "我要牛奶，谢谢。",
      "pinyin": "Wǒ yào niúnǎi, xièxie.",
      "tr": "Süt istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_016",
      "speaker": "张乐乐",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_017",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_018",
      "speaker": "张伟",
      "zh": "你要鸡蛋吗？",
      "pinyin": "Nǐ yào jīdàn ma?",
      "tr": "Yumurta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_019",
      "speaker": "张雨桐",
      "zh": "我要鸡蛋，谢谢。",
      "pinyin": "Wǒ yào jīdàn, xièxie.",
      "tr": "Yumurta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_020",
      "speaker": "张乐乐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_021",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_022",
      "speaker": "张伟",
      "zh": "每个人喜欢的东西不一样。",
      "pinyin": "Měi ge rén xǐhuan de dōngxi bù yíyàng.",
      "tr": "Herkesin sevdiği şey farklı."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_026",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_027",
      "speaker": "张雨桐",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_028",
      "speaker": "张乐乐",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒ yào chá, xièxie.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_029",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_030",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_031",
      "speaker": "张雨桐",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_032",
      "speaker": "张乐乐",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xièxie.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_033",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_035",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_037",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_038",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_039",
      "speaker": "张雨桐",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_040",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是桌子。",
      "pinyin": "Èn, duì, zhè shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_041",
      "speaker": "刘梅",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuōzi zài nǎr?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_042",
      "speaker": "张伟",
      "zh": "桌子在这儿。",
      "pinyin": "Zhuō zi zài zhèr.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_043",
      "speaker": "张雨桐",
      "zh": "大家都吃得很开心。",
      "pinyin": "Dàjiā dōu chī de hěn kāixīn.",
      "tr": "Herkes keyifle yiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_045",
      "speaker": "刘梅",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_046",
      "speaker": "张伟",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_048",
      "speaker": "张乐乐",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
