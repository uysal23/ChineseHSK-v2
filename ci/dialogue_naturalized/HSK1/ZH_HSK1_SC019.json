{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC019",
  "level": "HSK1",
  "sourceTitleZh": "新家的早餐",
  "sourceTitleTr": "Sabah Kahvaltısı",
  "sourceMiniAdventureTr": "Aile yeni evde ilk sakin kahvaltısını yapar; herkes sevdiği yiyecekleri söyler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC019_001",
      "speaker": "刘梅",
      "zh": "我们一起吃早饭。",
      "pinyin": "Wǒ men yī qǐ chī zǎo fàn.",
      "tr": "Birlikte kahvaltı yapıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_005",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_006",
      "speaker": "张伟",
      "zh": "你要早饭吗？",
      "pinyin": "Nǐ yào zǎo fàn ma?",
      "tr": "Kahvaltı ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_007",
      "speaker": "张雨桐",
      "zh": "我要早饭，谢谢。",
      "pinyin": "Wǒ yào zǎo fàn, xiè xiè.",
      "tr": "Kahvaltı istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_008",
      "speaker": "张乐乐",
      "zh": "嗯，好。",
      "pinyin": "Ń, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_009",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_010",
      "speaker": "张伟",
      "zh": "你要面包吗？",
      "pinyin": "Nǐ yào miàn bāo ma?",
      "tr": "Ekmek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_011",
      "speaker": "张雨桐",
      "zh": "我要面包，谢谢。",
      "pinyin": "Wǒ yào miàn bāo, xiè xiè.",
      "tr": "Ekmek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_012",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_013",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_014",
      "speaker": "张伟",
      "zh": "你要牛奶吗？",
      "pinyin": "Nǐ yào niú nǎi ma?",
      "tr": "Süt ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_015",
      "speaker": "张雨桐",
      "zh": "我要牛奶，谢谢。",
      "pinyin": "Wǒ yào niú nǎi, xiè xiè.",
      "tr": "Süt istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_016",
      "speaker": "张乐乐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_017",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_018",
      "speaker": "张伟",
      "zh": "你要鸡蛋吗？",
      "pinyin": "Nǐ yào jī dàn ma?",
      "tr": "Yumurta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_019",
      "speaker": "张雨桐",
      "zh": "我要鸡蛋，谢谢。",
      "pinyin": "Wǒ yào jī dàn, xiè xiè.",
      "tr": "Yumurta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_020",
      "speaker": "张乐乐",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_021",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_022",
      "speaker": "张伟",
      "zh": "每个人喜欢的东西不一样。",
      "pinyin": "Měi gè rén xǐ huān de dōng xī bù yī yàng.",
      "tr": "Herkesin sevdiği şey farklı."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_025",
      "speaker": "刘梅",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_026",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_027",
      "speaker": "张雨桐",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_028",
