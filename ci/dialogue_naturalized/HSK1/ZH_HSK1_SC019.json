      "id": "DLG_ZH_HSK1_SC019_031",
      "speaker": "张雨桐",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_032",
      "speaker": "张乐乐",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xiè xiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_033",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Ń, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_035",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_036",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_037",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_038",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_039",
      "speaker": "张雨桐",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuō zi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_040",
      "speaker": "张乐乐",
      "zh": "对，这是桌子。",
      "pinyin": "Duì, zhè shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_041",
      "speaker": "刘梅",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuō zi zài nǎ ér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_042",
      "speaker": "张伟",
      "zh": "桌子在这里。",
      "pinyin": "Zhuō zi zài zhè lǐ.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_043",
      "speaker": "张雨桐",
      "zh": "大家都吃得很开心。",
      "pinyin": "Dà jiā dōu chī dé hěn kāi xīn.",
      "tr": "Herkes keyifle yiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC019_045",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_046",
      "speaker": "张伟",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_047",
      "speaker": "张雨桐",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC019_048",
      "speaker": "张乐乐",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
