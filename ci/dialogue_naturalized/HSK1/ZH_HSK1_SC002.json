{
  "naturalizationVersion": 4,
  "sceneId": "ZH_HSK1_SC002",
  "level": "HSK1",
  "sourceTitleZh": "火车票在哪儿？",
  "sourceTitleTr": "Tren Biletleri Nerede?",
  "sourceMiniAdventureTr": "Aile evden çıkmaya hazırlanırken Lele kendi tren biletini bulamaz.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC002_001",
      "speaker": "张伟",
      "zh": "我们要去坐火车。",
      "pinyin": "Wǒmen yào qù zuò huǒchē.",
      "tr": "Trene binmeye gideceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_003",
      "speaker": "张雨桐",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_006",
      "speaker": "刘梅",
      "zh": "这个是火车票吗？",
      "pinyin": "Zhè ge shì huǒ chē piào ma?",
      "tr": "Bu, tren bileti mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_007",
      "speaker": "张雨桐",
      "zh": "对，就是火车票。",
      "pinyin": "Duì, jiù shì huǒ chē piào.",
      "tr": "Evet, bu tren bileti."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_008",
      "speaker": "张乐乐",
      "zh": "那火车票在哪儿？",
      "pinyin": "Nà huǒ chē piào zài nǎr?",
      "tr": "Tren bileti nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_009",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Tren bileti burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_010",
      "speaker": "刘梅",
      "zh": "这个是包吗？",
      "pinyin": "Zhè ge shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_011",
      "speaker": "张雨桐",
      "zh": "对，就是包。",
      "pinyin": "Duì, jiù shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_012",
      "speaker": "张乐乐",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_013",
      "speaker": "张伟",
      "zh": "你看，包在这儿。",
      "pinyin": "Nǐ kàn, bāo zài zhèr.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_014",
      "speaker": "刘梅",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuò huǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_015",
      "speaker": "张雨桐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuò huǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_016",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_017",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_018",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_019",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_020",
      "speaker": "张乐乐",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_021",
      "speaker": "张伟",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_022",
      "speaker": "刘梅",
      "zh": "乐乐的火车票不见了。",
      "pinyin": "Lèlè de huǒchēpiào bú jiàn le.",
      "tr": "Lele’nin tren bileti ortada yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_027",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_028",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_030",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_031",
      "speaker": "张雨桐",
      "zh": "这个是门吗？",
      "pinyin": "Zhè ge shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_032",
      "speaker": "张乐乐",
      "zh": "没错，是门。",
      "pinyin": "Méi cuò, shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_033",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎr?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_034",
      "speaker": "刘梅",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèr.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_035",
      "speaker": "张雨桐",
      "zh": "这个是时间吗？",
      "pinyin": "Zhè ge shì shí jiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_036",
      "speaker": "张乐乐",
      "zh": "对，就是时间。",
      "pinyin": "Duì, jiù shì shí jiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_037",
      "speaker": "张伟",
      "zh": "时间呢？",
      "pinyin": "Shí jiān ne?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_038",
      "speaker": "刘梅",
      "zh": "你看，时间在这儿。",
      "pinyin": "Nǐ kàn, shí jiān zài zhèr.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_039",
      "speaker": "张雨桐",
      "zh": "这是猫，对吗？",
      "pinyin": "Zhè shì māo, duì ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_040",
      "speaker": "张乐乐",
      "zh": "对，就是猫。",
      "pinyin": "Duì, jiù shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_041",
      "speaker": "张伟",
      "zh": "那猫在哪儿？",
      "pinyin": "Nà māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_042",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_043",
      "speaker": "张雨桐",
      "zh": "找到了，在包里。",
      "pinyin": "Zhǎodào le, zài bāo lǐ.",
      "tr": "Bulduk, çantanın içindeymiş."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_047",
      "speaker": "张雨桐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
    },
    {
