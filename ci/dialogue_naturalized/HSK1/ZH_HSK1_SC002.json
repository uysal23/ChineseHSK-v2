      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_087",
      "speaker": "张雨桐",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_088",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_089",
      "speaker": "张伟",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_090",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_091",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_092",
      "speaker": "张乐乐",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_093",
      "speaker": "张伟",
      "zh": "这个是门吗？",
      "pinyin": "Zhè ge shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_094",
      "speaker": "刘梅",
      "zh": "没错，是门。",
      "pinyin": "Méi cuò, shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_095",
      "speaker": "张雨桐",
      "zh": "门呢？",
      "pinyin": "Mén ne?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_096",
      "speaker": "张乐乐",
      "zh": "今天学了很多。",
      "pinyin": "Jīntiān xué le hěn duō.",
      "tr": "Bugün çok şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_097",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_098",
      "speaker": "刘梅",
      "zh": "都好了吗？",
      "pinyin": "Dōu hǎo le ma?",
      "tr": "Her şey tamam mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_099",
      "speaker": "张雨桐",
      "zh": "都好了。",
      "pinyin": "Dōu hǎo le.",
      "tr": "Her şey tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_100",
      "speaker": "张乐乐",
      "zh": "走吧。",
      "pinyin": "Zǒu ba.",
      "tr": "Hadi gidelim."
    }
  ]
