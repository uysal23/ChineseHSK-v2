{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC002",
  "level": "HSK1",
  "sourceTitleZh": "火车票在哪儿？",
  "sourceTitleTr": "Tren Biletleri Nerede?",
  "sourceMiniAdventureTr": "Aile evden çıkmaya hazırlanırken Lele kendi tren biletini bulamaz.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC002_001",
      "speaker": "张伟",
      "zh": "我们要去坐火车。",
      "pinyin": "Wǒmen yào qù zuò huǒchē.",
      "tr": "Trene binmeye gideceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_003",
      "speaker": "张雨桐",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_006",
      "speaker": "刘梅",
      "zh": "这是火车票吗？",
      "pinyin": "Zhè shì huǒchēpiào ma?",
      "tr": "Bu, tren bileti mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_007",
      "speaker": "张雨桐",
      "zh": "没错，是火车票。",
      "pinyin": "Méicuò, shì huǒchēpiào.",
      "tr": "Evet, bu tren bileti."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_008",
      "speaker": "张乐乐",
      "zh": "那火车票在哪儿？",
      "pinyin": "Nà huǒchēpiào zài nǎér?",
      "tr": "Tren bileti nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_009",
      "speaker": "张伟",
      "zh": "火车票在这儿。",
      "pinyin": "Huǒchēpiào zài zhèér.",
      "tr": "Tren bileti burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_010",
      "speaker": "刘梅",
      "zh": "这是包吗？",
      "pinyin": "Zhè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_011",
      "speaker": "张雨桐",
      "zh": "对，就是包。",
      "pinyin": "Duì, jiùshì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_012",
      "speaker": "张乐乐",
      "zh": "那包放在哪儿？",
      "pinyin": "Nà bāo fàngzài nǎér?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_013",
      "speaker": "张伟",
      "zh": "包在这儿。",
      "pinyin": "Bāo zài zhèér.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_014",
      "speaker": "刘梅",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuò huǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_015",
      "speaker": "张雨桐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuò huǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_016",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_017",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_018",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_019",
      "speaker": "张雨桐",
      "zh": "嗯，有一点。",
      "pinyin": "Èn, yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_020",
      "speaker": "张乐乐",
      "zh": "没关系，别急。",
      "pinyin": "Méiguānxì, biéjí.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_021",
      "speaker": "张伟",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_022",
      "speaker": "刘梅",
      "zh": "乐乐的火车票不见了。",
      "pinyin": "Lèlè de huǒchēpiào bú jiàn le.",
      "tr": "Lele’nin tren bileti ortada yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_024",
      "speaker": "张乐乐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_027",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_028",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_030",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_031",
      "speaker": "张雨桐",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_032",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是门。",
      "pinyin": "Èn, duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_033",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎr?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_034",
      "speaker": "刘梅",
      "zh": "你看，门在这儿。",
      "pinyin": "Nǐ kàn, mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_035",
      "speaker": "张雨桐",
      "zh": "这是时间吗？",
      "pinyin": "Zhè shì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_036",
      "speaker": "张乐乐",
      "zh": "对，就是时间。",
      "pinyin": "Duì, jiùshì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_037",
      "speaker": "张伟",
      "zh": "时间在哪儿？",
      "pinyin": "Shíjiān zài nǎr?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_038",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_039",
      "speaker": "张雨桐",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_040",
      "speaker": "张乐乐",
      "zh": "没错，是猫。",
      "pinyin": "Méicuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_041",
      "speaker": "张伟",
      "zh": "那猫放在哪儿？",
      "pinyin": "Nà māo fàngzài nǎér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_042",
      "speaker": "刘梅",
      "zh": "猫在这儿。",
      "pinyin": "Māo zài zhèér.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_043",
      "speaker": "张雨桐",
      "zh": "找到了，在包里。",
      "pinyin": "Zhǎodào le, zài bāo lǐ.",
      "tr": "Bulduk, çantanın içindeymiş."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_047",
      "speaker": "张雨桐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_048",
      "speaker": "张乐乐",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒmen jìxù ba.",
      "tr": "Devam edelim."
    },
    {
