{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC002",
  "level": "HSK1",
  "sourceTitleZh": "火车票在哪儿？",
  "sourceTitleTr": "Tren Biletleri Nerede?",
  "sourceMiniAdventureTr": "Aile evden çıkmaya hazırlanırken Lele kendi tren biletini bulamaz.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC002_001",
      "speaker": "张伟",
      "zh": "我们要去坐火车。",
      "pinyin": "Wǒ men yào qù zuò huǒ chē.",
      "tr": "Trene binmeye gideceğiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_003",
      "speaker": "张雨桐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_006",
      "speaker": "刘梅",
      "zh": "这是火车票吗？",
      "pinyin": "Zhè shì huǒ chē piào ma?",
      "tr": "Bu, tren bileti mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_007",
      "speaker": "张雨桐",
      "zh": "对，这是火车票。",
      "pinyin": "Duì, zhè shì huǒ chē piào.",
      "tr": "Evet, bu tren bileti."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_008",
      "speaker": "张乐乐",
      "zh": "火车票在哪儿？",
      "pinyin": "Huǒ chē piào zài nǎ ér?",
      "tr": "Tren bileti nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_009",
      "speaker": "张伟",
      "zh": "火车票在这里。",
      "pinyin": "Huǒ chē piào zài zhè lǐ.",
      "tr": "Tren bileti burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_010",
      "speaker": "刘梅",
      "zh": "这是包吗？",
      "pinyin": "Zhè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_011",
      "speaker": "张雨桐",
      "zh": "对，这是包。",
      "pinyin": "Duì, zhè shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_012",
      "speaker": "张乐乐",
      "zh": "包在哪儿？",
      "pinyin": "Bāo zài nǎ ér?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_013",
      "speaker": "张伟",
      "zh": "包在这里。",
      "pinyin": "Bāo zài zhè lǐ.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_014",
      "speaker": "刘梅",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒ men zuò huǒ chē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_015",
      "speaker": "张雨桐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒ men zuò huǒ chē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_016",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_017",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_018",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_019",
      "speaker": "张雨桐",
      "zh": "有一点儿。",
      "pinyin": "Yǒu yī diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_020",
      "speaker": "张乐乐",
      "zh": "没关系，别急。",
      "pinyin": "Méi guān xì, bié jí.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_021",
      "speaker": "张伟",
      "zh": "好，继续吧。",
      "pinyin": "Hǎo, jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_022",
      "speaker": "刘梅",
      "zh": "乐乐的火车票不见了。",
      "pinyin": "Lè lè de huǒ chē piào bù jiàn le.",
      "tr": "Lele’nin tren bileti ortada yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_027",
      "speaker": "张雨桐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_028",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_029",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_030",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_031",
      "speaker": "张雨桐",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_032",
      "speaker": "张乐乐",
      "zh": "对，这是门。",
      "pinyin": "Duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_033",
      "speaker": "张伟",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎ ér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_034",
      "speaker": "刘梅",
      "zh": "门在这里。",
      "pinyin": "Mén zài zhè lǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_035",
      "speaker": "张雨桐",
      "zh": "这是时间吗？",
      "pinyin": "Zhè shì shí jiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_036",
      "speaker": "张乐乐",
      "zh": "对，这是时间。",
      "pinyin": "Duì, zhè shì shí jiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_037",
      "speaker": "张伟",
      "zh": "时间在哪儿？",
      "pinyin": "Shí jiān zài nǎ ér?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_038",
      "speaker": "刘梅",
      "zh": "时间在这里。",
      "pinyin": "Shí jiān zài zhè lǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_039",
      "speaker": "张雨桐",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_040",
      "speaker": "张乐乐",
      "zh": "对，这是猫。",
      "pinyin": "Duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_041",
      "speaker": "张伟",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎ ér?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_042",
      "speaker": "刘梅",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhè lǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_043",
      "speaker": "张雨桐",
      "zh": "找到了，在包里。",
      "pinyin": "Zhǎo dào le, zài bāo lǐ.",
      "tr": "Bulduk, çantanın içindeymiş."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC002_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_047",
      "speaker": "张雨桐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC002_048",
      "speaker": "张乐乐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
