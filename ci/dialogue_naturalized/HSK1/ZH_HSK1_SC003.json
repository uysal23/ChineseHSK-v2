{
  "naturalizationVersion": 7,
  "sceneId": "ZH_HSK1_SC003",
  "level": "HSK1",
  "sourceTitleZh": "站台在哪儿？",
  "sourceTitleTr": "Peron Nerede?",
  "sourceMiniAdventureTr": "İstasyonda yanlış yöne giderler ve görevliye doğru peronu sorarlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC003_001",
      "speaker": "张伟",
      "zh": "我们要找站台。",
      "pinyin": "Wǒmen yào zhǎo zhàntái.",
      "tr": "Peronu bulmamız gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_003",
      "speaker": "工作人员",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_006",
      "speaker": "刘梅",
      "zh": "那车站在哪儿？",
      "pinyin": "Nà chē zhàn zài nǎr?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_007",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_008",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_009",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_010",
      "speaker": "刘梅",
      "zh": "站台呢？",
      "pinyin": "Zhàn tái ne?",
      "tr": "Peron nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_011",
      "speaker": "工作人员",
      "zh": "站台在那边。",
      "pinyin": "Zhàntái zài nàbian.",
      "tr": "Peron şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_012",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_013",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_014",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbian ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_015",
      "speaker": "工作人员",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbian.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_016",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_018",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubian ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_019",
      "speaker": "工作人员",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubian.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_020",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_022",
      "speaker": "刘梅",
      "zh": "我们走错了。",
      "pinyin": "Wǒmen zǒu cuò le.",
      "tr": "Yanlış yöne gittik."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_027",
      "speaker": "工作人员",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuò huǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_028",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuò huǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_029",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_030",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_031",
      "speaker": "工作人员",
      "zh": "这是火车票，对吗？",
      "pinyin": "Zhè shì huǒ chē piào, duì ma?",
      "tr": "Bu, tren bileti mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_032",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是火车票。",
      "pinyin": "Èn, duì, zhè shì huǒ chē piào.",
      "tr": "Evet, bu tren bileti."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_033",
      "speaker": "张伟",
      "zh": "火车票在哪儿？",
      "pinyin": "Huǒchēpiào zài nǎr?",
      "tr": "Tren bileti nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_034",
      "speaker": "刘梅",
      "zh": "火车票在这儿。",
      "pinyin": "Huǒ chē piào zài zhèr.",
      "tr": "Tren bileti burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_035",
      "speaker": "工作人员",
      "zh": "那路在哪儿？",
      "pinyin": "Nà lù zài nǎr?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_036",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_037",
      "speaker": "张伟",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_038",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_039",
      "speaker": "工作人员",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_042",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_043",
      "speaker": "工作人员",
      "zh": "对，站台在右边。",
      "pinyin": "Duì, zhàntái zài yòubian.",
      "tr": "Evet, peron sağ tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_044",
      "speaker": "张乐乐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_046",
      "speaker": "刘梅",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_047",
      "speaker": "工作人员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_048",
      "speaker": "张乐乐",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_049",
      "speaker": "张伟",
      "zh": "车站呢？",
      "pinyin": "Chē zhàn ne?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_050",
      "speaker": "刘梅",
      "zh": "车站在那边。",
      "pinyin": "Chēzhàn zài nàbian.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_051",
      "speaker": "工作人员",
      "zh": "好，明白了。",
