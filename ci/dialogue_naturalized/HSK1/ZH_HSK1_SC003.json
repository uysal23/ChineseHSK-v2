{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC003",
  "level": "HSK1",
  "sourceTitleZh": "站台在哪儿？",
  "sourceTitleTr": "Peron Nerede?",
  "sourceMiniAdventureTr": "İstasyonda yanlış yöne giderler ve görevliye doğru peronu sorarlar.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC003_001",
      "speaker": "张伟",
      "zh": "我们要找站台。",
      "pinyin": "Wǒmen yào zhǎo zhàntái.",
      "tr": "Peronu bulmamız gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_003",
      "speaker": "工作人员",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_006",
      "speaker": "刘梅",
      "zh": "车站在哪儿？",
      "pinyin": "Chēzhàn zài nǎr?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_007",
      "speaker": "工作人员",
      "zh": "你看，车站在那边。",
      "pinyin": "Nǐ kàn, chēzhàn zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_008",
      "speaker": "张乐乐",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_009",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_010",
      "speaker": "刘梅",
      "zh": "那站台在哪儿？",
      "pinyin": "Nà zhàntái zài nǎér?",
      "tr": "Peron nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_011",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Peron şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_012",
      "speaker": "张乐乐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_013",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_014",
      "speaker": "刘梅",
      "zh": "在左边吗？",
      "pinyin": "Zài zuǒbian ma?",
      "tr": "Sol taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_015",
      "speaker": "工作人员",
      "zh": "对，在左边。",
      "pinyin": "Duì, zài zuǒbian.",
      "tr": "Evet, sol taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_016",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_017",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_018",
      "speaker": "刘梅",
      "zh": "在右边吗？",
      "pinyin": "Zài yòubian ma?",
      "tr": "Sağ taraf mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_019",
      "speaker": "工作人员",
      "zh": "对，在右边。",
      "pinyin": "Duì, zài yòubian.",
      "tr": "Evet, sağ taraf."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_020",
      "speaker": "张乐乐",
      "zh": "这边走。",
      "pinyin": "Zhèbiān zǒu.",
      "tr": "Bu taraftan gidin."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_022",
      "speaker": "刘梅",
      "zh": "我们走错了。",
      "pinyin": "Wǒmen zǒu cuò le.",
      "tr": "Yanlış yöne gittik."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_023",
      "speaker": "工作人员",
      "zh": "先别急。",
      "pinyin": "Xiān biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ láikàn kànba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_027",
      "speaker": "工作人员",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuò huǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_028",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuò huǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_029",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_030",
      "speaker": "刘梅",
      "zh": "嗯，准备好了。",
      "pinyin": "Èn, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_031",
      "speaker": "工作人员",
      "zh": "这是火车票吗？",
      "pinyin": "Zhè shì huǒchēpiào ma?",
      "tr": "Bu, tren bileti mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_032",
      "speaker": "张乐乐",
      "zh": "对，就是火车票。",
      "pinyin": "Duì, jiùshì huǒchēpiào.",
      "tr": "Evet, bu tren bileti."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_033",
      "speaker": "张伟",
      "zh": "那火车票在哪儿？",
      "pinyin": "Nà huǒchēpiào zài nǎér?",
      "tr": "Tren bileti nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_034",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Tren bileti burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_035",
      "speaker": "工作人员",
      "zh": "那路在哪儿？",
      "pinyin": "Nà lù zài nǎér?",
      "tr": "Yol nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_036",
      "speaker": "张乐乐",
      "zh": "你看，路在那边。",
      "pinyin": "Nǐ kàn, lù zài nàbiān.",
      "tr": "Yol şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_037",
      "speaker": "张伟",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_038",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_039",
      "speaker": "工作人员",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_041",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_042",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_043",
      "speaker": "工作人员",
      "zh": "对，站台在右边。",
      "pinyin": "Duì, zhàntái zài yòubian.",
      "tr": "Evet, peron sağ tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_047",
      "speaker": "工作人员",
      "zh": "现在就好了。",
      "pinyin": "Xiànzài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_048",
      "speaker": "张乐乐",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_049",
      "speaker": "张伟",
      "zh": "车站呢？",
      "pinyin": "Chēzhàn ne?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC003_050",
      "speaker": "刘梅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC003_051",
      "speaker": "工作人员",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míngbái le.",
      "tr": "Anladım."
