      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_035",
      "speaker": "同学",
      "zh": "这是图片吗？",
      "pinyin": "Zhè shì túpiàn ma?",
      "tr": "Bu, resim / görsel mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_036",
      "speaker": "同学",
      "zh": "没错，是图片。",
      "pinyin": "Méi cuò, shì tú piàn.",
      "tr": "Evet, bu resim / görsel."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_037",
      "speaker": "张乐乐",
      "zh": "那图片在哪儿？",
      "pinyin": "Nà tú piàn zài nǎr?",
      "tr": "Resim / görsel nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_038",
      "speaker": "老师",
      "zh": "图片在这儿。",
      "pinyin": "Tú piàn zài zhèr.",
      "tr": "Resim / görsel burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_039",
      "speaker": "同学",
      "zh": "学校呢？",
      "pinyin": "Xué xiào ne?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_040",
      "speaker": "同学",
      "zh": "学校在那边。",
      "pinyin": "Xuéxiào zài nàbian.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_041",
      "speaker": "张乐乐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_042",
      "speaker": "老师",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_043",
      "speaker": "同学",
      "zh": "乐乐高兴地介绍了大家。",
      "pinyin": "Lèlè gāoxìng de jièshào le dàjiā.",
      "tr": "Lele herkesi sevinçle tanıtıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_044",
      "speaker": "同学",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_045",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_046",
      "speaker": "老师",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_047",
      "speaker": "同学",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_048",
      "speaker": "同学",
      "zh": "好，我们接着来。",
