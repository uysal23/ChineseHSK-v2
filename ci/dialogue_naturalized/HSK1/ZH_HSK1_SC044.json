{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC044",
  "level": "HSK1",
  "sourceTitleZh": "乐乐的全家福",
  "sourceTitleTr": "Lele’nin Resmi",
  "sourceMiniAdventureTr": "Lele okulda çizdiği aile resmini sınıfa anlatır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC044_001",
      "speaker": "张乐乐",
      "zh": "乐乐画了全家福。",
      "pinyin": "Lè lè huà le quán jiā fú.",
      "tr": "Lele bir aile resmi çizdi."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_002",
      "speaker": "老师",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_003",
      "speaker": "同学",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_004",
      "speaker": "同学",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_006",
      "speaker": "老师",
      "zh": "这是画吗？",
      "pinyin": "Zhè shì huà ma?",
      "tr": "Bu, resim mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_007",
      "speaker": "同学",
      "zh": "对，这是画。",
      "pinyin": "Duì, zhè shì huà.",
      "tr": "Evet, bu resim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_008",
      "speaker": "同学",
      "zh": "画在哪儿？",
      "pinyin": "Huà zài nǎ ér?",
      "tr": "Resim nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_009",
      "speaker": "张乐乐",
      "zh": "画在这里。",
      "pinyin": "Huà zài zhè lǐ.",
      "tr": "Resim burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_010",
      "speaker": "老师",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_011",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_012",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_013",
      "speaker": "张乐乐",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_014",
      "speaker": "老师",
      "zh": "这是我们的妈妈。",
      "pinyin": "Zhè shì wǒ men de mā mā.",
      "tr": "Bu bizim anne."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_015",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_016",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_017",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_018",
      "speaker": "老师",
      "zh": "这是我们的爸爸。",
      "pinyin": "Zhè shì wǒ men de bà bà.",
      "tr": "Bu bizim baba."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_019",
      "speaker": "同学",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_020",
      "speaker": "同学",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_021",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_022",
      "speaker": "老师",
      "zh": "老师请他介绍家人。",
      "pinyin": "Lǎo shī qǐng tā jiè shào jiā rén.",
      "tr": "Öğretmen ailesini tanıtmasını istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_023",
      "speaker": "同学",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_024",
      "speaker": "同学",
      "zh": "我看看。",
      "pinyin": "Wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_026",
      "speaker": "老师",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_027",
      "speaker": "同学",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒ men de lǎo shī.",
      "tr": "Bu bizim öğretmen."
    },
