    {
      "id": "DLG_ZH_HSK1_SC044_036",
      "speaker": "同学",
      "zh": "对，这是图片。",
      "pinyin": "Duì, zhè shì tú piàn.",
      "tr": "Evet, bu resim / görsel."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_037",
      "speaker": "张乐乐",
      "zh": "图片在哪儿？",
      "pinyin": "Tú piàn zài nǎ ér?",
      "tr": "Resim / görsel nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_038",
      "speaker": "老师",
      "zh": "图片在这里。",
      "pinyin": "Tú piàn zài zhè lǐ.",
      "tr": "Resim / görsel burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_039",
      "speaker": "同学",
      "zh": "学校在哪儿？",
      "pinyin": "Xué xiào zài nǎ ér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_040",
      "speaker": "同学",
      "zh": "学校在那边。",
      "pinyin": "Xué xiào zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_041",
      "speaker": "张乐乐",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_042",
      "speaker": "老师",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_043",
      "speaker": "同学",
      "zh": "乐乐高兴地介绍了大家。",
      "pinyin": "Lè lè gāo xīng dì jiè shào le dà jiā.",
      "tr": "Lele herkesi sevinçle tanıtıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_044",
      "speaker": "同学",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC044_045",
      "speaker": "张乐乐",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_046",
      "speaker": "老师",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_047",
      "speaker": "同学",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC044_048",
