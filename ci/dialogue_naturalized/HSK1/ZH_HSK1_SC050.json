    {
      "id": "DLG_ZH_HSK1_SC050_035",
      "speaker": "李晨",
      "zh": "你要蛋糕吗？",
      "pinyin": "Nǐ yào dàn gāo ma?",
      "tr": "Kek / pasta ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_036",
      "speaker": "李晨妻子",
      "zh": "我要蛋糕，谢谢。",
      "pinyin": "Wǒ yào dàn gāo, xiè xiè.",
      "tr": "Kek / pasta istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_037",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
