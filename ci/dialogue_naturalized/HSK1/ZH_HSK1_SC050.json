      "speaker": "李晨",
      "zh": "公园在哪儿？",
      "pinyin": "Gōng yuán zài nǎ ér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_040",
      "speaker": "李晨妻子",
      "zh": "公园在那边。",
      "pinyin": "Gōng yuán zài nà biān.",
      "tr": "Park şu tarafta."
