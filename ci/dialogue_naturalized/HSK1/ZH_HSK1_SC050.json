{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC050",
  "level": "HSK1",
  "sourceTitleZh": "这里是我们的家",
  "sourceTitleTr": "Artık Evimiz Burası",
  "sourceMiniAdventureTr": "Aile ve Li Chen’ler birlikte yemek yer; herkes yeni kasabada sevdiği bir şeyi söyler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC050_001",
      "speaker": "张伟",
      "zh": "今天两家人一起吃饭。",
      "pinyin": "Jīn tiān liǎng jiā rén yī qǐ chī fàn.",
      "tr": "Bugün iki aile birlikte yemek yiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_003",
      "speaker": "李晨",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_004",
      "speaker": "李晨妻子",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_006",
      "speaker": "刘梅",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_007",
      "speaker": "李晨",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_008",
      "speaker": "李晨妻子",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_009",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_011",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_012",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_013",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_015",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_016",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_017",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_018",
      "speaker": "刘梅",
      "zh": "新城在哪儿？",
      "pinyin": "Xīn chéng zài nǎ ér?",
      "tr": "Yeni şehir / kasaba nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_019",
      "speaker": "李晨",
      "zh": "新城在那边。",
      "pinyin": "Xīn chéng zài nà biān.",
      "tr": "Yeni şehir / kasaba şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_020",
      "speaker": "李晨妻子",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_022",
      "speaker": "刘梅",
      "zh": "大家说起刚来新城的时候。",
      "pinyin": "Dà jiā shuō qǐ gāng lái xīn chéng de shí hòu.",
      "tr": "Herkes yeni kasabaya ilk geldikleri zamanı konuşuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_024",
      "speaker": "李晨妻子",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_027",
      "speaker": "李晨",
      "zh": "学校在哪儿？",
      "pinyin": "Xué xiào zài nǎ ér?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_028",
      "speaker": "李晨妻子",
      "zh": "学校在那边。",
      "pinyin": "Xué xiào zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_029",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_030",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_031",
      "speaker": "李晨",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōng zuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_032",
      "speaker": "李晨妻子",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_033",
      "speaker": "张伟",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_034",
