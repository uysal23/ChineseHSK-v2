      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_043",
      "speaker": "李晨",
      "zh": "这里现在是我们的家。",
      "pinyin": "Zhè lǐ xiàn zài shì wǒ men de jiā.",
      "tr": "Burası artık bizim evimiz."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_044",
      "speaker": "李晨妻子",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_045",
      "speaker": "张伟",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_046",
      "speaker": "刘梅",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_047",
      "speaker": "李晨",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
