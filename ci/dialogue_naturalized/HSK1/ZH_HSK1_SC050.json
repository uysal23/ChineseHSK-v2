{
  "naturalizationVersion": 3,
  "sceneId": "ZH_HSK1_SC050",
  "level": "HSK1",
  "sourceTitleZh": "这里是我们的家",
  "sourceTitleTr": "Artık Evimiz Burası",
  "sourceMiniAdventureTr": "Aile ve Li Chen’ler birlikte yemek yer; herkes yeni kasabada sevdiği bir şeyi söyler.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC050_001",
      "speaker": "张伟",
      "zh": "今天两家人一起吃饭。",
      "pinyin": "Jīntiān liǎng jiā rén yìqǐ chīfàn.",
      "tr": "Bugün iki aile birlikte yemek yiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_003",
      "speaker": "李晨",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_004",
      "speaker": "李晨妻子",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_006",
      "speaker": "刘梅",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_007",
      "speaker": "李晨",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nàbian.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_008",
      "speaker": "李晨妻子",
      "zh": "这下明白了。",
      "pinyin": "Zhè xià míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_009",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_010",
      "speaker": "刘梅",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_011",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_012",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_013",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_014",
      "speaker": "刘梅",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_015",
      "speaker": "李晨",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_016",
      "speaker": "李晨妻子",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_017",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_018",
      "speaker": "刘梅",
      "zh": "新城呢？",
      "pinyin": "Xīn chéng ne?",
      "tr": "Yeni şehir / kasaba nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_019",
      "speaker": "李晨",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Yeni şehir / kasaba şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_020",
      "speaker": "李晨妻子",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_021",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_022",
      "speaker": "刘梅",
      "zh": "大家说起刚来新城的时候。",
      "pinyin": "Dàjiā shuōqǐ gāng lái Xīnchéng de shíhou.",
      "tr": "Herkes yeni kasabaya ilk geldikleri zamanı konuşuyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_023",
      "speaker": "李晨",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_024",
      "speaker": "李晨妻子",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_027",
      "speaker": "李晨",
      "zh": "学校在哪儿？",
      "pinyin": "Xuéxiào zài nǎr?",
      "tr": "Okul nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC050_028",
      "speaker": "李晨妻子",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Okul şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC050_029",
      "speaker": "张伟",
      "zh": "好，明白了。",
