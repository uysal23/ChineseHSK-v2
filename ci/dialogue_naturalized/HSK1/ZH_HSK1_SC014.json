{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC014",
  "level": "HSK1",
  "sourceTitleZh": "有人敲门",
  "sourceTitleTr": "Kapı Çalıyor",
  "sourceMiniAdventureTr": "Yeni komşu aileye hoş geldiniz demeye gelir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC014_001",
      "speaker": "刘梅",
      "zh": "有人来敲门。",
      "pinyin": "Yǒu rén lái qiāo mén.",
      "tr": "Birisi kapıyı çalıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_003",
      "speaker": "邻居",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_005",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_006",
      "speaker": "张伟",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhè shì wǒ men de lín jū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_007",
      "speaker": "邻居",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_008",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_009",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_010",
      "speaker": "张伟",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_011",
      "speaker": "邻居",
      "zh": "对，这是门。",
      "pinyin": "Duì, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_012",
      "speaker": "张乐乐",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎ ér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_013",
      "speaker": "刘梅",
      "zh": "门在这里。",
      "pinyin": "Mén zài zhè lǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_014",
      "speaker": "张伟",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒ men de jiā rén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_015",
      "speaker": "邻居",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_016",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_017",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_018",
      "speaker": "张伟",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎ ér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_019",
      "speaker": "邻居",
      "zh": "家在那边。",
      "pinyin": "Jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_020",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_021",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_022",
      "speaker": "张伟",
      "zh": "我们不认识这个邻居。",
      "pinyin": "Wǒ men bù rèn shí zhè gè lín jū.",
      "tr": "Bu komşuyu tanımıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_023",
      "speaker": "邻居",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_024",
      "speaker": "张乐乐",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_026",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_027",
      "speaker": "邻居",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_028",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_029",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_030",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_031",
      "speaker": "邻居",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míng zì shì shén me?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_032",
      "speaker": "张乐乐",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míng zì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_033",
      "speaker": "刘梅",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_034",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_035",
      "speaker": "邻居",
      "zh": "你要茶吗？",
      "pinyin": "Nǐ yào chá ma?",
      "tr": "Çay ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_036",
      "speaker": "张乐乐",
      "zh": "我要茶，谢谢。",
      "pinyin": "Wǒ yào chá, xiè xiè.",
      "tr": "Çay istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_037",
      "speaker": "刘梅",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_038",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_039",
      "speaker": "邻居",
      "zh": "这是我们的人。",
      "pinyin": "Zhè shì wǒ men de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_040",
      "speaker": "张乐乐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_041",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_042",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Ń, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_043",
      "speaker": "邻居",
      "zh": "大家互相介绍了。",
      "pinyin": "Dà jiā hù xiāng jiè shào le.",
      "tr": "Herkes birbirine kendini tanıttı."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC014_045",
      "speaker": "刘梅",
      "zh": "真谢谢你。",
      "pinyin": "Zhēn xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_046",
      "speaker": "张伟",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_047",
      "speaker": "邻居",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC014_048",
      "speaker": "张乐乐",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
