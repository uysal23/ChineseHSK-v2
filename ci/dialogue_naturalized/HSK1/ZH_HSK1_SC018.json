{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC018",
  "level": "HSK1",
  "sourceTitleZh": "钱够不够？",
  "sourceTitleTr": "Kasada Para Yetiyor mu?",
  "sourceMiniAdventureTr": "Kasada ödeme sırasında Zhang bozuk para ve toplam tutarı kontrol eder.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC018_001",
      "speaker": "张伟",
      "zh": "我们在超市付款。",
      "pinyin": "Wǒ men zài chāo shì fù kuǎn.",
      "tr": "Süpermarkette ödeme yapıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_003",
      "speaker": "收银员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_004",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_006",
      "speaker": "刘梅",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_007",
      "speaker": "收银员",
      "zh": "对，这是钱。",
      "pinyin": "Duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_008",
      "speaker": "张乐乐",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎ ér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_009",
      "speaker": "张伟",
      "zh": "钱在这里。",
      "pinyin": "Qián zài zhè lǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_010",
      "speaker": "刘梅",
      "zh": "这是元吗？",
      "pinyin": "Zhè shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_011",
      "speaker": "收银员",
      "zh": "对，这是元。",
      "pinyin": "Duì, zhè shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_012",
      "speaker": "张乐乐",
      "zh": "元在哪儿？",
      "pinyin": "Yuán zài nǎ ér?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_013",
      "speaker": "张伟",
      "zh": "元在这里。",
      "pinyin": "Yuán zài zhè lǐ.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_014",
      "speaker": "刘梅",
      "zh": "超市在哪儿？",
      "pinyin": "Chāo shì zài nǎ ér?",
      "tr": "Süpermarket nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_015",
      "speaker": "收银员",
      "zh": "超市在那边。",
      "pinyin": "Chāo shì zài nà biān.",
      "tr": "Süpermarket şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_016",
      "speaker": "张乐乐",
      "zh": "明白了。",
      "pinyin": "Míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_018",
      "speaker": "刘梅",
      "zh": "现在付款吗？",
      "pinyin": "Xiàn zài fù kuǎn ma?",
      "tr": "Şimdi ödeme yapıyor muyuz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_019",
      "speaker": "收银员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_020",
      "speaker": "张乐乐",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_021",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_022",
      "speaker": "刘梅",
      "zh": "张伟在找零钱。",
      "pinyin": "Zhāng wěi zài zhǎo líng qián.",
      "tr": "Zhang Wei bozuk para arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_023",
      "speaker": "收银员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_024",
      "speaker": "张乐乐",
      "zh": "我看看。",
      "pinyin": "Wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_027",
      "speaker": "收银员",
      "zh": "这是包吗？",
      "pinyin": "Zhè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_028",
      "speaker": "张乐乐",
      "zh": "对，这是包。",
      "pinyin": "Duì, zhè shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_029",
      "speaker": "张伟",
      "zh": "包在哪儿？",
      "pinyin": "Bāo zài nǎ ér?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_030",
      "speaker": "刘梅",
      "zh": "包在这里。",
      "pinyin": "Bāo zài zhè lǐ.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_031",
      "speaker": "收银员",
      "zh": "你要苹果吗？",
      "pinyin": "Nǐ yào píng guǒ ma?",
      "tr": "Elma ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_032",
      "speaker": "张乐乐",
      "zh": "我要苹果，谢谢。",
      "pinyin": "Wǒ yào píng guǒ, xiè xiè.",
      "tr": "Elma istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_033",
      "speaker": "张伟",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_034",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_035",
      "speaker": "收银员",
      "zh": "你要牛奶吗？",
      "pinyin": "Nǐ yào niú nǎi ma?",
      "tr": "Süt ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_036",
      "speaker": "张乐乐",
      "zh": "我要牛奶，谢谢。",
      "pinyin": "Wǒ yào niú nǎi, xiè xiè.",
      "tr": "Süt istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_037",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_038",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_039",
      "speaker": "收银员",
      "zh": "你要面包吗？",
      "pinyin": "Nǐ yào miàn bāo ma?",
      "tr": "Ekmek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_040",
      "speaker": "张乐乐",
      "zh": "我要面包，谢谢。",
      "pinyin": "Wǒ yào miàn bāo, xiè xiè.",
      "tr": "Ekmek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_041",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_042",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_043",
      "speaker": "收银员",
      "zh": "钱够了，我们可以回家。",
      "pinyin": "Qián gòu le, wǒ men kě yǐ huí jiā.",
      "tr": "Para yeterli, eve dönebiliriz."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_044",
      "speaker": "张乐乐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC018_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC018_047",
      "speaker": "收银员",
      "zh": "好，这下行了。",
      "pinyin": "Hǎo, zhè xià xíng le.",
      "tr": "Şimdi tamam."
    },
