{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC033",
  "level": "HSK1",
  "sourceTitleZh": "午饭点什么？",
  "sourceTitleTr": "Öğle Yemeği Siparişi",
  "sourceMiniAdventureTr": "Zhang menüde ne seçeceğine karar veremez ve arkadaşından yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC033_001",
      "speaker": "张伟",
      "zh": "大家一起去吃午饭。",
      "pinyin": "Dà jiā yī qǐ qù chī wǔ fàn.",
      "tr": "Herkes birlikte öğle yemeğine gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_003",
      "speaker": "服务员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_004",
      "speaker": "同事",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔn bèi dé zěn me yàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_006",
      "speaker": "同事",
      "zh": "这是菜单吗？",
      "pinyin": "Zhè shì cài dān ma?",
      "tr": "Bu, menü mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_007",
      "speaker": "服务员",
      "zh": "对，这是菜单。",
      "pinyin": "Duì, zhè shì cài dān.",
      "tr": "Evet, bu menü."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_008",
      "speaker": "同事",
      "zh": "菜单在哪儿？",
      "pinyin": "Cài dān zài nǎ ér?",
      "tr": "Menü nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_009",
      "speaker": "张伟",
      "zh": "菜单在这里。",
      "pinyin": "Cài dān zài zhè lǐ.",
      "tr": "Menü burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_010",
      "speaker": "同事",
      "zh": "你要午饭吗？",
      "pinyin": "Nǐ yào wǔ fàn ma?",
      "tr": "Öğle yemeği ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_011",
      "speaker": "服务员",
      "zh": "我要午饭，谢谢。",
      "pinyin": "Wǒ yào wǔ fàn, xiè xiè.",
      "tr": "Öğle yemeği istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_012",
      "speaker": "同事",
      "zh": "嗯，好。",
      "pinyin": "Ń, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_014",
      "speaker": "同事",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_015",
      "speaker": "服务员",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xiè xiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_016",
      "speaker": "同事",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_018",
      "speaker": "同事",
      "zh": "你要米饭吗？",
      "pinyin": "Nǐ yào mǐ fàn ma?",
      "tr": "Pirinç / pilav ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_019",
      "speaker": "服务员",
      "zh": "我要米饭，谢谢。",
      "pinyin": "Wǒ yào mǐ fàn, xiè xiè.",
      "tr": "Pirinç / pilav istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_020",
