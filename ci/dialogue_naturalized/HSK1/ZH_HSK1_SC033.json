{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC033",
  "level": "HSK1",
  "sourceTitleZh": "午饭点什么？",
  "sourceTitleTr": "Öğle Yemeği Siparişi",
  "sourceMiniAdventureTr": "Zhang menüde ne seçeceğine karar veremez ve arkadaşından yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC033_001",
      "speaker": "张伟",
      "zh": "大家一起去吃午饭。",
      "pinyin": "Dàjiā yìqǐ qù chī wǔfàn.",
      "tr": "Herkes birlikte öğle yemeğine gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_003",
      "speaker": "服务员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_004",
      "speaker": "同事",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_006",
      "speaker": "同事",
      "zh": "这是菜单吗？",
      "pinyin": "Zhè shì càidān ma?",
      "tr": "Bu, menü mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_007",
      "speaker": "服务员",
      "zh": "没错，是菜单。",
      "pinyin": "Méicuò, shì càidān.",
      "tr": "Evet, bu menü."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_008",
      "speaker": "同事",
      "zh": "菜单在哪儿？",
      "pinyin": "Càidān zài nǎr?",
      "tr": "Menü nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_009",
      "speaker": "张伟",
      "zh": "你看，菜单在这儿。",
      "pinyin": "Nǐ kàn, càidān zài zhèér.",
      "tr": "Menü burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_010",
      "speaker": "同事",
      "zh": "你想要午饭吗？",
      "pinyin": "Nǐ xiǎngyào wǔfàn ma?",
      "tr": "Öğle yemeği ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_011",
      "speaker": "服务员",
      "zh": "我要午饭，谢谢。",
      "pinyin": "Wǒ yào wǔfàn, xièxie.",
      "tr": "Öğle yemeği istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_012",
      "speaker": "同事",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_013",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_014",
      "speaker": "同事",
      "zh": "你想要饭吗？",
      "pinyin": "Nǐ xiǎngyào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_015",
      "speaker": "服务员",
      "zh": "那我要饭吧，谢谢。",
      "pinyin": "Nà wǒ yàofàn ba, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_016",
      "speaker": "同事",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_018",
      "speaker": "同事",
      "zh": "要不要米饭？",
      "pinyin": "Yào búyào mǐfàn?",
      "tr": "Pirinç / pilav ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_019",
      "speaker": "服务员",
      "zh": "好，我要米饭，谢谢。",
      "pinyin": "Hǎo, wǒ yào mǐfàn, xièxiè.",
      "tr": "Pirinç / pilav istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_020",
      "speaker": "同事",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_022",
      "speaker": "同事",
      "zh": "张伟看不懂一个菜名。",
      "pinyin": "Zhāng Wěi kàn bù dǒng yí ge càimíng.",
      "tr": "Zhang Wei bir yemek adını anlamıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_023",
      "speaker": "服务员",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_024",
      "speaker": "同事",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_026",
      "speaker": "同事",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_027",
      "speaker": "服务员",
      "zh": "要不要面条？",
      "pinyin": "Yào búyào miàntiáo?",
      "tr": "Erişte / noodle ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_028",
      "speaker": "同事",
      "zh": "那我要面条吧，谢谢。",
      "pinyin": "Nà wǒ yào miàntiáo ba, xièxiè.",
      "tr": "Erişte / noodle istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_029",
