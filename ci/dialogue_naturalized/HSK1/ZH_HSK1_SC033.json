{
  "naturalizationVersion": 3,
  "sceneId": "ZH_HSK1_SC033",
  "level": "HSK1",
  "sourceTitleZh": "午饭点什么？",
  "sourceTitleTr": "Öğle Yemeği Siparişi",
  "sourceMiniAdventureTr": "Zhang menüde ne seçeceğine karar veremez ve arkadaşından yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC033_001",
      "speaker": "张伟",
      "zh": "大家一起去吃午饭。",
      "pinyin": "Dàjiā yìqǐ qù chī wǔfàn.",
      "tr": "Herkes birlikte öğle yemeğine gidiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_003",
      "speaker": "服务员",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_004",
      "speaker": "同事",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_006",
      "speaker": "同事",
      "zh": "这是菜单，对吗？",
      "pinyin": "Zhè shì cài dān, duì ma?",
      "tr": "Bu, menü mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_007",
      "speaker": "服务员",
      "zh": "没错，是菜单。",
      "pinyin": "Méi cuò, shì cài dān.",
      "tr": "Evet, bu menü."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_008",
      "speaker": "同事",
      "zh": "菜单呢？",
      "pinyin": "Cài dān ne?",
      "tr": "Menü nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_009",
      "speaker": "张伟",
      "zh": "菜单在这儿。",
      "pinyin": "Cài dān zài zhèr.",
      "tr": "Menü burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_010",
      "speaker": "同事",
      "zh": "你要午饭吗？",
      "pinyin": "Nǐ yào wǔfàn ma?",
      "tr": "Öğle yemeği ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_011",
      "speaker": "服务员",
      "zh": "我要午饭，谢谢。",
      "pinyin": "Wǒ yào wǔfàn, xièxie.",
      "tr": "Öğle yemeği istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_012",
      "speaker": "同事",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_014",
      "speaker": "同事",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC033_015",
      "speaker": "服务员",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xièxie.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_016",
      "speaker": "同事",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_017",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
