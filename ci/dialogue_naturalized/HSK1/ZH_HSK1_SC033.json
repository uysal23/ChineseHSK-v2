      "zh": "嗯，好。",
      "pinyin": "Ń, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_021",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_022",
      "speaker": "同事",
      "zh": "张伟看不懂一个菜名。",
      "pinyin": "Zhāng wěi kàn bù dǒng yī gè cài míng.",
      "tr": "Zhang Wei bir yemek adını anlamıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_023",
      "speaker": "服务员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_024",
      "speaker": "同事",
      "zh": "我来看看吧。",
      "pinyin": "Wǒ lái kàn kàn ba.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_025",
      "speaker": "张伟",
      "zh": "那一起吧。",
      "pinyin": "Nà yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC033_026",
      "speaker": "同事",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
