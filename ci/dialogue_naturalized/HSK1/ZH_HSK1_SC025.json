{
  "naturalizationVersion": 4,
  "sceneId": "ZH_HSK1_SC025",
  "level": "HSK1",
  "sourceTitleZh": "丢失的铅笔",
  "sourceTitleTr": "Kaybolan Kalem",
  "sourceMiniAdventureTr": "Lele mavi kaleminin başka bir öğrencide olduğunu sanır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC025_001",
      "speaker": "张乐乐",
      "zh": "乐乐在找蓝色铅笔。",
      "pinyin": "Lèlè zài zhǎo lánsè qiānbǐ.",
      "tr": "Lele mavi kalemini arıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_002",
      "speaker": "同学",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_003",
      "speaker": "老师",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_004",
      "speaker": "刘梅",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_006",
      "speaker": "同学",
      "zh": "这是铅笔，对吗？",
      "pinyin": "Zhè shì qiān bǐ, duì ma?",
      "tr": "Bu, kurşun kalem mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_007",
      "speaker": "老师",
      "zh": "没错，是铅笔。",
      "pinyin": "Méi cuò, shì qiān bǐ.",
      "tr": "Evet, bu kurşun kalem."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_008",
      "speaker": "刘梅",
      "zh": "铅笔呢？",
      "pinyin": "Qiān bǐ ne?",
      "tr": "Kurşun kalem nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_009",
      "speaker": "张乐乐",
      "zh": "铅笔在这儿。",
      "pinyin": "Qiān bǐ zài zhèr.",
      "tr": "Kurşun kalem burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_010",
      "speaker": "同学",
      "zh": "你喜欢蓝色吗？",
      "pinyin": "Nǐ xǐhuan lánsè ma?",
      "tr": "Mavi renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_011",
      "speaker": "老师",
      "zh": "喜欢。",
      "pinyin": "Xǐhuan.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_012",
      "speaker": "刘梅",
      "zh": "这个是蓝色的。",
      "pinyin": "Zhège shì lánsè de.",
      "tr": "Bu mavi renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_013",
      "speaker": "张乐乐",
      "zh": "很好看。",
      "pinyin": "Hěn hǎokàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_014",
      "speaker": "同学",
      "zh": "你喜欢红色吗？",
      "pinyin": "Nǐ xǐhuan hóngsè ma?",
      "tr": "Kırmızı renk seviyor musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_015",
      "speaker": "老师",
      "zh": "喜欢。",
      "pinyin": "Xǐhuan.",
      "tr": "Seviyorum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_016",
      "speaker": "刘梅",
      "zh": "这个是红色的。",
      "pinyin": "Zhège shì hóngsè de.",
      "tr": "Bu kırmızı renk."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_017",
      "speaker": "张乐乐",
      "zh": "很好看。",
      "pinyin": "Hěn hǎokàn.",
      "tr": "Çok güzel görünüyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_018",
      "speaker": "同学",
      "zh": "这是我们的学生。",
      "pinyin": "Zhè shì wǒmen de xuésheng.",
      "tr": "Bu bizim öğrenci."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_019",
      "speaker": "老师",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_020",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_021",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_022",
      "speaker": "同学",
      "zh": "他以为同学拿了他的铅笔。",
      "pinyin": "Tā yǐwéi tóngxué ná le tā de qiānbǐ.",
      "tr": "Sınıf arkadaşının kalemini aldığını sanıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_023",
      "speaker": "老师",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_024",
      "speaker": "刘梅",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_026",
      "speaker": "同学",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_027",
      "speaker": "老师",
      "zh": "这是我们的老师。",
      "pinyin": "Zhè shì wǒmen de lǎoshī.",
      "tr": "Bu bizim öğretmen."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_028",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_029",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_030",
      "speaker": "同学",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_031",
      "speaker": "老师",
      "zh": "教室在哪儿？",
      "pinyin": "Jiàoshì zài nǎr?",
      "tr": "Sınıf nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_032",
      "speaker": "刘梅",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Sınıf şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_033",
      "speaker": "张乐乐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_034",
      "speaker": "同学",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_035",
      "speaker": "老师",
      "zh": "这是书，对吗？",
      "pinyin": "Zhè shì shū, duì ma?",
      "tr": "Bu, kitap mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_036",
      "speaker": "刘梅",
      "zh": "对，就是书。",
      "pinyin": "Duì, jiù shì shū.",
      "tr": "Evet, bu kitap."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_037",
      "speaker": "张乐乐",
      "zh": "书呢？",
      "pinyin": "Shū ne?",
      "tr": "Kitap nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_038",
      "speaker": "同学",
      "zh": "书在这儿。",
      "pinyin": "Shū zài zhèr.",
      "tr": "Kitap burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_039",
      "speaker": "老师",
      "zh": "这是包吗？",
      "pinyin": "Zhè shì bāo ma?",
      "tr": "Bu, çanta mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_040",
      "speaker": "刘梅",
      "zh": "没错，是包。",
      "pinyin": "Méi cuò, shì bāo.",
      "tr": "Evet, bu çanta."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_041",
      "speaker": "张乐乐",
      "zh": "包呢？",
      "pinyin": "Bāo ne?",
      "tr": "Çanta nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_042",
      "speaker": "同学",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Çanta burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_043",
      "speaker": "老师",
      "zh": "原来铅笔在自己的书包里。",
      "pinyin": "Yuánlái qiānbǐ zài zìjǐ de shūbāo lǐ.",
      "tr": "Meğer kalem kendi çantasındaymış."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_044",
      "speaker": "刘梅",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_046",
      "speaker": "同学",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bú kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_047",
      "speaker": "老师",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_048",
      "speaker": "刘梅",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC025_049",
      "speaker": "张乐乐",
      "zh": "这是铅笔吗？",
      "pinyin": "Zhè shì qiānbǐ ma?",
      "tr": "Bu, kurşun kalem mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC025_050",
      "speaker": "同学",
      "zh": "嗯，对，这是铅笔。",
      "pinyin": "Èn, duì, zhè shì qiān bǐ.",
      "tr": "Evet, bu kurşun kalem."
    },
