{
  "naturalizationVersion": 4,
  "sceneId": "ZH_HSK1_SC029",
  "level": "HSK1",
  "sourceTitleZh": "工作面试",
  "sourceTitleTr": "İş Görüşmesi",
  "sourceMiniAdventureTr": "Zhang kendini ve temel becerilerini iş görüşmesinde tanıtır.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC029_001",
      "speaker": "张伟",
      "zh": "张伟来参加工作面试。",
      "pinyin": "Zhāng Wěi lái cānjiā gōngzuò miànshì.",
      "tr": "Zhang Wei iş görüşmesine geliyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_002",
      "speaker": "经理",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_003",
      "speaker": "公司职员",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_004",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_006",
      "speaker": "经理",
      "zh": "今天有面试吗？",
      "pinyin": "Jīntiān yǒu miànshì ma?",
      "tr": "Bugün iş görüşmesi var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_007",
      "speaker": "公司职员",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_008",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_010",
      "speaker": "经理",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_011",
      "speaker": "公司职员",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_012",
      "speaker": "张伟",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_013",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_014",
      "speaker": "经理",
      "zh": "这是我们的经理。",
      "pinyin": "Zhè shì wǒmen de jīnglǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_015",
      "speaker": "公司职员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_016",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_017",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_018",
      "speaker": "经理",
      "zh": "办公室在哪儿？",
      "pinyin": "Bàngōngshì zài nǎr?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_019",
      "speaker": "公司职员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nà biān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_020",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_021",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_022",
      "speaker": "经理",
      "zh": "他要介绍自己会做什么。",
      "pinyin": "Tā yào jièshào zìjǐ huì zuò shénme.",
      "tr": "Neler yapabildiğini anlatması gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_023",
      "speaker": "公司职员",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_024",
      "speaker": "张伟",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_026",
      "speaker": "经理",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_027",
      "speaker": "公司职员",
      "zh": "这个是电脑吗？",
      "pinyin": "Zhè ge shì diàn nǎo ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_028",
      "speaker": "张伟",
      "zh": "嗯，对，这是电脑。",
      "pinyin": "Èn, duì, zhè shì diàn nǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_029",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diànnǎo zài nǎr?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_030",
      "speaker": "经理",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhè lǐ.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_031",
      "speaker": "公司职员",
      "zh": "这是卡吗？",
      "pinyin": "Zhè shì kǎ ma?",
      "tr": "Bu, kart mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_032",
      "speaker": "张伟",
      "zh": "嗯，对，这是卡。",
      "pinyin": "Èn, duì, zhè shì kǎ.",
      "tr": "Evet, bu kart."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_033",
      "speaker": "张伟",
      "zh": "卡在哪儿？",
      "pinyin": "Kǎ zài nǎr?",
      "tr": "Kart nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_034",
      "speaker": "经理",
      "zh": "你看，卡在这儿。",
      "pinyin": "Nǐ kàn, kǎ zài zhèr.",
      "tr": "Kart burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_035",
      "speaker": "公司职员",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzi shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_036",
      "speaker": "张伟",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzi.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_037",
      "speaker": "张伟",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_038",
      "speaker": "经理",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_039",
      "speaker": "公司职员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_040",
      "speaker": "张伟",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_042",
      "speaker": "经理",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_043",
      "speaker": "公司职员",
      "zh": "经理对他的回答很满意。",
      "pinyin": "Jīnglǐ duì tā de huídá hěn mǎnyì.",
      "tr": "Müdür cevaplarından memnun."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_044",
      "speaker": "张伟",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC029_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_046",
      "speaker": "经理",
      "zh": "不客气。",
      "pinyin": "Bú kèqi.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_047",
      "speaker": "公司职员",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_048",
      "speaker": "张伟",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jì xù.",
      "tr": "Devam edelim."
    },
