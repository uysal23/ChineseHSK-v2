{
  "naturalizationVersion": 6,
  "sceneId": "ZH_HSK1_SC012",
  "level": "HSK1",
  "sourceTitleZh": "新家的第一个晚上",
  "sourceTitleTr": "İlk Gece",
  "sourceMiniAdventureTr": "İlk akşam yataklar hazırlanırken Mimi ortadan kaybolur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC012_001",
      "speaker": "刘梅",
      "zh": "这是我们在新家的第一个晚上。",
      "pinyin": "Zhè shì wǒmen zài xīn jiā de dì yí ge wǎnshang.",
      "tr": "Bu yeni evdeki ilk akşamımız."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_003",
      "speaker": "张乐乐",
      "zh": "嗯，对。",
      "pinyin": "Èn, duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_006",
      "speaker": "张伟",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_007",
      "speaker": "张乐乐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nà biān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_008",
      "speaker": "张雨桐",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_010",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_011",
      "speaker": "张乐乐",
      "zh": "对，就是猫。",
      "pinyin": "Duì, jiù shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_012",
      "speaker": "张雨桐",
      "zh": "猫呢？",
      "pinyin": "Māo ne?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_013",
      "speaker": "刘梅",
      "zh": "你看，猫在这儿。",
      "pinyin": "Nǐ kàn, māo zài zhèr.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_014",
      "speaker": "张伟",
      "zh": "房间呢？",
      "pinyin": "Fáng jiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_015",
      "speaker": "张乐乐",
      "zh": "你看，房间在那边。",
      "pinyin": "Nǐ kàn, fáng jiān zài nà biān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_016",
      "speaker": "张雨桐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_017",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_018",
      "speaker": "张伟",
      "zh": "这是桌子，对吗？",
      "pinyin": "Zhè shì zhuō zi, duì ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_019",
      "speaker": "张乐乐",
      "zh": "没错，是桌子。",
      "pinyin": "Méi cuò, shì zhuō zi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_020",
      "speaker": "张雨桐",
      "zh": "桌子在哪儿？",
      "pinyin": "Zhuōzi zài nǎr?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_021",
      "speaker": "刘梅",
      "zh": "桌子在这儿。",
      "pinyin": "Zhuō zi zài zhèr.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_022",
      "speaker": "张伟",
      "zh": "咪咪不见了。",
      "pinyin": "Mīmī bú jiàn le.",
      "tr": "Mimi ortada yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_023",
      "speaker": "张乐乐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_026",
      "speaker": "张伟",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_027",
      "speaker": "张乐乐",
      "zh": "这是椅子，对吗？",
      "pinyin": "Zhè shì yǐ zi, duì ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_028",
      "speaker": "张雨桐",
      "zh": "没错，是椅子。",
      "pinyin": "Méi cuò, shì yǐ zi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_029",
      "speaker": "刘梅",
      "zh": "椅子在哪儿？",
      "pinyin": "Yǐzi zài nǎr?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_030",
      "speaker": "张伟",
      "zh": "你看，椅子在这儿。",
      "pinyin": "Nǐ kàn, yǐ zi zài zhèr.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_031",
      "speaker": "张乐乐",
      "zh": "这是门，对吗？",
      "pinyin": "Zhè shì mén, duì ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_032",
      "speaker": "张雨桐",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiù shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_033",
      "speaker": "刘梅",
      "zh": "那门在哪儿？",
      "pinyin": "Nà mén zài nǎr?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_034",
      "speaker": "张伟",
      "zh": "你看，门在这儿。",
      "pinyin": "Nǐ kàn, mén zài zhèr.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_035",
      "speaker": "张乐乐",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎnshang yǒu shíjiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_036",
      "speaker": "张雨桐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_037",
      "speaker": "刘梅",
      "zh": "晚上见。",
      "pinyin": "Wǎnshang jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_038",
      "speaker": "张伟",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_039",
      "speaker": "张乐乐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_040",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_041",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_042",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_043",
      "speaker": "张乐乐",
      "zh": "我们一起找咪咪。",
      "pinyin": "Wǒmen yìqǐ zhǎo Mīmī.",
      "tr": "Mimi’yi birlikte arıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_044",
      "speaker": "张雨桐",
      "zh": "太棒了！",
      "pinyin": "Tài bàng le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_045",
      "speaker": "刘梅",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_046",
      "speaker": "张伟",
      "zh": "别客气。",
      "pinyin": "Bié kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_047",
      "speaker": "张乐乐",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_048",
      "speaker": "张雨桐",
      "zh": "那我们继续吧。",
      "pinyin": "Nà wǒ men jì xù ba.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_049",
      "speaker": "刘梅",
      "zh": "家呢？",
