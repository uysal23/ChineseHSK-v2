{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC012",
  "level": "HSK1",
  "sourceTitleZh": "新家的第一个晚上",
  "sourceTitleTr": "İlk Gece",
  "sourceMiniAdventureTr": "İlk akşam yataklar hazırlanırken Mimi ortadan kaybolur.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC012_001",
      "speaker": "刘梅",
      "zh": "这是我们在新家的第一个晚上。",
      "pinyin": "Zhè shì wǒmen zài xīn jiā de dì yí ge wǎnshang.",
      "tr": "Bu yeni evdeki ilk akşamımız."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_003",
      "speaker": "张乐乐",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_004",
      "speaker": "张雨桐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_005",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_006",
      "speaker": "张伟",
      "zh": "家呢？",
      "pinyin": "Jiā ne?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_007",
      "speaker": "张乐乐",
      "zh": "你看，家在那边。",
      "pinyin": "Nǐ kàn, jiā zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_008",
      "speaker": "张雨桐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_009",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_010",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_011",
      "speaker": "张乐乐",
      "zh": "没错，是猫。",
      "pinyin": "Méicuò, shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_012",
      "speaker": "张雨桐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_013",
      "speaker": "刘梅",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_014",
      "speaker": "张伟",
      "zh": "房间呢？",
      "pinyin": "Fángjiān ne?",
      "tr": "Oda nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_015",
      "speaker": "张乐乐",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Oda şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_016",
      "speaker": "张雨桐",
      "zh": "好，明白了。",
      "pinyin": "Hǎo, míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_017",
      "speaker": "刘梅",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_018",
      "speaker": "张伟",
      "zh": "这是桌子吗？",
      "pinyin": "Zhè shì zhuōzi ma?",
      "tr": "Bu, masa mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_019",
      "speaker": "张乐乐",
      "zh": "嗯，对，这是桌子。",
      "pinyin": "Èn, duì, zhè shì zhuōzi.",
      "tr": "Evet, bu masa."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_020",
      "speaker": "张雨桐",
      "zh": "那桌子放在哪儿？",
      "pinyin": "Nà zhuōzi fàngzài nǎér?",
      "tr": "Masa nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_021",
      "speaker": "刘梅",
      "zh": "桌子在这儿。",
      "pinyin": "Zhuōzi zài zhèér.",
      "tr": "Masa burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_022",
      "speaker": "张伟",
      "zh": "咪咪不见了。",
      "pinyin": "Mīmī bú jiàn le.",
      "tr": "Mimi ortada yok."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_023",
      "speaker": "张乐乐",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_024",
      "speaker": "张雨桐",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_025",
      "speaker": "刘梅",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_026",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_027",
      "speaker": "张乐乐",
      "zh": "这是椅子吗？",
      "pinyin": "Zhè shì yǐzi ma?",
      "tr": "Bu, sandalye mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_028",
      "speaker": "张雨桐",
      "zh": "对，就是椅子。",
      "pinyin": "Duì, jiùshì yǐzi.",
      "tr": "Evet, bu sandalye."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_029",
      "speaker": "刘梅",
      "zh": "那椅子放在哪儿？",
      "pinyin": "Nà yǐzi fàngzài nǎér?",
      "tr": "Sandalye nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_030",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Sandalye burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_031",
      "speaker": "张乐乐",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_032",
      "speaker": "张雨桐",
      "zh": "对，就是门。",
      "pinyin": "Duì, jiùshì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_033",
      "speaker": "刘梅",
      "zh": "门在哪儿？",
      "pinyin": "Mén zài nǎr?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_034",
      "speaker": "张伟",
      "zh": "门在这儿。",
      "pinyin": "Mén zài zhèér.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_035",
      "speaker": "张乐乐",
      "zh": "晚上有时间吗？",
      "pinyin": "Wǎnshang yǒu shíjiān ma?",
      "tr": "Akşam vaktin var mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_036",
      "speaker": "张雨桐",
      "zh": "有。",
      "pinyin": "Yǒu.",
      "tr": "Var."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_037",
      "speaker": "刘梅",
      "zh": "晚上见。",
      "pinyin": "Wǎnshang jiàn.",
      "tr": "Akşam görüşürüz."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_038",
      "speaker": "张伟",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_039",
      "speaker": "张乐乐",
      "zh": "这是我们的家人。",
      "pinyin": "Zhè shì wǒmen de jiārén.",
      "tr": "Bu bizim aile."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_040",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_041",
      "speaker": "刘梅",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_042",
      "speaker": "张伟",
      "zh": "嗯，我也是。",
      "pinyin": "Èn, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_043",
      "speaker": "张乐乐",
      "zh": "我们一起找咪咪。",
      "pinyin": "Wǒmen yìqǐ zhǎo Mīmī.",
      "tr": "Mimi’yi birlikte arıyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_044",
      "speaker": "张雨桐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_045",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_046",
      "speaker": "张伟",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_047",
      "speaker": "张乐乐",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_048",
      "speaker": "张雨桐",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒmen jiēzhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC012_049",
      "speaker": "刘梅",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎr?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC012_050",
