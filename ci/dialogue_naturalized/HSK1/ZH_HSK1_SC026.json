{
  "naturalizationVersion": 7,
  "sceneId": "ZH_HSK1_SC026",
  "level": "HSK1",
  "sourceTitleZh": "张伟找工作",
  "sourceTitleTr": "Zhang İş Arıyor",
  "sourceMiniAdventureTr": "Zhang yerel ilanlara bakar ve Li Chen’den yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC026_001",
      "speaker": "张伟",
      "zh": "张伟开始找工作。",
      "pinyin": "Zhāng Wěi kāishǐ zhǎo gōngzuò.",
      "tr": "Zhang Wei iş aramaya başlıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_002",
      "speaker": "李晨",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_003",
      "speaker": "刘梅",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_006",
      "speaker": "李晨",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_007",
      "speaker": "刘梅",
      "zh": "没错。",
      "pinyin": "Méi cuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_008",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_010",
      "speaker": "李晨",
      "zh": "这是电话，对吗？",
      "pinyin": "Zhè shì diàn huà, duì ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_011",
      "speaker": "刘梅",
      "zh": "没错，是电话。",
      "pinyin": "Méi cuò, shì diàn huà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_012",
      "speaker": "张雨桐",
      "zh": "电话呢？",
      "pinyin": "Diàn huà ne?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_013",
      "speaker": "张伟",
      "zh": "你看，电话在这儿。",
      "pinyin": "Nǐ kàn, diàn huà zài zhèr.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_014",
      "speaker": "李晨",
      "zh": "你的电话号码是什么？",
      "pinyin": "Nǐ de diànhuà hàomǎ shì shénme?",
      "tr": "Telefon numarası nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_015",
      "speaker": "刘梅",
      "zh": "这是我的电话号码。",
      "pinyin": "Zhè shì wǒ de diànhuà hàomǎ.",
      "tr": "Bu benim telefon numarası."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_016",
      "speaker": "张雨桐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_017",
      "speaker": "张伟",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_018",
      "speaker": "李晨",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_019",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_020",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_021",
      "speaker": "张伟",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_022",
      "speaker": "李晨",
      "zh": "他还不知道给谁打电话。",
      "pinyin": "Tā hái bù zhīdào gěi shéi dǎ diànhuà.",
      "tr": "Kimi arayacağını henüz bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_024",
      "speaker": "张雨桐",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_026",
      "speaker": "李晨",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_027",
      "speaker": "刘梅",
      "zh": "办公室呢？",
      "pinyin": "Bàn gōng shì ne?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_028",
      "speaker": "张雨桐",
      "zh": "办公室在那边。",
      "pinyin": "Bàngōngshì zài nàbian.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_029",
      "speaker": "张伟",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_030",
      "speaker": "李晨",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_031",
      "speaker": "刘梅",
      "zh": "这是我们的经理。",
      "pinyin": "Zhè shì wǒmen de jīnglǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_032",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
