{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC026",
  "level": "HSK1",
  "sourceTitleZh": "张伟找工作",
  "sourceTitleTr": "Zhang İş Arıyor",
  "sourceMiniAdventureTr": "Zhang yerel ilanlara bakar ve Li Chen’den yardım ister.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC026_001",
      "speaker": "张伟",
      "zh": "张伟开始找工作。",
      "pinyin": "Zhāng wěi kāi shǐ zhǎo gōng zuò.",
      "tr": "Zhang Wei iş aramaya başlıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_002",
      "speaker": "李晨",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_003",
      "speaker": "刘梅",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_004",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "Ń, zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_006",
      "speaker": "李晨",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōng zuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_007",
      "speaker": "刘梅",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_008",
      "speaker": "张雨桐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_009",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_010",
      "speaker": "李晨",
      "zh": "这是电话吗？",
      "pinyin": "Zhè shì diàn huà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_011",
      "speaker": "刘梅",
      "zh": "对，这是电话。",
      "pinyin": "Duì, zhè shì diàn huà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_012",
      "speaker": "张雨桐",
      "zh": "电话在哪儿？",
      "pinyin": "Diàn huà zài nǎ ér?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_013",
      "speaker": "张伟",
      "zh": "电话在这里。",
      "pinyin": "Diàn huà zài zhè lǐ.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_014",
      "speaker": "李晨",
      "zh": "你的电话号码是什么？",
      "pinyin": "Nǐ de diàn huà hào mǎ shì shén me?",
      "tr": "Telefon numarası nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_015",
      "speaker": "刘梅",
      "zh": "这是我的电话号码。",
      "pinyin": "Zhè shì wǒ de diàn huà hào mǎ.",
      "tr": "Bu benim telefon numarası."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_016",
      "speaker": "张雨桐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jì xià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_017",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_018",
      "speaker": "李晨",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_019",
      "speaker": "刘梅",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_020",
      "speaker": "张雨桐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_021",
      "speaker": "张伟",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_022",
      "speaker": "李晨",
      "zh": "他还不知道给谁打电话。",
      "pinyin": "Tā hái bù zhī dào gěi shuí dǎ diàn huà.",
      "tr": "Kimi arayacağını henüz bilmiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_023",
      "speaker": "刘梅",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_024",
      "speaker": "张雨桐",
      "zh": "来，我看看。",
      "pinyin": "Lái, wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_025",
      "speaker": "张伟",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_026",
      "speaker": "李晨",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_027",
      "speaker": "刘梅",
      "zh": "办公室在哪儿？",
      "pinyin": "Bàn gōng shì zài nǎ ér?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_028",
      "speaker": "张雨桐",
      "zh": "办公室在那边。",
      "pinyin": "Bàn gōng shì zài nà biān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_029",
      "speaker": "张伟",
      "zh": "好，我明白了。",
      "pinyin": "Hǎo, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_030",
      "speaker": "李晨",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_031",
      "speaker": "刘梅",
      "zh": "这是我们的经理。",
      "pinyin": "Zhè shì wǒ men de jīng lǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_032",
      "speaker": "张雨桐",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_034",
      "speaker": "李晨",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_035",
      "speaker": "刘梅",
      "zh": "这是电脑吗？",
      "pinyin": "Zhè shì diàn nǎo ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_036",
      "speaker": "张雨桐",
      "zh": "对，这是电脑。",
      "pinyin": "Duì, zhè shì diàn nǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_037",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diàn nǎo zài nǎ ér?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_038",
      "speaker": "李晨",
      "zh": "电脑在这里。",
      "pinyin": "Diàn nǎo zài zhè lǐ.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_039",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_040",
      "speaker": "张雨桐",
      "zh": "嗯，有一点。",
      "pinyin": "Ń, yǒu yī diǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_041",
      "speaker": "张伟",
      "zh": "没关系，别急。",
      "pinyin": "Méi guān xì, bié jí.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_042",
      "speaker": "李晨",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_043",
      "speaker": "刘梅",
      "zh": "李晨给了他一个电话号码。",
      "pinyin": "Lǐ chén gěi le tā yī gè diàn huà hào mǎ.",
      "tr": "Li Chen ona bir telefon numarası veriyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_044",
      "speaker": "张雨桐",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_045",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_046",
      "speaker": "李晨",
      "zh": "不客气。",
      "pinyin": "Bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_047",
      "speaker": "刘梅",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_048",
      "speaker": "张雨桐",
      "zh": "那我们继续。",
      "pinyin": "Nà wǒ men jì xù.",
      "tr": "Devam edelim."
    },
    {
