      "zh": "电脑在这儿。",
      "pinyin": "Diàn nǎo zài zhèr.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_039",
      "speaker": "刘梅",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_040",
      "speaker": "张雨桐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_041",
      "speaker": "张伟",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_042",
      "speaker": "李晨",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_043",
      "speaker": "刘梅",
      "zh": "李晨给了他一个电话号码。",
      "pinyin": "Lǐ Chén gěi le tā yí ge diànhuà hàomǎ.",
      "tr": "Li Chen ona bir telefon numarası veriyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_044",
      "speaker": "张雨桐",
      "zh": "真好！",
      "pinyin": "Zhēn hǎo!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC026_045",
      "speaker": "张伟",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_046",
      "speaker": "李晨",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bú kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_047",
      "speaker": "刘梅",
      "zh": "现在好了。",
      "pinyin": "Xiànzài hǎo le.",
      "tr": "Şimdi tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC026_048",
