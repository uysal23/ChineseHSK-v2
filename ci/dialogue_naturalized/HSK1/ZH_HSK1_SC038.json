{
  "naturalizationVersion": 2,
  "sceneId": "ZH_HSK1_SC038",
  "level": "HSK1",
  "sourceTitleZh": "掉在地上的冰淇淋",
  "sourceTitleTr": "Dondurma Kazası",
  "sourceMiniAdventureTr": "Lele’nin dondurması yere düşer; aile yenisini alıp onu neşelendirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC038_001",
      "speaker": "张乐乐",
      "zh": "乐乐买了一个冰淇淋。",
      "pinyin": "Lèlè mǎi le yí ge bīngqílín.",
      "tr": "Lele bir dondurma aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_003",
      "speaker": "张伟",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_004",
      "speaker": "店员",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_006",
      "speaker": "刘梅",
      "zh": "你要冰淇淋吗？",
      "pinyin": "Nǐ yào bīngqílín ma?",
      "tr": "Dondurma ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_007",
      "speaker": "张伟",
      "zh": "我要冰淇淋，谢谢。",
      "pinyin": "Wǒ yào bīngqílín, xièxie.",
      "tr": "Dondurma istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_008",
      "speaker": "店员",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_009",
      "speaker": "张乐乐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_010",
      "speaker": "刘梅",
      "zh": "那公园在哪儿？",
      "pinyin": "Nà gōngyuán zài nǎér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_011",
      "speaker": "张伟",
      "zh": "你看，公园在那边。",
      "pinyin": "Nǐ kàn, gōngyuán zài nàbiān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_012",
      "speaker": "店员",
      "zh": "嗯，我明白了。",
      "pinyin": "Èn, wǒ míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_013",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xièxiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_014",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_015",
      "speaker": "张伟",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_016",
      "speaker": "店员",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_017",
      "speaker": "张乐乐",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_018",
      "speaker": "刘梅",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_019",
      "speaker": "张伟",
      "zh": "没错，是钱。",
      "pinyin": "Méicuò, shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_020",
      "speaker": "店员",
      "zh": "那钱放在哪儿？",
      "pinyin": "Nà qián fàngzài nǎér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_021",
      "speaker": "张乐乐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_022",
      "speaker": "刘梅",
      "zh": "冰淇淋掉在地上了。",
      "pinyin": "Bīngqílín diào zài dìshang le.",
      "tr": "Dondurma yere düştü."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_023",
      "speaker": "张伟",
      "zh": "别着急。",
      "pinyin": "Biézháojí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_024",
      "speaker": "店员",
      "zh": "我看看。",
      "pinyin": "Wǒ kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_025",
      "speaker": "张乐乐",
      "zh": "好，一起吧。",
      "pinyin": "Hǎo, yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_026",
      "speaker": "刘梅",
      "zh": "嗯，好。",
      "pinyin": "Èn, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_027",
      "speaker": "张伟",
      "zh": "这是元吗？",
      "pinyin": "Zhè shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_028",
      "speaker": "店员",
      "zh": "嗯，对，这是元。",
      "pinyin": "Èn, duì, zhè shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_029",
      "speaker": "张乐乐",
      "zh": "元呢？",
      "pinyin": "Yuán ne?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_030",
      "speaker": "刘梅",
      "zh": "元在这儿。",
      "pinyin": "Yuán zài zhèér.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_031",
      "speaker": "张伟",
      "zh": "你想要饭吗？",
      "pinyin": "Nǐ xiǎngyào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_032",
      "speaker": "店员",
      "zh": "好，我要饭，谢谢。",
      "pinyin": "Hǎo, wǒ yàofàn, xièxiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_033",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_035",
      "speaker": "张伟",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒmen de péngyou.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_036",
      "speaker": "店员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_037",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_038",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_039",
      "speaker": "张伟",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_040",
      "speaker": "店员",
      "zh": "嗯，有一点。",
      "pinyin": "Èn, yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_041",
      "speaker": "张乐乐",
      "zh": "没关系。",
      "pinyin": "Méi guānxi.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_042",
      "speaker": "刘梅",
      "zh": "好，继续。",
      "pinyin": "Hǎo, jìxù.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_043",
      "speaker": "张伟",
      "zh": "家人给他买了一个新的。",
      "pinyin": "Jiārén gěi tā mǎi le yí ge xīn de.",
      "tr": "Ailesi ona yeni bir tane aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_044",
      "speaker": "店员",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xièxie nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méishì, bù kèqì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_047",
      "speaker": "张伟",
      "zh": "这下好了。",
      "pinyin": "Zhè xià hǎo le.",
      "tr": "Şimdi tamam."
