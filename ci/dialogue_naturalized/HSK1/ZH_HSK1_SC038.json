{
  "naturalizationVersion": 1,
  "sceneId": "ZH_HSK1_SC038",
  "level": "HSK1",
  "sourceTitleZh": "掉在地上的冰淇淋",
  "sourceTitleTr": "Dondurma Kazası",
  "sourceMiniAdventureTr": "Lele’nin dondurması yere düşer; aile yenisini alıp onu neşelendirir.",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC038_001",
      "speaker": "张乐乐",
      "zh": "乐乐买了一个冰淇淋。",
      "pinyin": "Lè lè mǎi le yī gè bīng qí lín.",
      "tr": "Lele bir dondurma aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_003",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_004",
      "speaker": "店员",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔn bèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔn bèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_006",
      "speaker": "刘梅",
      "zh": "你要冰淇淋吗？",
      "pinyin": "Nǐ yào bīng qí lín ma?",
      "tr": "Dondurma ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_007",
      "speaker": "张伟",
      "zh": "我要冰淇淋，谢谢。",
      "pinyin": "Wǒ yào bīng qí lín, xiè xiè.",
      "tr": "Dondurma istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_008",
      "speaker": "店员",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_009",
      "speaker": "张乐乐",
      "zh": "好，谢谢。",
      "pinyin": "Hǎo, xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_010",
      "speaker": "刘梅",
      "zh": "公园在哪儿？",
      "pinyin": "Gōng yuán zài nǎ ér?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_011",
      "speaker": "张伟",
      "zh": "公园在那边。",
      "pinyin": "Gōng yuán zài nà biān.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_012",
      "speaker": "店员",
      "zh": "嗯，我明白了。",
      "pinyin": "Ń, wǒ míng bái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_013",
      "speaker": "张乐乐",
      "zh": "谢谢啊。",
      "pinyin": "Xiè xiè a.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_014",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒ men de hái zi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_015",
      "speaker": "张伟",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_016",
      "speaker": "店员",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_017",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_018",
      "speaker": "刘梅",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_019",
      "speaker": "张伟",
      "zh": "对，这是钱。",
      "pinyin": "Duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_020",
      "speaker": "店员",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎ ér?",
      "tr": "Para nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_021",
      "speaker": "张乐乐",
      "zh": "钱在这里。",
      "pinyin": "Qián zài zhè lǐ.",
      "tr": "Para burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_022",
      "speaker": "刘梅",
      "zh": "冰淇淋掉在地上了。",
      "pinyin": "Bīng qí lín diào zài dì shàng le.",
      "tr": "Dondurma yere düştü."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_023",
      "speaker": "张伟",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_024",
      "speaker": "店员",
      "zh": "我看看。",
      "pinyin": "Wǒ kàn kàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒ men yī qǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_026",
      "speaker": "刘梅",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_027",
      "speaker": "张伟",
      "zh": "这是元吗？",
      "pinyin": "Zhè shì yuán ma?",
      "tr": "Bu, yuan mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_028",
      "speaker": "店员",
      "zh": "对，这是元。",
      "pinyin": "Duì, zhè shì yuán.",
      "tr": "Evet, bu yuan."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_029",
      "speaker": "张乐乐",
      "zh": "元在哪儿？",
      "pinyin": "Yuán zài nǎ ér?",
      "tr": "Yuan nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_030",
      "speaker": "刘梅",
      "zh": "元在这里。",
      "pinyin": "Yuán zài zhè lǐ.",
      "tr": "Yuan burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_031",
      "speaker": "张伟",
      "zh": "你要饭吗？",
      "pinyin": "Nǐ yào fàn ma?",
      "tr": "Yemek ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_032",
      "speaker": "店员",
      "zh": "我要饭，谢谢。",
      "pinyin": "Wǒ yào fàn, xiè xiè.",
      "tr": "Yemek istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_033",
      "speaker": "张乐乐",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_034",
      "speaker": "刘梅",
      "zh": "谢谢。",
      "pinyin": "Xiè xiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_035",
      "speaker": "张伟",
      "zh": "这是我们的朋友。",
      "pinyin": "Zhè shì wǒ men de péng yǒu.",
      "tr": "Bu bizim arkadaş."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_036",
      "speaker": "店员",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_037",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāo xīng rèn shí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_038",
      "speaker": "刘梅",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yī yàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_039",
      "speaker": "张伟",
      "zh": "今天忙吗？",
      "pinyin": "Jīn tiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_040",
      "speaker": "店员",
      "zh": "有一点儿。",
      "pinyin": "Yǒu yī diǎn ér.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_041",
      "speaker": "张乐乐",
      "zh": "没关系。",
      "pinyin": "Méi guān xì.",
      "tr": "Sorun değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_042",
      "speaker": "刘梅",
      "zh": "好，我们接着来。",
      "pinyin": "Hǎo, wǒ men jiē zhe lái.",
      "tr": "Devam edelim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_043",
      "speaker": "张伟",
      "zh": "家人给他买了一个新的。",
      "pinyin": "Jiā rén gěi tā mǎi le yī gè xīn de.",
      "tr": "Ailesi ona yeni bir tane aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_044",
      "speaker": "店员",
      "zh": "太好了！",
      "pinyin": "Tài hǎo le!",
      "tr": "Harika!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_045",
      "speaker": "张乐乐",
      "zh": "谢谢你。",
      "pinyin": "Xiè xiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_046",
      "speaker": "刘梅",
      "zh": "没事，不客气。",
      "pinyin": "Méi shì, bù kè qì.",
      "tr": "Rica ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_047",
      "speaker": "张伟",
      "zh": "现在就好了。",
      "pinyin": "Xiàn zài jiù hǎo le.",
      "tr": "Şimdi tamam."
