{
  "schemaVersion": 1,
  "policyVersion": "LOCKED_V2",
  "scope": "HSK1-HSK6",
  "style": "warm_cinematic_3d_2_5d_cgi",
  "imageAspectRatio": "9:16",
  "textAllowed": false,
  "collageAllowed": false,
  "miniSkirtAllowed": false,
  "sexyClothingAllowed": false,
  "dialogueMustBeReadFromGitHubSource": true,
