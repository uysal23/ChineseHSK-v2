  "zipIsLegacyFallbackOnly": true,
  "buildOnSourcePush": false,
  "buildRequiresExplicitUserApproval": true,
  "buildTriggerFile": "ci/build_trigger.txt",
  "buildRequiresActiveBatchReady": true,
  "syncWorkflow": ".github/workflows/sync-source-to-build-inputs.yml",
  "legacyBuildZipMirror": "chinese_hsk_android_github_v2.0.0.zip",
