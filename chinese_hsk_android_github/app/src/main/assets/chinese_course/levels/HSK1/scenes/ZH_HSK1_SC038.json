  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC038_001",
      "speaker": "张乐乐",
      "zh": "乐乐买了一个冰淇淋。",
      "pinyin": "Lèlè mǎi le yí ge bīngqílín.",
      "tr": "Lele bir dondurma aldı."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_003",
      "speaker": "张伟",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_004",
      "speaker": "店员",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_005",
      "speaker": "张乐乐",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_006",
      "speaker": "刘梅",
      "zh": "你要冰淇淋吗？",
      "pinyin": "Nǐ yào bīngqílín ma?",
      "tr": "Dondurma ister misin?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_007",
      "speaker": "张伟",
      "zh": "我要冰淇淋，谢谢。",
      "pinyin": "Wǒ yào bīngqílín, xièxie.",
      "tr": "Dondurma istiyorum, teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_008",
      "speaker": "店员",
      "zh": "好的。",
      "pinyin": "Hǎo de.",
      "tr": "Olur."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_009",
      "speaker": "张乐乐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_010",
      "speaker": "刘梅",
      "zh": "公园在哪儿？",
      "pinyin": "Gōngyuán zài nǎr?",
      "tr": "Park nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_011",
      "speaker": "张伟",
      "zh": "公园在那边。",
      "pinyin": "Gōngyuán zài nàbian.",
      "tr": "Park şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_012",
      "speaker": "店员",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbai le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_013",
      "speaker": "张乐乐",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_014",
      "speaker": "刘梅",
      "zh": "这是我们的孩子。",
      "pinyin": "Zhè shì wǒmen de háizi.",
      "tr": "Bu bizim çocuk."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_015",
      "speaker": "张伟",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_016",
      "speaker": "店员",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_017",
      "speaker": "张乐乐",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_018",
      "speaker": "刘梅",
      "zh": "这是钱吗？",
      "pinyin": "Zhè shì qián ma?",
      "tr": "Bu, para mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC038_019",
      "speaker": "张伟",
      "zh": "对，这是钱。",
      "pinyin": "Duì, zhè shì qián.",
      "tr": "Evet, bu para."
    },
    {
      "id": "DLG_ZH_HSK1_SC038_020",
      "speaker": "店员",
      "zh": "钱在哪儿？",
      "pinyin": "Qián zài nǎr?",
      "tr": "Para nerede?"
