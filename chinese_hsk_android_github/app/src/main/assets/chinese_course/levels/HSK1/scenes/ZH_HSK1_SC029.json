    {
      "id": "DLG_ZH_HSK1_SC029_040",
      "speaker": "张伟",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "tr": "Biraz."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_041",
      "speaker": "张伟",
      "zh": "没关系。",
