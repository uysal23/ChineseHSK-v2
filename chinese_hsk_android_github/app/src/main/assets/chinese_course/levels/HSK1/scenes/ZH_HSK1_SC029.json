    {
      "id": "DLG_ZH_HSK1_SC029_038",
      "speaker": "经理",
      "zh": "谢谢。",
      "pinyin": "Xièxie.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC029_039",
      "speaker": "公司职员",
      "zh": "今天忙吗？",
