    {
      "id": "DLG_ZH_HSK1_SC041_001",
      "speaker": "刘梅",
      "zh": "咪咪今天不吃饭。",
      "pinyin": "Mīmī jīntiān bù chīfàn.",
      "tr": "Mimi bugün yemek yemiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_002",
      "speaker": "张伟",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_003",
      "speaker": "兽医",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_004",
      "speaker": "张乐乐",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎo le ma?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_005",
      "speaker": "刘梅",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_006",
      "speaker": "张伟",
      "zh": "这是猫吗？",
      "pinyin": "Zhè shì māo ma?",
      "tr": "Bu, kedi mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_007",
      "speaker": "兽医",
      "zh": "对，这是猫。",
      "pinyin": "Duì, zhè shì māo.",
      "tr": "Evet, bu kedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_008",
      "speaker": "张乐乐",
      "zh": "猫在哪儿？",
      "pinyin": "Māo zài nǎr?",
      "tr": "Kedi nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_009",
      "speaker": "刘梅",
      "zh": "猫在这里。",
      "pinyin": "Māo zài zhèlǐ.",
      "tr": "Kedi burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_010",
      "speaker": "张伟",
      "zh": "这是我们的兽医。",
      "pinyin": "Zhè shì wǒmen de shòuyī.",
      "tr": "Bu bizim veteriner."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_011",
      "speaker": "兽医",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_012",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_013",
      "speaker": "刘梅",
      "zh": "我也是。",
      "pinyin": "Wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_014",
      "speaker": "张伟",
      "zh": "这是我们的医生。",
      "pinyin": "Zhè shì wǒmen de yīshēng.",
      "tr": "Bu bizim doktor."
    },
    {
      "id": "DLG_ZH_HSK1_SC041_015",
      "speaker": "兽医",
      "zh": "你好！",
      "pinyin": "Nǐ hǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC041_016",
      "speaker": "张乐乐",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshi nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
