  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC007_001",
      "speaker": "张伟",
      "zh": "我们到新车站了。",
      "pinyin": "Wǒmen dào xīn chēzhàn le.",
      "tr": "Yeni istasyona geldik."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_003",
      "speaker": "工作人员",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_004",
      "speaker": "张乐乐",
      "zh": "都准备好了吗？",
      "pinyin": "Dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_005",
      "speaker": "张伟",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_006",
      "speaker": "刘梅",
      "zh": "车站在哪儿？",
      "pinyin": "Chēzhàn zài nǎér?",
      "tr": "Istasyon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_007",
      "speaker": "工作人员",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Istasyon şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_008",
      "speaker": "张乐乐",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_009",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_010",
      "speaker": "刘梅",
      "zh": "这个是电话吗？",
      "pinyin": "Zhège shì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_011",
      "speaker": "工作人员",
      "zh": "嗯，这就是电话。",
      "pinyin": "En, zhè jiùshì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_012",
      "speaker": "张乐乐",
      "zh": "请问，电话在哪儿？",
      "pinyin": "Qǐngwèn, diànhuà zài nǎér?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_013",
      "speaker": "张伟",
      "zh": "你看，电话在这儿。",
      "pinyin": "Nǐ kàn, diànhuà zài zhèér.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_014",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dìzhǐ shì shénme?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_015",
      "speaker": "工作人员",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_016",
      "speaker": "张乐乐",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_017",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_018",
      "speaker": "刘梅",
      "zh": "这个是时间吗？",
      "pinyin": "Zhège shì shíjiān ma?",
      "tr": "Bu, zaman mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_019",
      "speaker": "工作人员",
      "zh": "对，这是时间。",
      "pinyin": "Duì, zhèshì shíjiān.",
      "tr": "Evet, bu zaman."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_020",
      "speaker": "张乐乐",
      "zh": "请问，时间在哪儿？",
      "pinyin": "Qǐngwèn, shíjiān zài nǎér?",
      "tr": "Zaman nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_021",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Zaman burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_022",
      "speaker": "刘梅",
      "zh": "搬家公司的人还没来。",
      "pinyin": "Bānjiā gōngsī de rén hái méilái.",
      "tr": "Nakliye şirketinden kimse henüz gelmedi."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_023",
      "speaker": "工作人员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_024",
      "speaker": "张乐乐",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_027",
      "speaker": "工作人员",
      "zh": "我们坐车吗？",
      "pinyin": "Wǒmen zuòchē ma?",
      "tr": "Araç ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_028",
      "speaker": "张乐乐",
      "zh": "对，我们坐车。",
      "pinyin": "Duì, wǒmen zuòchē.",
      "tr": "Evet, araç ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_029",
      "speaker": "张伟",
      "zh": "那都准备好了吗？",
      "pinyin": "Nà dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_030",
      "speaker": "刘梅",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_031",
      "speaker": "工作人员",
      "zh": "我们坐火车吗？",
      "pinyin": "Wǒmen zuòhuǒchē ma?",
      "tr": "Tren ile mi gidiyoruz?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_032",
      "speaker": "张乐乐",
      "zh": "对，我们坐火车。",
      "pinyin": "Duì, wǒmen zuòhuǒchē.",
      "tr": "Evet, tren ile gidiyoruz."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_033",
      "speaker": "张伟",
      "zh": "现在都准备好了吗？",
      "pinyin": "Xiànzài dōu zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_034",
      "speaker": "刘梅",
      "zh": "嗯，都准备好了。",
      "pinyin": "En, dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_035",
      "speaker": "工作人员",
      "zh": "这是我们的人。",
      "pinyin": "Zhèshì wǒmen de rén.",
      "tr": "Bu bizim insan."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_036",
      "speaker": "张乐乐",
      "zh": "嗨，你好！",
      "pinyin": "Hāi, nǐhǎo!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_037",
      "speaker": "张伟",
      "zh": "认识你很高兴。",
      "pinyin": "Rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_038",
      "speaker": "刘梅",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC007_039",
      "speaker": "工作人员",
      "zh": "今天忙吗？",
      "pinyin": "Jīntiān máng ma?",
      "tr": "Bugün yoğun musun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC007_040",
      "speaker": "张乐乐",
      "zh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
