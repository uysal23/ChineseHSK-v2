      "speaker": "小朋友",
      "zh": "好。",
      "pinyin": "Hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_027",
      "speaker": "张雨桐",
      "zh": "家在哪儿？",
      "pinyin": "Jiā zài nǎr?",
      "tr": "Ev nerede?"
