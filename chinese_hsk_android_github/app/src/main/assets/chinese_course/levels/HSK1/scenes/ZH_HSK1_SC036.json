    {
      "id": "DLG_ZH_HSK1_SC036_020",
      "speaker": "刘梅",
      "zh": "球在哪儿？",
      "pinyin": "Qiú zài nǎr?",
      "tr": "Top nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC036_021",
      "speaker": "张乐乐",
      "zh": "球在这里。",
      "pinyin": "Qiú zài zhèlǐ.",
      "tr": "Top burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_022",
      "speaker": "小朋友",
      "zh": "两个孩子都想要同一个玩具。",
      "pinyin": "Liǎng ge háizi dōu xiǎng yào tóng yí ge wánjù.",
      "tr": "İki çocuk da aynı oyuncağı istiyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_023",
      "speaker": "张雨桐",
      "zh": "别急。",
      "pinyin": "Bié jí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_024",
      "speaker": "刘梅",
      "zh": "我来看看。",
      "pinyin": "Wǒ lái kànkan.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC036_025",
      "speaker": "张乐乐",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
