    {
      "id": "DLG_ZH_HSK1_SC001_013",
      "speaker": "张雨桐",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_014",
      "speaker": "张乐乐",
      "zh": "请问，家在哪儿？",
      "pinyin": "Qǐngwèn, jiā zài nǎér?",
      "tr": "Ev nerede?"
