      "id": "DLG_ZH_HSK1_SC001_005",
      "speaker": "王师傅",
      "zh": "嗯，准备好了。",
      "pinyin": "En, zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_006",
      "speaker": "张伟",
      "zh": "这是箱子吗？",
      "pinyin": "Zhèshì xiāngzi ma?",
      "tr": "Bu, kutu / koli mı?"
