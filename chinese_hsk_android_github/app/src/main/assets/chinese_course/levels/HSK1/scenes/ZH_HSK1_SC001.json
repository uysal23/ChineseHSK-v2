    {
      "id": "DLG_ZH_HSK1_SC001_007",
      "speaker": "刘梅",
      "zh": "嗯，这就是箱子。",
      "pinyin": "En, zhè jiùshì xiāngzi.",
      "tr": "Evet, bu kutu / koli."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_008",
      "speaker": "张雨桐",
      "zh": "请问，箱子在哪儿？",
      "pinyin": "Qǐngwèn, xiāngzi zài nǎér?",
      "tr": "Kutu / koli nerede?"
