      "speaker": "王师傅",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC001_021",
      "speaker": "张伟",
      "zh": "太好了，谢谢。",
