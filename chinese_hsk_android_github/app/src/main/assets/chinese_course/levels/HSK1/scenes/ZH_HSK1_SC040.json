  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC040_001",
      "speaker": "张伟",
      "zh": "快递送来了一个包裹。",
      "pinyin": "Kuàidì sònglái le yígè bāoguǒ.",
      "tr": "Kurye bir paket getirdi."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_002",
      "speaker": "刘梅",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_003",
      "speaker": "快递员",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_004",
      "speaker": "邻居",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_005",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_006",
      "speaker": "刘梅",
      "zh": "这个是包裹吗？",
      "pinyin": "Zhège shì bāoguǒ ma?",
      "tr": "Bu, paket / kargo mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_007",
      "speaker": "快递员",
      "zh": "对，这是包裹。",
      "pinyin": "Duì, zhèshì bāoguǒ.",
      "tr": "Evet, bu paket / kargo."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_008",
      "speaker": "邻居",
      "zh": "包裹呢？",
      "pinyin": "Bāoguǒ ne?",
      "tr": "Paket / kargo nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_009",
      "speaker": "张伟",
      "zh": "你看，包裹在这儿。",
      "pinyin": "Nǐ kàn, bāoguǒ zài zhèér.",
      "tr": "Paket / kargo burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_010",
      "speaker": "刘梅",
      "zh": "你的地址是什么？",
      "pinyin": "Nǐ de dìzhǐ shì shénme?",
      "tr": "Adres nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_011",
      "speaker": "快递员",
      "zh": "这是我的地址。",
      "pinyin": "Zhè shì wǒ de dìzhǐ.",
      "tr": "Bu benim adres."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_012",
      "speaker": "邻居",
      "zh": "我记下了。",
      "pinyin": "Wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_013",
      "speaker": "张伟",
      "zh": "谢谢。",
      "pinyin": "Xièxiè.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_014",
      "speaker": "刘梅",
      "zh": "这是我们的邻居。",
      "pinyin": "Zhèshì wǒmen de línjū.",
      "tr": "Bu bizim komşu."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_015",
      "speaker": "快递员",
      "zh": "你好，来了！",
      "pinyin": "Nǐhǎo, lái le!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_016",
      "speaker": "邻居",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_017",
      "speaker": "张伟",
      "zh": "我也这么想。",
      "pinyin": "Wǒ yě zhème xiǎng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_018",
      "speaker": "刘梅",
      "zh": "这个是门吗？",
      "pinyin": "Zhège shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_019",
      "speaker": "快递员",
      "zh": "没错，这是门。",
      "pinyin": "Méicuò, zhè shì mén.",
      "tr": "Evet, bu kapı."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_020",
      "speaker": "邻居",
      "zh": "请问，门在哪儿？",
      "pinyin": "Qǐngwèn, mén zài nǎér?",
      "tr": "Kapı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_021",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Kapı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_022",
      "speaker": "刘梅",
      "zh": "包裹上的名字不是张伟。",
      "pinyin": "Bāoguǒ shàng de míngzì búshì zhāngwěi.",
      "tr": "Paketin üzerindeki isim Zhang Wei değil."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_023",
      "speaker": "快递员",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_024",
      "speaker": "邻居",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_026",
      "speaker": "刘梅",
      "zh": "行。",
      "pinyin": "Xíng.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_027",
      "speaker": "快递员",
      "zh": "请问，家在哪儿？",
      "pinyin": "Qǐngwèn, jiā zài nǎér?",
      "tr": "Ev nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_028",
      "speaker": "邻居",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ev şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_029",
      "speaker": "张伟",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_030",
      "speaker": "刘梅",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_031",
      "speaker": "快递员",
      "zh": "你的名字是什么？",
      "pinyin": "Nǐ de míngzì shì shénme?",
      "tr": "Isim nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_032",
      "speaker": "邻居",
      "zh": "这是我的名字。",
      "pinyin": "Zhè shì wǒ de míngzì.",
      "tr": "Bu benim isim."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_033",
      "speaker": "张伟",
      "zh": "嗯，我记下了。",
      "pinyin": "En, wǒ jìxià le.",
      "tr": "Not aldım."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_034",
      "speaker": "刘梅",
      "zh": "嗯，谢谢你。",
      "pinyin": "En, xièxiè nǐ.",
      "tr": "Teşekkürler."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_035",
      "speaker": "快递员",
      "zh": "这是电话吗？",
      "pinyin": "Zhèshì diànhuà ma?",
      "tr": "Bu, telefon mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_036",
      "speaker": "邻居",
      "zh": "对，这是电话。",
      "pinyin": "Duì, zhèshì diànhuà.",
      "tr": "Evet, bu telefon."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_037",
      "speaker": "张伟",
      "zh": "请问，电话在哪儿？",
      "pinyin": "Qǐngwèn, diànhuà zài nǎér?",
      "tr": "Telefon nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_038",
      "speaker": "刘梅",
      "zh": "你看，电话在这儿。",
      "pinyin": "Nǐ kàn, diànhuà zài zhèér.",
      "tr": "Telefon burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC040_039",
      "speaker": "快递员",
      "zh": "你的号码是什么？",
      "pinyin": "Nǐ de hàomǎ shì shénme?",
      "tr": "Numara nedir?"
    },
    {
      "id": "DLG_ZH_HSK1_SC040_040",
      "speaker": "邻居",
      "zh": "这是我的号码。",
      "pinyin": "Zhè shì wǒ de hàomǎ.",
      "tr": "Bu benim numara."
    },
