      "id": "DLG_ZH_HSK1_SC031_007",
      "speaker": "保安",
      "zh": "对，这是工作卡。",
      "pinyin": "Duì, zhè shì gōngzuò kǎ.",
      "tr": "Evet, bu iş kartı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_008",
      "speaker": "经理",
      "zh": "工作卡在哪儿？",
      "pinyin": "Gōngzuò kǎ zài nǎr?",
      "tr": "Iş kartı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_009",
      "speaker": "张伟",
      "zh": "工作卡在这里。",
