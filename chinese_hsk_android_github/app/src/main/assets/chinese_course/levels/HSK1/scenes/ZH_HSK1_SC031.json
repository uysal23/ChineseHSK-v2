  "dialogues": [
    {
      "id": "DLG_ZH_HSK1_SC031_001",
      "speaker": "张伟",
      "zh": "今天是张伟上班第一天。",
      "pinyin": "Jīntiān shì zhāngwěi shàngbān dìyītiān.",
      "tr": "Bugün Zhang Wei’nin işe ilk günü."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_002",
      "speaker": "同事",
      "zh": "是吗？",
      "pinyin": "Shì ma?",
      "tr": "Öyle mi?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_003",
      "speaker": "保安",
      "zh": "对。",
      "pinyin": "Duì.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_004",
      "speaker": "经理",
      "zh": "准备好了吗？",
      "pinyin": "Zhǔnbèi hǎolema?",
      "tr": "Hazır mısınız?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_005",
      "speaker": "张伟",
      "zh": "都准备好了。",
      "pinyin": "Dōu zhǔnbèi hǎo le.",
      "tr": "Hazırız."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_006",
      "speaker": "同事",
      "zh": "这是工作卡，对吗？",
      "pinyin": "Zhèshì gōngzuò kǎ, duì ma?",
      "tr": "Bu, iş kartı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_007",
      "speaker": "保安",
      "zh": "对，这是工作卡。",
      "pinyin": "Duì, zhèshì gōngzuò kǎ.",
      "tr": "Evet, bu iş kartı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_008",
      "speaker": "经理",
      "zh": "请问，工作卡在哪儿？",
      "pinyin": "Qǐngwèn, gōngzuò kǎ zài nǎér?",
      "tr": "Iş kartı nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_009",
      "speaker": "张伟",
      "zh": "你看，工作卡在这儿。",
      "pinyin": "Nǐ kàn, gōngzuò kǎ zài zhèér.",
      "tr": "Iş kartı burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_010",
      "speaker": "同事",
      "zh": "这个是卡吗？",
      "pinyin": "Zhège shì kǎ ma?",
      "tr": "Bu, kart mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_011",
      "speaker": "保安",
      "zh": "对，这是卡。",
      "pinyin": "Duì, zhè shì kǎ.",
      "tr": "Evet, bu kart."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_012",
      "speaker": "经理",
      "zh": "请问，卡在哪儿？",
      "pinyin": "Qǐngwèn, kǎ zài nǎér?",
      "tr": "Kart nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_013",
      "speaker": "张伟",
      "zh": "你看，卡在这儿。",
      "pinyin": "Nǐ kàn, kǎ zài zhèér.",
      "tr": "Kart burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_014",
      "speaker": "同事",
      "zh": "办公室在哪儿？",
      "pinyin": "Bàngōngshì zài nǎér?",
      "tr": "Ofis nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_015",
      "speaker": "保安",
      "zh": "就在那边。",
      "pinyin": "Jiù zài nàbiān.",
      "tr": "Ofis şu tarafta."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_016",
      "speaker": "经理",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_017",
      "speaker": "张伟",
      "zh": "谢谢你。",
      "pinyin": "Xièxiè nǐ.",
      "tr": "Teşekkür ederim."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_018",
      "speaker": "同事",
      "zh": "你在找工作吗？",
      "pinyin": "Nǐ zài zhǎo gōngzuò ma?",
      "tr": "İş mi arıyorsun?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_019",
      "speaker": "保安",
      "zh": "没错。",
      "pinyin": "Méicuò.",
      "tr": "Evet."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_020",
      "speaker": "经理",
      "zh": "准备得怎么样了？",
      "pinyin": "Zhǔnbèi dé zěnmeyàng le?",
      "tr": "Hazır mısın?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_021",
      "speaker": "张伟",
      "zh": "准备好了。",
      "pinyin": "Zhǔnbèi hǎo le.",
      "tr": "Hazırım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_022",
      "speaker": "同事",
      "zh": "他的工作卡找不到了。",
      "pinyin": "Tā de gōngzuò kǎzhǎo búdào le.",
      "tr": "İş kartını bulamıyor."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_023",
      "speaker": "保安",
      "zh": "别急。",
      "pinyin": "Biéjí.",
      "tr": "Panik yapma."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_024",
      "speaker": "经理",
      "zh": "我来看看。",
      "pinyin": "Wǒlái kànkàn.",
      "tr": "Ben bir bakayım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_025",
      "speaker": "张伟",
      "zh": "我们一起吧。",
      "pinyin": "Wǒmen yìqǐ ba.",
      "tr": "Birlikte yapalım."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_026",
      "speaker": "同事",
      "zh": "嗯，好。",
      "pinyin": "En, hǎo.",
      "tr": "Tamam."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_027",
      "speaker": "保安",
      "zh": "这是我们的同事。",
      "pinyin": "Zhèshì wǒmen de tóngshì.",
      "tr": "Bu bizim iş arkadaşı."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_028",
      "speaker": "经理",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_029",
      "speaker": "张伟",
      "zh": "认识你很高兴。",
      "pinyin": "Rènshí nǐ hěn gāoxìng.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_030",
      "speaker": "同事",
      "zh": "嗯，我也是。",
      "pinyin": "En, wǒ yě shì.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_031",
      "speaker": "保安",
      "zh": "这是我们的经理。",
      "pinyin": "Zhèshì wǒmen de jīnglǐ.",
      "tr": "Bu bizim müdür."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_032",
      "speaker": "经理",
      "zh": "你好啊！",
      "pinyin": "Nǐhǎo a!",
      "tr": "Merhaba!"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_033",
      "speaker": "张伟",
      "zh": "很高兴认识你。",
      "pinyin": "Hěn gāoxìng rènshí nǐ.",
      "tr": "Tanıştığımıza memnun oldum."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_034",
      "speaker": "同事",
      "zh": "我也一样。",
      "pinyin": "Wǒ yě yīyàng.",
      "tr": "Ben de."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_035",
      "speaker": "保安",
      "zh": "这个是电脑吗？",
      "pinyin": "Zhège shì diànnǎo ma?",
      "tr": "Bu, bilgisayar mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_036",
      "speaker": "经理",
      "zh": "没错，这是电脑。",
      "pinyin": "Méicuò, zhèshì diànnǎo.",
      "tr": "Evet, bu bilgisayar."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_037",
      "speaker": "张伟",
      "zh": "电脑在哪儿？",
      "pinyin": "Diànnǎo zài nǎér?",
      "tr": "Bilgisayar nerede?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_038",
      "speaker": "同事",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bilgisayar burada."
    },
    {
      "id": "DLG_ZH_HSK1_SC031_039",
      "speaker": "保安",
      "zh": "这是门吗？",
      "pinyin": "Zhè shì mén ma?",
      "tr": "Bu, kapı mı?"
    },
    {
      "id": "DLG_ZH_HSK1_SC031_040",
      "speaker": "经理",
      "zh": "嗯，这就是门。",
      "pinyin": "En, zhè jiùshì mén.",
      "tr": "Evet, bu kapı."
    },
