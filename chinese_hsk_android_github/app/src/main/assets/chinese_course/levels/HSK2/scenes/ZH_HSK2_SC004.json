      "speaker": "张乐乐",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_056",
      "speaker": "刘梅",
      "zh": "这个校车在这里。",
      "pinyin": "Zhège xiàochē zài zhèlǐ.",
      "tr": "Bu okul servisi burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC004_057",
      "speaker": "邻居",
      "zh": "这个很实用。",
