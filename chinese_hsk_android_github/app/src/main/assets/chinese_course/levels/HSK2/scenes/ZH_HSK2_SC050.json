{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC050",
  "level": "HSK2",
  "number": 50,
  "titleZh": "在新城的一年",
  "titleTr": "Kasabada Bir Yıl",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC050_001",
      "speaker": "张伟",
      "zh": "我们在新城已经一年了。",
      "pinyin": "Wǒmen zài xīnchéng yǐjīng yīnián le.",
      "tr": "Yeni şehirde bir yılı tamamladık."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_002",
      "speaker": "刘梅",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_003",
      "speaker": "李晨",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_004",
      "speaker": "李晨妻子",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_005",
      "speaker": "张伟",
      "zh": "这一年过得很快。",
      "pinyin": "Zhè yīnián guòdé hěnkuài.",
      "tr": "Bu bir yıl çok hızlı geçti."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_006",
      "speaker": "刘梅",
      "zh": "嗯，我懂了。",
      "pinyin": "En, wǒ dǒng le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_007",
      "speaker": "李晨",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_008",
      "speaker": "李晨妻子",
      "zh": "这个已经准备好了。",
      "pinyin": "Zhège yǐjīng zhǔnbèi hǎo le.",
      "tr": "Bu çoktan hazırlandı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_009",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_010",
      "speaker": "刘梅",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_011",
      "speaker": "李晨",
      "zh": "我希望大家都越来越好。",
      "pinyin": "Wǒ xīwàng dàjiā dōu yuèláiyuè hǎo.",
      "tr": "Umarım herkes giderek daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_012",
      "speaker": "李晨妻子",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_014",
      "speaker": "刘梅",
      "zh": "希望以后越来越好。",
      "pinyin": "Xīwàng yǐhòu yuèláiyuè hǎo.",
      "tr": "Umarım gelecekte giderek daha iyi olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_015",
      "speaker": "李晨",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_016",
      "speaker": "李晨妻子",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_017",
      "speaker": "张伟",
      "zh": "这一年发生了很多事情。",
      "pinyin": "Zhè yīnián fāshēng le hěnduō shìqíng.",
      "tr": "Bu yıl birçok şey oldu."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC050_019",
      "speaker": "李晨",
      "zh": "我们慢慢想，一定有办法。",
      "pinyin": "Wǒmen mànmàn xiǎng, yídìng yǒu bànfǎ.",
      "tr": "Sakin sakin düşünelim, mutlaka bir yol buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_020",
      "speaker": "李晨妻子",
      "zh": "先做容易的吧。",
      "pinyin": "Xiān zuò róngyì de ba.",
      "tr": "Önce kolay olanı yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_022",
      "speaker": "刘梅",
      "zh": "大家今天都很开心。",
      "pinyin": "Dàjiā jīntiān dōu hěn kāixīn.",
      "tr": "Bugün herkes çok mutlu."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_023",
      "speaker": "李晨",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_024",
      "speaker": "李晨妻子",
      "zh": "那我先把它写下来。",
      "pinyin": "Nà wǒ xiān bǎ tā xiě xiàlái.",
      "tr": "O zaman bunu önce yazayım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_025",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_027",
      "speaker": "李晨",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_028",
      "speaker": "李晨妻子",
      "zh": "朋友今天也来了。",
      "pinyin": "Péngyǒu jīntiān yě lái le.",
      "tr": "Arkadaş bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_031",
      "speaker": "李晨",
      "zh": "现在的生活越来越稳定了。",
      "pinyin": "Xiànzài de shēnghuó yuèláiyuè wěndìng le.",
      "tr": "Şimdiki hayat giderek daha düzenli oluyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_032",
      "speaker": "李晨妻子",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_034",
      "speaker": "刘梅",
      "zh": "时间不多了，我们快一点吧。",
      "pinyin": "Shíjiān bùduō le, wǒmen kuài yìdiǎn ba.",
      "tr": "Fazla zaman kalmadı, biraz hızlanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_035",
      "speaker": "李晨",
      "zh": "好，先这个，后面再做下一个。",
      "pinyin": "Hǎo, xiān zhège, hòumiàn zài zuò xià yígè.",
      "tr": "Tamam, önce bu; sonra diğerini yaparız."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_036",
      "speaker": "李晨妻子",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_037",
      "speaker": "张伟",
      "zh": "刚才我试过这个办法。",
      "pinyin": "Gāngcái wǒshì guò zhège bànfǎ.",
      "tr": "Az önce bu yöntemi denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_038",
      "speaker": "刘梅",
      "zh": "这个不行，就换一个。",
      "pinyin": "Zhège bùxíng, jiù huàn yígè.",
      "tr": "Bu olmazsa başka birini deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_039",
      "speaker": "李晨",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_040",
      "speaker": "李晨妻子",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_043",
      "speaker": "李晨",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_044",
      "speaker": "李晨妻子",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_047",
      "speaker": "李晨",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_048",
      "speaker": "李晨妻子",
      "zh": "太好了，这下没问题了。",
      "pinyin": "Tàihǎole, zhèxià méi wèntí le.",
      "tr": "Harika, artık sorun yok."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_049",
      "speaker": "张伟",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_050",
      "speaker": "刘梅",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_051",
      "speaker": "李晨",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_052",
      "speaker": "李晨妻子",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC050_054",
      "speaker": "刘梅",
      "zh": "嗯，这一年过得很快。",
      "pinyin": "En, zhè yīnián guòdé hěnkuài.",
