      "zh": "嗯，我记住了。",
      "pinyin": "En, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_056",
      "speaker": "张乐乐",
      "zh": "这个食物在这里。",
      "pinyin": "Zhège shíwù zài zhèlǐ.",
      "tr": "Bu yiyecek burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_057",
