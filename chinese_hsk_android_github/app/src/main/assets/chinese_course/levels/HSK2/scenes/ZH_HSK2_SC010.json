      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_058",
      "speaker": "刘梅",
      "zh": "嗯，我们忘了带吃的。",
      "pinyin": "En, wǒmen wàng le dài chī de.",
      "tr": "Yiyecek getirmeyi unuttuk."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_059",
      "speaker": "张雨桐",
      "zh": "以后也会用到。",
      "pinyin": "Yǐhòu yě huì yòngdào.",
      "tr": "Bunu ileride yine kullanacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_060",
      "speaker": "张乐乐",
      "zh": "这个包在这里。",
      "pinyin": "Zhège bāo zài zhèlǐ.",
      "tr": "Bu çanta burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC010_061",
