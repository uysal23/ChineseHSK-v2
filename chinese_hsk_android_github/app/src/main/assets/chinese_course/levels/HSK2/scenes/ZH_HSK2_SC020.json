{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC020",
  "level": "HSK2",
  "number": 20,
  "titleZh": "家庭电影之夜",
  "titleTr": "Ailece Film Gecesi",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC020_001",
      "speaker": "张伟",
      "zh": "今晚我们一起看电影。",
      "pinyin": "Jīnwǎn wǒmen yìqǐ kàn diànyǐng.",
      "tr": "Bu akşam birlikte film izleyeceğiz."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_002",
      "speaker": "刘梅",
      "zh": "今天要忙的事不少。",
      "pinyin": "Jīntiān yào máng de shì bùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_003",
      "speaker": "张雨桐",
      "zh": "我们先从最重要的开始。",
      "pinyin": "Wǒmen xiān cóng zuì zhòngyào de kāishǐ.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_004",
      "speaker": "张乐乐",
      "zh": "行，一步一步来。",
      "pinyin": "Xíng, yībù yībù lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_005",
      "speaker": "张伟",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu film burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_006",
      "speaker": "刘梅",
      "zh": "好，我知道了。",
      "pinyin": "Hǎo, wǒ zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_007",
      "speaker": "张雨桐",
      "zh": "哦，是这样啊。",
      "pinyin": "Ó, shì zhèyàng a.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_008",
      "speaker": "张乐乐",
      "zh": "我想听听你的意见。",
      "pinyin": "Wǒ xiǎng tīngtīng nǐ de yìjiàn.",
      "tr": "Fikrini duymak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_009",
      "speaker": "张伟",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_010",
      "speaker": "刘梅",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_011",
      "speaker": "张雨桐",
      "zh": "这个电影真的很好笑。",
      "pinyin": "Zhège diànyǐng zhēnde hěn hǎoxiào.",
      "tr": "Bu film gerçekten çok komik."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_012",
      "speaker": "张乐乐",
      "zh": "好，我们就这样做。",
      "pinyin": "Hǎo, wǒmen jiù zhèyàng zuò.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_014",
      "speaker": "刘梅",
      "zh": "这个故事很有意思。",
      "pinyin": "Zhège gùshì hěn yǒuyìsi.",
      "tr": "Bu hikâye çok ilginç."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_015",
      "speaker": "张雨桐",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_016",
      "speaker": "张乐乐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_017",
      "speaker": "张伟",
      "zh": "大家想看的电影都不一样。",
      "pinyin": "Dàjiā xiǎng kàn de diànyǐng dōu bù yīyàng.",
      "tr": "Herkes farklı bir film izlemek istiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC020_019",
      "speaker": "张雨桐",
      "zh": "先冷静一下，我们再想想怎么办。",
      "pinyin": "Xiān lěngjìng yīxià, wǒmen zài xiǎngxiǎng zěnmebàn.",
      "tr": "Önce sakinleşelim, sonra ne yapacağımızı düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_020",
      "speaker": "张乐乐",
      "zh": "要不先做最简单的？",
      "pinyin": "Yào bù xiān zuò zuì jiǎndān de?",
      "tr": "Önce en kolay olanı yapsak?"
    },
    {
      "id": "DLG_ZH_HSK2_SC020_021",
      "speaker": "张伟",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_022",
      "speaker": "刘梅",
      "zh": "我们先决定。",
      "pinyin": "Wǒmen xiān juédìng.",
      "tr": "Önce karar vermek."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_023",
      "speaker": "张雨桐",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_024",
      "speaker": "张乐乐",
      "zh": "那就先写下来。",
      "pinyin": "Nà jiù xiān xiě xiàlái.",
      "tr": "O zaman önce yazalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_025",
      "speaker": "张伟",
      "zh": "家人今天也来了。",
      "pinyin": "Jiārén jīntiān yě lái le.",
      "tr": "Aile bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_027",
      "speaker": "张雨桐",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_028",
      "speaker": "张乐乐",
      "zh": "因为时间不多，我们得快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, wǒmen dé kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olmalıyız."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_029",
      "speaker": "张伟",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_031",
      "speaker": "张雨桐",
      "zh": "所以我们先解决这个问题。",
      "pinyin": "Suǒyǐ wǒmen xiān jiějué zhège wèntí.",
      "tr": "Bu yüzden önce bu sorunu çözelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_032",
      "speaker": "张乐乐",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_033",
      "speaker": "张伟",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_034",
      "speaker": "刘梅",
      "zh": "时间不多了，我们快一点吧。",
      "pinyin": "Shíjiān bùduō le, wǒmen kuài yìdiǎn ba.",
      "tr": "Fazla zaman kalmadı, biraz hızlanalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_035",
      "speaker": "张雨桐",
      "zh": "先做这个，然后再做下一个。",
      "pinyin": "Xiān zuò zhège, ránhòu zài zuò xià yígè.",
      "tr": "Önce bunu yapalım, sonra diğerine geçeriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_036",
      "speaker": "张乐乐",
      "zh": "换成这个办法会更容易。",
      "pinyin": "Huànchéng zhège bànfǎ huì gèng róngyì.",
      "tr": "Bu yönteme geçmek daha kolay olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_037",
      "speaker": "张伟",
      "zh": "这个我试过一次。",
      "pinyin": "Zhège wǒshì guò yīcì.",
      "tr": "Bunu bir kez denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_038",
      "speaker": "刘梅",
      "zh": "不行的话就换一个办法。",
      "pinyin": "Bùxíng dehuà jiù huàn yígè bànfǎ.",
      "tr": "Olmazsa başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_039",
      "speaker": "张雨桐",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_040",
      "speaker": "张乐乐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_041",
      "speaker": "张伟",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_044",
      "speaker": "张乐乐",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_045",
      "speaker": "张伟",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_046",
      "speaker": "刘梅",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_047",
      "speaker": "张雨桐",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_048",
      "speaker": "张乐乐",
      "zh": "好，总算解决了。",
      "pinyin": "Hǎo, zǒngsuàn jiějué le.",
      "tr": "Tamam, sonunda çözdük."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_049",
      "speaker": "张伟",
      "zh": "今天这个经验很有用。",
      "pinyin": "Jīntiān zhège jīngyàn hěn yǒuyòng.",
      "tr": "Bugünkü deneyim çok faydalı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_050",
      "speaker": "刘梅",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_051",
      "speaker": "张雨桐",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_052",
      "speaker": "张乐乐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_053",
      "speaker": "张伟",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_054",
      "speaker": "刘梅",
      "zh": "你看，这个电影在这儿。",
      "pinyin": "Nǐ kàn, zhège diànyǐng zài zhèér.",
      "tr": "Bu film burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_055",
      "speaker": "张雨桐",
      "zh": "对，我记住了。",
      "pinyin": "Duì, wǒ jìzhù le.",
      "tr": "Evet, aklımda."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_056",
      "speaker": "张乐乐",
      "zh": "嗯，我想听听你的意见。",
      "pinyin": "En, wǒ xiǎng tīngtīng nǐ de yìjiàn.",
      "tr": "Fikrini duymak istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_057",
      "speaker": "张伟",
      "zh": "这个挺实用的。",
      "pinyin": "Zhège tǐng shíyòng de.",
      "tr": "Bu çok kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC020_058",
      "speaker": "刘梅",
      "zh": "嗯，这个电影真的很好笑。",
      "pinyin": "En, zhège diànyǐng zhēnde hěn hǎoxiào.",
      "tr": "Bu film gerçekten çok komik."
    },
    {
