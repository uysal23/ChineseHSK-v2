{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC028",
  "level": "HSK2",
  "number": 28,
  "titleZh": "雨桐第一次自己回家",
  "titleTr": "Yutong İlk Kez Tek Başına Dönüyor",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC028_001",
      "speaker": "张雨桐",
      "zh": "我好像下错站了。",
      "pinyin": "Wǒ hǎoxiàng xiàcuò zhàn le.",
      "tr": "Sanırım yanlış durakta indim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_002",
      "speaker": "刘梅",
      "zh": "今天事情还真不少。",
      "pinyin": "Jīntiān shìqíng hái zhēnbùshǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_003",
      "speaker": "路人",
      "zh": "先看看哪件事最重要。",
      "pinyin": "Xiān kànkàn nǎjiàn shì zuì zhòngyào.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_004",
      "speaker": "张雨桐",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_005",
      "speaker": "刘梅",
      "zh": "我刚才下错站了。",
      "pinyin": "Wǒ gāngcái xiàcuò zhàn le.",
      "tr": "Az önce yanlış durakta indim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_006",
      "speaker": "路人",
      "zh": "知道了。",
      "pinyin": "Zhīdào le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_007",
      "speaker": "张雨桐",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_008",
      "speaker": "刘梅",
      "zh": "我不太确定方向。",
      "pinyin": "Wǒ bù tài quèdìng fāngxiàng.",
      "tr": "Yönden pek emin değilim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_009",
      "speaker": "路人",
      "zh": "行，我会记着。",
      "pinyin": "Xíng, wǒhuì jìzhe.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_010",
      "speaker": "张雨桐",
      "zh": "好，现在清楚了。",
      "pinyin": "Hǎo, xiànzài qīngchǔ le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_011",
      "speaker": "刘梅",
      "zh": "我们先转。",
      "pinyin": "Wǒmen xiānzhuǎn.",
      "tr": "Önce dönmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_012",
      "speaker": "路人",
      "zh": "行，就按这个来。",
      "pinyin": "Xíng, jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_013",
      "speaker": "张雨桐",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_014",
      "speaker": "刘梅",
      "zh": "从这里一直走就到了。",
      "pinyin": "Cóng zhèlǐ yìzhí zǒu jiù dào le.",
      "tr": "Buradan dümdüz gidince ulaşırsın."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_015",
      "speaker": "路人",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_016",
      "speaker": "张雨桐",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_017",
      "speaker": "刘梅",
      "zh": "你先看地图，然后一直走。",
      "pinyin": "Nǐ xiān kàn dìtú, ránhòu yìzhí zǒu.",
      "tr": "Önce haritaya bak, sonra dümdüz yürü."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_018",
      "speaker": "路人",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC028_019",
      "speaker": "张雨桐",
      "zh": "别着急，总会有办法的。",
      "pinyin": "Biézháojí, zǒnghuì yǒu bànfǎ de.",
      "tr": "Telaşlanma, mutlaka bir çözüm buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_020",
      "speaker": "刘梅",
      "zh": "我们可以先从简单的开始。",
      "pinyin": "Wǒmen kěyǐ xiān cóng jiǎndān de kāishǐ.",
      "tr": "Önce kolay olandan başlayabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_021",
      "speaker": "路人",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_022",
      "speaker": "张雨桐",
      "zh": "这个地图在这里。",
      "pinyin": "Zhège dìtú zài zhèlǐ.",
      "tr": "Bu harita burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_023",
      "speaker": "刘梅",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_024",
      "speaker": "路人",
      "zh": "别忘了，把这个记一下。",
      "pinyin": "Biéwàngle, bǎ zhège jì yīxià.",
      "tr": "Unutmayalım, bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_025",
      "speaker": "张雨桐",
      "zh": "我们先打电话。",
      "pinyin": "Wǒmen xiān dǎdiànhuà.",
      "tr": "Önce telefon etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_026",
      "speaker": "刘梅",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_027",
      "speaker": "路人",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_028",
      "speaker": "张雨桐",
      "zh": "就在这里。",
      "pinyin": "Jiù zài zhèlǐ.",
      "tr": "Bu ev burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_029",
      "speaker": "刘梅",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_030",
      "speaker": "路人",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_031",
      "speaker": "张雨桐",
      "zh": "我终于找到了。",
      "pinyin": "Wǒ zhōngyú zhǎodào le.",
      "tr": "Sonunda buldum."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_032",
      "speaker": "刘梅",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_033",
      "speaker": "路人",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_034",
      "speaker": "张雨桐",
      "zh": "时间有点紧，我们动作快一点。",
      "pinyin": "Shíjiān yǒudiǎn jǐn, wǒmen dòngzuò kuài yìdiǎn.",
      "tr": "Zaman biraz sıkışık, biraz hızlı hareket edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_035",
      "speaker": "刘梅",
      "zh": "这个做完以后再做下一个。",
      "pinyin": "Zhège zuò wán yǐhòu zài zuò xià yígè.",
      "tr": "Bunu bitirdikten sonra diğerini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_036",
      "speaker": "路人",
      "zh": "这个办法比刚才好一点。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái hǎo yìdiǎn.",
      "tr": "Bu yöntem az öncekinden biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_037",
      "speaker": "张雨桐",
      "zh": "我刚才已经试过了。",
      "pinyin": "Wǒ gāngcái yǐjīng shìguò le.",
      "tr": "Az önce zaten denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_038",
      "speaker": "刘梅",
      "zh": "那我们换个方法看看。",
      "pinyin": "Nà wǒmen huàngè fāngfǎ kànkàn.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_039",
      "speaker": "路人",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_040",
      "speaker": "张雨桐",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_041",
      "speaker": "刘梅",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_042",
      "speaker": "路人",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_043",
      "speaker": "张雨桐",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_044",
      "speaker": "刘梅",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_045",
      "speaker": "路人",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_046",
      "speaker": "张雨桐",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_047",
      "speaker": "刘梅",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_048",
      "speaker": "路人",
      "zh": "终于好了，我放心了。",
      "pinyin": "Zhōngyú hǎo le, wǒ fàngxīn le.",
      "tr": "Sonunda düzeldi, içim rahatladı."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_049",
      "speaker": "张雨桐",
      "zh": "这次我们也学到东西了。",
      "pinyin": "Zhècì wǒmen yě xuédào dōngxī le.",
      "tr": "Bu sefer de bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_050",
      "speaker": "刘梅",
      "zh": "以后再遇到这种情况就不怕了。",
      "pinyin": "Yǐhòu zài yùdào zhèzhǒng qíngkuàng jiù bùpà le.",
      "tr": "Bundan sonra böyle bir durum olursa korkmayız."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_051",
      "speaker": "路人",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_052",
      "speaker": "张雨桐",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_053",
      "speaker": "刘梅",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC028_054",
