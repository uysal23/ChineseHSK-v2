{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC014",
  "level": "HSK2",
  "number": 14,
  "titleZh": "理发店里的误会",
  "titleTr": "Mahalle Berberi",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC014_001",
      "speaker": "张伟",
      "zh": "我想把头发剪短一点。",
      "pinyin": "Wǒ xiǎng bǎ tóufa jiǎn duǎn yìdiǎn.",
      "tr": "Saçımı biraz daha kısa kestirmek istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_002",
      "speaker": "理发师",
      "zh": "今天事情不少。",
      "pinyin": "Jīntiān shìqing bù shǎo.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_003",
      "speaker": "刘梅",
      "zh": "我们先看看最重要的。",
      "pinyin": "Wǒmen xiān kànkan zuì zhòngyào de.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_004",
      "speaker": "张伟",
      "zh": "好，慢慢来。",
      "pinyin": "Hǎo, mànmàn lái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_005",
      "speaker": "理发师",
      "zh": "我今天去理发。",
      "pinyin": "Wǒ jīntiān qù lǐfà.",
      "tr": "Bugün saçımı kestirmeye gidiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_006",
      "speaker": "刘梅",
      "zh": "我明白了。",
      "pinyin": "Wǒ míngbai le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_007",
      "speaker": "张伟",
      "zh": "原来是这样。",
      "pinyin": "Yuánlái shì zhèyàng.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_008",
      "speaker": "理发师",
      "zh": "我想再短一点。",
      "pinyin": "Wǒ xiǎng zài duǎn yìdiǎn.",
      "tr": "Biraz daha kısa istiyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_009",
      "speaker": "刘梅",
      "zh": "这个我记住了。",
      "pinyin": "Zhège wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_010",
      "speaker": "张伟",
      "zh": "听起来很清楚。",
      "pinyin": "Tīng qǐlái hěn qīngchu.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_011",
      "speaker": "理发师",
      "zh": "这个有点长。",
      "pinyin": "Zhège yǒudiǎn cháng.",
      "tr": "Bu biraz uzun."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_012",
      "speaker": "刘梅",
      "zh": "好，那就按这个来。",
      "pinyin": "Hǎo, nà jiù àn zhège lái.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_014",
      "speaker": "理发师",
      "zh": "这个样子更适合你。",
      "pinyin": "Zhège yàngzi gèng shìhé nǐ.",
      "tr": "Bu görünüm sana daha uygun."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_015",
      "speaker": "刘梅",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen bié wàng le.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_017",
      "speaker": "理发师",
      "zh": "不是这么短。",
      "pinyin": "Bú shì zhème duǎn.",
      "tr": "Bu kadar kısa değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_018",
      "speaker": "刘梅",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnme bàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC014_019",
      "speaker": "张伟",
      "zh": "先别着急，我们想个办法。",
      "pinyin": "Xiān bié zháojí, wǒmen xiǎng ge bànfǎ.",
      "tr": "Önce telaşlanmayalım, bir çözüm düşünelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_020",
      "speaker": "理发师",
      "zh": "我觉得可以先做最简单的。",
      "pinyin": "Wǒ juéde kěyǐ xiān zuò zuì jiǎndān de.",
      "tr": "Bence önce en kolay kısmı yapabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_021",
      "speaker": "刘梅",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_022",
      "speaker": "张伟",
      "zh": "理发师今天也来了。",
      "pinyin": "Lǐfàshī jīntiān yě lái le.",
      "tr": "Berber bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_023",
      "speaker": "理发师",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_024",
      "speaker": "刘梅",
      "zh": "那我们把它记下来。",
      "pinyin": "Nà wǒmen bǎ tā jìxiàlái.",
      "tr": "O zaman bunu not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_025",
      "speaker": "张伟",
      "zh": "这个礼物很漂亮。",
      "pinyin": "Zhège lǐwù hěn piàoliang.",
      "tr": "Bu hediye çok güzel."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_026",
      "speaker": "理发师",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ búcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_027",
      "speaker": "刘梅",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshi.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_028",
      "speaker": "张伟",
      "zh": "我们先选择。",
      "pinyin": "Wǒmen xiān xuǎnzé.",
      "tr": "Önce seçmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_029",
      "speaker": "理发师",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_030",
      "speaker": "刘梅",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_031",
      "speaker": "张伟",
      "zh": "我们先检查。",
      "pinyin": "Wǒmen xiān jiǎnchá.",
      "tr": "Önce kontrol etmek."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_032",
      "speaker": "理发师",
      "zh": "说得对。",
      "pinyin": "Shuō de duì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_033",
      "speaker": "刘梅",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_034",
      "speaker": "张伟",
      "zh": "因为时间不多，所以我们快一点。",
      "pinyin": "Yīnwèi shíjiān bù duō, suǒyǐ wǒmen kuài yìdiǎn.",
      "tr": "Zaman az olduğu için biraz hızlı olalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_035",
      "speaker": "理发师",
      "zh": "先做这个，再做下一个。",
      "pinyin": "Xiān zuò zhège, zài zuò xià yí ge.",
      "tr": "Önce bunu, sonra sıradakini yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_036",
      "speaker": "刘梅",
      "zh": "这个办法比刚才的好。",
      "pinyin": "Zhège bànfǎ bǐ gāngcái de hǎo.",
      "tr": "Bu yöntem az öncekinden daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_037",
      "speaker": "张伟",
      "zh": "我已经试过一次了。",
      "pinyin": "Wǒ yǐjīng shìguo yí cì le.",
      "tr": "Bir kez denedim bile."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_038",
      "speaker": "理发师",
      "zh": "那我们换一个办法。",
      "pinyin": "Nà wǒmen huàn yí ge bànfǎ.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_039",
      "speaker": "刘梅",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiān lái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosu wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_041",
      "speaker": "理发师",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_042",
      "speaker": "刘梅",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎo duō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chà yìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_044",
      "speaker": "理发师",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒ lái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_045",
      "speaker": "刘梅",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxie, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yí cì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_047",
      "speaker": "理发师",
      "zh": "这次没有问题了。",
      "pinyin": "Zhè cì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_048",
      "speaker": "刘梅",
      "zh": "太好了，终于解决了。",
      "pinyin": "Tài hǎo le, zhōngyú jiějué le.",
      "tr": "Harika, sonunda çözüldü."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_049",
      "speaker": "张伟",
      "zh": "今天又学到一件事。",
      "pinyin": "Jīntiān yòu xuédào yí jiàn shì.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_050",
      "speaker": "理发师",
      "zh": "下次我们会更有经验。",
      "pinyin": "Xià cì wǒmen huì gèng yǒu jīngyàn.",
      "tr": "Bir dahaki sefere daha deneyimli olacağız."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_051",
      "speaker": "刘梅",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_053",
      "speaker": "理发师",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC014_054",
      "speaker": "刘梅",
      "zh": "我今天去理发。",
      "pinyin": "Wǒ jīntiān qù lǐfà.",
