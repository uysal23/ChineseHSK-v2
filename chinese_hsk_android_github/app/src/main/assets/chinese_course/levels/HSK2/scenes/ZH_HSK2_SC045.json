{
  "schemaVersion": 2,
  "id": "ZH_HSK2_SC045",
  "level": "HSK2",
  "number": 45,
  "titleZh": "张伟的第一次工作评价",
  "titleTr": "Zhang’ın İlk Performans Görüşmesi",
  "complete": true,
  "status": "planned",
  "dialogues": [
    {
      "id": "DLG_ZH_HSK2_SC045_001",
      "speaker": "张伟",
      "zh": "今天是第一次工作评价。",
      "pinyin": "Jīntiān shì dìyīcì gōngzuò píngjià.",
      "tr": "Bugün ilk performans değerlendirmesi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_002",
      "speaker": "经理",
      "zh": "今天有不少事情要做。",
      "pinyin": "Jīntiān yǒu bùshǎo shìqíng yào zuò.",
      "tr": "Bugün yapılacak epey iş var."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_003",
      "speaker": "同事",
      "zh": "我们先看最重要的事。",
      "pinyin": "Wǒmen xiānkàn zuì zhòngyào de shì.",
      "tr": "Önce en önemli olana bakalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_004",
      "speaker": "张伟",
      "zh": "好，我们慢慢来。",
      "pinyin": "Hǎo, wǒmen mànmànlái.",
      "tr": "Tamam, sakin sakin ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_005",
      "speaker": "经理",
      "zh": "今天经理要做工作评价。",
      "pinyin": "Jīntiān jīnglǐ yào zuò gōngzuò píngjià.",
      "tr": "Bugün müdür iş değerlendirmesi yapacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_006",
      "speaker": "同事",
      "zh": "明白了。",
      "pinyin": "Míngbái le.",
      "tr": "Anladım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_007",
      "speaker": "张伟",
      "zh": "这样我就懂了。",
      "pinyin": "Zhèyàng wǒ jiù dǒng le.",
      "tr": "Demek böyleymiş."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_008",
      "speaker": "经理",
      "zh": "这个地方以后还可以提高。",
      "pinyin": "Zhège dìfāng yǐhòu hái kěyǐ tígāo.",
      "tr": "Bu alan ileride daha da geliştirilebilir."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_009",
      "speaker": "同事",
      "zh": "好，我记住了。",
      "pinyin": "Hǎo, wǒ jìzhù le.",
      "tr": "Bunu aklımda tutacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_010",
      "speaker": "张伟",
      "zh": "嗯，听明白了。",
      "pinyin": "En, tīng míngbái le.",
      "tr": "Oldukça net görünüyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_011",
      "speaker": "经理",
      "zh": "这是你的一个优点。",
      "pinyin": "Zhè shì nǐ de yígè yōudiǎn.",
      "tr": "Bu senin güçlü yönlerinden biri."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_012",
      "speaker": "同事",
      "zh": "好，那就这么办。",
      "pinyin": "Hǎo, nà jiù zhème bàn.",
      "tr": "Tamam, o zaman buna göre ilerleyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_013",
      "speaker": "张伟",
      "zh": "我觉得可以。",
      "pinyin": "Wǒ juéde kěyǐ.",
      "tr": "Bence olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_014",
      "speaker": "经理",
      "zh": "以后我会更注意。",
      "pinyin": "Yǐhòu wǒhuì gèng zhùyì.",
      "tr": "Bundan sonra daha dikkatli olacağım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_015",
      "speaker": "同事",
      "zh": "对，这个很重要。",
      "pinyin": "Duì, zhège hěn zhòngyào.",
      "tr": "Evet, bu önemli."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_016",
      "speaker": "张伟",
      "zh": "我们别忘了。",
      "pinyin": "Wǒmen biéwàngle.",
      "tr": "Bunu unutmayalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_017",
      "speaker": "经理",
      "zh": "你做得不错，但是沟通还可以提高。",
      "pinyin": "Nǐ zuò dé bùcuò, dànshì gōutōng hái kěyǐ tígāo.",
      "tr": "İyi gidiyorsun ama iletişimini daha da geliştirebilirsin."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_018",
      "speaker": "同事",
      "zh": "那现在怎么办？",
      "pinyin": "Nà xiànzài zěnmebàn?",
      "tr": "Peki şimdi ne yapacağız?"
    },
    {
      "id": "DLG_ZH_HSK2_SC045_019",
      "speaker": "张伟",
      "zh": "别着急，总会有办法的。",
      "pinyin": "Biézháojí, zǒnghuì yǒu bànfǎ de.",
      "tr": "Telaşlanma, mutlaka bir çözüm buluruz."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_020",
      "speaker": "经理",
      "zh": "我们可以先从简单的开始。",
      "pinyin": "Wǒmen kěyǐ xiān cóng jiǎndān de kāishǐ.",
      "tr": "Önce kolay olandan başlayabiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_021",
      "speaker": "同事",
      "zh": "这样比较快。",
      "pinyin": "Zhèyàng bǐjiào kuài.",
      "tr": "Böyle daha hızlı olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_022",
      "speaker": "张伟",
      "zh": "经理今天也来了。",
      "pinyin": "Jīnglǐ jīntiān yě lái le.",
      "tr": "Müdür bugün de geldi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_023",
      "speaker": "经理",
      "zh": "对，这个也要注意。",
      "pinyin": "Duì, zhège yě yào zhùyì.",
      "tr": "Evet, buna da dikkat etmek gerekiyor."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_024",
      "speaker": "同事",
      "zh": "那我们先记下来。",
      "pinyin": "Nà wǒmen xiān jìxiàlái.",
      "tr": "O zaman önce not edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_025",
      "speaker": "张伟",
      "zh": "你看，这个工作在这儿。",
      "pinyin": "Nǐ kàn, zhège gōngzuò zài zhèér.",
      "tr": "Bu iş burada."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_026",
      "speaker": "经理",
      "zh": "这个办法不错。",
      "pinyin": "Zhège bànfǎ bùcuò.",
      "tr": "Bu yöntem fena değil."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_027",
      "speaker": "同事",
      "zh": "我们可以试试。",
      "pinyin": "Wǒmen kěyǐ shìshì.",
      "tr": "Deneyebiliriz."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_028",
      "speaker": "张伟",
      "zh": "老师说他进步很大。",
      "pinyin": "Lǎoshī shuō tā jìnbù hěndà.",
      "tr": "Öğretmen onun çok ilerlediğini söyledi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_029",
      "speaker": "经理",
      "zh": "我以前没注意到。",
      "pinyin": "Wǒ yǐqián méi zhùyì dào.",
      "tr": "Daha önce dikkat etmemiştim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_030",
      "speaker": "同事",
      "zh": "现在知道了。",
      "pinyin": "Xiànzài zhīdào le.",
      "tr": "Şimdi öğrendim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_031",
      "speaker": "张伟",
      "zh": "这个我们确实需要。",
      "pinyin": "Zhège wǒmen quèshí xūyào.",
      "tr": "Buna gerçekten ihtiyacımız var."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_032",
      "speaker": "经理",
      "zh": "说得对。",
      "pinyin": "Shuōdéduì.",
      "tr": "Doğru söylüyorsun."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_033",
      "speaker": "同事",
      "zh": "这样更方便。",
      "pinyin": "Zhèyàng gèng fāngbiàn.",
      "tr": "Böyle daha kullanışlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_034",
      "speaker": "张伟",
      "zh": "快一点吧，不然时间不够。",
      "pinyin": "Kuài yìdiǎn ba, bùrán shíjiān bùgòu.",
      "tr": "Biraz hızlanalım, yoksa zaman yetmeyecek."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_035",
      "speaker": "经理",
      "zh": "别一起做，先做这个。",
      "pinyin": "Bié yìqǐ zuò, xiān zuò zhège.",
      "tr": "Hepsini birden yapmayalım, önce bunu yapalım."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_036",
      "speaker": "同事",
      "zh": "还是这个办法好一些。",
      "pinyin": "Háishì zhège bànfǎ hǎo yīxiē.",
      "tr": "Bu yöntem biraz daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_037",
      "speaker": "张伟",
      "zh": "这个办法我刚刚试过。",
      "pinyin": "Zhège bànfǎ wǒ gānggāng shì guò.",
      "tr": "Bu yöntemi az önce denedim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_038",
      "speaker": "经理",
      "zh": "那我们换个方法看看。",
      "pinyin": "Nà wǒmen huàngè fāngfǎ kànkàn.",
      "tr": "O zaman başka bir yöntem deneyelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_039",
      "speaker": "同事",
      "zh": "可以，你先来。",
      "pinyin": "Kěyǐ, nǐ xiānlái.",
      "tr": "Olur, önce sen yap."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_040",
      "speaker": "张伟",
      "zh": "做完以后告诉我。",
      "pinyin": "Zuò wán yǐhòu gàosù wǒ.",
      "tr": "Bitirince bana söyle."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_041",
      "speaker": "经理",
      "zh": "没问题，我记得。",
      "pinyin": "Méi wèntí, wǒ jìde.",
      "tr": "Sorun yok, hatırlıyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_042",
      "speaker": "同事",
      "zh": "现在好多了。",
      "pinyin": "Xiànzài hǎoduō le.",
      "tr": "Şimdi çok daha iyi."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_043",
      "speaker": "张伟",
      "zh": "还差一点。",
      "pinyin": "Hái chàyìdiǎn.",
      "tr": "Biraz daha eksik var."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_044",
      "speaker": "经理",
      "zh": "我来帮你吧。",
      "pinyin": "Wǒlái bāng nǐ ba.",
      "tr": "Sana yardım edeyim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_045",
      "speaker": "同事",
      "zh": "谢谢，这样快多了。",
      "pinyin": "Xièxiè, zhèyàng kuài duō le.",
      "tr": "Teşekkürler, böyle çok daha hızlı."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_046",
      "speaker": "张伟",
      "zh": "我们再检查一次。",
      "pinyin": "Wǒmen zài jiǎnchá yīcì.",
      "tr": "Bir kez daha kontrol edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_047",
      "speaker": "经理",
      "zh": "这次没有问题了。",
      "pinyin": "Zhècì méiyǒu wèntí le.",
      "tr": "Bu kez sorun kalmadı."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_048",
      "speaker": "同事",
      "zh": "太好了，这下没问题了。",
      "pinyin": "Tàihǎole, zhèxià méi wèntí le.",
      "tr": "Harika, artık sorun yok."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_049",
      "speaker": "张伟",
      "zh": "今天又学到了一点。",
      "pinyin": "Jīntiān yòu xuédào le yìdiǎn.",
      "tr": "Bugün yine bir şey öğrendik."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_050",
      "speaker": "经理",
      "zh": "这次记住了，下次会更顺利。",
      "pinyin": "Zhècì jìzhù le, xiàcì huì gèng shùnlì.",
      "tr": "Bu kez öğrendik; bir dahaki sefere daha sorunsuz olur."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_051",
      "speaker": "同事",
      "zh": "我也是这么想的。",
      "pinyin": "Wǒ yě shì zhème xiǎng de.",
      "tr": "Ben de böyle düşünüyorum."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_052",
      "speaker": "张伟",
      "zh": "那就这么决定吧。",
      "pinyin": "Nà jiù zhème juédìng ba.",
      "tr": "O zaman böyle karar verelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_053",
      "speaker": "经理",
      "zh": "好，我们继续。",
      "pinyin": "Hǎo, wǒmen jìxù.",
      "tr": "Tamam, devam edelim."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_054",
      "speaker": "同事",
      "zh": "嗯，今天经理要做工作评价。",
      "pinyin": "En, jīntiān jīnglǐ yào zuò gōngzuò píngjià.",
      "tr": "Bugün müdür iş değerlendirmesi yapacak."
    },
    {
      "id": "DLG_ZH_HSK2_SC045_055",
